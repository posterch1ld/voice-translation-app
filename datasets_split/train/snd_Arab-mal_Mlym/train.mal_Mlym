കഴിഞ്ഞ വർഷം തീർത്തും ദുരന്തമായിരുന്നു.
നിങ്ങൾ എല്ലാവരും നന്നായി ഒത്തുപോകുകയും എല്ലാ പിണക്കങ്ങളും തീർക്കുകയും ചെയ്യുമെന്ന് പ്രതീക്ഷിക്കുന്നു.
തട്ടിപ്പിനെ തുടർന്ന് ബാങ്കിലുണ്ടായിരുന്ന എന്റെ മുഴുവൻ പണവും മോഷ്ടിക്കപ്പെട്ടു, എനിക്ക് ഭയങ്കര ദേഷ്യമാണ്.
അവനും ഒരു കിടിലൻ കളിക്കാരനാണോ?
ഇത്രയും അത്ഭുതകരമായ ഒരു കുടുംബം ഉണ്ടായത് നിങ്ങളുടെ ഭാഗ്യമാണ്.
അത് വളരെ ജീർണ്ണമായിരുന്നു, പുറത്തു ഇരുട്ടുമായിരുന്നു, അതിനുപുറമേ വേഗവും കുറവായിരുന്നു.
ഇത് ഇപ്പോഴും വളരെ നല്ലതായിരിക്കുമെന്ന് എനിക്ക് തോന്നുന്നു.
അവൾ കുടുംബത്തിലെ ഒരാളാണ്, അവൾക്ക് ഒരു ആസക്തിയുമുണ്ട്.
കുറച്ച് മാസങ്ങൾക്കുള്ളിൽ എന്റെ മകന് രണ്ട് വയസാകും, അത് എന്നെ കുറച്ച് സങ്കടപ്പെടുത്തുന്നു.
എന്റെ ജ്യാമിതി പരീക്ഷയിൽ ഞാൻ തോറ്റുപോകുമോ എന്നോർത്ത് എനിക്ക് ശരിക്കും പേടിയാണ്.
വളരെ വർഷങ്ങൾക്ക് മുമ്പ് പ്രൈമറി സ്കൂളിൽ പഠിക്കുമ്പോൾ, ഞാൻ രണ്ടാം ക്ലാസിലായിരിക്കെ അക്ഷരവിന്യാസം മറന്നുപോയി.
എന്റെ മകളെ നർത്തകിയായി കാണുന്നത് എനിക്ക് സന്തോഷമാണ്.
അവസാനം നീ അത് ധരിച്ചോ?
അത് ശരിക്കും ആവേശകരമായിരുന്നെന്ന് എനിക്ക് ഉറപ്പുണ്ട്.
അവൾ നിന്നിൽ നിന്ന് പണം കടം വാങ്ങിയോ?
നിങ്ങൾ ഏത് പ്രദേശത്താണ്?
എല്ലാം നന്നായി പോകുമെന്ന് പ്രതീക്ഷിക്കുന്നു.
ചുമത്തിയ കുറ്റം ശരിയാണ്, ഞാൻ കുറ്റക്കാരനാണ്.
ആ ആഷ്‌ട്രേയ്ക്ക് 16 വർഷം പഴക്കമുണ്ട്.
ഇത് നിങ്ങളെ കുറച്ച് ആശ്വസിപ്പിക്കുമെന്ന് പ്രതീക്ഷിക്കുന്നു.
എന്റെ സുഹൃത്ത് എന്നോട് പറഞ്ഞ ഒരു രഹസ്യം ഞാൻ മറ്റൊരാളോട് പറഞ്ഞെന്ന് അവൻ അറിഞ്ഞു
എന്റെ കാമുകി നഗരത്തിന് പുറത്താണ്, എനിക്ക് തീർത്തും ഒറ്റപ്പെട്ടതായി തോന്നുന്നു
നമ്മുടെ വാർഷികത്തിന് ഞാൻ അവൾക്ക് സമ്മാനിച്ച വാച്ച് അവൾ നഷ്ടപ്പെടുത്തി
ആളുകൾക്ക് ഇങ്ങനെ ഒരു കാര്യം ചെയ്യാൻ കഴിയുമെന്ന് എനിക്ക് വിശ്വസിക്കാനാകുന്നില്ല
അവൾ വലുതാകുമ്പോൾ നിന്റെ കുട്ടിയോട് പറയാൻ ഇത് ഒരു കിടിലൻ കഥയായിരിക്കും എന്ന് തോന്നുന്നു, അല്ലേ
പുതിയ കാർ വാങ്ങുന്നത് വലിയ കാര്യമാണ്
ഒരിക്കലെങ്കിലും ജീവിതത്തിൽ മുന്നേറാൻ കഴിഞ്ഞിരുന്നെങ്കിൽ എന്ന് ഞാൻ ആഗ്രഹിക്കുന്നു
പുതിയ അയൽപ്പക്കത്തേക്ക് മാറുമ്പോഴെല്ലാം എനിക്ക് കുറച്ച് പേടി തോന്നും
ഞാൻ ഇപ്പോഴും ജോലി അന്വേഷിക്കുകയാണ്
എനിക്ക് പല തവണ മുഖം തിരിക്കേണ്ടിവന്നു
അവരിൽ ചിലരെ അത് ചെയ്യുന്നതിനിടെ നീ പിടികൂടിയോ
അത് കൊള്ളാം, സ്ഥാനം എന്താണ്
റോഡിൽ ഒരാൾ എന്റെ മുന്നിലേക്ക് കട്ട് ചെയ്ത് കയറി, എന്നെ ഏതാണ്ട് അപകടത്തിൽ ആക്കിയേനെ
അത് നിന്റെ സുഹൃത്തിന് നല്ലതാണ്, പക്ഷേ നിനക്ക് എങ്ങനെ തോന്നുന്നുവെന്ന് എനിക്ക് മനസ്സിലാകുന്നു
എന്റെ അടുത്ത് വേറെ സുഹൃത്തുക്കളില്ല, ചെയ്യാനൊന്നുമില്ല
അവനോട് സംസാരിച്ചത് നന്നായി തോന്നി
എന്റെ സുഹൃത്ത് സ്വയം സ്കേറ്റിംഗ് പഠിച്ച് ഇപ്പോഴാണ് തന്റെ ആദ്യ മത്സരത്തിൽ ജയിച്ചത്
എനിക്ക് ശരിക്കും മൂക്ക് പൊത്തിപ്പിടിച്ച് ഓടിപ്പോകേണ്ടിവന്നു
ഞാൻ കളിച്ചിട്ടുള്ളതിൽ ഏറ്റവും മികച്ച കളിയായിരുന്നു ഇത്
എനിക്ക് കുറച്ച് മാത്രം കിതപ്പുണ്ട്.
ഇത് ഓടിക്കാൻ ശരിക്കും സ്മൂത്തും രസകരവുമാണ്.
എനിക്ക് അവിടെ പോകാൻ കഴിഞ്ഞിരുന്നെങ്കിൽ എന്ന് ആഗ്രഹിക്കുന്നു.
അവൻ വെറുതെ സുഖിപ്പിച്ച് സംസാരിക്കുകയും എല്ലാ ആശയങ്ങളും തന്റേതാണെന്ന പോലെ കാണിക്കുകയും ചെയ്യുന്നു.
ശരി, ചില ആളുകൾക്ക് അത് വളരെ വലിയ കാര്യമാണ്.
അത് എന്റേതല്ലാത്തതിനാൽ ഞാൻ അത് തിരികെ നൽകി കസ്റ്റമർ സർവീസിന് ഏൽപ്പിച്ചു.
എന്നെ ആദരിക്കാനായി എന്റെ മകൾ ഇപ്പോഴാണ് ഒരു ടാറ്റൂ ചെയ്തിരിക്കുന്നത്.
അവൾ ചെയ്യില്ല; നല്ല പ്രവൃത്തികൾക്ക് ശിക്ഷ ലഭിക്കില്ല.
പക്ഷേ അത് കേൾക്കുന്നത് വളരെ സന്തോഷകരമാണ്.
അടുത്ത തവണ ആ സ്ഥലത്ത് പോകുമ്പോൾ സൂക്ഷിക്കണം.
പുതിയൊരു ലുക്ക് തീർച്ചയായും പുതുമ അനുഭവിക്കാൻ സഹായിക്കും—കുറഞ്ഞത് എനിക്ക് അങ്ങനെ തോന്നാറുണ്ട്.
എനിക്ക് അവളെ സ്നേഹിക്കുന്നുവെന്ന് തോന്നുന്നു.
അഞ്ച് വർഷമായി എന്റെ പ്രിയപ്പെട്ട കൂട്ടുകാരി ഇന്നലെ മരിച്ചു, എനിക്ക് വളരെ ഏകാന്തത തോന്നുന്നു.
ഞാൻ പുറത്തുള്ള ചവറ്റുകുട്ടി ഒഴിക്കാൻ പോയപ്പോൾ അത് പുഴുക്കളാൽ മൂടപ്പെട്ടിരുന്നു.
വേനൽക്കാലം കഴിഞ്ഞ് അവർ സ്കൂളിലേക്ക് പോകേണ്ടിവരുമ്പോൾ എനിക്ക് ശരിക്കും സങ്കടം തോന്നും.
അത് പരമാവധി ആസ്വദിക്കുന്നുവെന്ന് ഉറപ്പാക്കണം.
നമ്മുടെ അവസാനത്തെ നല്ല കുടുംബഫോട്ടോ ഞാൻ ഒരിക്കലും മറക്കില്ല.
നിന്റെ ചവറ്റുകുട്ടി വയ്ക്കുന്ന സ്ഥലമൊട്ടാകെ ചുവന്ന മുളക് വിതറിയാൽ ചില മൃഗങ്ങളെ അകറ്റിനിർത്താൻ സഹായിക്കുമെന്നു കേട്ടിട്ടുണ്ട്.
നിനക്ക് ഒരിക്കലെങ്കിലും Cirque du Soleil-ലേക്ക് പോകാൻ കഴിഞ്ഞിട്ടുണ്ടോ?
പകുതി സമയം ഞാൻ സ്വയം ജോലി ചെയ്യുന്നു, ബാക്കി പകുതി സമയം ഒരു കമ്പനിയിൽ ജോലി ചെയ്യുന്നു.
എന്റെ സമയത്തിന്റെ എന്തൊരു പാഴ്‌ച്ച!
ഇത് നിന്റെ സ്വന്തം റെസിപ്പിയാണോ, അതോ ആരെങ്കിലും നിനക്ക് കൈമാറിയതാണോ, എന്താണ്?
പലപ്പോഴും ആ അറ്റകുറ്റപ്പണികൾക്ക് നല്ല ചെലവ് വരാം.
അതാണ ഏറ്റവും നല്ല സമ്മാനം.
അവൻ ശരിക്കും വാക്ക് പാലിച്ച് ജിമ്മിൽ പോകുമെന്ന് നിനക്ക് തോന്നുന്നുണ്ടോ?
നിനക്ക് വിഷമമായി കാണും എന്ന് എനിക്ക് ഉറപ്പാണ്.
അവൻ അതിനെ വിലമതിച്ചിട്ടുണ്ടാകും എന്ന് എനിക്ക് തോന്നുന്നു.
ഇടുത്തിടെ ഞാൻ സ്കൂളിൽ വളരെ കഠിനമായി പരിശ്രമിക്കുകയാണ്.
അതിൽ നിക്ഷേപിക്കാതിരുന്നത് എന്റെ ഏറ്റവും വലിയ പശ്ചാത്താപങ്ങളിൽ ഒന്നാണ്.
എന്റെ സഹോദരൻ മാസ്റ്റേഴ്സ് പൂർത്തിയാക്കി, അതിൽ എനിക്ക് വളരെ സന്തോഷമായി.
ഇപ്പോഴാണ് ബുഫെയിൽ നിന്ന് വീട്ടിലെത്തിയത്.
നീ ഇതൊക്കെ കഴിച്ചോ?
എന്റെ മുത്തച്ഛൻ തന്റെ പോക്കറ്റ് വാച്ച് എനിക്ക് തന്നു.
ഇതിനെക്കുറിച്ച് എനിക്ക് ലജ്ജ തോന്നുന്നു.
എനിക്ക് വല്ലാതെ വിഷമമാകുമായിരുന്നു.
ജൂറി ഡ്യൂട്ടിക്ക് പോകുമ്പോൾ എനിക്ക് നല്ല പേടിയായിരുന്നു.
ഞാൻ ഫുട്ബോളിന്റെ വലിയ ആരാധകനൊന്നുമല്ല.
അവളുടെ മാതാപിതാക്കളായതിൽ ഞങ്ങൾ ഭാഗ്യവാന്മാരാണെന്ന് തോന്നിപ്പിക്കാൻ അവൾക്ക് ശരിക്കും അറിയാം.
ചിലപ്പോൾ കുടുംബക്കാർ വായ്പയുടെ കാര്യത്തിൽ അത്ര നല്ലവരല്ല.
അതേസമയം, മാറ്റമൊന്നും സാധ്യമല്ല.
അമേരിക്കയിലെ കുട്ടികൾക്കായി ഒരുക്കിയ വിചിത്രമായ ടെലിവിഷൻ ഷോയായ ‘ലേസി ടൗൺ’ൽ അവൻ വില്ലനായി അഭിനയിച്ചിരുന്നു.
അവൾ ഇനി അവരോടൊപ്പം ഇല്ലാത്തത് എന്തുകൊണ്ടാണെന്ന് അവർക്ക് മനസ്സിലാകാത്തതിനാൽ എനിക്ക് അവരോട് വിഷമം തോന്നുന്നു.
ഞാൻ സമ്മതിക്കുന്നു, ആ തോന്നൽ എനിക്ക് വളരെ ഇഷ്ടമാണ്.
വളരെക്കാലമായി നേടാൻ ഞാൻ ശ്രമിച്ചുകൊണ്ടിരുന്ന ഒന്നായിരുന്നു അത്.
നാനിയെക്കുറിച്ച് നിനക്ക് എങ്ങനെ തോന്നിയിരുന്നോ, നിന്റെ ബോസിനും അതുപോലെ തന്നെയായിരുന്നിരിക്കണം എന്ന് തോന്നുന്നു.
ആ ക്ലാസുകളും ചെലവേറിയതാണ്.
വർഷങ്ങളായുള്ള പീഡനത്തിന് ശേഷം എനിക്ക് അവിടെ നിന്ന് പോകേണ്ടി വന്നു, പക്ഷേ ഒറ്റയ്ക്ക് ജീവിക്കുന്നത് ഇത്ര ബോറായിരിക്കുമെന്ന് ഞാൻ ഒരിക്കലും കരുതിയില്ല.
എന്റെ ഭർത്താവ് എന്നോടൊപ്പം വീട്ടിലുണ്ടാകുമ്പോൾ എനിക്ക് വളരെ ആശ്വാസവും സന്തോഷവും തോന്നുന്നു.
അത് വളരെ മോശമായി, എനിക്ക് വിഷമമുണ്ട്.
കുറച്ച് കാലമായി ഞാൻ വലിയൊരു ആരാധകനാണ്.
അത് എപ്പോഴും ഒരു അധിക നേട്ടമാണ്.
അയ്യോ, നിനക്ക് അത് വൃത്തിയാക്കാൻ കഴിഞ്ഞോ?
നന്നായി, ഞാൻ അവളെ 6 വർഷം മുമ്പാണ് കണ്ടുമുട്ടിയത്; അന്ന് എനിക്ക് 25 വയസ്സായിരുന്നു.
അവർ അത്ര നല്ല ആളുകളായി തോന്നുന്നില്ല.
എനിക്ക് ഏറ്റവും ഇഷ്ടമുള്ള നഗരങ്ങളിൽ ഒന്ന്.
എന്റെ പുതിയ ജോലിയെക്കുറിച്ച് എനിക്ക് ഉറപ്പില്ല.
ശരി, ഇത് കുറച്ച് അലോസരപ്പെടുത്തുന്നതായി മാറുകയാണ്.
എന്റെ അച്ഛൻ ജനിച്ചത് പോളണ്ടിലാണ്.
അവിടെ എത്താൻ അവൻ വളരെ കഠിനാധ്വാനം ചെയ്തിട്ടുണ്ട്.
നിനക്ക് അങ്ങനെ തോന്നാൻ കാരണം എന്താണ്?
നിനക്ക് എപ്പോഴും വ്യാജ ചെക്കുകളാണ് കിട്ടുന്നത് എന്തുകൊണ്ട്?
ഇത് ഒരുതരം പലവിധ സാധനങ്ങളുള്ള പാക്കാണ്.
ഞങ്ങളുടെ ഹോക്കി കളിക്ക് ശേഷം എന്റെ സഹോദരൻ എന്നോട് വഴക്കിടാൻ ശ്രമിച്ചു.
ചിലപ്പോൾ ഞാൻ വളരെ അശ്രദ്ധനാകുന്നു.
അതിൽ എനിക്ക് സന്തോഷമുണ്ട്.
കാലം കഴിയുമ്പോൾ നമുക്ക് ഇത് പരിഹരിക്കാനാകുമെന്ന് എനിക്ക് പ്രതീക്ഷയുണ്ട്.
എന്റെ നായയ്ക്ക് 16 വയസ്സുണ്ട്.
കുടുംബത്തോടൊപ്പമുള്ള ക്യാമ്പിംഗ് ട്രിപ്പിൽ നിന്ന് ഇപ്പോഴാണ് തിരികെ വന്നത്.
തുടക്കത്തിൽ തന്നെ ചില നായകളെ നിരോധിക്കാൻ അവരെ പ്രേരിപ്പിച്ചത് എന്തായിരിക്കുമെന്ന് എനിക്ക് ചിന്തിക്കാനുപോലും കഴിയുന്നില്ല.
എനിക്ക് കഴിക്കണമെന്ന് തോന്നിയത് ഇതല്ല.
ഇപ്പോഴേക്കും എനിക്ക് ഇതിലും നന്നായി അറിയേണ്ടിയിരുന്നു.
ചിലപ്പോൾ എന്റെ കുട്ടികൾ ഭയങ്കര കുസൃതിക്കാരാണ്.
അത് കേൾക്കുന്നത് ഹൃദയം ഏതാണ്ട് നിലച്ചുപോകുന്ന വാർത്ത പോലെയാണ്.
പോകാൻ നല്ലൊരു കാരണമെന്നു തോന്നുന്നു; ഒരുപക്ഷേ ഞാനും എന്റെ മേൽ ജ്യൂസ് ഒഴിക്കണം.
അവൾ എന്നേക്കാൾ ഭംഗിയുള്ള ഒരാളെ കണ്ടെത്തി എന്നെ ഉപേക്ഷിക്കുകയാണ് ചെയ്യുന്നത്.
ഇംഗ്ലീഷിന്റെ ഒരു വാക്കുപോലും അറിയാത്ത ഒരാളോട് നീ സംസാരിക്കുമ്പോൾ എനിക്ക് അത് സഹിക്കാനാവില്ല.
‘ദിസ് ഈസ് അസ്’ന്റെ പുതിയ സീസണിനായി ഞാൻ വളരെ ആവേശത്തിലാണ്.
നിന്റെ ജോലിക്കായോ മാനസികാരോഗ്യത്തിനായോ?
നീ അത് ഗംഭീരമായി ചെയ്തെന്ന് തോന്നുന്നു.
നാളെ ഞാൻ ഡോക്ടറെ കാണാൻ പോകുന്നു, ഇത് വളരെ ഗുരുതരമായ ഒന്നല്ലെന്ന് എനിക്ക് പ്രതീക്ഷയുണ്ട്.
എന്റെ സീരിയലിൽ എന്തോ ഉണ്ടായിരുന്നു
നീ ഇത് പ്രതീക്ഷിച്ചിരുന്നില്ലെന്ന് ഞാൻ കരുതുന്നു
അത് വലിയൊരു സന്തോഷമായിരുന്നു
ഇന്ന് ഒരു കഠിന ദിവസമാണ്, ഈയിടെയായി ഞാൻ പലപ്പോഴും ഒറ്റയ്ക്കാണ്
ഞാൻ നാളെ ഡിസ്നി വേൾഡിലേക്ക് പോകുകയാണ്
അവർക്ക് എല്ലാ വർഷവും അതേ സാധനങ്ങൾ തന്നെ വേണം
നീ നിന്റെ സുഹൃത്തിനോട് മുടിയെക്കുറിച്ച് പറഞ്ഞോ
ഇത് നന്നായി നടക്കുമെന്ന് എനിക്ക് നല്ല പ്രതീക്ഷയുണ്ട്
അപ്പോൾ ഈ യാത്രയ്ക്ക് നീ ആവശ്യത്തിലധികം തയ്യാറാണെന്ന് ഞാൻ ഉറപ്പിച്ച് പറയും
ഞാൻ കുളിച്ചു, അതുകൊണ്ട് എനിക്ക് വല്ലാതെ അറപ്പായി
അവർ അവരെ ക്യാമറയിൽ പകർത്തിയോ
അവന്റെ കുട്ടികൾ അവനെ പ്രചോദനമായി കാണുന്നത് അവന് വളരെ സന്തോഷം നൽകുന്നുണ്ടാകും
ഞങ്ങൾ ഫ്ലോറിഡയിലായിരിക്കും
നീ നിന്റെ അയൽക്കാരന്റെ സംസാരത്തിന് മുകളിൽ തന്നെ തുടർന്നും സംസാരിക്കണമെന്നാണ് എനിക്ക് തോന്നുന്നത്
നിനക്ക് സ്വന്തമായി കാര്യങ്ങൾ കൈകാര്യം ചെയ്യാൻ കഴിയുന്നതുവരെ സഹായിക്കാനാണ് മാതാപിതാക്കൾ ഉണ്ടാകുന്നത്
നീ എങ്ങനെയുള്ള സൂപ്പർവൈസറാകാൻ പോകുന്നു എന്ന് കാണിക്കുന്ന എന്തെങ്കിലും ചെയ്യൂ
ഞാൻ ചെയ്യുന്നതിൽ ഞാൻ മിടുക്കനാണെന്നും അതിനെക്കുറിച്ച് എനിക്ക് വളരെ സന്തോഷമുണ്ടെന്നും മാത്രം പറയാം
അങ്ങനെ ചിന്തിക്കുന്നത് വളരെ ആരോഗ്യകരമായ രീതിയാണ്
ശരി, അവൻ അവ ഒരിക്കലും ചെയ്തിട്ടില്ല
എനിക്ക് അത് വിശ്വസിക്കാനായില്ല, അതിനാൽ പോലീസുകാരനോട് വാദിക്കാൻ ശ്രമിച്ചു, എന്നിട്ടും ടിക്കറ്റ് കിട്ടി.
എനിക്ക് ഉറപ്പില്ല, പക്ഷേ റിപ്പോർട്ടിൽ 20-ലധികം ബഗുകൾ കണ്ടെത്തിയെന്ന് പറഞ്ഞിരുന്നു.
എന്റെ അമ്മായിയപ്പന് അടുത്ത ആഴ്ച ശസ്ത്രക്രിയയാണ്.
എനിക്ക് ദന്തഡോക്ടറെ കാണണം, പക്ഷേ ആ യാത്ര എനിക്ക് ഒട്ടും ഇഷ്ടമല്ല.
ഈ അപേക്ഷയെക്കുറിച്ച് എനിക്ക് നല്ല തോന്നലാണ്.
എനിക്ക് മോശമായി തോന്നി, കാരണം അത് എനിക്ക് ഇഷ്ടപ്പെട്ടെന്ന് എന്റെ കാമുകി അറിയണമെന്ന് ഞാൻ ആഗ്രഹിച്ചില്ല.
ഞാൻ വസ്ത്രം അടിവസ്ത്രത്തിനുള്ളിൽ കുത്തിക്കയറ്റി ഓഫീസിൽ ചുറ്റിനടന്നു.
ഞാൻ വിജനമായ ഒരു റോഡിലൂടെ കാർ ഓടിക്കുകയായിരുന്നു, പക്ഷേ അവിടെ ചില കുപ്രസിദ്ധ ഗുണ്ടകൾ തമ്പടിക്കാറുണ്ടെന്ന് കേട്ടിട്ടുണ്ട്.
അവസാനം എല്ലാം ശരിയാകും.
കഴിഞ്ഞ ദിവസം സ്കൂളിൽ എനിക്ക് വളരെ ബുദ്ധിമുട്ടുള്ള ഒരു പരീക്ഷയുണ്ടായിരുന്നു.
എന്റെ മകളുടെ കഴിവുകളെക്കുറിച്ച് എനിക്ക് വളരെ സന്തോഷമുണ്ട്.
ഞാൻ ഇപ്പോഴാണ് ചിപ്പോട്ടിലിൽ നിന്ന് ഭക്ഷണം കഴിച്ചത്.
നീ നിന്റെ ബേസ്മെന്റിലേക്ക് പോയോ?
ഇനി ഒരെണ്ണം ബാക്കിയുണ്ട്.
തമാശയുള്ളവയാണ് എനിക്ക് കൂടുതൽ ഇഷ്ടം.
അത് അവന് ഒരു ശീലമായി മാറുന്നു.
ഞാനും ശ്രമിച്ചു, പക്ഷേ മറ്റെല്ലാവരും വലിയ കൂട്ടങ്ങളായി അടിച്ചുപൊളിക്കുന്നത് കണ്ടപ്പോൾ എനിക്ക് വിഷമമായി.
ഇന്ന് കുട്ടികളെ സ്കൂളിൽ നിന്ന് കൂട്ടിക്കൊണ്ടുവരുമ്പോൾ ഞാൻ തെറ്റായ വഴിയിലൂടെ പോയി, ഏകദേശം കുടുങ്ങിപ്പോയി.
നിനക്ക് ഒരുപാട് രസിക്കും.
ഒരുപക്ഷേ ഞാൻ ‘കൂടുതൽ സുരക്ഷിതം’ എന്ന് പറയേണ്ടിയിരുന്നു.
ഞാൻ അടുത്തിടെ വീണ്ടും ‘മറ്റിൽഡ’ കണ്ടു.
എനിക്ക് ഉയരത്തെ ശരിക്കും പേടിയാണ്.
കുറച്ച് ആഴ്ചകൾക്ക് മുമ്പ് എന്റെ കാർ കേടായി, അതിനാൽ ഈയിടെ എന്റെ സുഹൃത്ത് എന്നെ കാറിൽ കൊണ്ടുപോകുകയാണ്.
എന്റെ അനിയൻ എന്റെ കാറിന്റെ താക്കോലുകൾ എടുത്ത് ടോയ്ലറ്റിൽ ഇട്ട് ഫ്ലഷ് ചെയ്തു.
അതെ, സമയമാണ് പ്രധാനപ്പെട്ട ഏക കാര്യം, അവൻ സന്തോഷത്തോടെ പോയതിൽ എനിക്ക് സന്തോഷമുണ്ട്.
ബാറിൽ വെച്ച് ഞാൻ മദ്യപിച്ച് ലഹരിയിലായപ്പോൾ എന്നെ വീട്ടിലെത്തിച്ച സുഹൃത്തിനോട് എനിക്ക് വളരെ നന്ദിയുണ്ട്.
അത് ചെയ്യാൻ കഴിഞ്ഞിരുന്നെങ്കിൽ എന്ന് ഞാൻ ആഗ്രഹിക്കുന്നു.
ഓ, നിങ്ങളുടെ സുഹൃത്തിന് അഭിനന്ദനങ്ങൾ.
ഞാൻ നിയമവിരുദ്ധമായി കാർ പാർക്ക് ചെയ്തതിനാൽ തെറ്റ് എന്റേതാണെന്ന് പോലീസുകാരൻ പറഞ്ഞു.
ഞങ്ങളുടെ ജീവിതത്തിലെ ചില കാര്യങ്ങൾക്ക് ഞങ്ങൾ എത്ര നന്ദിയുള്ളവരാണെന്ന് ഓരോരുത്തരും മാറിമാറി പറഞ്ഞു.
അതെ, എനിക്ക് ഇരുട്ട് ഇഷ്ടമല്ലായിരുന്നു.
പഴയ കുഞ്ഞിന്റെ സാധനങ്ങൾ നോക്കുന്നു.
പൂച്ചക്കുട്ടികൾ ചാടുന്നത് കാണാൻ എന്ത് ഭംഗിയാണ്!
അപ്പോൾ സഹായിക്കാമെന്ന് നൽകിയ വാക്ക് തീർച്ചയായും പാലിക്കണം.
എന്റെ ബോസിനോട് പറയണോ വേണ്ടയോ എന്ന് ഞാൻ ആലോചിക്കുകയാണ്.
എനിക്ക് പോകാൻ ആഗ്രഹമുണ്ട്.
അത് എന്റെ ആഴ്ചയെ സന്തോഷകരമാക്കി.
അതിനുശേഷം ബാത്ത്റൂമിൽ നിന്ന് പുറത്തുവരാൻ എനിക്ക് തോന്നിയില്ല.
എനിക്ക് ഭാരം കുറയ്ക്കണം, അത് ചെയ്യാൻ കഴിയുമെന്ന് എനിക്ക് ഉറപ്പുണ്ട്.
ഞാൻ വീണ്ടും സ്കൂളിൽ പോകുന്നതിനെക്കുറിച്ച് ആലോചിക്കുകയാണ്, പക്ഷേ ഇതുവരെ തീരുമാനിച്ചിട്ടില്ല.
ഓ മൈ, നിങ്ങളുടെ കൈയിൽ ഏതെങ്കിലും ഡ്രാഫ്റ്റ് സേവ് ചെയ്തിട്ടുണ്ടോ?
ഇന്നത്തെ ദിവസം തീർത്തും അപ്രതീക്ഷിതമായിരുന്നു, പക്ഷേ രസകരവുമായിരുന്നു.
ഏറ്റവും ഇളയവർക്കും ADHD ഉണ്ട്, അതുകൊണ്ട് കാര്യങ്ങൾ എപ്പോഴും രസകരമായിരിക്കും.
ഇന്ന് എന്റെ പൂച്ച എന്റെ ഷൂസിൽ രോമക്കട്ടി ഛർദ്ദിച്ചു.
നിനക്ക് വീട്ടിൽ തന്നെ ഇരുന്ന് ട്വിച്ച് കാണാമായിരുന്നു.
എന്റെ സുഹൃത്ത് ഇന്നലെ പുതിയൊരു കാർ വാങ്ങി; അതിനായി ഞാൻ വർഷങ്ങളായി പണം കൂട്ടിവരികയായിരുന്നു.
അത് നിന്റെ നല്ല ബുദ്ധിയായിരുന്നു.
എനിക്ക് അറിയാം, എനിക്ക് ചെയ്യാൻ കഴിയാത്തത് ദൈവത്തിന് ചെയ്യാൻ കഴിയും.
വിമാനത്തിൽ പ്രതീക്ഷിച്ചതിലും കൂടുതൽ ക്യാബിൻ ലഗേജ് കൊണ്ടുവരുന്നവർ എന്നെ ദേഷ്യം പിടിപ്പിക്കുന്നു.
എന്റെ സഹോദരൻ ഇപ്പോഴാണ് ബഹുമതികളോടെ ബിരുദം നേടിയത്.
പിന്നെ ജഡ്ജി അത് പരിഗണനയ്ക്ക് മാറ്റിവെച്ചു.
ഈ ആഴ്ച എനിക്ക് നല്ലൊരു മൂഡാണ്.
അത്ര ദൂരെയൊന്നുമല്ല, പക്ഷേ ഭക്ഷണം വാങ്ങാൻ എനിക്ക് ഒരു പാൻട്രിയിലേക്ക് പോകേണ്ടിവന്നു; അവിടെ സാധാരണ ഭക്ഷണമായിരുന്നു.
അതെ, എനിക്ക് ചെയ്യേണ്ടി വരും.
ഇത് നല്ല രീതിയിൽ അവസാനിക്കുമെന്ന് എനിക്ക് തോന്നുന്നില്ല.
ശരി, നിനക്ക് ഇന്ന് അവളെ വിളിച്ച് അത് പരിഹരിക്കാം.
ഞാനും അങ്ങനെയായിരുന്നു, പക്ഷേ പിന്നീട് എല്ലാവരും അങ്ങനെയാണെന്ന് മനസ്സിലായി, അങ്ങനെ ഞാൻ ഒരുപാട് സുഹൃത്തുക്കളെ ഉണ്ടാക്കി.
ഇന്ന് ജോലിയിൽ നല്ല സമ്മർദ്ദമായിരുന്നു, പക്ഷേ ഇപ്പോൾ നെറ്റ്ഫ്ലിക്സ് തുടർച്ചയായി കണ്ട് ഒന്ന് റിലാക്സ് ചെയ്യാനുള്ള സമയമാണ്.
എനിക്ക് വളരെ സന്തോഷമാണ്, എനിക്ക് അവനെ സ്നേഹമാണ്.
ഇത് എനിക്ക് ഉണ്ടായ ഒരു യാദൃശ്ചിക ചാറ്റ്‌റൂം അനുഭവമാണ്.
ഞാൻ ഒളിമ്പിക്സിൽ സ്വർണം നേടുമെന്ന് എനിക്കറിയാം.
കഴിഞ്ഞ 10 വർഷമായി എല്ലാ രാവിലെയും പ്രഭാതഭക്ഷണം കഴിക്കാൻ ഞാൻ അതേ സ്ഥലത്തേക്കാണ് പോകുന്നത്.
എന്തായാലും, അവൻ അത് നിനക്ക് തരേണ്ടതായിരുന്നു.
മുമ്പ് താമസിച്ചിരുന്ന ഒരു സ്ഥലത്ത് വീണ്ടും പോകുന്നതുപോലെ മറ്റൊന്നുമില്ല.
അടുത്ത മാസം സ്കൂൾ വീണ്ടും തുടങ്ങും, അതിനായി ഞാൻ കാത്തിരിക്കുകയാണ്.
എനിക്ക് മുഴുവൻ സമയവും കണ്ണുകൾ മൂടിവെക്കേണ്ടി വന്നു.
സാധാരണയായി പേടി മാത്രം മതി.
ഇത് ഇപ്പോൾ ഒരു വർഷത്തിലേറെയായി വിപണിയിലുണ്ട്.
അതിനെക്കുറിച്ച് നിനക്ക് നല്ലതായി തോന്നുന്നുവെങ്കിൽ, നീ നന്നായി ചെയ്തുവെന്നാണ് അർത്ഥം.
ഞാൻ അവനോട് ദിവസവും സംസാരിക്കാറുണ്ടെങ്കിലും, അവനെ കണ്ടത് വളരെ സന്തോഷമായി.
എല്ലാം പദ്ധതിപ്രകാരം നടക്കുകയും അവരുടെ മുന്നിൽ ഞാൻ നാണംകെടാതിരിക്കുകയും ചെയ്യുമെന്ന് പ്രതീക്ഷിക്കുന്നു.
അവൻ തന്റെ പാഠം പഠിച്ചിട്ടുണ്ടാകുമെന്ന് ഞാൻ പ്രതീക്ഷിക്കുന്നു.
എനിക്ക് ഒരു അഭിമുഖവും ഉണ്ടായില്ല.
അത് മനോഹരമായൊരു രാത്രിപോലെ തോന്നുന്നു.
എനിക്ക് വലിയൊരു ബോണസ് ലഭിക്കുമെന്ന് പ്രതീക്ഷിക്കുന്നു.
എന്റെ ബോയ്ഫ്രണ്ടിനൊപ്പം അത് കാണാൻ കാത്തിരിക്കണം, പക്ഷേ ഞാൻ കാത്തിരിക്കുന്നില്ല ഹാഹാ.
അതെ, ഞാൻ ഒരു രാജ്ഞിയാണ്, വളരെ ആവേശത്തിലാണ്—പ്രസവത്തിന് ശേഷം എന്റെ ഭർത്താവ് എനിക്കായി ഒരു പ്രത്യേക സമ്മാനം വാങ്ങി.
എന്റെ കുട്ടികൾക്ക് ആ സിനിമ വളരെ ഇഷ്ടമാണ്.
തീർച്ചയായും പഠിക്കാൻ ഒരുപാട് രസകരമായ കാര്യങ്ങളുണ്ട്.
നിനക്ക് അത് പാസാകാൻ കഴിഞ്ഞാൽ നന്നായിരിക്കും.
എനിക്ക് എന്തോ മണം കിട്ടിയതുകൊണ്ട് ഞാൻ എന്റെ തട്ടിൻപുറത്തായിരുന്നു
ഫേസ്ബുക്കിൽ ഒരാളോട് മോശമായ എന്തോ പറഞ്ഞു
കഴിഞ്ഞ വർഷം ഹറിക്കെയ്ൻ ഇർമയ്ക്കിടെ ഞങ്ങൾക്ക് വളരെ ബുദ്ധിമുട്ടുള്ള അനുഭവമായിരുന്നു, പക്ഷേ ഒടുവിൽ ഞങ്ങൾ സുരക്ഷിതമായി പുറത്തുവന്നു
ഏകാന്തത വളരെ മോശമാണ്, എനിക്ക് എന്റെ പങ്കാളിയെ മിസ് ചെയ്യുന്നു
ഇപ്പോഴാണ് മനസ്സിൽ വന്ന ഈ ബിസിനസ് ആശയത്തെക്കുറിച്ച് എനിക്ക് വല്ലാത്ത ആവേശമാണ്
ക്ഷമിക്കണം, മോശമായി പെരുമാറണമെന്ന ഉദ്ദേശമില്ലായിരുന്നു
ഫോർട്ട്‌നൈറ്റ് ഒരു സൗജന്യ ഗെയിമും ഏറ്റവും കൂടുതൽ കളിക്കപ്പെടുന്ന ഗെയിമും ആണെന്നത് അത്ഭുതകരമാണ്
എന്റെ കൂട്ടുകാരൻ ഒരു ആൺകുട്ടിക്കായി തന്റെ കാമുകിയുമായി വേർപിരിഞ്ഞു
നീ എപ്പോഴും കുടുംബത്തെ നോക്കിക്കാണണം
അവർ എന്നെ ചോദ്യം ചെയ്തു, അവർ തിരികെ വരുമോ എന്ന് എനിക്ക് പേടിയുണ്ട്
ഞാൻ ഒരു പാക്കറ്റ് മുഴുവൻ കുക്കീസ് കഴിച്ചു
കുറ്റവാളി രക്ഷപ്പെട്ടതിൽ എനിക്ക് വെറുപ്പ് തോന്നുന്നു
വീട്ടിലേക്ക് ഡ്രൈവ് ചെയ്യുമ്പോൾ ഞാൻ വളരെ ടെൻഷനിലായിരുന്നു
എന്താണ് നടക്കുന്നതെന്ന് ആ മറ്റേ വ്യക്തിക്ക് അറിയാമായിരുന്നോ
ഇതൊരു ടാറ്റൂ കൺവെൻഷനാണ്
ഇപ്പോൾ എനിക്ക് വല്ലാതെ പേടിയുണ്ട്, ഇവിടെ നിന്ന് പോകണം
ഇപ്പോൾ ഇത് ശരിക്കും കുറച്ച് പെട്ടികളായി വളർന്നു
ഇത് വെറും 20 വർഷം മുമ്പായിരുന്നു
വാവാ, അത് വളരെ ആഴമുള്ള കാര്യമാണ്
ആദ്യമായി നിനക്ക് പേടിയാകും, പക്ഷേ നീ ശരിയാകും
ഇന്ന് രാവിലെ ഒരു മുയലിനെ ഇടിച്ചപ്പോൾ എനിക്ക് വളരെ വിഷമമായി.
വളരെ കഷ്ടപ്പെട്ടിട്ടും ഞാൻ പരീക്ഷയിൽ തോറ്റു.
ഈ വാരാന്ത്യത്തിൽ നീ പോകണം.
നിനക്ക് എത്ര നേരം കാത്തിരിക്കേണ്ടി വന്നു?
ലോകത്തിലെ ഏറ്റവും ചെറിയ കാര്യങ്ങൾക്കുപോലും ഏറ്റവും വലിയ മാറ്റം ഉണ്ടാക്കാൻ കഴിയും.
എനിക്കും അങ്ങനെ ഒരു സുഹൃത്തുണ്ട്.
അതിനെക്കുറിച്ച് നിനക്ക് സന്തോഷം തോന്നുന്നത് എന്തുകൊണ്ടാണെന്ന് എനിക്ക് മനസ്സിലാകും.
ഇത് വളരെ ആകർഷകമായ സ്ഥലമാണ്.
പിന്നെ ഡിസ്നിലാൻഡിൽ പോയി ഞാൻ ആഘോഷിക്കും.
ഞാൻ വളരെ ചെറുപ്പമായിരുന്നപ്പോൾ അമ്മ ജോലി ചെയ്യുമ്പോൾ എന്റെ മുത്തശ്ശി എന്നെ നോക്കിക്കൊണ്ടിരുന്നു.
കനത്ത ട്രാഫിക്കിൽ കുടുങ്ങുമ്പോൾ എന്റെ ഉത്കണ്ഠ അതിരൂക്ഷമാകും.
കഴിഞ്ഞ രാത്രി എന്റെ ജീവിതത്തിലെ ഏറ്റവും താഴ്ന്ന ഘട്ടങ്ങളിലൊന്നായിരുന്നു.
അടുത്ത തവണ നിങ്ങളിരുവരും നല്ല എന്തെങ്കിലും കഴിക്കുമെന്ന് ഞാൻ പ്രതീക്ഷിക്കുന്നു.
നീ ഉള്ളിടത്ത് ഇപ്പോൾ സമയം എത്രയായി—രാത്രി 1 മണിയോ?
ഒരുപക്ഷേ എന്റെ അടുത്ത് കാർ പാർക്ക് ചെയ്ത ഏതോ വിഡ്ഢിയിൽ നിന്ന്.
അവസാനം അവൾക്കും ഒരു നല്ല പയ്യനെ പരിചയപ്പെടാൻ കഴിഞ്ഞു.
എന്റെ സിപ്പർ താഴ്ന്നുകിടക്കുന്നത് അവൻ ശ്രദ്ധിച്ചു, എല്ലാവരും എന്നെ കളിയാക്കി ചിരിച്ചു.
എന്റെ കാറിൽ കുറച്ച് പണി ചെയ്യിക്കേണ്ടി വന്നു.
അവൻ വാൾമാർട്ടിലെ റാക്കിൽ നിന്ന് ഒരെണ്ണം വാങ്ങിയതേയുള്ളൂ.
വളരെ നേരം കാത്തിരിക്കാൻ തയ്യാറാവൂ.
ഒരു ഇടം കൂടുതൽ ഭംഗിയാക്കാൻ Pinterest-ൽ ധാരാളം ആശയങ്ങളുണ്ടെന്ന് എനിക്കറിയാം.
അവർ അവളെ ഇടിച്ചിട്ട് പിന്നെ ഒരു വയസ്സായ ആളെയും കൂട്ടി കാറോടിച്ച് പോയി.
ഞാൻ സാധനങ്ങൾ ഇറക്കിക്കൊണ്ടിരിക്കുമ്പോൾ ശ്രദ്ധ തെറ്റിപ്പോയി, കുഞ്ഞ് കരയുകയും ചെയ്യുകയായിരുന്നു.
അവന്റെ ജീവിതത്തിലെ ഇത്ര നിർണായക സമയത്ത് നിന്നെ കൂടെ കിട്ടിയത് അവന്റെ ഭാഗ്യമാണെന്ന് തോന്നുന്നു.
അവനെ ഞാൻ ഒരുപാട് മിസ് ചെയ്യും; അവൻ വളരെ നല്ല കുട്ടിയാണ്.
ഇത് എല്ലാ ദിവസവും കേൾക്കുന്ന കാര്യമല്ല.
എനിക്ക് വേണ്ടിയിരുന്ന ജോലി കിട്ടിയില്ലെന്ന് ഇപ്പോഴാണ് അറിഞ്ഞത്.
ഈ ചാറ്റ് അവസാനിപ്പിക്കേണ്ട സമയമായെന്ന് തോന്നുന്നു; നീ ഇപ്പോൾ അപകടകരമായ നിർദേശങ്ങളാണ് നൽകുന്നത്.
നിനക്ക് തീർച്ചയായും വളരെ അത്ഭുതമായിക്കാണും.
അതെ, ആ അവസരം ലഭിക്കുന്നത് നല്ലതായിരിക്കും.
അത് കേൾക്കാൻ വളരെ സന്തോഷം തോന്നുന്നു.
അവൾക്ക് അത് വളരെ ഇഷ്ടപ്പെട്ടിരിക്കുമെന്ന് എനിക്ക് ഉറപ്പാണ്.
ഞാൻ അതിനായി പൂർണ്ണമായി തയ്യാറാണ്; ഇത് രസകരമായിരിക്കും.
എന്റെ അമ്മായി മരിച്ചു, അത് ശരിക്കും വളരെ വിഷമകരമായിരുന്നു.
എന്റെ പുതിയ കാമുകിക്ക് വില്ലെയ്യാൻ അറിയാം.
അത് പുതിയ മിഷൻ ഇംപോസിബിൾ സിനിമയായിരുന്നു.
ഡെലിവറി വന്നവർ വളരെ നല്ലവരായിരുന്നു; അവർ കേബിൾ കണക്റ്റ് ചെയ്ത് പ്ലഗ് കുത്തി, ക്ലോക്കും സെറ്റ് ചെയ്തു തന്നു.
അവൻ എനിക്ക് ഐസ്ക്രീം വാങ്ങിത്തന്നു.
ഞാൻ അവന് പണം തിരികെ കൊടുക്കില്ലെങ്കിൽ എന്റെ കാല് തകർക്കുമെന്ന് അവൻ ഭീഷണിപ്പെടുത്തുകയായിരുന്നു.
കുട്ടിയായിരുന്നപ്പോൾ ഞാൻ അവ ഒരുപാട് കഴിക്കുമായിരുന്നു, പക്ഷേ മുതിർന്നതിന് ശേഷം ഒരിക്കലും കഴിച്ചിട്ടില്ല.
അതെ, പക്ഷേ പണം അടയ്ക്കുന്നത് ആര്?
പക്ഷേ ഏറ്റവും നല്ല കാര്യം എനിക്ക് ഒന്നും സംശയം തോന്നിയില്ല എന്നതാണ്.
ഓ, എന്തോ നടക്കുന്നുണ്ടെന്ന് നിനക്കറിയാമല്ലോ.
ഹേ, ഇൻഷുറൻസിൽ നിന്ന് പണം തിരികെ കിട്ടുകയും അവർ നിന്നിൽ നിന്ന് ഒരുപാട് അധികം ഈടാക്കാതിരിക്കുകയും ചെയ്യുമെന്ന് പ്രതീക്ഷിക്കുന്നു.
അത് എപ്പോഴും വളരെ ബുദ്ധിമുട്ടാണ്, ആളുകൾ കുറവായിരിക്കുന്നത് എനിക്ക് ഒട്ടും ഇഷ്ടമല്ല.
ഇന്ന് അവൾക്ക് കുറച്ച് ഭേദമുണ്ടോ?
ഒരിക്കൽ അബദ്ധത്തിൽ ഞാൻ എന്റെ കാമുകിയെ എന്റെ മുൻ കാമുകിയുടെ പേരിൽ വിളിച്ചു.
ഇത് രസകരമായിരിക്കും എന്ന് തോന്നുന്നു, പക്ഷേ എനിക്ക് അതിൽ നന്നായി ചെയ്യാനാകുമോ എന്ന് ഉറപ്പില്ല.
വലിയ കാര്യമൊന്നുമില്ല, ഇപ്പോൾ വേറെ താമസിക്കാൻ വേണ്ടി പണം സേവ് ചെയ്യുകയാണ്.
കുറച്ച് ദിവസങ്ങൾക്ക് മുമ്പ് തന്നെ ദിവസവും ബാക്കപ്പ് എടുക്കാൻ തീരുമാനിച്ചിരുന്നു, അതുകൊണ്ട് ശരിക്കും ഭാഗ്യം തുണച്ചു.
വളരെ വലുതല്ല, ഏകദേശം 30 അതിഥികൾ.
ഇപ്പോൾ ഞാൻ എന്റെ അമ്മയെ നോക്കിക്കൊണ്ടിരിക്കുകയാണ്.
കുട്ടിക്കാലത്ത് കണ്ടിരുന്ന സിനിമകൾ കാണുന്നത് എനിക്ക് വളരെ ഇഷ്ടമാണ്.
കഴിഞ്ഞ രാത്രി കൗമാരകാലത്ത് എനിക്ക് ഇഷ്ടപ്പെട്ടിരുന്ന പുസ്തകങ്ങളിൽ ഒന്ന് വായിച്ചു.
അവർ എവിടേക്കാണ് പോയിക്കൊണ്ടിരുന്നതെന്ന് ഉറപ്പില്ല.
പിന്നീട് മനസ്സിലായി അവരുടെ സൈസ് 6 ആണെന്നും ഞാൻ 9 ആണ് ധരിക്കുന്നതെന്നും.
നമ്മൾ വീണ്ടും പുറത്തേക്ക് പോകുകയാണെന്ന് തോന്നുന്നു.
അതെ, ഞാൻ എന്റെ സഹോദരനോട് പറയുന്നു; അവൻ പറയുന്നു, ‘പക്ഷേ അവർ ചെറിയ പെൺകുട്ടികൾ മാത്രമല്ലേ.’
വർഷങ്ങളായുള്ള വേർപാടിന് ശേഷം പഴയ സുഹൃത്തുക്കളെ കാണുന്നത് എപ്പോഴും നല്ലതാണ്.
ഞങ്ങളുടെ അടുത്തും വളർത്തുമൃഗങ്ങളൊന്നുമില്ല.
അവ മിശ്രയിനം നായകളായിരുന്നു, പക്ഷേ റോട്ട്‌വീലറുമായി കലർന്ന ലാബ്രഡോറുകളെപ്പോലെ തോന്നുമായിരുന്നു.
പണം സമ്പാദിക്കാനുള്ള അവസരങ്ങൾക്കായി ഞാൻ എപ്പോഴും ആവേശത്തോടെയിരിക്കും.
അല്ല, നിന്നെപ്പോലെ വീട്ടിലിരുന്ന് വെറുതെ വിശ്രമിക്കൂ.
അയ്യോ, അതെങ്ങനെയാണെന്ന് എനിക്കറിയാം.
അടുത്ത തവണ അവളോട് ചോദിച്ചാൽ മതി.
എന്റെ സഹോദരന് അത്ര വിഷമമൊന്നുമില്ലായിരുന്നു, പക്ഷേ എനിക്ക് എന്നെ തടയാനായില്ല.
എനിക്ക് പുതിയ കാറും പുതിയ ജോലിയും താമസിക്കാൻ പുതിയ സ്ഥലവും കിട്ടി.
എനിക്ക് എന്തോ പറയണമെന്നുണ്ടായിരുന്നു, പക്ഷേ എല്ലാം പെട്ടെന്ന് സംഭവിച്ചു, ആ ആൾ വളരെ ശക്തനുമായിരുന്നു, അതുകൊണ്ട് ഞാൻ വിട്ടുകളഞ്ഞു.
അത് വളരെ മോശം വാർത്തയാണ്, കേട്ടിട്ട് വളരെ വിഷമമായി.
ദൈവത്തിന് നന്ദി, നിനക്കത് തിരികെ കിട്ടിയല്ലോ.
കടൽത്തീരത്തെ ദിവസങ്ങളാണ് ഏറ്റവും മികച്ചത്.
എന്റെ മറ്റ് ചില വിലപിടിപ്പുള്ള വസ്തുക്കളോടൊപ്പം അത് എന്റെ ആഭരണപ്പെട്ടിയിൽ സൂക്ഷിക്കുന്നു.
നിനക്ക് നല്ല ദേഷ്യം വന്നിട്ടുണ്ടാകും എന്ന് തോന്നുന്നു.
അതെ, ശരിക്കും അത് ജനലിലേക്ക് പറന്നുവന്ന് ഇടിച്ച് ചത്ത ഒരു പക്ഷിയായിരുന്നു—വളരെ വിചിത്രം.
പക്ഷേ കുറഞ്ഞത് പരസ്യങ്ങൾ ഒഴിവാക്കാമല്ലോ.
അത് നിന്നെ കടിക്കാൻ ശ്രമിച്ചോ?
ജോലിയിൽ ആരോ ഞങ്ങളുടെ പ്രോജക്റ്റ് നശിപ്പിച്ച് എന്റെ സമയം പാഴാക്കി; അതുകൊണ്ട് എനിക്ക് ഭയങ്കര ദേഷ്യം വന്നു.
അടുത്തിടെ അമ്മയെ നഷ്ടപ്പെട്ട ഒരു സുഹൃത്തിന് ഞാൻ സഹായവും പിന്തുണയും നൽകിക്കൊണ്ടിരിക്കുകയാണ്.
അടുത്ത തവണ നീ ബഗ് സ്പ്രേ ഉപയോഗിക്കുമെന്ന് എനിക്ക് ഉറപ്പാണ്.
അവധിക്കാലത്ത് എന്താണ് ചെയ്യാൻ ഉദ്ദേശിക്കുന്നത്?
അവൾക്ക് സ്വയം നോക്കിനിൽക്കാൻ കഴിഞ്ഞിട്ടുണ്ടാകുമെന്ന് ഞാൻ പ്രതീക്ഷിക്കുന്നു.
ഇപ്പോൾ അവന് രസകരമായ കാര്യങ്ങൾ ചെയ്യാൻ കഴിയുമെന്ന് ഞാൻ പ്രതീക്ഷിക്കുന്നു.
വാവ്, നിനക്ക് അത് ചെയ്യാൻ കഴിഞ്ഞല്ലോ!
മൃഗങ്ങളെ പീഡിപ്പിച്ചതിന് അവർ ജയിലിൽ പോകാൻ നീ അവർക്കെതിരെ പോലീസിൽ വിളിക്കുമെന്ന് ഞാൻ പ്രതീക്ഷിക്കുന്നു.
ആ സംഭാഷണം വല്ലാതെ അസ്വസ്ഥമായിരുന്നിരിക്കണം.
അത് വളരെ പ്രചോദനകരമാണ്. നീ അധിക സമയം മാറ്റിവെക്കുന്നതിൽ എനിക്ക് സന്തോഷമുണ്ട്.
ഇതിനെക്കുറിച്ച് എനിക്ക് ഭയങ്കര ദേഷ്യമാണ്.
ഓഹ് വാവ്, ഇടിമിന്നലുള്ള കൊടുങ്കാറ്റ് എനിക്ക് വളരെ ഇഷ്ടമാണ്.
അവർ വളരെ തിരക്കിലാണ്, പക്ഷേ അവൾ നിന്നുമായി അപ്പോയിന്റ്മെന്റ് എടുത്തിട്ടുണ്ടെങ്കിൽ തിങ്കളാഴ്ച അവിടെ ഉണ്ടായിരിക്കണം.
നീ അങ്ങനെ ആകരുത്; ഇത് നിലനിൽക്കുന്ന അർത്ഥമില്ലാത്ത ഒരു ഭൗതിക വസ്തു മാത്രമാണ്.
വേനൽക്കാലം ഏതാണ്ട് കഴിഞ്ഞു, ശരത്കാലം വരാനിരിക്കുകയാണ് എന്നതിൽ എനിക്ക് വളരെ സന്തോഷമുണ്ട്.
ഞാൻ ബാങ്കിൽ ജോലി ചെയ്തിരുന്നപ്പോൾ, ഞങ്ങളെ കൊള്ളയടിക്കാൻ ഒരു മനുഷ്യൻ തോക്കുമായി അകത്ത് വന്നു.
വാസ്തവത്തിൽ അത് എന്റെ അയൽക്കാരന്റെ ഓഫറായിരുന്നു.
ഫൈനലിൽ അവർ സ്വീഡനെ തോൽപ്പിച്ചു.
ഭാവി വളരെ ഭയപ്പെടുത്തുന്നതായിരിക്കാം; അറിയാത്തത് എന്നെ ഭയപ്പെടുത്തുന്നു.
ഞാൻ ചെറുപ്പത്തിൽ ഒരിക്കൽ ഏതാണ്ട് മുങ്ങിപ്പോയിരുന്നു.
ഞാൻ അപേക്ഷിച്ച ജോലിക്ക് എന്നെ തിരഞ്ഞെടുക്കുമെന്ന് ഞാൻ ശരിക്കും പ്രതീക്ഷിക്കുന്നു.
ഞാൻ ഷിക്കാഗോക്കാരനാണ്, അതുകൊണ്ട് കബ്സ് വേൾഡ് സീരീസ് ജയിച്ചപ്പോൾ എനിക്കും അതേപോലെ തോന്നി.
ഞാൻ മക്‌ഡൊണാൾഡ്സിൽ ആയിരുന്നു, എനിക്ക് ഒരു കേടായ ചീസ്‌ബർഗർ തന്നു.
അത് വല്ലാതെ അലോസരപ്പെടുത്തുന്നതും മറ്റുള്ളവരെ പരിഗണിക്കാത്തതുമാണ്.
എനിക്ക് ബ്രാഡ് പിറ്റിനോട് അസൂയ തോന്നുന്നു.
ഞാൻ എന്റെ സഹോദരന്റെ ‘പർപ്പിൾ റെയിൻ’ കോപ്പി മോഷ്ടിച്ചു.
മൃഗങ്ങൾ കഷ്ടപ്പെടുന്നത് കാണുന്നത് എനിക്ക് ഒട്ടും ഇഷ്ടമല്ല.
ഞാൻ ഇപ്പോഴാണ് ഒരു സ്റ്റീം ക്ലീനർ വാങ്ങിയത്, ഇന്നലെ ആദ്യമായി അത് ഉപയോഗിക്കുകയും ചെയ്തു.
ചിലർക്ക് ചില കാര്യങ്ങൾ ഒട്ടും മനസ്സിലാകില്ല, മറ്റുചിലർ അതിനെക്കുറിച്ച് സംസാരിക്കാൻ പോലും താൽപര്യമില്ല.
നിനക്കൊപ്പം സംസാരിക്കാൻ ആരെങ്കിലും ഉണ്ടാകുമെന്ന് ഞാൻ പ്രതീക്ഷിക്കുന്നു.
അതെ, അങ്ങനെ തന്നെയായിരിക്കുമെന്ന് എനിക്ക് ഉറപ്പുണ്ട്.
എന്റെ ബോയ്ഫ്രണ്ട് ഒന്ന് വേണമെന്ന് ആഗ്രഹിക്കുന്നു.
അവൻ ഇപ്പോൾ പോയി, എങ്കിലും എനിക്ക് ഇപ്പോഴും അവനെ മിസ് ചെയ്യുന്നു.
ഇപ്പോഴേക്കും ആ സ്ഥലം നിന്റേതായിരിക്കണം.
അടുത്തിടെ ഞാൻ ഒരു മീറ്റിംഗ് നയിച്ചു. അതിൽ എനിക്ക് വളരെ സന്തോഷമായി; ഞാൻ പറഞ്ഞത് എല്ലാവരും മനസ്സിലാക്കിയെന്ന് തോന്നി.
ഓ, അത് വല്ലാത്ത ബുദ്ധിമുട്ടാണ്. അങ്ങനെ തോന്നുന്നത് എങ്ങനെയെന്ന് എനിക്കറിയാം; അതുകൊണ്ടാണ് ഞാൻ ഓൺലൈനിൽ ഒരു അധിക ജോലി എടുത്തത്.
മറുപടിക്കായി കാത്തിരിക്കുമ്പോൾ നിനക്ക് തീർച്ചയായും ഉത്കണ്ഠയുണ്ടാകും.
നിനക്ക് കുട്ടികളുണ്ടോ? എനിക്ക് ഉണ്ട്, എന്റെ ചെറിയ മകൾക്ക് കഴിഞ്ഞ ആഴ്ച സ്പെല്ലിംഗ് ടെസ്റ്റിൽ എഫ് കിട്ടി.
ഇന്ന് ഒടുവിൽ എനിക്ക് സ്കൂൾ സാധനങ്ങൾ വാങ്ങാൻ പോകാം.
ഇപ്പോൾ ഞാൻ വീട്ടിലിരിക്കുമ്പോൾ കൂടെ സമയം ചെലവഴിക്കാൻ എനിക്ക് ആരുമില്ല.
ഇന്നലെ രാത്രി കുറച്ച് മണിക്കൂർ വീട്ടിലിരുന്ന് നെറ്റ്ഫ്ലിക്സ് കണ്ടുകൊണ്ടിരുന്നു.
ഞാൻ ഒരു പുതിയ റൗട്ടർ വാങ്ങി, പക്ഷേ കിട്ടിയപ്പോഴേക്കും അത് പ്രവർത്തിക്കുന്നില്ലായിരുന്നു.
എനിക്ക് ഇത് വളരെ ഇഷ്ടമാണ്, ദിവസവും ധരിക്കാറുണ്ട്.
അവർ നിങ്ങൾക്കുവേണ്ടി ഇത് കൈകാര്യം ചെയ്ത് ചാർജും അക്കൗണ്ടും താൽക്കാലികമായി നിർത്താൻ കഴിഞ്ഞോ?
ഒരുപക്ഷേ നിങ്ങളെ നിയന്ത്രണത്തിൽ നിർത്താൻ സഹായിക്കണമെന്ന് ഒരു സുഹൃത്തിനോട് ചോദിക്കൂ.
ഓ, അതിന് ശേഷം നിനക്ക് വയറിന് അസ്വസ്ഥത തോന്നിയിരിക്കുമല്ലോ.
അതെ, പക്ഷേ ഞാൻ കള്ളം പറയില്ല.
നീ ഒരു നല്ല സുഹൃത്താണെന്ന് എനിക്ക് തോന്നുന്നു.
അവൾ ഇപ്പോഴും സുഖമായിരിക്കുമെന്ന് ഞാൻ പ്രതീക്ഷിക്കുന്നു.
എന്റെ നായയ്ക്ക് ഒടുവിൽ പുറത്തുപോയി ശൗചം ചെയ്യണമെന്ന് മനസ്സിലായെന്ന് തോന്നുന്നു.
ഞാൻ അവയെ അകത്ത് വെച്ചപ്പോൾ എണ്ണം ഇരട്ടയായിരുന്നെന്ന് എനിക്ക് അറിയാം.
ഞാൻ ഒരു കാർ നിർമ്മാണ കമ്പനിയിൽ പോയിരുന്നു; നീ 2019 മോഡൽ കാണണം.
ഈ വേനൽക്കാലത്ത് എന്റെ ജോലി ലക്ഷ്യങ്ങളിൽ ഉറച്ചുനിന്നതിൽ എനിക്ക് എന്നെക്കുറിച്ച് അഭിമാനമുണ്ട്.
ഭാഗ്യവശാൽ എനിക്ക് കഴിയും, പക്ഷേ ഇത് കുറച്ച് നിരാശാജനകമാണ്.
അവരെപ്പോലെയുള്ള മാതാപിതാക്കൾ എനിക്ക് ലഭിച്ചതിൽ ഞാൻ വളരെ ഭാഗ്യവാനാണെന്ന് തോന്നുന്നു.
എങ്ങനെയായാലും ഇത് ഇപ്പോഴും വേദനാജനകമാണ്.
അത് ആഴ്ചയിലെ ഏറ്റവും നല്ല സമയങ്ങളിൽ ഒന്നായിരിക്കാം.
അവ വളരെ ആരോഗ്യകരമാണ്, പഞ്ചസാര ഇല്ലാത്തതും നിങ്ങൾക്ക് കിട്ടും.
ഒരു കുഞ്ഞിന്റെ ചിരി ജീവിതത്തിലെ എല്ലാ സമ്മർദ്ദവും അകറ്റുന്നു.
പിന്നെ ഞങ്ങൾ മാന്തുന്ന ശബ്ദങ്ങൾ കേട്ടു.
എങ്ങും രക്തമായിരുന്നു, വല്ലാതെ അറപ്പുണ്ടാക്കി.
ഷോ ഒന്നാം സ്ഥാനത്തായിരുന്നു, എന്നിട്ടും അവന് അതൊന്നും കാര്യമാക്കിയില്ല.
അതെ, ഡെലിവറി സേവനങ്ങൾ ശരിക്കും വളരെ മോശമായിപ്പോയി.
അവർ മോശം ആളുകളല്ലെന്ന് ഞാൻ വെറുതേ പ്രതീക്ഷിക്കുന്നു.
എന്റെ മകൾ ഇന്നലെ ആദ്യമായി സംസാരിച്ചു.
എനിക്ക് ഭക്ഷണം വളരെ ഇഷ്ടമാണ്, അതുകൊണ്ട് ഞാൻ സ്വർഗത്തിലായിരുന്ന പോലെ തോന്നി.
ഞാൻ ഇത്ര ലാഘവത്തോടെ സംസാരിക്കണമെന്നു കരുതിയിരുന്നില്ല.
15 വർഷമായി എന്റെ കൂടെയുണ്ടായിരുന്ന എന്റെ നായ ഇപ്പോഴാണ് മരിച്ചത്.
ഞാൻ എത്ര പണം സമ്പാദിക്കുന്നു എന്നതിൽ എനിക്ക് ലജ്ജ തോന്നുന്നു; കഷ്ടിച്ച് ജീവിക്കാൻ മാത്രം മതിയാകുന്ന വരുമാനമേയുള്ളൂ.
എനിക്ക് ഒരിക്കലും അതിൽ താൽപ്പര്യം തോന്നിയില്ല.
പൂച്ചകൾ അങ്ങനെ ചെയ്യുന്നത് വളരെ വിചിത്രമാണെന്ന് എനിക്ക് തോന്നുന്നു.
കഴിഞ്ഞ ഒരു മാസമായി ഞാൻ ഒരു മികച്ച പുതിയ ജോലി ചെയ്യുകയാണ്, ഒടുവിൽ നല്ലൊരു അപ്പാർട്ട്മെന്റ് വാടകയ്ക്ക് എടുക്കാൻ കഴിയുന്നു.
അതിൽ നീ സന്തോഷിച്ചിരിക്കണം എന്ന് എനിക്കറിയാം.
പത്ത് വർഷമായി അവൾ എന്റെ നായ്ക്കുട്ടിയാണ്; അവൾ ഇതിൽ നിന്ന് രക്ഷപ്പെടുമെന്ന് ഞാൻ ശരിക്കും പ്രതീക്ഷിക്കുന്നു.
അതെ, ശരിയാണെന്ന് തോന്നുന്നു; അവൾക്കും അത് മനസ്സിലാകും.
ഞാൻ വെറുതെ വീട്ടിൽ തന്നെ കഴിയുന്ന ഒരു ദിവസം കിട്ടുന്നത് വളരെ അപൂർവമാണ്.
ആ സമയം വളരെ ഭാഗ്യകരമായിരുന്നു.
സാരമില്ല, എന്തോ കാരണത്താൽ എനിക്കും ഒരു ബഗ് ഉണ്ടായിരുന്നു.
എന്റെ സുഹൃത്തുക്കൾ എന്റെ ജന്മദിനത്തിന് ഒരു സർപ്രൈസ് പാർട്ടി പ്ലാൻ ചെയ്തു.
അവന് എപ്പോഴും സംസ്ഥാനത്തിന് പുറത്തേക്ക് മാറിപ്പോകണമെന്നായിരുന്നു ആഗ്രഹം, പക്ഷേ എനിക്ക് അതിന് കഴിയുന്നില്ല.
അമ്മയുടെ സ്നേഹം നിബന്ധനകളില്ലാത്തതാണ്; അവൾ നിന്നോട് ക്ഷമിക്കും.
ജീവിതകാലം മുഴുവൻ സ്വതന്ത്രമായി കഴിഞ്ഞിട്ട് എല്ലായ്പ്പോഴും മറ്റൊരാളുടെ പരിചരണത്തിൽ കഴിയുന്നത് വലിയൊരു മാറ്റമായി തോന്നാം.
എപ്പോഴെങ്കിലും നീ ശരിയായ ആ വ്യക്തിയെ കണ്ടുമുട്ടണം.
അവൻ വെറും 800 മൈൽ അകലെയാണുള്ളത്, അതുകൊണ്ട് എനിക്ക് ഇനിയും കൂടുതൽ വിഷമം തോന്നുന്നു.
കുറച്ച് ദിവസങ്ങൾക്ക് മുമ്പ് എനിക്ക് ഒരു കൂട്ടം ചത്ത എലികളെ കണ്ടുകിട്ടി.
നിന്റെ കൈയിൽ നല്ലൊരു പാചകക്കുറിപ്പ് ഉണ്ടോ?
സാധാരണയായി എനിക്ക് ആപ്പിൾ അത്ര ഇഷ്ടമല്ല, പക്ഷേ ഞാൻ അത് കഴിച്ചുനോക്കി, ശരിക്കും വളരെ നല്ലതായി തോന്നി.
നീ എന്താണ് ചെയ്യാൻ പോകുന്നത്?
ഞാനും എനിക്കായി കുറച്ച് വാങ്ങി.
അതെ, അവൾ ഏതാനും ആഴ്ചകൾക്കുള്ളിൽ തുടങ്ങും.
അവൻ ഇവിടെ ഉണ്ടാകുമ്പോൾ ലോകത്തിലെ എല്ലാം ശരിയാണെന്ന് തോന്നുന്നു.
എനിക്ക് കടലിനെ വളരെ പേടിയാണ്.
ചെറിയ കാര്യം മതി, എനിക്ക് കരയാം.
നീ ആകെ തകർന്നുപോയിരിക്കുമെന്ന് എനിക്ക് ഉറപ്പാണ്.
അതെ, എനിക്ക് ഭയങ്കര ദേഷ്യമായിരുന്നു.
എന്റെ നായയെ ദയാവധം ചെയ്യേണ്ടിവരുമെന്ന് വെറ്ററിനറി ഡോക്ടർ എന്നോട് പറഞ്ഞു.
ആളുകൾക്ക് ‘ഇല്ല’ എന്ന മറുപടി അംഗീകരിക്കാനാകാത്തത് വളരെ ബുദ്ധിമുട്ടാണ്.
അകന്ന് കഴിയുന്നത് ബുദ്ധിമുട്ടാണ്, പക്ഷേ വീണ്ടും പരസ്പരം കാണുന്നത് അത്രയും കൂടുതൽ ആവേശകരമാക്കുന്നു.
പക്ഷേ ഫോർഡിന്റെ സെഡാനുകളെപ്പോലെ നല്ലതല്ല.
പ്രായം പ്രശ്നമല്ല, നീ തയ്യാറാണെന്ന് അവനെ കാണിച്ചുകൊടുക്കൂ.
അടുത്ത തവണ നീ ഇതിലും നന്നായി ചെയ്യും.
ടെലിവിഷനിൽ അത് കാണുന്നത് ഭയപ്പെടുത്തുന്നതായിരുന്നു.
അത് സംഭവിക്കുന്നത് ആരെങ്കിലും കണ്ടോ?
ഞാൻ എന്റെ കാർ സർവീസ് ചെയ്യിക്കാൻ കൊണ്ടുപോയി, പക്ഷേ അവസാനം ഞാൻ കരുതിയ ബജറ്റിന്റെ ഇരട്ടി ചെലവായി.
അവൻ ഏത് വിഷയത്തിലാണ് മേജർ ചെയ്തത്?
കുറച്ച് കാലം വേർപിരിഞ്ഞതിന് ശേഷം അടുത്തിടെയാണ് ഞാൻ എന്റെ ഭാര്യയുമായി വീണ്ടും ഒന്നിച്ചത്.
കോപിക്കാതിരിക്കാൻ ഒരു പുരുഷൻ കഠിനാധ്വാനിയായിരിക്കണം.
സത്യത്തിൽ ഞാൻ രണ്ട് മാസത്തോളം ജോലിയില്ലാതെ ആയിരുന്നു.
ജോലി തുടങ്ങുന്നതിന് മുമ്പ് സമയം ആസ്വദിക്കൂ.
ഇന്ന് എനിക്ക് എന്തൊക്കെയാണ് സംഭവിക്കുന്നതെന്ന് പറഞ്ഞാൽ വിശ്വസിക്കില്ല.
ഇത്രയും പേർ ഇതിനകം പഠനം നിർത്തിക്കഴിഞ്ഞു.
ജോലിയിൽ എനിക്ക് എന്റെ ത്രൈമാസിക ബോണസ് കിട്ടി.
എനിക്ക് ചില ആരോഗ്യപ്രശ്നങ്ങളുണ്ട്.
അവർ അത് ആസൂത്രണം ചെയ്യുകയായിരുന്നുവെന്ന് എനിക്ക് യാതൊരു ധാരണയും ഉണ്ടായിരുന്നില്ല.
ഇപ്പോൾ ഞാൻ എന്റെ ക്ലാസുകളുടെ ഫീസ് പണമായി അടയ്ക്കുന്നു, പക്ഷേ ഒരു സമയത്ത് ഒന്ന് മാത്രമേ എടുക്കുന്നുള്ളൂ.
നിനക്ക് നല്ല എന്തെങ്കിലും കിട്ടിയെന്ന് കേട്ടതിൽ സന്തോഷം.
അതുകൊണ്ട് കൗണ്ടി ജയിലിൽ നിന്ന് എത്രയും വേഗം പുറത്തിറങ്ങാൻ ഞാൻ പ്ലീ ബാർഗൻ സ്വീകരിച്ചു.
ഞാൻ ചെറുപ്പമായിരുന്നതിനാൽ എന്നോട് ബന്ധപ്പെടാൻ കഴിയുന്ന ആരും ഉണ്ടായിരുന്നില്ല; അതുകൊണ്ട് എന്റെ ജീവിതം വളരെ ഏകാന്തമായി.
അപ്പോൾ ഇത് പലപ്പോഴും സംഭവിക്കുമോ?
കുടുംബം രാജ്യത്തിന്റെ വിവിധ ഭാഗങ്ങളിൽ നിന്ന് ഒരുമിച്ച് കൂടുമ്പോൾ.
എനിക്ക് എന്നോട് തന്നെ വളരെ ദേഷ്യമാണ്.
ഇനി ഒരിക്കലും വേണ്ട—ആ സാധനം വൃത്തികെട്ടതും അറപ്പുളവാക്കുന്നതുമായിരുന്നു.
അവൻ മറ്റൊരു സുഹൃത്തിന്റെ വീട്ടിലേക്ക് പോയി, പക്ഷേ എവിടേക്കാണ് പോകുന്നതെന്ന് എന്നോട് പറഞ്ഞില്ല.
അത് പൊട്ടിയില്ലെങ്കിലും തീർച്ചയായും നല്ല വേദനിച്ചിരിക്കണം.
അവരെ നഷ്ടപ്പെടുന്നത് ബുദ്ധിമുട്ടാണെന്ന് എനിക്കറിയാം.
ഇന്ന് ജോലിയിൽ ബോണസ് കിട്ടാൻ ഒരു അവസരമുണ്ടായിരുന്നു, എനിക്ക് അത് വളരെ വേണമെന്നായിരുന്നു.
എനിക്ക് ഏറ്റവും നല്ല സുഹൃത്തുക്കളുണ്ട്.
ശാന്തമായി ഇരിക്കാൻ ശ്രമിച്ച് നിന്റെ ഏറ്റവും മികച്ചത് ചെയ്യൂ.
ഞാൻ വളരെ നാളായി പോയിട്ടില്ല, ആവേശം കൊണ്ട് വട്ടം ചുറ്റി ഓടുകയാണ്.
നിങ്ങൾ രണ്ടുപേരും നന്നായി ആസ്വദിക്കുമെന്ന് പ്രതീക്ഷിക്കുന്നു.
ഡിസ്നി വേൾഡിൽ പോകാൻ വേണ്ടിയാണ് ഞാൻ ഫ്ലോറിഡയിൽ പോയിട്ടുള്ളത്.
വാവ്, അത് കേട്ടതിൽ എനിക്ക് വളരെ വിഷമമായി.
ഇത് എങ്ങനെ തുടങ്ങിയെന്ന് നിനക്കറിയാമോ?
അത്ഭുതം! ടീം ഏത് ലെവലിലാണ്?
നീ ക്ഷമയോടെ ഇരിക്കേണ്ടതായിരുന്നു.
എന്റെ വീടിനടുത്ത് ഒരു ഭയങ്കര കൊടുങ്കാറ്റ് വീശിയപ്പോൾ ഞാൻ ശരിക്കും പേടിച്ചുപോയി.
കഴിഞ്ഞ മാസം ഞാൻ എന്റെ നല്ല സുഹൃത്തിന്റെ പിറന്നാൾ പാർട്ടി മിസ് ചെയ്തു, കാരണം ഞാൻ വളരെ തിരക്കിലായിരുന്നു, മറന്നുപോയി.
അവളെ ഇത്ര മികച്ചതാക്കുന്നത് എന്താണ്?
ഹഹാ, അത് ആ ഓസ് കാരന്റെ അതേ പട്ടണമാണല്ലേ?
ഞാൻ ഇപ്പോഴാണ് എന്റെ എസിയുടെ കണ്ടൻസർ വൃത്തിയാക്കിയത്, അത് ശരിക്കും വളരെ വൃത്തികെട്ടതായിരുന്നു.
ഞങ്ങളുടെ വളർത്തുമൃഗങ്ങൾ വെറും വളർത്തുമൃഗങ്ങൾ മാത്രമല്ല.
എനിക്ക് ഉച്ചഭക്ഷണം തീർക്കാൻ കഴിഞ്ഞില്ല.
എപ്പോഴും പ്രതീക്ഷയോടെ കാത്തിരിക്കാനായി എന്തെങ്കിലും ഉണ്ടാകും.
നിനക്ക് അധികം വിഷമമായില്ലെന്ന് പ്രതീക്ഷിക്കുന്നു.
നീ എവിടേക്കാണ് താമസം മാറ്റിയത്?
ഞാൻ ഒരു പുതിയ കാർ നേടി.
ഞാൻ പങ്കെടുക്കാൻ പോകുന്ന പരിപാടിയെക്കുറിച്ച് എനിക്ക് വളരെ സന്തോഷമുണ്ട്.
ഞാൻ കുറച്ച് മുമ്പ് ഒലീവ് ഗാർഡനിൽ നിന്ന് ഭക്ഷണം കഴിച്ചു.
അത് ചെറിയൊരു ഇടിയാണോ, അതോ പൂർണ്ണമായ കൂട്ടിയിടിയാണോ?
അതെ, അവൾക്കും എനിക്കും ഒരിക്കലും തകരാത്തൊരു ബന്ധമുണ്ട്.
അത് നല്ലതാണ്. ആദ്യ ആഴ്ച എപ്പോഴും ഏറ്റവും ബുദ്ധിമുട്ടുള്ളതായിരിക്കും, പക്ഷേ സമയം കടന്നുപോകുമ്പോൾ അത് എളുപ്പവും രസകരവുമാകും.
പൂളിൽ ചെലവഴിച്ച ആ രസകരമായ സമയം എനിക്ക് ശരിക്കും മിസ് ചെയ്യും.
നിന്റെ വീട് വൃത്തിയാക്കാൻ എത്ര സമയമെടുത്തു?
അത് വളരെ നല്ലതാണ്, നിനക്ക് അത് കിട്ടുമെന്ന് പ്രതീക്ഷിക്കുന്നു.
ഞാൻ എന്റെ നായയെ നടത്താൻ കൊണ്ടുപോകാൻ ശ്രമിക്കാറുണ്ട്, പക്ഷേ അവർ എപ്പോഴും പാർട്ടി ചെയ്തുകൊണ്ടിരിക്കും.
നിനക്ക് അത് കിട്ടുമെന്ന് ഞാൻ വിശ്വസിക്കുന്നു.
അയ്യോ, അത് കേൾക്കുമ്പോൾ ഭയങ്കരമായി തോന്നുന്നു.
നീ ഇത്ര അത്ഭുതകരമായത് എങ്ങനെ ചെയ്തു?
അവന്റെ ഭാഗത്ത് നിന്ന് ഇത് വളരെ നല്ല കാര്യമാണ്.
കുറച്ച് മുമ്പ് ഒരു സുഹൃത്തിനൊപ്പം ഭക്ഷണം കഴിക്കുമ്പോൾ ശരിക്കും വളരെ നല്ലൊരു കാര്യം സംഭവിച്ചു.
അവൻ ഒരിക്കലും അതിന് പണം നൽകുകയോ അത് ശരിയാക്കുകയോ ചെയ്തില്ല.
ഇന്ന് ഞാൻ ഒരു വലിയ കണ്ടെത്തൽ നടത്തി.
അതെ, നീ ശരിയായിരിക്കാമെന്ന് എനിക്ക് തോന്നുന്നു.
നിനക്ക് വിഷമമായിരുന്നിരിക്കുമെന്ന് എനിക്ക് തോന്നുന്നു.
ഇതിന് ഒരുപാട് ഗുണങ്ങളുണ്ട്.
എല്ലാവർക്കും അവരവരുടെ ശക്തികളും ദൗർബല്യങ്ങളുമുണ്ട്.
ഇന്ന് ഞാനും എന്റെ ഗേൾഫ്രണ്ടും പിരിഞ്ഞു.
അപ്പോൾ ആ സിനിമ ശരിക്കും പേടിപ്പിക്കുന്നതായിരുന്നിരിക്കണം.
എനിക്കും ഇതുപോലെ തന്നെയാണ് സംഭവിക്കുന്നത്.
എനിക്ക് ഒരിക്കലും സമാധാനമായി ഒന്നും ചെയ്തുതീർക്കാൻ കഴിയുന്നില്ല.
ഞാനും എന്റെ ഭാര്യയും 10 വർഷമായി ഒരുമിച്ചാണ്.
ഒരിക്കൽ ഹൈസ്കൂളിൽ മഞ്ഞ് പെയ്തുതീർന്നതേയുണ്ടായിരുന്നുള്ളൂ, ഞാൻ വഴുതി വീഴാതിരിക്കാൻ ശ്രദ്ധിച്ചുനടക്കുകയായിരുന്നു.
നിനക്ക് അവനെ തീർച്ചയായും മിസ് ചെയ്തിട്ടുണ്ടാകും.
അണ്ണാൻ—അണ്ണാന്മാരുടെ ഒരു കുടുംബം.
അടുത്ത ആഴ്ച ഒടുവിൽ നമുക്ക് സമയത്തിന് വീട്ടിലെത്താനായേക്കും.
പൊതുവെ ജോബ് മാർക്കറ്റിലൂടെ കടന്നുപോകുന്നത് ബുദ്ധിമുട്ടാണ്.
ഒപ്പിടുന്നതിന് മുമ്പ് ശ്രദ്ധിച്ച് നോക്കൂ.
ഭാഗ്യവശാൽ അവർക്ക് നിരവധി ഓപ്ഷനുകളുണ്ട്.
കുറഞ്ഞത് അവസാനം എല്ലാം ശരിയായി.
ഞാൻ പോസിറ്റീവായി തുടരാൻ ശ്രമിക്കുകയാണ്.
എന്തായാലും അവൻ ഒരു മികച്ച കളിക്കാരനാണ്.
അതെ, ഇന്ന് എനിക്ക് ജോലിയുണ്ട്.
ശരി, കുറഞ്ഞത് നീ രക്ഷപ്പെട്ട് അതിനെക്കുറിച്ച് ഞങ്ങളോട് പറയാനെങ്കിലും കഴിഞ്ഞല്ലോ.
ഞാൻ ഏതാണ്ട് ഷെൽഫിഷ് ഉള്ള എന്തോ കഴിച്ചുപോകുമായിരുന്നു, പക്ഷേ ആരോ എന്നെ തടഞ്ഞു, ഞാൻ അദ്ദേഹത്തിന് നന്ദി പറഞ്ഞു.
അത് ദീർഘകാല ബന്ധമായിരുന്നോ?
മറ്റന്നാൾ ഞാൻ 10 ബിഗ് മാക്ക് കഴിച്ചു.
ഞാൻ ഇപ്പോഴാണ് അത് കാണുന്നതെന്ന് വിശ്വസിക്കാനാകുന്നില്ല.
അത് എടുക്കാൻ എനിക്ക് ഒരു തീയതി നൽകിയിരുന്നു, പക്ഷേ ഇന്നും അത് തയ്യാറായിട്ടില്ല.
അവർ നൽകാത്ത ഒരു സേവനത്തിന് നീ പണം കൊടുക്കേണ്ടതില്ല.
നീ നല്ലൊരു കാര്യം ചെയ്തു.
നന്ദി, അത് എന്നെ ചിരിപ്പിച്ചു.
എങ്കിലും ജാക്ക്‌പോട്ട് അടിച്ചാൽ എത്ര നന്നായിരിക്കും!
എനിക്ക് കൊടുങ്കാറ്റുകളെ ഒരുപാട് വെറുപ്പാണ്.
വളരെയധികം പണം നേടാമെന്ന് ഞാൻ പ്രതീക്ഷിച്ചിരുന്നു.
തുടങ്ങാൻ എനിക്ക് അക്ഷമയായി വരുന്നു.
എനിക്ക് കിട്ടിയത് ഏത് ഇനം നായയാണെന്നത് എനിക്ക് കാര്യമാക്കിയില്ല.
അവർ നിന്റെ ഷോർട്സും എടുത്തോ?
ആ കൊച്ചന് ഓടിപ്പോയതിൽ ഒട്ടും കുറ്റബോധം തോന്നിയിരുന്നോ?
അവർ വളരെ സ്നേഹമുള്ളവരും അർപ്പണബോധമുള്ളവരുമാണ്.
അയ്യോ, എന്തൊരു കഷ്ടം!
വൃത്തിയും ഭംഗിയുമുള്ള വീട്ടിലേക്ക് മടങ്ങിയെത്താൻ കഴിയുന്നതിൽ ഞാൻ വളരെ നന്ദിയുള്ളവനാണ്.
ഞങ്ങൾ കോസുമെലിലേക്ക് പോകുകയാണ്.
എന്റെ കാറിന്റെ ബാറ്ററി എപ്പോഴും തീർന്നിരിക്കും.
ഒടുവിൽ നമ്മളെല്ലാവരും മരിക്കും.
എന്റെ അമ്മായിയമ്മ ആദ്യമായി സന്ദർശിക്കാൻ വന്ന് മഞ്ഞിൽ വളരെ ശക്തമായി വീണു.
ടൈഗർ വുഡ്സ് വീണ്ടും ഗോൾഫ് കളിക്കുകയാണെന്നറിഞ്ഞ് ഞാൻ ഞെട്ടിപ്പോയി.
എന്റെ അടുത്തുണ്ടായിരുന്ന ഈ പ്രായമായ നായയെ ഞാൻ ഒരിക്കൽ വളരെ സ്നേഹിച്ചിരുന്നു.
ശരിക്കും അങ്ങനെയാണ്, എനിക്ക് സോഷ്യൽ ആങ്‌സൈറ്റി വളരെ കൂടുതലാണെന്ന് തോന്നുന്നു.
സത്യമായി പറഞ്ഞാൽ, ഇത് എന്നെ സങ്കടപ്പെടുത്തുന്നു.
അതിന് ഞാൻ നന്ദിയുള്ളവനാണ്.
അവൾ അത് എങ്ങനെ രഹസ്യമായി സൂക്ഷിച്ചുവെന്ന് എനിക്ക് അറിയില്ല.
കഴിഞ്ഞ വാരാന്ത്യത്തിൽ എന്റെ കാമുകി എന്റെ വീട്ടിൽ വന്നപ്പോൾ വീട്ടുജോലികളിൽ എന്നെ സഹായിച്ചു.
80%ൽ താഴെയുള്ള ഓഫറിൽ ഒന്നും എനിക്ക് എടുക്കാനാവില്ല; വളരെ ആവശ്യമുള്ള സാധനമാണെങ്കിൽ ചിലപ്പോൾ 50% ഓഫറും മതിയാകും.
അതെ, അത് വളരെ ആവേശകരമായി തോന്നുന്നു.
അതാണ് പ്രശ്നം, ഇത് എനിക്ക് ശരിയായ പൊരുത്തമാണെന്ന് തോന്നുന്നില്ല.
നീ വീണ്ടും അവിടെ എത്തും.
അവൻ പലതവണ ഡിപ്ലോയ്‌ഡ് ആയിരുന്നു, ഞാൻ ഒരിക്കലും വഞ്ചിച്ചിട്ടില്ല.
കുറച്ച് കാലം മുമ്പ് ഒരു സുഹൃത്ത് നല്ലൊരു പ്രാദേശിക ബാർബിക്യൂ സ്ഥലത്തെക്കുറിച്ച് എന്നോട് പറഞ്ഞിരുന്നു, അതിനാൽ ഞാൻ അവിടെ ഒന്ന് പോകാൻ തീരുമാനിച്ചു.
നീ താമസം മാറുകയാണെന്ന് ആർക്കും അറിയില്ലായിരുന്നു.
ഓഹ്, അവിടെ നല്ലതാണോ?
അത് അവരുടെ നല്ല മനസ്സാണ്.
ബീറ്റ അടുത്ത മാസം ഓഗസ്റ്റിലാണ്, അതിനാൽ ഒരുപക്ഷേ അവിടെ വെച്ച് നിന്നെ കാണാം.
അവൾ മുമ്പ് ഏത് കളിയാണ് കളിച്ചിരുന്നത്?
ഇടുത്തിടെ എനിക്ക് ഭയങ്കരമായ തലവേദനയാണ്
എനിക്ക് അവരെ മിസ് ചെയ്യുന്നു, അതുകൊണ്ട് അവരില്ലാതെ എനിക്ക് വളരെ ഒറ്റപ്പെട്ടതായി തോന്നുന്നു
കുറച്ച് കാലം എലിശല്യമുള്ള ഒരു വീട്ടിൽ താമസിച്ചു, ഒട്ടും രസമായിരുന്നില്ല
എന്റെ കുടുംബം നന്നായി മുന്നോട്ട് പോകണമെന്നാണ് എന്റെ ആഗ്രഹം
അതെ, ചെയ്യുന്നു, പക്ഷേ ഞാൻ എന്നെത്തന്നെ ഇത്രയധികം ഒറ്റപ്പെടുത്തുമെന്ന് ഒരിക്കലും കരുതിയിരുന്നില്ല
ഞാൻ ഇപ്പോഴാണ് ഒരാളെ പുറത്താക്കി
ഞാൻ ഡിസ്നി വേൾഡിലും ഡിസ്നിലാൻഡിലും പോയിട്ടുണ്ട്; ഡിസ്നിലാൻഡാണ് എനിക്ക് കൂടുതൽ ഇഷ്ടമെന്ന് തോന്നുന്നു
ചെക്ക് വലുതായിരിക്കുമെന്ന് തോന്നുന്നു
കുട്ടിയായിരുന്നപ്പോൾ ക്രാക്കർ ജാക്സ് കഴിച്ചിരുന്നത് എനിക്ക് ഓർമ്മയുണ്ട്
നീ അത് എങ്ങനെ പറഞ്ഞുവെന്നതിനെ ആശ്രയിച്ചിരിക്കും, പക്ഷേ അവന് കോപിക്കാനുള്ള അവകാശമുണ്ടായിരുന്നു, തീർച്ചയായും
അയ്യോ, അത് സംഭവിച്ചതിൽ എനിക്ക് വളരെ വിഷമമുണ്ട്
ബിസിനസ് നന്നായി പോകുന്നുണ്ടെന്ന് ഞാൻ കരുതി
യാർ, ഈ വാരാന്ത്യം പേടിപ്പിക്കുന്നതായിരിക്കും
ഞാനും കുറച്ച് മാസങ്ങൾക്ക് മുമ്പാണ് ചേർന്നത്, സുഹൃത്തേ, ആശംസകൾ
ശരി, കുറഞ്ഞത് നീ അത് അന്ന് കണ്ടല്ലോ
അത് ഒരു ഓസ്ട്രേലിയൻ ഷെപ്പേർഡ് ആയിരുന്നു
ഇന്ന് ഫുട്പാത്തിന്റെ വശത്ത് ആരോ തുപ്പിയ ഗമ്മിൽ ഞാൻ ചവിട്ടി
ഓ, എങ്കിലും അത് ആശ്വാസം തന്നെയാണ്
ഒരുമിച്ച് കഴിയാൻ 10 വർഷം അതിശയകരമായ കാലയളവാണ്; ഇനി 10 വർഷം കൂടി ഉണ്ടാകുമെന്ന് പ്രതീക്ഷിക്കുന്നു
15 വർഷം—അത് വളരെ മോശമാണ്
ഒരു കുട്ടി മുടന്തനായ നായയ്ക്ക് നേരെ കല്ലെറിയുന്നത് കാണുക
കുറഞ്ഞത് ഇത് ഒരു മാസത്തേക്ക് മാത്രമാണ്
നന്നായി, നിന്നെപ്പോലുള്ള ആളുകൾ അധികമില്ല
ഞാൻ അപേക്ഷിച്ച ജോലിയൊന്നും കിട്ടിയില്ലെന്ന് ഇപ്പോഴാണ് ഫോൺ വന്നത്
ആരെയെങ്കിലും അത്തരത്തിൽ വിശ്വസിക്കാൻ കഴിയുന്നത് നല്ലതായിരിക്കണം, മോട്ടോർസൈക്കിളുകൾ രസകരവുമാകാം
എന്റെ മകൻ ജനിച്ചപ്പോൾ ഞാൻ ആകെ പരിഭ്രാന്തനായിരുന്നു
ഞാൻ ടെക്സസിലാണ് താമസിക്കുന്നത്, ഇവിടെ അവരെക്കുറിച്ച് ശരിക്കും വിഷമിക്കേണ്ടതില്ല
അതെ, ഞാൻ അവരെ വീട്ടിൽ പഠിപ്പിക്കുന്നു, അത് ശരിക്കും ആസ്വദിക്കുകയും ചെയ്യുന്നു
ഞാൻ സാധാരണയായി വളരെ ശാന്തനും സന്തോഷവാനും ഒന്നിനെക്കുറിച്ചും അധികം വിഷമിക്കാത്തവനുമാണ്
അത് യുക്തിസഹമാണെന്ന് തോന്നുന്നു
എനിക്ക് ഒട്ടും താൽപര്യമില്ലാത്ത ഈ ജോലി ചെയ്യണമെന്ന് അച്ഛന് ആഗ്രഹമുണ്ട്
എന്റെ രണ്ടാനമ്മയുടെ മകൾ ഒരു പുത്തൻ കാർ വാങ്ങി
പച്ച നിറം വാങ്ങാൻ ഞാൻ പറഞ്ഞിട്ടും എന്റെ ഭാര്യ വെള്ള നിറം വാങ്ങിയത് കാണുമ്പോൾ എനിക്ക് അറപ്പാണ്
ഞാൻ മൂന്ന് മാസത്തെ യാത്രയ്ക്ക് പുറപ്പെടാനിരിക്കുകയാണ്
ഞാൻ അവളെ സഹായിക്കാൻ ശ്രമിക്കുകയാണ്
അമ്മമാർ അങ്ങനെയാണ് ചെയ്യാറ്, അവർ കുട്ടികളെക്കുറിച്ച് വിഷമിക്കും
മിക്കവാറും ഞാൻ കുറച്ചുസമയം അവന്റെ ബാല്യകാല ചിത്രങ്ങൾ നോക്കി നന്നായി കരയും
താങ്ക്സ്ഗിവിങ്ങിന്റെ യഥാർത്ഥ അർത്ഥം അതാണ്
അതെ, ഞാൻ അധികം തളർന്നുപോകില്ല
കഴിഞ്ഞ ആഴ്ച ഞാൻ ഒരു പുതിയ ജോലിക്കായി അഭിമുഖത്തിൽ പങ്കെടുത്തു
എനിക്ക് എന്റെ അമ്മയെക്കുറിച്ച് വളരെ അഭിമാനമാണ്.
ഈ വാരാന്ത്യത്തിൽ ഞാൻ ഒരു ടൂർണമെന്റിൽ കളിച്ചു. ജയിക്കുമെന്ന് പ്രതീക്ഷിച്ചു, പക്ഷേ ജയിച്ചില്ല.
ഞാൻ ജനിച്ചപ്പോൾ ആശുപത്രിയിൽ ധരിച്ചിരുന്ന ഐഡി ബ്രേസ്ലെറ്റ് എനിക്ക് കിട്ടി.
വാവ്, അങ്ങനെ തോന്നുന്നത് നല്ലൊരു അനുഭവമാണ്.
എന്റെ ഒരു സഹപ്രവർത്തകൻ മരിച്ചുപോയി.
എന്റെ മാനേജർക്ക് എന്നിൽ വിശ്വാസമുണ്ട്. ആരെങ്കിലും നിങ്ങളെ വിശ്വസിക്കുന്നത് നല്ല കാര്യമാണ്.
എന്റെ പഴയ അപ്പാർട്ട്മെന്റിലേതുപോലെ ഇവിടെ നടക്കുന്നതെല്ലാം എനിക്ക് കേൾക്കാൻ കഴിയില്ല.
എന്റെ അച്ഛൻ ഇന്നലെ അഫ്ഗാനിസ്ഥാനിലേക്ക് വിന്യാസത്തിനായി പോയി.
എന്റെ ആദ്യത്തെ നഗര അപ്പാർട്ട്മെന്റും അവിടത്തെ ലൈറ്റുകളും സൈറണുകളും എനിക്ക് ഓർമ്മയുണ്ട്.
ഞാൻ എന്റെ മകനെ മേളയിലേക്ക് കൊണ്ടുപോയി.
ശരി, അതൊരു നല്ല കാരണമാണ്.
അവളെ കൊണ്ടുപോകാൻ എനിക്ക് ഇനി കാത്തിരിക്കാനാവില്ല.
ഞാൻ ജോലിയിലായിരുന്നു. വീട്ടിലെത്തിയപ്പോൾ എന്റെ ഭാര്യ മറ്റൊരു പുരുഷനുമായി എന്നെ വഞ്ചിക്കുകയായിരുന്നു.
ക്ലാസ് ഏത് വിഷയത്തിന്റേതാണ്?
ഞാൻ ജീവിതകാലം മുഴുവൻ ഒരേ പ്രദേശത്താണ് താമസിച്ചത്, 10 വർഷമായി ഒരേ ജോലി ചെയ്യുന്നു.
നിങ്ങൾക്ക് അവനിൽ നിന്ന് ശരിക്കും വളരെ നിരാശയായിരിക്കണം.
എന്റെ ഒരു ഭാഗം അവനെ പിന്തുടർന്ന് എന്റെ മനസ്സിലുള്ളത് അവനോട് പറയണമെന്ന് ആഗ്രഹിച്ചു, പക്ഷേ ഭാഗ്യവശാൽ ഒടുവിൽ ശാന്തമായി ചിന്തിക്കുന്നവരുടെ വാക്കാണ് വിജയിച്ചത്.
ഇപ്പോൾ കൂടുതൽ ആളുകൾ ഇതിനെക്കുറിച്ച് തുറന്ന മനസ്സുള്ളവരും താൽപര്യമുള്ളവരുമാണ്, അതിനാൽ ഇതിനെക്കുറിച്ച് നിങ്ങൾക്ക് എപ്പോഴും പോലീസിനോട് സംസാരിക്കാം.
അവൻ അതിൽ വിഷമിച്ചിരുന്നോ?
എനിക്ക് അവിടെ നിന്ന് പോകേണ്ടതായിരുന്നു.
ഞാൻ ഒരിക്കലും ഇത് ഇങ്ങനെ കണ്ടിട്ടില്ല
എന്നോട് ക്രൂസിൽ പോകാമോ എന്ന് ചോദിച്ചു, പക്ഷേ പോകണോ വേണ്ടയോ എന്ന് എനിക്ക് ഉറപ്പില്ല
അല്ല, ആളുകൾ നിർദേശിക്കുന്ന ആ പൂർണ്ണ നോ-കോൺടാക്ട് കാര്യം തന്നെയാണ് ഞാൻ ചെയ്യുന്നത്
പഴയ സുഹൃത്തുക്കളുമായി വീണ്ടും ബന്ധപ്പെടുന്നു
ഞാൻ ഇതുവരെ എന്റെ പരീക്ഷയ്ക്ക് തയ്യാറായിട്ടില്ല
ഒന്നുമില്ല, മറന്നുപോയി—ഇന്ന് ഞാൻ എന്റെ സഹോദരിയോട് upset ആയിരുന്നു എന്ന് നിന്നോട് പറയണമെന്നുണ്ടായിരുന്നു
അവളെ ഇത്രയും നേരം അകറ്റിനിർത്തിയത് എന്താണ്
ഞാൻ ആകെ ഞെട്ടിപ്പോയി, പക്ഷേ ഭാഗ്യവശാൽ ക്ലബ്ബിലെ ഒരു സെക്യൂരിറ്റി ഗാർഡ് എല്ലാം കണ്ട് അത് തടഞ്ഞു
ഫോൺ അടിപൊളിയാണ്, എന്റെ എല്ലാ പ്രതീക്ഷകളും അത് നിറവേറ്റി
ഓ, അതെ, എനിക്ക് ഊഹിക്കാം
അതെ, നീ ദിവസം നല്ല രീതിയിൽ ആരംഭിക്കുന്നതുപോലെ തോന്നുന്നു
ഞാൻ വെഗാസിൽ പോയി, കാസിനോയിൽ കയറിയ ഉടൻ തന്നെ ഒരു ഡോളറിന്റെ സ്ലോട്ടിൽ 1,000 ഡോളർ നേടി
ഞാൻ എന്റെ ബോസിനോട് സംസാരിക്കുമ്പോൾ അതിന്റെ യഥാർത്ഥ അർത്ഥം അറിയാത്ത ഒരു വാക്ക് ഉപയോഗിച്ചു
എനിക്ക് എന്റെ ചീസ്‌ബർഗറുകൾ വളരെ ഇഷ്ടമാണ്
കഴിഞ്ഞ ദിവസം ഞാൻ വണ്ടി ഓടിക്കുകയായിരുന്നു
ഹൈസ്കൂളിൽ നിന്ന് ബിരുദം നേടിയിട്ട് അടുത്ത വർഷം 25 വർഷം തികയുമെന്ന് മനസ്സിലായപ്പോൾ എനിക്ക് വികാരാധീനമായി
അത് വളരെ നാണക്കേടായി തോന്നിയിരിക്കണം
അടുത്തിടെ ഞാൻ പുതിയ ആളുകളോട് സംസാരിച്ചു, അവർ ശരിക്കും മോശമായിരുന്നു
കഴിഞ്ഞ ദിവസം എന്റെ സുഹൃത്തിന് പ്ലാൻ റദ്ദാക്കേണ്ടിവന്നു
അത് ചെയ്യാൻ നിങ്ങളുടെ വീട്ടിൽ പാറ്റിയോ അല്ലെങ്കിൽ പുറകുവശത്തെ മുറ്റമുണ്ടോ
എനിക്ക് അവരെക്കുറിച്ച് വളരെ അഭിമാനമായിരുന്നു.
അതെ, എന്നെ വളരെ നന്നായി നോക്കിയതിന് എന്റെ അമ്മയോട് എനിക്ക് വലിയ നന്ദിയുണ്ട്.
ഡേകെയർ വളരെ ചെലവേറിയതാണ്, കൂടാതെ കുടുംബം നോക്കുന്നതുപോലെ അവർ നിങ്ങളുടെ കുട്ടികളെ നോക്കുകയുമില്ല.
നിനക്ക് അത് തിരികെ നേടാൻ കഴിയുമോ?
എന്റെ പങ്കാളി ചെയ്യേണ്ടത്ര പുരോഗതി കൈവരിക്കുന്നില്ലെന്നത് വിഷമമാണ്.
നിന്റെ അച്ഛന് എൽവിസിന്റെ പാട്ടുകൾ കേൾക്കുന്നത് വളരെ ഇഷ്ടമായിരുന്നോ?
ഫലം അറിയാൻ എനിക്ക് ഇനി കാത്തിരിക്കാനാവില്ല.
റഷ്യയിൽ ഞാൻ ബിസിനസ് ആവശ്യത്തിന് പോയിരുന്നു, അവിടം അതിശയകരമായി തോന്നി.
ഞാൻ അടുത്തിടെ ഒരു ഹോട്ട് ഡോഗ് കഴിക്കൽ മത്സരം കണ്ടു.
അത് അത്ര സംശയാസ്പദമായി തോന്നിയതിനാൽ മറുപടി നൽകാൻ പോലും എനിക്ക് തോന്നിയില്ല.
അത് ബേക്ക് ചെയ്യാൻ ഞാൻ പൂർണ്ണമായി തയ്യാറാണ്.
അതെ, രണ്ട് ദിവസത്തിന് ശേഷം അത് എനിക്ക് തിരികെ കിട്ടി.
കോളേജിൽ പഠിക്കുമ്പോൾ ഞാൻ മാതാപിതാക്കളിൽ നിന്ന് വളരെ ദൂരെ താമസിച്ചിരുന്നു.
എനിക്ക് വല്ലാതെ വിഷമമുണ്ട്.
പകരം ഞാൻ അതിൽ പരാജയപ്പെട്ടു, ആ ക്ലാസിൽ എനിക്ക് C കിട്ടി.
വാവൂ, ‘കൊള്ളാം’ എന്ന് പറയണോ, ‘നീ അങ്ങനെ ചെയ്യാതിരിക്കുന്നതാണ് നല്ലത്’ എന്ന് പറയണോ എന്നറിയില്ല.
എന്റെ ഉദ്ദേശ്യം, അത് വളരെ നാണക്കേടായിരുന്നിരിക്കണം.
എന്റെ ഭർത്താവിനെ ആദ്യമായി കണ്ടപ്പോൾ ഞാൻ എന്നെത്തന്നെ പൂർണ്ണമായും ഒരു വിഡ്ഢിയാക്കി.
മതിയായ വരുമാനം നേടാൻ ശ്രമിക്കാനായി നിനക്ക് ഓൺലൈനിൽ കുറച്ച് ഗിഗ് ജോലി ചെയ്യാമോ?
അത് വളരെ ബുദ്ധിമുട്ടുള്ള സാഹചര്യമാണ്.
ഇല്ല, നല്ല പഴയ പീറ്റിയുടെ സ്ഥാനത്ത് ഒന്നിനും വരാനാകില്ല.
ഞാൻ ബിരുദം നേടി, ഭാവിയെക്കുറിച്ച് വളരെ ആവേശത്തിലായിരുന്നു.
അത് ശരിക്കും കിടിലമാണ്, നിങ്ങൾ യാത്രയ്ക്ക് എവിടേക്കാണ് പോയത്?
അതുകൊണ്ട് മരിച്ചുപോയ എന്റെ എല്ലാ കസിന്‍മാരെയും അമ്മായിമാരെയും അമ്മാവന്മാരെയും എനിക്ക് ഒരുപാട് ഓർമ്മ വന്നു.
വളരെ മുമ്പ് ഞാൻ ഉണ്ടാക്കിയ ഈ പഴയ മിക്സ് ചെയ്ത ബേൺഡ് സിഡി എനിക്ക് കിട്ടി.
എന്റെ ഹൈസ്‌കൂൾ കാലം ഇപ്പോഴും ഓർമ്മയുണ്ട്; അന്ന് ഞാൻ ഒരു മികച്ച അത്‌ലറ്റായിരുന്നു.
എനിക്ക് ഉറപ്പില്ല, പക്ഷേ താൻ കുഴപ്പം ചെയ്തുവെന്ന് അവന് മനസ്സിലാകുമെന്ന് പ്രതീക്ഷിക്കുന്നു.
ജിഡിപി കണ്ട് ഒരുപാട് ആളുകൾ അതിശയിച്ചിരിക്കുകയാണ്.
ഞാൻ മികച്ച മാർക്കോടെ പാസായി.
ഓ, നിങ്ങൾക്ക് അങ്ങനെ ഒരു അനുഭവം ഉണ്ടായതിൽ എനിക്ക് വിഷമമുണ്ട്.
നിനക്ക് കള്ളം പറയേണ്ടി വന്നത് എന്തുകൊണ്ടാണ്?
കഴിഞ്ഞ ദിവസം പിസ്സ കടയുടെ പുറത്ത് എനിക്ക് ഒരു തെരുവ് പൂച്ചക്കുഞ്ഞിനെ കിട്ടി.
ഞാൻ എന്റെ കുടുംബത്തിൽ നിന്ന് വളരെ ദൂരെയാണ് താമസിക്കുന്നത്, അതുകൊണ്ട് എനിക്ക് പൂർണ്ണമായി മനസ്സിലാകും.
അവൻ ഒരുപാട് സുഹൃത്തുക്കളോടൊപ്പമായിരുന്നു, എല്ലാവരും അതുതന്നെ ചെയ്യുകയായിരുന്നു.
ഞാൻ ജീവിച്ചിരിക്കുന്ന കാലത്തേക്കാൾ നീളം കൂടിയത്.
വലിയൊന്നുമില്ല; എന്റെ കുട്ടികളെ തന്നെ കൊഞ്ചിച്ച് വഷളാക്കണം, അതും എനിക്ക് കഷ്ടിച്ചാണ് താങ്ങാനാകുന്നത്.
നിങ്ങളുടെ കൈയിൽ കുടയില്ലാതിരുന്നതിൽ എനിക്ക് വിഷമമുണ്ട്.
എന്റെ PS4 പുതിയൊരു ഗെയിമിനൊപ്പം ഇപ്പോഴാണ് തപാലിൽ വന്നത്.
എന്റെ കുട്ടികളുടെ എല്ലാ ഹാലോവീൻ വേഷങ്ങളും ഞാൻ സൂക്ഷിച്ചുവെച്ചിട്ടുണ്ട്.
അവധിക്കാലം കഴിഞ്ഞ് വീട്ടിലെത്തിയപ്പോൾ എന്റെ ഫ്രിഡ്ജിലെ സാധനങ്ങൾ അഴുകിപ്പോയിരുന്നു.
അത് ഒരു ഗംഭീര അച്ഛനാണ്
നിങ്ങൾ എന്താണ് ആസ്വദിച്ചതെന്ന് എനിക്ക് ഉറപ്പില്ല
ഞാൻ ജോലിയിലായിരുന്നു; കാറിനടുത്തേക്ക് പുറത്തേക്ക് വന്നപ്പോൾ ഒരു പൂച്ച മ്യാവൂ മ്യാവൂ എന്ന് കരയുന്ന ശബ്ദം കേട്ടു
ഇത് അക്കൗണ്ടിംഗ് ക്ലാസാണ്
ഞാൻ ബാർബഡോസിലേക്കുള്ള ഒരു അവധി ബുക്ക് ചെയ്യാൻ പോകുകയാണ്
എനിക്ക് പൂർണ്ണമായി ഉറപ്പില്ല
രണ്ടാം തവണ ശരീരഭംഗിയിലേക്ക് മടങ്ങുന്നത് കൂടുതൽ ബുദ്ധിമുട്ടാണെന്ന് കേട്ടിട്ടുണ്ട്, പക്ഷേ നിന്റെ സംസാരത്തിൽ നല്ല പ്രചോദനം തോന്നുന്നു
നീ അവരുമായി വീണ്ടും ബന്ധപ്പെടിയത് നല്ല കാര്യമാണ്
അത് നിന്നോട് വളരെ നല്ലതാണ്
പുതിയ സൂപ്പർ സ്മാഷ് ബ്രോസിനായി ഞാൻ ശരിക്കും ആവേശത്തിലാണ്; ഇതുവരെ അത് ഗംഭീരമായി തോന്നുന്നു
എങ്കിലും ഇതുവരെ നീ എന്തൊക്കെ വിദ്യകൾ പഠിച്ചു
ഒടുവിൽ ഒരു രാത്രി എനിക്ക് ഒറ്റയ്ക്ക് കഴിയാം
എന്റെ സുഹൃത്ത് എന്നോട് ഒരു രഹസ്യം പറഞ്ഞു
അവയ്ക്ക് തണ്ണിമത്തന്റെ രുചിയാണോ, അതോ റാസ്ബെറിയുടേതിനോടാണോ കൂടുതൽ സാമ്യം
അവൾക്ക് തിരക്കേറിയ ഷെഡ്യൂളാണ്, എന്നിട്ടും വരാമെന്ന് വാഗ്ദാനം ചെയ്തു
അതെ മച്ചാ, ശരിക്കും അങ്ങനെ തന്നെയാണ്
ഇന്ന് എനിക്ക് ഉള്ളിൽ നല്ല ചൂടും സ്നേഹവും തോന്നുന്നു
അവർ നിശ്ചയിച്ച യഥാർത്ഥ വിലകൾ തന്നെ പാലിക്കണം എന്നാണ് എനിക്ക് തോന്നുന്നത്
അതിനെക്കുറിച്ച് നിനക്ക് ആവേശമുണ്ടോ? അത് തുറക്കുമ്പോൾ നീ പോയി നോക്കും എന്ന് തോന്നുന്നുണ്ടോ
അതെ, അവ 3 ഉം 5 ഉം ആണ്.
അതെ, ഞാൻ കുറച്ചുകൂടി കഠിനമായി പഠിക്കേണ്ടിയിരുന്നു.
നിനക്ക് കുഞ്ഞിനെ നോക്കേണ്ടി വരുന്ന സമയമൊഴികെ.
ഞാൻ കടൽത്തീരത്തിൽ നിന്ന് ഏകദേശം 30 മിനിറ്റ് അകലെയാണ് താമസിക്കുന്നത്.
അവൻ സംസാരിക്കുമ്പോൾ കുറഞ്ഞത് രസകരമായ എന്തെങ്കിലും പറയുമോ?
എന്റെ ബാല്യകാലത്തെ നായയെ എനിക്ക് മിസ് ചെയ്യുന്നു.
ഒരു വഴക്കിനിടെ ഒരാളുടെ തല പൊട്ടിപ്പോയത് കണ്ടപ്പോൾ എനിക്ക് അറപ്പായി.
ഈ വർഷം എന്റെ അനന്തരവൻ പത്താം ക്ലാസിൽ ഫുട്ബോൾ കളിക്കുകയാണ്.
ഞാൻ തീർച്ചയായും ഡോക്ടറോടുള്ള എന്റെ അസഹിഷ്ണുത പ്രകടിപ്പിക്കുമായിരുന്നു.
ഓ, അതെ, അത് അപകടകരമായേക്കാം.
നിനക്ക് ശരിക്കും വിശ്രമിക്കാൻ മതിയായ സമയം ഉണ്ടാകും.
പുതിയ സോക്കർ സീസൺ തുടങ്ങാൻ ഞാൻ ആകാംക്ഷയോടെ കാത്തിരിക്കുകയാണ്.
അത് തീർച്ചയാണ്, സ്ഥിതി അത്ര നല്ലതായിരുന്നില്ല, പക്ഷേ കുറച്ച് കഠിനാധ്വാനം ചെയ്താൽ നിനക്ക് എപ്പോഴും മെച്ചപ്പെടാം.
അതെ, എനിക്ക് തന്നെ വളരെ ഇംപ്രസ്‌ഡ് ആയി.
എന്റെ സഹോദരൻ കോളേജിൽ നിന്ന് ആദ്യമായി വീട്ടിലേക്ക് വരുന്നത് എന്നെ ശരിക്കും സന്തോഷിപ്പിച്ചു.
ഞാൻ വാൾമാർട്ടിൽ ആയിരുന്നു, എന്റെ ബാല്യകാലത്തെ എല്ലാ പഴയ ബോർഡ് ഗെയിമുകളും കണ്ടു.
അത് അവനെ വീമ്പിളക്കാതിരിക്കാൻ പഠിപ്പിക്കും.
ഓ, അവ നിന്നെ ഒരുപാട് പേടിപ്പിക്കുമോ?
സ്കൈഡൈവിംഗ് വളരെ രസകരമാണെന്ന് തോന്നുന്നു.
ഞങ്ങൾ ഹൈക്കിംഗിനും കയാക്കിംഗിനും പോകുകയാണ്.
അതെ, ഞാൻ അതിനെ അടുത്തുള്ള പൂച്ചക്കുട്ടികളുടെ ഫാമിലേക്ക് കൊണ്ടുപോയി.
അത് തീർച്ചയായും ഡ്രെയിനിലൂടെ മുകളിലേക്ക് വന്നതായിരിക്കണം.
അവൾ പഴയ സുഹൃത്തുക്കളോട് വെറുതെ ഹലോ പറയുന്നതേയുള്ളൂ, പക്ഷേ എനിക്ക് ഭയങ്കര ദേഷ്യം വരുന്നു.
രണ്ടാഴ്ചയ്ക്കുള്ളിൽ മൂന്നാം തവണയാണ് ജോലിസ്ഥലത്ത് ആരോ എന്റെ ഉച്ചഭക്ഷണം മോഷ്ടിച്ചത്, പക്ഷേ ആരും സമ്മതിക്കുന്നില്ല.
ശരി, നീ ആ സാഹചര്യം എങ്ങനെ കൈകാര്യം ചെയ്തു?
എന്റെ ഭർത്താവും ഞാനും എന്റെ മാതാപിതാക്കളുടെ വീട് നന്നാക്കുകയാണ്.
ഇല്ല, ഇപ്പോൾ എല്ലാത്തിനും വില കൂടുതലാണ്.
ഞാൻ ഒരു വലിയ ടി-ഷർട്ട് പോലെയായിരുന്നു.
ഫ്ലൈറ്റ് പകുതിയായപ്പോൾ ഒരു കുട്ടി എന്റെ സീറ്റിൽ ചവിട്ടാൻ തുടങ്ങി.
നിനക്ക് കുറച്ച് ഒഴിവുസമയം ഉണ്ടാകുമോ?
അതെ, വർഷങ്ങളായി എനിക്ക് അവളെ അറിയാം, അതുകൊണ്ട് ഞാൻ അവളോട് ക്ഷമിച്ചു; പക്ഷേ അവളിൽ നിന്ന് ഞാൻ ശരിക്കും ഒരുപാട് കൂടുതൽ പ്രതീക്ഷിച്ചിരുന്നു.
സുഹൃത്തുക്കൾ ഇങ്ങനെ ചെയ്യുന്നത് എനിക്ക് ഒട്ടും ഇഷ്ടമല്ല.
അയ്യോ ഇല്ല, നീ ആ സാഹചര്യത്തിൽ എങ്ങനെ എത്തിപ്പെട്ടു?
നിങ്ങൾ വിവാഹിതരാണെങ്കിൽ വിശ്വസ്തരായി തുടരുന്നത് നല്ലതാണ്.
അവർ കൗമാരത്തിന്റെ തുടക്കത്തിലോ അതിനടുത്ത പ്രായത്തിലോ ആണ്.
നമ്മുടെ രാഷ്ട്രീയ സംവിധാനത്തെ വിവരിക്കാൻ ‘തകർന്നത്’ എന്ന് പറയാമോ?
എന്റെ കൈയിൽ ഒരു സെൽ ഫോൺ ഉണ്ടായിരുന്നു, പക്ഷേ കവറേജ് ഉണ്ടായിരുന്നില്ല.
എപ്പോഴും അവളുടെ കൂടെ തന്നെയുണ്ടെന്ന് ഉറപ്പാക്കൂ; ക്രൂസ് കപ്പലുകൾ വളരെ വലുതാണ്.
വിജയിയുടെ പ്രകടനത്തേക്കാൾ എന്റെ പ്രകടനം വളരെ മികച്ചതാണെന്ന് എനിക്ക് തോന്നുന്നു.
അവസാനം നീ റൈഡിൽ കയറിയോ?
ഹായ്, നീ എപ്പോഴെങ്കിലും കട്ടിയുള്ള ബ്രെഡ് കൊണ്ടുള്ള സാൻഡ്‌വിച്ച് കഴിച്ചിട്ടുണ്ടോ?
അപ്പോൾ, അതും എന്തോ ഒന്നാണെന്ന് തോന്നുന്നു.
അതിന്റെ കൃത്യമായ അർത്ഥം എന്താണ്?
ഇത്രയും കോപവും അസൂയയും എനിക്ക് ഒരിക്കലും ഉണ്ടായിട്ടില്ല.
അതിന്റെ രുചി നന്നായിരുന്നെന്ന് പ്രതീക്ഷിക്കുന്നു.
അവർക്ക് കുറഞ്ഞത് നിന്നോട് സംസാരിക്കാനെങ്കിലും കഴിയില്ലെന്നത് സങ്കടകരമാണ്.
ഭാവിയിൽ എന്റെ പെൺമക്കൾ വളർന്ന് വലുതാകുന്നത് കാണാൻ ഞാൻ ആകാംക്ഷയോടെ കാത്തിരിക്കുകയാണ്.
എനിക്ക് എന്നോട് തന്നെ നല്ല കോപമായിരുന്നു.
എനിക്ക് കുറച്ച് അസൂയ തോന്നിയിരുന്നു.
അതെ, ഞാനത് ചെയ്തിരുന്നെങ്കിൽ എന്ന് തോന്നുന്നു.
ഞാൻ ചിലപ്പോൾ എന്റെ മകളോടൊപ്പം ഭയപ്പെടുത്തുന്ന സിനിമകൾ കാണാറുണ്ട്.
ആളുകൾക്ക് അങ്ങനെ എങ്ങനെ ചെയ്യാൻ കഴിയും?
പ്രത്യേകിച്ച്, കവർച്ചയ്ക്കിടെ ആർക്കും പരിക്കേറ്റില്ലല്ലോ.
എനിക്ക് എന്റെ അമ്മയെയും മുത്തശ്ശിയെയും മിസ് ചെയ്യുന്നു.
അവളുടെ കുട്ടികൾ അവളോട് വിരോധം തോന്നിത്തുടങ്ങും.
ഇങ്ങനെയുള്ള സമയങ്ങൾ ബുദ്ധിമുട്ടായേക്കാം, അവന് ലഭിക്കാവുന്ന എല്ലാ പിന്തുണയും ആവശ്യമാണ്.
എന്റെ ഭാര്യ അടുത്തിടെ അസുഖമായിരുന്നു, ഞാൻ ദിവസം മുഴുവൻ അവളെ പരിചരിച്ചു.
എന്റെ കുട്ടികളില്ലാതെ എനിക്ക് കഴിയില്ല.
അതെ, ഇന്നത്തെ കാലത്ത് കുട്ടികൾ മാറിയിരിക്കാം.
ഇത് അവന്റെ ആദ്യ വർഷമാണോ?
എല്ലാ കുട്ടികൾക്കും നല്ലൊരു വീട് അർഹതയുണ്ട്.
ആശംസകൾ, എല്ലാം നന്നായി നടക്കുമെന്ന് പ്രതീക്ഷിക്കുന്നു.
സത്യത്തിൽ കാര്യങ്ങൾ മെച്ചപ്പെട്ടിരുന്നു.
ഇപ്പോൾ ഞാൻ ഒറ്റയ്ക്കാണ് താമസിക്കുന്നത്, അതുകൊണ്ട് പ്രത്യേകിച്ച് രാത്രി ബുദ്ധിമുട്ടാണ്.
ഇത് ദിവസം നന്നായി പോകുമെന്ന് തോന്നിക്കുന്നു.
എന്റെ അമ്മായി അടുത്തിടെയാണ് ഭർത്താവിനെ നഷ്ടപ്പെട്ടത്, അവർ വളരെ വിഷമത്തിലായിരുന്നു.
എനിക്ക് കുറച്ച് അസൂയ തോന്നുന്നു.
UGAയുടെ ആദ്യ ഫുട്ബോൾ ഗെയിമിനായി ഞാൻ പൂർണ്ണമായി തയ്യാറാണ്.
ദൈവത്തിന് നന്ദി, എനിക്ക് അത്രയും ഭാരം കൂടുന്നില്ല.
എന്റെ പൂച്ചയുടെ മുറി പെയിന്റ് ചെയ്യേണ്ടത് വളരെ അത്യാവശ്യമാണ്.
എന്റെ ബാല്യത്തിന്റെ ഒരു സ്ക്രാപ്ബുക്ക് അമ്മ ഉണ്ടാക്കിയിരുന്നെങ്കിൽ എന്ന് ഞാൻ ആഗ്രഹിക്കുന്നു.
നിങ്ങൾക്ക് പോലീസിനെ വിളിക്കാമോ?
ഞാൻ ഒരു പുതിയ അവസരത്തിനായി തയ്യാറാണ്.
ഒരുപക്ഷേ ഒരു ദിവസം നമ്മൾ ലോട്ടറി ജയിക്കും.
ഓഹ് ഇല്ല, അത് ഭയങ്കരമാണ്.
നിങ്ങളുടെ ദിവസം ചെലവഴിക്കാൻ ഇത് മോശം വഴിയല്ല.
കുട്ടികൾ എന്നിൽ നിന്ന് അകന്നു നിൽക്കണം, അവർ വളരെ ശബ്ദമുള്ളവരാണ്.
എങ്കിലും അത് പിൻവലിക്കാൻ കഴിഞ്ഞിരുന്നെങ്കിൽ എന്ന് ഞാനും ആഗ്രഹിക്കുന്നു.
കാറൊന്നുമില്ലാത്ത ഒരു ചെറിയ പട്ടണത്തിലാണ് ഞാൻ താമസിക്കുന്നത്.
ശരി, ഒരുപക്ഷേ നിനക്ക് നിന്റെ സുഹൃത്തിനോട് പറഞ്ഞ് നിന്നോട് ക്ഷമിക്കാൻ ആവശ്യപ്പെടാം.
നീ ഈ സിനിമ കാണണം, ഞാൻ ഇപ്പോഴാണ് കണ്ടത്; ശരിക്കും വളരെ നന്നായിരുന്നു, പക്ഷേ കുറച്ച് വികാരഭരിതവുമായിരുന്നു.
അതെ, അയാളോട് കയർത്തുപറയേണ്ട സാഹചര്യമാണെങ്കിൽ അത് വേറെ കാര്യം.
അതെ, അവർ ചെറുപ്പക്കാരാണ്, അതുകൊണ്ട് ഇത് കുറച്ച് വർഷങ്ങൾ കൂടി തുടരുമെന്ന് പ്രതീക്ഷിക്കുന്നു.
നീ അടുത്ത തവണ ഷോപ്പിംഗിന് പോകുമ്പോൾ അവൻ നിനക്കായി കേക്ക് വാങ്ങുമോ?
എനിക്ക് ഇപ്പോൾ ഭയങ്കര ദേഷ്യമാണ്, അവനോട് പകരം വീട്ടണമെന്നുണ്ട്.
മൈൽഡ് വാങ്ങാൻ തക്കതല്ല.
ഞങ്ങൾ ഇന്നലെ സിക്‌സ് ഫ്ലാഗ്സിൽ പോയി; ഉയർന്ന് നിൽക്കുന്ന റോളർ കോസ്റ്റർ കണ്ടപ്പോൾ എനിക്ക് വല്ലാത്ത അസ്വസ്ഥത തോന്നി.
അതെ, അവ വളരെ ബുദ്ധിമുട്ടായിരുന്നു. ഞാൻ വേണ്ടത്ര പഠിച്ചില്ലെന്ന് തോന്നുന്നു.
ഓ, എന്റെ ഫ്രീസറിനുള്ള കുറച്ച് സാധനങ്ങളും ഒരുപാട് സ്നാക്കുകളും മാത്രം.
അവൻ പല സ്ഥലങ്ങളിലും ജോലി ചെയ്തിട്ടുണ്ട്, ഒരിക്കൽ ജപ്പാനിലും ആയിരുന്നു.
ആ വൃത്തികെട്ട ദുർഗന്ധമുള്ള കീഴ്ശ്വാസങ്ങളെക്കുറിച്ച് അവർ ഒരുപാട് ചിരിച്ചിട്ടുണ്ടാകുമെന്ന് എനിക്ക് ഉറപ്പാണ്.
സത്യത്തിൽ, ഞാൻ ശരിക്കും അത്ഭുതപ്പെട്ടുപോയി.
അതെ, അത് എൺപതുകളിലെ ഒരു പഴയ ടേപ്പ് ഡെക്കായിരുന്നു.
ഈ വർഷം ഈഗിൾസിന് വീണ്ടും ജയിക്കാനാകുമെന്ന് ഞാൻ കരുതുന്നു; അങ്ങനെ തന്നെ സംഭവിക്കുമെന്ന് പ്രതീക്ഷിക്കുന്നു.
നിനക്ക് എന്തുകൊണ്ടാണ് ഉറപ്പില്ലാത്തതായി തോന്നുന്നത്?
എന്റെ മകൻ കുറച്ച് ദിവസങ്ങൾക്ക് മുമ്പ് ആദ്യമായി നടന്നു.
എന്റെ സയൻസ് പരീക്ഷയിൽ തോറ്റപ്പോൾ എനിക്ക് ഭയങ്കര ദേഷ്യം വന്നു.
അവർ വിവാഹിതരായതുകൊണ്ടാണെന്ന് എനിക്ക് തോന്നുന്നു.
ഈ ആഴ്ച എന്റെ മുത്തശ്ശിക്ക് ശസ്ത്രക്രിയയുണ്ട്. കുറഞ്ഞത് ഒരു രാത്രി ഞാൻ അവരോടൊപ്പം താമസിക്കും.
നിനക്കായി എനിക്ക് വളരെ സന്തോഷമുണ്ട്.
പ്രാർത്ഥന നമ്മുക്ക് ശക്തി നൽകുകയും മുന്നോട്ട് പോകാൻ സഹായിക്കുകയും ചെയ്യുന്നു
നിങ്ങളുടെ മുറ്റത്ത് അപരിചിതമായ കാറുകൾ കാണുമ്പോൾ പേടിയാകുന്നു
ഇപ്പോൾ നിനക്ക് കുറ്റബോധം തോന്നുന്നുണ്ടോ
അടുത്ത തവണ ഈ വഴി ഒരു ചുഴലിക്കാറ്റ് കടന്നുപോകുമ്പോൾ ഞാൻ തീർച്ചയായും തയ്യാറായിരിക്കും
അവൾ പുകയുടെ മണമുമായി എന്റെ ഓഫീസിൽ വന്ന് ജോലി ചെയ്യുന്നതിന് പകരം സംസാരിക്കാൻ ശ്രമിക്കുന്നു
ഹസ്കികൾ ഏറ്റവും തമാശക്കാരായ നായകളിൽ ചിലതാണ്
അവസാനം ഇത് സംഭവിക്കേണ്ടതായിരുന്നു
അത് തീർച്ചയായും ഭയങ്കരമായൊരു സാഹചര്യം ആയിരുന്നിരിക്കണം
നിങ്ങൾ എല്ലാവരും ഒരുമിച്ച് എന്ത് ചെയ്യും
പക്ഷേ എന്നെ പാലിൽ മുക്കി സ്നാനം കഴിപ്പിച്ചിരുന്നെങ്കിൽ അത് മുഴുവൻ പാലായേനെ
അവൻ വല്ലാതെ ശല്യപ്പെടുത്തുകയായിരുന്നു
അവൻ മരിച്ചിട്ട് ഒരു വർഷമായി, ഇപ്പോഴും വളരെയധികം വേദനിക്കുന്നു
ഞാൻ ഇപ്പോൾ അതേ ക്ലാസിലേക്ക് പോകാനിരിക്കുകയാണ്, അതുകൊണ്ട് ഞാനും നന്നായി ചെയ്യുമെന്ന് പ്രതീക്ഷിക്കുന്നു
നന്നായി തയ്യാറായിട്ടും പരാജയപ്പെടുമോ എന്നെനിക്ക് വളരെ പേടിയാണ്
അത് തെറ്റാണെന്ന് ഞാൻ അവനോട് പറഞ്ഞു, കുറച്ച് മിനിറ്റ് ടൈം-ഔട്ടിൽ ഇരുത്തുകയും ചെയ്തു
മുമ്പ് എനിക്ക് അവയിൽ മോശമായിരുന്നു, പക്ഷേ ഇപ്പോൾ നന്നായി വരുന്നു
ഓ, ഇപ്പോൾ നീ എന്താണ് ചെയ്തത്
നിങ്ങൾക്ക് എന്റെ അനുശോചനം; അവളെക്കുറിച്ചുള്ള മനോഹരമായ ഒരുപാട് ഓർമ്മകൾ നിങ്ങൾക്കുണ്ടാകുമെന്ന് പ്രതീക്ഷിക്കുന്നു
ഹും, അത് നല്ലതല്ല
ജോലിയാണ് ആദ്യം, ഇല്ലെങ്കിൽ ബില്ലുകൾ അടയ്ക്കാൻ കഴിയില്ല
ചിലപ്പോഴൊക്കെ മറ്റൊരാളെ തെറ്റായ കാര്യങ്ങൾക്ക് പ്രോത്സാഹിപ്പിക്കാതിരിക്കുക ബുദ്ധിമുട്ടാണ്.
നീ സുഹൃത്തുക്കളോടൊപ്പം പുറത്തുപോകാൻ ശ്രമിച്ചോ?
അതെ, കുട്ടികൾ മാതാപിതാക്കളേക്കാൾ മെച്ചപ്പെട്ടവരാകേണ്ടതല്ലേ—പരിണാമം, അറിയാമല്ലോ.
നന്നായി, നീ ആരെയെങ്കിലും കൂടെ കൊണ്ടുപോകുന്നുണ്ടോ?
അതെ, അവനോട് എനിക്ക് നല്ല അസൂയയുണ്ട്—അവൻ ചുറ്റിക്കറങ്ങുന്ന വാഹനം അവന്റെ അച്ഛൻ അവനുവേണ്ടി വാങ്ങിക്കൊടുത്തതാണ്.
നിന്റെ വീട്ടിൽ പുറത്തേക്ക് ഇറങ്ങിപ്പോകാൻ സാധ്യതയുള്ള വളർത്തുമൃഗമുണ്ടോ?
അതെ, അതായിരുന്നു എന്റെ ശുപാർശ.
അത് നടക്കുമെന്ന് എനിക്ക് ഉറപ്പാണ്. നീ അകത്ത് പോയി അതിനെ കൊന്നോ?
ഞാൻ തീർച്ചയായും അത് ചെയ്യാൻ പദ്ധതിയിടുന്നുണ്ട്.
നീ പോലീസിനെ വിളിക്കണോ മറ്റോ?
ഞാൻ വിയർക്കുകയായിരുന്നു, അത്രയും പരിഭ്രമത്തിലായിരുന്നു.
എനിക്ക് പുറത്തേക്കോ അകത്തേക്കോ പോകേണ്ടിവരുമ്പോൾ വളരെ പേടിയാണ്.
ജോലിയിൽ നിന്ന് വീട്ടിലെത്തിയപ്പോഴാണ് സുഹൃത്തുക്കൾ എനിക്കായി പാർട്ടി നടത്തിയെന്ന് അറിഞ്ഞത്.
ഒരിക്കൽ മൂന്ന് ആഴ്ച വീട്ടിൽ നിന്ന് അകന്ന് യാത്ര ചെയ്യേണ്ടിവന്നു; അതുകൊണ്ട് ഞാൻ വല്ലാതെ പരിഭ്രമിച്ചു.
ഓ, അതെ, അത് കുറച്ച് അപകടകരമായി തോന്നുന്നു. അത്യാവശ്യമല്ലെങ്കിൽ ഞാൻ ആ വിമാനത്തിൽ കയറില്ലായിരുന്നു.
അച്ഛനെ അവധിക്ക് കൊണ്ടുപോകൂ.
താൻ നാമനിർദ്ദേശം ചെയ്യപ്പെട്ടുവെന്ന് അവൾക്ക് അറിയുകയേ ഇല്ലായിരുന്നു.
അതെ, പക്ഷേ ഇങ്ങനെ അധികം തിടുക്കപ്പെടുന്നില്ലെന്ന് ഉറപ്പാക്കണം.
അവൻ ശ്രമിച്ചാൽ വിജയിക്കാമെന്ന് അറിയുന്നത് വളരെ സന്തോഷം നൽകുന്നു.
ചിലപ്പോൾ കുട്ടികളെ നോക്കിനടത്തുന്നത് സുഖകരമാണ്.
അതൊരു ഭ്രാന്തമായ കഥയാണ്.
നിങ്ങളൊക്കെ എവിടേക്കാണ് പോകുന്നത്?
അല്ല, ഓഹരി വിപണി തകർന്ന കാലമായിരുന്നു അത്.
ഞാൻ അവ കണ്ടെത്തി കേൾക്കാം.
നിങ്ങൾ എത്ര ഇടവിട്ട് പരസ്പരം കാണാറുണ്ട്?
ഞാൻ ഉപേക്ഷിക്കാൻ പോകുന്നില്ലായിരുന്നു.
ഈ ആഴ്ചയുടെ തുടക്കത്തിൽ എന്റെ മരുമക്കളിൽ നിന്ന് പേടിപ്പിക്കുന്നൊരു ഫോൺ വന്നു.
എന്റെ ഭൂതകാലത്തെക്കുറിച്ച് ഞാൻ എന്റെ കാമുകിയോട് തുറന്നു സംസാരിച്ചു.
ഞാനാണ് കൂടുതൽ യോഗ്യനായ സ്ഥാനാർഥിയെന്ന് ഞാൻ കരുതി.
ചിലപ്പോൾ എനിക്കും അങ്ങനെ തോന്നും, പക്ഷേ പഠിക്കാൻ ഇതാണ് ഏറ്റവും നല്ല വഴി, മാത്രമല്ല ഇത് ക്രമേണ എളുപ്പമാകും.
ഉടൻ അവളെ കാണാനുണ്ട്, പക്ഷേ അവൾക്ക് ഇപ്പോഴും എന്നെ ഇഷ്ടമാണോ എന്ന് എനിക്ക് ഉറപ്പില്ല.
ഇന്ന് ജോലി കഴിഞ്ഞ് രാത്രി ഒരു ഡേറ്റിന് പോകുകയാണ്.
അവർ അവരുടെ വിവരങ്ങൾ നൽകിയില്ലെന്ന് തോന്നുന്നു, അല്ലേ?
അവരുടെ ജീവിതത്തിലെ ഒരു മികച്ച പുതിയ അധ്യായം തുടങ്ങുന്നതിൽ അവർ വളരെ ആവേശത്തിലാണ്.
എന്റെ ഇപ്പോഴത്തെ ജോലിയിൽ എനിക്ക് സുഖമാണ്, അത്ര തന്നെ.
എന്നോടൊപ്പം പുതപ്പിനടിയിൽ കിടന്ന് ഉറങ്ങാൻ അവന് ഇഷ്ടമാണ്.
അത് തീർച്ചയായും ആശ്വാസമായിരിക്കണം.
ഒന്നും ശരിയാകുന്നില്ല—ജോലി കിട്ടുന്നില്ല, ഞങ്ങൾ ഇപ്പോഴാണ് താമസം മാറിയത്, ഒരുപാട് കാര്യങ്ങൾ നടക്കുകയാണ്.
ഒരുപക്ഷേ ഞാൻ കുറച്ചുനേരം ഉറങ്ങും.
ഫോ ഒരു വിയറ്റ്നാമീസ് നൂഡിൽസ് വിഭവമാണ്
ഇത് എനിക്ക് വളരെ പുളിയാണെന്ന് തോന്നുന്നു
അവൾ പോയതോടെ ഇപ്പോൾ അവൻ സുഖം പ്രാപിച്ച് ഉണരുമെന്ന് പ്രതീക്ഷിക്കുന്നു
അവർക്കും നല്ലൊരു ദിവസം ആയിരുന്നെന്ന് പ്രതീക്ഷിക്കുന്നു
ഇല്ല, പക്ഷേ എനിക്ക് വേണം
വാവ്, അത് എത്ര ഭാഗ്യമാണേ
എന്നേക്കാൾ ഒരു സഹപ്രവർത്തകന് പ്രമോഷൻ കിട്ടി
കഴിഞ്ഞ ദിവസം ഞാൻ എന്റെ സുഹൃത്തിന് എന്റെ ഡെബിറ്റ് കാർഡ് കടം കൊടുത്തു
അത് നിങ്ങളുടെ വീട്ടിൽ കയറിയിട്ടില്ലെന്ന് പ്രതീക്ഷിക്കുന്നു
എനിക്ക് പുതുപുത്തൻ കമ്പ്യൂട്ടർ കിട്ടി
ഇല്ല, പക്ഷേ അവർ സുഖമായിരിക്കുന്നെന്ന് അവൾ കണ്ടിരുന്നെങ്കിൽ അവൾക്ക് വിഷമമുണ്ടാകില്ലായിരുന്നു
നിനക്കായി ഇത്ര വലിയ ഉപകാരം ചെയ്തത് ആരാണ്
എന്റെ ഭർത്താവിന് പുതിയ സ്ഥാനത്തേക്ക് സ്ഥലംമാറ്റം കിട്ടിയേക്കാം, ഞങ്ങൾക്ക് കുടുംബത്തിന്റെ അടുത്തേക്ക് താമസം മാറാനും കഴിഞ്ഞേക്കും
ഹേ കൂട്ടുകാരാ, എങ്ങനെയുണ്ട് കാര്യങ്ങൾ
ഞാൻ വിമാനത്താവളത്തിലെ ഫുഡ് കോർട്ടിൽ ജോലി ചെയ്തിരുന്നു
എന്റെ ഭാര്യ ഭ്രാന്തായിപ്പോയേനേ
അതുതന്നെയാണ് കാര്യം, എനിക്ക് അത് മനസ്സിലായില്ല
വെള്ളം തണുത്തതായിരുന്നോ ചൂടായിരുന്നോ
എനിക്ക് കേൾക്കാൻ ഇഷ്ടമില്ലാത്ത എന്തെങ്കിലും അവർ എന്നോട് പറയുമോ എന്ന ആശങ്കയുണ്ട്
കഴിഞ്ഞ മാസം ജോലി കഴിഞ്ഞ് പതിവായി ജിമ്മിൽ പോയതിന്റെ ഫലമായി എന്റെ ഭാരം 4 പൗണ്ട് കുറഞ്ഞു
ഒരുപാട് ക്വാഡുകളും ബോട്ടുകളും ജെറ്റ്‌സ്‌കികളും ഉള്ള ആളുകളെ ഞാൻ കാണാറുണ്ട്; അവ വാങ്ങാനുള്ള കഴിവ് എനിക്കുണ്ടായിരുന്നെങ്കിൽ എന്ന് തോന്നും.
ഓഹ്, അത് വളരെ രസകരമായിരിക്കും എന്ന് തോന്നുന്നു.
കുറച്ചൊക്കെ അസൂയ തോന്നുന്നുണ്ട്.
എനിക്ക് പ്രായം കൂടി, പിന്നെ പേടിയൊന്നും തോന്നിയില്ല.
അവൻ ഉണർന്ന് ഫ്രിഡ്ജ് നോക്കിയപ്പോൾ സന്തോഷമായിരുന്നില്ല.
അതുകൊണ്ട് എനിക്ക് ജോലിക്ക് വൈകി.
വിനോദത്തിനായി ചെലവാക്കിയ പണത്തിന് ഇത് വളരെ നല്ല ഇടപാടാണ്.
ജീവിതത്തിൽ ഇത്രയും ദേഷ്യം എനിക്ക് ഒരിക്കലും വന്നിട്ടില്ല.
കഴിഞ്ഞ ദിവസം ഞാൻ എന്റെ മുൻപ്രണയിതാവിനെ കണ്ടു; അവന് ഇതിനകം പുതിയ കാമുകിയുണ്ട്.
അത്രയും സമ്പന്നനായത് നോക്കുമ്പോൾ അവൻ മിടുക്കനാണ്.
സത്യമായി പറഞ്ഞാൽ, ഇത് എല്ലാവർക്കും സംഭവിക്കും; എനിക്ക് മനസ്സിലാകും.
എന്റെ ഭാര്യ 3 വർഷമായി സ്വന്തം ബിസിനസ് നടത്തുകയാണ്.
ഞാൻ കണ്ടിട്ടുള്ളതിൽ ഏറ്റവും പേടിപ്പെടുത്തുന്ന ഒന്നാണ് ഇത്.
അതെ, ഞാൻ അങ്ങനെ ചെയ്തു; കാരണം എന്റെ കുട്ടിയുടെ മുന്നിൽ അവൻ അങ്ങനെ പെരുമാറിയത് എന്നെ വല്ലാതെ ദേഷ്യം പിടിപ്പിച്ചു.
എന്റെ മകൻ നേരത്തേ ബിരുദം നേടുകയാണ്.
അടുത്തിടെ ജോലിയിൽ എനിക്ക് പ്രമോഷൻ കിട്ടി, അതോടെ ഞാൻ വളരെ സന്തോഷവാനായി.
നിങ്ങൾ ഓർത്തുവെക്കുന്ന പഴയ ഓർമ്മകൾ സാധാരണയായി നിങ്ങൾക്ക് ഏറെ പ്രിയപ്പെട്ടവയായിരിക്കും.
സ്കൂൾ തുടങ്ങുന്നതിന് മുമ്പ് ഒരാഴ്ച താമസിച്ച് എന്നെ ഞെട്ടിക്കാനായി എന്റെ മകൾ വീട്ടിലെത്തി.
അതെ, അത് വല്ലാതെ ക്ഷീണിപ്പിക്കുന്നതായിരുന്നു.
ആശങ്കപ്പെടാതെ, ഇന്റർവ്യൂവറോട് പറയാനുള്ളത് മാത്രം ഓർത്തുവയ്ക്കുന്നതാണ് ഏറ്റവും നല്ലത്.
എങ്കിലും ക്രിസ്മസിന് അവൾക്കായി ഒരെണ്ണം വാങ്ങും.
മിക്കവർക്കും തമ്മിൽ ഒത്തുപോകുന്നില്ലെന്ന് തോന്നുന്നു.
മക്കളെന്ന നിലയിൽ നമുക്ക് ചെയ്യാനാകുന്ന കുറഞ്ഞത് ഇത്രയെങ്കിലും ആണ്.
നമ്മിൽ ഭൂരിഭാഗം പേരുടെയും കാര്യത്തിൽ ഇത് ഇങ്ങനെയാണ് പ്രവർത്തിക്കുന്നത്.
ഈ വാരാന്ത്യത്തിൽ ഞാൻ ഒരു ടൂർണമെന്റിൽ കളിക്കുകയാണ്, നമുക്ക് ജയിക്കാനാകുമെന്ന് തോന്നുന്നു.
പിന്നീട് എനിക്ക് ഒരു ഡ്രെസ്സർ കൂട്ടിച്ചേർക്കണം.
എനിക്ക് തന്നെ ഒരു അവധി എടുക്കാൻ മതിയാകുന്നത്ര പണം ഇപ്പോഴാണ് സമ്പാദിച്ചത്.
ആ പരീക്ഷ എഴുതാൻ ഇനി കാത്തിരിക്കാനാവില്ല.
മറ്റുള്ളവർ എന്ത് പറഞ്ഞാലും ഞാൻ എപ്പോഴും ഏറ്റവും പുതിയ നിൻടെൻഡോ കൺസോൾ തന്നെയാണ് വാങ്ങുന്നത്.
രാവിലെ അവൻ ആ വാച്ച് ധരിക്കുന്നത് എനിക്ക് ഇപ്പോഴും കാണാം.
നമുക്കെല്ലാവർക്കും വീണ്ടും സ്കൂളിന്റെ താളത്തിലേക്ക് മടങ്ങണം.
നീ ഇതിലും നന്നായി ചെയ്യേണ്ടതായിരുന്നു.
എന്റെ തലയ്ക്ക് മുകളിൽ ഒരു മേൽക്കൂരയും നല്ലൊരു ജോലിയും അത്ഭുതകരമായൊരു കുടുംബവും ഉണ്ട്.
ശരിക്കും കൂടുതൽ ഫലപ്രദമായി പ്രവർത്തിക്കുന്ന പകരം ചികിത്സകൾ അന്വേഷിക്കാൻ ശ്രമിക്കൂ.
എന്താണ് സംഭവിച്ചത്? എന്തെങ്കിലും ഏറ്റുമുട്ടൽ ഉണ്ടായോ?
എങ്കിലും അവൾ വളരെ നന്നായി ചെയ്യുമെന്ന് എനിക്ക് തോന്നുന്നു.
മറ്റന്നാൾ എന്റെ നായ ഓടിപ്പോയപ്പോൾ എനിക്ക് തീർത്തും ഒറ്റപ്പെട്ടതായി തോന്നി.
ഈ വാരാന്ത്യത്തിൽ ഞാൻ ആദ്യമായി സുഷി കഴിക്കാൻ പോകുകയാണ്, പക്ഷേ കുറച്ച് ടെൻഷനുണ്ട്.
അയ്യോ, അത് നിരാശാജനകമായിരിക്കണം.
അസൂയ തോന്നുന്നത് എനിക്ക് ഇഷ്ടമല്ല, പക്ഷേ മാസങ്ങളായി എനിക്ക് ഒരു കാർ വേണമായിരുന്നു, എന്റെ സുഹൃത്ത് ഇപ്പോഴാണ് പുതിയൊരു കാർ വാങ്ങിയത്.
ഇന്ന് ഞാൻ എന്റെ എല്ലാ ഫേസ്ബുക്ക് ഫോട്ടോ ആൽബങ്ങളും നോക്കി.
ഞാൻ എന്റെ അഞ്ച് വയസ്സുള്ള മകളിൽ നിന്ന് പണം മോഷ്ടിച്ചു.
സൗജന്യമായവ ഒട്ടും നല്ലതല്ല.
അങ്ങനെയൊരു കാര്യം ചോദിക്കാൻ പോലും അവൾക്ക് നല്ല ധൈര്യമുണ്ട്.
ഞാൻ വളരെ നല്ലൊരു വ്യക്തിയാണ്.
അയ്യോ, അത് കേട്ടപ്പോൾ വളരെ വിഷമമായി. എന്റെ മുത്തശ്ശി ഏകദേശം 10 വർഷം മുമ്പ് കാൻസർ ബാധിച്ച് മരിച്ചു.
നല്ലതൊന്നും എളുപ്പത്തിൽ ലഭിക്കില്ലെന്ന് എനിക്ക് തോന്നിയിരുന്നു.
അവർക്കു വിഷമമുണ്ടെന്ന് പറഞ്ഞ് ഒരു കുറിപ്പുപോലും അവർ വെച്ചില്ല.
അതിന്റെ അർത്ഥം എന്താണെന്ന് നിനക്ക് എങ്ങനെ മനസ്സിലായി?
പ്രഥമ ശുശ്രൂഷയിൽ നിങ്ങൾക്ക് പ്രൊഫഷണൽ ബിരുദമുണ്ടോ?
ദന്തഡോക്ടറുടെ അടുത്തേക്ക് പോകുന്നത് എനിക്ക് എപ്പോഴും വെറുപ്പാണ്; വല്ലാത്ത വേദനയാണ്.
എന്റെ ഭാര്യയെ ഞാൻ വളരെ വിശ്വസിക്കുന്നു; നല്ലൊരു സ്ത്രീയെ കണ്ടെത്തുക വളരെ ബുദ്ധിമുട്ടാണ്.
കഴിഞ്ഞ രാത്രി ഞാൻ വീട്ടിലേക്ക് പോകുന്ന വഴിയിലായിരുന്നു.
ആരും അത് ഒറ്റയ്ക്ക് അനുഭവിക്കേണ്ടി വരരുത്.
അന്ന് രാത്രി അവൻ മുത്തശ്ശൻമാരോടൊപ്പം കഴിയട്ടെയെന്ന് ഞങ്ങൾ തീരുമാനിച്ചു.
ഞാൻ കുട്ടിയായിരുന്നപ്പോൾ ഒരു ടൊർണാഡോയിൽ പെട്ടിരുന്നു.
എനിക്ക് വേണ്ടിയിരുന്ന ജോലി മറ്റൊരാൾക്ക് ലഭിച്ചുവെന്ന ഫോൺ ഇപ്പോഴാണ് വന്നത്.
അത് ശരി, നിനക്ക് വേറെ എന്ത് ചെയ്യാൻ കഴിയുമായിരുന്നു?
LSAT പരീക്ഷയ്ക്ക് തയ്യാറെടുക്കാനും സ്കൂളുകളിൽ അപേക്ഷിക്കാനും വളരെയധികം അച്ചടക്കം വേണം.
അതെ, അവൻ വളരെ നന്നായി ചെയ്തു.
കാഷ്യർ തന്നിൽ നിന്ന് അധികം പണം ഈടാക്കുന്നുവെന്ന് അവൾ കരുതി.
അതെ, അത് വല്ലാതെ ഹൃദയഭേദകമായിരുന്നു, കാരണം അവൻ എപ്പോഴും അങ്ങനെയുള്ള വിശ്വസ്തനായ ഏറ്റവും നല്ല സുഹൃത്താണ്.
അവർ ഇപ്പോഴെങ്കിലും എന്നെ വിളിച്ചിരുന്നെങ്കിൽ എന്ന് തോന്നുന്നു.
ജീവിതം പഠിച്ചുകൊണ്ടിരിക്കുന്നതിലാണ്. അതിൽ നിന്ന് നീ എന്തെങ്കിലും പഠിച്ചതിൽ എനിക്ക് സന്തോഷമുണ്ട്; പലരും പഠിക്കാറില്ല.
അത് വണ്ടി നിർത്തിപ്പിക്കാൻ മാത്രം ഉള്ള ഒരു മണ്ടൻ കാരണമാണ്.
എന്റെ കുട്ടികളുടെ സ്കൂളിനുള്ള എല്ലാ സാധനങ്ങളും ഞാൻ ആഴ്ചകൾക്ക് മുമ്പേ വാങ്ങിയിരുന്നു.
നീ അവ കഴിക്കാൻ പോകുകയാണോ?
ഞാൻ ലോട്ടറി ടിക്കറ്റുകൾ മാത്രം വാങ്ങിക്കൊണ്ടിരിക്കും.
അതിനുശേഷം ഞാൻ തന്നേക്കാൾ വേഗത്തിൽ മുന്നേറുകയാണെന്ന് അവൾ തീരുമാനിച്ച് എന്റെ ജോലി തകർക്കാൻ ശ്രമിച്ചു.
അവരെ സഹായിച്ചതിന് മറ്റൊരു ഡിപ്പാർട്ട്‌മെന്റിലെ സഹപ്രവർത്തകൻ എനിക്ക് നന്ദി കാർഡ് അയച്ചു.
നന്നായി, ഇതെല്ലാം ആദ്യം തുടങ്ങുന്നത് ദൃഢനിശ്ചയത്തോടെയാണ്.
അത് വളരെ നല്ലതാണ്; സാഹചര്യം ഏറ്റെടുത്തതിന് നിനക്ക് അഭിനന്ദനങ്ങൾ.
അവൾക്ക് 13 വയസ്സാണ്, അവൾ ത്രിഫ്റ്റ് സ്റ്റോറുകളിൽ പോകാൻ ആഗ്രഹിക്കുന്നു.
ഞാൻ ഓടാൻ ശ്രമിക്കുമ്പോഴൊക്കെ നിലത്തേക്ക് താഴ്ന്നുപോകുന്നു.
അതെ, അവൻ എന്റെ ഏക സഹോദരനായിരുന്നു.
ജോലിസ്ഥലത്തെ പുതിയ പ്രിന്റർ വളരെ മോശമാണ്.
നിനക്ക് നന്നായി ചെയ്യാനാകും എന്ന് എനിക്ക് ഉറപ്പുണ്ട്.
എന്റെ അശ്രദ്ധയിൽ എന്റെ നായയ്ക്ക് വളരെ മോശമായി പരിക്കേറ്റു.
ഇത് വലിയൊരു ആശ്വാസമാണ്, ഇപ്പോൾ എന്റെ കുടുംബത്തോടൊപ്പമുള്ള ജീവിതം ഇതിലും ലളിതമാകാനില്ല.
നീ എത്ര കാലമായി പഠിപ്പിക്കുന്നു?
ആളുകളുടെ മുന്നിൽ എന്റെ വസ്ത്രം കീറിപ്പോയി
പുതിയൊരെണ്ണം കണ്ടെത്താൻ റോക്കീസിലേക്ക് പോകാമെന്ന് ആലോചിക്കുകയാണ്
കഴിഞ്ഞ ആഴ്ച എന്റെ സുഹൃത്ത് പണത്തിന്റെ കാര്യത്തിൽ ഒരുപാട് മുന്നേറി; എനിക്ക് അതിശയവും അവനെക്കുറിച്ച് നല്ല അഭിമാനവും തോന്നി
എന്റെ വിവാഹത്തിന് മുന്നോടിയായിരുന്ന ദിവസങ്ങളിൽ എനിക്ക് എങ്ങനെ തോന്നിയിരുന്നുവെന്ന് ഇപ്പോഴും ഓർമ്മയുണ്ട്
ഇത് എത്ര വിചിത്രമായി തോന്നിയാലും, എന്റെ അമ്മ ഇപ്പോഴും ഓരോ ക്രിസ്മസിനും എനിക്ക് കുട്ടികളുടെ പുസ്തകം സമ്മാനമായി തരുന്നു
ഞാൻ ചിലപ്പോൾ കുറച്ച് അധികം കാര്യങ്ങൾ ചെയ്ത് പോകാറുണ്ടെന്ന് തോന്നുന്നു, അത് അല്പം സമ്മർദ്ദകരമാകാം
അവർ ഇപ്പോഴും ഇത്രയധികം പ്രണയത്തിലാണെന്നത് ശരിക്കും അത്ഭുതകരമാണ്
എന്റെ ഭർത്താവിന് മറ്റൊരു സംസ്ഥാനത്ത് ജോലി ചെയ്യാൻ ആഗ്രഹമുണ്ട്
കൊള്ളാം, നീ എന്താണ് കഴിച്ചത്?
എനിക്കും അങ്ങനെ ആകാൻ ഇഷ്ടമില്ല, അത് ഭയപ്പെടുത്തുന്നതായി തോന്നുന്നു
ഇക്കാര്യത്തിൽ നിന്നെ ഞാൻ ശരിക്കും മനസ്സിലാക്കുന്നു
നിങ്ങളുടെ കുടുംബത്തിന്റെ ഭാഗമായതിലൂടെ അവൾക്ക് കഴിയുമായിരുന്ന ഏറ്റവും നല്ല ജീവിതം തന്നെയാണ് നയിച്ചതെന്ന് എനിക്ക് ഉറപ്പുണ്ട്
അന്റാർട്ടിക്കയിലേക്ക് യാത്ര പോകാൻ മതിയായ പണം സ്വരുക്കൂട്ടുന്നത് വരെ കാത്തിരിക്കാനാവുന്നില്ല
എന്റെ കൈയിൽ എത്ര ഫോണുകളുണ്ടെന്ന് പോലും എണ്ണാനാവുന്നില്ല
തുടർച്ചയായി മുന്നോട്ട് പോകുകയും ഓരോ ദിവസവും ഓരോ ദിവസമായി കൈകാര്യം ചെയ്യുകയും ചെയ്താൽ യാഥാർത്ഥ്യത്തിൽ എന്തും ചെയ്യാം
ഇന്ന് രാവിലെ നല്ലൊരു ജോലി സെഷന് വേണ്ടതെല്ലാം എനിക്ക് കിട്ടി
അതിനുശേഷം എനിക്ക് വളരെ കുറ്റബോധം തോന്നി
ഞാൻ ഇതിനകം തന്നെ എന്റെ ആത്മാവിനെ നഷ്ടപ്പെടുത്തിയതുപോലെ തോന്നുന്നു
ഞാൻ കുട്ടിയായിരുന്നപ്പോൾ വായിച്ചിരുന്ന പുസ്തകങ്ങൾ വായിക്കാൻ കഴിയുന്നത്ര എന്റെ മരുമകൾ ഇപ്പോൾ വളർന്നിരിക്കുകയാണ്
നീ കുളിച്ച് കുറച്ച് പുതിയ ഷൂസ് വാങ്ങിയെന്ന് പ്രതീക്ഷിക്കുന്നു
ഞാൻ നടക്കുമ്പോൾ എന്റെ പാന്റ് കണങ്കാൽ വരെ താഴേക്ക് വീണു
ഇതിലധികം ആവേശഭരിതനാകാൻ എനിക്ക് കഴിയില്ല
അവ ഉപയോഗിക്കാൻ ഞാൻ വിസമ്മതിക്കുന്നു
നെറ്റ് ന്യൂട്രാലിറ്റിയെക്കുറിച്ച് എനിക്ക് അധികം അറിയില്ല
അതെ, കാറിന്റെ ടയറുകൾ മാറ്റണം
നിനക്ക് തിരികെ പോയി അത് കൊണ്ടുവരാൻ കഴിയുമെന്ന് പ്രതീക്ഷിക്കുന്നു
പുതിയ സ്റ്റേഡിയം ഗംഭീരമാണ്
എനിക്കും എന്റെ സുഹൃത്തിനും ഒരേ ജോലി കിട്ടിയില്ല
അത് നിന്നെ ശരിക്കും വിഷമിപ്പിച്ച കാര്യമല്ലായിരുന്നെന്ന് പ്രതീക്ഷിക്കുന്നു
ആ 25 ഡോളർ എന്റെ ഗ്യാസ് ടാങ്കിൽ ഇടാൻ പോവുകയായിരുന്നു ഞാൻ
ഞാൻ അടുത്തിടെ വർക്ക്‌ഔട്ട് തുടങ്ങുകയും കുറച്ച് ഇഞ്ച് കുറയുകയും ശരീരം കൂടുതൽ ഉറപ്പുള്ളതാവുകയും ചെയ്തു
ഇന്റർസ്റ്റേറ്റിൽ ഒരു കാർ എന്നെ ഇടിക്കാൻ തൊട്ടടുത്തെത്തിയപ്പോൾ
നീ അതിന് തീ കൊളുത്തിയെന്ന് പ്രതീക്ഷിക്കുന്നു
എന്റെ സ്വപ്ന കോളേജിൽ എനിക്ക് പ്രവേശനം ലഭിച്ചു
അവർ ചെയ്യുമെന്ന് എനിക്ക് ഉറപ്പുണ്ട്
ഞാൻ മേക്കപ്പ് വാങ്ങും; ആ സ്ഥലങ്ങളിൽ പകുതിയിലധികം വിലക്കുറവ് കിട്ടും
ജോലിക്കോ മറ്റെന്തിനെയെങ്കിലും പോകാൻ എനിക്ക് തോന്നുന്നില്ല
അവൾ ചെറുപ്പമാണ്, പക്ഷേ വളരെ മിടുക്കിയാണ്
അതെ, കുട്ടികൾ ഇപ്പോൾ യുഗിയോയും മറ്റു മണ്ടത്തരമുള്ള കളികളിലേക്കും മാറിയിരിക്കുന്നു
നിനക്ക് ഇഷ്ടപ്പെട്ട തരം ഏതാണ്?
അതെ, അവർ മണിക്കൂറുകൾ എടുക്കാൻ സന്തോഷിച്ചു.
ജോലിക്കിടയിലെ നിന്റെ ദിവസവും മോശമായിരുന്നോ, വാവോ.
ഞാൻ മകനെ ഗർഭം ധരിച്ചിരുന്നപ്പോൾ, എന്റെ ഭർത്താവ് എല്ലാ രാത്രിയും എനിക്കായി വീട്ടിലേക്ക് ചോക്ലേറ്റ് ഷേക്ക് കൊണ്ടുവരുമായിരുന്നു.
എന്റെ പുതിയ സെമസ്റ്റർ അടുത്ത ആഴ്ച തുടങ്ങും, ഇതുവരെ ഉണ്ടായതിൽ ഏറ്റവും മികച്ചതായിരിക്കും ഇതെന്ന് തോന്നുന്നു.
നിനക്ക് അവളെ എത്ര ഇടവിട്ട് കാണാൻ കഴിയാറുണ്ട്?
ഞങ്ങൾ കുട്ടികളെ സിക്സ് ഫ്ലാഗ്സിലേക്ക് കൊണ്ടുപോകുകയാണ്, അവർ എന്നെ കോസ്റ്ററിൽ കയറ്റും.
എന്റെ അവധി അടുത്തെത്തി, അതിനായി ആകാംക്ഷയോടെ കാത്തിരിക്കുകയാണ്.
അച്ഛന് അസുഖമായപ്പോൾ അദ്ദേഹത്തെ നോക്കേണ്ടത് എന്റെ ഉത്തരവാദിത്തമാണെന്ന് എനിക്ക് തോന്നി.
ഒരിക്കൽ എന്റെ സഹോദരൻ എന്റെ നിൻടെൻഡോ 64 മോഷ്ടിച്ചു.
എട്ട് വയസ്സായിരുന്ന ശേഷം ഞാൻ കണ്ടിട്ടില്ലാത്ത ഒരു സിനിമ അടുത്തിടെ കണ്ടു.
ഇത് ഒരു അഭിനന്ദനമായി കാണൂ.
അവൾക്ക് വേണ്ടതെല്ലാം കിട്ടി.
അവർ വെറുതെ കാറോടിച്ച് പോയി, ഒരു കുറിപ്പുപോലും വച്ചില്ലെന്ന് ഞാൻ വാതുവെക്കും.
എന്റെ ജീവിതം വളരെ നന്നായി പോകുന്നു.
ലാസ് വെഗാസിലേക്കുള്ള എന്റെ അവധിക്ക് ഞാൻ തയ്യാറാണ്.
അന്ന് രാത്രി നിനക്ക് ഉറങ്ങാൻ തീർച്ചയായും ബുദ്ധിമുട്ടുണ്ടായിരിക്കണം.
ഇപ്പോൾ പ്ലേ ചെയ്യുന്ന തരത്തിലുള്ള സംഗീതം എനിക്ക് ഇഷ്ടമല്ല.
ഞാൻ എന്റെ പഴയ പട്ടണത്തിലേക്ക് തിരികെ പോയി.
അത് കണ്ടപ്പോൾ എനിക്ക് വല്ലാതെ അറപ്പായി എന്ന് എനിക്കറിയാം.
എന്റെ നായ കെട്ട് വിട്ട് മറ്റൊരു നായയുമായി വഴക്കിട്ടു
ഇനി മുതൽ എന്റെ അലമാര അടച്ചുവെക്കേണ്ടിവരും
ആ കേക്കിനുള്ളിൽ ശരിക്കും ഒരു ചെറിയ മനുഷ്യനായിരുന്നു
പക്ഷേ നീ പറഞ്ഞത് ശരിയാണ്, ചിലപ്പോൾ അവർ വിലകുറഞ്ഞ മരം ഉപയോഗിക്കും
ഞങ്ങൾ നല്ല സംഭാഷണങ്ങൾ നടത്തിക്കൊണ്ടിരിക്കുകയാണ്
പിന്നെ എനിക്ക് റോഡിൽ ഒരു പൂച്ചക്കുഞ്ഞിനെ കിട്ടി
അവൻ അവിടെ എത്ര നേരമായി ഉണ്ട്
അവർ ഏത് ക്ലാസുകളിലാണ് പഠിക്കുന്നത്
ഓ, ആ ദിവസങ്ങൾ എനിക്ക് ഓർമ്മയുണ്ട്
അവരെ നാണിപ്പിച്ച് കാര്യങ്ങൾ ശരിയാക്കിക്കൂ
നിന്റെ കഥ പ്രാദേശിക വാർത്തയിൽ വന്നിരുന്നോ
കുറച്ചുകാലത്തേക്ക് ഇതായിരിക്കട്ടെ അവസാനത്തെ കൊടുങ്കാറ്റ് എന്ന് പ്രതീക്ഷിക്കുന്നു
എനിക്ക് ഒരിക്കലും ചോദിക്കാനാകുമായിരുന്ന എല്ലാം എന്റെ കൈവശമുണ്ടെന്ന് സത്യമായി പറയാം
ഇക്കാലത്ത് ഞാൻ അവനെ സ്വന്തം മകനായി കരുതി ഏറെ സ്നേഹിക്കുന്നു
എന്റെ ഭൂരിഭാഗം സാധനങ്ങളും രണ്ട് മാസത്തേക്ക് ഒരു ഹോസ്റ്റലിൽ വെച്ചിട്ടാണ് ഞാൻ വന്നത്
ഇത് നിന്റെ ആദ്യ വർഷമാണോ
എന്റെ അവധി ഇപ്പോഴാണ് അംഗീകരിച്ചത്
ഞാൻ എവിടെ നിന്നാണ് വന്നതെന്ന് ഓർക്കുമ്പോൾ എനിക്ക് എന്തോ തോന്നും
കഴിഞ്ഞ വാരാന്ത്യമായിരുന്നു എന്റെ ജന്മദിനം
എനിക്ക് ശരിക്കും മനസ്സിലായോ എന്ന് ഉറപ്പില്ല—നീ ഒറ്റയ്ക്കാണോ ബൗളിംഗ് കളിക്കാൻ പോയത്
വളരെ അത്യാവശ്യം വന്നാൽ മാത്രമേ അവർ പണം ചെലവാക്കൂ
ലോകത്തിലെ മുഴുവൻ ആത്മവിശ്വാസത്തോടെയും അകത്ത് കയറി
ഇത് ചെറിയ നായയാണോ വലുതാണോ?
എനിക്ക് സ്കോളർഷിപ്പ് കിട്ടുമെന്ന് ഉറപ്പാക്കാൻ അത് നേടി നന്നായി ചെയ്യാൻ ഞാൻ വളരെ പഠിച്ചു
ഇന്ന് രാവിലെ സ്റ്റാർബക്‌സിൽ എന്റെ അടുത്ത് ക്യൂവിൽ നിന്നിരുന്ന ആൾക്ക് ഭയങ്കര ദുർഗന്ധമായിരുന്നു
എനിക്ക് മറ്റൊരു വീട് അന്വേഷിക്കേണ്ടിവന്നു, പക്ഷേ മൂന്ന് മാസത്തേക്ക് ഒന്നും കണ്ടെത്താനായില്ല
ഹായ്, എന്റെ മകന് അവന്റെ ഗണിത ക്ലാസിൽ ഗ്രേഡ് കിട്ടിയില്ല
ഇത് എന്റെ ആദ്യത്തെ മൗണ്ടൻ ബൈക്കായിരുന്നു
എനിക്ക് റൗട്ടറും മോഡവും ഇടയ്ക്കിടെ അൺപ്ലഗ് ചെയ്ത് വീണ്ടും പ്ലഗ് ഇൻ ചെയ്യേണ്ടിവരുന്നു
അണ്ടർടോയിൽ അകപ്പെട്ടപ്പോൾ ഞങ്ങൾ ഏകദേശം മുങ്ങിപ്പോയി
നിനക്ക് പേടിയാണോ അതോ ആവേശമാണോ?
അവൻ എനിക്ക് കുറേശ്ശെയായി പണം തിരികെ കൊടുത്തുകൊണ്ടിരിക്കുകയാണ്
എനിക്ക് ഇതുവരെ കുട്ടികളില്ല, പക്ഷേ ഭാവിയിൽ ഉണ്ടാകുമെന്ന് പ്രതീക്ഷിക്കുന്നു
ഒരുപക്ഷേ അവൾക്ക് വയറിന് അസ്വസ്ഥതയോ മറ്റോ ഉണ്ടായിരുന്നിരിക്കാം
എന്താണ് സംഭവിച്ചതെന്ന് അധ്യാപകൻ പറയുന്നത്?
ഞാൻ പറയുന്നത്, അവരെക്കൊണ്ട് അത് ചെയ്യിക്കൂ
ചിലപ്പോൾ ഞാൻ എന്റെ ബാല്യത്തെക്കുറിച്ച് ആലോചിക്കാറുണ്ട്, അങ്ങനെ ചെയ്യുന്നത് എനിക്ക് സന്തോഷം നൽകുന്നു
നിനക്ക് ജോലി കിട്ടുമെന്ന് പ്രതീക്ഷിക്കുന്നു
നീ കളിയിൽ പണം വാതുവെച്ചിരുന്നോ?
നിനക്ക് ഇത് വിൽക്കേണ്ടത് എന്തിനാണ്?
വഴിയിലുണ്ടായിരുന്ന കാണാൻ പറ്റാത്ത വെള്ളക്കെട്ടിൽ തെന്നിവീണ് പലരുടെയും മുന്നിൽ കാലുകൾ വിടർത്തി വീണു.
വീണ്ടും ഏകാന്തമായ ഒരു ഞായറാഴ്ചയായിരിക്കുമെന്ന് തോന്നുന്നു.
അവരിൽ നിന്ന് മറുപടി കേൾക്കാൻ ഇനി കാത്തിരിക്കാനാവില്ല.
ഇത് അനുഭവിക്കാൻ ഇനി കാത്തിരിക്കാനാവില്ല.
അത് നല്ലൊരു കാര്യമാണ്.
എന്റെ ജീവിതത്തിൽ ആദ്യമായി ഞാൻ സാമ്പത്തികമായി സുരക്ഷിതനാണ്; എനിക്ക് സ്വന്തമായി ഒരു വീടും പുതിയ കാറും ഉണ്ട്.
ഇങ്ങനെ തുടരുകയാണെങ്കിൽ എത്ര ദൂരം പോകാനാകുമെന്ന് എനിക്ക് ഉറപ്പില്ല.
നിങ്ങൾ രണ്ടുപേരും നിങ്ങളുടെ വിവാഹം രക്ഷിക്കാൻ ശ്രമിക്കുന്നുണ്ടെങ്കിൽ ഇത് പ്രവർത്തിക്കും.
ഞാൻ എപ്പോഴും ഒരുപാട് കാര്യങ്ങൾ മറന്നുപോകുന്നു.
അതാണു പ്രധാന കാര്യം; ഡ്രൈവ് ചെയ്യുമ്പോഴും ശ്രദ്ധിക്കണമെന്ന് ഞാൻ എപ്പോഴും എന്നെ തന്നെ ഓർമ്മിപ്പിക്കാറുണ്ട്.
നീ പറയുന്നത് ശരിയാണ്, ഞാൻ അത് മനപ്പൂർവം ചെയ്തതല്ല.
എന്റെ വീട്ടുടമയെക്കുറിച്ച് ചിന്തിക്കുമ്പോൾ എനിക്ക് നല്ല ദേഷ്യം വരും.
അവിടെ ഇത് നിന്റെ ആദ്യമായാണോ?
ഞാൻ ഒരിക്കലും ഏഷ്യയിൽ പോയിട്ടില്ല.
എന്റെ വളർത്തു തത്ത ഇന്നലെ ചത്തു.
ഓ, അതെ, എന്റെ കൈയിൽ കുറച്ചേ ഉണ്ടായിരുന്നുള്ളൂവെങ്കിലും ഞാൻ അവർക്ക് കുറച്ച് പണം കൊടുത്തു; സത്യത്തിൽ, കൂടുതൽ ഉണ്ടായിരുന്നെങ്കിൽ എന്ന് ആഗ്രഹിച്ചു.
അതിനോട് ഞാൻ തീർച്ചയായും യോജിക്കുന്നു.
അത് വല്ലാതെ അസ്വസ്ഥമായിരുന്നിരിക്കുമെന്ന് ഉറപ്പ്.
നിനക്ക് മനസ്സിലായപ്പോൾ ഭയങ്കര കുറ്റബോധം തോന്നിയിരിക്കണം.
അത് എന്റെ പിറന്നാളായിരുന്നു, പതിനാറാം പിറന്നാളിന് അച്ഛൻ എനിക്ക് ഒരു കാർ വാങ്ങിത്തരുമെന്ന് എനിക്ക് ഉറപ്പായിരുന്നു.
ശരി, നിനക്ക് മനസ്സിലാകില്ല, പക്ഷേ ഞാൻ പഠിച്ച സ്ഥാപനത്തിൽ നിന്ന് എനിക്ക് ഡോക്ടറേറ്റ് ലഭിച്ചു.
ട്രക്ക് കൊണ്ട് എന്തിലെങ്കിലും ഇടിച്ചുപോകുമോ എന്നോർത്ത് എനിക്ക് പേടിയാകുന്നു.
ഞാൻ അടുത്തിടെ ഒരു പുതിയ കാർ വാങ്ങി, ഒരാഴ്ചയ്ക്കുള്ളിൽ തന്നെ ട്രാഫിക്കിൽ പിന്നിൽ നിന്ന് ഇടിച്ചു.
ഞങ്ങൾ ആദ്യമായി ഇവിടെ താമസം മാറിയപ്പോൾ അവൾ സ്വയം പരിചയപ്പെടുത്തിയതിന് ശേഷം ഞാൻ അവളോട് സംസാരിച്ചിട്ടില്ല.
കഴിഞ്ഞ ദിവസം രാത്രി ഞാൻ പുറത്തു ഭക്ഷണം കഴിക്കാൻ പോയിരുന്നു; അവിടെ ഒരു മാന്ത്രികൻ അത്ഭുതകരമായ ചില ചീട്ടുതന്ത്രങ്ങൾ കാണിക്കുന്നത് കണ്ടു.
അതെ, എനിക്ക് വളരെ സന്തോഷമുണ്ട്.
എന്റെ കുട്ടികൾക്ക് ഒരുപാട് പാഠ്യേതര പ്രവർത്തനങ്ങളിൽ പങ്കെടുക്കാൻ ഇനിയും വളരെ ചെറുപ്പമാണ്.
എനിക്ക് അത് കൈകാര്യം ചെയ്യാനാകുമെന്ന് തോന്നുന്നില്ല.
ഞാൻ അങ്ങനെ ചെയ്തിരുന്നെങ്കിൽ നടക്കുകയായിരുന്നു.
നീ അത് എങ്ങനെയാണ് ശരിയാക്കിയത്?
അത് അത്ഭുതകരമാണ്! അതോടെ നിന്റെ ഇൻഷുറൻസ് നിരക്കും കുറഞ്ഞോ?
ഞാനും എന്റെ ഭാര്യയും ഒരു ക്രൂസ് യാത്ര ബുക്ക് ചെയ്തു.
അയ്യോ, അത് ക്രെയ്ഗ്സ്‌ലിസ്റ്റിൽ നിന്നായിരുന്നോ?
പെട്ടെന്ന് എന്റെ വീട്ടിൽ ഒരു പുരുഷൻ എങ്ങനെ വന്നു?
എന്റെ ഒരു സുഹൃത്ത് ഇപ്പോഴാണ് ഒരു പുതിയ കാർ വാങ്ങിയത്.
ചിലപ്പോൾ എന്റെ സഹോദരന്മാരെക്കുറിച്ച് ചിന്തിക്കുമ്പോൾ ഞാൻ വികാരാധീനനാകും; അവർ എനിക്ക് വളരെ പ്രധാനപ്പെട്ടവരാണ്.
അവൻ അവിടെ ഉണ്ടാകേണ്ടതില്ലായിരുന്നോ?
നാശനഷ്ടങ്ങളും മോഷണം പോയ സാധനങ്ങളും കണ്ടപ്പോൾ ഞാൻ ആകെ തകർന്നുപോയി.
നിന്റെ ഉച്ചഭക്ഷണത്തെക്കുറിച്ച് എന്തെങ്കിലും എഴുതിയ ഒരു ബോർഡ് ഉണ്ടാക്കണം.
ലൈവിൽ ഇത്ര പെട്ടെന്ന് ഇത് വളരെ നല്ലൊരു തുടക്കമാണ്
എന്റെ കുട്ടികൾ എല്ലാ രാത്രിയും ഉറങ്ങാൻ പോകാൻ വിസമ്മതിക്കുന്നു
അവൻ അത് ആസ്വദിച്ചെന്ന് ഞാൻ കരുതി
നിങ്ങളുടെ മാതാപിതാക്കൾക്ക് നിങ്ങളെക്കുറിച്ച് തീർച്ചയായും വളരെ അഭിമാനമുണ്ടാകും
എന്റെ പല്ലുകൾ വളരെ മോശമാണ്
നീ അവനെ വഷളാക്കുമോ
ഇന്ന് ഓഫീസിൽ ഞാൻ ഉച്ചത്തിൽ ഒരു കീഴ്‌വായു വിട്ടു
അലങ്കോലമായ ആളുകളെ എനിക്ക് സഹിക്കാനാവില്ല
അതെ, അതിനെക്കുറിച്ച് എന്നോട് പറയൂ
അവർ വീട്ടിലുണ്ടാകുമ്പോൾ എനിക്ക് ഇഷ്ടമാണ്
ഇവിടെയുള്ള ചുറ്റുമുള്ള ആളുകളുമായി എനിക്ക് അധികം സാമ്യമില്ല
ഈ ദിവസങ്ങളിൽ എന്റെ ബോസിനോട് എനിക്ക് ഭയങ്കര ദേഷ്യമാണ്
ഞാൻ പരാജയപ്പെട്ടവനാണെന്ന് തോന്നുന്നു
അവൾ ജോലിയിൽ നിന്ന് നേരത്തെ വീട്ടിലെത്തിയിരുന്നു
ഇത് ബുദ്ധിമുട്ടാകാൻ പോകുകയാണ്
ആരുടെയെങ്കിലും ജന്മദിനത്തിൽ അർദ്ധരാത്രിയിൽ ഹാപ്പി ബർത്ത്‌ഡേ പാടിക്കൊണ്ട് മത്തങ്ങത്തോട്ടത്തിലേക്ക് പോകുന്നത്
എല്ലാവർക്കും അവരവരുടെ കുറവുകൾ ഉണ്ടെന്ന് തോന്നുന്നു
നിനക്ക് ആവേശമുണ്ടെന്ന് എനിക്ക് തോന്നുന്നു
ഞാൻ എത്രയും വേഗം മറ്റൊന്ന് വാങ്ങാൻ പോകുന്നു
അവൾക്കായി എല്ലാം നന്നായി നടക്കുമെന്ന് പ്രതീക്ഷിക്കുന്നു
അത് കേട്ടപ്പോൾ വിഷമമായി, നിനക്ക് ഇത് വളരെ ബുദ്ധിമുട്ടായിരിക്കണം.
അവർ ഫോണിലായിരുന്നോ?
അതെ, അത് ശരിയാണ്; ഞാനും അതേ കാര്യമാണ് ചെയ്തത്.
നിനക്ക് അധ്യാപകനോടോ പ്രൊഫസറോടോ ചോദിക്കാമോ?
ഇന്ന് രാവിലെ ഞാൻ വളരെ നേരത്തെ എഴുന്നേറ്റു; ഒട്ടും ഉറങ്ങാൻ കഴിഞ്ഞില്ല.
നല്ല ഷോകളെല്ലാം അവസാനിച്ചുകൊണ്ടിരിക്കുകയാണ്.
അന്ന് ഞാൻ പ്രൊഫഷണൽ റോഡിയോ കാണുകയായിരുന്നു.
എല്ലാം നന്നായി പോയി, പക്ഷേ ആ ഫാംഹൗസ് എനിക്ക് മിസ് ചെയ്യും.
ആദ്യം കാര്യങ്ങൾ സ്ഥിരപ്പെടുത്തൂ, പിന്നെ പതിവായി പണം സേവ് ചെയ്യൂ.
സെപ്റ്റംബറിൽ അവർ സ്കോട്ടിഷ് റൈറ്റ് ആശുപത്രിയിൽ നൃത്തം ചെയ്യും.
എന്റെ റൂംമേറ്റ് ഒന്നും വൃത്തിയാക്കില്ല.
ആ ഫോൺ കവറുകൾ അത്ര നല്ലതല്ല.
നീ ജയിക്കുമ്പോൾ വാർത്തയിൽ വരുമോ?
കുറച്ച് മെക്സിക്കൻ മിഠായികൾ രുചിച്ചുനോക്കാൻ കാത്തിരിക്കാനാവുന്നില്ല.
ഹഹാ, അവൻ നിന്നോടും അതേ കാര്യം തന്നെയായിരിക്കും പറയുക.
അന്ന് ഞാൻ ഒരു പാട്ട് കേട്ടു; അത് എനിക്ക് പഴയകാലം ഓർമ്മിപ്പിച്ചു.
എനിക്ക് ഈ ജോലി അവസരം കിട്ടിയിട്ടുണ്ട്, പക്ഷേ ഇത് എനിക്ക് ചേരുമെന്ന് തോന്നുന്നില്ല.
ഇപ്പോൾ വേനൽ കഴിഞ്ഞതിനാൽ കാര്യങ്ങൾ മെച്ചപ്പെടണം.
അവൾ നമ്മളെക്കുറിച്ച് താനേ തയ്യാറാക്കിയ ഒരു സ്ക്രാപ്ബുക്ക് കൊണ്ടുവന്നിരുന്നു.
എന്റെ ബോയ്ഫ്രണ്ട് ഹോളണ്ടിലാണ് താമസിക്കുന്നത്, ഞാൻ യുകെയിലും; എന്നിട്ടും എനിക്ക് അവനെ വളരെ വിശ്വാസമാണ്.
ഇന്നലെ രാത്രി ചൂടൻ ചോക്ലേറ്റ് കുടിച്ചുകൊണ്ട് സുഖമായി ചുരുണ്ടുകിടന്ന് ഒരു കിടിലൻ സിനിമ കാണുകയായിരുന്നു.
അടുത്ത മാസത്തിനായി ഇനി കാത്തിരിക്കാനാവില്ല.
അവരെ ബന്ധപ്പെടാൻ വേറെ എന്തെങ്കിലും മാർഗമുണ്ടോ?
നിനക്ക് സ്കൂളുകളിൽ ജോലി ചെയ്യാൻ ആഗ്രഹമുണ്ടോ?
ഒരുപക്ഷേ ഞാൻ ഒരു അപ്പോയിന്റ്മെന്റ് എടുക്കണം.
അവന് നിന്നെ സ്നേഹിക്കുന്നുണ്ടെങ്കിൽ അതൊന്നും പ്രശ്നമല്ല. അവസാനം എല്ലാം ശരിയാകും എന്ന് എനിക്ക് ഉറപ്പുണ്ട്.
എന്റെ വീടിന്റെ ക്ലോസിംഗ് ഇപ്പോൾ നടക്കുകയാണ്. ഇനിയും കുറച്ച് ആഴ്ചകൾ വേണ്ടിവരും, പക്ഷേ ഇത് എന്നേക്കുമായി നീളുന്നതുപോലെ തോന്നുന്നു.
എനിക്ക് പരിക്കൊന്നും പറ്റിയില്ല, പക്ഷേ എന്റെ കാറിൽ ഒരു പോറലും കുറച്ച് ഡെന്റുകളും ആയി.
പക്ഷേ അത് അത് തിരികെ നൽകുകയും ഏകാന്തതയുടെ ഭാഗം നികത്തുകയും ചെയ്യുന്നു.
ആ കുറിപ്പ് എന്തിനുള്ളതാണ്?
എനിക്ക് നല്ലൊരു കാർ വാങ്ങാൻ കഴിയുന്നതിൽ വളരെ സന്തോഷമുണ്ട്. എന്റെ പഴയ കാർ അഞ്ച് മാസത്തിലൊരിക്കൽ ശരിയാക്കേണ്ടി വരുമായിരുന്നു.
സ്വർഗത്തിൽ ജീവിക്കുന്നത് എങ്ങനെയായിരുന്നു?
ഒരുപാട് ആളുകൾ അതിനോട് യോജിക്കുന്നില്ലെന്ന് തോന്നുന്നു.
അവൻ ഒരു ഭ്രാന്തൻ ടൈപ്പാണ്.
അതെ, അവർ ചെയ്തത് വളരെ മോശമായിപ്പോയി.
എന്റെ കുഞ്ഞ് കുറച്ച് വർഷങ്ങൾക്ക് മുമ്പ് മരിച്ചു.
അത് ആരായിരുന്നുവെന്ന് നിനക്കറിയാമോ?
ഇത് പ്ലാൻ ചെയ്ത വ്യക്തിയോട് നീ നന്ദി പറയണം.
എന്നോട് കൂടുതൽ പറഞ്ഞത് ആരാണ്?
ആ സിനിമകൾ ഇന്നത്തേത്ര നല്ലതല്ലെന്നാണ് എന്റെ കുട്ടികൾ കരുതുന്നത്.
നിനക്ക് കുഴപ്പമില്ലെന്ന് അറിഞ്ഞതിൽ സന്തോഷം, എന്താണ് സംഭവിച്ചത്?
എന്റെ ഏറ്റവും നല്ല സുഹൃത്ത് അടിപൊളിയാണ്.
ഞാൻ ഉടൻ യൂറോപ്പിലേക്ക് പോകുകയാണ്.
ദുഃഖത്തിൽ നിന്ന് മുക്തി നേടാൻ എപ്പോഴും സമയം എടുത്തേക്കാമെന്ന് എനിക്ക് ഉറപ്പുണ്ട്.
ഇതിനെക്കുറിച്ച് നിനക്ക് എന്തെങ്കിലും ചെയ്യാനാകുമോ?
മിക്കവാറും എന്റെ ബാല്യവും അവന്റെ ബാല്യത്തിന്റെ കുറച്ച് ഭാഗവും.
അവന് ഇത് ഇഷ്ടപ്പെടുമെന്ന് എനിക്ക് ഉറപ്പാണ്.
എന്തോ കാരണത്താൽ നീ ആവേശത്തിലോ ഉത്സാഹത്തിലോ ആണെന്ന് തോന്നുന്നു.
കഴിഞ്ഞ ദിവസം ഞാൻ എന്റെ കാറിന്റെ തെർമോസ്റ്റാറ്റ് മാറ്റി.
അവർ അത് അന്നേ ചെയ്തിരുന്നെങ്കിൽ നന്നായേനെ, പക്ഷേ ഇപ്പോൾ എനിക്ക് കാത്തിരിക്കണം.
എന്റെ സഹോദരൻ അസുഖപ്പെട്ടു, യാതൊരു മുന്നറിയിപ്പുമില്ലാതെ മരിച്ചു.
എന്റെ വാക്ക് കേൾക്കൂ, ഒരു ദിവസം ഈ റാമൻ നൂഡിൽസ് ഫിലെ മിഗ്നോൺ സ്റ്റീക്കുകളായി മാറും.
ഇരുട്ടിൽ ജീവിച്ചുകൊണ്ട് പുല്ല് മുറിക്കണമെന്ന് അവർ എങ്ങനെ കണ്ടുപിടിച്ചെന്ന് ഞാൻ അത്ഭുതപ്പെടുന്നു.
അതിന് എന്തെങ്കിലും നല്ല കാരണമുണ്ടോ? അതായത്, അവന്റെ ആത്മാഭിമാനം ശരിക്കും വളരെ കുറവാണ്.
നീ സിനിമകൾ കാണാനോ വീഡിയോ ഗെയിമുകൾ കളിക്കാനോ ശ്രമിച്ചോ?
പോക്കർ കളിച്ചതിന് ശേഷം എനിക്ക് ചിലർക്ക് പണം കൊടുക്കാനുണ്ട്.
നമ്മൾ ഒരുമിച്ച് ആസ്വദിച്ച കാലത്തെ അവളുടെ പഴയ ഫോട്ടോ ആൽബങ്ങൾ എല്ലാം നോക്കിയത് ശരിക്കും നല്ല അനുഭവമായിരുന്നു.
ശനിയാഴ്ച എന്താണ് നടക്കുന്നത്?
ഇല്ല, അത് തമാശയാണെന്ന് അവർ കരുതി.
ഞാൻ എന്നെത്തന്നെ ഒന്ന് ട്രീറ്റ് ചെയ്യാമെന്നും നഗരത്തിൽ പരിപാടി അവതരിപ്പിക്കാൻ ആരാണ് വരുന്നതെന്ന് നോക്കാമെന്നും കരുതുന്നു.
പക്ഷേ അതൊരു ഭയങ്കര വലിയ രഹസ്യമായേനേ.
എനിക്ക് ഭയങ്കര വിഷമമുണ്ട്, ഞാൻ അത് ചെയ്യരുതായിരുന്നു.
കഴിഞ്ഞ രാത്രി മദ്യലഹരിയിൽ ദേഷ്യപ്പെട്ട് ഞാൻ എന്റെ വീട്ടിൽ വലിയ ബഹളം ഉണ്ടാക്കി.
ഒടുവിൽ ഈ മാറ്റത്തിന് കാരണമെന്തായിരുന്നു?
നിന്റെ കാറിൽ എന്തെങ്കിലും കുടുങ്ങിയിരുന്നോ?
അതെ, എനിക്കറിയാം, ഞാൻ വീണ്ടും വീണ്ടും അവളെക്കുറിച്ചാണ് ചിന്തിച്ചുകൊണ്ടിരുന്നത്.
പക്ഷേ ഞാൻ പോയില്ല.
ഞാൻ ഇപ്പോഴും പ്രത്യേകിച്ച് എന്റെ ഒരു മുൻ കാമുകിയെക്കുറിച്ച് ചിന്തിക്കാറുണ്ട്.
നിനക്ക് എനിക്ക് ഒരു ഉദാഹരണം തരാമോ?
അവൻ നന്നായി സുഖം പ്രാപിക്കുമെന്ന് ഞാൻ പ്രതീക്ഷിക്കുന്നു.
അത് ശരിക്കും നല്ലൊരു അനുഭവമല്ല.
എനിക്കും ഇല്ല—അതിലൊന്ന് കടിച്ചാൽ എങ്ങനെയിരിക്കുമെന്ന് ചിന്തിച്ചുനോക്കൂ.
നിങ്ങൾ വലിയൊരു ഫുട്ബോൾ ആരാധകനാണെന്ന് തോന്നുന്നു.
നിങ്ങൾ ഏത് പുസ്തകമാണ് വായിച്ച് ആസ്വദിച്ചിരുന്നത്?
അവൻ മരുന്ന് കഴിക്കുന്നത് നിർത്തിയിരിക്കണം, അല്ലെങ്കിൽ അങ്ങനെ എന്തെങ്കിലും.
എന്താണ് സംഭവിച്ചതെന്ന് പറയാമോ? ഒരുപക്ഷേ എനിക്ക് നിന്നെ സഹായിക്കാനായേക്കും.
അവനെ കണ്ടെത്താനാകാത്തതിൽ എനിക്ക് ശരിക്കും വളരെ വിഷമമായി.
ഓ, അത് ബുദ്ധിമുട്ടായേനേ.
പാർട്ടി അടുത്ത ആഴ്ചയാണ്. താൻ വരുമോ ഇല്ലയോ ഉറപ്പില്ലെന്ന് അവൾ പറഞ്ഞു.
അവരുടെ നിലയിലേക്ക് താഴ്ന്നിറങ്ങേണ്ട കാര്യമില്ല.
എന്റെ കമ്പ്യൂട്ടറിലെ ഗ്രാഫിക്സ് കാർഡ് അപ്ഗ്രേഡ് ചെയ്യുന്നതിനെക്കുറിച്ച് ഞാൻ ചിന്തിക്കുകയായിരുന്നു.
ആരുമായി നല്ലൊരു ബന്ധം നിലനിർത്താനും വിശ്വാസം ഒരു പ്രധാന ഘടകമാണ്.
ചിലപ്പോൾ തുക വളരെ കൂടുതലായിരിക്കും, അവൾ ഒരിക്കലും സമയത്ത് പണം നൽകാറില്ല.
നീ ഇപ്പോഴേ ഒരുപാട് മൃദുവായ ബ്രൗണികൾ കഴിച്ചോ?
നിന്റെ ബോസ് നിന്നോട് ദേഷ്യത്തിലായിരുന്നോ?
എന്റെ കാമുകിയുമായി 3 വർഷം ഡേറ്റിംഗ് നടത്തിയിട്ടും അവൾ ഇപ്പോഴും എന്റെ വിവാഹാഭ്യർത്ഥന സ്വീകരിക്കുന്നില്ല; എനിക്ക് ഭയങ്കര ദേഷ്യമാണ്.
അത് വളരെ നിരാശാജനകമായിരുന്നിരിക്കണം എന്ന് എനിക്ക് അറിയാം.
ഹഹാ, അപ്പോൾ നീ കള്ളം പറഞ്ഞതാണോ?
അവൻ ഏത് തരത്തിലുള്ള കാറാണ് വാങ്ങിയത്?
വാവ്, അത് നല്ലതാണ്; വളരെ ഉന്മേഷം തോന്നുന്നു.
ഞാൻ ഇന്നലെ രാത്രി സെന്റ് ജൂഡിന്റെ ഒരു ഇൻഫോമെർഷ്യൽ കണ്ടു.
അവൻ ഇതിനായി വളരെയധികം പരിശ്രമിച്ചു, അതുകൊണ്ട് അവൻ ഇത് അർഹിക്കുന്നുവെന്ന് ഞാൻ പറയും.
അപ്പോൾ അത് എങ്ങനെയായിരുന്നു?
അയ്യോ, പ്രത്യേകിച്ച് ഒരു വ്യത്യസ്തമായ സ്ഥലത്ത്.
ഉണ്ടായ അനുഭവത്തേക്കാൾ മികച്ചത് മറ്റൊന്നും ആകുമായിരുന്നില്ല.
എനിക്ക് വളരെ അടുത്ത കുറച്ച് സുഹൃത്തുക്കൾ മാത്രമേയുള്ളൂ; അവരുമായി ഞാൻ വളരെ അടുപ്പത്തിലാണ്.
എനിക്ക് അവളോട് അത്രയും ദേഷ്യം വന്നു, രാത്രി മുഴുവൻ അവളെ അവളുടെ മുറിയിൽ തന്നെ ഇരുത്തി.
ഞാൻ മറ്റൊരു സഹപ്രവർത്തകനോട് തോറ്റു.
അത്തരത്തിലുള്ള കാര്യങ്ങൾ ഇടയ്ക്കിടെ സംഭവിക്കാറുണ്ടായിരുന്നു.
ഒരു പ്രത്യേക വ്യക്തിയിൽ നിന്ന് കിട്ടിയ സമ്മാനം പോലെ.
അതെ, ഈ മാസം ഞാൻ വ്യായാമം തുടങ്ങിക്കഴിഞ്ഞു. കുറഞ്ഞത് 20 പൗണ്ട് ഭാരം കുറയ്ക്കാൻ ഞാൻ ഉറച്ച തീരുമാനത്തിലാണ്.
ഇത് കാൽക്കുലസ് പരീക്ഷയാണ്, എനിക്ക് 60-ൽ കൂടുതൽ മാർക്ക് നേടണം.
അതെ, അങ്ങനെ ആയിരിക്കാം. പക്ഷേ അടുത്ത തവണ അത് വാങ്ങുന്നുവെന്ന് ഉറപ്പാക്കണം.
ഇനി നീ കൂടുതൽ തവണ പോകുമെന്ന് എനിക്ക് ഉറപ്പാണ്.
ഞാൻ എന്റെ കുടുംബത്തിൽ നിന്ന് 800 മൈൽ അകലെയാണ്, അവരെ എനിക്ക് വളരെ ഓർമ്മ വരുന്നു.
65 ഇഞ്ച് ടെലിവിഷൻ വാങ്ങാൻ കഴിഞ്ഞതിൽ എനിക്ക് വളരെ സന്തോഷം. വർഷങ്ങളോളം എന്റെ കൈയിൽ 19 ഇഞ്ചിന്റെ ഒരു ചെറിയ ടിവിയായിരുന്നു.
അവൻ അഞ്ച് വർഷമായി എന്റെ കൂടെയുണ്ട്.
ഇത് നീയും നിന്റെ ഭാര്യയും എടുത്ത നല്ല തീരുമാനമാണെന്ന് എനിക്ക് തോന്നുന്നു.
നിനക്ക് ഡോക്ടറുടെ അടുത്തേക്ക് പോകേണ്ടി വന്നോ?
ഇന്ന് രാത്രി ശക്തമായ കൊടുങ്കാറ്റ് ഉണ്ടാകുമെന്നായിരുന്നു കരുതിയത്.
ഞാൻ ലോകത്തിന്റെ മുകളിലാണെന്ന പോലെ തോന്നുന്നു.
അവർ ശരിക്കും എനിക്ക് പൂക്കൾ കൊണ്ടുവന്നു.
നിനക്ക് എപ്പോഴാണ് തയ്യാറാണെന്ന് തോന്നിയത്?
അതെ, എനിക്ക് അത് വിശ്വസിക്കാം.
അതായത്, അവിടെ നിന്ന് നിന്റെ അടുത്തെത്താൻ എത്ര സമയം എടുക്കും?
ഇന്നലെ ലോട്ടറി ജയിക്കാതിരുന്നതിൽ എനിക്ക് കുറച്ച് വിഷമം തോന്നി.
ഈ വാരാന്ത്യത്തിൽ എന്റെ ഹൈസ്കൂൾ റീയൂണിയനാണ്, അതിനാൽ ഞാൻ വളരെ ആവേശത്തിലാണ്.
അയ്യോ ഇല്ല, ഇതൊരു മോശം തമാശയാണോ?
അവരെ കാണുന്നതിൽ എനിക്ക് വളരെ സന്തോഷമുണ്ട്.
എന്ത് സംഭവിച്ചാലും ഞാൻ എപ്പോഴും എന്റെ ഭർത്താവിനൊപ്പം നിൽക്കും.
ഇന്ന് എന്റെ മകൻ തന്റെ ആദ്യ വാക്ക് പറഞ്ഞു
രാജ്യം വിടാൻ ഇനി കാത്തിരിക്കാനാവില്ല
നിനക്ക് കറ കളയാൻ കഴിഞ്ഞോ
എന്റെ മകൻ പെർമനന്റ് മാർക്കർ കൊണ്ട് എന്റെ കാറിലാകെ വരച്ചുവച്ചു
അതെ, എനിക്ക് പിസ്സ വളരെ ഇഷ്ടമാണ്
അതെ, തകർന്നുപോയ ഒരു വിവാഹത്തിന്റെ ഫലമാണ് ഞാൻ
ഇത് കുറച്ച് ബുദ്ധിമുട്ടാണ്, പക്ഷേ അടുത്ത പരീക്ഷ നന്നായി കൈകാര്യം ചെയ്ത് മികച്ച മാർക്ക് നേടാനാണ് ഞാൻ പ്ലാൻ ചെയ്യുന്നത്
നീ വലിയ കുഴപ്പത്തിൽപ്പെട്ടോ
എന്താണ് നിന്നെ ഇത്ര ദേഷ്യം പിടിപ്പിച്ചത്
പഠിക്കുമ്പോൾ നിനക്ക് ഉറക്കം വന്നോ
ഞാനും എന്റെ സഹോദരനും ഞങ്ങൾ താമസിക്കുന്നിടത്തിന് അടുത്തുള്ള ഒരു എംഎംഎ ഷോയിലേക്ക് എന്റെ അനന്തരവനെ കൊണ്ടുപോകുകയാണ്
നീ അവൾക്ക് എന്താണ് കൊടുക്കാൻ പ്ലാൻ ചെയ്യുന്നത്
അതെ, പക്ഷേ സന്തോഷമുള്ള ദിവസങ്ങളിലാണ് എനിക്ക് അവ കൂടുതൽ ഇഷ്ടം
ഓഹ് വാവ്, അത് രസകരമാണ്
നീ താമസം മാറിയപ്പോൾ വളരെ സന്തോഷിച്ചേനേ
മറ്റുള്ളവർക്ക് സമ്മാനങ്ങൾ വാങ്ങേണ്ടി വരുന്നത് എനിക്ക് ഇഷ്ടമല്ല
പക്ഷേ അവർ തിരച്ചിലിന് ശേഷം ഒരിക്കലും വൃത്തിയാക്കാൻ മെനക്കെട്ടില്ല
ശരി, അവന് നല്ലൊരു സഹോദരനുണ്ട്
അവൻ ശരിക്കും സ്വയം പരിക്കേൽപ്പിച്ചേക്കാമെന്ന് എനിക്ക് തോന്നുന്നു
നിനക്ക് അഭിമാനം തോന്നാൻ അവർ എന്താണ് ചെയ്തത്
ഞാൻ കുറച്ച് മുമ്പ് ഡിന്നറിന് മക്‌ഡൊണാൾഡ്സിൽ പോയിരുന്നു.
അവൾ അത്ര മോശമായി എന്താണ് ചെയ്തത്?
ഇത് അന്യഗ്രഹജീവികളാണെന്ന് എനിക്ക് തോന്നുന്നു.
എന്റെ മുത്തശ്ശി മരിച്ചപ്പോൾ എനിക്ക് വളരെ വിഷമമായി.
അതെ, അവരുടെ സംഗീതം എനിക്ക് വളരെ ഇഷ്ടമാണ്.
ഓഹ് ഇല്ല, പോലീസുകാരന് മനസ്സിലായിരുന്നോ?
ശരി, നിനക്ക് അവനോട് കൂടുതൽ സംസാരിക്കാനും ഒരുപക്ഷേ അവിടേക്ക് പോയി കാണാനും കഴിയുമെന്ന് പ്രതീക്ഷിക്കുന്നു.
അത് എത്ര നിരാശാജനകമായി തോന്നിയിരിക്കുമെന്ന് എനിക്ക് സങ്കൽപ്പിക്കാനാകില്ല.
ഞങ്ങൾക്ക് അത് എന്റെ അമ്മയിൽ നിന്ന് മറച്ചുവെക്കേണ്ടിവന്നു.
ജോലിയിൽ എനിക്ക് ഒരു വലിയ പ്രസന്റേഷൻ ഉണ്ട്.
അച്ഛൻ ഉറങ്ങിക്കിടക്കുമ്പോൾ ഞാൻ അദ്ദേഹത്തിന്റെ കാർ എടുത്തു, അബദ്ധത്തിൽ അതിൽ ചുരണ്ടുപോയി.
ഛെ, ആ ആളുകളൊക്കെയാണ് എന്നെ യൂണികോൺ ആകുന്നതിൽ നിന്ന് തടഞ്ഞത്.
എന്റെ ജോലിസ്ഥലത്തെ ഈ സ്ത്രീ വളരെ മധുരമുള്ളവളാണ്, പക്ഷേ അവിടെ ആർക്കും അവളെ ഇഷ്ടമല്ലെന്ന് തോന്നുന്നു.
ചവറ് കളയാൻ പോയപ്പോൾ അതിനുള്ളിൽ പുഴുക്കളെ കണ്ടിട്ട് എനിക്ക് ഏകദേശം ഛർദ്ദി വന്നു.
ഓഹ് ഇല്ല, നിന്റെ പൂച്ചയ്ക്ക് എന്ത് സംഭവിച്ചു?
ഞാൻ ഇപ്പോൾ താമസം മാറാൻ നോക്കുകയാണ്.
വീയ്ക്ക് ശേഷം ഞാൻ മാരിയോ കാർട്ട് കളിച്ചിട്ടില്ല.
അത് അത്ര നല്ലതായിരുന്നു, എനിക്ക് ജോലി കിട്ടിയെന്ന് എനിക്കറിയാം.
എനിക്ക് അതിൽ പ്രശ്നമൊന്നുമില്ല.
ഒരു സുഹൃത്തിനൊപ്പം പുറത്തുപോകുന്നത് എപ്പോഴും നല്ലതാണ്.
അത് ഞാൻ പ്രതീക്ഷിച്ചതുപോലെ നടന്നില്ല.
ഞാൻ ചെറുപ്പത്തിലായിരുന്നപ്പോൾ ഏതാണ്ട് മുങ്ങിപ്പോയിരുന്നു.
എനിക്ക് അധിക പണം വേണം, അത് എനിക്ക് വളരെ അത്യാവശ്യമാണെന്ന് എന്റെ ബോസിന് അറിയാം.
ഡൊണാൾഡ് ട്രംപ് അമേരിക്കയെ വീണ്ടും മഹത്തായതാക്കുമെന്ന് എനിക്ക് ഉറപ്പുണ്ട്.
സ്കൂൾ ഉടൻ തുടങ്ങേണ്ടതാണ്.
എനിക്ക് ജോലി കിട്ടിയെന്ന് നല്ല പ്രതീക്ഷയുണ്ട്.
സിനിമയ്ക്ക് പോകുമ്പോഴെല്ലാം എനിക്ക് എപ്പോഴും ഉത്കണ്ഠ തോന്നും.
ട്രംപ് ഭരണകൂടം നിയമമായി പാസാക്കിയ നികുതി ഇളവുകൾ മൂലധന നിക്ഷേപത്തിൽ നിക്ഷേപകർക്ക് ആത്മവിശ്വാസം നൽകിയെന്ന് എനിക്ക് തോന്നുന്നു.
അതിനെക്കുറിച്ച് എനിക്ക് വിഷമമായി.
എനിക്ക് എപ്പോഴും ആഗ്രഹിക്കാവുന്ന ഏറ്റവും നല്ല ഭർത്താവും മകനുമാണ് എനിക്കുള്ളത്.
അതിൽ നിനക്ക് കുഴപ്പമില്ലേ?
അവ തട്ടിക്കൊണ്ടുപോകുന്നവർക്കുള്ളതാണെന്ന് ഞാൻ സാധാരണയായി കരുതും.
നീ അവന് പുതിയതൊന്ന് വാങ്ങാൻ പോകുകയാണോ?
എന്റെ ഏറ്റവും ഇഷ്ടപ്പെട്ട വിഭവങ്ങൾ ഉപയോഗിച്ച് അമ്മ എനിക്ക് മൂന്ന് കോഴ്സ് ഭക്ഷണം ഉണ്ടാക്കി തന്നു.
അത് എനിക്ക് വിചിത്രമായി തോന്നുന്നു.
ഇത്തരത്തിലുള്ള സാഹചര്യം ഇനി ഉണ്ടാകില്ലെന്ന് പ്രതീക്ഷിക്കുന്നു.
ഭാവിയിൽ നിനക്ക് അത് വേണമെന്നു തോന്നുകയും അപ്പോഴേക്കും വളരെ വൈകിപ്പോകുകയും ചെയ്യുമോ എന്നാണോ പേടി?
ഹഹാ, ഞാൻ ആദ്യത്തേത് കൺസോളിൽ കളിച്ചിരുന്നു. അവർ അത് പിസിക്കായി പുറത്തിറക്കിയിരുന്നെങ്കിൽ നന്നായിരുന്നു.
അവൾ അത്ര നല്ലവളല്ല.
വാരാന്ത്യത്തെക്കുറിച്ച് എനിക്ക് വലിയ പ്രതീക്ഷകളുണ്ട്.
ഏത് കാറിന്റെയും ന്യായമായ വില എനിക്ക് അറിയാമെന്ന് മനസ്സിലാക്കാത്ത ഒരാളെയും കണ്ടെത്താൻ കഴിയാത്തതുപോലെ തോന്നി.
വീണ്ടും അവിടെ മുഖം കാണിക്കാൻ എനിക്ക് തോന്നുന്നില്ല.
അമിതവണ്ണമുള്ള ആളുകളെ കാണുമ്പോൾ എനിക്ക് അലോസരം തോന്നും.
അവൻ അതിനായി വളരെ കഠിനമായി പരിശ്രമിക്കുകയാണ്.
നിനക്ക് കുറ്റബോധം തോന്നില്ലെന്ന് പ്രതീക്ഷിക്കുന്നു.
പക്ഷേ അവസാനം അത് വിലമതിക്കുന്നതാണ്.
ഞങ്ങളുടെ പിന്നാമ്പുറത്ത് എന്റെ നായ ഒരു പൂച്ചയെ കണ്ടെത്തി, അന്നുമുതൽ അതിനെ പരിപാലിക്കുകയാണ്.
ഞാൻ കാർ ഓടിച്ചുപോയി, പക്ഷേ ഭാഗ്യവശാൽ തിരികെ വന്നപ്പോൾ ആരോ അതിനുള്ളിലെ എല്ലാം ഉൾപ്പെടെ അത് ഏൽപ്പിച്ചിരുന്നു.
90-കളുടെ ശേഷം കളിച്ചിട്ടില്ലാത്ത ഒരു വീഡിയോ ഗെയിം ഞാൻ ഇന്നലെ രാത്രി കളിച്ചു.
അതെ, ഇത് എനിക്ക് ശരിക്കും വളരെ പ്രധാനമാണ്.
നീ എന്തിനാണ് പുറത്തുപോയത്?
എനിക്ക് വളരെ നിരാശയായി തോന്നുന്നു.
ഞാൻ ഇപ്പോൾ തന്നെ ഒരുപാട് ഞണ്ടിന്റെ കാലുകൾ കഴിച്ചു.
എനിക്ക് എന്റെ കുടുംബത്തെ ശരിക്കും വളരെ ഇഷ്ടമാണ്.
റോബിൻ വില്യംസ് എന്റെ ഹീറോ ആയിരുന്നു; അദ്ദേഹം മരിച്ചുപോയത് ഇന്നും വളരെ ദുഃഖകരമാണ്.
നിന്റെ സുഹൃത്തുക്കളോടൊപ്പം ഇരിക്കൂ, നിന്നെത്തന്നെ കണ്ടെത്തൂ.
വെള്ളിയാഴ്ച ഞാൻ ഓഫീസിൽ ചെന്നപ്പോൾ എനിക്കായി പിറന്നാൾ ആഘോഷം നടക്കുകയായിരുന്നു.
വാവ്, നിനക്ക് ശരിക്കും ഭാഗ്യം മോശമായിരിക്കാം.
കുട്ടികളെ കൈകാര്യം ചെയ്യുന്നത് ചിലപ്പോൾ ഇങ്ങനെയായിരിക്കും.
എനിക്ക് വെറുതെ വെയിലത്ത് കിടന്ന് ടാൻ ആയി വിശ്രമിക്കണമെന്നേ ഉള്ളൂ, പക്ഷേ അവ എന്റെ മുഖത്തിന് മുന്നിൽ വന്ന് കൈകാലുകളിൽ കുത്തുന്നു—ഭയങ്കര ദേഷ്യം വരുന്നു.
എന്നെങ്കിലും ഞാൻ ലോട്ടറി ജയിച്ച് അത് ചെയ്യാൻ കഴിയുമല്ലോ, ഹാഹാ
എനിക്ക് ആറുമാസം പ്രായമുള്ള ഒരു കുഞ്ഞുണ്ട്
നമ്മുടെ പ്രദേശത്തിന് ചുറ്റുമുള്ള മാനുകളെ കാണുന്നത് എനിക്ക് വളരെ ഇഷ്ടമാണ്, അവ എത്ര ക്യൂട്ടാണ്
ഉറങ്ങുക അസാധ്യമാണ്, നിനക്ക് അങ്ങനെ സംഭവിച്ചതിൽ എനിക്ക് വിഷമമുണ്ട്
ഞാൻ നല്ലവനാകാൻ ശ്രമിച്ചു, പക്ഷേ അവർ എന്റെ എല്ലാ പൂക്കളും നശിപ്പിക്കുകയാണ്
എന്റെ തൊഴിലുടമ എനിക്ക് പ്രമോഷൻ തന്നതിൽ എനിക്ക് വളരെ സന്തോഷമുണ്ട്
നീ ഇതിനെക്കുറിച്ച് ആരോടെങ്കിലും പരാതി പറയാൻ പോകുകയാണോ
അത് ചെയ്യാൻ എനിക്ക് ആകാംക്ഷയുണ്ട്
അത് ഒരുപാട് ഓർമ്മകൾ തിരികെ കൊണ്ടുവന്നു
ഞാൻ എന്റെ കൂടാരത്തിലേക്ക് ഓടി
പക്ഷേ അവൻ ഇപ്പോഴും ഒരു നായ്ക്കുട്ടി മാത്രമാണ്, ഇത്തരത്തിലുള്ള പെരുമാറ്റം പ്രതീക്ഷിക്കാവുന്നതാണ്
അതെ, അതിന് പുറമേ ശമ്പളവും കൂടുതലാണ്
നിനക്കായി കാര്യങ്ങൾ കൂടുതൽ നന്നായി മാറുമെന്ന് ഞാൻ പ്രതീക്ഷിക്കുന്നു
അവനും എന്റെ അച്ഛനും വേട്ടയാടാൻ ഉപയോഗിച്ച റൈഫിളാണിത്
ഞാൻ സിഇഒ സ്ഥാനത്തിനായി അഭിമുഖം നടത്തുകയാണ്
അതെ, ഞാൻ ചെയ്തു, എന്റെ ഭർത്താവിന് സന്തോഷമായില്ല
എന്തിനെക്കുറിച്ച് എന്ന് ചോദിക്കാമോ
ഞങ്ങൾ ഒരുമിച്ച് ഒരുപാട് കളിച്ചു
ഇത് എന്നെ ശരിക്കും തിരക്കിലായിരിക്കാൻ സഹായിക്കുന്നുവെന്ന് എനിക്കറിയാം
അതുകൂടാതെ, അവന്റെ വാക്സിനുകളും അപ്ഡേറ്റ് ചെയ്യിക്കേണ്ടതുണ്ടായിരുന്നു
ഇത് ഒരുപക്ഷേ പെൺകൊതുകായിരിക്കുമെന്ന് മാത്രം ഓർമ്മിക്കൂ.
ഇതിൽ നിന്ന് നല്ലതൊന്നും ഉണ്ടാകില്ല.
അത് വളരെ ആവേശകരമായ അനുഭവമായിരുന്നു, ഞാൻ ഒരുപാട് ആസ്വദിച്ചു.
നിന്റെ വിഷമം മനസ്സിലാകുന്നു ബ്രോ, അവർ ഇതിലും നല്ല ഒരാളെ കണ്ടെത്തി ഒളിച്ചോടാതിരുന്നാൽ മതിയായിരുന്നു.
ബാങ്കിൽ നിന്ന് കിട്ടുമെന്ന് കരുതിയിരുന്ന ലോണിനെ ആശ്രയിച്ചിരിക്കുകയായിരുന്നു, പക്ഷേ അത് കിട്ടില്ലെന്ന് ഇപ്പോഴാണ് അറിഞ്ഞത്.
എന്റെ വരുമാനം കൂടിയിട്ടുണ്ട്, ഫെബ്രുവരിയിൽ വീണ്ടും കൂടും, അതിനായി ഞാൻ കാത്തിരിക്കുകയാണ്.
അതെ, അവൾ അത് പറയുന്നത് കേട്ടുകൊണ്ടേയിരിക്കണം എന്നേ എനിക്ക് തോന്നുന്നുള്ളൂ.
അങ്ങനെ സംഭവിക്കും; തെറ്റുകളിൽ നിന്ന് പഠിക്കാൻ അവ അംഗീകരിക്കണം.
നിനക്ക് നിന്റെ സുഹൃത്തിൽ വലിയ വിശ്വാസമുണ്ടെന്ന് തോന്നുന്നു.
നിനക്ക് ഇത് സഹിച്ച് മറികടക്കാൻ കഴിയുമെന്ന് പ്രതീക്ഷിക്കുന്നു.
അത് വളരെ നല്ല കാര്യമാണ്; നീ അവനെ ആരോഗ്യകരമായ ഭാരത്തിലെത്തിച്ചു.
ഞാൻ ജേണലിസം പഠിപ്പിക്കുന്നു, പക്ഷേ എന്റെ ഒരു വിദ്യാർത്ഥി പുറത്തുപോയി അഭിമുഖങ്ങൾ എടുക്കുന്നത് തന്റെ ദൗത്യമാക്കിയിരിക്കുകയാണ്.
അതിന് പകരം നീ പോയി അവനെ കാണാൻ കഴിയുമോ?
നീ ഉദ്ദേശിച്ചത് യാത്രയാണോ കാറാണോ?
ഇപ്പോൾ എന്റെ ജീവിതത്തിൽ ഞാൻ സന്തോഷവാനാണ്.
എന്റെ അച്ഛൻ എനിക്ക് കുറച്ച് സ്കേറ്റുകൾ വാങ്ങിത്തന്നു.
അത് ശരിയാണ്, എല്ലാവർക്കും അങ്ങനെ തന്നെ വേണമെന്നാണ് എന്റെ ആഗ്രഹം.
പക്ഷേ ഞാൻ ഇത് ഗംഭീരമായി ചെയ്തു കാണിക്കുമെന്ന് ഉറപ്പാണ്.
ഇന്ന് എനിക്ക് ആദ്യമായി ഒരു യഥാർത്ഥ ഇറ്റാലിയൻ റെസ്റ്റോറന്റിലെ അനുഭവം ലഭിച്ചു.
എന്റെ ബോസിനോടും സഹപ്രവർത്തകനോടും സത്യം തുറന്ന് പറയണമെന്നാണ് എനിക്ക് തോന്നുന്നത്.
ഹായ് സുഹൃത്തേ, എനിക്ക് ഇപ്പോഴാണ് ഭയങ്കരമായൊരു കാര്യം സംഭവിച്ചത്.
അധികാരത്തിൽ തുടരാൻ അവർ ഒന്ന് പറയുകയും മറ്റൊന്ന് ചെയ്യുകയും ചെയ്യുന്നു.
അവർക്ക് എന്നെ സഹായിക്കാനായതിൽ എനിക്ക് സന്തോഷമുണ്ട്.
കഴിഞ്ഞ മാസം ഞാൻ ഒരു ലൈസൻസിംഗ് ടെസ്റ്റ് എഴുതി; അതിനായി വളരെ കഠിനമായി പഠിക്കേണ്ടി വന്നു.
ഫേസ്‌ടൈം ഉണ്ടെങ്കിൽ അത്ര മോശമാകില്ലെന്ന് തോന്നുന്നു.
യഥാർത്ഥത്തിൽ അവൻ പാർക്കിൻസൺസിനെക്കുറിച്ചാണ് പ്രവർത്തിക്കുന്നത്.
ഈ വെള്ളിയാഴ്ച എനിക്ക് അറിയാം.
കുറഞ്ഞത് ആരെയെങ്കിലും ബന്ധപ്പെട്ട് എന്താണ് മെച്ചപ്പെടുത്താനാകുകയെന്ന് നോക്കാനായോ?
അത് കുറച്ച് ദിവസത്തേക്ക് നിന്നെ വല്ലാതെ ബുദ്ധിമുട്ടിക്കും.
നീ മുന്നോട്ട് പോയി സന്തോഷത്തോടെ ഇരിക്കണമെന്ന് അവൻ ആഗ്രഹിക്കുന്നുണ്ടാകുമെന്ന് എനിക്ക് തോന്നുന്നു.
ഇത് കൊണ്ട് നീ എന്താണ് എഴുതുന്നത്?
തീർച്ചയായും, അവൾ വളരെ മിടുക്കിയും സുന്ദരിയുമാണ്—രണ്ടും കൂടിയാൽ കിടിലൻ കോമ്പോ തന്നെ.
ഓ ശരിക്കുമോ? എന്തെങ്കിലും കിടിലൻ കാര്യം കിട്ടിയോ?
നീ പരീക്ഷകളിൽ വിജയിക്കാത്തതിൽ ഞാൻ നിന്നോട് ദേഷ്യപ്പെടാതിരിക്കേണ്ടത് എന്തിന്?
നീ സുഖമായിരിക്കുമെന്ന് പ്രതീക്ഷിക്കുന്നു.
അത് ഒരു നിലയുള്ള വീടായിരുന്നോ?
എനിക്ക് എന്നെക്കുറിച്ച് ശരിക്കും വളരെ സന്തോഷമുണ്ട്.
പ്ലംബറെ കാത്തിരിക്കുകയാണ്; ഇന്ന് അവൻ എന്റെ വെള്ളത്തിന്റെ പ്രശ്നം ശരിയാക്കുമെന്ന് പ്രതീക്ഷിക്കുന്നു.
ഞാൻ യഥാർത്ഥത്തിൽ അമേരിക്കയിലല്ല, അതിനാൽ നിന്നെപ്പോലെ അതേ സന്തോഷം പങ്കിടാൻ കഴിയില്ല, പി.
അത് പ്രധാനപ്പെട്ട ഒന്നും ആയിരുന്നില്ല.
ഇത് ചെയ്യാൻ ചെലവ് കൂടുതലാണോ?
ഈ ടി-ഷർട്ട് ഏത് ബാൻഡിനുള്ളതായിരുന്നു?
ഇത് പെട്ടെന്ന് വന്നിരുന്നെങ്കിൽ എന്ന് ആഗ്രഹിക്കുന്നു.
അവൻ ചെയ്തത് വളരെ നല്ലതായിരുന്നു.
അത്ര ബുദ്ധിമാനല്ലാത്ത ഒരാൾക്ക് എങ്ങനെ ഇത്ര സമ്പന്നനാകാൻ കഴിയുമെന്ന് എനിക്ക് മനസ്സിലാകുന്നില്ല.
എന്റെ അച്ഛൻ അവൾക്കായി ഒരുപാട് ചെയ്തു.
സാധാരണയായി ഞാൻ ആശങ്കപ്പെടുമായിരുന്നെങ്കിലും, നമ്മുടെ ബന്ധം വളരെ നന്നായി പോകുന്നതിനാൽ ഞാൻ ഇപ്പോഴും പ്രതിബദ്ധനും ആശങ്കയില്ലാത്തവനുമാണ്.
ഇത് എന്റെ ബാല്യകാലം ഓർമ്മിപ്പിക്കുന്നു.
നിന്റെ സഹപ്രവർത്തകനേക്കാൾ കൂടുതൽ കാലമായി നീ അവിടെ ജോലി ചെയ്യുകയാണോ?
കുറച്ച് കാലം മുമ്പ് ന്യൂ സ്മിർണയിൽ ഞാൻ കടൽത്തീരത്ത് കുറച്ച് മീൻ പിടിച്ചിരുന്നു.
ഞാൻ എപ്പോഴും നിന്നോട് നന്ദി പറയും.
കുട്ടികൾ ചെയ്യുന്നതെല്ലാം അപ്പോഴാണ് തുടങ്ങുന്നത്.
എന്റെ ജന്മദിനത്തിന് ജോലിയിൽ നിന്ന് അവധിയുണ്ടായിരുന്നിട്ടും അതിന് പണം കിട്ടിയെന്ന് ഞാൻ മനസ്സിലാക്കി.
ചില ജോലികൾ ബുദ്ധിമുട്ടുള്ളവയാണ്.
ഞാൻ എന്റെ റൂംമേറ്റിനെ വിശ്വസിച്ചിരുന്നു, പക്ഷേ അവൾ എന്റെ സാധനങ്ങൾ പരിശോധിക്കുകയായിരുന്നെന്ന് പിന്നീട് മനസ്സിലായി.
നിങ്ങളുടെ ഇൻഷുറൻസിൽ പുതിയ കെയർ റീപ്ലേസ്‌മെന്റ് ഓപ്ഷൻ ഉണ്ടോ?
ഇത് എന്റെ പുരോഗതിയെ അതിവേഗത്തിലാക്കും.
എനിക്ക് മൃഗങ്ങളെ പേടിയാണ്.
എന്റെ സുഹൃത്തിന്റെ അമ്മയ്ക്ക് കാൻസറാണ്, അവൾക്ക് ഇനി എത്രകാലം ഉണ്ടാകുമെന്ന് ഞങ്ങൾക്ക് ഉറപ്പില്ല.
കഴിഞ്ഞ രാത്രി എന്റെ കട്ടിലിനടിയിൽ നിന്ന് വളരെ വിചിത്രമായ ചില ശബ്ദങ്ങൾ കേട്ടു.
നിനക്ക് നിന്നോടുതന്നെ സമാധാനമായി ജീവിക്കാനാകുന്നുണ്ടോ എന്നതാണ് പ്രധാനപ്പെട്ടത്.
അവളെക്കുറിച്ച് എനിക്ക് വളരെ വിഷമമുണ്ട്.
ഒരുപക്ഷേ പ്രാർത്ഥിക്കൂ, അപ്പോൾ അവൾ നിന്റെ വാക്ക് കേൾക്കും.
വീക്കൻഡ് നന്നായിരിക്കുമെന്ന് എനിക്ക് നല്ലൊരു തോന്നലുണ്ടായിരുന്നു.
കുറച്ചുകാലം അതിനെക്കുറിച്ചും അവനെക്കുറിച്ചും എനിക്ക് മോശം തോന്നലുകളുണ്ടായിരുന്നു, പക്ഷേ പിന്നീട് ഞാൻ അതിൽ നിന്ന് മുക്തനായി.
സുഹൃത്തേ, എന്റെ പിറന്നാളിന് എന്റെ കുടുംബം എനിക്ക് വേണ്ടി ചെയ്തത് നീ വിശ്വസിക്കില്ല.
അവനിൽ നിന്ന് നിനക്ക് ഉടൻ വാർത്ത ലഭിക്കുമെന്ന് ഞാൻ പ്രതീക്ഷിക്കുന്നു.
അവർ ഒരേസമയം ഇത്രയും ഹോട്ട്‌ഡോഗ് കഴിക്കുന്നത് കണ്ടപ്പോൾ ഞാൻ ഞെട്ടിപ്പോയി.
നിനക്ക് അത് ആവശ്യമുണ്ടായിരുന്നോ?
ജോലിക്ക് പോകുന്ന വഴിയിൽ ഞാൻ പതുക്കെ ഓടിച്ചിരുന്ന ഒരു ഡ്രൈവറുടെ പിന്നിൽ പെട്ടുപോയി.
അങ്ങനെയാണെങ്കിൽ അത് ശരിക്കും വിഷമകരമാണ്, ഞാനും സമ്മതിക്കുന്നു.
എന്റെ മുത്തശ്ശി രണ്ടാഴ്ച മുമ്പ് മരിച്ചു.
സുഹൃത്തേ, കഴിഞ്ഞ ആഴ്ച ഒരാൾ എന്നെ ഇടിക്കാനൊരുങ്ങിയതുകൊണ്ട് ഞാൻ ഏകദേശം ഒരു അപകടത്തിൽപ്പെടുകയായിരുന്നു.
വേലി കെട്ടിയ മുറ്റം ഉണ്ടാകുന്നത് സഹായകരമാണ്, പക്ഷേ രാത്രിയിൽ ചില കാര്യങ്ങളെക്കുറിച്ച് എനിക്ക് ആശങ്കയുണ്ട്.
എങ്കിൽ നിന്നെ പേടിപ്പിക്കുന്ന കഥകൾ ഒഴിവാക്കൂ.
ഈ സമയത്ത് ഇതിലുപരി എനിക്ക് മറ്റൊന്നും ചോദിക്കാനില്ല.
ഞാൻ നാല് തവണ പറഞ്ഞിട്ടും എന്റെ അപ്പാർട്ട്മെന്റിലെ ചോരുന്ന ടാപ്പ് വീട്ടുടമ ഇതുവരെ ശരിയാക്കിയിട്ടില്ല.
എന്റെ ഒരു അടുത്ത സുഹൃത്തിന്റെ സുഹൃത്ത് എന്റെ അടുത്ത സുഹൃത്തിനെക്കുറിച്ച് എന്നോട് കിംവദന്തികൾ പറയുകയായിരുന്നു.
അവൻ എന്റെ പിന്നാലെയുണ്ടെന്ന് കരുതി എനിക്ക് വല്ലാതെ പേടിച്ചു.
എന്റെ അടുത്ത വീട്ടിൽ ആരാണ് താമസിക്കാൻ വരുന്നതെന്ന് ഓർത്ത് എനിക്ക് പേടിയുണ്ട്.
നിങ്ങൾ ക്ലർക്കിനോട് എന്തെങ്കിലും പറഞ്ഞോ?
അതെ, ട്രാഫിക്കിൽ കുടുങ്ങുന്നത് എനിക്ക് ഒട്ടും ഇഷ്ടമല്ല.
എന്റെ ജീവിതത്തിൽ ഞാൻ ഒരിക്കലും ഒന്നും മോഷ്ടിച്ചിട്ടില്ല.
അമേരിക്കൻ സമ്പദ്‌വ്യവസ്ഥയെക്കുറിച്ച് എനിക്ക് വലിയ പ്രതീക്ഷയുണ്ട്.
നിങ്ങൾ വളരെ നല്ല സഹപ്രവർത്തകനും ജീവനക്കാരനുമാണെന്ന് എനിക്ക് ഉറപ്പാണ്.
നിങ്ങളുടെ ഡേറ്റ് എങ്ങനെ പ്രതികരിച്ചു?
ഞാൻ ഒരുപാട് പരിശീലിച്ചിരുന്നു.
ഞാൻ ജയിച്ചില്ലെങ്കിലും കുറഞ്ഞത് ഫൈനലിലെങ്കിലും എത്തുമെന്ന് വളരെ പ്രതീക്ഷിച്ചിരുന്നു, പക്ഷേ കഴിഞ്ഞില്ല.
നിങ്ങൾ ഇങ്ങനെ പറയുന്നത് എന്തുകൊണ്ടാണ്?
ഫ്രഷ്മാൻ വർഷത്തിൽ ഒരിക്കൽ കേൾക്കുമ്പോഴേ സംശയാസ്പദമായി തോന്നുന്ന ഒരു പാർട്ടിയിലേക്ക് എന്നെ ക്ഷണിച്ചിരുന്നു.
എന്റെ ജീവിതത്തിൽ ഞാൻ ഇത്രയും തയ്യാറായിട്ടില്ല.
ജോലിയും വരുമാനവും സംബന്ധിച്ച് കുറച്ചൊക്കെ.
നിങ്ങൾ തന്നെ സ്കൂളിൽ പോയിരുന്നോ ഇല്ലയോ?
ഡേറ്റ് നൈറ്റിനായി ഞാൻ പൂർണ്ണമായും തയ്യാറാണ്.
എന്റെ സുഹൃത്ത് എപ്പോഴും എന്നെക്കാൾ മുമ്പ് എല്ലാം നേടുന്നു.
ശരി, എനിക്ക് വൈകുന്നതിനെക്കുറിച്ചല്ല, ചുറ്റും കൊടുങ്കാറ്റുള്ളപ്പോൾ പറക്കുന്നതിനെക്കുറിച്ചാണ് കൂടുതൽ ആശങ്ക.
വേനലവധിക്ക് ഞാൻ വീട്ടിലേക്ക് പോയി, അമ്മ എല്ലാ ദിവസവും എനിക്ക് വേണ്ടി പാചകം ചെയ്തു.
വാവ്, അത് വളരെ നല്ലതാണ്! നിങ്ങൾക്ക് അത് ചെയ്യാൻ കഴിയുമെന്ന് ഞാൻ പ്രതീക്ഷിക്കുന്നു.
ഞാൻ എന്റെ പഴയ ജോലിസ്ഥലത്തേക്ക് പോയി.
നല്ലൊരു അവധിക്ക് ശേഷം വീണ്ടും ജോലിക്ക് പോകുന്നതിൽ എനിക്ക് സന്തോഷമുണ്ട്.
ഇത് ബുദ്ധിമുട്ടാണെന്ന് എനിക്കറിയാം.
വിവരങ്ങൾ അറിഞ്ഞുകൊണ്ടിരിക്കുന്നത് നല്ലതാണ്.
ഡിസ്‌നിലാൻഡിൽ പോകാൻ കഴിഞ്ഞില്ലെന്ന് ഓർത്ത് എനിക്ക് വല്ലാതെ ദേഷ്യം വരുന്നു.
നിനക്ക് പ്രധാനമായും ചിക്കൻ വിഭവങ്ങളാണോ ഇഷ്ടം?
അവനെ നഷ്ടപ്പെടുമെന്ന ചിന്ത എനിക്ക് ഒട്ടും ഇഷ്ടമല്ല.
റിവേഴ്‌സ് എടുക്കുമ്പോൾ ഒരു കാറിൽ ഇടിച്ചു; മറ്റേ കാറിന്റെ ഉടമയോട് സംസാരിക്കാൻ എനിക്ക് ഏറെ നേരം കാത്തിരിക്കേണ്ടി വന്നു.
നിനക്ക് അവിടെ പോകാൻ താൽപ്പര്യമില്ല.
അവൾ ഗർഭിണിയായിരുന്നു എന്നുപോലും എനിക്ക് അറിയില്ലായിരുന്നു.
എന്റെ അവധിക്കായി ഒരാഴ്ച മുമ്പേ ഞാൻ സാധനങ്ങൾ പാക്ക് ചെയ്ത് കഴിഞ്ഞു.
അവൻ നിനക്ക് വിശ്വസ്തനായ സുഹൃത്തായിരുന്നെന്ന് എനിക്ക് ഉറപ്പാണ്.
ഞാൻ എന്റെ ഭാര്യയെ നിബന്ധനകളില്ലാതെ സ്നേഹിക്കുന്നു; ഒരാൾക്ക് സ്വന്തം ജീവിതപങ്കാളിയെ എങ്ങനെ വഞ്ചിക്കാനാകുമെന്ന് എനിക്ക് മനസ്സിലാകുന്നില്ല.
എന്തായാലും, ഞാൻ അവിടെ ഉണ്ടാകാൻ പാടില്ലായിരുന്നു.
ക്രൂസിൽ പോകാൻ ഞാൻ പേര് രജിസ്റ്റർ ചെയ്തു.
അടുത്ത ആഴ്ച ഞാൻ വിമാനത്തിൽ പോകുകയാണ്, ഇതിന് മുമ്പ് ഒരിക്കലും വിമാനത്തിൽ കയറിയിട്ടില്ല.
എന്റെ ലൈസൻസ് ഏകദേശം 5 വർഷം മുമ്പേ കാലഹരണപ്പെട്ടിരുന്നു, പക്ഷേ എനിക്ക് അത് മനസ്സിലായില്ല.
ഞാൻ ഇപ്പോഴാണ് ചില വലിയ സ്പീക്കറുകൾ സ്ഥാപിച്ചത്, അവ ആരോ എടുത്തുകൊണ്ടുപോയി.
കഴിഞ്ഞ ദിവസം ഹോക്കിക്ക് ശേഷം എന്റെ പൂച്ച ചത്തുപോയെന്ന് അറിഞ്ഞു; ഭയങ്കര വിഷമമായി.
അവൾ പോകുമ്പോൾ അവൾക്ക് സുഖമാണെന്ന് ഉറപ്പാക്കിയത് ഞാനായിരുന്നു എന്നറിഞ്ഞത് എനിക്ക് സന്തോഷമായി.
അതിൽ എനിക്ക് അതിശയവും സന്തോഷവും തോന്നി.
അത് കേൾക്കുന്നത് എപ്പോഴും സന്തോഷകരമാണ്.
ആർക്കെങ്കിലും അങ്ങനെ എങ്ങനെ ചെയ്യാൻ കഴിയും?
അത് വളരെ നല്ലൊരു അനുഭവം പോലെ തോന്നുന്നു.
അവർ എന്റെ കോളേജ് പഠനത്തിന്റെ മുഴുവൻ ചെലവും വഹിച്ചു, അതിന് തിരിച്ച് എന്തെങ്കിലും ചെയ്യണം എന്ന് എനിക്ക് എപ്പോഴും തോന്നിയിരുന്നു.
എന്റെ ഇഷ്ടപ്പെട്ട സോക്കർ ടീം നന്നായി കളിക്കുമെന്ന് എനിക്ക് ഉറപ്പായിരുന്നു.
അത് കേട്ട് വിഷമമായി, പക്ഷേ നീ എന്തുകൊണ്ടാണ് നിന്റെ സുഹൃത്തുക്കളിൽ നിന്ന് അകന്നത്?
സ്കൂളിൽ എന്റെ കൈയിൽ ബാക്ക്പാക്ക് ഇല്ലാതിരുന്ന ഒരു സമയവും എനിക്ക് ഓർമ്മയില്ല.
ഇനി 99 എണ്ണം കൂടി കിട്ടിയാൽ എനിക്ക് മറ്റൊന്ന് വാങ്ങാം.
കഥാപാത്രങ്ങൾ അരോചകമായിരുന്നു, നിറങ്ങളുടെ പാലറ്റ് ഭയങ്കര മോശവും.
എനിക്ക് ചില സാമ്പത്തിക പ്രശ്നങ്ങൾ ഉണ്ടായിരുന്നു.
അവർ നിന്നെ കുടുക്കുകയാണോ അതോ ശരിക്കും നല്ലൊരു ഡീൽ തരുകയാണോ എന്ന് ഒരിക്കലും അറിയില്ല.
എനിക്ക് ആ കാർ വളരെ ഇഷ്ടപ്പെടും.
ഇന്ന് ഞാൻ എന്റെ മകളുടെ ടീച്ചറെ കണ്ടു.
കുറഞ്ഞത് ഡോമിനോസെങ്കിലും നല്ലതാണ്.
കുറച്ച് കടുപ്പമായി തോന്നുന്നു, പക്ഷേ ബിസിനസ് ബിസിനസ് തന്നെയാണ്.
ഇന്ന് എന്റെ ആദ്യത്തെ പുതിയ കാർ വാങ്ങിയതിൽ എനിക്ക് വളരെ സന്തോഷമായി.
വിഷമം തോന്നുന്നു, ഇതിനെക്കുറിച്ച് സംസാരിക്കാൻ നിനക്കൊരാൾ ഉണ്ടാകുമെന്ന് പ്രതീക്ഷിക്കുന്നു.
നീ അവളെ നോക്കിക്കൊള്ളുമോ?
മഴ പെയ്യുകയായിരുന്നു, അതിനാൽ ഞങ്ങൾക്ക് റദ്ദാക്കേണ്ടി വന്നു.
എനിക്ക് അവരെ നേരത്തേ തന്നെ ഇഷ്ടമല്ല.
ഞാൻ അത് ഒരിക്കലും പ്രതീക്ഷിച്ചിരുന്നില്ല.
ഛെ, നീ തന്നെയാണ് എംവിപി.
തീരുമാനിക്കുന്നതിന് മുമ്പ് അവൻ കുറച്ച് വർഷങ്ങൾ ജോലി മാത്രമേ ചെയ്യൂ.
നീ അത് നന്നായി പരിപാലിച്ച് ശരിയായ രീതിയിൽ ഉപയോഗിച്ചാൽ അത് നിനക്കൊപ്പമെന്നേക്കും നിലനിൽക്കും.
ഞാൻ മാത്രമാണ് ഉണ്ടായിരുന്നതെന്ന് ഞാൻ കരുതി.
ഗ്യാങ് കുറ്റകൃത്യങ്ങൾ തടയണം.
അതിന് ദുർഗന്ധമായിരുന്നെന്ന് ഉറപ്പ്.
ജോലിയിൽ നിന്ന് വീട്ടിലെത്തിയപ്പോൾ എന്റെ നായ തറയിൽ വിസർജനം ചെയ്തിരുന്നു.
കൂടുതൽ സ്ഥലം ഉണ്ടാകുന്നത് എപ്പോഴും ഒരു അധിക നേട്ടമാണ്.
ഈ വാരാന്ത്യത്തിൽ ഞങ്ങൾ എന്റെ അമ്മയ്ക്കായി ജന്മദിന പാർട്ടി നടത്തുകയാണ്.
മനുഷ്യർക്ക് എന്തൊക്കെ ചെയ്യാനാകുമെന്നത് അതിശയകരമാണ്.
ഗെറെയ്ന്റ് തോമസ് ജയിച്ചതിൽ എനിക്ക് അതിശയമായി.
നിനക്ക് ഉയരങ്ങളെ ഒട്ടും പേടിയുണ്ടോ?
ഹാലോവീനിനായി എനിക്ക് കാത്തിരിക്കാനാവുന്നില്ല.
ഞാൻ ലിവിഡിയാണ്, എനിക്ക് കോൺടാക്ട് ലെൻസുകളുണ്ട്.
ഉഫ്, നടന്നത് പകർത്തിയിട്ടുണ്ടാകാവുന്ന ഏതെങ്കിലും സുരക്ഷാ ക്യാമറ നിങ്ങളുടെ കൈവശമുണ്ടോ?
എന്റെ സുഹൃത്തും ഞാനും ഉടൻ ഒരു വാട്ടർ പാർക്കിൽ പോകാനിരിക്കുകയാണ്.
ഒരാൾ മറ്റെയാളിനുമുമ്പ് മരിച്ചു, മറ്റെയാൾ അത്രയും വിഷമിച്ചിരുന്നതിനാൽ അവളും പെട്ടെന്ന് പിന്നാലെ പോയി.
അതെ, പക്ഷേ ഞാൻ അവരെ വിശ്വസിച്ചില്ല.
എനിക്ക് ഒരിക്കലും ഗുരുതരമായ അപകടം ഉണ്ടായിട്ടില്ല, അത് നല്ല കാര്യമാണ്.
എന്നെ സംബന്ധിച്ചിടത്തോളം അത് ഏതാണ്ട് ഒരു ദുരന്തമായിരുന്നു.
എന്റെ രഹസ്യം പറഞ്ഞിട്ടില്ലെന്ന് പറഞ്ഞ സുഹൃത്തിനെ വിശ്വസിക്കുക
ഞാൻ വർക്ക്‌ഔട്ട് ചെയ്യാറുണ്ട്, പക്ഷേ അവൻ വേറെ ലെവലിലാണ്
എന്റെ സുഹൃത്ത് വന്ന് എന്റെ പിറന്നാളിന് ഒരു ജോഡി കച്ചേരി ടിക്കറ്റുകൾ കൊണ്ടുവന്നു
എന്റെ സഹോദരന് അസുഖം വന്നപ്പോൾ അവൻ ഇത്ര പെട്ടെന്ന് പോകുമെന്ന് ഞങ്ങൾ ഒരിക്കലും കരുതിയില്ല
മാസങ്ങളോളം പണം സ്വരുക്കൂട്ടിയ ശേഷം ഒടുവിൽ എനിക്ക് ഒരു പുതിയ സ്മാർട്ട്ഫോൺ വാങ്ങാൻ കഴിയുന്നു
അതെ, ഞാൻ പൂർണ്ണമായി തകർന്നുപോയി
വാവ്, നിന്റെ പേടി മറികടക്കാനുള്ള ധൈര്യം കണ്ടെത്തിയത് നന്നായി
എന്റെ സഹോദരി എപ്പോഴും എനിക്ക് പണം തരാനുണ്ട്
അതിനെ കൊല്ലുന്നതിന് മുമ്പ് ഞാൻ നിലവിളിച്ചുകൊണ്ട് ചാടിയെഴുന്നേറ്റു
ഇത് പതിവ് ജീവിതത്തിൽ നിന്നുള്ള ഒരു വലിയ രക്ഷപ്പെടലായിരിക്കും, അല്ലേ
എനിക്ക് നല്ല ജോലിയും നല്ല കാമുകിയും നല്ല സുഹൃത്തുക്കളുമുണ്ട്
ഇത് വളരെ മനോഹരമായൊരു അനുഭവമായിരുന്നു
ഞാൻ ഉറപ്പായും ഒരു പാഠം പഠിച്ചു
ഓഹ് ഇല്ല, അവൾ എന്താണ് ചെയ്യുന്നത്
ഹഹാ, നിന്റെ ഭാര്യ നിന്നെ കളിയാക്കാൻ പേടിക്കുന്നില്ലെങ്കിൽ നിങ്ങളുടെ ബന്ധം കിടിലമാണെന്ന് മനസ്സിലാക്കാം
നീ സുരക്ഷിതമായ ഏതെങ്കിലും സ്ഥലത്താണ് താമസിക്കുന്നതെന്ന് പ്രതീക്ഷിക്കുന്നു
ഞാൻ സ്വന്തമായി താമസിക്കുകയാണ്, അച്ഛൻ എനിക്ക് മൂന്ന് മാസത്തെ വാടക മുൻകൂറായി അടച്ചുതന്നു
ഒരിക്കൽ ആംസ്റ്റർഡാമിൽ ഒരു ആളൊന്ന് എന്നെ കൊള്ളയടിക്കാൻ ശ്രമിച്ചു
അതെ, അത് എന്റെ സുഹൃത്തുക്കളോടൊപ്പം കഴിഞ്ഞ നല്ല പഴയകാലത്തെക്കുറിച്ച് ശരിക്കും ഓർമ്മിപ്പിച്ചു
ഇത് പെട്ടെന്ന് കടന്നുപോകും, നീ ഉടൻ തന്നെ തൂങ്ങിക്കിടക്കുകയും ചെയ്യും, എനിക്ക് ഉറപ്പാണ്
അത് നിന്നെ സങ്കടപ്പെടുത്തുന്നത് എന്തുകൊണ്ടാണ്?
നീ അവളോടൊപ്പം സമയം ചെലവഴിക്കുകയും എല്ലാം ശരിയാകും എന്ന് അവളെ അറിയിക്കുകയും ചെയ്യുന്നുവെന്ന് ഉറപ്പാക്കൂ.
ഞാൻ ഫാൽക്കൺസിന്റെ ആരാധകനാണ്.
എന്റെ ചരിത്ര പരീക്ഷയിൽ ഞാൻ പാസാകുമെന്ന് എനിക്ക് ഉറപ്പായിരുന്നു.
എന്നിട്ടും ഞാൻ വഴുതി വീണു, എല്ലാവരും എന്നെ നോക്കി.
ഇന്ന് ഞാൻ വളരെ സന്തോഷത്തിലായിരുന്നു.
കഴിഞ്ഞ മൂന്ന് വർഷമായി എനിക്ക് ഇതുതന്നെയാണ് സംഭവിക്കുന്നത്.
സത്യത്തിൽ അവർ എന്റെ കൂടെ വരേണ്ടതായിരുന്നു, അല്ലെങ്കിൽ അവരുടെ കൂടെ വരാൻ എന്നെ ക്ഷണിക്കേണ്ടതായിരുന്നു എന്നാണ് എനിക്ക് തോന്നുന്നത്.
നിങ്ങളുടെ ബോസുമാരുമായി ബന്ധപ്പെടാൻ സെമിനാർ ഒരു മികച്ച അവസരമായിരിക്കും.
നീ നിന്റെ വസ്ത്രങ്ങൾ നശിപ്പിച്ചോ?
അവന് കുറച്ച് ഭേദമായി തോന്നണം എന്നേ എനിക്ക് വേണ്ടൂ.
നീ തയ്യാറായിരിക്കുന്നത് വളരെ നല്ല കാര്യമാണ്.
ഓഹ് വാവ്, അതൊരു നല്ല ചുറുചുറുക്കുള്ള നായയാണ്! ആശംസകൾ.
കഴിഞ്ഞ രാത്രി ഒരു പാർട്ടിയിൽ ഞാൻ എന്റെ ദേഹമൊട്ടാകെ ബിയർ ഒഴിച്ചുകളഞ്ഞു.
വാവ്, വളരെ രസകരം! അപ്പോൾ നീ നിന്നെ എങ്ങനെയാണ് കണ്ടത്?
ഞങ്ങൾ ഇപ്പോഴേ ഒരു പുതിയ നായ്ക്കുട്ടിയെ കൊണ്ടുവന്നു—വെള്ളത്തിൽ കളിക്കാൻ അതിന് വലിയ ഇഷ്ടമാണ്.
അത് ഫിറ്റ്നസ് ടെസ്റ്റായിരുന്നോ മറ്റെന്തെങ്കിലും ആയിരുന്നോ?
പോകണം എന്ന് ഞാൻ എപ്പോഴും പറയാറുണ്ട്, പക്ഷേ ഒരിക്കലും പോകാറില്ല.
അത് അത്ഭുതകരമാണ്! ഏത് ടെസ്റ്റായിരുന്നു?
ഞാൻ വല്ലാതെ പേടിച്ച് നിലവിളിക്കാൻ തുടങ്ങി.
സ്കൂൾ സൈക്കോളജിക്കായുള്ള കൗൺസിലർ വിദ്യാഭ്യാസം
വലിയ കാരുണ്യപ്രവൃത്തികൾ ശ്രദ്ധിക്കപ്പെടാതെ പോകില്ല
സുഹൃത്തേ, അത് വളരെ നല്ലൊരു ആഗ്രഹമാണ്
ലോകത്ത് ഇതിലും വളരെ നല്ല ആളുകളുണ്ട്
പഴയ രീതിയിൽ കാര്യങ്ങൾ ചെയ്യുന്നതിന് ചില നല്ല ഗുണങ്ങളുണ്ട്
ഒടുവിൽ അടുത്ത മാസം കുടുംബസംഗമത്തിനായി ബീച്ചിൽ ബുക്കിങ് നടത്തി
അതെ, അത്തരത്തിലുള്ള ഒരു കിടിലൻ തലയണ വേണം; ഞാൻ എന്റേത് എപ്പോഴും മറിച്ചുകൊണ്ടിരിക്കും
എനിക്കും ഇതേ പ്രശ്നമാണ്
നീ അധികം ചെലവാക്കി കടത്തിൽപ്പെട്ടില്ലല്ലോ, അതിൽ എനിക്ക് സന്തോഷമുണ്ട്
അത് ഓടിക്കാൻ നിനക്ക് ആവേശമായിരുന്നോ
അവരുടെ അച്ഛനും ഞാനും കാര്യങ്ങൾ എങ്ങനെ ചെയ്യണമെന്ന് അവൾ എന്റെ പെൺമക്കളോട് നിരന്തരം പറയുന്നു
ഒടുവിൽ അവന് പ്രമോഷൻ കിട്ടി
ഏറ്റവും നല്ല സംഗീതവും സ്നാക്കുകളും ടെലിവിഷൻ ഷോയും ഇതാണ്
ഞാൻ വലിയ കടുത്ത റിപ്പബ്ലിക്കനല്ല, നിങ്ങളോട് യോജിക്കുന്നു
എന്റെ മുത്തച്ഛന്റെ വാച്ച് എനിക്ക് പാരമ്പര്യമായി ലഭിച്ചു
എന്തായാലും നായകൾക്ക് വലിയ ശബ്ദങ്ങൾ ഇഷ്ടമല്ല
ഇത് എളുപ്പമുള്ള കാര്യമല്ല, പക്ഷേ നമുക്ക് ശ്രമിക്കാം
അത് വളരെ നല്ലതാണ്, അവന് നല്ലതായി
ഞാൻ എന്റെ ജോലി ആഴ്ച ആരംഭിക്കുകയാണ്
ഞാൻ അടുത്തിടെ ജോലി വിട്ടു; ചേരാൻ പുതിയൊരു സ്ഥാനമൊന്നുമില്ല
എന്റെ കഥ ഒരു പുരസ്കാരത്തിന് നാമനിർദ്ദേശം ചെയ്യപ്പെട്ടിരുന്നു.
ശരി ശരി, മിസിസിപ്പി സന്ദർശിക്കാൻ ഏത് സമയമാണ് ഏറ്റവും നല്ലതെന്ന് നിനക്കു തോന്നുന്നു?
നീ ഏത് സ്ഥാനത്തേക്കാണ് ഇന്റർവ്യൂ കൊടുക്കുന്നത്?
അവൻ നല്ല കുട്ടിയാണ്, അവന്റെ ഭാവി വളരെ തിളക്കമുള്ളതാണ്.
കാലാവസ്ഥ മനോഹരമായിരിക്കുമെന്ന് തോന്നുന്നു.
അവർ അവിടെ താമസം മാറിയാൽ നിന്നെ ശല്യപ്പെടുത്തുന്നത് നിർത്തുമെന്ന് പ്രതീക്ഷിക്കുന്നു.
നീ എപ്പോഴെങ്കിലും ടിവിയിൽ റേസിംഗ് കാണാറുണ്ടോ?
പ്രസംഗം നടത്തേണ്ട സമയം വന്നപ്പോൾ ഞാൻ തകർത്തു ചെയ്തു.
എന്റെ മകൾ ജനിച്ചപ്പോൾ എനിക്ക് ഉറങ്ങാനേ തോന്നിയില്ല.
നീ സ്കൂളിനോട് നല്ല പ്രതിബദ്ധതയുള്ളവനാണെന്ന് തോന്നുന്നു, അത് വളരെ നല്ലതാണ്.
ഒരു സുഹൃത്ത് എന്നെ ബാറിൽ പോയി എന്റെ പങ്കാളിയുടെ അറിയാതെ സമയം ചെലവഴിക്കാൻ പ്രേരിപ്പിക്കാൻ ശ്രമിച്ചു.
അത് വളരെ നന്നായിരിക്കും.
മറ്റു ഡ്രൈവർമാരെയാണ് നീ ശ്രദ്ധിക്കേണ്ടത്.
കെയർഗിവർ എന്താണ് ചെയ്യുന്നത്?
ഒരു കൊതുക് ദിവസം മുഴുവൻ എന്റെ മുഖത്തിന് ചുറ്റും പറക്കുകയാണ്, ഇപ്പോൾ അത് ശരിക്കും എന്നെ ശല്യപ്പെടുത്താൻ തുടങ്ങി.
ഇല്ല, ആരെങ്കിലും അങ്ങനെ ചെയ്യുന്നത് എന്തുകൊണ്ടാണെന്ന് ചിന്തിച്ച് ഞാൻ വെറുതെ വിഷമിച്ചും ആശയക്കുഴപ്പത്തിലുമായിരുന്നു.
എന്റെ നായയെ രണ്ടു ദിവസമായി കാണാതായിരുന്നു.
അതിനെ വളരെ വലുതെന്ന് ഞാൻ പറയില്ല.
അത് വളരെ നാണക്കേടായേനേ.
ഇന്നലെ ഞാൻ മിഠായി കടയിൽ നിന്ന് മിഠായി മോഷ്ടിച്ചു.
അത് അടിപൊളിയാണ്, പക്ഷേ നീ ചെയ്യുമോ
എനിക്ക് ഇപ്പോഴും ജോലി ഉണ്ട്, എല്ലാം അത്രയും നന്നായി പോകുന്നു എന്നത് മാത്രം
ഒരുപക്ഷേ ആഴ്ചയിൽ കുറച്ച് മണിക്കൂറേക്ക് ആരെയെങ്കിലും ജോലിക്ക് വെച്ച് ജിമ്മിലോ യോഗ ക്ലാസിലോ ചേരാം
നീ എന്തിന്റെ മുകളിലായിരുന്നു നിൽക്കുന്നത്
ബെറൻസ്റ്റീൻ ബെയേഴ്‌സുള്ളത്, എനിക്ക് അത് ഭ്രാന്താണെന്ന് തോന്നുന്നു
ഓ, അത് അത്ഭുതകരമാണ്, അത് നിനക്ക് വളരെ പ്രധാനമാണെന്ന് എനിക്കറിയാം
അതെ, ആദ്യം അത് എന്നെ ഞെട്ടിച്ചു
ഞങ്ങൾ ഹവായിയിൽ താമസിച്ചിരുന്നു
എന്റെ യൂണിവേഴ്സിറ്റി കഴിഞ്ഞു
കഴിഞ്ഞ ദിവസം സുഹൃത്തിനൊപ്പം ‘ദി നൈറ്റ്‌മേയർ ബിഫോർ ക്രിസ്മസ്’ കണ്ടു, അത് എന്റെ ബാല്യകാലം ഓർമ്മിപ്പിച്ചു
അസുഖമുള്ള കുട്ടികൾക്കായി സമ്മാനങ്ങൾ കൊണ്ടുപോകാൻ ഞാൻ കുട്ടികളുടെ ആശുപത്രിയിൽ പോയി
പ്രധാനമായും സാമ്പത്തിക കാര്യങ്ങൾ, കഷ്ടപ്പെട്ട് പണം ലാഭിച്ചുകൊണ്ട്
ഒരു ചെറിയ അവധിക്കായി ഞാൻ നാളെ നഗരം വിടുകയാണ്
ഓ മൈ ഗോഡ്, അത് അത്ഭുതകരമാണ്
ഈ പുതിയ ഡയറ്റിൽ സലാഡും സാൻഡ്‌വിച്ചും കഴിക്കുന്നതിൽ എനിക്ക് പ്രശ്നമില്ല
കാർ ഒരുപക്ഷേ മണിക്കൂറിൽ 40 മൈൽ വേഗത്തിൽ പോകുകയായിരുന്നു
പുതിയത് കൂടുതൽ പണം തരുന്നുണ്ടോ
അവൾക്ക് കുഴപ്പമൊന്നുമില്ലായിരുന്നോ, അതോ കരഞ്ഞോ
കഴിഞ്ഞ രാത്രി എനിക്ക് ഏകദേശം 3 മണിക്കൂർ മാത്രമാണ് ഉറങ്ങാനായത്
ചില സ്ത്രീകൾ വിശ്വസ്തരല്ല
ഞാൻ എപ്പോഴും എന്റെ ഭാര്യയോടൊപ്പം വിവാഹിതനായിരിക്കും
ഞാൻ ഗ്രാജുവേറ്റ് ചെയ്യാൻ എല്ലാം തയ്യാറായിരുന്നു, പക്ഷേ ഇപ്പോൾ അത് വീണ്ടും ചെയ്യണം
നിനക്കറിയാമോ, ഇത് ഇനിയും മെച്ചപ്പെടുത്താൻ കഴിയുന്ന ഒരു കാര്യമുണ്ട്
നിനക്ക് ഇതിനേക്കാൾ വളരെ മോശമായ കാര്യങ്ങൾ ചെയ്യാം
അതെ, ഞാൻ അവൾക്കായി ഐപാഡ് വാങ്ങി
ഇതിനായി നിന്നെ അറസ്റ്റ് ചെയ്യണം
വളരെ നല്ലത്, പക്ഷേ ഇതിനെക്കുറിച്ച് എനിക്ക് വളരെ മോശം തോന്നുന്നു ഹാഹാ
ബർഗറും ഫ്രൈസും മാത്രം കഴിച്ച് ജീവിക്കാനാവില്ല
ജീവിതത്തിൽ ഞാൻ കഷ്ടപ്പെടുമ്പോൾ അവൻ എനിക്കായി കൂടെയുണ്ടായിരുന്നു
നീ നിന്റെ ലക്ഷ്യത്തോട് എത്ര അടുത്താണ്
അതിൽ ഒട്ടും തെറ്റില്ല
അടുത്ത 2 ആഴ്ചയ്ക്കുള്ളിൽ ഏതെങ്കിലും സമയത്ത്; ഞങ്ങൾ ഇപ്പോഴും കൃത്യമായ തീയതി തീരുമാനിക്കാൻ ശ്രമിക്കുകയാണ്
അവന്റെ തീരുമാനത്തിൽ ഞാൻ മടുത്തു
എന്റെ അമ്മ പെട്ടെന്ന് മരിച്ചപ്പോൾ എനിക്ക് ശരിക്കും ഏറെ വേദനിച്ചു
കഴിഞ്ഞ വർഷം ഞാൻ കോളേജിൽ നിന്ന് ഗ്രാജുവേറ്റ് ചെയ്തു, അത് ഒരു വിചിത്രമായ അനുഭവമായിരുന്നു
എനിക്ക് അവന്റെ അടുത്ത് ഇരിക്കാൻ ആഗ്രഹമുള്ളതുപോലെ തന്നെ, അവനും എന്നോടൊപ്പം ഇരിക്കാൻ ആഗ്രഹിച്ച് എപ്പോഴും എന്റെ പിന്നാലെ നടക്കുന്നു
ഞാൻ കുട്ടിക്കാലത്തെ ഒരു പഴയ ആൽബം മറിച്ചുനോക്കുകയായിരുന്നു, പലതരം വികാരങ്ങൾ തോന്നിത്തുടങ്ങി
എനിക്ക് ഹൊറർ സിനിമകൾ ഒട്ടും ഇഷ്ടമല്ല
ഇന്നലെ രാത്രി ഒറ്റയ്ക്ക് വീട്ടിലേക്ക് നടക്കുമ്പോൾ എനിക്ക് പേടിയായി
ആഹ്, പഴയ ഓർമ്മകളിലൂടെ പോകുമ്പോൾ വളരെ നൊസ്റ്റാൾജിക് ആയി തോന്നിയിരിക്കണം.
ഒരുപക്ഷേ നിങ്ങൾക്ക് എഎ മീറ്റിംഗുകൾ പരീക്ഷിക്കാം, അല്ലെങ്കിൽ നിങ്ങളുടെ ഭാര്യയോട് അൽ-അനോൺ മീറ്റിംഗുകളിൽ പോകാമെന്ന് നിർദേശിക്കാം.
എങ്കിലും യാത്രയ്ക്കായി ഞാൻ പകുതി പണം മാത്രമേ നൽകിയുള്ളൂ.
നിങ്ങൾക്ക് വിഷമം തോന്നുന്നു എന്നതിൽ എനിക്ക് സങ്കടമുണ്ട്.
എന്റെ ജോലിയുടെ അവസാന ദിവസത്തിനായി ഞാൻ തയ്യാറാണ്.
ശനിയാഴ്ചയ്ക്കായി കാത്തിരിക്കാനാവുന്നില്ല.
അവന് തന്റെ കൊച്ചുമക്കളെ വളരെ ഇഷ്ടമായിരിക്കണം.
എനിക്ക് ഒരു ബങ്കറുണ്ട്, അതിൽ ധാരാളം ഭക്ഷണവും ആവശ്യമായ സാധനങ്ങളും ശേഖരിച്ച് വെച്ചിട്ടുണ്ട്.
വർഷങ്ങളോളം ഭാരം കുറയ്ക്കാൻ ശ്രമിച്ച ശേഷം ഒടുവിൽ ലക്ഷ്യമിട്ട ഭാരത്തിലെത്തി.
അവൾ എന്തെങ്കിലും അസാധാരണമായി ചെയ്തോ?
വിലപിടിപ്പുള്ള ഒന്നും മോഷണം പോയിട്ടില്ലെന്ന് ഞാൻ ശരിക്കും പ്രതീക്ഷിക്കുന്നു.
വാവ്, തെറ്റായി എടുക്കരുത്, നിങ്ങൾ വളരെ ചിട്ടയുള്ള ആളായി തോന്നുന്നു.
അടുത്ത സീസണാണ് അവസാനത്തേത്.
അത് ജീവിതത്തിൽ ഒരിക്കൽ മാത്രം ലഭിക്കുന്ന അനുഭവമായിരുന്നു.
ഇത് ഇനി വീണ്ടും സംഭവിക്കില്ല.
അത് തീർച്ചയായും വളരെ ശക്തമായൊരു വികാരമായിരിക്കണം.
ചിലപ്പോൾ കോളേജിൽ പോകേണ്ടെന്ന് തീരുമാനിച്ചിരുന്നെങ്കിൽ എന്റെ ജീവിതം എങ്ങനെയായിരുന്നേനെ എന്ന് ഞാൻ ചിന്തിക്കാറുണ്ട്.
ഇതിനെക്കുറിച്ച് എനിക്ക് വളരെ ലജ്ജ തോന്നുന്നു.
അതെ, അത് എപ്പോഴും നല്ല കാര്യമാണ്.
ഭക്ഷണത്തിനായി കാത്തിരിക്കുകയാണ്.
ഞാൻ രാഷ്ട്രീയത്തിൽ ഒട്ടും താൽപ്പര്യമില്ലാത്ത ആളാണ്.
അവൾ അതിന്റെ പേരിൽ വലിയ ബഹളം ഉണ്ടാക്കാതിരുന്നത് അടിപൊളിയായി.
തീർച്ചയായും ചൈനീസ് തന്നെയാണ്, പക്ഷേ അവർക്കു കുറച്ച് അമേരിക്കൻ വിഭവങ്ങളും ഉണ്ട്.
എനിക്ക് വേണ്ടതെല്ലാം നടന്ന് പോകാവുന്ന ദൂരത്താണ്, അതുകൊണ്ട് എന്തായാലും പ്രശ്നമില്ല.
എന്റെ വീടിന് ചുറ്റും ഇങ്ങനെ കീടങ്ങൾ അഴിഞ്ഞാടുന്നത് എനിക്ക് സഹിക്കാനാവില്ല.
നിനക്ക് തീർച്ചയായും ഒറ്റപ്പെട്ടതായി തോന്നിയിരിക്കണം.
അവർ ഒരു ഫോൺ വിളിയുടെ അകലത്തിൽ മാത്രമേ ഉണ്ടായിരുന്നുള്ളൂ, ഞാൻ അധികം ദൂരെയൊന്നും പോയില്ല.
തിങ്കളാഴ്ചയെക്കുറിച്ച് എനിക്ക് ടെൻഷനാണ്.
ഇത് 7 മണിക്കൂർ ഡ്രൈവാണ്.
ഒരു നല്ല സെറ്റിന് 15 മുതൽ ഏകദേശം 30 വരെ വരാം.
ഓ, അതെന്നെ അത്ഭുതപ്പെടുത്തിയില്ല.
പുതിയ സ്ഥലം നിനക്ക് ഇഷ്ടപ്പെടുന്നുണ്ടോ?
ഞാൻ സംസാരിക്കുമ്പോൾ എന്റെ സുഹൃത്ത് എപ്പോഴും ഇടയിൽ കയറി തടസ്സപ്പെടുത്തും.
ആ അലമാരകൾ ഏതാണ്ട് കാലിയായിരുന്നു.
എന്റെ അമ്മാവൻ കഴിഞ്ഞ വർഷം മരിച്ചു.
അവൾ ഭയങ്കര ഉച്ചത്തിലാണ് സംസാരിക്കുന്നത്, അവിടെ എപ്പോഴും പോലീസ് ഉണ്ടാകും.
നിന്റെ ഇൻഷുറൻസ് ഇത് കവർ ചെയ്യുമോ?
എന്റെ റൂംമേറ്റ് താൻ ഉപയോഗിച്ചതിന് ശേഷം വൃത്തിയാക്കാതിരിക്കുമ്പോൾ എനിക്ക് അസഹ്യമായി തോന്നും.
ടെസ്റ്റിൽ തോറ്റാൽ ഞാൻ ആകെ തകർന്നുപോകും.
പക്ഷേ അവരുടെ കുഞ്ഞുമുഖങ്ങൾക്കായി ഇതെല്ലാം ചെയ്യുന്നത് തീർച്ചയായും വിലമതിക്കുന്നതാണ്.
എന്താണ് സംഭവിക്കാൻ പോകുന്നതെന്ന് എനിക്ക് ഉറപ്പില്ല.
അപ്പോൾ നിനക്ക് ഒന്നും ചെയ്യാനില്ല.
എന്റെ സഹപ്രവർത്തകരിൽ ഒരാൾ എപ്പോഴും ജോലിയുമായി ബന്ധമില്ലാത്ത കാര്യങ്ങളെക്കുറിച്ച് എന്നോട് സംസാരിച്ചുകൊണ്ടിരിക്കും.
ശരി, ഒരുപക്ഷേ നീ അവരുടെ അടുത്തേക്ക് മാറിനിൽക്കണം.
എന്റെ സുഹൃത്ത് വരണമെന്ന് ഞാൻ ആഗ്രഹിച്ചിരുന്നെങ്കിൽ ഞാൻ അങ്ങനെ ചെയ്യുമായിരുന്നു.
എന്റെ പുതിയ പ്രോജക്റ്റ് തുടങ്ങാൻ ഞാൻ ആവേശത്തിലാണ്.
പ്രത്യേകിച്ച് ആ ഉച്ചത്തിലുള്ള ശല്യപ്പെടുത്തുന്ന സെമി-ട്രക്ക് ഹോണുകൾ.
അവനെ നടക്കാൻ പുറത്തേക്ക് കൊണ്ടുപോകുന്നത് എനിക്ക് വളരെ ഇഷ്ടമാണ്.
ഈ വർഷത്തെ ഏറ്റവും മികച്ചത് വരാനിരിക്കുകയായിരുന്നു.
എങ്കിലും, ഇനി നിനക്ക് അതിനെ പേടിയില്ലെന്നതിൽ എനിക്ക് സന്തോഷമുണ്ട്.
അത് വളരെ വ്യത്യസ്തമായിരിക്കും.
ചേ, അതൊരു വ്യാജ കോൾ ആയിരുന്നോ എന്തോ?
ഓ വേണ്ട, ഇപ്പോൾ അവൾക്ക് എങ്ങനെയുണ്ട്?
ഇത് ഒരു വഞ്ചകനിൽ നിന്നാണ് വരുന്നതെന്ന് നീ പറയുന്നതാണോ?
എന്റെ കരിയറിലുടനീളം, ഒരു അമ്മ എന്ന നിലയിലും, അവൾ എന്നെ വളരെയധികം പിന്തുണച്ചിട്ടുണ്ട്.
പൊതുവെ പറഞ്ഞാൽ, ആളുകൾ പരസ്പരം ഒത്തുപോകണം.
എന്റെ ബാല്യകാല നായയെ എനിക്ക് ഒരുപാട് മിസ് ചെയ്യുന്നു.
എനിക്ക് ആകെ പേടിയും അസ്വസ്ഥതയും തോന്നുന്നു.
എന്റെ മകൻ അടുത്തിടെ മൂന്നാം ക്ലാസിലെ LEAP പരീക്ഷയിൽ എല്ലാ വിഷയങ്ങളിലും അഡ്വാൻസ്ഡ് സ്കോർ നേടി.
അതെ, അല്ലെങ്കിൽ അടുത്ത തവണ അവൾ അത്താഴം ഉണ്ടാക്കുമ്പോൾ അവിടെ ഉണ്ടായിട്ട് അവൾക്ക് ചില ടിപ്പുകൾ കൊടുക്കൂ—പച്ച ചിക്കൻ കഴിക്കുന്നത് വളരെ മോശമാണ്.
ഞാനും എന്റെ മൂന്ന് കുട്ടികളും
ഞാൻ നാണംകുണുങ്ങിയാണ്, അതിനാൽ അവരോട് വിനയമായി നിർത്താൻ എങ്ങനെ പറയണമെന്ന് എനിക്ക് മനസ്സിലായില്ല
ഓർമ്മയ്ക്കായി സൂക്ഷിക്കാൻ ഇനിയും കുറച്ച് സാധനങ്ങളുണ്ട്
അതെ, കുറഞ്ഞത് മാതാപിതാക്കളെന്ന നിലയിൽ നമ്മൾ എന്തോ ശരിയായി ചെയ്തുവെന്ന് ഇത് എന്നെ ചിന്തിപ്പിക്കുന്നു
സാധനങ്ങൾ കളയുന്നത് ഇത്ര ബുദ്ധിമുട്ടാണോ
എനിക്ക് ഗ്യാസ് പോയി, അതിന് ഭയങ്കര ദുർഗന്ധമായിരുന്നു
കാരണം അവൻ പെൺകുട്ടികളോട് സംസാരിച്ചിരുന്നുവെന്ന് പോലും എനിക്ക് അറിയില്ലായിരുന്നു
എനിക്ക് ശമ്പളവർധന ലഭിക്കുമെന്ന് കരുതി ഇന്ന് ഞാൻ എന്റെ ബോസിനെ കണ്ടു
നഗരത്തിലെ സംശയകരമായ ഒരു പ്രദേശത്തിലൂടെ നടക്കുമ്പോൾ എനിക്ക് പേടി തോന്നി
എനിക്ക് എപ്പോഴും വേണമെന്നുണ്ടായിരുന്ന എന്റെ പ്രിയപ്പെട്ട ബാൻഡിന്റെ ടി-ഷർട്ട് ഞാൻ ഓർഡർ ചെയ്തു
കുട്ടിയായിരിക്കുക വളരെ എളുപ്പമായിരുന്നു
എന്റെ കാമുകിയുടെ മാതാപിതാക്കളോടൊപ്പം അത്താഴം കഴിക്കുമ്പോൾ ഞാൻ അബദ്ധത്തിൽ വിലകൂടിയ വൈൻ ഗ്ലാസ് താഴെയിട്ടു
എനിക്ക് അത് ഇഷ്ടമല്ല
അവ ഒരുപാട് ഓർമ്മകൾ തിരികെ കൊണ്ടുവരുന്നു
പഠിക്കാനായി ഞാൻ തനിച്ച് ഇപ്പോഴാണ് സ്പെയിനിലേക്ക് മാറിയത്
ഇന്ന് ബാങ്കിന്റെ പിഴവ് തിരുത്താൻ മതിയായ പണം എന്റെ കൈവശമുണ്ടായിരുന്നതിൽ എനിക്ക് വളരെ സന്തോഷമുണ്ട്
ഞാൻ ഇപ്പോഴാണ് സംശയാസ്പദമായ കുറച്ച് ഭക്ഷണം കഴിച്ചത്
എന്റെ എല്ലാ കടങ്ങളും ഞാൻ അടച്ചുതീർത്തു
റോഡിലേക്ക് ഇറങ്ങാൻ എനിക്ക് ഇനി കാത്തിരിക്കാനാവില്ല
കുടുംബമാണ് ഏറ്റവും പ്രധാനപ്പെട്ടത്
അവൾക്ക് മറ്റ് മത്സരങ്ങളിൽ ജയിക്കാനായി ഇപ്പോൾ ഞാൻ അവളെ കൂടുതൽ പരിശീലിക്കാൻ സഹായിക്കും.
ഇന്നലെ ഞാൻ എന്റെ കാറിന് കേടുപാടുകൾ വരുത്തി.
നിന്റെ സഹോദരനും അങ്ങനെ തന്നെയാണോ തോന്നുന്നത്?
എനിക്കും അങ്ങനെ തന്നെയാണ് തോന്നുന്നത്. മൂന്ന് വർഷത്തിനിടെ ഞാൻ രണ്ടുതവണ പരാതി പറഞ്ഞിട്ടുണ്ട്, ബാക്കിയുള്ള എല്ലാവർക്കും വേണ്ടി ജോലി ചെയ്തിട്ടുമുണ്ട്.
നിങ്ങളെ സന്തോഷിപ്പിക്കുന്നതുതന്നെ നിങ്ങൾ ശരിക്കും ചെയ്യണം, കാരണം ജീവിതം വളരെ ചെറുതാണ്.
യാഥാർത്ഥ്യത്തിൽ ആരും പൂർണ്ണരല്ലാത്തപ്പോൾ ഒരാളെ പൂർണ്ണനായി കാണിക്കാൻ ശ്രമിക്കുന്നത് നല്ലതായി തോന്നില്ല.
അവൻ സ്വന്തം സമയമെടുത്തുകൊണ്ടിരിക്കുമ്പോൾ ഞങ്ങൾ എല്ലാവരും ഇത്രയും നേരമായി അവനുവേണ്ടി കാത്തിരിക്കുകയാണ്.
അതെ, ഇന്നത്തെ കാലത്ത് കുട്ടികൾ വളരെ പെട്ടെന്ന് വളരുന്നു.
വാവ്, അത് ശരിക്കും അതിരുകടന്നതാണ്.
അവൻ അതിൽ വളരെ നന്നായിരുന്നു.
എനിക്ക് വീണ്ടും ഭയങ്കരമായവ വന്നിരിക്കുന്നു.
ഞാൻ എന്റെ മുത്തച്ഛന്റെ ഒരു ഫോട്ടോ എന്റെ വാലറ്റിൽ സൂക്ഷിക്കുന്നു.
ഇന്ന് കുറച്ച് സമയം വിശ്രമിക്കാൻ കഴിഞ്ഞതിൽ ഞാൻ നന്ദിയുള്ളവനാണ്.
ഒരുപക്ഷേ ഒരു ദിവസം ഞാൻ ശ്രമിക്കും.
ഇത് എനിക്ക് എന്റെ മാതാപിതാക്കളെ മിസ് ചെയ്യിക്കുന്നു.
അത് വെറുമൊരു നല്ല സർപ്രൈസ് ആയിരുന്നു.
അവൾ മനസ്സിലാക്കുന്നവളും ക്ഷമിക്കുന്നവളുമായിരുന്നോ?
അത് വളരെ അധികം മഷ് ആയി പോകും.
അവിടെ പോകുന്നതിന് മുമ്പ് നിനക്ക് ആ റെസ്റ്റോറന്റിനെ അറിയാമായിരുന്നോ?
ഞാൻ മുമ്പും അവരെ മിസ് ചെയ്തിട്ടുണ്ട്, അങ്ങനെ സംഭവിക്കുമ്പോൾ എനിക്ക് ഒട്ടും ഇഷ്ടമല്ല.
ഞങ്ങൾ തമ്മിൽ വളരെ അടുത്തവരായിരുന്നു, പക്ഷേ വർഷത്തിൽ രണ്ടുതവണയിൽ കൂടുതൽ പരസ്പരം കാണാൻ കഴിഞ്ഞിരുന്നില്ല.
ഞാൻ ഒരു പെൺകുട്ടിയെ കണ്ടുമുട്ടി, ഞങ്ങൾ തമ്മിൽ പെട്ടെന്ന് നല്ല കൂട്ടായി.
എന്റെ നായ ചത്തുപോയി, ഇനി എനിക്ക് സുഹൃത്തുക്കളാരുമില്ലെന്ന പോലെ തോന്നുന്നു.
ഞങ്ങളുടെ മകളുടെ ഡാൻസ് പ്രോഗ്രാമിൽ നിന്ന് പുതിയ ട്യൂഷൻ ഫീസ് നോട്ടീസുകൾ അയച്ചിട്ടുണ്ട്.
അന്ന് രാവിലെ ഞാൻ തീർച്ചയായും വളരെ ശ്രദ്ധതിരിച്ച നിലയിലായിരുന്നിരിക്കണം.
ഞാൻ കൈകൾ കൂട്ടിപ്പിടിച്ച് കണ്ണുകളടച്ച് പിന്നിലേക്ക് വീണു.
അവർ അതേ പാട്ട് തന്നെയാണെങ്കിൽ ഇടാൻ പോകുന്നത്, പിന്നെ റേഡിയോ കേൾക്കുന്നതിന് എന്ത് കാര്യം?
ഇത് തീർച്ചയായും പാപവും ഭക്ഷണം പാഴാക്കലുമാണ്.
നിനക്കും? എനിക്ക് എന്റെ സഹോദരനെ ഇഷ്ടമാണ്.
ഇത് നടക്കുമോ പോലും എന്ന് എനിക്ക് ഉറപ്പില്ല.
അപ്പോൾ പ്ലാൻ ബി എന്തായിരുന്നു?
അയ്യോ പാവം! എന്തായാലും അവൻ തന്റെ വീടിനടുത്തായിരുന്നെന്ന് എനിക്ക് ഉറപ്പുണ്ട്.
എന്റെ പൂച്ചയെക്കുറിച്ച് എനിക്ക് ആശങ്കയുണ്ട്.
ക്ലാസുകളും വളരെ മികച്ചതാണ്.
ഇക്കാലത്ത് എല്ലാം നടക്കുന്നത് നോക്കുമ്പോൾ, ഒറ്റയടിക്ക് ഓട്ടപ്പാച്ചിൽ മാത്രമാണെന്ന് തോന്നുന്നു.
ഒരിക്കൽ ഒരാൾ താൻ ഒരു സെലിബ്രിറ്റിയാണെന്ന് എന്നോട് പറഞ്ഞു, ഞാനത് വിശ്വസിച്ചു.
അതെ, ഏറെക്കാലത്തിന് ശേഷം ഞാൻ അത് ജയിച്ചു.
ഈ ശരത്കാലത്ത് എന്റെ ആദ്യത്തെ കൊച്ചുമകൻ അല്ലെങ്കിൽ കൊച്ചുമകൾ ജനിക്കും, ഞാൻ മുത്തശ്ശിയാകാൻ ആകാംക്ഷയോടെ കാത്തിരിക്കുകയാണ്.
എന്നെ വിവാഹം കഴിക്കാമോ എന്ന് ഞാൻ എന്റെ കാമുകിയോട് ചോദിച്ചു.
ഇത് ഒരു ചൈസ് ലോഞ്ച് പോലെയാണ്, എന്റെ ലിവിംഗ് റൂമിൽ ഇത് വളരെ മനോഹരമായി കാണുമെന്ന് എനിക്ക് തോന്നുന്നു.
ചിലർ ആശങ്കപ്പെട്ടിരിക്കാം, പക്ഷേ ഞാൻ ശരിക്കും ആശങ്കപ്പെട്ടിരുന്നില്ല.
അവർ പിരിച്ചുവിടാൻ പോകുന്ന സ്ഥാനാർഥി ഞാൻ തന്നെയാകുമോ എന്നോർത്ത് എനിക്ക് വളരെ ആശങ്കയുണ്ട്.
നിന്റെ വീട്ടിൽ ഒരു വളർത്തു ആർമ്മഡില്ലോ ഉണ്ട്.
അവൾ മുമ്പൊരിക്കലും അങ്ങനെയായിരുന്നില്ല.
ഓ, ഞാനും അത് ചെയ്തിട്ടുണ്ട്; അങ്ങനെ സംഭവിക്കുമ്പോൾ എനിക്ക് ഒട്ടും ഇഷ്ടമല്ല.
ഹാഹാ, അതെ, അല്ലെങ്കിൽ ഇത്രയും കഠിനമായി ജോലി ചെയ്തതിന് ശേഷം ഒന്ന് റിലാക്സ് ചെയ്യാൻ നല്ലൊരു റെസ്റ്റോറന്റിൽ പോകൂ.
ചിലപ്പോൾ നമുക്ക് അവ ആവശ്യമുള്ള സമയത്തുതന്നെ അവ സംഭവിക്കും.
അപ്പോൾ ഇന്നലെ ഉച്ചയോടെ ഞാൻ പതിവുപോലെ ജോഗിംഗ് ചെയ്യുകയായിരുന്നു.
കിട്ടിയ ഒഴിവുസമയം കൊണ്ട് രസകരമോ ഉപകാരപ്രദമോ ആയ എന്തെങ്കിലും ചെയ്യാൻ കഴിഞ്ഞോ?
ഞാൻ അതിനായി ആകാംക്ഷയോടെ കാത്തിരിക്കുകയാണ്.
അവൻ എത്ര നേരം പഠിച്ചു?
ഞാൻ കടയിലിരിക്കുമ്പോൾ നനഞ്ഞ നിലത്ത് വഴുതി വീണു.
എന്റെ ജീവിതത്തിൽ ചില വളരെ മോശം ബന്ധങ്ങൾ ഉണ്ടായിട്ടുണ്ട്, അതുകൊണ്ടാണ് അവൻ എന്റെ കൂടെയുണ്ടെന്നത് എന്നെ ഇത്ര സന്തോഷിപ്പിക്കുന്നത്.
സ്വയം ഒന്ന് ട്രീറ്റ് ചെയ്യാൻ ഏറ്റവും നല്ല സമയം ഏതാണ് എങ്കിൽ അത് തീർച്ചയായും നിന്റെ ജന്മദിനമാണ്.
എന്റെ അഭിപ്രായത്തിൽ ഡ്രൈവിംഗ് പ്രായം 21 ആക്കണം.
ഇന്ന് എനിക്ക് ചില മോശം വാർത്തകൾ കിട്ടി.
പ്രതീക്ഷ കൈവിടാതിരിക്കുകയാണ് നിനക്ക് ചെയ്യാനാകുന്ന ഏറ്റവും നല്ല കാര്യം.
ഞങ്ങൾ ഒരു തൊഴുത്തിലെ പൂച്ചയെ വാങ്ങി, അത് ഭയങ്കര ശല്യമാണ്.
ആരെങ്കിലും മുന്നോട്ട് വന്ന് ഇതിനെക്കുറിച്ച് തുറന്നു സംസാരിച്ചതിൽ എനിക്ക് സന്തോഷമുണ്ട്.
നിങ്ങൾ പോലീസിനെ ബന്ധപ്പെട്ടിരുന്നോ?
നിങ്ങൾ പോകുമെന്ന് കരുതുന്നുണ്ടോ?
ഭാഗ്യവശാൽ ആർക്കും പരിക്കേറ്റില്ല.
എനിക്ക് പോകാൻ കഴിഞ്ഞിരുന്നെങ്കിൽ എന്ന് ആഗ്രഹിക്കുന്നു.
ഇന്ന് ഞാൻ ഒരു ഡോക്ടറെ കണ്ടു.
പഠിക്കാൻ ആഗ്രഹിക്കുന്നുവെങ്കിൽ ലളിതമായതിൽ നിന്ന് തുടങ്ങൂ.
അവളുടെ കൈയിൽ ശരിക്കും ഒന്നുമില്ല.
പട്ടണത്തിന് പുറത്തുകടന്നതോടെ അത് ശരിക്കും എളുപ്പമായി.
നീ നിന്റെ പങ്കാളിയെ വഞ്ചിച്ചെന്നോ ഗുരുതരമായ എന്തെങ്കിലും ചെയ്തെന്നോ അല്ലല്ലോ.
ഇത് എനിക്ക് കിട്ടുമെന്ന് എനിക്ക് ശരിക്കും പ്രതീക്ഷയും വിശ്വാസവുമുണ്ട്.
സോറി, ഞാൻ വെറുതെ തമാശ പറയുകയായിരുന്നു. എനിക്ക് അസുഖമില്ലാതിരുന്നിട്ടും ഞാൻ ജോലിസ്ഥലത്തേക്ക് വിളിച്ച് അറിയിച്ചിരുന്നു.
അത് ശരിയാണ്, പക്ഷേ അത് നിങ്ങളുടെ ഭക്ഷണം എടുത്തിട്ടില്ലെന്ന് പ്രതീക്ഷിക്കുന്നു.
പുതിയ കാര്യങ്ങളെക്കുറിച്ച് എനിക്കും ഉത്കണ്ഠ തോന്നും.
കുറ്റബോധത്തേക്കാൾ എനിക്ക് നാണക്കേടാണ് കൂടുതൽ തോന്നുന്നത്.
ഇന്നലെ ഒരു ബസ് ഡ്രൈവറുടെ വായിൽ വ്രണങ്ങൾ കണ്ടു; ബസ് യാത്രക്കാരുടെ മുന്നിൽ അയാൾ അത് ചൊറിയുകയായിരുന്നു.
വേണ്ടിവന്നേക്കാമെന്ന് കരുതി ഞാൻ ഒരുപാട് സാധനങ്ങൾ കൂടെ കൊണ്ടുനടക്കും.
ടിക്കറ്റിന് നിങ്ങൾ എത്ര പണം നൽകി?
ഇന്നലെ ഞാൻ എന്റെ പുതിയ ഫോൺ തകർത്തു.
ഈ വർഷം വളരെ നന്നായി പോയി.
എനിക്ക് ഇത് നന്നായി ചെയ്യാൻ കഴിയില്ലെങ്കിൽ, വീണ്ടും വിറ്റ് പണം നഷ്ടപ്പെടും.
ഓഹ്, നിനക്കായി വിഷമം തോന്നുന്നു.
എപ്പോഴെങ്കിലും ഒരു ദിവസം ആശുപത്രിയിൽ ജോലി ചെയ്യാൻ എനിക്ക് ആഗ്രഹമുണ്ട്.
എന്റെ പങ്കാളി ദിവസം മുഴുവൻ ഉറങ്ങുമ്പോഴൊക്കെ എനിക്ക് വല്ലാതെ വിഷമമാകും.
അവിടെ നിന്റെ കൈയിൽ എന്തായിരുന്നു?
അവർക്ക് എന്താണ് ഇതിന് കാരണമെന്ന് ഉടൻ കണ്ടെത്താൻ കഴിയുമെന്ന് ഞാൻ പ്രതീക്ഷിക്കുന്നു.
എന്റെ രണ്ട് പെൺമക്കൾ ഹൈസ്കൂളിൽ നിന്ന് ബിരുദം നേടുന്നത് ഞാൻ കണ്ടു.
കലയെ ആസ്വദിക്കാൻ ഇതിലും മികച്ച രീതികളുണ്ട്.
എനിക്ക് കുറച്ചുകൂടി കഠിനമായി ജോലി ചെയ്യണം.
ഓഹ് വാവ്, എല്ലാവരും സുഖമായിരുന്നോ?
ശരിക്കും, എനിക്കും കൃത്യമായി ഇങ്ങനെയാണ് തോന്നുന്നത്.
എന്റെ ചരിത്ര ക്ലാസിൽ ലോകമഹായുദ്ധങ്ങളെക്കുറിച്ച് വായിച്ചപ്പോൾ എനിക്ക് പല വികാരങ്ങളും തോന്നി.
നടക്കാനുള്ള വഴിയിലേക്കോ പാർക്കിലേക്കോ പോകൂ.
ഞാൻ 20 പൗണ്ട് ഭാരം കുറച്ചപ്പോൾ എന്റെ നേട്ടത്തിൽ വളരെ സന്തോഷമായി.
എന്റെ സഹോദരി ഇപ്പോൾ പറഞ്ഞതാ, ഏറെ കഷ്ടപ്പെട്ട് ശ്രമിച്ചിരുന്ന പുതിയ ജോലി അവൾക്ക് കിട്ടിയെന്ന്.
അവധി ദിവസത്തിന് അനുമതി കിട്ടിയപ്പോൾ എനിക്ക് സന്തോഷമായി.
ഞാൻ ഗോൾഡൻ ടിക്കറ്റ് നേടി.
വാവ്, മുമ്പ് നീ ഇത്രയും തടിയനായിരുന്നോ?
ഞാൻ ആഴ്ചയിൽ രണ്ടുതവണ മാത്രമേ ജിമ്മിൽ പോകാറുള്ളൂ, പക്ഷേ അതിൽ എനിക്ക് പ്രശ്നമില്ല.
പ്രൈമറി സ്കൂളിലെ എന്റെ പ്രിയപ്പെട്ട അധ്യാപകൻ മരിച്ചുവെന്ന് കേട്ടപ്പോൾ എന്റെ ഹൃദയം തകർന്നു.
ഇക്കാലത്ത് ആളുകൾ എല്ലാത്തിനെയും കുറിച്ച് ഇത്രയും പിടിവാശിയുള്ളവരാണ്.
നല്ലത്, അത് ശരിക്കും പ്രധാനപ്പെട്ട കാര്യമാണ്.
എന്റെ ഇപ്പോഴത്തെ ജോലിക്കായുള്ള ഇന്റർവ്യൂ കഴിഞ്ഞപ്പോൾ എനിക്ക് ആത്മവിശ്വാസം തോന്നി.
അവൻ എന്തുതരത്തിലുള്ള അലങ്കാരങ്ങളാണ് കൊണ്ടുവന്നത്?
നിനക്ക് അത് വ്യക്തമായി പരിഹരിക്കാനായതിൽ എനിക്ക് സന്തോഷമുണ്ട്.
എനിക്കും ജോലിയിൽ നിന്ന് ഇറങ്ങിപ്പോകണമെന്ന് തോന്നുന്ന സമയങ്ങളുണ്ട്.
നിനക്ക് എപ്പോഴെങ്കിലും ചുഴലിക്കാറ്റോ പ്രകൃതിദുരന്തമോ നേരിട്ടിട്ടുണ്ടോ?
ഞാൻ ഒരു മത്സരത്തിലായിരുന്നു. നാളെ എലിമിനേഷൻ ഘട്ടമാണ്.
മോഷ്ടിക്കുന്നത് വളരെ വിരളമായേ ഗുണകരമാകാറുള്ളൂ, എന്നിട്ടും അത് ആളുകളെ അങ്ങനെ ചെയ്യുന്നതിൽ നിന്ന് തടയുന്നില്ല.
ഞാൻ എപ്പോഴും എന്റെ അനിയനെ നോക്കിക്കൊണ്ടിരിക്കുമായിരുന്നു.
അതുകൊണ്ട് ഞാൻ ഉള്ള മുറിയിൽ അവർ വന്ന് ബഹളം വെക്കാം.
ഞാൻ ഒരു അഭിഭാഷകനെ ഏർപ്പെടുത്തി എനിക്ക് എന്ത് ചെയ്യാനാകുമെന്ന് നോക്കും.
അതെ, മാറ്റം പലപ്പോഴും ബുദ്ധിമുട്ടാണ്.
എന്റെ സഹോദരന്റെ വീട്ടിൽ കള്ളൻ കയറിയിരുന്നു.
നീ അവരിൽ വിലമതിക്കാനാകാത്ത സ്വാധീനം ചെലുത്തിയിട്ടുണ്ട്.
ഞാൻ ചെറുപ്പത്തിലിരിക്കുമ്പോൾ എന്റെ സഹോദരൻ താമസം മാറുകയാണെന്ന് അറിഞ്ഞപ്പോൾ അത് എന്നെ ശരിക്കും തകർത്തു.
എനിക്ക് ഈ ജോലി ശരിക്കും വേണം.
എനിക്ക് അത് ചെയ്യണം.
അവർ ചോദിക്കാതെയാണ് അത് ചെയ്തതെന്നും കാറിന് അറ്റകുറ്റപ്പണി വേണമായിരുന്നെന്നും നിനക്ക് വിശ്വസിക്കാനാവില്ല.
അതുകൊണ്ടാണ് എനിക്ക് എന്റെ സുഹൃത്തിനെക്കുറിച്ച് ഓർമ്മ വന്നത്.
അത് വളരെ നല്ലതാണ്, നായ്ക്കൾക്ക് ഇത്ര സ്നേഹമുള്ളവരാകാം.
അത് എന്റെ മറ്റേ സ്ക്രീനിലുണ്ട്, ഞാൻ തയ്യാറാണ്.
അവൻ ഏകദേശം 7 വർഷം എന്റെ കൂടെയുണ്ടായിരുന്നു.
ഒരൊറ്റ വ്യക്തിയുമായി മാത്രം സംതൃപ്തനായി കഴിയാനുള്ള വഴി നീ കണ്ടെത്തണം.
നീ കൃത്യമായി എന്തിനെ കുറിച്ചാണ് പറഞ്ഞിരുന്നത്?
നിനക്ക് അവരെ വേറെ എവിടെയെങ്കിലും കണ്ടെത്താനായോ?
എനിക്കും കുറച്ച് ടെൻഷനുണ്ടായിരുന്നു, പക്ഷേ ഏറെക്കാലത്തിന് ശേഷം കണ്ടുമുട്ടി സംസാരിച്ചത് വളരെ രസകരമായിരുന്നു.
കഴിഞ്ഞ വാരാന്ത്യത്തിൽ ഞാൻ എന്റെ കുട്ടികളുടെ സോക്കർ കളി കാണുകയായിരുന്നു.
പക്ഷേ ആ ഓർമ്മകൾ എന്നും നമ്മോടൊപ്പം സന്തോഷിക്കും.
ഞാൻ സമ്മതിക്കുന്നു, അതിന് ഭയങ്കര ദുർഗന്ധമായിരുന്നു.
ആ പുക നിനക്ക് ഇഷ്ടപ്പെട്ടില്ല, കാരണം അത് നിന്റെ അച്ഛന്റെ പുകവലി ശീലം നിന്നെ ഓർമ്മിപ്പിച്ചു.
ഞാൻ വീട്ടിൽ കയറിയപ്പോൾ എന്റെ ഭാര്യ കയ്യിൽ കേക്കുമായി ഡയറ്റ് തെറ്റിക്കുകയായിരുന്നു.
നീ വീട്ടിലേക്ക് പോകുമ്പോൾ നിന്റെ പുരോഗതി ഒരു സുഹൃത്തിന് പിന്തുടരാൻ അനുവദിക്കുന്ന ചില ആപ്പുകളുണ്ട്.
ഞാൻ ജയിൽ സംബന്ധിച്ച ഒരുപാട് ഷോകൾ കണ്ടുകൊണ്ടിരിക്കുകയാണ്.
നീ തയ്യാറാണെങ്കിൽ നന്നായി ചെയ്യാനാകും.
ഞാൻ ചെറുപ്പമായിരുന്നപ്പോൾ കഞ്ചാവുമായി പിടിക്കപ്പെട്ടു.
അവൻ എന്തോ കുഴപ്പം ചെയ്യുകയാണ്.
സത്യം പറഞ്ഞാൽ ബാസ്കറ്റ്ബോളിനെക്കുറിച്ച് എനിക്ക് അധികം അറിയില്ല, അതുകൊണ്ട് ഇതിനെക്കുറിച്ച് എനിക്ക് ശക്തമായ അഭിപ്രായമില്ല.
എന്റെ ടീമിലെ ഒരു പിച്ചർ ഒരു വലിയ കോളേജുമായി കരാർ ഒപ്പിട്ടു.
ശരി എന്നാൽ, അങ്ങനെ പറയുന്നത് ശരിക്കും വിചിത്രമായി തോന്നി.
അവന് ആരെയെങ്കിലും കൂടെ കൊണ്ടുവരാമോ?
ചിലപ്പോൾ ആളുകൾ അത്തരമൊരു നഷ്ടത്തിലൂടെ കടന്നുപോകുമ്പോൾ സ്വയം ഒറ്റപ്പെടുന്നു, അതോടെ അവർക്ക് കൂടുതൽ മോശമായി തോന്നും.
കുറച്ച് മിനിറ്റുകൾക്ക് ശേഷം കനത്ത മഴ പെയ്യാൻ തുടങ്ങിയപ്പോൾ ഞാൻ ശരിയായിരുന്നു.
നമുക്ക് അപ്പോൾ എങ്ങനെയെങ്കിലും ഒപ്പിച്ചെടുക്കാമെന്ന് തോന്നുന്നു.
അതെ, മൂന്ന് ദിവസം അവധി കിട്ടിയിരുന്നെങ്കിൽ അടിപൊളിയായേനേ, പക്ഷേ ഇതാണ് യഥാർത്ഥ ജീവിതം.
എന്റെ വിവാഹസമയത്ത് അമ്മ എനിക്ക് ഒരു ജോടി കമ്മലുകൾ തന്നു; അവ ഞങ്ങളുടെ കുടുംബത്തിൽ വളരെക്കാലമായി ഉള്ളതാണ്.
ഹൈസ്കൂളിന് ശേഷം ജിഇഡി നേടി അമ്മ മാസ്റ്റേഴ്‌സ് ബിരുദം നേടിയപ്പോൾ ഞാൻ അഭിമാനത്തോടെ തലയുയർത്തി നിന്നു.
ഉച്ചസമയം ഒഴിവാക്കിയാൽ ഏകദേശം 100ഓളം സാധിക്കും.
നിനക്ക് ഇഷ്ടപ്പെടുന്ന എന്തെങ്കിലും കിട്ടുമെന്ന് പ്രതീക്ഷിക്കുന്നു.
രാത്രിയിൽ ഉറങ്ങുമ്പോഴും അത് എന്നെ അലട്ടുന്നു; അത് മനസ്സിൽ നിന്ന് മാറ്റാനേ കഴിയുന്നില്ല.
അത് ഏത് ഇനത്തിലുള്ള നായയാണ്?
നീ നായയെ ശകാരിച്ചോ?
അത് പരിശോധിക്കാൻ പോകരുത്.
ഇല്ല, അവൻ അതൊരു സൂചനയായി കരുതിയിരിക്കാം; കാരണം കുറച്ച് മാസങ്ങൾക്ക് ശേഷം അവൻ എന്നോട് കളിക്കാൻ പറഞ്ഞു.
ജോലിയിൽ നിന്ന് വീട്ടിലെത്തിയപ്പോൾ അവിടെ ഞാനും നായയും മാത്രമേ ഉണ്ടായിരുന്നുള്ളൂ.
ആ രാത്രിയിലെ സംഭവം എന്നെ ഭയം കൊണ്ട് പൂർണ്ണമായി പിടിച്ചുകുലുക്കി.
എന്റെ അച്ഛൻ എനിക്ക് തികച്ചും പുതിയൊരു കാർ തന്നു.
എനിക്ക് ശരിക്കും ആ പണം ആവശ്യമുണ്ട്.
ഞാൻ അവൾക്ക് ഒരു ജോലി കൊടുത്തു, പക്ഷേ അവൾ അത് പൂർത്തിയാക്കിയില്ല.
എനിക്ക് വിദ്യാഭ്യാസം ഏറെ ഇഷ്ടമാണ്, ഇത് എനിക്ക് ഒരു നല്ല ചുവടുവയ്പ്പാണ്.
അൽപ്പം ഇരുമ്പിന്റെ കുറവുണ്ട്, പക്ഷേ അതെ, എല്ലാം ശരിയാണ്
ഏകദേശം 10 മിനിറ്റ് ഞങ്ങളെ പിടിച്ചുനിർത്തി
അവൻ അങ്ങനെ ചെയ്തത് വളരെ നല്ലതാണ്
അയ്യോ ദൈവമേ, അത് വളരെ അലോസരപ്പെടുത്തുന്നതായിരുന്നിരിക്കണം
ഇത് തമാശയായിരിക്കും എന്ന് കരുതി നീ മനപ്പൂർവം ചെയ്തതൊന്നുമല്ലല്ലോ
ഞാൻ ഒരിക്കലും പോയിട്ടില്ല, എനിക്ക് പരിഭ്രമമുണ്ട്
അത് നല്ല വാർത്തയാണ്, നിന്റെ കാർക്ക് കുഴപ്പമില്ലെന്ന് പ്രതീക്ഷിക്കുന്നു
അവൻ ഗേറ്റ് തുറന്നുവെച്ചു, എന്റെ നായ ഓടിപ്പോയി
ക്യാമ്പിംഗ് ബുദ്ധിമുട്ടുള്ള കാര്യമാകാം, പക്ഷേ ഒരിക്കൽ എല്ലാം സജ്ജമാക്കിയാൽ പിന്നെ എളുപ്പമായിരിക്കണം
നിനക്കും നിന്റെ കുടുംബത്തിനും നന്മകൾ നേരുന്നു
എനിക്ക് ഇനിയും കുറച്ച് ദൂരം പോകാനുണ്ട്, പക്ഷേ ഞാൻ മെച്ചപ്പെട്ടുവരുന്നു
അതിനെക്കുറിച്ച് ക്ഷമിക്കണം, പക്ഷേ അവർ മുമ്പ് വളരെ നല്ലവരായിരുന്നു, അതിൽ നീ അഭിമാനം കൊള്ളണം
അയ്യോ ദൈവമേ, അത് ശരിക്കും വളരെ നാണക്കേടായിരുന്നിരിക്കണം
എന്റെ സഹോദരൻ എന്നോട് വഴക്കിടാൻ ആഗ്രഹിച്ചപ്പോൾ
അത് എന്റെ ബാല്യകാലം ഓർമ്മിപ്പിക്കുന്നത് എനിക്ക് ഇഷ്ടമാണ്
അത് വളരെ ഭയാനകമാണ്, നിനക്ക് പ്രേതങ്ങളിൽ വിശ്വാസമുണ്ടോ
പക്ഷേ അത് എന്റെ കൈവശമില്ലെന്ന് ഞാൻ അമ്മയോട് കള്ളം പറഞ്ഞു
നീ ഇത് വീണ്ടും ചെയ്യുമോ
കുറഞ്ഞത് സിനിമയെങ്കിലും നല്ലതായിരുന്നോ
ഒരാഴ്ചയ്ക്കുള്ളിൽ തന്നെ ദൂരെയുള്ള എന്റെ കാമുകിയെ കാണാൻ പോകുന്നു
ഒടുവിൽ എന്റെ എല്ലാ തയ്യാറെടുപ്പുകളും ഫലിച്ചു.
കഴിഞ്ഞ ദിവസം ഞാൻ പലചരക്ക് കടയിൽ ആയിരുന്നു.
നെക്ക്ബിയാർഡുകളുടെ പതിവ് സാധനത്തേക്കാൾ ഇത് വളരെ മികച്ച വാങ്ങലാണ്.
എന്റെ ഡിഗ്രി പൂർത്തിയാക്കി നഴ്‌സാകാൻ ഇനി കാത്തിരിക്കാനാവില്ല.
അതായത് എനിക്ക് യാതൊരു പ്രശ്നവും ഇല്ലെന്നായിരിക്കും.
ഇതുവരെ നിന്റെ ജീവിതം ശരിക്കും നല്ലതായിരുന്നെന്ന് തോന്നുന്നു.
അതെ, അത് വളരെ നല്ല ആശയമാണ്.
നിനക്ക് വളർത്തുമൃഗമായി ഒരു ലെമൂർ ഉണ്ട്.
പഠിപ്പിക്കുന്നത് തനിക്ക് ശരിക്കും ഇഷ്ടമാണെന്ന് അവൻ പറയുന്നു.
എനിക്ക് വളരെ അത്യാവശ്യമായി ഒരു അവധി വേണം.
അതെ, എന്റെയും കാരണം അതുതന്നെയാണ്.
ഞാൻ അത് സാധിച്ചാൽ മാത്രം.
ഇന്നലെ ഒറ്റയ്ക്ക് നടന്ന് വീട്ടിലേക്ക് പോകാൻ എനിക്ക് പേടിയായിരുന്നു.
സത്യത്തിൽ, അത് അവർക്ക് നല്ലതല്ല.
200-ൽ താഴെ, എനിക്ക് കുതിരസവാരി ചെയ്യാൻ പോകാൻ കഴിയണം.
ഓ, എനിക്കും അവരെ ഇഷ്ടമാണ്.
ആറ് വർഷം മുമ്പ് ചെയ്തതുപോലെ അവൻ ജോലി ഉപേക്ഷിച്ചേക്കാം.
ഏകദേശം ഒന്നര വർഷം കഴിഞ്ഞപ്പോൾ എഴുത്ത് പിന്തുടരാൻ അവൻ പഠനം ഉപേക്ഷിക്കുകയും സ്കോളർഷിപ്പ് പാഴാക്കുകയും ചെയ്തു.
എന്റെ മകൾ ആശുപത്രിയിൽ നിന്ന് പുറത്തിറങ്ങിയെങ്കിലും ഇപ്പോഴും വളരെ അസുഖമായിരുന്നു.
അടുത്ത കുറച്ച് ആഴ്ചകൾ എന്റെ ഭർത്താവ് ജോലിക്കായി പട്ടണത്തിന് പുറത്തായിരിക്കും.
കഴിഞ്ഞ സെമസ്റ്ററിൽ ഞാൻ എടുത്ത എല്ലാ ക്ലാസിലും എനിക്ക് എ ഗ്രേഡ് കിട്ടി.
ഇന്നലെ രാത്രി അവതാരകൻ ജീവനുള്ള ഒരു സ്ക്വിഡ് കഴിച്ച ഒരു ടെലിവിഷൻ ഷോ ഞാൻ കണ്ടു.
എന്റെ താൽപര്യങ്ങളുമായി കൂടുതൽ ഒത്തുപോകുന്ന ഒരു പുതിയ കാമുകിയെ എനിക്ക് കിട്ടി.
ജോലിസ്ഥലത്തെ ആളുകൾക്ക് ചുറ്റിനടന്ന് ഒന്നും ചെയ്യാതെ ഇരിക്കാനാകുമ്പോൾ.
കസ്റ്റമർ കെയർ പ്രതിനിധികളോട് കയർത്തു സംസാരിക്കണമെന്നു തോന്നുന്നു.
അവർ വളർന്നുവരുന്നത് സംബന്ധിച്ച ഒരുപാട് ഓർമ്മകൾ എനിക്കുള്ളതിനാൽ അത് എനിക്ക് ബുദ്ധിമുട്ടായിരുന്നു.
അത് ഗംഭീരമാണ്! എനിക്കും അങ്ങനെ ചെയ്യാൻ കഴിഞ്ഞിരുന്നെങ്കിൽ—ശരിക്കും അത്ഭുതം.
റോഡിലെ നല്ല കാറുകൾ കാണുന്നത് എന്നെ പ്രചോദിപ്പിക്കുന്നു.
എനിക്ക് ട്രംപിനെ ഇഷ്ടമാണ്; അദ്ദേഹം ദിവസം മുഴുവൻ സംസാരിച്ചാലും ഞാൻ കേട്ടിരിക്കാം.
ഇന്നത്തെ കാലാവസ്ഥാ പ്രവചനത്തിൽ മഴക്കാറ്റ് ഉണ്ടാകുമെന്ന് കേട്ടിരുന്നു.
അശ്രദ്ധയായി എന്റെ സഹപ്രവർത്തകന്റെ കാറിൽ ഞാൻ ചുരണ്ടിപ്പോയി.
ഞങ്ങൾ ഒരുമിച്ച് ചെലവഴിച്ച സമയം എങ്ങനെ പോയി എന്ന് ഓർക്കുമ്പോഴെല്ലാം എനിക്ക് ഭൂതകാലത്തെക്കുറിച്ച് വികാരാധീനനാകുന്നു.
തീർച്ചയായും കുറച്ച് പൊട്ടിച്ചിരികൾ ഉണ്ടായിരുന്നു.
അവർക്കുള്ള ശിക്ഷ സ്കൂൾ മേളയിൽ പോകാൻ പാടില്ല എന്നതാണ്.
അവരുടെ ഭാരം കുറഞ്ഞു, എന്റേത് കുറച്ച് കൂടി.
അത് വളരെ തമാശയാണ്, പക്ഷേ നിനക്ക് എങ്ങനെ തോന്നുന്നുവെന്ന് എനിക്ക് കൃത്യമായി അറിയാം.
