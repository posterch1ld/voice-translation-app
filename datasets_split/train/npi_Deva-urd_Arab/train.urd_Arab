اوہ سوری، جہاں ہم منتقل ہو رہے تھے وہاں ہم کسی کو نہیں جانتے تھے
ہر چیز صاف کر کے سلیقے سے رکھنے کے معاملے میں میں بہت محنتی تھا
میری گراما کبھی کبھی برا سلوک کرتی رہی ہیں، پھر بھی ان کی دیکھ بھال کرنے پر مجھے اپنی ماں پر فخر ہے
میرے دوست کو اچانک نوکری اور گرل فرینڈ ملنے تک وہ بالکل کوئی نہیں تھا
اس سے تو تقریباً ایسا لگتا ہے جیسے تم گریجویٹ نہیں ہوئے یا کچھ گڑبڑ ہو گئی—کیا تم گریجویٹ ہوئے تھے
مجھے شک ہے کہ میں یہ کر سکوں گا
کیا تم انہیں گھر بلانے سے گھبرا رہے ہو
جب میرے بچے بہت زیادہ خاموش ہوتے ہیں
مجھے واقعی اس پر فخر ہے کہ وہ یہ کر سکا
وہ تو یقیناً کافی بڑا سرپرائز رہا ہوگا
ہاں، اور ہم نے اس کے ساتھ بھی وہی کیا تھا
خاندان کی بات ہو تو مجھے اپنی چھوٹی بھانجی کو پڑھ کر سنانا بہت پسند ہے
میں اپنی زندگی میں کبھی اتنا شرمندہ نہیں ہوا
میرا خیال ہے کہ اگر تمہیں خود پر اعتماد ہو تو تم زیادہ تر نوکریوں کے لیے خود کو منا سکتے ہو
جب بھی مجھے سڑک پر جیپیں نظر آتی ہیں تو مجھے بہت حسد ہوتا ہے
ہاں، مجھے واقعی بہت گھبراہٹ ہو رہی ہے کہ وہ مجھے نوکری پر نہیں رکھیں گے۔
یہ ایسا لگ رہا تھا جیسے کوئی بڑا، بوڑھا اور خونخوار بھیڑیا مجھے کھانا چاہتا ہو۔
میں اپنے بچوں کو بوفے پر لے جانا چاہتا ہوں۔
مجھے امید ہے کہ یہ ریاضی ہے اور میں نے اس کے لیے محنت کی ہے۔
کاش میں اپنی امی کی کچھ اور مدد کر پاتا۔
ہم پارٹی میں صرف اپنے ڈَیٹ کو اتنا بکھرا ہوا اور بے ڈھنگا دیکھنے کے لیے ملنے کا ارادہ رکھتے ہیں۔
کبھی کبھی میرے لیے سکون سے آرام کرنا مشکل ہو جاتا ہے۔
کرسمس سے ایک دن پہلے میں بہت پرجوش ہو جاتا ہوں۔
اس پر بہت کچھ منحصر ہے۔
جب تک موقع ہے، تمہیں ان کی قدر ضرور کرنی چاہیے۔
امید ہے تمہاری شام خوشگوار گزرے اور تمہیں پُرسکون نیند آئے۔
امید ہے کہ کسی دن میں لوگوں پر زیادہ بھروسا کرنا سیکھ جاؤں گا۔
کیا تم مستقبل میں ایک اور کتا لینے کا سوچ رہے ہو؟
سب سے بری بات یہ تھی کہ تصویریں، بچوں کے کمبل، ایئر بکس—مختصر یہ کہ سب کچھ پھینکنا پڑا۔
یہ ایک شاندار ہفتے کی صبح ہے اور میں یہ دیکھنے کے لیے بہت بےتاب ہوں کہ آج کیا ہونے والا ہے۔
بس اس پر کام کرتے رہو۔
کیا تمہیں کبھی اپنا سامان استعمال کرنا پڑا ہے؟
اس کے پیٹ پر ایک عجیب سا دانہ تھا۔
میں نے اپنا لیپ ٹاپ گرا کر توڑ دیا۔
ایسی یادیں یقیناً تمہیں بہت عزیز ہوں گی۔
جس ترقی کو حاصل کرنے کے لیے میں نے اتنی محنت کی تھی، وہ مجھے نہیں ملی۔
اس کے پاس میرے گھر کے باہر کی تصویریں تھیں اور اس سے میں ڈر گیا تھا، لیکن وہ بس ایک دوست کی شرارت تھی۔
کیا تم ان کی مدد کر پائے؟
وہ گھر میں رہتا ہے، لیکن کبھی کبھی پٹے کے بغیر باہر چلا جاتا ہے اور مجھے ڈر لگتا ہے کہ وہ واپس نہیں آئے گا۔
مجھے ہمیشہ کسی بڑے سفر کے لیے تیار رہنا پسند ہے۔
اگر اس کی انگلی میں انگوٹھی نہیں ہے تو ابھی بھی امید ہے۔
چند ہفتوں میں پاناما سٹی جا رہا ہوں۔
اوہ، یہ سن کر افسوس ہوا۔
مجھے اپنی ٹانگوں اور آزادی کی بہت یاد آتی ہے۔
وقت کے ساتھ تم دوبارہ سواری کر سکو گے۔
آن لائن دوست بھی اتنے ہی اچھے ہوتے ہیں۔
جب میں نے اپنی بلی میٹی کو کھو دیا تھا۔
میں بھی بیٹل فیلڈ میں داخل نہیں ہو سکا۔
اوہ، خیر، یہ تو ایک اضافی فائدہ ہے۔
ملازمت کا تحفظ ہونا بہت اچھا احساس ہے۔
میں نے سنا ہے کہ میرے بچپن کے گھر کے قریب کا جنگل نئے گھر بنانے کے لیے کاٹ دیا گیا۔
وہ بہت پیارے اور اچھے تھے، لیکن کوئی بھی انہیں نہیں چاہتا تھا۔
گزشتہ رات میرے آرماڈیلو نے قالین پر پاخانہ کر دیا۔
وہ کس بات کے بارے میں جھوٹ بولتی آ رہی ہے؟
مجھے لگتا ہے کہ یہ میری نئی ملازمت اب تک کی میری سب سے اچھی ملازمت ہے۔
کیا اس سے آپ کو شرمندگی محسوس ہوئی؟
اب سمجھ آ رہا ہے کہ اسکول کے معاملات جتنے نظر آتے تھے، اُن سے کہیں کم پریشانی والے تھے۔
جب میری امی کالج میں داخل ہوئی تھیں۔
میری بوڑھی بلی بہت بیمار ہے۔
مجھے کام پر بڑا بونس ملا اور میں اپنا قرض چکانے کے قابل ہو گیا۔
مجھے سوشی بہت پسند ہے، یہ بہت مزیدار ہوتی ہے۔
دوسری نوکری طے کیے بغیر ہی میں نے اپنی نوکری چھوڑ دی۔
کیا آپ ابھی ری یونین میں ہیں؟
آپ لوگ ایک دوسرے کی صحبت سے لطف اندوز ہوں گے۔
میں ایک چھوٹے شہر کے بینک میں کام کرتا ہوں۔
پڑھنا شروع کرنے کے لیے میں کچھ اچھی کتابیں ڈھونڈ رہا ہوں۔
انہوں نے آج مجھے فون کیا اور مجھے نوکری مل گئی۔
وہ میرے قریب ہی رہتے ہیں اور ہمیشہ میری مدد کرتے ہیں۔
مجھے خوشی ہے کہ آپ نے زندگی میں ایک نیا انداز ڈھونڈ لیا ہے۔
میں جلد ہی اڑ کر بوسٹن جاؤں گا اور اپنی گرل فرینڈ سے ملوں گا۔
ہاں، تھوڑی دیر کے لیے اس نے واقعی ہمیں ڈرا دیا تھا۔
اچھا وقت گزرا۔
میں کچھ لیب کے نتائج معلوم ہونے کا انتظار کر رہا تھا۔
یہ انسانی بات ہے—جب آپ کچھ عرصہ زندگی گزار لیتے ہیں تو ہر چیز پہلی بار ہی درست کرنا ضروری نہیں ہوتا۔
آج سپر مارکیٹ میں مجھے بہت غصہ آیا۔
ہاں، وہ کھیل میں ہار گئے۔
مجھے امید ہے کہ میری ساس اس معاملے میں میری مدد کر پائیں گی۔
مجھے اتنا یقین نہیں کہ ہم ان سے مکمل طور پر چھٹکارا پا سکیں گے۔
وہ کافی تیزی سے آگے بڑھ رہا ہے۔
ہم اگلے ویک اینڈ پر کیمپنگ کرنے جا رہے ہیں اور اسے ٹھیک طرح کرنے کے لیے میرے پاس سارا سامان ہے۔
تیار رہنے کے لیے میں ہر روز ورزش کرتا ہوں۔
میں نے حال ہی میں چھٹیوں کے دوران ایک دیکھا اور اندر چلا گیا۔ یہ حیرت کی بات ہے کہ وہ اب بھی موجود ہیں۔
اچھا نہیں۔ کیا تم دوسرا لینے جا رہے ہو؟
میں نے اپنے آخری امتحانات دے دیے ہیں اور نتائج کا انتظار کر رہا ہوں۔
میرا بھائی بھی حال ہی میں اسی صورتِ حال سے گزرا ہے۔
تم ایسا کیوں کرو گے؟
ایک لڑکی کے بڑے ہونے کی اچھی کہانی۔
مجھے اس کی توقع نہیں تھی، لیکن بنیادی طور پر اس لیے کہ میرے اعداد و شمار زیادہ تھے۔
مجھے افسوس ہے کہ تم ناراض تھے۔
حال ہی میں میرا بہت وزن کم ہوا ہے۔
ہر روز بارش ہو رہی ہے اور مجھے اپنی اٹاری میں پانی ٹپکنے کی آواز سنائی دینے لگی ہے۔
امید ہے تم جلد بہتر محسوس کرو گے۔
افسوس، کاش کبھی میرے ساتھ بھی ایسا ہو پاتا۔
اگر تم صحت مند ہو تو آگے بڑھتے رہنا ہی بہتر ہے۔
اگر اندر جاتے ہوئے تمہیں اعتماد محسوس نہیں ہوتا تو تم مشکل میں ہو۔
ہاہا، پھر ہم دو بالکل مخالف سروں جیسے تھے۔
ہفتے کے آخر تک شاید مجھے اپنی نئی گاڑی مل جائے۔
میں جتنی بار ممکن ہو سکے، اتنی بار وہ کرنے کی کوشش کرتا ہوں۔
اوہ، یہ تو بہت ڈراؤنا ہے۔
جب لوگ مختلف ڈونٹس خریدیں اور کوئی تمہارا پسندیدہ واحد ذائقہ کھا جائے۔
یہ بہت برا ہے، سن کر افسوس ہوا۔
تم کچھ بھی نہیں کھو رہے ہو۔
جب میں اٹھا تو یہ جان کر بہت مایوسی ہوئی کہ وہ صرف ایک خواب تھا۔
نہیں، یہ ایک ماہر کر رہا ہے جو شیرف محکمہ کے ساتھ کام کرتا ہے۔
کم از کم مجھے پیسے تو مل رہے ہیں، میرا خیال ہے۔
تمہیں اس سے ملنے کا موقع کیسے ملا؟
تم اسے کل رات کے کھانے میں کھا سکتے ہو۔
اس ڈر سے کہ شاید کوئی اندر آ کر مجھے مارنے کے انتظار میں ہو، میں اپنی چادر کے نیچے چھپا ہوا ہوں۔
مجھے لگتا ہے کہ میں بہت اچھا کروں گا۔
اس دور کا پورا ماحول زبردست تھا۔
میں نے ہر طرف دیکھا، لیکن وہ سب جا چکے تھے۔
جب میں کام کرتا ہوں تو میرے بچے کافی عرصے سے مجھ سے درخواست کر رہے ہیں کہ انہیں بیبی سیٹر کے بغیر گھر میں اکیلے رہنے دوں۔
میرا خیال ہے لوگ جو کہتے ہیں وہ سچ ہے—بلیوں کی واقعی نو زندگیاں ہوتی ہیں۔
وہ کس پر بھونک رہا ہے؟
کتے پر ایک کویوٹ نے حملہ کر دیا۔
یہ اسٹیک کی پٹیاں ہیں، اجی کے پیاز، مرچوں اور ٹماٹروں کے ساتھ۔
کل میں دیکھوں گا کہ میں نے کیسا کیا۔
مجھے اپنی دادی کے گھر کا اتوار کا کھانا یاد آتا ہے۔
یہ بہت اچھی بات ہے کہ تم اسے لے جانے والے ہو۔
خیر، اتنی زیادہ ورائٹی ہونا یقیناً دلچسپ ہوگا، ان کی عمر کتنی ہے؟
آج صفائی کرتے ہوئے مجھے بچپن کی اپنی کچھ پرانی تصویریں ملیں۔
اب تو یہ درد بھی نہیں کرتا، پھر بھی یہ ابھی تک مجھے تنگ کر رہا ہے۔
اپنے والدین کے ساتھ کھلا رشتہ ہونا اچھی بات ہے۔
اس اتوار میں نے پہلی بار 60 میل دوڑنے والا ہفتہ مکمل کیا۔
اوہ ہاں، اور ہر بار وہ اس کی جواب دینے والی مشین پر چلا جاتا ہے۔
کیا تمہاری بلی اب ٹھیک ہے؟
مجھے واقعی امید ہے کہ تم صحیح ہو اور نتائج منفی آئیں۔
مجھے 18 سال کی عمر میں کھینچی گئی اپنی اسپرنگ بریک کی کچھ تصویریں ملیں۔
حال ہی میں میرے گھر کو بہت زیادہ نقصان پہنچا۔
گزشتہ ہفتے کام پر مجھے بہت شرمندگی ہوئی تھی۔
مجھے برا لگ رہا ہے کہ میں نے اس کا کریڈٹ لے لیا۔
اوہ واہ، امید ہے تمہیں جلد کچھ مدد مل جائے گی۔
میری روز والی رائیڈ مجھے جلدی چھوڑ کر چلی گئی۔
میں نے اپنی بالکل نئی گاڑی کا مکمل کباڑا کر دیا۔
میرا خیال ہے کہ یہ ہمیں حقیقی دنیا کے لیے تیار کرنے کے لیے ہے۔
آج میں لنچ کے لیے آربیز گیا تھا۔
وہ تمہارے ساتھ کب ہوا تھا؟
مجھے یقین نہیں آ رہا کہ انہوں نے پوری گرمیوں میں ہمارا پول کھولا ہی نہیں۔
کم از کم کچھ حد تک وہ احساس مجھے بھی معلوم ہے۔
جب میرا دوست گھر بدل رہا تھا تو اس نے اپنا صوفہ مجھے دے دیا۔
مجھے خوشی ہے کہ تم پُراعتماد لگ رہے ہو۔
تم اگلی بار زیادہ کوشش ہی کر سکتے ہو۔
مجھے مثلثیات سے بہت نفرت ہے۔
افسوس کہ پولیس آس پاس نہیں تھی۔
میں نہیں چاہتا کہ وہ اسے بڑا مسئلہ بنائے۔
لگتا ہے تمہاری بیٹی بڑی ہو کر بہت ذمہ دار بن رہی ہے۔
تمہیں ان میں کیا پسند ہے؟
اس میں دیکھ کر مجھے لیکچر کے دوران پیچھے بیٹھ کر تکلیف سہنے کا وقت یاد آ گیا۔
میرے بیٹے نے مجھے بہت فخر محسوس کرایا ہے۔
میں سب کے آس پاس محتاط رہتا ہوں۔
کیا تمہیں اپنے خاندان سے ملے کافی وقت ہو گیا ہے؟
گرمیاں بہت مزے دار تھیں۔
انہوں نے تمہیں کتنی دیر انتظار کروایا؟
اوہ، یہ تو بہت اچھی بات ہے، اب تم انہیں اس کے ساتھ زیادہ بار چھوڑ کر مطمئن محسوس کر سکتے ہو۔
مجھے امید ہے کہ اس کی وجہ سے اس کا کیریئر کامیاب ہوگا۔
ہاں، لیکن اس کے بعد مجھے بہت برا محسوس ہوا۔
میرے پاس بھی کبھی ایک جوڑا نہیں رہا، لیکن میں ان سے نفرت نہیں کرتا۔
اب میں بالکل اکیلا ہوں۔
یہ کس چیز سے بنا تھا؟
اب تک یہ اس کے برعکس ہی کرتا آیا ہے۔
اچھا، شاید تم انہیں کسی کام کے لیے اکٹھا کر سکو۔
شاید اپنے جسم کے حصے، جیسے پلازما، بیچ کر۔
راستے میں میں بس برگر کنگ یا ویسی ہی کوئی چیز لے لوں گا۔
یہاں بھی مانسون جیسا موسم تھا۔
کیا تمہارے دل میں کوئی رنجش ہے؟
تو میں اندازہ لگا رہا ہوں کہ تمہیں نوکری مل گئی۔
لیکن آخرکار اصل امتحان میں وہ فیل ہونے میں کامیاب ہو گیا۔
میری پچھلی کامیابیوں میں سے ایک انٹرن شپ کی پیشکش ملنا تھا۔
عوامی نقل و حمل میں سفر کرتے ہوئے میں وقت کی پابندی نہیں کر سکا۔
لیکن جب وہ مجھے چھیڑنا چاہتا ہے تو یہ بات چھیڑ دیتا ہے۔
یہ تو زبردست ہے! تم کیا کرنے والے ہو، اس کے بارے میں مجھے مزید بتا سکتے ہو؟
یقیناً، وہ ایک اچھا احساس تھا۔
یار، یہ تو بہت افسوسناک ہے۔
حال ہی میں میرا کچھ وزن کم ہوا ہے اور اب جب میں تیار ہوتا ہوں تو مجھے زیادہ پراعتماد محسوس ہوتا ہے۔
پیر کو میں اپنی پسندیدہ کپ کیک بیکری جانے والا ہوں۔
میں ہوائی چلا جاتا۔
اس ہفتے مجھے جیتنے والا ٹکٹ مل گیا۔
پچھلے دن میری بیٹی بیمار تھی اور میرے لیے کام سے چھٹی کرنا ممکن نہیں تھا۔
ایک ہفتہ ہو گیا ہے۔
اگر تناؤ کم کرنے کے لیے تھوڑی شراب چاہیے تو پی لو۔
وہ سب کر کے دیکھ چکا ہوں۔
جب وہ آخرکار میرے گھر پہنچا تو میں نے تین نوالے کھائے اور بیچ میں ایک لمبا بال ملا۔
کیا تم اس کے نوٹس کرنے سے پہلے دکان جا کر کچھ اور لے آ سکتے ہو؟
ہم ہفتے کو ساحلِ سمندر پر جا رہے ہیں۔
اب تم دونوں برابر حیثیت میں ہو۔
میں نے اپنا پسندیدہ گلاس میز سے گرا دیا اور اب اس کا متبادل ڈھونڈنا ہوگا۔
جو تمہیں خوش کرے، وہی کرو۔
ایک دن میں وہاں پہنچ جاؤں گا۔
یہ سچ ہے۔ کیا وہ پریشان تھے؟
ہاں، اور اس دن میں کافی اداس محسوس کر رہا تھا۔
میں بڑی کمائی کرنے کے لیے بے تاب ہوں۔
میں اپنی زندگی میں پہلی بار رولر کوسٹر پر سوار ہونے والا ہوں۔
میں تمہارے لیے خوشیوں سے بھرے کامیاب کیریئر کی خواہش کرتا ہوں۔
ایسا لگتا ہے کہ اس دور میں زندگی زیادہ آسان تھی۔
شکریہ، میں نفسیاتی مشاورت کے لیے جا رہا ہوں۔
تو پھر آرام کرنے کے لیے یہ بہت اچھا دن لگتا ہے۔
ٹھیک ہے، کم از کم یہ یقینی بناؤ کہ تم کوئی مفید کام کر رہے ہو۔
میں تصور کر سکتا ہوں، سنا ہے وہاں سردیاں بہت سخت ہوتی ہیں۔
اگر کسی اور ترقی کے لیے مجھے نظرانداز کیا گیا تو میں واقعی بہت پریشان ہو جاؤں گا۔
کل مجھے واٹر پارک جانے کا موقع ملے گا۔
مجھے یقین ہے کہ اس سے تمہیں اچھا محسوس ہوا ہوگا۔
کچھ دن پہلے میرا بٹوا گم ہو گیا، لگتا ہے میں اسے بس میں چھوڑ آیا۔
وہ ہمیں بہت خوش کرتی ہے۔
یہ بہت اچھی بات تھی کہ اسے حاصل کرنے کے لیے تمہیں چنا گیا، اور امید ہے تم اسے دوبارہ کسی اور کو دے دو گے۔
کام کے لمبے دن کے بعد یہ بہت مدد کرتا ہے۔
مجھے یاد ہے جب ایک ہیمبرگر صرف ایک ڈالر کا ملتا تھا۔
میں بھی ایک اچھے سفر پر گیا تھا۔
ہاں، میں اس ریستوران میں دوبارہ کبھی نہیں جاؤں گا۔
اوہ میرے خدا، تم نے کیا کیا؟
سپروائزر کے طور پر ایسا کرنا کبھی بھی اچھی بات نہیں ہے۔
میں جلدی میں تھا اور وہ دیکھنے میں ایک جیسے لگ رہے تھے۔
میں کینیڈا کے پریری علاقوں میں پلا بڑھا، اس لیے روڈ ٹرپس کافی بور ہوتی تھیں۔
حال ہی میں مجھے ایک بے چینی سی محسوس ہو رہی ہے اور واقعی نہیں معلوم کیوں۔
وہ مسئلہ نہیں ہے۔
ایک چھوٹی سی بوتل کے اندر چاول کے ایک دانے پر میرا نام لکھا ہوا تھا۔
والدین کی حیثیت سے وہ آپ کے لیے یقیناً بہت فخر کا لمحہ رہا ہوگا۔
میری بیوی نے ابھی ابھی ہمارے 11ویں بچے کو جنم دیا ہے۔
میں اچھی طرح تیار ہوں، اس لیے مجھے یقین ہے کہ اسے پاس کرنے میں مجھے مشکل نہیں ہوگی۔
اُف، یہ تو سن کر ہی بڑا جھنجھٹ لگ رہا ہے۔
کیا تم نے فلم واپس کر دی؟
آج میرے پرندے کا پنجرہ ڈاک سے آنا تھا، مگر نہیں آیا۔
اب وہ ایسا کرنے گئے ہی کیوں؟
آج اپنے کتے کو ویٹ کے پاس لے جاتے ہوئے میں بہت گھبرایا ہوا تھا۔
میرا اپنے بھائی سے جھگڑا ہو گیا۔
میں ہمیشہ وہاں جانا چاہتا تھا۔
میں کام سے گھر آیا تو کتے نے فرش پر پوٹی کر رکھی تھی۔
میں اپنے پرانے اسنیپ چیٹس میں اپنے بیٹے کی ویڈیوز دیکھ رہا تھا۔
مجھے مزید کوشش کرنا ہوگی۔
مجھے لگا کہ کوئی میرے گھر میں گھس رہا ہے۔
وہاں میرے کچھ کزن رہتے ہیں، اس لیے ان سے بھی مل کر مزہ آئے گا۔
میں نے آٹو پائلٹ فنکشن پر بہت بھروسا کیا ہے۔
کیا تمہیں کام سے باہر رہنا پڑ رہا ہے؟
ہاں، وہ بہت اچھا احساس تھا۔
کیا تم نے اس کی پڑھائی میں مدد کی؟
یہ اُس کا پانچواں جرم تھا۔
دن میں کتوں کے بھونکنے سے میں نمٹ سکتا ہوں، لیکن رات کو یہ بالکل اچھا نہیں لگتا۔
مجھے فزکس زیادہ پسند ہے، اسی لیے میں انجینئرنگ میں ہوں۔
سمندر میں ایک بہت بڑی لہر نے مجھے گرا دیا اور میری اوپر والی قمیض پھٹ کر اتر گئی۔
آج میری ملاقات ایک بے گھر شخص سے ہوئی۔
سننے میں تو یہ کرنے کے لیے مزے دار لگتا ہے۔
کیا تم بھیڑ کے وہاں پہنچنے سے پہلے بہت سویرے جا سکتے ہو؟
ان کے بارے میں کل ڈاکٹر کو دکھانے جانا ہے، امید ہے وہ مدد کے لیے مجھے کچھ دے سکیں گے۔
کیا وہاں جانا بہت لمبا سفر تھا؟
شاید تم اسے ریہیب میں داخل کرانے کی کوشش کر سکتے ہو، سنا ہے کہ ایک بار شروع کرنے کے بعد کسی کے لیے رکنا مشکل ہوتا ہے۔
وہ چیزیں جاتی دیکھ کر دکھ ہوتا ہے، لیکن کم از کم میرا مکمل نقصان نہیں ہوا۔
میں نے ابھی اولیو گارڈن میں کافی اچھا کھانا کھایا۔
میں نے اس خزاں میں لاس ویگاس جانے کے لیے ابھی ہوائی جہاز کے ٹکٹ خریدے ہیں۔
شاید نومبر میں اُس کی سالگرہ کے لیے یہ لے لوں گا۔
کاش حالات بہتر ہوتے۔
اور وہ بہت باصلاحیت ہے۔
یہ سن کر مجھے افسوس ہوا، مجھے معلوم ہے کہ وہ بہتر ہو جائے گی۔
آپ کس قسم کا جائزہ ڈھونڈ رہے ہیں؟
یہ واقعی کافی پریشان کن ہے۔
مجھے یقین ہے کہ اس سے اسے کچھ بہتر محسوس ہوا ہوگا۔
میں اپنے بوائے فرینڈ کے بغیر باہر گئی تھی، لیکن مجھے کسی کا نمبر نہیں ملا۔
جب پچھلے سال میرا کتا مر گیا تو میں بہت اداس تھا۔
جب میری بیٹی نے پہلی بار ایسا کھانا کھایا جو اس نے پہلے کبھی نہیں کھایا تھا۔
میں وہاں جا کر کھانے کے لیے بےتاب ہوں۔
فی الحال میں اتنے پیسے خرچ نہیں کرنا چاہتا۔
جب میں اسٹور میں تھا تو کسی نے اسے ٹکر مار دی۔
اگرچہ تمہیں فوراً انعام نہ ملے، لیکن کم از کم تم نے کسی کی مدد تو کی۔
اس نے حال ہی میں ایک میوزیکل کے لیے آڈیشن دیا۔
میری پسندیدہ چھٹی کرسمس ہے۔
اسٹور جے کریو تھا، اور میں نے نیا ہیئر کٹ بھی کروایا۔
میں لیبر ڈے کے لیے بالکل تیار ہوں، اب انتظار نہیں ہو رہا۔
ایک کروز کافی شاندار لگتا ہے۔
ہاں، مجھے بھی نہیں، اگرچہ حال ہی میں کچھ اچھے آئے ہیں۔
یہ کافی خیال رکھنے والی بات ہے، کیونکہ وہ بچے کے کاموں میں مصروف ہوں گے۔
او یار، امید ہے سب ٹھیک ہے اور بس درخت کی شاخ جیسی ہلکی سی پریشان کن چیز ہی ہوئی تھی۔
یہ بہت افسوسناک ہے۔ کیا تم اسے فوراً جانوروں کے ڈاکٹر کے پاس لے گئے تھے؟
کیا تم جلد ہی ایک لینے والے ہو؟
میرا مطلب ہے، میری فیس بک فیڈ اس سارے کوڑے سے بھری ہوئی ہے۔
مین ہٹن رہنے کے لیے بہت اچھی جگہ ہوگی۔
بدقسمتی سے، جیسے ہی میں نے آخری نوالہ لیا وہ اندر آ گیا۔
لیکن، مجھے اس بات پر تھوڑا برا لگا تھا۔
ہم دو مہینوں سے مالی مشکلات سے گزر رہے ہیں۔
میں کوشش کروں گا، مجھے ڈر لگ رہا ہے۔
ارے نہیں، جس شخص کی تمہیں پروا ہے اسے کسی برے انسان کے ساتھ ڈیٹ کرتے دیکھنا واقعی بہت برا لگتا ہے۔
مجھے وہ وقت بہت یاد آتا ہے۔
ان سنگِ میلوں کو ہمیشہ یاد رکھنا اچھا لگتا ہے۔
مجھے یقین ہے کہ وہ اور تم اس کے بارے میں بہت پرجوش ہو۔
میں کل چھٹی منانے جا رہا ہوں۔
اگلے ہفتے میری بلی کو موت کی نیند سلانا پڑے گا۔
کیا اس نے اس بارے میں کچھ کہا تھا؟
زندگی غیر متوقع ہے، اور سڑک پر بات یہ نہیں کہ تم کیسے گاڑی چلاتے ہو، بلکہ یہ ہے کہ دوسرے کیسے چلاتے ہیں۔
تم کام کاج کرنے جا رہے ہو یا بس آرام کرو گے؟
اچھا، گیم اکتوبر تک ریلیز نہیں ہوگی۔
یہ اس سے بہت زیادہ ہے جو اس عمر میں میرے پاس تھا۔
جب میرے والد اچانک انتقال کر گئے تو مجھے واقعی بہت تکلیف ہوئی۔
ہاں، لیکن میں موازنہ نہ کرنے کی کوشش کرتا ہوں۔
اچھا، امید ہے تم نے اس سے کچھ نہ کچھ سبق سیکھا ہوگا اور یہ دوبارہ نہیں ہوگا۔
کیا تم نے اپنے ڈاکٹر سے ملنے کا وقت لیا ہے؟
دراصل، میرا اسے رکھنے کا ارادہ ہے؛ اسے ابھی تک پتا نہیں چلا۔
جب کوئی تمہیں بتاتا ہے کہ کیا کرنا ہے تو واقعی کوفت ہوتی ہے۔
مجھے تب ہی پتا تھا کہ وہ کمپنی میرے لیے نہیں ہے۔
میں بس اپنا دل ہلکا کرنا چاہتا ہوں، ابھی سمجھ نہیں آ رہا کہ کیسا محسوس کروں۔
بات یہ تھی کہ میں اس کا بہت شکر گزار تھا اور اسکول ختم ہونے پر بھی شکر گزار تھا۔
کاش لوگ جب منصوبے بنائیں تو ان پر قائم بھی رہیں۔
اور وہ سب بہت خراب ہیں—مذاق کر رہا ہوں۔
اوہ، یہ بدقسمتی ہے۔ میرا والا ممکنہ انفیکشن کے لیے تھا۔
اس نے مجھے بتایا کہ اسے طلاق چاہیے اور میں ہمارے بیٹے کا باپ نہیں ہوں۔
میں ہولو پر اسٹیفن کنگ کی نئی سیریز دیکھ رہا ہوں۔
انہیں ہٹ کرنا کافی مشکل سمجھا جاتا ہے۔
کچھ ماہ پہلے مجھے اپنا فائنل دینا پڑا تھا۔
