کٔر، مگر کیلکولس چھُ مےٚ خٲطرٕ واریاہ مُشکل۔
تُہۍ اَکھ دۄدہِ پٲٹھۍ خوش رٲو، تُہۍ تَمہِ مٲنۍ بَنُن سِکھٲوِتھ ہٮ۪و۔
مےٚ چھُس یقین، تُہہِ چھُوٚن تِمِس پٲٹھۍ واریاہ فخر۔
مےٚ پٲٹھۍ گژھِتھ نَنگ پٲدٕر اکھ جٲیِہ تام۔
مےٚ سۭتۍ یہِ باتھ کَرِو نہٕ؟
تِم ٲسِو صاف صاف نَہ تُہٕنٛد دوست۔
مےٚ چھُس اُمید کران تُہہِ جلدی بہتر محسوس گژھِو۔
مےٚ آم معلوم زِ مےٚنٛز گرل فرینڈ چھُس کُنِس اَکِس خٲطرٕ مےٚ تٕر کٔڈمُت۔
اُمید چھُ زِ تُہہِ واپس یِوان پیٹھ کُنہِ گند نَہ آسِ صاف کرُن۔
مےٚ نَہ چھُس سَمَجٕھان اَتھ دُنیاہِ کِیاہ گژھان چھُ؛ باسان چھُ زِ حالٕتھ چھِ دۄہ بہٕ دۄہ خراب گژھان۔
اَسِو تہٕ لگ بَگ ہر رٲژ سٹیک کھاون خٲطرٕ باہر گژھان۔
آ، مےٚ چھُس واریاہ شُکرگُزار۔
مےٚ کَرٕن لازِم اِقرار، سُہ چھُ سچُی ہُنٛرمٕن کھٲلۍ۔
مےٚ چھُس یاد کران کرسمس پٲٹھۍ تحفہ کھولُن۔
ہای، مےٚ چھُس گژھِتھ اَز اَکھ واریاہ اَہم اِمتِحان۔
مےٚ چھُس فقت پنُن کالج ڈگری مُکمَل کران۔
مےٚ چھُس یاد، مےٚنٛز زنٛہِ کٔژھ زِ یِلہِ سٕہ ٲسِو اَسِو دۄنٛو بچٕن سۭتۍ حامِل...
تَمہِ مےٚ چھُس گژھان پٲٹھۍ تیار روزُن۔
آج مےٚ کٔڈ کَمَہِ پٲٹھۍ کینٛہہ کاپی پیپر تہٕ پَکڑ گٔیو۔
مےٚ چھُس واریاہ معذرت خواہ، مےٚ ہٕنٛز تہِ یِمِس قٕسمِچ مُشکل گژھِتھ۔
تُہٕنٛدِس ژٕھنٛگِس منز گاز آسِتھ جاگُن چھُ بدترین حِصہٕ۔
مےٚ چھُس اَندٕزٕ کَران زِ گژھِ کلُس دۄہ واریاہ لمبا، تہٕ سُہ چھُ مےٚ پریشان کَران۔
مےٚ ٲس پنٛنِس کُنبہٕس منز یہ کَرن وٲلۍ پہلۍ انسان
مےٚ پانٛنِس متعلق خوش ٲس
مےٚ ہٕنٛز دانٛت ہلِتھ چھُ تٕہ مےٚ لگٕ چھُ یہِ ڈِگِتھ گژھان
سُہ چھُ ضروٗر سُپَر ہیرو، مےٚ ہُند مدد کرنٕچ پیشکش کٔرِتھ ٲس، ہاہا
کیا چھُ سُہ یہِ ؤرۍ سکولَس منز
تہٕ کٔتیو چھُو
کاش مےٚ ٲسِتھ
مےٚ چھُس نِہ پَتہٕ یہِ چھُ اکھ سُہ سوال
سُہ چھُ سٲری دۄہ صفٲی کران کَڈُن
آ، توہہِ چھِو صاف صاف پَرِتھ لِکھِتھ
یِمی دۄہ مےٚ انٹرویو دِنِس گٔیوس، مےٚ ٲس بےچَینی
مےٚ چھُس اُمید کَران زِ تِم تِہٕ پَکڑِتھ لَگَن
مےٚ چھُس یہِ آمُتھ محسوس کَران کیازِ مےٚ ہُند بیٚیِہِ چھُ کینہہ مہینن پیٚٹھ آوان
پتہٕ لَگ زِ مےٚ ہُند سَبَہِ کھوتہٕ نِزٕدیکی دوست چھُس مےٚ ہُند کرش پَسانٛد کَران
بیری چھُ بَہٕ ذائقہٕ دار لَگٕنۍ
آسہِ لَگِتھ ۴ ؤرۍ
سَبَہِ کھوتہٕ اہم چھُ یہِ زِ توہہِ بس وُٹھِتھ چلِتھ رٲژِو
آ، تٕہ مےٚ چھُس رَنٛگن ہٕنٛز بدلاو تہٕ ٹھنٛڈِی ہواہٕن ہُند اِنتظار کَران
نٔوِس اِنتظامس ہیٚٹھ پٲٹھۍ ٹیم میٹنگس پتہٕ مےٚ ٲس پٲٹھۍ پَتہٕ زِ مےٚ ہیکہٕ پنٛنِس ٹیمس پٮ۪ٹھ بھروسہٕ کٔرتھ
آ، کھیل چھِ اکھ بَہٕ ترٛٛٲوِتھ زِ سماجس منز میل جول تہٕ صحت ٹھیٖک تھاوِتھ
عام اِنسان سٕتۍ نوکری حٲصل کٔرتھ کٲمَس گژھنہٕ خٲطرٕ
اوہ، مےٚ نَہ آس خبر زِ یہِ واقٕعی گژھان اوس
یِم نوکری خٲطرٕ مےٚ اِنٹرویو دِتھ اوس، سُہ نَہ مِلنہٕ پؠٹھ مےٚ مایوسی گٔے
آ، سُہ اوس بَڈٕ خراب تَجرُبہٕ
مےٚ چھُ لُگ بَگ ۶۰ ؤرۍ گژھُن
مےٚ اُمید چھُ زِ یاد کَرنہٕ سٕتۍ سٲری یادٕ ہٕنٛدۍ بٔری یادٕ آسِہ
تُہۍ یہِ کِنہہ کٔرِتھ
کینہہ لوکھن چھُ پتہٕ زِ تِم ہؠکِن بیتر کٔرتھ، تِمۍ شاید جاے جاے ژھانٛڑان
تِمِس نقصان پؠٹھ مےٚ اوس بَڈٕ دُکھ
بِلکُل، یہِ مےٚ کٔرِتھ چھُ کینہہ تصوٗیرٕ دِژھنہٕ خٲطرٕ وٕنۍ گژھنہٕ دِل کَران
کیا تُہۍ تِمن پالن پوش کَران یا چھِ تِم کِٹن آسِن تٔمۍ نِش
مےٚ چھُس نَہ ڈاکٹر، مگر یِم آواز چھِ زِ شاید تُہۍ گژھِو ہٕنٛز زیٛادٕ ضروٗرت توازن تھاونہٕ خٲطرٕ
مےٚ اوس غلط رٲستہٕ نِتھ ایک ورکرَن، یُس مےٚ کٲم کَمزور کٔرُن چاہان اوس
مےٚ اُمید چھُ زِ تُہۍ ڈاکٹرَس سٕتۍ گژھِو
مےٚ تِہ نَہ کینہہ کھٲد
شُکریہ، مےٚ کَرٕ یہِ کٲم
اوہ، تَمہ مےٚ سٕمجھان اوس زِ مےٚ چھُس زِیوس سٕنٛد برابر
سچ پوٗچھو، آواز چھِ زِ دۄہ اوس کمالُک
اَسہِ شہرَس چھُ ضرورت اکھ کوریَن ریسٹورَنٛٹ، اگر یِتہِ اکھ کُھلِ تہٕ مےٚ گژھِ بَڈٕ خوٗشی
کیا تُہۍ سُہ کُچلِتھ ہؠکِو
تُہۍ ٹھیٖک گژھِو نا؟
مےٚ یہِ کٔریٖدٕنۍ خٲطرٕ واریاہ جوش چھُ۔
مےٚ برٛونٛہہ اَچانک مےٚ خٲطرٕ اکھ ایکسباکس انٛد۔
یہِ تھوڑا بوٚن ڈرٕاوٕن لگِتھ۔
مےٚ چھُ واریاہ بختہٕ ورٕ زِ مےٚ چھُ اَسہِ جاینٛسُک یِمِس ساتھی۔
مےٚ چھُ لگٕنۍ زِ یہِ چھُ تِمِس وجہہ زِ سُہ چھُ واریاہ بٔڑِ پوسٹِس پیٹھ۔
یہِ چھُ تُہٕنٛدِس شُرِکُن ہٕنٛدِس واریاہ خراب۔
تُہۍ کِیا تِم کٔڈمُتھ یا دِوان چھِو تِمِس اکھ واریاہ موقعہ؟
یہِ چھُ فَقَط لوٗکَن ہٕنٛزِ نزدیٖک روزُن۔
مےٚ گوٚو صوفہٕ پیٚٹھ بیٚٹھِتھ اکھ بیٖر پیٖون۔
یہِ آخٕر دٔپان زِ یہِ چھُ دٔیر سُہ پٲٹھۍ گژھنُک جنٛم دِۄسُک تحفہٕ۔
مےٚ چھُ سٲریوٕن پٲٹھۍ پنٛنٮ۪ن طٲلب علمن ہٕنٛز خٲطرٕ خیال تھاوان؛ اگر تِمَن چھُ مُشکل گژھان، مےٚ چھُ دِوان تِمَن اُتھ وقت یُتھ وقت تِمَن سمجھنہٕ خٲطرٕ ضرورت چھِ۔
مےٚ دوستن مےٚ کٔڈمُتھ تہٕ مےٚ لٔگ ذِ مےٚ چھُ واریاہ اکیلا۔
کِیا یہِ چھُ گرمیٖن ہٕنٛز فلو؟
مےٚ چھُ نہٕ ہٲوِتھ تِمِس وُچھنہٕ خٲطرٕ۔
فَقَط کَنِہہ وُہرس تھٲو۔
تہٕ کِیا چھُ یہِ وُنۍ کام کران؟
تہٕ تُہۍ چھِو تِتھ کِیا کٔرِتھ ہٲوان؟
تِمَن ہٕنٛز سالگرٕہِچ کیک مےٚ کٔڈِن سٲتۍ اٛنٛدر انان وِز گٔر۔
مےٚ چھُ آس زِ سُہ گژھِ پوٹی ٹرٛین۔
تٔمۍ ترٛقی تھوٚڑی سُست ٲس، یِمنہِ خٲطرٕ أسۍ حیران گژھۍ زِ سُہ واقٔعی ہیک سال پؠٹھٕ گریجویٹ گٔیو۔
مےٚ جھیلَس گژھن اوس بہت پسند، یِتھ پٮ۪ٹھ ٲسۍ آرام محسوس کران۔
گَژھِت ہفتہِ مےٚ سکولَس منز پاد کٔر۔
یہ خبر میٚنہٕ بہت پریشان کران۔
جوابَس منز مےٚ تِمِس پول نُوڈل سۭتۍ مار۔
شاید أسۍ جلدٕ تِمِس مارُن پَڑِ۔
یِتھ ہفتہِ میٚ پٲٹھۍ اکھ پارسل۔
آ، سُہ واقٔعی بہت گندٕ ٲس۔
میٚ پَتہٕ لَگ زِ میٛٲنۍ دوست یِم داغَس پٮ۪ٹھ سۭتۍ ژٕیادٕ فکرمند ٲس، سُہ شاید کینسر نَہ۔
سُہ کیٛاہ ٲس یُس ضرور زٕیادٕ وٲل ہُند ٲس؟
واہ، دیرۍ سۭتۍ جنم دِن مبارک! پٲٹھۍ موج کر۔
خوشگوار یادٕ پؠٹھ غور کرنس منز وقت دِن ہمیشہ سُہل چھُ۔
تُہۍ تِمنہِ خٲطرٕ مُشکلِس منز نَہ پٲٹھۍ، ہا؟
اَتھۍ تُہۍ پنٕنۍ انتخاب ژٕلی ہیکِو۔
میٚ شُکر چھُ زِ میٛٲنۍ پٲٹھۍ زٕیادٕ کٲم چھُ۔
یہ چھُ اکھ زٕیادٕ خراب سروس۔
آ، یہ چھُ زٕیادٕ مزٕدار، مگر یِمنہِ خٲطرٕ وقت ژٕلی چھُ زٕیادٕ مُشکل۔
گٔژھِت روز میٛٲنۍ گَرِ نزدیٖک کُنہِ گولۍ لٲگۍ۔
مےٚ آس چھُ زِ تُہۍ سہی چھِو۔
تُہۍ کُنہِ دوستَس پنٕنۍ سۭتۍ یِنہِ خٲطرٕ دعوت کیازِ نَہ دِیِو؟
تہٕ لَگۍ یہِ چھُ اَکھ کھِلُن۔
تَمہِ مےٚ تَمہِ خٲطرٕ اَکھ اَن پیٚٹھہٕ تحفہٕ کِرِد۔
اوہ مےٚ، سُہ ضروٗر گژھِ تام ڈرٕنۍ۔
مےٚ پَنُن پُرانٕ نِنٹینڈو پَننٕ والدینن ہُند گَرِ لَبھ۔
سُہ صِرف اَکھ دُکُھچ وقتُس۔
سُہ اوس بدترین چیز یوس مےٚ کِنہِ وُچھ۔
مےٚ آس چھِ تُہۍ اَکھ بَہتر نوکری مِلِتھ۔
اَکھ دۄہ مےٚ وُچھ اَکھ نَگ پھُل لَگاونٕ خٲطرٕ گٲڈ کھودان۔
یَتھ پٲٹھۍ مےٚ پَنُن وَقتٕچ محبت وُچھ، تَتھ پٲٹھۍ مےٚ چھُ ڈَلاس کاؤبویزس سۭتۍ وفادار۔
اَکھ دۄہ مےٚ سکول کُن پیٚٹھ گژھ۔
یِم ہفتہٕ آخرِ مےٚ ہٕنٛز ماج کران چھِ دوبارٕ وِوہ۔
تہٕ اوسُس پَنُن ہَمیشہٕ ساتھی۔
آ، یہِ چھُ سُہِ یِم لُکھ فِٹ گژھن۔
بےٚ مےٚ تہٕ مےٚ ہُند گرل فرینڈ اوسو اَکھ دۄہ خٲطرٕ بَہتر، مگر تِمِس نَہ اوسُس یہِ دِژان۔
یہِ چھُ پَکّا زِ مےٚ چھُ اَکھ بَہت خۄش ماں۔
پَرزُ مےٚ اَکھ ٹیسٹ دِت تہٕ مےٚ سۭتۍ لَگِو زِ مےٚ اوسُس سٲری بَہتر کٔر۔
مےٚ اوسُس سُہ گاڑِ بَہت پسند، یوس مےٚ سۭتۍ بَہت کیٚنہِ سٲتھ دِژ۔
مےٚ چھُس سُمرٕس منز ہَمیشہٕ اَکیلا۔
مےٚ چھُس نَہ واقف زِ یہِ نُقصان کَتھ پٲٹھۍ سَنبٲلُن۔
مےٚ چھُس نَہ سۄبُر کَرِتھ گژھان اَگلی پے ڈے خٲطرٕ۔
تُہۍ کُنہِ جایہِ گژھان چھِو یا صرف گَرِ آرام سۭتۍ وقت گژھاوٕ؟
مےٚ دوستن میٚ کٔہ کہِ تَتھ کُنہِ تہِ مزٕ نَہ آس۔
بہٕ ژٕٹھ ٹریفک اوس۔
مگر سُہ پوٹی استعمال کرنس نَہ مانان۔
کرسمس وقتہٕ پیٹھ چھِ اسہِ مےٚ والدین نَہ دِژمتۍ۔
مےٚ صحت مند کھاون کھاون آس، مگر گژھِ راتھ مےٚ واریاہ کوکیز کھٲتھ۔
مگر سُہ واریاہ خراب نَہ اوس۔
مےٚ چھُ یقین زِ یہِ جلد شروع گژھِ۔
تَتھ ہٕنٛد پورٕ پورٕ فایدٕ ژٕٹنس باقی چھِ کینہہ وقت، نہ؟
مےٚ کُنہِ چیٖزہِ سۭتۍ سانپہٕ پیٹھ زِیادٕ ڈر نَہ لگا۔
تُہۍ ہُنٛد نقصان چھُ۔ مےٚ چھُ خوش زِ تُہۍ نَہ گژھِو واریاہ پریشان تِمۍ رد کرنس متعلق۔
عام طور، یِتھ پٲٹھۍ تُہۍ حقدار چھِو، تَتھ پیٹھ زِیادٕ یا کم مِلُن چھُ بے توازنی۔
مےٚ دوست چھُ کَتھ کَتھ وار واریاہ خود غرض گژھان۔
کیا سُہ وزن کم کرنُک پلان کران؟
مےٚ کینٛہہ دوستن سۭتۍ سفر کٔر، مگر گَرِ واپس آمتھ مےٚ نَہ اوس واریاہ ہُند محسوس۔
مےٚ چھُ نوکری، مگر تنخواہ چھِ ناکافی۔
یہِ چھُ واقعی تُہۍ زندگی ہٕنٛد قدر کرنس مجبور کران۔
تُہۍ کانٛہہ کیازِ نَہ ووٚنِو؟
مےٚ چھُ ژٕٹھان کینٛہہ یُس گیس کم خرچ کرِ تہِ مناسب قیمتس مِلِ۔
مےٚ چھُ لگ بھگ ۱ میل کران۔
تہٕ یِہ چھِ انتظار کرنہٕ لایق چیز
کم از کم تُہۍ کَرم صحیح کٔرِتھ تہٕ خود نَہ کٔرِتھ بچس پٮ۪ٹھ چیخ
سُہ پانٛژھ میلین ڈالر ہُند تحقیقٕچ منصوبہٕ اوس
کِس قِسمچ یادٕن آو فیرِ اُبھرنہٕ
بہٕ پنٛنِس پُترس سٕتۍ تَتھ گژھِتھ ہٮ۪کہٕ
کم از کم تُہۍ چھِو کینہہ گژھٕ یادٕن تَمہِ سٕتۍ
بہٕ چھُس سُہ دۅدھُن ہنٛز سوچان
مےٚ نَہ اوس پتاہ سُہ ژٕ اَتھ گۄڈ اوس
اَچھا، یِہ چھِ مےٚ دۄیمہِ وِوٕہ
اوہ واہ، سُہ گوٚو تُہۍ دۄنٛوَن خٲطرٕ واریاہ پَریشان کُن تجربہٕ
مےٚ یارڈس منٛز چھُ اَکھ واریاہ بٔڈ بھرِتھ بَنان آمُت ریچھ
مےٚ چھُس یقین نَہ یِوان زِ مےٚ ہُند پٔتمِس چھُ بچس ہُند خرچ دِوان
ہای، گژِ کَل مےٚ زَنٛنِس نٕہِ پٮ۪رٛاگٛلایڈِنٛگ کٔرِتھ نِتھ
یِہ چھِ واریاہ پیارِ بچہٕ
یِہ اوس تھوڑ تھوڑ کٔرِتھ کم تیٖران، تَتھ خٲطرٕ نَہ اوس سُہ بلکل اچانک
بہٕ چھُس ٹرٛیول ایجنٛٹ، فلایٹس ہُند ریٹ چھُ گھنٹہٕ گھنٹہٕ بدلِتھ، نٛظر تھاو، شایِد فیر کم گژھِ
یَتھ گانٕہ ریڈیو پٮ۪ٹھ شنوٚں چھُس، تَتھ مےٚ یاد یِوان یَتھ بہٕ ژٕ کُر اوس
ہا ہا، شایِد چھِ فائدٕ تہٕ نقصان دۄنٛوے
مےٚ اوس اصلن ژٕلہِ انعام تہٕ لوگوں ہُند پسند انعام جیتھمُت
مےٚ چھِ امید تُہۍ سٕنٛز خاندان تہٕ باقی دوستن ہُنٛد کینٛہہ سہارا مِلان
آ، تِمۍ مےٚ نمبر پوچھ۔
مےٚ کَسَمَس بیٚہِ اَکھ اِنٹرویو اوس۔
وُنِ حالَتھ سٲری کینٛہہ ٹھیک چَلان۔
کیاہ تِم ڈِپریشن خٲطر یہِ کَران چھِ یا کیاہ؟
ہَفتہ وار مےٚ گَرُک اَیِر کنڈِشنَر خراب گٔے۔
مےٚ چھِ لگَان یہِ صاف چھِ، مگر کیاہ سُہ گورا چھُ؟
مےٚ چھُس یہِ سٲری ہفتہٕ پنٕنۍ میتھ فاینل خٲطرٕ پَران۔
یہِ سٲری کٲم بے منصوبہ اوس، تہٕ تِمِس دِتھ مےٚ کَتھ صدمہٕ لَگ۔
واہ، یہِ کٔرتھ تُہۍ پنُن زٕوٚن پیسہٕ بچٲو۔
مگر مےٚ چھِ اَکھ سُہنٛد سٮ۪نٛڈوِچ پَسند۔
مےٚ چھِ وُنِ تہِ یقین زِ سُہ مےٚ فخر محسوس کرٲوِتھ ہٮ۪کان۔
تِم چھِ واقعی تُہۍ مضبوط تر بناوان، چھِ نہ؟
مگر اِنٛسٹرکٹر اوس اَتھ پٲٹھۍ پُرسُکون تہٕ پَنُن یقین اوس زِ مےٚ لَگ زِ کینہہ تہِ غلط نَہ گژھِ۔
آ، وُن مےٚ چھِ بُرٕ لَگَان؛ مےٚ کَرِ تِمِس فون تہٕ مٲفِی وُچھان۔
شُکر چھُ، اَس نَہ ٲس۔
شاید تُہۍ وُنِ پَسان تَتھ نَہ وَچھیو۔
تِم چھِ بٔگٕر کٲم کَران تہٕ اَس چھِ مٲٹِس منز مَزٕ کَران۔
مےٚ چھُس کینہہ مالی مُشکِلاتن ہٕنٛدۍ منز گژھان، مگر مےٚ کُٹم چھُ مےٚ سٕتۍ کھڑِتھ۔
لَگَان چھُ یِوان زِ تِمۍ گژھِوٚن گژھِوٚن پَچھِم ہفتہٕ کِنٛڈرگارٹن شُروع کٔرِتھ۔
یِتھ کٕمَس منز تُہۍ واریاہ وٲری چھِو، تَتھ کانہہ گَڑبَڑ گژھِ تہٕ واریاہ بُرا لگِ۔
مےٚ ڈایٹ کَران چھُس اکھ وَرۍ گژھان۔
ہاں، مےٚ سٕنٛز تہِ کَتھ کَتھ أسۍ چھِ تِم یِم۔
مےٚ چھِ حقیقتن کُکی کھٲنس منز لتھ، تہٕ مےٚ چھُ مدد گژھُن۔
کیا تُہۍ چھِو سَمانان یِم ہٕنٛدِ یہِ سَنبٲلِتھ؟
پَتہٕ مےٚ آو کَژھُن زِ تِم واریاہ نِہ چھِ نٛہٕ۔
ہاں، تُہۍ چھِو پَزِ کَتھ کَتھ پٲٹھۍ اکھ بریک گژھُن۔
کاش مےٚ ڈوین جانسن أسٕس!
مےٚ کٔر کوشِش زِ مےٚ مِلہِ کَنسرٹ ٹِکٕٹ یِم مےٚ چھِ پسندیدہ بٮ۪نٛڈ دِدِکُن۔
مےٚ سٲنس گژھان دِتھ سُہ واریاہ خۄش گژھ۔
اوہ ٹھیک چھُ، خۄدایہ، تِمِس حوصلہٕ دِیو۔
یِلہٕ مےٚ ہٕنٛد دوست مےٚ بغیر گٔے بٲہر تہٕ مےٚ نِہ دِتھ دعوت۔
مونٹریال شَہَرِ کٔر ڈاؤن ٹاؤن عَلاقَس منز واریاہ بَڈ تعمیراتی کٲم۔
نَہ، مےٚ ہٕنٛد کُٹم چھُ واریاہ لۄکُٹ۔
پَتہٕ کَرنٛہہ دِہ سَودان رٔو تہٕ فون سٕنٛز تھٲوِو، یِلہِ کٲنٛہہ ضٔروٗرت پَزِ۔
نَہ، مےٚ چھُس یِتھ منز واقیَعَتھ بُری۔
یِلہٕ مےٚ ہٕنٛز گرٛل فرٛینڈ مےٚ چھٔڈِ گٔے، مےٚ ہٕنٛز دِل ٹوٗٹ، تہٕ اَز چھُس مےٚ واریاہ اکیلا۔
سُہ چھِ پَنٛژَہ وَرۍ عُمرِ تھٕے کٲم کَران تہٕ پیسہٕ ژٕٹہٕ کَران۔
یَتھ کٲنٛہہ تہِ گژھِ، مےٚ چھُس تِمِس خۄش۔
عمارتُک تقریبن اکھ چۄتھ حصّہٕ تباہ گژھ۔
مےٚ پنٛنؠ زنہِ خٲطرٕ کھٲنٛہ پَزٕ، کیازِ مےٚ سُہ پریم کَران چھُس۔
مےٚ پنُن تحقیق کٔرمت تہٕ مےٚ چھُس تیار اکھ بہترین ٹیم ہُنٛد خاکہ بناونٕے۔
بہٕتر، کیازِ یہِ سیکھنٕے خٲطرٕ واریاہ وقت لَگ۔
مےٚ سٲنسوٕم ژِ مےٚ کھٲنہٕ گژھِ۔
شاید اگلی بار سُہِ یہِ کم کرنٕے خٲطرٕ وُچھِو۔
اچھا، اگر تُہٕنٛز شادی بچِتھ، تَ امید چھُس کَران ژِ حال دَپان بہتر آسِ۔
مےٚ چھُس پنٛنؠ سٲری پٲٹھۍ مایوس۔
یہِ واریاہ خراب آسِ ژِ تُہٕ کُن یِم طریقٕ سٲتھ سبق سیکھُن پَزِ۔
یَتھ مےٚ روزان چھُس تَتھ جُرمَن ہُنٛد شرح بَڑان چھُ، سُہ سوچُن چھُ ہولناک۔
یِہِ سُڻِتھ مےٚ افسوس ژِ تُہٕ تِمِس پٲٹھۍ محسوس کَران آسِو۔
یِم سۭتۍ یہِ چھُ واریاہ خاص بَنان۔
مےٚ چھُس سٲری ویزِ یِمِس پٲٹھۍ چال سیکھنٕے خٲطرٕ خواہشمند۔
آج مےٚ تیز گژھان خٲطرٕ روکُن پَز، تہٕ پولیس وَلے سُہ وارنِگ دِتھ چھوڑ۔
مےٚ چھُس سٲری پٲٹھۍ خوش یَتھ مےٚ روزان چھُس۔
کُنِہِ آخری انرجی ڈرنک پیوٕمُت۔
مےٚ کٔر یہِ پنٛنؠ نوٚن بِلّی سۭتۍ تہٕ آخرکار یہِ ٹھیک کَم کٔر۔
مےٚ میٚلِتھ پنٛنؠ بچپنٕچ واریاہ دوست۔
مبارک! سُہ ضرور تیز گژھان آسِ، مےٚ چھُس سٲری ویزِ گروپ ہُنٛد پٲٹھۍ پٲٹھۍ گژھان۔
یہِ چھُ سُہنٛد، تِمِس پٲٹھۍ کھیلنٕے خٲطرٕ نوٚن جاے مِلن چھُ ہمیشہ سُہنٛد۔
مےٚ گژھِ حیران ژِ یہِ کِتھ پٲٹھۍ سُہنٛد آسِ۔
یہِ ملِ جلِ اشارن ہُند ایپ چھُ۔
تِم ضروٗر کافی گژھِ آسَن۔
مےٚ چھُس تیار زِ میون بھانجہ یِہ ویک اینڈ پیٹھ۔
میون نانی گٔے مہینے فوت گٔے تہٕ وُنیو چھِ أس تِمَن ہُنٛد سامان چھانٹان۔
مگر چھُس مےٚ ارٕز کران زِ دۄیمِس سکولس منز داخلہ ہاوٕ اگلے ورٕس خٲطرٕ۔
تُہۍ گٔیو کینہِ تِم تُہند خٲطرٕ وٲرِتھ؟
اوہ، کِتھ بُرا درد چھُ کٲٹھ کرُن۔
تیٚتی چھِ تُہۍ اصل سستہ سودا لَبان۔
یِم بڑے میچس خٲطرٕ أس کٔرٕ تیٲری، سُہ أس جیت۔
کیا تِم گٔے ورٕس ہُنٛد چیزن منز گژھِ وٕد؟
مےٚ چھُس سوچان زِ یُس وٕدِ گژھِ تَمہِ دِکھاوم یہِ۔
گِراہک چھُ ہمیشہ سہی۔
مےٚ چھُس حالیہ منز جانان زِ میون ۱۵ ورین ہنٛز زن چھِ مےٚ دھوکا دِوان۔
مےٚ چھُس ظٲہر چھُ نہٕ تِم وٕنٛزھان، مگر مےٚ لیٚگِ تہِ چھُ سُہ بہانہ أسُن۔
میون بٔینۍ ہِنٛدِس سبب چھُس مےٚ اکثر چِڑان۔
مےٚ چھُس وُنٛیٖ یِلہِ اکھ ژور کٹھ امتحان ختم کٔرِتھ تہٕ چھُس تَمہِ سٕتۍ خوش۔
گٔے کِنہہ دۄہ اکیٛلا گَر وٲتھ مےٚ گٔے ڈر۔
یہِ خاص پٲٹھۍ کٹھ تھٲو، کیٛازِ زِ تِمِس نہٕ ٲس بایکس پیٚٹھ خاص فِکر۔
میون مطلب چھُ زِ گۄڈٕ دۄہ کٲم چھُ مےٚ خٲطرٕ تیٚتھ وٲتھان۔
کاش أس ساروٕی اکھٹھِ مِل جُل رٔہتھ۔
کم اَز کم تُہۍ سٕکایپ پٮ۪ٹھ گژھِ ہیکِو تہٕ رابطس منز رٔہِتھ ہیکِو۔
بہٕ چھُس تَمہِ خٲطرٕ واریاہ شُکرگُزار۔
کُنہِ کُنہِ وار یہِ چھُ سِکھنُک سبَتھ کھۄتہٕ بہتر طریقہٕ۔
ماضی منز کیاہ گٔیہِ جِہ تُہۍ اَتھ پٲٹھۍ ہَچکِو؟
بہٕ چھُس تیار تَمہِ زنہِ ہٕنٛدۍ والِدَین ہٕنٛدۍ یہِ وُنُن زِ بہٕ چھُس تِمَن کَتھ پٲٹھۍ پیار کران۔
اَکھ وار خٲطرٕ سہی، یہِ کَرنُک قٲبِل آسُن سُہتر چھُ۔
مےٚ چھُس سمجان زِ تِم چھِ اَز تہِ۔
یِلہِ سُہ گژھِ نہٕ، تُہۍ نہٕ ہٮ۪کِو سَمجھِتھ زِ کَتھ پٲٹھۍ سُہ سُہتر آس۔
مےٚ دوست چھِ اَکھ اَکیلی ماجہ، سُہ چھِ پورٕ وقت کام کران تہٕ پورٕ وقت سکوٗل گژھان۔
یِلہِ بہٕ آسُس لۄٚکُٹ، مےٚ آسِ پٮ۪ٹھ پی بی ایس چینل بٔڈ شوق۔
اِرٲدٕ شَکت تہٕ صحت مند بَنٛنُک مضبوط خواہش۔
بہٕ چھُس اَکھ نَہٕ سُہتر محلہٕس منز رَہان۔
A چھِ اَکھ واریاہ سُہتر گریڈ۔
مگر کرایہٕ سستا آس تہٕ أسۍ کٔم جاے ضرورت آس۔
کیا تُہۍ گۄڈٕے پتہٕ کٔڈِو زِ بچہٕ چھُ لُکُٹ یا لُکُٹۍ؟
