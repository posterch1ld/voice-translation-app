تُہۍ مینٹیننس کرٕناوان چھِو۔
خیر، کم از کم یہِ آسانی سان ٹھیک کرن وٲلۍ لگنہ چھِ۔
مۄژ سٲری دوستن ہُند چھُ کانٛہہ نہ کانٛہہ یُس تِمن مُحبّت کران چھُ۔
شاید تِمَن سۭتۍ مقابلہ نہ کرُنٕچ چھُ بہتر۔
یہِ چھُ سچ، مگر قایل کرنہٕ خٲطرٕ بہت محنت کرٕنۍ پٔی۔
آ، مگر بچپنہِ منز اسۍ سٲری یِمِچ غلطی کران چھِو؛ تِمَن پٮ۪ٹھ تُہۍ سمجھدار گژھِو، یہِ چھُ سُہ۔
مےٚ اوس مٕژ بٲیِس ہُند ساتھی سۭتۍ ناجایز تعلق۔
مےٚ اوس تِم دوستس پٮ۪ٹھ یقین کَران یُس سٲری وٲر مےٚ سۭتۍ ژوٚٹ ونان اوس۔
اصل منز تِمِس نَہ اوس پٲٹھ چھوٚڑُن ضروٗری، مگر مےٚ بغٲر وُچھنہٕ نَہ اوس تِمِس پَزَند۔
تُہۍ دوٚن کَتھ کٲل پٲٹھۍ چھِو اکھٕٹھ؟
مٕژ لالچی بچن ہُند اکھ چھُ یہِ مےٚ کٔڈان چور کران۔
وقت کٹھن ٲسِ تہٕ پیسَن ہُند تنگی ٲسِ، مگر مےٚ چھُ سٲری وٲر چرچس پنُن دسواں حِصہٕ دِن یاد۔
مگر تٔم نَہ جواب دِت۔
نَہ، گرجٕچ پھلۍ آواز آوَانٕچ سۭتۍ چھُ سُہ بیسمٮ۪نٹَس منز گژھان تہٕ گول گول کٔڈان چھُ بَسان۔
مےٚ چھُ آس یِم چھِ سہی طریقہٕ گژھان۔
او واہ، سُہ ضرور سُہاون اوس۔
پالِتُ جانور گم کرُن چھُ واریاہ کٹھن۔
تُہۍ کُس چیزِس متعلق لیٖکھان چھِو؟
کیا تِم چھِ تُہۍ نوستالجک محسوس کرٕناوان؟
یہِ چھُ مٕژ سُہ پسندیدہ، آخری سیزن گژھِ مِٹھ تہٕ کَڑُ۔
شُکریہ، بہٕ اَکھ کُتُر پٲٹھ لٲنٕچ سوچان چھُس۔
مگر یُس پیٚٹھ آسٕہ توقع، تِمَن پٲٹھ زِیادٕ وقت لَگ۔
تِمَن خٲطرٕ چھُ واقٔی مدد تہٕ سہارو ضروٗری۔
مٲر بیٚیہِ ملاقات کرنہٕ یِوان چھُ۔
مٲر کمپیوٹر گژھ خراب، تِمن دِژ مےٚ پنُن پرٛون کمپیوٹر۔
یِہ چھُ تِمَن ہُنٛد واقٔی بدتمیزی، شاید کَنہِ نہٕ تِمَن شٲستہٕ گیٚہ سکھٲومٕژ۔
کیا تُہۍ اوسط پٲٹھ چھِو کوٚتَر؟
مےٚ ٲس سُنُن زِ ڈیپ ڈِش پِزّا چھُ بےمثال۔
مےٚ چھُ مٲرِس برادَرَس کُن کینہہ رشک، مگر اَکھ نیک مطلبس منز۔
اَکھ لمبہٕ ہفتہٕ ورزش کرنہٕ پَتہٕ کینہہ نہٕ کرِتھ صِرف بَسی رہُن گژھِتھ بےحد سُہنٛد۔
تُہۍ صِرف کینہہ شارکَن سۭتۍ کشتی لڑٕنۍ چھِ، تہٕ تِم تُہۍ ریاستُک سربراہ لائف گارڈ مقرر کرن۔
مےٚ ابھی اَکھ نوکری ہُنٛد انٹرویو دِتھ تہٕ مےٚ چھُ لگُن زِ مےٚ سٕہِ کٲم کٔر۔
آ، مٲر دوستَن سٕچِ مٲر گاڑِ کٔر حادثس منز۔
مےٚ چھُس یِہ نوکری حٲصل کرنہٕ خٲطرٕ وریٚن ہنٛد کوشش کران، یِہ گژھِتھ زبردست۔
او یار، دوری ہُنٛد رشتہٕ چھُ سخت۔
گژھِتھ دۄہ مےٚ اچانک اَکھ پارسل حٲصل گژھ۔
مےٚ چھُس سٕچِ یِژھان زِ تِمَن پیسَن ہُنٛد قدر بوزھ۔
یِہ ٲس اَچانک، یِتھ پٲٹھ مےٚ چھُ نہٕ یقین۔
یِہ چھُ وونٕہ اَکھ زبردست ہوشیار فون۔
گَژھِتھ دۄہ مےٚ لگ بھگ اَکھ کار حادثہٕ گژھان آس۔
مگر کم از کم تُہۍ کٔن چھِ باقی انتخاب۔
بہٕ چھُس ہر رات تِمِس بارے سوچان تہٕ میون دِل چھُ چاہان زِ سُہ یِتھِ مےٚ سات یہِ آسِتھ۔
تہٕ مےٚ چھِ فُٹبالس مُتعلق کانہہ تہِ علم نہٕ۔
میون بیٚیہِ پارٹِس منز پٮ۪نٹ نہٕ پیٚٹھِتھ باہر دٕوڑ۔
مےٚ چھُ حقیتاً برکت والِہ زِندگی تہٕ بہٕ چھُس واریاہ خوش۔
ہاں، میٚنۍ انسٹرکٹر ماریسا چھِ واریاہ خواب نِش۔
مےٚ چھُس یقین نہٕ یِوان زِ بہٕ کِتھ پؠٹھ گٔیٚس سٲری چیزن ہٕنٛدۍ دور۔
ہاں، مےٚ چھُ اکھ فوٹو البم تہٕ یَتھ کینہہ وار بہٕ تِہ پَزٕ چھَوان، بہٕ چھُس مُسکران۔
بہٕ وُچھُس چھُٹۍ پٮ۪ٹھ گَر آمت تہٕ گَرَس منز اوس اکھ بَڈ بَدبُو۔
ہاں، سُہ اوس واریاہ زبردست۔
گژِ رات بہٕ کٔرۍ میٚنِس پنٛنِس پیسَس سٟتۍ پنُن بلکل پٲنۍ ویڈیو گیم خرٕید۔
مےٚ چھُس پنٛنٕچ ٹیلیویژن ژٔٹِتھ گُنہگار محسوس کران۔
ہاں، بہٕ چھُس پنٛنٕن بچن ساتھ تہِ تَمی کٔران۔
مےٚ چھُس لفظی طور کارن ہٕنٛزۍ مسلہٕ نَفرَت۔
آخرکار بہٕ کٔرِس تَتھ منز واریاہ سُہ۔
میون بیٚیہِ اوس پنُن بَڈ ٹریک میٹ خٲطرٕ سخت مشق کران۔
یہِ چھُ بلکل پاگل پن، تِمنہٕ چھُ نہٕ گژھِتھ کمپلیکس اَسہِ ڈسٹرب کٔرُن۔
مےٚ چھُس سونچان زِ شاید بہٕ گژھان بوڑ، کیازِ کینہہ وار چھُس مےٚ جاگنس پؠٹھ سون پسند۔
بہٕ کٔرِس اکھ ٹیسٹ منز نقل۔
مےٚ اوسُس حیران زِ مےٚ اوس نہٕ کانہہ تہِ فٔراموش کٔرمت۔
اوہ واہ، مےٚ خوش چھُ کہ سُہ خوش اوس۔ تُہۍ کیوں نَروَس اوس؟
نَہ، سُہ اوس میون یِکۍ پالتو جانور۔
مےٚ چھِ ۲۵ ؤرۍ عمرس منز یِک گَر کٔنُتھ۔
یِتھ ضرور تُہۍ ہُند یِک جُڑواں پھِران چھُ۔
ہاں، تہٕ ژِلہٕ چھُ نَزدیٖک یِوان۔
میون سکولس خٲطرٕ یِک بڑ امتحان چھُ یِوان۔
یہِ چھُ واریاہ گۄڈ پوٚینٹ۔
مےٚ پنٛنِس ساتھی کٔر اجازت کہ سُہ میٚ مدد کٔرِ یِک رازدار پروجیکٹَس منز۔
گژِوِس دۄہ مےٚ یِک مامہٕ دِتھ، یِم مےٚ واریاہ دۄہ نَہ اوس دِتھ۔
مےٚ چھُ سُہ احساس سَمجھان۔
شاید یِم دوٚیم کمپنی تُہۍ ہُند ہُنر سراہِ۔
مگر مےٚ چھُ نَہ ژٕچھان کہ روڈ ٹرِپَس گژھِتھ خطرٕ مول۔
لگِ چھُ کہ تُہۍ ہُند دٔختر شاید گۄڈ ژیادٕ باتھ کران۔
پَتہٕ ؤرۍ مےٚ اوس واریاہ خوش کہ مےٚ جاے بدلٕنۍ چھُ۔
تُہۍ کُس امتحان دِوان چھِو؟
ہاں، مےٚ ہٲوِتھ ہیکان، مگر یِتھ کٔرُن چھُ واریاہ بے آرام تہٕ دُکھی یُس مےٚ کٔرُن پَوان۔
میٚنۍ بھانٛج کٔر پنُن نوٚو بایسکل ٹریننگ وہیل نَہ لٲگِتھ چلاوُن۔
نَہ، ریل اسٹیٹ والۍ بیٚیہِ اوس ونان کہ سُہ بدھ دۄہ یِیہِ۔
تِمن ہُند عمر چھُ ۱۳ تہٕ ۱۰ ؤرۍ۔
خیر، تُہۍ ییٚلہٕ سِکھِتھ پنُن حال بہتر کٔرِتھ ہیکِو۔
دۄہسٕچ یِکسانی توڑنہٕ خٲطرٕ کانہہ نُوٗن دۄیُن ضرور سُہل گژھان۔
مےٚ گھرٕچ پۄٹھہٕ طرف وٲلۍ نالہٕ دوٚیہِ لٹہٕ لگ بھگ صحنس منز یِتھ پٲٹھۍ آیہِ چھِ۔
بس پنٕنۍ طور رٔہ، مےٚ چھُ پورٕ یقین زِ تُہۍ چھِو واریاہ سُہ کران۔
مےٚ چھُ خیال زِ اصل کُن چھُ سُہ۔
کاش مےٚ ہیکو اَتھ پیٹھ زِ زیادٕ دِتھ۔
مےٚ چھُ سٲریَن سۭتۍ لٔڑنۍ یژھان۔
مےٚ چھُ پنٕنۍ بچاوٕچ کلاس لٲنۍ ضرور۔
یہِ پےٚ زٲدٕ تہٕ عہدٕ بدلٲوُن آس۔
اگَر سُہ نہٕ ہیکِ، تَہِ سُہ کُن کَرنُک اِرٲدٕ چھِ کَران؟
مےٚ چھُ سُہ جایہِ پٲٹھۍ گژھِتھ۔
آ، مےٚ نہٕ اوس اِتھ پٲٹھۍ کینہہ اَندازٕ۔
اوہ نہ، کیا تُہۍ چھِو تِم اَز تام لَبمِتھ؟
مےٚ چھِ پانٛژھ مُختٲلِف بَچِہٕ تہٕ سٲری چھِ کھٲنۍ یژھان، مےٚ کُس کَرُن؟
مےٚ چھِ کینہہ ڈر زِ مےٚ گژھِ وُڈ، یہِ گژھِ دَہل دِوان۔
اَسۍ گژھِتھ آس ساحلس، مگر سٲری ویک اینٛڈ چھُ بارش کَران۔
یہِ چھُ منحصر زِ تِم کِتھ پَزِ چھوٹ۔
نوکریچ انٹرویو اوس واریاہ سُہ، یِتھ تجربس پتہٕ تھوڑِس زانۍ مےٚ آیہِ سُہ عہدٕ خٲطرٕ آفر۔
کیا تُہۍ چھِو لَگ بھگ یِتھِ کُن وقتس منز پنٕنۍ خٲطرٕ ٹرک خٔریدِتھ ہیکِو؟
مےٚ آیہِ ہارورڈس منز داخلہٕ، مےٚ چھُ واریاہ خوشی!
مےٚ گریٚلفرینڈ چھِ پنٕنِ دوستَن سۭتۍ دۄہ ہفتَن خٲطرٕ مُلکٕچ باہَرٕ سیرِ گژھان۔
مےٚ شرط لَگان چھُس، یِتھ پٲٹھۍ تٔمِس خبر گٔژھ، تٔمِس ہُنٛد تۄنٛد گژھ آسُن نٲبَر۔
تُہۍ کِنہِ ہُر رائِڈس ژٕتھ لَگاوُن گژھ؟
یہِ کٲم میٚون زنٛدٕگی بدلٲوِتھ، یِمِس سۭتۍ مےٚ دوبارٕ کھۄر پٲٹھۍ کھڑٕ گژھِتھ زنٛدٕگی ہٕنٛز لُطف وٕٹھِتھ۔
کیا تُہۍ نَوی نَوی چٲدَر وِکُن لَگاوُن نَہ وٕنٛدو؟
مےٚ چھُس لۄکچھُرۍ ہنٛز چھُٹۍ یاد کٔرتھ نَسٹالژِک محسوٗس کَران۔
مےٚ نہٕ چھُس جانان کِہ گژھ۔
کیا تُہۍ کٲنٛہہ وار کٲم پٲٹھۍ کٔڈ گٔیو؟
مےٚ پَنُن جۄڑیدار سۭتۍ لڑٲی کٔرتھ تہٕ یہِ بوٗزِتھ زِ اصلہٕ قصوٗر میٚون اوس، مےٚ بوٗزِتھ بٔڈ وٲری وٕنٛد لٲگ۔
تٔم کٔرن مےٚ بٔڈ نَروس۔
مےٚ چھُس پٲٹھۍ یقیٖن زِ یہِ سٲری ٹھیٖک گژھِ۔
ہاں، جشن کٔرُن خٲطرٕ گٔے راتھ أسۍ ڈِنر خٲطرٕ باہَر گٔے آو۔
کُنہِ نَہ اُمید اوسِتھ شَخص پٲٹھۍ ٹھیٖک تعاون مِلُن چھُ واقٔی خوشی ہُنٛد احساس۔
مےٚ اوس کُنہِ وار اٮ۪رپورٹٕچ باہَر بٲنٛچِ پٮ۪ٹھ پَنُن والِٹ ژٔٹ۔
مےٚ اوس پٕنٛنِس زٔنۍ ہُنٛد سکوٗلِچ سامنہٕ پوٗلِسَن روٗک مٕت۔
گٔے راتھ ییلہِ مےٚ اوس نِنٛدران، مےٚ شوٗر گۄلِی ہنٛد آواز آی۔
نَرسِنگ سکوٗلِچ مُقٲبلہٕ نَرسِنگ ہنٛز حٔقیقی دُنیا خٲطرٕ کِنہِ چیٖزِ سۭتۍ تُہۍ تَیار نَہ گژھِو۔
شایَد سُہِ کُنہِ دۄہ سکوٗل نَہ گٔے۔
ہاں، سُہِ اوس مٮ۪تھ ہُنٛد ٹٮ۪سٹ۔ مےٚ کٔر پٲٹھۍ کوٗشش تہٕ سخت محنت کٔرتھ پَر مےٚ سُہِ فیل گٔیو۔
مےٚ چھُس تُہۍ ژورِ خٲطرٕ خوٗش۔
مےٚ چھُس واقٔی یِہ سوچان زِ سُہِ سُہِ بوٗزِ۔
مےٚ امید چھُ کہ سٲری اگلے قدمس خٲطرٕ تیار چھِ، تاکہ تُہۍ مزید بہتری کٔرِتھ رَہو۔
مےٚ لَگِو یَتھ مےٚ واپس تَتھٕے گٔیوس۔
مےٚ صرف یہِ وُنُن یژھان کہ آز مٮ۪ون کُتھ مٲر گٔیو، تہٕ یہِ مےٚ خٲطرٕ بالکل تباہ کُن چھُ۔
بےٚ یُتھ کِنہِ مےٚ پنٛنِس زٲمِس خٲطرٕ نَنۍ بلی ہٕنٛد بچہٕ کٔنۍ۔
تٔمۍ یتھ کِنہِ سُہ آچھر کٔر، تَتھ سۭتۍ مےٚ حیران گٔیوس۔
مےٚ تھوڑا دوٚدھ مَنٛز چھُس کہ یہِ ہفتہٕ مےٚ رُخصت طٕلب کٔرُن گژھِ یا نہٕ۔
مےٚ مونٹریال گژھنُک موقعہٕ مِلِو۔
اوہ ہاں، بچن کینٛہہ کران چھِ تہِ دِژھنہٕ خٲطرٕ تِمِس تھوڑا بدلاوٕ گژھِ زبردست۔
مےٚ چھُس جانان کہ آز مےٚ کٲم زور دِتھ پار کٔرِتھ ہیکہٕ۔
مےٚ ہٕنٛز زٲن چھِ دوٚہ ہفتن خٲطرٕ شہرٕ بٲہر، تہٕ أسۍ ابھی یِتھ شہرَس منز منتقل گٔے۔
مےٚ تِمِس خٲطرٕ خوش چھُس، مگر مےٚ سُہ نہٕ مِلُنُک افسوس چھُ۔
حالٕے حالٕے چھُ سُہ کٲم منز سُستی کران تہٕ چیزٕ جمع نہٕ کران۔
کاش مےٚ تُہۍ سٕنٛدِرۍ نصیب دار آسِتھ۔
سُہ واریاہ خۄش آمدیدی تعجب آسِو۔
مےٚ چھُس اَز تک یاد کران کہ مےٚ تِمَن ہٕنٛدۍ ڈایپر بدلٲوِتھ۔
مےٚ پنٛنِس خۄدس وعدٕ کٔر کہ ڈایٹ ہٕنٛدۍ حصٕس پٲٹھۍ مےٚ ڈونٹ نہٕ کھٲوُن۔
مےٚ چھُس اَکھ اہم پارسلُک انتظار کران۔
یَلہِ مےٚ ڈرایونٛگ ٹیسٹ دِوُن، مےٚ واریاہ گھبراہٹ محسوس کٔر۔
مےٚ سٕنز دوستن ابھی سَستٕچ اَکھ بلکل نٔو گاڑِ کٔنۍ۔
بہٕ کَنہہ ہفتَن منز پنٛنِس بہترین دوستَس مِلُن نیو یارک گژھان چھُس۔
مےٚ تہٕ مٕہٕنٛز بہترین دوست چھِ دَہِس سالن پیٹھۍ أکِس جایہِ کَم کران۔
تُہہ چھُوٗمٕتھ یِہ پنٛنِس باس سۭتۍ ڈِسکس کرُن؟
کیا تُہہ کٔرِو پنٛنِس فون کمپنِس کٲل تہٕ پَتہٕ کٔرِو یِہ بابت تِمَن کیاہ اوس ونان؟
یِہ اپارٹمٮ۪نٛٹ اوس تصویرو سۭتۍ بالکل مُختٔلِف۔
کیا تُہہ کینٛہہ بچٲوِتھ ہٮ۪کِو؟
مےٚ چھُس پَتہٕ تُہہ کٔرِو زبردست۔
مٕہٕنۍ چھِ ونان زِ سُہ کَرِ، مگر مےٚ چھُس سَانان زِ اَکھ وَرۍ پیٹھٕ بہٕ ٹرانسفر گژھِ۔
سُہ کِس قٕسمُک لِسٹ چھُ؟
بہٕ واریاہ وَقتھ پیٹھۍ کینٛہہ نَہ اوس کٔڈمُت۔
واریاہ سالن پَتہٕ مےٚ چھُس وُنِتھ پنٛنِس کزن سۭتۍ دوبارٕ رابطہٕ کٔرمُت۔
سُہ میون سالگرٕہ دۄہ کَرِ ہر وَرۍ اَتھ رٲتھ کٲل۔
سُہ اوس نٕم تہٕ بالکل نَہ اوس دِلچَسپ۔
مٕہٕنٛز پَتہِم کینٛہہ ٹرینِنگ چَکر گژھِ واریاہ نِیٚک۔
ماتَم کَرنٕچ کینٛہہ وَقتھ لَگِ۔
اوہ ہاں، سٲری زِ تِم یِمَن ہُند واریاہ ڈِمانٛڈ اوس۔
مےٚ چھُس سَانان، یِم تُہہ خوش کَرِ تِم کُنہہ۔
مٕہٕنٛز پٕترٕ کٔل اوس پنُن پَہِل لفظ ونان۔
مےٚ چھُس نِش حالَس پَہِل بچہٕ تہٕ مٕہٕنٛز شادی شُدٕہ زندگی چھِ واریاہ نِیٚک گژھان۔
تُہہ یِہ نَہ مانو، مگر مےٚ اوس سڑکِس کَنٛٹھ پیٹھۍ اَکھ جیتھمُت سکریچ آف ٹکٹ مٕلِتھ۔
یِہِ قسمُک گژھُن بلکل عام چھُ۔
ہَفتُک منز
شاید تُہۍ باہر گژھِتھ کانہہ نَو لوٗکن سۭتۍ گژھِتھ مِلہِو۔
تُہۍ یِہ کٔرِو تو شاید سُہ تُہندس تعریف کٔرِ۔
مےٚ وُچھِتھ چھُس ٹھیٖک، مگر پَت جھڑ یِوان آمادٕ چھُس۔
کیا سُہ یِہِ کَریٖر کِنۍ طور پٲٹھۍ سوچان چھِ؟
مےٚ گژھِتھ گوٚو بار کَل راتھ، تہٕ سُبس دٔپھتھ وُچھُس زِ میٛون اَنڈَرپینٛٹ چھِ نَہ۔
پِزّا ہَٹَس کیا گژھ؟
کَل راتھ گٔیوٗس مےٚ پنٛنِس کَزِنٕچ گَرٕچ رَسوٕی منز چُپکۍ۔
سُہ چھُ نَہ یِتھ پٲٹھۍ خراب، شاید سُہ تُہندس طرفہٕ زیادٕ توجّہِ ہٕژ چھِ۔
اوہ مےٚ گۄڈ، کِتھ بٔڈ یِہ!
یِہِ چھُ اکھ واریاہ گۄڈ خیال۔
مےٚ گٔیوٗس دُکھی ییلہِ میٛون برٛونٛہہ گژھِوٗس کینسل کٔر فَٹ ہفتہ۔
مےٚ چھُس ڈیلرشِپَن پٲٹھۍ سچِ اعتبار نَہ کَران۔
مےٚ گٔیوٗس خۄش یِتھ وُچھِتھ زِ میٛون ویکَنٛڈ چھُٹی مَنٛظوٗر گٔی۔
مےٚ چھُس راضی، تِم چھِ پنٛنِس آپَن بڑا ہوشیار سمجھان، مگر چھِ نَہ۔
مےٚ حَسدس پٲٹھۍ واریاہ ژٔلِس۔
تِم چھِ عام طور جوان تہٕ لاپرواہ۔
یاد تھاوِو زِ تُہۍ پنٛنِس وس پٲٹھۍ زیادٕ قۄمتُک گَر نَہ لِوِو۔
میٛون بال چھِ واریاہ لۄکُٹ، اَسہِ چھِ نَہ اَسہِ تِہِ کَم شُروع کٔرمُت۔
مےٚ واپس سکوٗل گژھنٕچ فِکر چھُ؛ مےٚ نہٕ کَنہہ پَتہٕ زِ مےٚ یہِ کَرنٕچ ضروٗرت چھِ یا نہٕ۔
میون پِزّا یِتھ پٲٹھۍ یِوان لَگِ اِک گَنٹہٕ۔
مےٚ اُمید چھُ زِ یہِ کینٛہہ بُد نہٕ آسِتھ۔
میون تہِ اَز راتھ بُت دیر تام جاگِتھ آس۔
میون پٲٹھۍ گوٚوٕنۍ کوٗشش کَرنہٕ خٲطرٕ شایَد ۳۰ مِنَٹ یا تِتھ پٲٹھۍ لَگ۔
گژِس راتھ کٲمُک اِک پروگرامس منز اِک مَنٛژِس میون پٲٹھۍ فلَرٹ کَرنٕچ کوٗشش کٔر۔
مےٚ لَگٕنۍ چھُ زِ یِتھ معاملَس منز مدد خٲطرٕ تُہۍ ہاسٹل مٔنیجمٮ۪نٹ سٕتۍ تہِ گَژھِتھ گَژھِوٕنۍ آس۔
لُکٕٹِس شہرُک دیہی طرزِ زندگی چھُ میون مزاجس سٕتۍ زٕیادٕ میل۔
مےٚ دۄدُر کینٛہہ ژٕ چھُس نٮ۪وان زِ کینٛہہ اَسۍ پنٕنۍ آٮ۪س کریم پٮ۪ٹھ میو ڈالان۔
مےٚ چھُس بے صبر زِ کَتھ پٲٹھۍ کٲمُک کینٛہہ وقت آف ژٔھان۔
مےٚ چھُس پَک یقین زِ تُہۍ گژھِو سبنٛۍ کھۄتہٕ اُونٛچ گریڈ حٲصِل کٔرتھ۔
مےٚ نہٕ پَتہٕ زِ تِم ژھٹہٕ کران چھِ یا نِش فِکر نَہٕ کران۔
اوہ، تُہۍ تہِ جاے سٲری پنٕنۍ خٲطرٕ حٲصِل کٔرِو۔
واہ، یہِ چھُ سچُ عشق۔
اچھا، مےٚ گژھِ کُھلُن۔
تُہۍ گژھِو پنٕنۍ قٲبلیتَن پٮ۪ٹھ بُتھ اعتماد تھاوان۔
مےٚ وَنٕنۍ اوسُس، کینٛہہ اَسہِ لوٗکھ ژٕ سٕتۍ شوق مِلِتھ چھِ، تِمَن سۭتۍ واریاہ وٲلِف گژھُن۔
یِمِس خٲطرٕ تُہٕنٛدِس کَنہہ کِس قٕسمُک سنٛیک چھُ؟
مےٚ وَنٕنۍ اوسُس زِ تُہۍ تِمَن پٮ۪ٹھ بُتھ فخر کران چھِو۔
سُہ صِرف کینٛہہ چیٖز کَران چھِ گَڈمَڈ۔
تُہٕنٛدِ زِندگی منز کیاہ گژھان چھُ؟
واہ، یہِ واقعی بہت مایوس کُن چھُ۔
مےٚ اُمید چھُ کہ اکھ دۄہ تُہۍ کَنہِ حل ژھانڈِتھ دوبارٕ پَگاہ پٲٹھۍ بَنتھ۔
تُہۍ یہِ مجبوری کھٲطرٕ کَران چھِو یا تَمہِ ہُند تھرل کھٲطرٕ؟
تِم ژھانڈِتھ حٲصل کرنہٕ پٮ۪ٹھ تِم مےٚ کُن جلدی واپس دِتھ۔
مےٚ بُہت گانجا کھیٚو تہٕ مےٚ سُہ پٲٹھۍ شک شک کَران آس۔
بہٕ تہِ چیٚکھان آسٕس۔
تَمہِ سۭتۍ مےٚ واقعی دُکھی گژھِتھ۔ ٹیسٹ کِنہِ متعلق اوس؟
مےٚ چھُ اُمیدوار کہ یہِ ویک اینڈ زبردست تہٕ آرام دہٕ گژھِ۔
اَتھ پٮ۪ٹھ تِمَنٛز آزاد گژھُن چھُ نَہ۔
یِمنٛز سۭتۍ آز کٲم کَران اوس، سُہ کٲم نَہ سَمجھان اوس۔
صحت مند آسُن چھُ اکھ سُہ گژھان۔
مےٚ ہُند بۄیہِ سکالرشپ جیتھ، یِمنٛز مےٚ فیسہِ پٮ۪ٹھ پیسہٕ خرچ نَہ کَرُن پَران۔
یہِ مزٕ دار گژھِتھ چھُ۔ تُہۍ کَس سۭتۍ گژھان چھِو؟
تِمَنٛز چھُ یہِ پاگل پَن بَند کَرُن ضٔروری۔
اسہِ سۭتۍ سۄبَن ہُند آسَن چھِ یِتھ پٲٹھۍ ہفتہٕ۔
کٲم پٮ۪ٹھ پرفارمنس رِویو پٮ۪ٹھ مےٚ چھُ بَہٕتر محسوس کَران۔
کیا تُہۍ فلوریڈا نَہ پسند کَران چھِو؟
یِم بُزرُگ نسلَن کَنہِ زمانہِ منز اَسہِ ہُند خیال تھاوان اوس، تِمن ہُند خیال تھاوُن چھُ ضروری۔
پنُن خۄد نَہ ڈراوِو۔
ترٛکاری کھاون مُنٛز مےٚ گَژھان بٔڈ گَندٕ، یِمٔ خاطٕر مےٚ سٲری سموٗدی منز بلینٛڈ کران۔
مےٚ خوش چھُس زِ ویک اینٛڈ چھُ لگ بھگ یِوان۔
بس بینٛز تہٕ تیز مصالحہ دار کھانٛہ نِش دور رٔہیو، ہاہا۔
اُمید چھُ زِ تُہۍ چھِو جلدٕ کُنہِ حٲصِل کران۔
فائنل ٹیسٹ منز فیل گژھنہٕ پتہٕ مےٚ وُچھ زٕبردست غُصہٕ۔
تُہٕنٛد محنت ثمرآور گٔے۔
پٕرٛنۍ-پٕرٛنۍ تہٕ پٕرٛنۍ-بٲیہِ رٲبطہٕ ہُنٛد وقت چھُس مےٚ نہٕ گژھان۔
مےٚ چھُس نیک دوستن خٲطرٕ زٕبردست شُکرگُذار۔
مےٚ چھُس تھای کھانٛہ ہاوٕن، مےٚ سمجھیو زِ یِمٔ تُہٕنٛدِ دلہِ کیازِ خوشی دِتھ۔
کیا تُہۍ کُنہِ بیٚ کَھلِتھ گژھِو؟
گَژھِت ہفتہٕ منز مےٚ ہیک انٹرویو آس۔
مےٚ چھُ کَل یِم سکوٗل منز جمع کرُن۔
مےٚ بناوٕ یہِ ہفتہٕ منز اکھ شاندار پیزا۔
یہِ آوٕ زٕبردست سُہ، مگر مےٚ کُنہِ گلدان یا کانٛہہ چھُ نہٕ۔
مےٚ چھُس پنُن مُلک واپَس گژھِتھ ہاوٕن۔
مےٚ چھُس متاثر—تِمۍ کُتھ جِتھ میڈل؟
تُہۍ چھِو مطلب مارٹگج گژھُن؟
کَل مےٚ بناوان چھُس پنُن گۄڈٕ میونیز لَزانیا۔
تَمہِ منز اکھ کٲٹھٕر آس۔
امریکہُک برٹش نُسخہٕ۔
تٔہنٛدۍ سۭتۍ وقت گٔزارِتھ ہیٚکُن چھُ سُہ پسند
ہا ہا، لگٕن چھُ اگلی بار سُہ نہ بُلُن
مےٚ اوسُس تِمن پؠٹھ فخر
گژھِس ہفتس مےٚ پنُن شوہر شہرٕ باہر کٲم کران اوس، تہٕ مےٚ دوہ دن گَرِ اکیٛس روٗزُن پَڑِ
کیا تُہۍ چھِو اَز تٔم بیس بال کھیلُن
تُہۍ چھِو بختٕوٲل یِم تُہۍ سۭتۍ ٲسِو
بہت سٲری کٲم کٔرِتھ بُفے کُن گژھان چھُس
مےٚ چھُنہٕ کَمٕہِ ٹایمٕہِ کُنہِ ٹِکَٹہِ پؠٹھ جیت، مگر اکھ دۄہ ۳۰۰ جِتھ
مےٚ حالٕے حالٕے ٹی وی پؠٹھ گالف وُچھنٕچ شوق لٲگ
تَمہِ مےٚ اکھ نَو ٹیٚبُل ژٔٹ دۄہ لٔد
کٲم خٲطرٕ وۄل رۄکَمُک اکھ سودا پَکُن کٔرِتھ کوٗشش کران چھُس
میٛونۍ پرٛدادی گٔژھِس مرنٕہ پؠٹھ مےٚ چھُس اداس محسوس کران
آہ نہ، تُہۍ کِتھ کَم وقت کٲمٕہِ باہر ٲسِو
تَمہِ مےٚ سکولس منز ٲسُس تہٕ دۄدٕن میٛون پینٹ خراب گٔی
میٛونۍ کوٗترُکۍ ژٔنگس پؠٹھ سرجری گژھان چھِ
آہ واہ، سُہ چھُ زبردست! اَز تَک تُہۍ کِتھ پٮ۪ٹھ لٲگُن
مےٚ گَرِ یِتھ وُچھ زِ پٮ۪ٹھۍ آنگَنُک گیٹ اُگُر ٲس
آ، مگر موت چھُ واتن دُکھ دِن وٲل، تہٕ مےٚ چھُنہٕ پتہ زِ مےٚ کِنہِ وِزِ ہا یہ احساس دۄر کرِتھ ہیٚکِو
مےٚ چھُ یقین زِ یِتھ کالجس گژھِ تہٕ تٔمۍ ہٕنٛز ژٔیٛر کٔرِ سُہ کٲم زبردست
گژھِس راتھ مےٚ کچرا باہر کٔرِتھ گٔژھ، تہٕ مےٚ لگ بھگ مرُن پٔژھ
مےٚ حمل ٹھہرٛاونٛچ کوٗشش کران چھُس تہٕ مےٚ حملچ سارٕے علامتھ محسوس گژھان چھِ۔
