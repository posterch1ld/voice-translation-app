نَہ، بہٕ واریاہ ڈرِتھ اوس۔
برفٕچ پٮ۪ٹھ پہلی بار چلن وول بہٕ ڈرِتھ اوس۔
بچپن ہٕنٛدۍ چھُٹِیُن ہٕنٛز یاد بہٕ واریاہ پیارٕ سان کران۔
بہٕ واریاہ خوش چھُس تہٕ یونیورسٹی ہٕنٛز اگلی سالُک شروع کرنہٕ خٲطرٕ تیار چھُس۔
بہٕ یقینن تُہٕنٛز تکلیف محسوس کران۔
تُہٕنٛز تصویر کھینچنہٕ خٲطرٕ تُہۍ 45 مِنٹ ساکت رہُن پٲوان۔
یَتھ پٮ۪ٹھ بہٕ شروع کٔر، تَتھ پٮ۪ٹھ بہٕ واریاہ کینہہ سیکھمت۔
بہٕ جانان تہٕ یہِ واریاہ اداس کُن چھُ۔
آن لائن سائٹن ہنٛز بجایہِ ٹریول ایجنٹ چھِ پیچیدہ سفر واریاہ آسان بناوان۔
بہٕ اَتھ کینہہ وقتہٕ پنُن اکھ ساتھی ملازم سٕتۍ اکھ واریاہ ملازمُک شفٹ سنبھالنہٕ خٲطرٕ ونان اوس۔
اوہ نَہ، کیٛاہ تُہۍ تِم واپس مِلہِ؟
میون چھُ خیال، اگر یہِ پرٛتھ گژھِ تہٕ مےٚ پٲوان ایمرجنسی فون کرُن۔
گژھِ راتھ گھرِ اکیلا اوسُن بہٕ ڈرِتھ اوس۔
بدقسمتی سان، بہٕ وُچھُمتھ کِہ گژھِ راتھ مےٚ بیٚیہِ ہٕنٛز سالگرٕ اوس۔
بہٕ واریاہ شکرگزار چھُس زِ سُہ چھُس مےٚ زندگی ہٕنٛز اکھ حصہ۔
کیٛاہ سُہِ چھِ اَتھ پٮ۪ٹھ اَکھ دوٚیم نوکری مٕلِتھ؟
اوہ، کَتھٕ گژھ؟
چھُٹیُن دوران یوس کرسمس گانہٕ بہٕ ونان، سُہ چھُ مےٚ فلپائنز منز آسِن خاندان ہٕنٛز پیارِ یادُن طرف واپس نین۔
بہٕ چھُس تیار تِم بدکردار لوٗکن ہنٛد خلاف عدالتس منز گواہی دِنہٕ خٲطرٕ۔
بہتَن سالن پَتھ پٲٹھۍ بار گٔیِس بہ پنٛنِس والِد سافٹ بال کھیٚلٕن دِژنس
دوٚ یِمِتَن مَنٛز بہ سُہ بَنیٛہ
کیا تُہۍ سُہ وٕنٛدِ استعمال کٔرۍو
اوہ، سُہ چھُ نَہ ٹھیٖک
لون آفِسر اوس سٕہت نِرم، مگر سُہ گوٚو بۄنِہ بۄنِہ وار لَگان
سُہ چھُ خوفناک، ہَنٛگَن مَنٛز چھُس بہ موتھ پٲٹھۍ گژھان
کم از کم پٲٹھۍ، پوکیمون گو چھُ وۄنۍ مشہور
تٔمۍ کٔنۍ چھُ نَہ کٔرمُت مےٚ خٲطرٕ یِم پٲٹھۍ کینٛہہ
سُہ چھُ سپینٛچِس شُمٲلی کِنٛڈِس پٲٹھۍ اِک شہر
واہ، کیا تُہۍ گٔیو سُہ مَنٛز رٲڈ کٔرِتھ
مےٚ چھُ نہ وۄنۍ پَتہ، مگر چھُس اُمید کَران زِ کانٛہہ مےٚ خٲطرٕ پارٹی کرِ
پنٛنٮ۪ن والِدٮ۪ن سٕتۍ چھُس بہ گَرِ مَنٛز رٲوان
یِی، سُہ چھُ اِک مُشکِل جاے یَتھ رٲوان
مےٚ چھُرُس ابھی پنٛنِہ پٲٹھۍ نوکری مٕلِتھ
مےٚ اوس سٕہت بیمار گٔیوم تہٕ اوسُس تَتھ جاے ہفتہ بَھر اَٹکِتھ
اِک وَز مےٚ گٔیو جاگِتھ زِ مےٚ لَگُن اوس مےٚ کمرِ مَنٛز بھوت
مےٚ چھِ بہترین دوستُچ شادی گژھان، تَمِس خٲطرٕ چھُس بہ سٕہت خوش
یِم وُرس چھُس مےٚ بھٲج فُٹ بال کھیٚلان
تھوٚڈا چھُس مےٚ دِل خراب زِ مےٚ چھُ نَہ کَتھ وۄنٛہہ اِتھ لَکی
مےٚ دوست گوٚو حالٕے کار حادثَس مَنٛز فوت
تٔہِ کُتٕن پٮ۪ٹھ دۄڑاوٕن خٲطرٕ کِنہہ کھلُن یا تَتھ پٲٹھۍ کانہہ چیز استعمال کٔرتھ آزماو—کُتٕ چھِ تِم ژٕٹ پسند۔
بہٕ سٕہِ سٕژھ تَتھ سوزِتھ خاک کٔرِہ۔
مےٚ چھُ نہٕ پتہٕ کِتھ پٲٹھۍ کانہہ سَتٲیِتھ بَچٕہ رَد کٔرِتھ۔ یہِ آسان چھُ نہٕ، مگر تِمَن چھِ مددٕچ ضروٗرت۔
کیا تُہۍ ۲۰ ؤرۍ جیل مُل؟
ییٚلہِ میون زٕوٗر وقتس پٲٹھۍ گَر نَہ آو تہٕ مےٚ نَہ ہیٚکِس تَمہِ سٟتۍ رٲبطہٕ کٔرِتھ، بہٕ سٕخت پریشان گژھِس۔
بہٕ چھُس عام طور پٲٹھۍ پریشان گژھن وٲلۍ، تِہِ چھُ سُہ تہِ۔
ییٚلہِ مےٚ ہُند زَنم دۄہ اوس تہٕ کٲنٛسہِ نَہ دِتھ دھیٖان نَہ کِہنہِ ووٚل، مےٚ سٕخت خراب لَگِو۔
مےٚ گٔے ہفتہٕ لاٹری کھیٚلِ، یُس بہٕ تقریباً کَتھٕے نَہ کَران۔
مےٚ چھُ خۄشی زِ موسم چھُ ٹھیک تھاوان لٲگِتھ۔
مگر مےٚ نَہ ژٕٹ تَتھ پٮ۪ٹھ کٲٹھ کٔرِتھ وٲرِتھ۔
ییٚلہِ میون برٛۆر کالیج پٮ۪ٹھ گَر آو، بہٕ سٕخت متاثر گژھِس۔
سُنِتھ لٲگِتھ چھُ سُہ سٕخت مزٕ۔
نَہ چھُ صرف پنٛنۍ خٲطرٕ کٲم کٔرُن، مگر بیٚیِو مدد کٔرُن تہِ۔
یہِ چھُ تُہٕنٛدِس کَتھِ پٲٹھۍ؟
سٲریٛس منز نَہ گٔیو سُہ تِتھ پٲٹھۍ سُہل۔
کٲم پٮ۪ٹھ گَر وٲلِتھ مےٚ یِتھ دِژھ زِ مےٚ ہُند شرٹ اوس سٕخت بٔڑِ سُرٛنٛدۍ دٲغہٕ، مےٚ سٕخت خراب لَگِو۔
مےٚ چھُ امید زِ سٲریٛن کِہِ تہِ بہتری خٲطرٕ گژھِ۔
مےٚ چھُ یقین—سُہ دِژھُ کِتھ پٲٹھۍ؟
مےٚ چھُ لٲگِتھ زِ تُہۍ نَہ یِو کٲنسہِ معافی، ظٲہر چھُ۔
وۄنۍ کم از کم تُہۍ گژھِو نہٕ تِمَن ہٕنٛز دٕیکھ رٲکھ۔
مےٚ سٕس ہمیشہ پیسہٕ نِش تَنگ ٲس، مگر گژھِتھ مہینس تِنہٕ مےٚ خٲطرٕ اَکھ مہنگ لٲن موٗوَر اَنی۔
اَکھ ڈٮ۪نٹ تہٕ اَکھ خَروٗچ۔
مےٚ گژھِتھ محنت سان پرٛٮ۪تھ کٔر۔
سُہ چھُ اَسہِ رِشتہٕ ختم کٔرُن چاہان۔
تُہۍ کِس پٲٹھۍ شَرٕط لٲی؟
کَم اَز کَم تَتھ پٲٹھۍ یُس مےٚ کانہہ نَہ کَران ٲس، سُہ تَتھ تام وٲتھ کٔرِتھ ہٮ۪کِ۔
سُہ چھُ شاید تُہۍ ہُنٛد مِہربٲنی خٲطرٕ بٕہ حد شُکرگُزار۔
یہِ چھُ اَکھ سُہٕن ہٲو۔
مےٚ چھُ نَہ ہٮ۪کان وٲتھ کٔرِتھ یِتھ تام آز کٲم ختم گژھِ۔
مےٚ چھُ آز کالیجس منز پرٛان وول پنُن بَچٕہ مِلان گژھان۔
مےٚ چھُ تِمِس پٮ۪ٹھۍ گژھِتھ وُنمتھ یِہ چھُ ختم تہٕ اَسہِ چھِ نَہ ہٮ۪کان یِتھ پٲٹھۍ پَتھ وٲپس یُن۔
شُکریہ، آز چھُ سُہ یُس پٮ۪ٹھۍ ٲس۔
مےٚ چھُ تازٕ اَکھ اِحتجاجس گژھان۔
مےٚ چھُ یِم پٲٹھۍ اَکھ بٕہ حد سُہٕن احساس۔
مےٚ چھُ پَتہٕ، تُہۍ ہٮ۪کِو تِمِس بَچٲوِتھ یِہ مےٚ خٲطرٕ خۄشی چھِ۔
اَسہِ چھِ نَہ وٲتھان تحفہٕ یا جشنس خٲطرٕ خاص موقعہٕ؛ اَسہِ چھِ صِرف آز خٲطرٕ پنُن زِندگی گژھان۔
ٹارگٮ۪ٹس منز مےٚ پٮ۪ٹھۍ یِہ بٲیِہ مےٚ پاگل کَران ٲس۔
کیا سُہ چھُ جلد وٲپس یِوان؟
مےٚ ہٕنٛد سٲری کُٹمب گژھِتھ گرمیٚن یورپ گژھ۔
مےٚ ہٕنٛد سٲری کھٲس دوست چھُ لَنڈَن گژھان۔
تُہۍ چھا وۄنۍ اکیلہ گَرِس منز رۄن وُچھان؟
مےٚ چھُ سٕہ پسند یِوان یَتھ وٲتھ میٛون کُتہٕ میٛانہِ ساتہٕ لپٹان۔
بِجلی گژھنُک چھُ واریاہ امکان۔
مےٚ چھُ اَکھ یِم ویک اینڈس۔
مےٚ چھُس محسوس کران زِ مےٚ گژھِ نروس، مگر مےٚ چھُس نہٕ۔
مےٚ وُچھمُت میٹنگس منز وُچھنہٕ برونہہ زِ مےٚ چھُس سۄنٛدس پنُن نیوکلیئر ہتھیار ختم کرنہٕ متعلق کیاہ وُنان۔
بےٚ اوس ڈرایِو کران تہٕ مےٚ وُچھ یہِ سُہ فریوے ہٕنٛز کَنٛڈس منز کُڑا پھلان۔
مےٚ چھُس سٹوڈنٹ لونُک واریاہ قرض تہِ، مگر مےٚ چھُس صرف یِتھ پٲٹھۍ دھیان دِوان زِ ہر ماہ پیٚٹھ ادا کٔرِتھ۔
گَژِ رات مےٚ اوس پٲٹھۍ تہٕ چھتِ پنکھٕن پیٚٹھ اَکھ ژٕنگ سِدھا کمفرٹر پیٚٹھ کٔھژھ۔
کُتہٕ چھِ تِمٕچ پٲٹھۍ وفادار۔
مےٚ اوس نہٕ تیار زِ کُنہِ ساتہٕ وقت گٲری۔
یِلہِ میٛونۍ ماجہٕ گٔی، میٛونۍ ساتھی کَم کرن وٲلۍ ہیٚکہٕ جمع تہٕ میٛانہِ دِلۍ پھول دِتھ۔
دۄڑنُک ریس یا کارن ہٕنٛز؟
چھا چھِ تُہٕنٛدِ کینٛہہ بِل یِم تُہۍ پَتہٕ دِتھ ہٲوِو؟
مگر بارش—اوہ، یہِ بارش!
یہِ گژھِ کافی نزدیٖک۔
تُہۍ یِم کتاب لیکھان، تَمہِ کیاہ چھُ؟
گَژِ کَل مےٚ وُچھ اَکھ ژٕنگ میٛونِس ڈیسکَس پیٚٹھ دۄڑان تہٕ مےٚ چیٖخ زٕرِ زور۔
شاید تٔمِس کینٛہہ مدد سُوٗزِو۔
مےٚ اوس واریاہ فخرس منز بھرِتھ۔
ہاں، اَس قٕسمچ لوکھ چھِ بٔڈ بدتمیز۔
ہاں، بہٕ چھُس۔ بہٕ چھُس ترٛےٚ وری کُنہِ رخصت نٕہ لٔتھ کام کران۔
تُہۍ لَگُن زِ تِمَو گژھِتھ بٔڈِ سٹیجس پٮ۪ٹھ۔
تَمہِ اُمید چھِ زِ تُہۍ کُنہِ وِزِ تھٲی گژھِتھ ہیکِو۔
مےٚ پٲٹھۍ پنٕنۍ نوکری ہُنٛد کارکردگی متعلق میٹنگس گژھُن پٲوان۔
بہٕ چھُس وقتس متعلق ضروری پیکیجس ہُنٛد انتظار کران، مگر پیکیج ہُنٛد ٹریکنگ چھُ بالکل غلط۔
بہٕ چھُس ہمیشہ پنٕنِس شُہرَس تِم کُھتم کرنٕچ کَہان۔
لوکھ ہیٚکِن لالچی تہٕ بےحِس گژھِتھ۔
یَتھ بہٕ چھُس کام کران، تِتھ کُنہِ گینگَنۍ آسہِ زبردستی پیسہٕ وُچھ۔
بہٕ چھُس متفق زِ پنٛنِس ماحولس منٛز روزُن تہٕ پنٛنِچ آزادی تھاوُن چھُ بہتر۔
تُہۍ گژھو تُہِ تِتھ چیک اپ خٲطرٕ ویٹ ڈاکٹرَس کُن نِن۔
کیا تُہٕنٛد کُنُبھ تہِ چھِ بٔڈ ڈِنَر کران؟
تھیٹرَس منٛز ٹھیک آیہِ، مگر کُنہِ قدر بورنگ آیہِ۔
تِہ چھِ کَتیو وِزِ سۭتۍ بٔمار؟
مےٚ چھُس لَگان زِ بہٕ چھُس اکھ الگ انسان۔
تَہٕ گژھِتھ مےٚ بٔڈ غصہٕ۔
مےٚ چھُس بس ناپسند کران رد گژھُن، تہٕ تِہ چھِ بٔڈ خراب۔
جُلاے چھُ نہٕ وقت تَمہِ خٲطرٕ۔
تَہٕ چھُ بٔڈ خراب، تہٕ مےٚ چھِ یقین زِ تُہٕنٛد شُہر چھُ بٔڈ خراب محسوس کران۔
بہٕ چھُس کران، تہٕ یہِ چھُ سُہ پٲٹھۍ خیال یُس مےٚ پٲٹھۍ آیہِ زِ یہِ ہیٚکِتھ گژھِتھ۔
مےٚنٛس بہترین دوست چھُ دور گژھان
یِہ چھُ جلد تُہٕنٛدِس ساتہٕ گژھِتھ، تُہٕنٛدِس دِلبر چھُ کُنہِ جایہِ
وُہ بڑ گٔی تہٕ بٔنِتھ اَکھ سُندر مُٹھی
مےٚنہٕ چھُ پتہٕ، مگر مےٚ چھُ نہٕ کینہہ تہِ چھوڈان، مےٚ چھُ سٲری لالچِس کھٲوان
گۄڈٕ چھُ میون نوکری ہنٛز انٹرویو تہٕ مےٚ چھُ سارٕ ہفتہٕ تیاری کران
