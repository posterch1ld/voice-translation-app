یقینن، اوس یہِ اکھ نیک احساس۔
ہای، یہِ چھُ واریاہ دۄکھد۔
حالَے مےٚ کٔر کینہہ وزن کم، تہٕ اَتھ یَلہِ بَنٛدٕس چھُس بہٕ، چھُس بہٕ زیادٕ پٲٹھۍ پُراعتماد محسوس کَران۔
سوموار مےٚ چھُس پنٛنۍ پسندیدہ کپ کیک بیکریس گژھان۔
بہٕ ہَوای گژھِ ہاوُن۔
یہ ہفتہ میٚون جیتن وٲل ٹکٹ لَب۔
پٲٹھۍ دۄہ چھِ مےٚ کنہِ بٔیٹی بۄمار، تہٕ مےٚ نہٕ ہیکِس کامہٕ پیٹھ ژٕلُن۔
اَکھ ہفتہ گٔیہ۔
اگر تُہۍ سٹریس کم کرنہٕ خٲطرٕ کینہہ شراب ضرورت چھِ، تہٕ پیو۔
تہِ چھُس سۄ کٔرتھ تہٕ وۄنۍ تَمہِ ہنٛز تجربہٕ چھُ۔
یِلہِ سۄ آخرکار میانہِ گَرِ پٲٹھۍ وۄت، بہٕ ترٛےٚ گُرٛتھ کھٲد تہٕ مےٚ منز اَکھ لمب بال لَب۔
تِمۍ ہیکِو دُکان گژھِتھ تہٕ کینہہ زیادٕ وُچھِتھ، سۄ ژٕلِتھ پٲٹھۍ؟
سنیوار چھِ أسۍ بیچس گژھان۔
وۄنۍ چھِو تُہۍ دۄنٛۍ برابر سطحس پیٹھ۔
مےٚ کٔر میانہِ پسندیدہ گلاس ٹیبلہٕ پیٹھ ژٕل، وۄنۍ مےٚ چھُ تَمہِ بدلہٕ کینٛہہ وُچھُن۔
یِم تُہۍ خوش کران، تَمی کٔرو۔
اَکھ دۄہ بہٕ تَتھ وُصل گژھان۔
سۄ چھُ سچ۔ کیا چھِ سٕتۍ پریشان؟
آ، تہٕ سۄ دۄہ اوس بہٕ کینہہ اداس۔
مےٚ چھُس بے صبر، یِتھ پٲٹھۍ بہٕ ڈھیر پیسہٕ کماوُن۔
مےٚ چھُس پنٛنۍ ژٕندگی منز پہلی دفعہ رولر کوسٹر رٲڈ کرنہٕ خٲطرٕ تیار۔
مےٚ چھُس تمنّا کران زِ تُہٕنٛد کیریئر گژھِ کامیاب تہٕ خوشیٕن ہنٛز بھرپور۔
دِسان چھُ زِ سٕہِ دۄرِ منز ژٕندگی سٲنۍ آسِ۔
شُکریہ، بہٕ نفسیاتی مشورٕ لٲگٕ جٲن چھُس۔
تَمہِ لگٕ چھُ یہ آرام کرنہٕ خٲطرٕ واریاہ بہترین دۄہ۔
یہ چھُ ٹھیک، کم از کم پٲٹھ کرِو زِ تُہۍ کُنہِ کٲم یوس کران چھِو۔
بہٕ تصور کٔرِتھ ہیکَس، وُچھم چھُس تَتھ ژٕمٕتھ واریاہ سخت۔
اگر مےٚ دۄیم ترٛقی خٲطرٕ نظرانداز کٔر، بہٕ واریاہ پریشان گژھان۔
سۄبٕہ بہٕ واٹر پارک گژھِتھ ہیکان۔
مےٚ چھُس یقین زِ تتھ سۭتۍ تُہۍ خۄش گژھِو ہون۔
کٔہہ دۄہ گژھِ مےٚ والٹ گم، مےٚ چھُس خیال زِ بہٕ بسس منز تھٲو۔
سُہ چھِ أسۍ واریاہ خوش کَران۔
یہ چھُ واریاہ نائس زِ تُہۍ سٕتۍ وٕنُن خٲطرٕ ژٕٹ کٔر، تہٕ اُمید چھُ زِ تُہۍ یہٕ دوبارٕ اَتھ پٲٹھ دِو۔
دراز کٲم دۄہس پتہٕ یہِ چھُ واریاہ مدد کَران۔
مےٚ چھُ یاد زِ یِلہٕ ہَمبَرگَر صرف اَکھ ڈالر آسِہ۔
بہٕ سۄ یِک نِک سفرس پیٹھ گژھِتھ۔
آ، بہٕ چھُس تَتھ ریسٹورَنٹس کَتہِ نَہ گژھان۔
اوہ خدایہ، تُہۍ کِیا کٔر؟
سُپرٛوایزر گژھِتھ تَتھ پٲٹھ کَرُن کَتہِ نَہ چھُ نٛہ اچھ۔
بہٕ جلدی منز آس، تہٕ سُہ دۄنٛنٕہِ دِسٕن منز اَکھ جٲری آس۔
بہٕ کینیڈاچ پرٛیری منز وُدُم، یِمن خٲطرٕ روڈ ٹرِپ چھِ واریاہ بے مزٕ۔
حالٕ چھُس بہٕ بے چینی ہٕز احساس کران تہٕ سچ چھُس نَہ وٕنِتھ زِ کیاز۔
یہِ چھُ نَہ مسئلہ۔
یہِ ہُند ناوٕ اَسہٕ اَکھ نِچٕو بوتلِ منز چاوٕلکِس دانَس پؠٹھ لیکھمُت۔
پٲلک بَنیِتھ گوٚو سُہ ژٕچِس خٲطرٕ یَتھ پٲٹھۍ فخرُک لمحہٕ۔
مےٚ وٕنِہ ہُوٚنٛچٕ اَسٕنِس یازٕرِم بَچَس جَنٛم دیُت۔
بہٕ چھُس بٔری طرح تیار، تیٚلہِ مےٚ چھِ اُمید زِ یہِ پاس کرنس منز مےٚ کُنہِ دٔقت نَہ یِیہِ۔
اُف، یہِ چھُ سٔنِتھ کَنہہ دَرد دِوان۔
کیا تُہۍ فلم واپس کٔر؟
مےٚ ہُند پَکھٕرُک پنجرٕ گوٚو اَز ڈاکہٕ منز نَہ، یُس سُہ یِوان آسَن۔
اَسہِ پَتہٕ نَہ کِنٛہہ تِم گٔے تِہٕ کِیاہ کٔرِتھ؟
اَز بہٕ اوسُس واریاہ گھَبٔرٲوُن پنُن کُتھ وٲتھ ڈاکٹرِس نِتھ۔
مےٚ گوٚو پنٕنِس بَدرِس سۭتۍ تَکرار۔
مےٚ اوس سٲری وِز تَتھ گَژھُن یِژھان۔
بہٕ کٲمِہِ پٮ۪ٹھ گَرٕ آوٕس تہٕ کُتھَن اوس فرشَس پؠٹھ پٲخانہٕ کٔرمُت۔
بہٕ اوسُس پنٕنِس پورٕنِس سنیپ‌چیٹَن منز پنٕنِس یازٕرِس ہُند ویڈیو دِژھان۔
مےٚ کٔرُن پَرو اَزۍ زیٛادٕ کوٗشش۔
مےٚ اوسُس گمان زِ کُنِہِ چھُس گَرٕ منز زبردستی دٲخل گَژھان۔
تَتھ چھِ مےٚ کینہہ کُزن رٲوان، تیٚلہِ تِمَن سۭتۍ مِلان تہِ یِیہِ مزٕ۔
مےٚ چھُس آٹو پائلٹ فنکشنَس پؠٹھ واریاہ اِعتِماد کٔرمُت۔
کیا تُہۍ کٲمِہِ پٮ۪ٹھ بٲہر روزان؟
آ، سُہ اوس اَکھ سۭتۍ بٔڈٕ احساس۔
کیا تُہۍ تَمہِ پَرانس منز مَدد کٔر؟
یہِ تُہٕنٛد پونٛسوان جرم آس۔
دۄہہِ کُتٕرٕ بھونکِتھ ہٕرٛزِتھ ہٕندِس سٕتۍ مےٚ چلِتھ، مگر راتھ چھُ یہِ بلکل نَہ ٹھیٖک۔
مےٚ چھِ فزکس زیٛادٕ پسند، یِمنِچ مےٚ چھُ انجینئرِنگ منز۔
سمُندٕر منز اکھ بٔڑِ لہرٕن مےٚ ڈۄلِتھ، تہٕ میون ٹاپ پھٹِتھ گٔژھ۔
اَز مےٚ گٔژھ اکھ بےگھر اِنسان۔
سۄنِتھ چھُ یِہِ اکھ مزٕدار کٲم لگٕنۍ۔
کیاہ تُہۍ گژھِتھ ہیکو بِیہہِ سُہ گژھِتھ یِمن ہٕنزِ بھیڑ؟
تِمِچن ہٕندِس بارَس منز چھُس مےٚ گژھُن ڈاکٹرِس کَنۍ صُبح، امید چھِ زِ تِم دِیِو کینہہ مدد کرنس کٔرِتھ۔
کیاہ یہِ اکھ لمبٕ سفر آس؟
شاید تُہۍ ہٕیکیو سُہ ریہیب منز دٲخل کٔرِتھ، مےٚ چھِ سُرنہٕ زِ اکھ لَٹ شروع گژھِتھ چھِ کُنِہِ سُنٛد رُکُن مُشکل۔
تہِ چیزٕ گژھان بۄنِتھ چھُ دٔل دُکھان، مگر کم اَزکم چھُس مےٚ نَہ پٲران نقصان۔
مےٚ چھُ وُنِتھ اولِو گارڈَن منز اکھ بٔڑِیا کھٲدٕ کھادمُت۔
مےٚ چھِ وُنِتھ لاس ویگاس خٲطرٕ یِمن پتھٕر منز جہازٕ ٹکٹ خرٕیدمُت۔
شاید نومبر منز تِمِس سالگرٕ خٲطرٕ گژھِ مےٚ یِہِ کھیٛنِتھ۔
کاش زِ حالٕت آسِ بہتر۔
تہٕ سُہ چھُ واریاہ قابل۔
یِہِ سۄنِتھ مےٚ چھُ دُکھ گژھان، مےٚ چھِ پتہٕ زِ سُہ گژھِ بہتر۔
تُہۍ کِنہِ قٕسمُک جٲیزٕ کَرُن ژٕٹان؟
یِہِ چھُ پٲٹھۍ پٲٹھۍ تَنگ کَرٕنۍ۔
مےٚ چھِ یقین زِ یِمنِچ آس سُہ تھوڑا بہتر محسوس کران۔
مےٚ پنٛنِس بواۓ فرینڈ بغیر باہَر گٔی تہٕ کانہہ نمبر نَہ مِل۔
گٔےِ سال یِلہِ مےٚ کُتھ مٔر، بہٕ گوٚو بہت دُکھی۔
یِلہِ مےٚ کٕنِہِ پٔتھ پَہلی دفعہ اَسہِ کھادٕ یُس ژٔ کَدی نَہ آسہِ کھادان۔
مےٚ نَہ ہٕکٕن انتظار کٔرِتھ تِتھ گٔی کھاون۔
فی الحال مےٚ نَہ چھُس یژھان اَتھ قدر پیسہ خرچ کٔرِتھ۔
یِلہِ بہٕ دُکانس منٛز اوس، کُنہِ نِہ تَمہِ ٹٔکر دِژ۔
اگر تُہۍ سٔمدِست انعام نَہ مِلِو، مگر کم از کم تُہۍ کُنہِ مدد تہٕ کٔر۔
ژٔنِہ کُنہِ حالٕے منٛز اَکھ میوزیکل خٲطرٕ آڈیشن دِتھ۔
مےٚ پسندیدہ چھُٹی چھُ کرسمس۔
دُکان جے کروٗ اوس تہٕ مےٚ نٔو ہیر کٹ تہِ کٔر۔
مےٚ چھُس لیبر ڈے خٲطرٕ بلکل تیار، انتظار نَہ ہٕکٕن کٔرِتھ۔
اَکھ کروز چھُ واریاہ زبردست لٕگٕن۔
ہاں، مےٚ تہِ نَہ، اگرچہ حالٕے منٛز کینہہ اَچھا آیہِ۔
یِہ چھُ واریاہ سوچنٕچ گژھ، کیازِ تِم چھِ بچہٕ ہٕنٛدِ کٲمَن منٛز مصروف روزان۔
اوہ یار، مےٚ چھُس امید کران زِ ساروٕ کینہہ ٹھیٖک آسہِ تہٕ یہِ کُنہِ پیڑ ہٕنٛز شاخہٕ سٕیتھ ہلکہٕ پریشان کُن چیز آسہِ۔
یہِ چھُ واریاہ دُکھ دِوان۔ تُہۍ اوسِ تِمِس ژٔٹ پِیٹھ وٲتھ ڈاکٹرِس نِش؟
کیا تُہۍ چھُو جلدی اَکھ گژھان گنٛڈِتھ؟
مےٚ مطلب، مےٚ فیس بُک فیڈ چھُ اَتھ سٲری فالتو چیزن سۭتۍ بٔرِتھ۔
مینہٹن روزنٕچ آسہِ اَکھ زبردست جاے۔
بدقسمتی سۭتۍ، یِلہِ مےٚ آخری نوالہٕ کھاد، تِلہِ سۭتۍ ژٕ اندر آو۔
پَتہٕ، مےٚ یہِ متعلق تھوڑا خراب محسوس کٔر۔
اَس ژٕ کَہہِ مہینَن ہٕنٛدِ مالی طور پٲٹھۍ پریشان چھِ۔
مےٚ کوٗشش کَرٕ، مےٚ چھُ ڈر۔
اوہ نہٕ، یِم شخصس سۭتۍ تُہۍ چھِ فکر کران، تِمَن ہٕنٛز کُنہِ خراب شخصس سۭتۍ ڈیٹ کَرن دیکھُن چھُ واقعی بہت خراب۔
مےٚ چھِ سُہ وقت زٕبردست یاد یِوان۔
تِم سنگِ میلَن ہمیشہ یاد تھاوُن چھُ کٲفی کُول۔
مےٚ چھُ یقین زِ سُہ تہٕ تُہۍ چھِ تَمہِ متعلق زٕبردست پَرجوش۔
مےٚ گژھان چھُس سُہ دۄہ ژٕٹِھ پٲٹھۍ۔
مےٚ ہٕنٛز بِلّی چھُ اگلے ہفتہٕ مارُن پٲوان۔
کیا تِمَن کِنہِ کٲنٛہہ یہِ متعلق ووٚن؟
زِندگی چھِ بے یقینی، تہٕ سڑکَس پٲٹھۍ یہِ نہٕ زِ تُہۍ کِتھ پٲٹھۍ چلاوان چھِ، بلکہ یہِ زِ باقی کِتھ پٲٹھۍ چلاوان چھِ۔
تُہۍ چھِ کُنہِ کٲمَس گژھان یا صرف آرام کَران؟
ٹھیک، گیم نہٕ یِوان اکتوبر تام۔
یہِ چھُ تِمَن ہٕنٛدِس عمرس منز مےٚ یُس اوس تَمہِ پیٹھۍ کَتھ زٕیادٕ۔
یَتھ مےٚ ہُنٛد بابا اچانک مُوت یِو، تَتھ مےٚ سۭتۍ زٕبردست دکھ۔
آ، مگر مےٚ چھُس کوٗشش کَران زِ مےٚ نہٕ کَرٕ مُقابلہٕ۔
ٹھیک، اُمید چھِ زِ تُہۍ گژھِو کینہہ سبق تِمَہِ منز تہٕ سُہ واریاہ دوٚپارہٕ نہٕ گژھِ۔
کیا تُہۍ چھِ پنٕنِس ڈاکٹرَس سۭتۍ اپاینٹمنٹ کٔرِتھ؟
حقیقتن، مےٚ چھُس سُہ تھاوُن منصوبہٕ کَران، تِمَن چھُ نہٕ وچھمتھ اَز تام۔
یَتھ کُنہِ تُہۍ ووٚن زِ کیاہ کَرُن، تَتھ چھُ واقعی تَنگ یِوان۔
مےٚ تَمہِ پتہٕ اوس زِ کمپنی میٚےٚ خٲطرٕ نَہ چھِ۔
مےٚ بس یژھان چھُس پنُن دل ہلکا کٔرُن، مگر حالیہ مےٚ نَہ چھُ پتہٕ زِ کِتھ پٲٹھۍ محسوس کَرُن۔
بات یہ اوس زِ مےٚ تَمہِ خٲطرٕ بے حد شُکرگُزار اوسُس، تہٕ سکول ختم گژھنہِ خٲطرٕ تہِ خوش اوسُس۔
کاشِرِ لوگ یِلہِ منصوبہٕ بناون، تِلہِ تِم تِمِس پٮ۪ٹھ قائم روزن۔
تہٕ تِم سٲری چھِ خراب—مذاق اوس۔
اوہ، یہِ چھُ بدقسمتی۔ میٚون اوس ممکنہٕ انفیکشن خٲطرٕ۔
تِمۍ مےٚ سۭتۍ ووٚن زِ تِم طلاق یژھان تہٕ زِ مےٚ نَہ چھُس اَسہِ سٲنۍ بیٚیہِ ہٕنٛز بٲپتھ۔
مےٚ Hulu پٮ۪ٹھ سٹیفن کِنگ ہُنٛد نٔو سیریز وُچھان چھُس۔
تِمِس پٮ۪ٹھ وار کٔرُن چھُ کافی مُشکل سَمیٚت۔
چند مہینن پیٹھہٕ مےٚ پنُن فاینل دِن پٮ۪ٹھ۔
نَہ، مگر باسان مےٚ سۭتۍ گژھِ بے حد کِلاس۔
تِم صفا کٔرٕن ہُنٛد خیال کٔرتھ مےٚ چھُ کافی ٹینشن۔
مےٚ چھُ اُمید زِ اکھ دۄہ مےٚ تِہِ مٮ۪لِہ۔
تِمۍ بس اکھ ٹیکو یژھان اوس۔
تُہٕنٛد امتحان پاس کٔرنس پٮ۪ٹھ مبارک۔
کیا چھِ تُہٕنٛد عام طور پٮ۪ٹھ پول پسند؟
یہِ چھُ واریاہ پیزا رول لَگان—تُہٕنٛد کیٛاہ حال چھُ؟
مےٚ چھُس یقین زِ تُہٕنٛد بے حد کَسکَس گژھِ آسہِ۔
مےٚ چھُس یقین زِ تُہۍ چھِ واریاہ جلدی نٔو دوست بناوٕن۔
تِم پنٕن سامان زبردستی جایہِ دِنہِ خٲطرٕ اَسہِ سامانَس منز چیزہِ توڑان۔
مےٚ عام طور پٲٹھۍ ویک اینڈ پسند چھِ، مگر یہ وٲلۍ نَہ۔
اَس کٔر سٕہ ڈراوٕن تِم پَران، مگر تِمَن تقریباً مےٚ پٲٹھۍ حملہ کٔر۔
مےٚ بنا کُنہہ وجہِ نروس اوس۔
کیا تُہۍ چھِم کٔر کوشش دۄیم سروس پرووایڈرٕن ہُند پَتہٕ لَگاون یِم کِہ بہتر ڈیل چھِ دۄیم؟
زِندگی منز مےٚ کُنہہ ہٚنٛد ضرورت چھِ نہٕ۔
تُہۍ چھِ سَدا پنٛنِس خٲطرٕ دۄیم ژھُنٛگ لٲدِتھ۔
مےٚ اوس سُہ مرد یوس شادی شُدٕ اوس تہٕ یِمن اوس مےٚ لالچ دِوان۔
مےٚ کرُن چھِ پنٛنِس مکان مالِکَس فون، کرٲیَس منز دۄہ ہٚنٛد دٕیر گٔے۔
مےٚ یقین چھِ نہٕ یِم مٲج کٲنٛہٕ ہای سکول شروع کران چھِ۔
گیم اوس پٲٹھۍ پٲٹھۍ رازٕن ہُند۔
یونیورسٹی چھِ وٲنٛگن شروٗع گژھان تہٕ مےٚ چھِ نروس۔
واہ، مےٚ چھِ گۄڈ کُتُرٕن ہٕنٛدۍ کمال کٲم کَران وُچھنٕچ شوق۔
کیازِ، سوموارس کِیا گژھان چھُ؟
مےٚ چھُ نہٕ کافی مشق کٔرمٕژ۔
مٲج کٲنٛہِ پرٛی کے ہٕنٛدۍ کینہہ ہم جماعت چھِ سکولُک پَہلِس دۄہَس پٲٹھۍ رَوان۔
آ، مگر یہ کٔرنٕہِ خٲطرٕ اَسَن لگِ کینہہ مِنٹ، کیازِ اَس اوسَن زٕ سَخْت حَیْران۔
دۄہِ دۄہ مےٚ کٔر سُہ واٹر کوسٹر یِم تِمَن ہٕنٛدۍ اوس۔
مےٚ وٲتٕچ پنٛنٕے ژور ڈونٹ کھٲدۍ۔
مےٚ کٔر پنٛنِس تقریرس خٲطرٕ سٲری رات ریہرسل۔
کہ مےٚ چھُ اکھ بہتر نوکری میلان
یِم گیمس پیٚٹھ بہٕ سٕچۍ بےتاب آسہٕ، سُہ اکتوبرس منز ژٔلان چھُ تہٕ بہٕ چھُس تَمہِ خٲطرٕ واریاہ پرجوش
مےٚ دوستن منٛز مےٚ جنم دِہسُک ڈِنر کینسل کٔر
ییلہٕ بہٕ بوے سکاوٗٹ اوسُس، أس کیمپِنگ کٔرِتھ گٔژھ
مےٚ بچہٕ چھِ وُنِوٗن کالج گٔژھان تہٕ مےٚ شوٚہر چھُ چار دۄہن ہٕنٛز بزنس ٹرِپہِ پٮ۪ٹھ باہر
نَہ، سُہ چھِ اَز تہِ سٲری چیز پَران
تُہۍ کُنہِ نِہ گٔژھِوٗ ڈرایِو کٔرِتھ تَتھ
تُہۍ گژھِو تَمہِ سۭتۍ دۄبارٕ وِیہِ کٔرُن
مےٚ پٕنٛنِس زٲمِس فاینل اِمتحانُک سکوٗر دِتھ یژھان آسہٕ تہٕ بہٕ اوسُس واریاہ پریشان
مےٚ دوستن اَز مےٚ جوٗتۍ واپس دِتۍ
مےٚ آسنٛۍ اوس کٲمِہ پٮ۪ٹھ پٲنٛۍ زنٛدگِیُک سۄنٛتۍ بٔڈ پروموشن مٕلۍ
کیا تُہۍ سُہ موٗکٕہ دِتھ دۄبارٕ کٔر؟
اَز مےٚ سٲری کٲم کرن وٲلۍن ہٕنٛز سامنہٕ اکھ گَرٕم، لٕدٕر تہٕ بَدبُو دار زور دار پاد کٔر
بہٕ بار بار چھُس ژٲنٛگَرِ ہٕنٛدۍ باہر دِوان نظر، یِمٕہِ آسہٕ نَہ بدتر گژھان
کیا تُہۍ کٔدی ٹورنیڈو منز گٔژھِو؟
سُہ چھِ تَمہِ دۄہ روز لَنٛچَس نِوان تہٕ مےٚ چھِ لگٕن یِہ چھُ غَلَط
مےٚ چھُ نَہ پَتہٕ سُہ اوس یا نَہ
سُہ چھُ اکھ واریاہ مُبارک لمحہٕ
بہٕ نَہ اوسُس تَمہِ پٮ۪ٹھ جان بوجھ کٔر پٮ۪ر دِوان، سُہ اوس غُصہٕ ہٕنٛز وَجہ سۭتۍ
بہٕ چھُس وُنِوٗن پانٛژھ بچن ہٕنٛز ماجہٕ
ٹھیک چھُ، ژٕ سَدا یِہِ سوچُن گژھان۔
تہٕ اوس اَکھ تِمَن قٕسمُک یُس منز لوٗکھ ژٕنٛدٕر اچانک ژٕنۍ سٲمتھ یِوان۔
کٔتھ پٲٹھۍ ژٕنٛدٕر شُبہٕ گژھِ یِہِ بارش یِ؟
مےٚ بَرٛونٛہِ ہٕنٛد کُتُرٕن اُپر پٲٹھۍ شِٹ کٔر، مےٚ نہٕ سُہ دِژ تہٕ آخٕر مےٚ تَمہِ پٮ۪ٹھ پٲو دِتھ۔
جھیلَس پٮ۪ٹھ مےٚ اَکھ زبردست ویک اینڈ گُزار۔
خۄش قِسمتی سٕتۍ أسۍ سُہ ہٕنٛدٕر ٲنۍ تہٕ ژٕٹ پٲٹھۍ سُہ کھٕیوان۔
ہاں، أسۍ اَتھ پَگاہ کَتھ نَہ کَرٕنۍ۔
یِہِ چھُٹ تہٕ محفوظ آسُن گژھ، مگر مےٚ چھُ اَتھ پَگاہ بٕہ ڈَر۔
مےٚ چھُ لگِتھ ژٕنٛدٕر مےٚ چھُ نَہ پَتہٕ مےٚ کُس چھُس۔
مےٚ آس چھُ ژٕنٛدٕر تُہٕنٛز واریاہ سُہ وقت گُزرِ۔
مےٚ زنٛدٕگِس منز کَدٕن نَہ مٲنسِتھ اَتھ پٲٹھۍ تیار۔
کیا ژٕ سُہ ڈٕھونٛڈِتھ سَکھ؟
مےٚ اوس واریاہ ڈَر کَتھ یِہِ مےٚ کُن بٕتھ۔
مگر تَمہِ پٮ۪ٹھ اوس آس تھاونُک کینٛہہ نَہ نُقصان۔
مےٚ نَہ سَگٕر وَتھُن یَتھ سٕتۍ مےٚ سٲری بٲل گھرٕ ہٕنٛدٕر باہَر گژھِو۔
ژٕ کیا کٔرِو، قالین صاف کٔرِو؟
بہ صبح مےٚ وٲتھ ژٕنٛدٕر مےٚ ہٕنٛز زَنٛگٕن کٔر بۄد کہ سُہ حاملہ چھِ۔
مےٚ اَکھ بٔہٕرٕن کٲفی شاپٕچ منز کٲفی ڈٕل کٔر۔
یِہِ سُنۍ مےٚ چھُ واریاہ اَفسوس، تہٕ خۄشی چھِ زِ تُہٕنٛدِس چرچُک لوٗکھ چھِ تُہٕنٛدِس ساتہٕ۔
کیا ژٕ چھُٹِیَن پٮ۪ٹھ گَرٕ گژھان؟
اچھ، اُمید چھِ تُہۍ یِہ کٲم زبردست کرِو۔
یِہِ سۭتۍ مےٚ تھوڑا گھبراہٹ تہٕ ڈر لگان چھُ کہ بہ کِتھ پٲٹھۍ مِلِتھ گژھِہ۔
بہٕ چھُس یِمِس کمپنی منز اکھ گۄڈ ہٲیک لَبُنٕچ تلاش کَران۔
جمعہ دۄہ چھُس مےٚ اکھ بٔڈ انٹرویو۔
سُہ ضرور بدبو دار آسِہ۔
گژھِت ہفتہٕ بہٕ گٔیوس تھایلینڈ چھُٹۍ مناون۔
سُہ اکھ ایسِہ مٲنٛس لَگن چھُ یُس سۭتۍ تھاون لٲزِم چھُ۔
رسک تہٕ مونوپلی چھُس بہٕ وریَن پٲٹھۍ نہٕ کھیٚلِتھ۔
بہٕ کَروٚکس تہٕ اکھ وائپ اِستعمال کوٚر۔
واہ، کیا تُہۍ طے کوٚرِو چھُ کُتھ جایِو چھُٹِین منز؟
بہٕ حالٕے منز اکھ نٔو شہر منز رۄستھ چھُس، مگر اَز تام چھُس نہٕ کانٛہہ یِتھ کُن وُنٛدِتھ۔
گژھِت ہفتہٕ آخرِس مےٚ بچن ہٕنٛز فٹبال ٹیمٕن ٹورنامنٹ جیت تہٕ تِمَن جیتُن گول کوٚر۔
تِمَن کوٚر تِہنٛز خٲطرٕ سُہ خراب۔
سُہ چھُ اکھ گۄڈ دوست، مگر افسوس تُہۍ پنٛٹ پھاڑِتھ۔
مےٚ چھِ خیال تُہۍ بلکل ٹھیک کَرِو۔
مےٚ سۭتۍ مےٚ بہن ہٕنٛز بٔڈ لڑٲی گٔی تہٕ تِنٛۍ وۄن مےٚ موٹی گۄو۔
مےٚ چھُس اندازٕ لَگان تُہۍ گٔیِو چھُ دۄکان۔
نہٕ، بہٕ اوسُس اُمید کَران شاید پیسہٕ یا کانٛہہ کٲشر کۄرِچ فون نمبر مِلِہ۔
بہٕ سُہ دۄہ گژھِتھ گژھُن پسند کران؛ بس نشہٕ کٔرتھ لوٗکن ہٕنٛز طرف دھیان دِیِو نہٕ، مےٚ چھِ یقین تُہۍ خوب مزٕ کَرِو۔
یِہِ چھُ ہٲنٛسُن، مگر تِمِس وَختَس سُہ یِمنہٕ ہٲنٛسُن اوس۔
مےٚ ڈاکٹرِ مُتعلق پٲٹھۍ تحقیق کٔر تہٕ مےٚ یقین آسۍ زِ سُہ سُند کام سہی کرِ۔
اچھا، تِمِس چھِ تَتھ دۄن ؤرۍ تہٕ مےٚ چھِ گژھان زِ یِہِچ وجہ آسہِ یِمَن تِہِ وُنُن۔
مےٚ چھُس یِہِ سٕہِ پلان لَگھان۔
مےٚ چھُس اُمید کران زِ سٲری کینہہ سہی گژھِ تہٕ تُہۍ پٮ۪و محبتس منز۔
آ، مےٚ چھُس سُہ اکھ دوست تہٕ تُہۍ نہٕ چھِوٕمُت یِمِس پٮ۪ٹھ آس چھوٚڑُن۔
پہلِہ نَہٕ اوس یِہِ لَگُن۔
تُہۍ چھِوٕمُت، مےٚ اوس اکھ جھٹکَس منز وٕتھ تہٕ گٔژھ۔
مےٚ نہٕ چھُس سٲن زِ مےٚ ہٮ۪کِو یِہِ کَرِتھ؛ یِہِ چھِ مےٚ خٲطرٕ واریاہ ڈرٲون۔
یَتھ وِز مےٚ سُہ بھٹھی منز بیلچہٕ سٟتۍ دٔل، مےٚ اوس واریاہ غصہٕ۔
سوزِو زِ تُہۍ چھِو یِہِ نٔر۔
بوٗنہہ چیٖز چھِ یِمِس کُن بدتر۔
مےٚ چھُس معذرت خواہ زِ سُہ ڈرٲون واقعہٕ تُہند سٟتۍ گٔیو۔
شاید مےٚ چھُوٚن یِمِس چینِ سٟتۍ وفادار روزُن تہٕ دۄہُن زِ یِہِ سُدھرِتھ۔
مےٚ چھُس سچِچ جراثیمن ہٕنٛز ڈر۔
ہیلوٗوین یِتھ کٔڈِ چھِ ژھٹ گژھُن، تِتھ کٔڈِ چھِ کم۔
مےٚ کٔر پٲٹھۍ محنت زِ مےٚ سی پی اے امتحان خٲطرٕ پٲٹھۍ پڑھُن گژھِ۔
آ، تُہۍ چھِوٕ بالکل سہی۔ ژٕٹ دٔگُر مُشکل اوس، مگر نَو کُنہِ سٟتۍ مِلان چھِ تِہِ واریاہ آسان بناوان۔
گٔے ؤرۍ مےٚ کٔر پنُن تھیسس ڈیفینڈ، یَتھ مےٚ اوس کانَس منز سخت انفیکشن۔
نَو کمرٕ اوس سُہ، مگر ٹوٗیٚلِٹ اوس بند۔
مےٚ چھُس سٲن زِ تُہۍ کینہہ وٲتھ خٲلی نَہ گژھِو۔
آ، تُہۍ کُتھ گٔیِو؟
مےٚ کَنۍ کُنہِ خۄشگوار وقت ضروٗرت چھِ۔
ٹھیک چھُ، دۄیم کام کران چھُ، مگر سٹریچرُک دھاتُک ڈنڈ چھُ صحیح طریقہٕ سان کام نہٕ کران۔
مےٚ سٔنٛدِ ماجہِ پٲٹھۍ روزان اوسُس یِمن دۄہن ہٕنٛد یاد چھِ زٕر پٲٹھۍ یوان۔
آ، میٚ کٔر سیزن ٹکٹ چھِ۔
مےٚ لگن چھُ کہِ وۄنۍ تُہۍ فون کُتھ ترٛاوان چھِو، تَمہِ مُتعلق زیادہ احتیاط کٔرِو۔
ٹھیک چھُ، وۄنۍ چھِ تِمَن ہٕنٛز آن لائن بہٕت سۄہنٛۍ آفر۔
کَنہِ لوٗکھن ہٕنٛز چھِ کمالُک صلاحیت۔
بہٕ کھیلَن متعلق گژھِ بیان دِن۔
مےٚ چھُ بہٕت خوش کہِ میٛون زٕنٛگ آو تہٕ پُتر دۄہس منٛز گَرِ رہِتھ ہیکن۔
یِلہِ تِم کٔرِتھ ہیکان، تِم چھِ سٕہ کَنہِ مُتعلق کٲم مےٚ خٲطرٕ کران۔
جادوگر اوس واقعی باکمال۔
مےٚ لگن چھُ شاید مےٚ کٔرۍ کُنہِ خاص نفر گٔںڈمُت۔
اَتھ سٲریٛو آب ضایع گژھنس مےٚ چھِ بہٕت خرچ، ضایع کرنُک ذکر چھُ الگ۔
تُہۍ تہِ شاید لائف انشورنس کِرِتھ گژھِو۔
تِہِ پاؤنٛڈ بَرگر کھاونہٕ خٲطرٕ مےٚ چھِ اَکھ فری ٹی شرٹ پٲٹھۍ بہٕت کینٛہہ زیادٕ ضروٗرت۔
مےٚ چھُ جلدی اَکھ نو فون یِوان تہٕ مےٚ چھِ تَمہِ خٲطرٕ واقعی بہٕت شوق۔
تِہِ اوس واقعی بہٕت گندٕ نَظر یِوان۔
آ، أسۍ اکھِ پٲٹھۍ برج کھیلان چھِ۔
آ، مگر مےٚ اوسُس خیال شاید بہٕ مرِ گژھم۔
مےٚ اُمید چھُس زِ تُہۍ زٕنۍ اکھ جایہِ سُہ وقت گژھِو۔
مےٚ چھُس ہمیشہ زیاتہٕ کٔرُن یژھان۔
ہای دوست، چھُ تُہۍ تیز گاڑِ چلاوُن پسند؟
پَر اُمید چھُس زِ آخرس منز سٲری کینٛہہ ٹھیک گژھِ۔
کیا تِمَن ہیکۍ پَرواہٕ نَہ کٔر؟
یہِ چھُ مزٕدار لَگان—کون گیم پلیٹفارم؟
خیر، مےٚ چھُس فورسن ہٕنٛز سمجھُن منز بلکل کمزور، مگر مےٚ نَہ لگِ زِ مےٚ پورٕ محنت سۭتۍ پرٛژھ۔
مگر ہوشیار، یہِ چھُ خوفناک۔
آ، مےٚ چھُس سٲنۍ زِ أسۍ سٲری تَتھ گٔے چھِ۔
کُتہٕ چھِ اَمہِ لوکھٕ بہ نسبت بٔڈ کم حساس لَگان۔
یہِ پٲٹھ چھِ لگ بگ پانٛژھ بجِ روشنی گژھان، تِمنٛز سُرُج آسِ تہٕ تُہۍ چھِ بہت جلدی جاگِتھ۔
یہِ چھُ زبردست، تُہۍ چھُ گُرٕوٕسوس کَرن یژھان۔
کیا تاریخ ہٕنٛز ترتیب بدلِتھ تَتھ وِز گژھِ یِلہٕ موسم زیادہ سازگار آسِ؟
خیر، یُس سٲچِ تُہٕنٛد دوست چھُ، تُہۍ چھُ نہٕ یِہ کَرن یژھان۔
اَسۍ ہُنٛد چھُ یُس فوجس منز چھُ، سُہ گژھان چھُ اَسۍ نِش مُلان خاطرٕ اگلے مہینے رخصتھ۔
مےٚ چھُس ژٕد کَل فزکس ہٕنٛز ٹیسٹ، یتھ خاطرٕ مےٚ چھُس پاگل پٲٹھۍ پران۔
مےٚ ہُنٛد پانٛژھ وریہِ بچہٕ چھُ کنٛڈرگارٹن شروع کٔرُن والا، تہٕ مےٚ چھُ دُکھ زِ سُہ چھُ اَتھ جلدی بٔڑ گژھان۔
مےٚ چھُس ہر سُنٛدَر چرچ گژھان۔
مےٚ چھُس تِمن ہٕنٛز شُکرگُزار۔
مےٚ ۱۵ ؤرسَن ہٕنٛز پالان والٕ بلی اَزے مُری۔
تہِ کیازٕ سٲریوٕے گژھِ۔
مےٚ کَہنہٕ چھُ نَہ پَتہٕ تُہۍ سۄ کِتھ کَرو۔
مےٚ لَگِو کُنہٕ ژٕھٕرِ نؠبَر یُنٛچ کَرٕن کوٗشِش کَران اوس۔
مےٚ اَزےٚ پَتہٕ لَگِو زٕ کٲمَس منز مےٚ بٔڈِس دفترس منز بدلٕنۍ چھُ۔
ہاں، مگر تُہۍ سٲریوٕن ہٕنٛز تہٕ سٲریوٕ کِس مدد کَرِتھ نَہ ہیکو۔
مےٚ تہٕ مےٚ ہٕنٛز شَوہرن کَری اَزےٚ نَوِم شٲدی وٲرسِک پٲٹھ منٲوُن۔
مےٚ سٲریوٕے ڈَر لَگِو زٕ مےٚ ژَخٕم لَگِتھ۔
بہٕت سٲری مُشکِلات تہٕ آزمایِش آیہِ۔
کیا تُہٕنٛد کُتھٕ ٹھیک رَہِ؟
آج کَل چھِ سُہ بہٕت مہٕنگ، مےٚ آس کَرُن زٕ زٕبردَست غُصہٕ۔
مےٚ ہٕنٛز حالیہ منز بچہٕ ژٕر تہٕ مےٚ ہٕنٛز شٲدی ہٕنٛز زِندگی چھِ سٲریوٕے ترٛٲو۔
کینہہ لوٗکھن ہٕنٛز اولاد پٲدٕ کَرنٕچ اجازت نَہ دِیُن گژھِ۔
کیا تُہۍ سۄ اِتھ پَسَنٛد آو زِ تُہۍ دوٚیِم ڈیٹَس پیٹھ گٔیو؟
اَسہِ ہٕنٛز گَرِ پیٹھ اَکھ ژٕنٛگ لَگِتھ پٔت۔
دُنیاہِس منز چھِ اَز تہِ کینہہ لوٗکھ۔
تَمہِ تہِ سۄ کَرُن اَکھ نِیٚک کٲم اوس۔
مےٚ ہٕنٛز تہِ اَسہِ گَپھ کرن والِس کٲم کرن والِس سٟتۍ تٔمِثٕل تجربہٕ۔
مےٚ چھُ نَہ کٲنٛہہ دوست۔
واہ، سُنے تُہۍ سٲریوٕے دُکھی گٔیو۔
اَز مٲلۍ بھٲجی تہِ بیٛیہِ کٲنہہ کمرِ منز واریاہ گژر چھوٚڑِتھ۔
مےٚ پنٛنِس زنہِ ہٕنٛد کٲنہہ واریاہ قٕدر کَران۔
بہارِ ہَواہس منز پولنُک بٕوٚن مےٚ پنٛنِس پٲٹھۍ بوسہٕ ہٕنٛد یاد دِوان۔
مےٚ سِرف یہِ چھُس چاہان زِ تِم ژھٹ فون کَرن۔
نَہ، مےٚ سِرف واریاہ مشغول اوسُس، مگر مےٚ چھُس یِمن پٲٹھۍ سٕتۍ واریاہ خراب محسوس کَران۔
بلکل سچ، اگرِ مےٚ چھُس وۄنۍ بالکل کم پٮ۪وان۔
آخر مےٚ کرٛانہٕ چھوٚڑِتھ آو۔
مےٚ چھُس جانان، مگر مےٚ اوس نہٕ توقع۔
تَتھ پیٚٹھ، یہِ چھُ سٲریَن ہٕنٛز مشغول دۄہس منز واریاہ تَکلیف دِن وٲل دٕیر۔
حالے مےٚ پنٛنِس دوستس کٔر مےٚ گھرُک خیال یَتھ وِزِ کَران یِتھ وِزِ مےٚ اوسُس چھُٹِ منز۔
یہِ اوسُس اَکھ نیک کالج۔
آ، مےٚ چھُس روز یِمن پیٚٹھ کٲم کَران۔
یِمِس بَرس مےٚ آفسہٕ پیٚٹھ واریاہ کاروبار کَران۔
مےٚ ہٕنٛدِس علاقَس باہَر تہِ کَنٛہہ وٕدِی وۄقت گٕزارُن گژھِ۔
آو، کیاہ یہِ ٹھیک گژھِتھ؟
مےٚ اوس نہٕ کُنہِ گژھِتھ ہٕنٛد منٛز۔
سِرف اَکھ سِکّہٕ اوس، مگر تَمہِ کٔر مےٚ واریاہ خراب محسوس۔
کیاہ تُہۍ تِمن سٕتۍ نفرت کَران یِم تُہۍ کٔرِتھ کٲم ہٕنٛز ہدایت دِوان، یاہ سِرف حاکم لوٗکھَن سٕتۍ؟
شایَد تُہۍ کٔرِو کوٚشش زِ تُہۍ وٕدِی باہَر نِکلو۔
یِتھ کِنہِ قٕسمُک کٲم گژھان چھُ، تَتھ چھُ واریاہ زبردست لٲگِتھ۔
تٔلِہِ سۭتۍ کٔہہ، سُہ واریاہ وار سر ٹکرٕوان چھُ تہٕ زانٛگ چھِلان چھُ۔
کیا چھِ سُہ گٔڈٕ یہِ سۭتۍ راضی؟
مےٚ چھُس راضی، مےٚ لٔگۍ بہت اکیٛلا تہٕ ناپسندیدہ۔
مےٚ مطلب چھُ، کینہہ دۄہ ژوٚن تہٕ پتہٕ ٹھیک چھُ، مگر پورٕ مہینہ؟
مےٚ چھُس شرط لَگاون، سُہ چھِ سۄنٛدٕرین سۭتۍ سۄنٛدٕر۔
سارٕ پیک تہٕ گژھنس تیار۔
مےٚ ہیکانٕچ نہٕ سوچِتھ کہ یہِ ہفتہِ کینہہ خراب گژھِ۔
کیا توٚہہ چھِ ۲۰۱۸ فیفا ورلڈ کپ فاینل ووٚچھمُت؟
اوہ، بہٕ چیٛخِتھ تہٕ دوڑِتھ گٔژھِتھ۔
بہٕ پاس گٔیِس، مگر یہِ مےٚ خاطرٕ آسان نہٕ آس، کیازِ امتحان آس بہت مشکل۔
یِم سۭتۍ چھُ آج یہِ میٹنگس گژھُن مشکل۔
ویسے، اکھ میل تامہِ پۄنٛٹھہٕ کینہہ نَہ آس۔
تُہٕنٛدِس چھُ یِتھ اضافی وقت، تُہٕی چھِ کاؤنسلِنگ سروس شروع کرُن گژھان۔
گٔژِمۍ رات مےٚ ووٚچھ اکھ بھوت مےٚ پۄنٛٹھہٕ یوان۔
کینہہ وار چھِ أسۍ زنٛدگی منز بٔڈ بدلاوٕ کٔرِتھ پتہٕ بہترین تجربہٕ حاصٕل کَران۔
مےٚ ماجۍ کٔر فون صرف یِتھ پٲٹھۍ پَتہٕ لَگاونہٕ خٲطرٕ کہ بہٕ کَتھ چھُس۔
نَہ، سچِ، تہٕ یِمے سۭتۍ چھُس بہٕ یِتھ حسد کَران زِ تَمہِ چھُ واریاہ پٲٹھۍ نَو ساتھی۔
نتیجہٕ حاصٕل کرنہٕ خٲطرٕ مےٚ آخرکار فیصلہٕ کٔر زِ مےٚ پنُن فِٹنس روٗٹین بہتر کٔرُن چھُ۔
سارنی سۭتۍ کٔرِتھ اکھ کٲنٛہہ کُرۍ جان بوجھ کٔر مےٚ ہال وے منز ٹھوکر دِن۔
تُہہِ کُن چھِ پننِس پَڑوسِس منز کینٛہہ عجیب چیٖز لَگِتھ؟
مےٚ چھِ گۄڈٕ صحتِچ مُشکِلاتھ۔
تُہۍ کِتھ پٲٹھۍ لوٗکھ یِوان چھِ اُمید کَران؟
سُہ چھُ سٲری ژٕٹَن ہٕنٛز بھرِتھ۔
مےٚ چھِ لٲگن، اَسہِ ہٕنٛز دۄو ؤرۍ ہٕنٛز رِشتہٕ سٲری ختم گوٚو۔
بہٕ سٹیٖرِنگ سٲرۍ دِتھ، آٹوپائلٹَس دِتھ مےٚ ہٕنٛز کار چَلاون۔
کیا تُہۍ میونسِپَلٹیِس کُن شکایت کٔر؟
تِمَن ہٕنٛز فِکر کران چھِ مےٚ اکھِ یِوان ژٕل۔
اُف، مےٚ سۭتۍ نہٕ وُن!
چھُٹِس گژھنہٕ خٲطرٕ چھِ واریاہ جلدی۔
سُہ چھِ اکھ گۄڈٕ مثال۔
مےٚ سۭتۍ لٲگِتھ زِ سُہ تِم مےٚ ہٕنٛز بہٕنِس دِتھ آسِتھ۔
بہٕ دۄہَن دۄہَن ژٕلِتھ ٲسٕس۔
یِم کینٛہہ چھُ اَسہِ ہٕنٛز دُنیاہَس منٛز، تِمَن ہٕنٛز قٕدر کَرُن چھُ ضٔروٗری۔
بہٕ بیروزگار چھُس، تٔتھ مےٚ چھِ اکھ نوِ نوکری ضٔروٗری۔
مےٚ گوٚو مےٚ ہٕنٛز کُنجی چین یِم مےٚ ہٕنٛز نانی دِژ 10 ویں سالگرہِس۔
مےٚ ہُند لُکُٹ بھراوٕ جیلہِ گژھِتھ چھُ۔
مےٚ ہُند شوہر گوٚو کٲمِہٕ خٲطرٕ شہرٕ باہَر۔
سَمُنٛدَرِ کَنٛٹھٕ آرام کَرُن چھُ واریاہ سُہاون۔
گٔژِتھِس وُچھِس کٔرۍ اَسہِ تِمِچ سالگرہِس پارٹی۔
یِمِس مانٛہ چھِ مےٚ ہٕنٛدِس بابُس تہٕ مےٚ ہٕنٛز بہٕنِچ بَرٕسی یِوان۔
وال مارٹٕن ہنٛز پارکنگ لاٹَن منٛز نگرٲنی کیمرہ ٲسن۔
تُہۍ کُنہِ زبردست کلاس ژھانٛہِ گژھان؟
مےٚ پتہٕ چَل کہ مےٚنٛز بیٚیہِ سکولس منٛز دۄسرن بچن تنگ کران اوس۔
مےٚ سمجٕہِ سگان چھُس کہ یہِ کِتھ پٲٹھۍ گژھان۔
یہِ چھُ ہمیشہ اکھ احساس یُس مےٚ تھاوٕنٛچ کوشش کران چھُس۔
تُہۍ کَتھۍ بوٹِنگ کرن گژھان؟
یہِ چھُ اکھ تحفہٕ یُس تُہۍ مٔژ چھِ پیار کران تہٕ یہِ تُہۍ سٕتۍ پیار کٔرِتھ ہیکہِ۔
کال مےٚ سپرمارکٹس منٛز غُصہٕ ٲو۔
ارے، سُہ چھُ ضرور زبردست دِسان۔
کیا تُہۍ پولیَسن فون کور؟
مےٚ چھُس پنٛنٕنۍ ساتھی سٕتۍ خاص ڈِنرس خٲطرٕ بے صبری سٕتۍ واتٕنظَر۔
زنٛدگی چھُ نہٕ ہمیشہ برابر طریقس پیٹھ گژھان، اسہِ چھُ پنٛنہِ حالتن ہنٛز بہترین استعمال کٔرُن۔
مےٚ چھُس سمجان کہ مےٚ تہِ یہِ واتُن گژھِ۔
تُہۍ چھِو کینٛہہ خاص کران تَمہِ خٲطرٕ؟
کام چھُ واریاہ زبردست تہٕ واریاہ پیسہٕ کمان چھُ۔
ہاں، مےٚ چھُس سمجان کہ مےٚ چاپلوسی کرنٕچ مشق کرُن گژھِ۔
مےٚ اوس سُنےمُتھ کہ طوفان یِوان چھُ تہٕ مےٚ ژٕٹٕچ ڈر وُتھ۔
مےٚ چھُس خود جانورن ہنٛز مٔژ پیار کران۔
مےٚ اوس اَتھ حیران گژھمُت کہ کینہہ وۄقت مےٚ ہٕنٛز زبان بند ٲس۔
مگر کُنہِ کُنہِ چھُ یہِ اَسہِ پٲٹھۍ گژھان۔
مےٚ پٲٹھۍ ٹیسٹَس منٛز ۱۰۰ نمبر گژھ
نَہ، فیس بُک چھُ شیطان
