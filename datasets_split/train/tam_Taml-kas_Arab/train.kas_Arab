نہٕ یہِ اکی، مگر مےٚ ہٕنٛز چہرٕ چھُ واریاہ سُرخ گژھان۔
مےٚ چھُس یِتھ منز واقعی ماہر تہٕ مےٚ چھُس بنٛاون اگلہٕ ڈیوڈ کاپرٕفیلڈ۔
تِہنٛدِس طٔرح تۄہہ بلیک میل کرُن ہٕچ کوٗشش کٔرتھ چھِ سُہ واریاہ خود غرض لٲگن۔
مےٚ ہٕنٛز برونٛہہ کراتہٕ منز چیمپین شِپ جِتھ۔
کیا یہِ چھُ پہلِی وٲر؟
اوہ واہ، تِہنٛدِس یہِ کٔرنس منز چھُ کانٛہہ خاص وجہ؟
تُہہِ کِیاہ چھِ ونان زِ یہِ نہٕ یِیہِ؟
مےٚ چھُس پٲٹھ یقین زِ أسۍ شیٖن ٹھیک کٔرتھ تہٕ خوش روزِتھ ہیکو۔
تُہٕنٛز مالی صحت تہِ چھِ اَہم۔
مےٚ کٔرِہ کوشش زِ تِہنٛدِس ساتٕھ سچ روزٕں تہٕ وونٛہِہ زِ یہِ تۄہہِ بے آرام کٔران۔
فورڈ مستانگ، یہِ چھُ ڈرٛیو کٔرنس منز واریاہ مزٕدار گاڑِی۔
مےٚ چھُس تِہنٛدِس سۭتۍ واریاہ تنگ یِم روز مےٚ ہٕنٛز لانٛچِس باہَر کُڑٕ پھینکاں۔
مےٚ چھُس یِمِس پٲٹھ واریاہ خوش۔
پڑھٕنۍ چھِ اصل منز سبزنٛہہ بڑٕ حصہٕ۔
تِہنٛہِ کٔر سٲنۍ فریزر کھُلہٕ تہٕ سٲری پاپسِکٕل گٔیہِ پگلاوٕنۍ۔
مےٚ چھُس خوش زِ سُہ گٔیہِ پٲٹھ۔
سُہِ دۄہِ کٲمَس پٲٹھ مےٚ ہُوٚر ہُوٚر سٲرنی ہُنٛد کٲم کٔرُن پٲوان۔
یِم چھِ واریاہ بڑِ ذِمہٕدارِی۔
واہ، یہِ چھُ اکھ زبردست کامیابی۔
مےٚ جنم دِوَس پؠٹھ میٛٲنۍ والدین دِوان مےٚ اکھ ٹھیک ٹھاک رقمک چیک۔
مےٚ امیٖد چھُ تُہٕنٛد کُتہٕ ژٕٹِتھ ٹھیٖک گژھِ۔
تِمَن چھُ خراب ریٹنگ مِلان۔
اَز مےٚ اکھ پورٛٲن ڈایری دِژ، یتھ منز مےٚ کم عُمرِس منز لیکھمتھ۔
کیشیٲر آسَن سُست کٲم کران۔
اگرچہ مےٚ چھُس تِمَن خٲطر خوش، مگر مےٚ تِمَن بۄنٛہہ واریاہ یاد کَرُن۔
اچھا، مےٚ حٲصِل کٔر اکھ نِنٹینڈو سِوِچ تہٕ کینہہ گیم یم مےٚ چاہان۔
یہِ سچٕے خاص تہٕ جوشٕ بھرِتھ تجربن ہٕنٛز ژٕل۔
مگر زبردست کِچنٕک سامان ضایع گژھُن چھُ افسوسک۔
مےٚ چھُس ترجیح دِوان سٲری کٲم خۄد کرٕنۍ، تاکہ مےٚ لَگہِ کَنہٕ الزام دِیُن۔
مےٚ چھِ کینہہ تِمَن منز تہٕ ہارڈبیک کتابہٕ تہِ۔
کینہہ دۄہ پیٚٹھ مےٚ خبر پٲیہ کہ مےٚ بہنِس چھِ جڑواں بَچہٕ گژھان۔
اَتھ مےٚ کٔرِ کٲم پؠٹھ دھیٖان۔
اَس ہفتہٕ مےٚ بیٚٹی ہایِسکول شروع کٔر۔
شاباش، تُہۍ سُہ یاد تھٲوِو۔
مےٚ چھُس بُزھان تُہۍ کِیاہ وَنان، کیازِ مےٚ تہِ چھُس تَمہِ کٲم کران۔
مےٚ چھُس نہٕ یقینی تہٕ کموڈور چھُ کِیاہ۔
تِمَن دوبارٕ دِتھ مےٚ لٲگ اِتھ خوب، واریاہ وقت گٔی آ۔
شاید تُہۍ تِمَن دِیِو اکھ تحفہٕ تہٕ کینہہ مِٹھٲیۍ، تاکہ یہِ کَمی پُر گژھِ۔
مےٚ چھُ سۄرٕے افسوس زِ تُہۍ سۄ ساملاوُن پٲٹھ۔
مےٚ کٔر فیصلہ زِ مےٚ پنٛنِس گَرِس منٛز رٔہِتھ ہاریکین سامنٕے کَرُن۔
سُہ چھُ سچ، شاید مےٚ نَہ گژھِ پنٛنِس پٲٹھ اِتھ کَٹھ کَرُن۔
مےٚ گٔژھ بھُلِتھ کٕنہِ کَرُن پنٛنِس سٲری یارُک جنٛم دِنُک خٲطرٕ۔
مےٚ چھُ افسوس سۄن پٲٹھ۔ کِیا سۄ نِزدیٖک گٔے یا کُنِہِ بیٚیہِ شہرِ گٔے؟
یَتھ مےٚ ہؠوٗ 25 وریٚن پتٕہِ سکوٗلِس منٛز داخٕل گٔے۔
یہِ چھُ سُہُن منٛز زَنِہِ کمالُک دۄہ بَرٕ پروگرام، اُمید چھُ تُہۍ مزٕ کَریو۔
بہٕ کٔر غلطی سۭتۍ تھوڑِ دیر پٲٹھ پنٛنِس کُتُرُک دُمٕس پؠٹھ پٲنٛز، تہٕ مےٚ سُہِ پٲٹھ سٲری وٲنٛگ لٲگ۔
مےٚ چھُ ڈر زِ سُہ کَری ہٕل ہمساٮ۪ن ہُند بٮ۪لین قتل۔
مےٚ چھُ لگٕان زِ آو چھُ فقت عادت گژھِتھ۔
اگر تُہۍ چھِو نہٕ خراب ڈرٛایِور، تہٕ یِہِ پٲٹھ گھبرٛاوُن چھُ لَگٕان یِہِ بیٚیہِ سُہ کار۔
مےٚ سۭتۍ تہِ یِہِے آو پَتٕہ۔
کِیا سُہ ژٕل واپس آو؟
آ، سۄ کٔر؛ کینسرن کٔر سۄ دوٚن وریٚن گژھِتھ۔
شاید آو چھُ وقت نٔو پرٛنٹر گژھٕنۍ۔
کٲم ژٕڈُن، کٲرُبارِ پؠٹھ کٲم کَرُن تہٕ کوٗشش کَرُن زِ سُہ مےٚ پٲٹھ حاوی نَہ گژھِ۔
یِہِ چھُ کَٹھِ زِ مےٚ نَہ ہٕہِ کُنہِ پٲٹھُک سفر کَرُن یِتھ جلدی۔
مےٚ کٔر پنٛنٕے سۭتۍ چال زِ مےٚ ژٕٹِتھ بچت کَرِ، جان بوجھ کٔر زیادٕ پیسہ دِتھ۔
مےٚ نَہ ہٕہِ یِہِ ٹھیٖک کَرُن۔
اگر تِم رَن نَہ کَرِ تھٲوی، تہٕ مےٚ یِہِ سۭتۍ زٕبٲن دِل شِکستٕہ گژھِ۔
لگہِ چھُ کہ ٹرمپس منز، یُس وُنتھ تٔمۍ، معیشت زبردست ترٛقی کران چھِ
یہِ چھُ کینہہ ڈراون یِم بارے سوچُن
بہٕ چھُس ہمیشہ تٔمس سالگرہِ فون کران تہٕ أسۍ چھِ دۄپہرۍ کھاون کھان گژھان
بہٕ کٔر آنلائن پینٹ آرڈر یُس مےٚ لگِتھ فِٹ گژھِ، مگر سُہ نہٕ گٔیہِ فِٹ
پَتہٕ بہٕ نِہٕ کٔھہِ تٔمِس دوٚبارٕ دۄن
آ، بہٕ چھُس گژھنس منز زبردست جوش منز
واریاہ، مےٚ چھُ یہِ واریاہ پسند
کینہہ ویز چھُس مےٚ لَگن زِ خوش تہٕ تندرُست بچہٕ حاصِل گژھُن چھُ مےٚ باپت برکت
مےٚ چھُ امید زِ سُہ سچ نہٕ آسہٕ، کیازِ اگر سُہ سچ آسہٕ تہٕ سُہ چھُ واریاہ گِھنون
مےٚ چھُ یقین زِ یہِ چھُ سُہ وقت یَتھ منز تُہۍ پنُن سٲری محنت کامہِ لَگان چھِو
بہٕ چھُس وٕنکیٚن یتھ ممکن گژھِ، کینہہ وقت کٔڈتھ چرچ سروسس منز شامل گژھنچ کوشش کران
مےٚ کٔر کینہہ فوٹو یِم مےٚ گرل فرینڈن بھیٚجِ، اکھ دوستس نِشان، یوتھ تِم نجی تھاون ضٔروری آس
کینہہ بھونکن وٲلۍ کالرس یا شاید کینہہ ٹریننگ پٲٹھۍ نظر کر
بہٕ چھُس تٔمس واریاہ شکرگزار
مےٚ آوِ سٹرٛابری شارٹ کیک کریمسکل پسند
مےٚ نزدیٖکی دوستن مےٚ کَنۍ چوری کٔر، بہٕ چھُس واریاہ اداس
یہِ چھُ کُتُرٕ کَتھ نسلُک
مےٚ بچہٕ وُنو، کیازِ ییلہِ مےٚ سٲری طرح زخم گژھِ ہٲ، تیلہِ بہٕ روٚن لٲگ
گرٛمیَن ہنٛز کلاسہٕ چھِ مُشکِل گژھِتھ
مےٚ گرل فرینڈ کران چھُس واریاہ خوش، تہٕ بہٕ کیازِ وٕچھہٕ تِم ژٕلُن
بدقسمتی سۭتۍ مےٚ کٲنٛہہ اَسہِ ڈینٹسٹ نہٕ لبان یُس قسطن منز پیٹھہٕ رقم ژھٔتھ، لہٰذا یِہِ چھُ یِہِ۔
مےٚ یہِ لُکھ زَن حٲصل کٔر یِہِ چھُ ضٔروٗری زِ زندگی ہٕنٛز واقعاتن پٮ۪ٹھ بھروسہٕ کٔرِتھ تہٕ قبول کٔرِتھ۔
دُنیا چھِ سونٛچ تِمنٛد ختم گژھُن۔
کیا تُہۍ حٲصِل کٔر کینہہ تنبیہہ تُہٕنٛدِس غیر ذمہ داری خٲطرٕ مینیجمنٹ کَنۍ؟
مےٚ چھُ ابھی ابھی کوکیز ہٕنٛد پورٕ پیکٹ کھٲد۔
ہاں، کم کھیلِتھ محنت کٔرُن چھُ بہتر، مےٚ چھُ لگن۔
ہاں، سُہ کٔرُن آوٕ صحیح۔
ٲسۍ أک ریسٹورَنٹ منز اکھٕ ساتھ سرور ہٲوِتھ کٲم شروٗع کٔر۔
پٲلِو جانور ژھٲرُن چھُ واریاہ مُشکل۔
مےٚ ہٕنٛز پڑوسِس چھُ حالٕے منز اکھ بچہٕ زٲمُت۔
مےٚ ژٕٹ کٔر اَپٕنِس سکولس منز گژھمُت انڈٕ نگلنس مقابلہٕ منز پہل جایزہٕ۔
عام طور پٮ۪ٹھ یِم چیٖز چھِ مقبولیتُک مقابلہٕ۔
مےٚ چھُ معاف کٔرِتھ، مےٚ چھُ یقین زِ سُہ چھُ صرف نِہ گژھنہٕ مصیبتس منز خٲطرٕ نیک بنان۔
مےٚ چھُ یقین نہٕ یوان زِ مےٚ گژھِ یِمن لوٗکن ہٕنٛز اکھ یُس اَپٕنِس فون بغیر ژٕندٕ نہٕ کٔرِتھ ہٲوِ۔
یار، مےٚ ہٕنٛد ہفتہٕ چھُ واریاہ شاندار گژھِتھ۔
ہاں، مےٚ ہٕنٛدِس ژٔنٛگ تہٕ سرس پٮ۪ٹھ کُل ۶ ٹانک چھِ۔
ہاں، مےٚ چھُ لگٲن زِ ٲسۍ یِہِ وُنِس یِتھٕے ختم کٔرِتھ۔
مےٚ امید چھُ کِ شو آوٕ گوٚڈ۔
سپیٖچ چھِ کِس متعلق؟
مےٚ چھُ پتہٕ شےٚ تہہ ہٕنٛد بین ڈِپ بناوُن۔
بہٕ نَو دُکان د۪یٹھن گٔژھمُت
مےٚ پنٛنۍ پُران ہای سکول یونیفارم پنٛنٕن ہؠنٛزن گَرِ مٕلۍ
تَتھ ٲس اکھ قیمتی گُلدان، یُس مےٚ غلطی سۭتۍ اُلٹٕو
اوہ نہ، مےٚ اُمید چھُس زِ تُہۍ تِم مٕلۍ تہٕ سُہ ٹھیک چھُ
مےٚ یاد چھُس سُہ وقت ییلہٕ بہٕ تھوڑ ٲس تہٕ میٛانہِ والدینن میٛانہِ میلہِ نیٚتھ
کیا چھُ تُہنٛدِس کُن فوٹو ایلبم یَتھ منز تُہۍ تِم تھاوِو
تِمن ہٕنٛز ناو چھُ ‘فاؤنٛڈ ا جاب’، تِم ٹاکِنٛگ ہیڈزن گانے کَور کَران
کتابس ناو کیا ٲس
پَتہٕ دۄہ میٛانِ باسن میٛانہِ سٕتۍ حقارت سان کٔر گپ، یِمَن کٔر مےٚ بٔڈ پٔریشان
اَز مےٚ ژٔتھ کَپ آیس کریم کھٲد
ییلہٕ ہریکین تُہنٛدِس علاقس پٔتھ، کیا تُہۍ محسوس کٔر زِ تُہنٛدِ حفاظتی انتظام تِمس طاقتہِ کھۄتہٕ مضبوط ٲس
پَتہٕ دۄہ بہٕ ٹریفِک منز ٲس
مےٚ چھُ یقین زِ تُہنٛدِس اگدِس واریاہ چھُ
میٛونۍ بیٹی ژٔٹ پٲٹھۍ وُڈ چھِ گژھان
واریاہ پیار چھُ، تُہنٛدِ خٲطرٕ چھُ سُہ گژھِتھ
آ بٔڈ خَرٕچ چھُ تَتھ پٮ۪ٹھ
سُہ میٛٲنِ نانہِ گھڑی ٲس
سکول شُروع گژھنہِ خٲطرٕ بہٕ کَتھٕچ نہٕ اتھ پٲٹھۍ تیار ٲس
تُہۍ میٛونۍ پٮ۪ٹھٕنۍ صحن د۪یٹھو
یِم چھُ ہر بار مےٚ غُصہٕ دِوان
یہ چھُ بہٕت زبردست زِ تُہٕنٛد بیٚیہِ اتھ ذمہٕدار چھُ زِ تُہٕے تِمۍ پنُن ڈیبٹ کارڈ بھروسہٕ کٔرِتھ دِتھ ہیکیو۔
واہ، یہِ چھُ زبردست!
مےٚ چھُس اَمہِ پٲٹھۍ کافی نروس۔
یہِ چھُ گژھان، کم از کم تِمۍ چھُ تَمہِ منز کٲنٛہہ شیکھمُت۔
نَہ، صِرف گُلاب تہٕ اَکھ بیٚیہِ قِسم۔
یہِ اوس بہٕت محنت، مگر مےٚ چھُس خوش زِ آخرکار مےٚ ہٮ۪کۍ دوبارٕ ڈرٛایِو کٔرِتھ۔
شاید سُہٕ چھِ یژھان زِ تُہٕے گٔژھِتھ تِم دُرُست کٔرِو۔
اگر یِتھ چھُ، تُہٕے گژھِ تِمۍ سٕتۍ یہِ گژھٕنۍ گژھاون۔
مےٚ دۄہہ ہٕنٛز اَکھ کار دِژ زِ سُہٕ مےٚ بہٕت پسند ٲس۔
مےٚ اوس ؤنٛدٕس ٹیٖچَرَن یا پروفیٖسَرَن یتھ شِیٖتھ ہٮ۪کِو اطلاع۔
مےٚ تہٕ میٚون دوست چھِ بیٖچَس گژھان۔
آ، مےٚ اوس بہٕت محنت کٔرتھ پرٛان، یِتھ کٔنۍ مےٚ اوس لٲگِتھ زِ مےٚ چھُس امتحانَس خٲطرٕ تیار۔
ہا ہا، راتِس ڈرٛاونۍ کہٲنِۍ پرٛاون چھُ واقٕعی ڈرٛاونُ۔
کیا باہر اوس واقٕعی موسم سُہاوُن؟
آ، مےٚ ہٮ۪کۍ تَمہِ کٔرِتھ۔
مےٚ چھُس پنٛنِس دادٕکۍ کیڈِلٮ۪ک وِکٲونِس مُشکِل لٲگِتھ۔
اگر تُہٕے یِتھ سُہٕل پٲٹھۍ نٮ۪و، شاید اَکھ تھوڑا پرایویٹ وقت گژھِ فائیدٕمَنٛد۔
نَہ، مگر مےٚ چھُس پنٛنِس دوستُک جِیپَس منز گژھان تہٕ یِتھ چھُ لٲگِتھ زِ گویا ٹینکَس منز چھُس، ہا ہا۔
مےٚ چھُس یقیٖن زِ تُہٕنٛد باس گژھِ یژھان زِ یہِ کٲم سُہل پٲٹھۍ گژھِ، نہٕ زِ ژھٹ پٲٹھۍ۔
تِمۍ کٔر شٲف مِکیٖزَس منز مےٚ پرٛوپوز، یِتھ منز میٚون سٲری پسندیدہ ڈزنی کردار ٲسِتھ۔
اوہ، یہِ سٕنِتھ دُکھ ژٕل۔ کیا یہِ اَکیٛاہ اوس؟
اگر بہٕ تٔمۍ سچ وُچھم، شایٚد مےٚ نوکری گژھِ، یِمنۍ بہٕ ژوٚٹ وُچھ۔
پہلی دفعہ بہٕ پنٕنۍ بیٹی پٲٹھۍ تِمۍ سہیلیٛن سٕتۍ سکولُک سامان ژٕنٛنٕچ خٲطرٕ روان کٔر۔
ہاں، بدلٲو مےٚ خٲطرٕ واریاہ مُشکل چھُ۔
مےٚ پٲٹھۍ رٔہن والٕن وُن مےٚ تِمَن ہٕنٛز بچہِ سنٛبھٲلُن۔
ییلہٕ ‘د آفس’ ختم گوٚو تہٕ اَتھ چھُ بلکل دۄیم شو، بہٕ روٚدم۔
مےٚ اوس یقین زِ بہٕ ڈرٛایونگ ٹیسٹ پاس کرٕنۍ۔
تٔمۍ پنٛنۍ گاڑِی واریاہ پیٛار چھُ، یہِ چھِ تٔمۍ بچہِ سٕنز پٲٹھۍ۔
یہِ چھُ اَکھ دلچسپ نُکتہ، بہٕ یہِ ہٕنٛز پَتہٕ لٲگِتھ۔
اَتھ چھُ ہمیشہ دۄیم موقع، تٔمۍ چھُ فقت ژیٚادٕ محنت سٕتۍ پٲرُن۔
شایٚد اگر بہٕ فقت اَکھ وار کوشش کرٕ، مےٚ یہِ پسند یِو۔
مےٚ مٲج مےٚ کروز پٲٹھۍ نٮ۪وان چھِ۔
مےٚ بیٹی چھِ واریاہ بدتمیز۔
واہ، وۄنۍ مےٚ پٲرۍ کٔر مےٚ بلکل مایوس۔
مےٚ چھُ گمان زِ ییٚتہِ بہٕ رٲوان چھُس، تَتھ یہِ واریاہ بہتر گژھِ۔
تُہۍ کروز پٲٹھۍ کُتھ کُن گژھان چھِو؟
تھوڑٕ پٲٹھۍ مےٚ اَکھ دوس اوس، مگر وۄنۍ بہٕ چھُس بلکل اکیٛاہ۔
تٔمۍ پٲٹھۍ تٔمِس کَتھ پٲٹھۍ چھُ؟
ییٚتہِ کیٛاہ گوٚو، تَتھ خٲطرٕ بہٕ چھُس وۄنۍ تہِ واریاہ پریشان، مگر مےٚ چھُ فقت یہِ بٲتھ پٲٹھۍ تٔرُن۔
وۄنۍ مےٚ کٕنہہ بیٚیہِ ژٕنڈُن چھُ تہٕ سکوٗل شروع گژھن وٲلۍ چھِ۔
تُہۍ کُنہِ قٕسمچِ مستی کٔرِتھ یاد چھِ تِتھ؟
ٹھیک چھُ، وۄنۍ مےٚ بوز کیازِ تُہۍ خوش چھِو۔
کیا تُہۍ واقٔعی نشہٕ ہُند اثرس منز اوسِو؟
پنُنِ خٲطر کھڑُن چھُ بہتر۔
یِمِس منز تُہۍ گژھِوَان گۄچھ، سُہ کُس چھُ؟
کیا یِمۍ تُہند ٹینشن کَم کٔرِتھ مدد کٔر؟
تِمنٛۍ مےٚ گٔژھِ راتھ باہر رَن کران تہٕ مےٚ محسوس کٔر کیازِ مےٚ پٲنٛٹ رِپھ گٔی۔
آہ، شُکریہ تہٕ ہاں، سُہ چھُ۔
مےٚ وۄنۍ چھُ نظر پٲوان کیازِ کُنہِ کٔر مےٚ کارس پارکِنگ لاٹس منز پٲٹھۍ کھوت۔
آ، مےٚ کٔر ژٕنٛگٕلِچ کُنہِ اوندھ گژھان واتھ پٲٹھۍ۔
مےٚ ۸۰ ہُند دَہَکَس منز پٲٹھۍ گژھِتھ۔
دُر، وۄنۍ مےٚ غلطی کٔر۔
مےٚ چھُ لٲگِتھ یِہِ رشتہٕ صحت مند نہٕ چھُ یَتھ منز مےٚ چھُ۔
کیا تُہۍ کُنہِ ساتھ یِم قٕسم محسوس کران؟
واہ، سُہ چھُ زبردست گاڑِ!
مےٚ چھُ فلمَن دِژھِتھ گژھُن زٕبردست پسند۔
مےٚ چھُ کانٛہہ پتا نہٕ یُہ کُتھ چھُ، مگر یِہ چھُ پردیسی سٲنۍ آواز دِوان۔
آ، مگر کم از کم تِم چھِ تُہۍ واریاہ دِژھان، تِمنٛۍ سۭتۍ تُہۍ کٔرِتھ چھِو کُنہِ محبت تہٕ پیار۔
آہ نَہ، کۄتاہ خوفناک خواب!
کام پٲٹھۍ برونٛہہ مےٚ ژٕلۍ منز پٲٹھۍ گژھ تہٕ سٲریو ژٕلۍ ژٕلۍ پٲٹھۍ پٲٹھۍ پٲٹھۍ پٲٹھۍ
مےٚ چھُ نہٕ اتھ پٲٹھۍ پیسہٕ زِ مےٚ دوٗنٛۍ منز کینہہ کٔرِتھ ہیکہٕ، تمہِ وجہہ سۭتۍ مےٚ بس دٔرد سٕنٛگتھ ژٕٹہٕ ژٕٹہٕ گژھُن پَتہٕ
تُہۍ سٲریو کٔر جشن سُہلۍ
مےٚ سُہ ہفتہٕ ختم گژھنُک انتظار نِہ کٔرِتھ ہیکان
مےٚ چھُس محسوس کران زِ شوٗ پٮ۪ٹھ کَیٹفِشِنگ تھوڑا کم گٔیہِ
مےٚ پٮ۪ٹھ چھُ تہِ تَتھ پٲٹھۍ اَکھ شرارتی تہٕ چُھپتھ چُھپتھ پھِران وُہل کُتُہ
پتہٕ چَل زِ سُہ دۄہَرُک کھٲنہٕ اوس
مےٚ کدٕنہٕ نِہ وٲن زِ یہِ گژھِ
اَز مےٚ کینٛہہ سامان خرٕد کٔر تَتھ کَس خٲطرٕ یُس مےٚ عزیز چھُ، اگرچہِ کَتھ کَتھ ژٕ سُہ سنٛبھٲلُن مُشکل گژھان
ہا ہا، یِمن چھِ ضروٗر زبردست باورچی
زیادٕ تر لوٗکھَن چھِ physics ہُنٛد ہِجٕ تہِ نِہ لِکھِتھ یِوان
کینہہ دۄہ برونٛہہ مےٚ جِم منز وزن اٹھاونُک پنُن ریکارڈ توڑ
بدقسمتی سۭتۍ مےٚ پٮ۪ٹھ چھُ صرف ۲۰
مےٚ وُچھ سُہ تُہۍ چھِو اَز کامہٕ پٲٹھۍ رٕخصت گژھان
یہِ چھُ واریاہ سُہل، مےٚ نِہ اوس یقین زِ مےٚ منظوٗری مِلِ
مےٚ ہٕنٛزِ زَنہٕ چھُس خبر زِ مےٚ کِتھ پٲٹھۍ یِژھان اوس اَکھ بلٕی ہُند ژوٗر
