مےٚ راتِس سڑکَس پٮ۪ٹھ گاڑِ چَلاوان آسِ، تہٕ مےٚ گاڑِ گٔی بند۔
مےٚ چھُس یقین زِ تِمَن کٔرِ سُہِ تہِ بَہت قَدَر۔
اَمہِ ؤرۍ خٲطرٕ مےٚ ۱۰ دۄہن ہُنٛد رخصتِی فائدو مٕلِتھ۔
مےٚ سٲری کٲم پیک کٔرِتھ روان گژھنہِ خٲطرٕ تیار چھُس، تہٕ نوٚو گھر تہِ واریاہ پٲٹھۍ صاف کٔرمت۔
بےٚ چھُس نہٕ تُہۍ مُلامت کَران۔ تُہۍ چھِو رِویو وُچھمت؟
اَتہٕ ہفتہٕ بہٕ چھُس روڈ ٹرِپَس گژھان، تہٕ گژھِ کلُس سۄ وار تیٚلہِ تیٚلہِ تیٚلہِ تیار گژھنس منز۔
ہاں، تہٕ تِمَن ہٕنٛز تہِ سمجٲویو زِ تُہۍ چھِو محسوس کٔرمت زِ تُہۍ یہِ کٔرتھ اوسِو۔
زنٛدگِی منز کُنہِ سُنٛد کَتھٕ نہٕ آسُنہِ خٲطرٕ کِیاہ چھُ کَرُن پٲوان؟
کِہِ چیزَن تُہۍ پٲٹھۍ اَوس محسوس زِ تُہۍ کُنہِ اِنٲم مٕلِتھ؟
گژھِو، آرام کٔرِو تہٕ پنُن دِل دوٚیِم کینٛہِس منز لگٲویو۔
سُہ یا چھِ مُرتھ، یا چھِ نہٕ تُہُنٛد گرل فرینڈ واریاہ۔
پرٛٮ۪تھ رات مےٚ گوٚو آسُن فُٹبال میچ وُچھنہِ۔
سُہ گژھِ مٕزٕ دِوان وَخت، کُنہِ کُنہِ چھِ ژٕوٗر وُچھُن سُہان۔
حالِس منز کُنہِ آیہِ مےٚ گھرِ منز کٲم کَرنہِ خٲطرٕ واریاہ پیسہٕ دِنہِ ہُنٛد آفر کٔر۔
پٲٹھۍ وار سُہ واریاہ سُہان نہٕ گژھ۔
کیا تُہۍ چھِو سَرکَس سُہان؟
سُہ چھُ سۄ کٲم سٲری ویز کَران۔
تہٕ سُہ چھُ لگٕنۍ زِ تُہۍ کُن دۄن چیزن ہِنٛد فائدو چھُ۔
شُکریہ، مےٚ چھُس تہِ تَمہِ آس کَران۔
مےٚ چھُس محسوس کَران زِ مےٚ چھِ سُہ پیٹھۍ نوٚو کار مٕلُن۔
مےٚ یِمۍ پوسٹَس خٲطرٕ درخٲست کٔر، سُہ پوسٹ مےٚ نہٕ مٕلِتھ۔
ویک اینڈس منز مےٚ وُچھِ اَکھ واریاہ دُکھی فلم تہٕ مےٚ محسوس کٔر زِ مےٚ چھِ پنٕن والدین ہٕنٛد شُکرگُزار۔
کم از کم تُہۍ پانہِ یہ یادٕ ہمیشہ آسن زِ پَتھ نظر کٔرِتھ۔
مگر بہٕ چھُس نہٕ ژَگڑٕ شروع کَرُن یژھان۔
یعنی تُہۍ کَری سخت ورزش۔
بہٕ چھُس حالیہ وقتس منز واریاہ خوش، لگنہٕ چھُ آخرکار سٲری کینٛہہ ٹھیٖک جاے پٲٹھۍ گژھان۔
خاندٕن چھِ واریاہ بِیہتر، تِم چھِ ہمیشہ مدد تہٕ محبت دِکھاونہٕ خٲطرٕ موجود۔
اگر تُہۍ چھِ اَکروبیٹ پسند، تُہۍ سُہِ دلہٕ پسند کَران۔
اوہ، تہٕ سُہ چھُ ٹھیٖک۔
والدین بنُن کیٛاہ چھُ چَلان؟
تِمۍ سۭتۍ معلوم کَرنہٕ خٲطرٕ بہٕ کٔر ایک پھَندٕ تیار۔
بہٕ چھُس جانان زِ تِم میٚہِ کَنہِ نقصان نہٕ کَران، مگر کانٛہہ وجہِ سۭتۍ چھُس بہٕ تِمَن سۭتۍ واریاہ ڈَرِتھ۔
تُہۍ یِوان اکھ گوڈ جواب۔
تُہۍ کیٛاہ؟ تُہۍ کِنہِ وول لَجٕک بچہٕ آسِو یا تُہۍ سٲری وقت چھِس ایکسٹروورٹ؟
اگر بہٕ آسِو، بہٕ گژھِو واریاہ ڈَران۔
بہٕ کٔھ آخری ژٕ کوکی یَتھ جارَس منز آسِتھ۔
سُہٕ اوس اکھ گوڈ احساس، سُہٕ ہٕنٛزۍ واریاہ پُرانہِ یادٕ واپس۔
فُٹبال ٹٕیم سۭتۍ کَتھ کَرنہٕ خٲطرٕ فُٹبال کوچَن کٔر میٚہِ دعوت۔
گھرٕ آمتھ میٚہِ دِژ سٲری خاندان یِتھِ، تہٕ اکھ گرم برتن اوس چلان۔
واہ، میٚہِ ہُنے ہُنے سُہٕ عجیب چیز معلوم گٔے۔
بہٕ چھُس صاف منع کَران زِ پنٛنِس ہمسایہِ ہٕنٛدِس گَرَس منز بہٕ واپس گژھٕن۔
بچٕ چھِ واپس سکوٗل گژھان۔
بس یہ اُمید چھِ کہ بہٕ حل گوٗگل کٔرتھ پنٕنہٕ مصروف کامس منز واپس گژھٕ ہٲو۔
شاید تُہۍ یہِ زیادٕ سوچان۔
مےٚ یِمۍ چھِ واریاہ زبردست، یِمۍ مےٚ ہٕنٛد گھر صاف کوٚر ییلہٕ بہٕ کاروبارٕ سۭتۍ باجس اوس۔
مےٚ چھِ تھوڑا ڈر نٔو جایہِ منتقل گژھنہِ سۭتۍ، تبدیلی چھِ مےٚ زیادہ پسند نہٕ۔
مےٚ ہٕنٛد باس مےٚ نہٕ دِوان اوس اتوارُک کام، ییلہٕ أسۍ چھِ ڈیوڑھ گُنا اجرت یوان۔
میتھ چھِ ہمیشہ مےٚ ہٕنٛد کم پسند مضمون آسُن۔
کیا چھِ پانٛسۍ تُہٕنٛز پٮ۪ٹھ آمت؟
مےٚ ہٕنٛد باسس چھِ کینسر، تمی تھٲوِتھ کرنہِ سۭتۍ کام آسان بہٕ واریاہ محنت کٔرتھ اضافی کام کرنُک کوٗشش کران چھُس۔
اوہ واہ، یِمنٛز خاطرٕ بہتھ نیک تمنائیں۔
واہ، یہِ واریاہ پیچیدہ سونٛچِتھ چھِ۔
صدمس پیٚٹھ صحتیاب گژھنُک کوٗشش کَران تَتھ متعلق خواب دِکھن چھِ واقعی ناگوار۔
ییلہٕ مےٚ ڈٕگ مٔژ کینٛہہ کٔنہٕ پنٕنہٕ گاڑِس منز ڈینٹ کران، بہٕ اوسُس غصہٕ۔
کھٲنس منز زیادٕ نمک نسبتھ کم نمک چھِ ہمیشہ بہتر۔
مےٚ چھِ ڈر زِ مےٚ ہٕنٛز بیٹی وُڈ گژھِ تہٕ خراب گژھِ۔
ظٲہر چھِ زِ تمۍ یژھ کینہہ کٔر، مگر تمۍ نہٕ ہٲو تِمۍ نِنٛدرِ پٮ۪ٹھ جاگٲوتھ۔
مےٚ اوسُس اُمید مےٚ ہٕنٛد برادَر کٔرِ سکولس پیٚٹھ مےٚ نِن، مگر سُہ کینہہ نہٕ آو۔
مےٚ ہٕنٛدِس پاس آرام کرنس تہٕ کام پورٕ کرنس خاطرٕ واریاہ وقت آسِ۔
گٔژِ راتھ پارکِنٛگ لاٹس منز کٔنہٕ مےٚ ٹکر دِتھ، کیازِ تِمۍ پنُن آئنہٕ نہٕ پیٚٹھ۔
کَتھ کَتھ باجس کھاون چھِ موڈ بدلٲونہٕ خاطرٕ لازمی، خوشی گژھِ زِ تُہۍ مزٕ کٔر۔
گٔژِ راتھ مےٚ ہٕنٛد کُتُرٕن قالینس پیٚٹھ پوٹی کٔر۔
تہٕ، سُہ کِتھ پٮ۪ٹھ پیٖٹھ چھُ؟
تہٕ، کِیاہ تُہٕنٛدِس نوکری ہُنٛد آفر گژھ؟
یِتھ پٲٹھۍ کھٲنس سٕتۍ تِمَن یِہِے چھُ مِلان۔
بہٕ اوس اتھ پٲٹھۍ مزٕدار کھٲد، اَسہِ وٕنۍ تہِ چھُ پیٖٹھ تہٕ مزٕدار لٲگِتھ۔
یِم لاٹری ٹِکَٹ بہٕ گژھ راتھ کٕرِتھ، سُہ ژٔٹ نہٕ۔
مےٚ ؤتھ پٮ۪ٹھ لٲگ یِہِ میون پسنٛدِیدہ ٹی وی شو کینٛسل گژھ۔
یِلہِ بہٕ آخرکار نوکری تٕرِتھ زنٛدگِس منٛز پنُن رٲستہٕ ژٕٹن ہُنٛد فیصلہ کٔر، مےٚ اوس اطمینان۔
آخرس سُہنٛ کٔر مےٚ اَتھ پٲٹھۍ دِتھ یُس کٕرِتھ بہٕ کٕلاس پاس کٔرِتھ۔
کیا تُہۍ چھِوٗ معلوم، اَکھ عام اِنسان چھُ رٲتۍ نِنٛدِس منٛز ہر سال ۴ مَکڑِ کھٲوان؟
شاید تُہۍ اکھ دۄہس خٲطرٕ ٹویوٹا بدلِتھ ہٮ۪کو، ڈی۔
میون لٔڑکۍ خوش نہٕ اوس۔
سُہ چھُ ہمیشہ یِتھ پٲٹھۍ مزٕدار، تہٕ بچو چھِ یہِ پسند کران زِ تِمَن دِژھن خٲطرٕ لُکھ یِتھ پٲٹھۍ آسَن۔
مےٚ چھُ یقین زِ تُہۍ نِہٕ دِیِو یہِ دوبارٕ گژھِتھ۔
مےٚ چھُ اُمید زِ تُہۍ امن ژٲوِو۔
اُمید چھُ زِ تِمَن کٔر تُہۍ سٕتۍ نَرمۍ سٕتۍ برتاؤ۔
سُہ اوس اکھ ہفتہٕ رٲوان تہٕ تِمِس پٲٹھۍ اوس نوکری پٮ۪ٹھ رخصت لٲگِتھ۔
کیا تُہۍ چھِوٗ یِم ۱۵ وریٖن منٛز ٹھیٖک ٹھاک مستحکم رٲوان؟
ہمت تھاو، دوست۔
تہٕ آگۍ تہِ—حالِس منٛز چھِ تِمَن ہُنٛد شمار واریاہ گژھان، لٲگِتھ چھُ یِہِ پٲٹھۍ زِ یِہِ سٕہِ کُنہِ وَنٛدۍ سٕتۍ بدتر چھُ۔
سُہ پٲکٕے پارٹِی اینِمٕل آسَن۔
یہ چھِ اکھ گژھان طریقہ چیزن ہٕنٛز نظر سٕتۍ وُچھنُک۔
مےٚ چھِ اُمید تُہۍ یہِ کیمرس منز ریکارڈ کٔرمتھ آسہِ؛ اگر بہٕ تُہٕنٛدِ جایہِ آسہٕ، بہٕ تہِ یژھ کران آسہٕ۔
اگر أسۍ یژھ گژھان رٕہٕ، دنیاہِ ہٕنٛدۍ نہٕ بوزِتھ یتھۍ زٕیاد لوکھ جایہِ کران آلودہ۔
پھر تہِ، کیک مٕلنُک چھِ اکھ زبردست اشارہ۔
مےٚ خٲطرٕ تہِ چھِ یہِ خاص اہم۔
تازٕ چھِ سٕہِ ژٔچھَن مےٚ کٔرمتھ بریک اَپ۔
اصل چھِ، چاہتھ کُنہِ تہِ ختم نہٕ گژھان۔
مےٚ چھِ اُمید یہِ دۄہ رہِ، سُہ چھِ اَز تہِ ٹین۔
اکھ لٹہٕ مےٚ سوشل ماحولس منز بلکل بےجایہِ محسوس کران آس؛ یہِ مےٚ خٲطرٕ واریاہ مُشکل آس۔
مےٚ ہٕنٛدِس مکان مالکس تہِ چھِ یژھ مسلہٕ۔
أسۍ کٔس بارس منز گژھِ گپ کران؟
تُہۍ یُس پیزا بناونُک کوشش کران آسِو، تَتھ کٕہ گٔڈبڑ گٔے؟
تُہۍ پنٕنِس ماجِ ہٕنٛدِس رشِتَس کِنٛہہ ٹھیک کرنُک کوشش کیاز نہٕ کران؟
بہٕ چھُس پنٕنِ امتحانن خٲطرٕ واریاہ مٔزیٚن پَران۔
آ، مےٚ خٲطرٕ چھِ یہِ بلکل صاف زِ تِم چھِ واقعی پرواہ نہٕ کران۔
سُہ چھِ اکھ ژٔھ، یار؛ ژٔھ چھِ غلطی کران۔
مےٚ ہٕنٛدۍ کزن چھِ مےٚ سٕتۍ ڈراون ٹرٛک کران آسِتھ۔
تُہۍ چھِو سٕبَہِ کھوتہٕ مٔزیٚن بیٚوِ۔
مےٚ ہٕنٛدۍ برٛونہٕ کٔلۍ کامہِ پیٚٹھ ۷۵ اِنٛچ ٹیلیویژن جیت۔
مےٚ چھُس پنٕنِ نَتیجن سٕتۍ اَز تام سٕچٕچ مُطمئن۔
کاشِر مےٚ یِتھ یِتھ باران تُہۍ طرف پٲٹھِ پٲٹھِ ہٲوِتھ ہٲندٕس۔
ہاں، بُتھ لۄکۍ برٛادَر کِنہہ وِزِ تَکلیف دِوان ہٲسِتھ۔
تُہۍ سچٕچ چھِو وٕنان زِ تِم وَقتھ جرم کَم ٲس؟
مےٚ سٕہ لالہِ روزگار گژھ۔
مےٚ چھِ مےٚ دوستن سٕتۍ کینٛہہ حسد۔
ہا ہا، وۄنۍ، اَسہِ سٕندِ بہترین لوٗکھن سٕتۍ تہِ یِم گژھان۔ بہٕ چھُس یہِ پنٛنٮ۪ن دوستن ہٕنٛزِ نزدیکی ہمیشہ کَران۔
مےٚ کارس منز کینہہ مسئلہ ٲس۔
مےٚ چھِ بٔڈ شوق یِلہِ بہٕ گَرِ یِوان تہٕ میٚون بِلّی چھِ کھڑکی باہَر پٲٹھِ مےٚ انتظار کَران۔
مےٚ چھُس تُہۍ بارے گوٗگل کَرُن۔
حالِس منز مےٚ چھِ مالی مُشکِلات آسِتھ۔
