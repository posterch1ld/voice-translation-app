ٹھیک چھُ، اگر ژٕ روز رابطہٕ کٔرِو شاید یہِ اتھ دور نَہ لَگہِ
مےٚ چھُس ژٕ آج صُبح پنٕنِس کافی کپَس مَنٛز تھُک دِمُت تہٕ تَتھ اوس باقی کافی تہِ
یِتھ حالتس مَنٛز آسُن چھُ ڈراون، مگر تُہۍ سٕند پٲٹھۍ مےٚ تہِ چھُس باہر یِم کٲنٛسہِ تہِ کٲمَن خٲطرٕ تقریباً اَرزۍ دِوان
مٕہنِس بٲپھس حالیہ مَنٛز چھُ الزائمرس تشخیص گژھمُت
پہلِس اوس خراب، مگر کٲنٛسہِ بہتر انسان مٕلُن اوس سُہٕ برٛونٛہہ؛ البتہِ چھُ کٲنٛسہِ ژھانٛڈُن مُشکِل
سُہٕ اوس بہٕت ڈراون، پتہٕ تَمَن مےٚ کٕہ اندر یِوٕن کٔہ
پارکَس گژھُن چھُ ہمیشہ سُہ لَگُن
یہِ بلَن ہٕنٛدۍ ادایگی مَنٛز بہٕت مدد کَرِ
پرٛسٕہ مےٚ اوس دوڑان، تہٕ ژٕنۍ بٔڈۍ زٕنانۍ مےٚ پٮ۪ٹھ نظر کٔرِتھ تامان
مٕہنِس بِلِس چھِ اَز تہِ نَخ
مےٚ سُرٕ کٔمیٖڈی ہِنٛدِس أکِس ٹیٖویٖژن شَوَس منٛز آسٕنہٕ خٲطرٕ چُنیومُت۔
مےٚ کٕرِس نِوِس کامَس شُروٗع۔
مےٚ چھُس وُنہِ تام فیصلہ نَہ کٔرِتھ۔
یِمَن ہٕنٛدۍ کِیا کٔر یِم دۄہ؟
تَمہِ دٔوٚر چھِ ژٔٹِھ سٕردیُک کَٹھ تۄل بَسان، تہٕ سُہ چھُ پنٛنِس ماجِس کُرِتھ کٔرِتھ رُدان، مگر چھُ نَہ کُنہِ جواب۔
کیا چھُو تُہٕنٛدِس کٕڑِ اضافی کَپڑٕ، یا تُہِ ہٕکِو کَپڑٕ بَدلاوِتھ؟
ہاں، مےٚ ٲس سوچان کینہہ وونٛن، مگر مےٚ چھُس محسوس کَران زِ دۄستی چھِ نَہ زبردستی کٔرِتھ ہٕکان۔
روٗڈِیوَس گژھُن چھُ سُہ مزٕدار۔
ہاں، بہٕ چھُس تَمہِ حالَتِس منٛز گژھِتھ۔
آسا چھِ یِہ زِ سُہ یِم تَھٲوِتھ دٔپان۔
اُف، بیکی چھِ سۄ کَتھ کَروٗر۔
کیا تُہِ چھُو کُنہِ جاں وۄنٛتھ چھُٹی خٲطرٕ؟
سُہ چھُ مےٚ سٕنٛز آسٕنہٕ، مےٚ چھُس سۄتھ لۄلِتھ۔
مےٚ نَہ ٲس پَتہٕ یِتھ پَتہٕ یُس مےٚ گَرٕ پَگٕہ۔
مےٚ دۄست چھُ وُنہِ نِوِس گَرٕس منٛز شِفٹ گژھِتھ۔
آج کَل چھُس مےٚ اِقتِصادِس مُتعلِق خۄش اُمید۔
سُہِ نَہ ٲس پَتہٕ زِ یِہ چھُ یِوان۔
سُہِ تُہِ خٲطرٕ کِتھ پٲٹھۍ کٲر آنِ؟
وُنہِ چھِ تِم وۄڈ گٔمت، تہٕ مےٚ چھِ تِہ وقتُک واریاہ یاد یِوان۔
تُہِ پٲزِ ہٮ۪کِ أکھ سُہ رِویو لِکھُن، لَگِ چھُ زِ تِمَن چھُ پَتہٕ زِ تِم چھِ کِیا کَران۔
بہٕ پنٛنِس بیٚیِس چھٕڈِتھ پنٛنِس نَینی سۭتۍ رۄنٕچ سوچان، کیازِکہِ سُہ چھِ مےٚ مُتعلِق بیٚیِس نِش زیادٕ دلچسپ لگۄن۔
تِم چھِ سکوٗل پَسند، کیازِکہِ تِم ہٕنٛدۍ مُلاقات گٔے کینہہ یِم اَنیٖمے پَسند کَران۔
عام طور چھُس نہٕ، مگر کُنہِ وجہہ سۭتۍ چھِ مےٚ یِتھٕ کِنہہ خۄشگوار احساس۔
کیاہِ یہِ چھِ اَکھ بُرٕ باتھ؟
اَز کوڑٕ بوزان وٕلِتھ گژھان ٲس، تہٕ میٚل اَکھ بوٚڈ ژھۄر۔
میٚن دِژ پنٛنِس لٔکِرِس تِمَن ہٕنٛز دوستَن سۭتۍ سکوٗلُک سامان ژٕٹِتھ گژھٕن۔
سُہ ٲس اَکھ اَنٛدھیر بَنہِ علاقہٕ۔
مےٚ ٲس پَریشان زِ سُہ ہیکہٕ نَہ ہیٚکِہ آسٕن جُڑِتھ، مگر مےٚ ٲس پَتہٕ زِ سٕہ چھُ سٕہٕلۍ ٹھیٖک گژھان۔
اَس کِتھ پٲٹھۍ پنٛنٮ۪ن دوستَن سۭتۍ تہِ گژھان۔
بٕہ کوڑٕ وٕلِتھ گژھان ٲس، مےٚ سُہ کھۄل تہٕ میٚل مۄگٕل، مےٚ لگ بھگ اوٚبُر آو۔
مےٚ چھُ رخصتِس گژھنس پٮ۪ٹھ بٔڈ شوق۔
تِم میٚن یہِ سۄچٕن دِلٕو زِ سٕہٕلۍ ٹھیٖک گژھِ، مگر سُہ بلکل نہٕ گژھ۔
مےٚ چھُس یِتھ ہفتہٕ اَخرس پنٛنٮ۪ن دوستَن سۭتۍ سِنیما گژھنس پٮ۪ٹھ سۄنٛتھ پَتہٕ۔
تُہٕ کٔرِو وائٹ نۄیز تہٕ بلیک آؤٹ پردٕ آزماوٕن۔
یِم چھُ تُہٕنٛدِس مُستقبلس منٛز خۄشی زِ تُہٕۍ یہِ کٔر۔
تُہٕ پَہلِ کُتھ گژھِو؟
اَ، مےٚ چھِ پَتہٕ، مگر مےٚ چھُس بَس مایوٗس محسوس کَران۔
تُہٕنٛدِس پَتھٕ پۄش مَنی مَینیٖجَرس کیٛاہ ٲس خۄٹ؟
یِم قِسمُک اِنسان چھُ جیلِس منٛز دِژُن گژھان۔
اَکھ خاص کیک چھُ کمالُک، تہٕ تُہٕ چھِو مرحبا۔
مےٚ سُہِ متعلق تھوڑا فکرمند چھُس، کیازِ سُہ ڈپریشنس منز گژھان چھُ۔
مےٚ سُہِ پٮ۪ٹھ بہت غصہٕ اوس، مگر تِتھٕے حیران تہِ اوسُس زِ تِم کیٛاہ وٕنُن، یِہ تہِ نَہٕ کٔرۍ ہٮ۪کان۔
اَسہِ جماعتُک تقریباً اَڌ۔
مےٚ پٮ۪ٹھٕے تِتھٕ اوسُس، مگر اَتھ نَہٕ چھُس۔
مےٚ سمجٕھان، شاید تُہۍ خٲطرٕ حالات بہتر گژھن۔
مےٚ وۄنۍ سچٕچ پنٕنۍ ٹرک ڈیلرشپ تام ٹو کٔرِتھ نٮ۪وُن پٲوان۔
مےٚ تہِ۔ مےٚ نَہٕ ژٕٹِتھ دِوان یِژھان، مگر مےٚ سۭتۍ خراب سلوک گژھُن نَہٕ سٕہِ ہٮ۪کان۔
سُہ چھُ ونان زِ مےٚ یِہ مٮ۪لِتھ گژھِ، یِہ چھُ سُہِ لٔگُن تِکھ۔
گژھِتھ مٮ۪نٛہٕ مےٚ اوسُس زٕبردست بزی، تہٕ مےٚ پنٕنِس دوستُک برتھ ڈے پارٹی بلکل وسٕر۔
کم از کم تُہۍ سُہِ قدر تہِ کٔرِتھ ہٮ۪کاو تہٕ پنُن پیار تہِ دِکھٲوِتھ ہٮ۪کاو۔
مےٚ اوسُس تِم وَقت۔
کامس منز اکھ مُشکل ہفتہٕ گژھاونٕچ پَتہٕ مےٚ گژھِتھ رات گھنٹَن گھنٹَن ویڈیو گیم کھیٚلِتھ۔
واہ، یِہ چھُ زٕبردست نصیب۔
یِم برونٛہہ سُہ اوس، تِمِس پٮ۪ٹھ مےٚ اوس زٕبردست حسد۔
مےٚ تہِ تِتھٕے محسوس کَران۔ مےٚ چھُس پنٕنِس کھانٕچ تہٕ یِمِس خٲطرٕ پٮ۪سہٕ دِوان، تِمِس پٮ۪ٹھ بٔڑ معیار۔
واہ، سُہِ سۭتۍ زٕبردست دٔرد لٔگِتھ آسہِ۔
مےٚ چھُس امید کَران زِ تُہۍ سکون لَبِو۔
بچٕن نَہٕ آسٕنۍ متعلق چھُس مےٚ دلٕچ احساسات مِلہٕ جُلہٕ۔
اَزکَل چھِ بُتھ سارنۍ بَچن ٹیکنالوجی ہٕنٛز عادت۔
مےٚ اوسُس تھوڑا دوٚدلہٕ منز زِ پنٕنۍ لٔکٕر پارٹی گژھٕنۍ دِوٕنۍ یا نَہٕ۔
سُہ چھِ مےٚ سۭتۍ ناراض، تِہ مےٚ سۭتۍ بدلہٕ لینٕے خٲطرٕ سُہ کٔر یہِ۔
اگلے ہفتہٕ میون بچہٕ گژھِ۔
پَگاہ اوس مےٚ اولمپک فِگر سکیٹنگ گژھان نِیوان۔
تَمہِ کٔر کینہہ سُہنٛد یاد تازٕ۔
مےٚ چھُس منتظر اَزکِ ٹورنامنٹ جیتنٕچ۔
مےٚ چھُس یِمہِ ؤرۍ ہالووین خٲطرٕ بلکل تیار۔
مےٚ چھُس پَتہٕ زِ تُہۍ زٕوٚہ ژٕٹِھ کٔرِو خۄش، مگر ژٕٹِھ زٕیادٕ مٕت کٔریو۔
میون ژٕٹہٕ چھِ مےٚ طرف بونٛگ کران تہٕ چھِ نہٕ روٚکان۔
تُہۍ چھِوٚ سُہنٛد طریٖقہٕ تیار لگٕنۍ۔
کیا تُہۍ وٕنان زِ دُنیاہِ منز کانٛہہ دۄہ امن گژھِ؟
آزٲدی تہٕ کانٛہہ نٔو شُروع کٔرُن۔
نیک تمنٛا، تُہۍ چھِوٚ یہِ کٔرِتھ۔
آ، اصلہٕ چھِ کُنہہ لۄکُٹ انعام تہٕ کینٛہہ پہچان، یُس چھُ سُہنٛد کیازِ مےٚ چھِ نہٕ واریاہ وقت تِتھ کَم کران۔
کیا تُہۍ چھِوٚ دۄبارٕ کوٗشش کٔرٕنۍ پٲٹھۍ سوچان؟
سُہ چھِ تھوڑِچ دیرس منز مےٚ ترٛاوِتھ گژھان۔
تُہۍ وٕنۍ زِ واعظ چھُ مددگار۔
مےٚ چھُس وُنۍ تَمہِ پٲٹھۍ حالتس منز۔
ییٚلہٕ مےٚ کَمَس پیٚٹھ اوس، سُہ اوس اَکیلا۔
یہِ چھُ زبردست! کیا یہِ چھُ تِمۍ کَمَس پیٚٹھ زیادٕ پیسہٕ دِوان؟
آ، مگر مےٚ کٔر فونَس پیٚٹھ پورٕ گَنٹہٕ یہِ سمجاون زِ قصور تِمۍ ہٕنٛز اوس۔
یہ سُنِتھ کَرِتھ خۄش لَگ، تہٕ اگر تُہُنٛد جیون ساتھی یہِ جانِہٕ، تِمَن تُہۍ پٲٹھۍ فخر آسِہ تہٕ سُہ دوستَس پٮ۪ٹھ غُصہٕ کَرِہ۔
تُہۍ قسمتٕ وٲلِیو چھِو زِ تُہۍ اَسہِ قِسمچ رِشتہٕ تھاوِتھ ہٮ۪کِو۔
بہٕ اَکھ گژھِ لَوان، کیازِ مےٚ سَخٕت نَہ چھُند دٕیر گژھُن۔
یِمِن پٮ۪ٹھ کینہہ واریاہ نَہ ہٮ۪کِو گژھِتھ۔
فَقَط تِمِس سَمژٲو زِ سُہ دۄبارٕ نَہ کَرِہ۔
مےٚ اُمید چھِ زِ تُہُنٛد بَب اَز تِمِچ محنت سٕتۍ مِلِتھ ریٹائرمنٹَس سٕتۍ لُطف اُٹھاوَان۔
مےٚ بَبَن دِتھ یہِ سونہٕ ہار وَرۍ وَرۍ پٮ۪ٹھ۔
پَتہٕ بہٕ تَمہِ منز پٲٹھ کٔرِتھ گٔے تہٕ سٲری گَرٕس منز تَمہِ نِشان لَگاوَان گٔے۔
خۄش لَگِتھ زِ تُہۍ تِمِس وٮ۪ٹ کَڈٕ نِوان۔
مَگَر صُبح چھِ واریاہ سُبُح، یہِ چھِ پَکّہٕ۔
اَسِہٕ مےٚ پسندیدہ ریسٹورَنٹَس منٛز ٲسِو۔
وایہٕ گژھِتھ، تُہۍ تِمَن خٲطرٕ واقٕعی کینہہ سُہ کَرِتھ ہٮ۪کِو۔
بہٕ چھُس وۄنۍ واریاہ غُصہٕ منز۔
لَگَان چھُ زِ تِمِس چھِ بھروسَس مُتعلِق کینہہ اندرونی مسلہٕ۔
پَتہٕ دۄہ بہٕ گۄم کٔر مےٚ کٲمَس جمع کَرنہٕ وٲلۍ پیسَن ہُنٛد بٹوہ۔
بہٕ چھُس اِتھ پٮ۪ٹھ واریاہ گھَبراوان زِ شاید بہٕ یہِ خراب کَران۔
یَلہٕ مےٚ والِدٕن یہِ لُڈ، تِمَن سَمٕجھ زِ بہٕ چھُس اَکھ سوشیوپیتھ۔
مےٚ دوستَس مِلِتھ اَکھ کِتابُک ایڈوانس ساین کٔرِتھ کاپی۔
مےٚ چھُ یاد زِ یَلہٕ فاسٹ فوڈ ٲس واریاہ سَستہٕ۔
پَتہٕ کِتھ دۄہ بٲقِی چھِ؟
تہٕ اگر مےٚ یہِ واقعی ختم کٔرمتھ، تہٕ یہِ تِمۍ آسِتھ۔
سُہ تُہِند کُس چھُ؟
یہ چھُ زبردست زِ تُہۍ دۄنوٕن یہِ مسلہٕ حل کٔرِتھ سَژِو۔
مےٚ چھُ خوش زِ تُہٕنٛدِ زِندَگِس منز چھِ اتھِ پٲٹھۍ دوست، یہِ چھُ زِندَگِ آسان کَران۔
مےٚ چھُ سَخت پٲٹھۍ بےتاب زِ تِمِس سٕتۍ کَرٕہِ وِواه۔
مےٚ چھُ لگٕنۍ زِ یہِ چھُ عین یُس مےٚ اَسۍ وَقتھ ضٔروٗرتھ۔
ییلہِ مٮ۪ٚنٛدۍ نوکٕری کٔر مےٚ تحفہٕ۔
اَگلے مہینے گژھِ مٮ۪ٚنۍ بیٹی ۱۶ وَرۍ، تہٕ مےٚ چھُ نَہ صبر۔
مےٚ پَژِ پنٛنِ لیبر ڈے چھُٹی کَنسل کَرٕنۍ، کیازِ مےٚ چھُ کٲم کَرُن۔
نَہ چھُ ہر کٲنہِ یہِ کَرنہٕ سَژھان یا کَرِ۔
مےٚ اوس سَخت خواہِش زِ کیکُک آخری ٹُکرٕ مےٚ مِلِتھ، مگر مٮ۪ٚنۍ سُہرن کٔر سُہ کھٲتھ۔
شاید یہِ کٔرِتھ سُہ دِلگیر گژھِ آسِتھ، مگر مےٚ چھُ یقین زِ سُہ سَمَجِ۔
اوہ، یہِ چھُ کافی زبردست۔
کِتھ پٲٹھۍ خۄبصوٗرت کھیل چھُ، ہا؟
پِزّا سٕتۍ چھُ نَہ کَنہِ پٲٹھۍ غَلَط گژھان۔
مےٚ چھُ نہٕ کَنہِ یہِ سٕنٛدِ ہٕنٛز سُنیومُت۔
مےٚ اوس سَمَجھان زِ مٮ۪ٚنۍ کمپنی منز چھُ کٲم کَرنٕچ کَمی گژھِتھ۔
مےٚ چھُ متفق، مگر ییلہِ تُہۍ واپس یِوٕ، تُہۍ سُہ دۄبارٕ دِتھ سَژِو۔
مےٚ چھُ سَخت اُمید زِ تُہۍ سُہ ضروٗر مِلو، تُہٕنٛدِ آواز چھِ سَخت جوش دِوان۔
وَلہٕ، یہِ چھُ تُہٕنٛدِ حق۔
اُف، یہ تہٕ کافی وٲرِیا رقم چھِ۔
سی فوڈ پاستہ بناون سۭتۍ چھُس بہٕ پنٕنۍ پٮ۪ٹھ فخر۔
مےٚ چھِ ہمیشہ یہِ ڈر زِ مےٚ پٮ۪ٹھ حملہ گژھِ۔
پانٛژھ مہینن گژھِ مےٚ چوتھ بچہٕ پیٖدا۔
اسِہِ سکایپ پٮ۪ٹھ گژھان گپ، مگر یہِ چھُ نہٕ تِمَہِ قٕسم۔
نِمٕہ بُل ڈاگ تہٕ نِمٕہ جرمن شیفرڈ۔
تَمہِ سۭتۍ مےٚ گژھان بوٗز گھبراہٹ۔
مےٚ نَہٕ سَگِ انتظار کرِتھ زِ گژھِ سکول شروع یِہِ پٮ۪ٹھۍ سیٚمسٹَر۔
مگر چھِ اُمید زِ سُہ ژٕٹۍ نوکری گژھِ لَبُن۔
اَکھ وۄنۍ مےٚ بوٹ ٹرِپ بُک کر، مگر پتہٕ نَہٕ دِتھ اسِہِ گژھِتھ۔
مےٚ چھُس سوچان جوان محبت تہٕ یہِ زِ تَمہِ وِز مےٚ کِتھ پٮ۪ٹھ آسٕو معصوم تہٕ کم عُمر۔
تُہۍ چھِوُن ظٲہر زِ تُہۍ تَمہِ سۭتۍ مزٕ کَرِو۔
کیا ڈے کیئرِس منٛز چھُ کانٛہہ مسئلہٕ؟
تُہۍ کینٛہہ قٕسمُک چیز وُچھ؟
مےٚ چھُس سٲن زِ تَمہِ سُرخ لایٹَس پٮ۪ٹھ ٹریفک کیمرہٕ ضروٗری چھُ۔
سُہ کَرِ تھٲوۍ دۄر یٲد تُہنٛدۍ مہربٲنی۔
اچھا، اگلی اِنفِنِٹی وارٕز ۲۰۱۹ منٛز یِیہِ، تِہِ انتظار چھُ واریاہ دۄر۔
مےٚ چھُس گژھان پنٕنۍ پسندیدہ بینٛڈ فینِکس وُچھنٕے۔
مےٚ دۄست، یہِ چھُ سٲریٚ کَٹھ۔
مےٚ چھُس پسند کران ییٚلہِ خاندان چھِ کٲنٛہہ مٔہربان بچہٕ گود لَوان تہٕ تَمہِ دِوان اَکھ گَر۔
ہاں، لگہِ چھُ تُہۍ اَکھ حقدار
اوہ، اگر بہٕ روٹ بنٲوتھ وٲری وٲری گژھِ کمٲوُن موٹ پیسہ، سُہ گژھِ بہترین
مےٚ ژٕنۍ وٕچھِوٕلۍ ہمسایہ واریاہ نیک أسۍ
بہٕ چھُس پچھلے ژٕ دوہن پیٹھ ڈایٹ کران تہٕ یتھ وقتس تام چھُس تقریبن ۳۰ پاؤنٛڈ وزن کھوتھ
پک، تُہۍ سۭتۍ گپ شپ کرتھ سُہ واریاہ نیک لٲگ
بہٕ دٕپُن پنٕنہِ سۭتۍ وعدہ کہ بہٕ کرٕ زیادہ ورزش تاکہ گژھٕس پتلا
مےٚ سُہِ متعلق کانہہ نہٕ وٲنٛس
اوہ واہ، نہٕ، سُہ اوس پانٛژھ وریہِ ہُنٛد تہٕ سُہ اوس ژٔمِنس پٮ۪ٹھ لیٹمُت
یِم صبح بہٕ یلہِ وُٹھیو تہٕ میٛٲنۍ کوٹھرس منز اوس اَکھ بٲڈ
پَگاہ دۄہ گٔژھِ مےٚ اَکھ جنازس گژھُن
سُہ اوس کانٛہہ وقت پٮ۪ٹھۍ ہُنٛد برتھ ڈے کارڈ
خۄش چھُس زِ میٛٲنۍ گرل فرینڈ گٔے تَتۍ یلہِ بہٕ گٔیوس گھر
بہٕ اوس خبر وٲنان تہٕ مےٚ گٔے نظر اَکھ خبر یِم منز اوس آتشِس منز بچہِ ہٕنٛد قتل
سُہ لگہِ چھُ زِ سُہ تُہۍ خٲطرٕ واریاہ نیک گٔے
بہٕ چھُس کَنہہ نہٕ جیتان، تَمہِ خٲطرٕ سُہ اوس غیر متوقع
گٔش پگاہ بہٕ ٹی وی پٮ۪ٹھ سۭتۍ کھۄفناک فلم وٲچھی
ہاں، بہٕ اوس میٛٲنۍ بیٚٹی ہُنٛد نوو گَر گژھان
مےٚ چھُس ڈر زِ امریکہ منز یِوان اقتصادی بحران کُنہِ اثر کرِ أسۍ سٲری
اَکھ دۄہ کُنٛہِ کٔر میٛٲنۍ گاڑِ خۄد خراب
سُہ اوس تُہٕنٛد قصور یا بینٛکُک؟
مےٚ یقین نَہ یِوان زِ ہماری کیمپنگ ٹرِپَس سٔمورس بناونُک سامان اَنانُک خیال صرف مےٚ آیہ۔
کیا تُہۍ بٔہِر گٔیو تہٕ سُہ چیک کٔر؟
مےٚ چھُ ۳۰ ؤرۍ زِ وۄنٛٹھ مَرِتھ۔
نَہ، اصلس منٛز نَہ؛ مگر دفترس منز مےٚ چھُ پسند زِ سارنی ہٕنٛد آسنہٕ پتہٕ کینہہ وقت آسہٕ۔
تٔمۍ ہُنٛد پَتھ کٕنٛہِ کٕنِس ہُند آدھ حِصہٕ گٔیو۔
اِک دۄہ مےٚ پٲٹھۍ بَتھ‌روم ہٕنٛز کھڑکی منز وۄنۍ جالہٕ دِژ۔
سُہ چھِ اَکھ گۄڈٕ خیال۔
مےٚ چھُس پنٛنِس گرل فرینڈس پٲٹھۍ بھروسہٕ؛ اَسہِ چھِ لگ بھگ ۳ ؤرۍ زِ ڈیٹنگ کران، نَہ؟
وُنُس چھُ نہٕ ژور خراب، مگر سُہ چھُ واریاہ تام گژھان۔
مےٚ ہٕنٛد دوستن چھِ وۄنِچ نٔوی کار رٲد کٔرمُت، تہٕ مےٚ چھُ یقین نَہ یِوان زِ تٔمۍ سُہ کِتھ پٲٹھۍ اَتھ سستہٕ قٕیمتس پٲٹھۍ مٕل۔
اَسہِ چھِ آسنہٕ ہفتس بار ٹیسٹ دِوان، تِمِس خٲطرٕ مےٚ چھُ واریاہ پَران۔
بس سُہٕ جان زِ سُہ شایَد اَکھ بہتر اِنسان بَنِتھ واپس یِیہِ۔
خوش آمدید، تہٕ ہاں، مےٚ چھُ ہمیشہ لان کَترُن نَہ پسند۔
یِم واریاہ مدد کران ییلِہ حالات نَہ آسَن تَام گۄڈٕ۔
اَتھ پتہٕ مےٚ پٲٹھۍ زیٛادٕ دھیان دِنُک پَڑِ۔
تٔمۍ اَخر ونان زِ تٔمۍ چھِ ہیٚچھِ منزلِس پنٛنِس بسترِس پٲٹھۍ نٲنِس دادِ مُردٕ حالتس منز دِژمٕژ۔
مےٚ چھُس پنٛنِس خاندان تہٕ دوسن پٲٹھۍ پیار کران۔
مےٚ چھُ وۄنِچ پَہل بچہٕ گٔومُت تہٕ مےٚ ہٕنٛز شادی شُدٕ زندگی چھِ گۄڈٕ ترٛاوان۔
اوہ، گژھِتھ چھِ کَنہہ کَنہہ، تہٕ کینٛہہ ہٕے نَہ کٔرِتھ ژھۄک۔
۳ ؤرۍ ہٕنٛد بچس خٲطرٕ سُہ چھُ واریاہ شاباش لایق۔
مےٚ خوش چھُس زِ تُہۍ یہِ اِتھ پٲٹھۍ پسند کٔر۔
اکھ سَلٲہ چھُ مےٚ لوٗکن دِوان زِ تِمن کِنہہ چھُ کھِوان، سُہ بدلٕنۍ ضروٗرت نَہ، صرف کَتھ پٲٹھۍ کھِوان سُہ بدلٕنۍ۔
مےٚ پنٛنٮ۪ن بچن ہٕنٛدِس سۭتۍ تہِ یِہِ کَتھ چھُ وَنان۔
اوہ نَہ، یہِ چھُ بَڈٕ ہیبت ناک۔
مےٚ لگٕنۍ چھُ زِ تُہۍ تہِ یہِ کَرنۍ چاہِ۔ اَگر تُہۍ جانان چھِو زِ تُہۍ محنت کَران چھِو، تہٕ کٔرِو۔
خوشی چھُ زِ تُہۍ ٹھیک چھِو۔
ہای، مےٚ نٔوِس کٲمَس چھُ نَہ کانٛہہ دوست۔
مےٚ کُت چھُ ہَر لۄکُٹ آوازِ پٮ۪ٹھ بھونٛکِتھ بند نَہ کَران۔
کیا تِمن کٔر کینہہ نیک تُہٕنٛدِ خٲطرٕ حالیہ؟
مےٚ روڈ ٹرِپَن ہٕنٛز چھُ شوق، سُہ چھُ سُہنٛدَر وَقت لٲگنُک۔
صرف مزٕ خٲطرٕ، مےٚ تیٖرَن منز چیمپین آس، مگر ٹینِس مےٚ خٲطرٕ زیادہ آرام دہ اوس۔
مَتٕوال ڈرایِور تہِ چھِ بَڈٕ خراب۔
عام طور چھُس مےٚ کھوٹٕ کَتھ یاد تھاونٕچ عادت۔
سوری، مےٚ مطلب اوس ‘زندٕ’؛ اسپتالس منز آسُن تہٕ بیٚین ہٕنٛدِ طرفٕ سۭتۍ پنٛنٮ۪ن خیال تھاونٕچ چھُ بَڈٕ ڈرٲونۍ۔
تِم کیا آس کَران اوس تُہۍ کینہہ کَرو؟
کیا تِمِس ملی اکھ بہترین نوکٔری ہنٛز پیشکش؟
مےٚ سُر چھُ ہمیشہ چیزَن سۭتۍ ٹَکرٲوان۔
مےٚ چھُ سچُے دُکھ زِ پَگاہ ہفتس نَاو ڈُب گٔے۔
سچُے ونان، مےٚ آسٕس بَڈٕ گھبراوان۔
ہاں، مےٚ تہِ چھُ پت جھڑ زیادہ پسند۔
بہٕ تُہۍ ہٕنٛدۍ خٲطرٕ حوصلہٕ دِوان رَہان۔
یا کم از کم وُن نہٕ۔
مےٚ چھُس اُمید تُہۍ کٔرۍ آسِہ تِمۍ شُکریہ۔
مگر مےٚ حٲصِل کٔر سُہِند وائس میل۔
ہای سکولس منٛز بہٕ اوسُس دھوکہ دِوان۔
مےٚ نہٕ اوس خیال زِ بہٕ سُہ کٔرِتھ ہٲوان۔
کیا تُہۍ کٲمِہ خٲطرٕ تَتھ گٔژھُن پَڑ؟
آجکَل چھِ کُنِہ کُژۍ مِلان مُشکل۔
اَز مےٚ ہُنٛد باسَن مےٚ دیٚت بٕہٕتھ کٲم زِ مےٚ نِہ ہٲو کٔرِتھ، یِمِہ سۭتۍ مےٚ کٔر غصہٕ۔
مےٚ چھُس واقعی تِمِہ خٲطرٕ افسوس۔
انٹرنیٹس پٮ۪ٹھ چھِ یِم پٮ۪ٹھان مےٚ چھُس بٕہٕتھ فِکر مند۔
دۄہِم دۄہ بہٕ اوسُس سڑکَس پٮ۪ٹھ گژھان تہٕ اَکھ بلی پٔژ مےٚ سٕنٛدِس مُکھ۔
سٲری ہفتہٕ بہٕ اوسُس کٲمِہ خٲطرٕ اکھ پروجیکٹس پٮ۪ٹھ کٲم کَران۔
تِم چھِ ۳ تہٕ ۵، تہٕ امیٖد چھِ زِ یِمن وۄنۍ گۄڈٕ بوز۔
مےٚ نِہ ہٲو یقین زِ تِمۍ کم از کم معافی تہِ نہٕ مانگ تہٕ نہٕ ‘سوری’ وٲلِتھ ہتھ ہلاو۔
اگر تُہۍ بَسُن پَڑِو، تہٕ ڈونٹ شَکِلُک تکیہٕ لَوو تاکہ پُچھِ تھَپٕتھ پٮ۪ٹھ نہٕ بَسِو۔
یاد تھاو، تُہۍ چھِ دور کیازِ تُہۍ چھِ پنُن آپ بہتر بناوان۔
مےٚ چھُس پٲک یقین زِ یِہ تِمِہ ہُنٛد بَقٕے پَڑھایِس منٛز تہِ چَلان۔
تہٕ یِہ چھُ کَتھ تہِ آسان نہٕ۔
یِم دۄہ بہٕ اوسُس تَتھ، مےٚ اوس دِژم سٲری جایِہ پٮ۪ٹھ بھوت۔
یہ بہت گژھان تہٕ اَن پیٹھ گژھُن۔
اَسہِ ہر وِز مےٚ تنگ کرنہٕ بجاے روزگار کَرُن چاہی۔
بہٕ آوُر گھبرٲوِت، تَمہِ سۭتۍ بار بار مشق کٔر۔
مےٚ اُمید چھِ زِ سُہ تَمہِ خٲطرٕ یہِ پورٕ کَری۔
مےٚ چھِ نَہ وَتھ تَام یَتھ کارُک قرضہٕ ادا کَران۔
لَگہِ چھُ زِ مےٚ کَتہِ کَتہِ نَہ مِلان سُہ چیٖز یَتھ مےٚ جلدِ خٲطرٕ ٹھیٖک آسہِ، تَمہِ سۭتۍ اُمید چھِ زِ یہِ کَم کَری۔
تَمہِ کٔر مےٚ سچٲے خاص محسوس۔
مےٚ چھِ دُکھ زِ مےٚ ژٕنہٕ کُنہِ سُہ ہر وِز پنُن ترقی ضایع کَران۔
بہٕ گژھِو مےٚ ریاضی امتحان منز ناکام۔
تَمہِ چھِ کُنہِ چیٖزُک فِکر نَہ، یِہِ چھِ سُہ وِز سُہ بَہتر۔
شَک آسہِ تہٕ سُہ وِز ژٲر کَرُن چھُ بَہتر۔
مےٚ ہٕنٛدِ تَمہِ سَتھ سَمانہٕ محسوس گژھِو، یہِ کِتھ پَتہٕ کَم نَہ کٔر؟
بہٕ چھُس سُہ وِز پنٕنۍ پُران چیزہٕ بیچنہٕ بجاے غریٖبَن دَان کَران۔
ناغہٕ وٲقعہٕ پَتہٕ شٲید بہٕ یِہِ ہٕنٛز زیٛادٕ گور کَریٛہ۔
سُہ کَتھ قِسمُک سیریَل آس؟
گژھِ دۄہ مےٚ ہٮ۪تھ اَکھ شاندار اِنٹرویو۔
مےٚ نَہ وٲنٛد چھُس، بہٕ کٔر کوشش زِ تِم ژٕٹہٕ سۭتۍ بَرٕ کھٮ۪وٗن۔
کیا یہِ سُہ دوست آس زِ تۄہہِ سُہِ سۭتۍ پیار کَران اوس، یا صرف بیٚیہِ بہترین دوست؟
تُہٕ گژھِو تَمہِ ہٕنٛز کھیلَن منز؟
تٔرٛہ ؤرۍ سۭتۍ اَکھٕے جماعت پَڑٲوِتھ، مےٚ چھُ نَوِس ؤرۍ خٲطرٕ وُچھُن زٕ مےٚ واریاہ تیٲر محسوس گژھان۔
تمہِ چھِ تالاب تہنٛدِس خاطرٕ واریاہ اہم۔
مےٚ تہِ، خزاں خٲطرٕ چھُس مےٚ جوش۔ مےٚ چھُ پسند کپڑن ہٕنٛز تہٕر تہٕر پہنٛاون۔
مےٚ چھُس اُمید کٔ تۄہہِ نہٕ ٲوُر زخم۔
مےٚ چھُس رٲضی، مےٚ چھُس تَمہِ پٮ۪ٹھ واریاہ غُصہٕ۔
مےٚ چھُس خوش زِ ییٚلہِ تۄہہِ ڈِپریٚس نہٕ کٔر۔
مےٚ ٲس حٲران یَلہِ مےٚ برٛونٛہِ دۄپہرِ کھانٛہِ خٲطرٕ دعوت دِت۔
سُہ تُہٕنٛدِ طرفہٕ سچٕچ واریاہ نِکوٗس ٲس۔
سپینِس شاہی خاندانُک چھِ تَتھ اَک گرمٕی محلس۔
گوٚو مےٚ چھُس ژوٚر تیز، مگر تٔمۍ مےٚ خٲطرٕ واریاہ دوری سۭتۍ بۄس۔
مےٚ چھُس سمجھان زِ یِہ چھِ اصل تھوڑا خوش نصیبی یِہ ژِ تِمۍ مزید نہٕ ہٲرٕو۔
وُچھ مہینس مےٚنٛز مےٚ یُٹِلٹی بِل ٲس توقعہٕ پٮ۪ٹھ کم، تَمہِ سۭتۍ گوٚو مےٚ حٲران۔
مےٚ چھُس یِہِ آم محسوس کران کیٛازِ مےٚ برٛونٛہِ چھُ پٲنٛژھ مہینن منٛز دۄہہِ ؤری زان۔
مےٚ پٲدَس تلہِ چھُ اَک کَٹ، تہٕ وۄلُن کوٗشش کرُن چھُ واریاہ مُشکل۔
یِہ چھُ گژھان اَک گَندِہ کٲم۔
گوٚو سُہ پَگاہ واریاہ تل؟
مےٚ ٲس دوستن سۭتۍ فُٹبال کھیلان تہٕ میچ گوٚو واریاہ کَٹ۔
مےٚ چھُس واریاہ کٲل پٮ۪ٹھ کَتھ کَتھ کھیلان۔
ہہ، سُہ چھُ واریاہ بَہ کٲم۔
یِہ چھُ بۄڈ مُضحکہ خیز زِ ہر اَکھس چھُ اَتھ شوٚکھ دِکھاوٕ کرُن۔
مےٚس گژھان چھُ زِ مےٚ گژھِ تِمۍ ہٕنٛز سۄ موٚٹر، یِم چھِ مےٚ پٮ۪ٹھ واریاہ نِکوٗس۔
مےٚ ‘دِ رنگ’ ہُنٛد اَصٕل فلم گوٚو نَظَر۔
یار، ڈاکٹَر تہٕ مےٚ والِدٕینَن تہِ تَمیٚچ کٔر سونٛچ۔
مےٚ یہِ سچ پٲٹھۍ نَہ چھِ پسند۔
تٔمۍ نمونیا آس تہٕ پتہٕ أکِس ۲۸ مِنٹن خٲطرٕ مٔرتھ گوٚو۔
مےٚ اُمید چھِ زِ یہِ بَدلِتھ گژھِ تۄہہِ خٲطرٕ مُستقبٕلَس۔
مےٚ GRE دِیُن خٲطرٕ تیٲری کَران چھُس تہٕ مےٚ نَہ چھِ صٙبر زِ یہِ کَتھ گژھِ خَتم۔
مےٚ ؤنٛد آس زِ سُہ میٚٮ۪نٛز بٔڈ مدد کَرِ۔
اوہ خۄدایہ، یہِ چھِ بٔڈ خراب۔
یہِ چھِ میٚٮ۪نٛز بٔڈ چِڑچِڑٕ کَران۔
مےٚ ڈونالڈ ٹرمپ سٕتۍ بٔڈ غُصہٕ چھُس۔
کاشِر میٚٮ۪نٛز کینٛہہ ژٔل تَتھ گژھِ آس؛ یِتھ پَتھِ ڈیڑھ ہفتہٕ پیٚٹھ ژٔل یِوان۔
بَس تِمِس نَظَر کَرُن یِم سۭتۍ أسۍ بچہٕ سٲنۍ رٲبطہٕ بَناوان۔
لگ بگ ۱۶ گنٛٹہٕ بجلی نَہ آسَن پَتہٕ سچ پٲٹھۍ بٔڈ سُہل گژھان۔
میٛٲنۍ سٲری دوست گرمیٖن ہٕنٛز وجہ سۭتۍ دور چھِ، یِم سۭتۍ سَمے گژھٲوِتھ مےٚ کُنہِ چھُ نَہ۔
اُف، یہِ چھِ مزٕدار کیازِ مےٚ تاریخَس منز اوس بٔڈ خراب۔
مےٚ یہِ چیٹ رٕوم ہُنٛد کٲم کَران اوس تہٕ أکِس مِنٹن خٲطرٕ گوٚو دور۔
أسۍ چھِ ہُند ویکٕنٛڈ مےٚ پارٹنَر سۭتۍ فلوریڈا ہٕنٛز میامی منز یونیورسل سٹوڈیوز گژھنُک پلان کٔرمُت۔
خاص کر ہالوینس منز یہِ چھِ تۄہہِ روٗنٛگٹہٕ کھٕڑ کَران تہٕ تَمس پَلُک جوش دِوان۔
تِمِ سٲری نیک دوستن سۭتۍ رٲبطہٕ تھاو۔
میٚٮ۪نٛز پُترن فٹبال میچَس منز گول کٔر۔
تہٕ اوس اُمید تُہۍ یہِ سمجھِ گژھِ۔
اوہ واہ، تُہۍ کٲتھ چھِ؟
کینہہ تھٕو باقی، مگر تِمَن کٔر تھٕو اکثر کھٲدِتھ۔
آخرکار مےٚ سٕتھ ویک اینڈ اکیلہ گژھِتھ۔
یہِ مےٚ کُن آسُن گژھِتھ۔
مےٚ پنُن زٲنۍ سِکھاوان چھُس ژٕنۍ گَرٕچ الیکٹرِک ساکٹ بدلُن۔
تُہۍ چھِو کُنہہ بوزھ پٲٹھۍ ترقی کران؟
مےٚ چھُ واریاہ عرصہ گژھان یَلہٕ مےٚ نیوُن ژٕٹ سنبھال۔
تُہٕنز اعتماد دِتھ گژھِ مےٚ خۄش۔
بدقسمتی سٕتۍ، اَسۍ چھِو ہٕن گژھنہٕ خٲطرٕ واریاہ دیر۔
چھُٹیَن منز اَسہِ بد واقعہ گژھُن چھُ واریاہ خراب۔
سُہ چھُ پَکّٕہ اَکھ سُہِ دوست؛ مےٚ تھٲوُن تٔمۍ ہُند نمبر سپیڈ ڈایلہِ۔
سمجھ ییوان چھُ؛ مےٚ چھُ یقین زِ والدین بنُن چھُ نہٕ کینٛہہ مذاق۔
آ، لوگ چھِ ہمیشہ مےٚ سٕتۍ کَہان زِ پنُن ڈر سامنہٕ کر، مگر مےٚ چھُ لگٕنۍ زِ تِم چھِ پاگل۔
آج ہُند سٲری فُٹبال دِژنس منز چھُس مےٚ بے صبری۔
ٹھیک چھُ لگٕنۍ؛ لگٕنۍ زِ تِم چھِ نہٕ تُہۍ ہُند وقت قدر کران۔
آسٹریلیا ہُند دور دراز علاقس منز گاڑِ چلاوانہٕ وول مےٚ ہُند پٹرول گٔے ختم۔
مےٚ اوس بس مصروف گژھِتھ؛ اگلے پیٹھ کَرٕس یہِ استعمال۔
تِمۍ چھِ کیا بناون پسند؟
کیا تِمۍ چھِ پنُن اصلی لائسنس میلانٕہ خٲطرٕ کٲفی مشق کٔرمُت؟
مےٚ سمج گوٚو، مےٚ اُمید چھُ زِ تُہۍ جلدی کانہہ وقتس منز سۄ مقام حٲصل کٔرِو۔
مگر یہِ بارَس منز زیادٕ فِکر مَت کٔرِو۔
پٔٹھ وول تہٕ گوٚو یِوان یِتھ وِز مےٚ مِڈٕل سکوٗلس منز آس۔
مےٚ خوش چھُ زِ تُہۍ سچِو منز یہِ مزٕ حٲصل کوٚر۔
مےٚ کالجُک دوست حالیہ منز یِتھ پیٹھ آیہ، تہٕ أسۍ لگو تِمِس وقتُک مزٕ دار وقتس بارَس منز گَژھِتھ۔
نہ، مےٚ واریاہ نَہ ہیٚکِو کُنہہ دوا اتھ وقتس منز۔
گژھِتھ ہفتس منز مےٚ اوس باہر ڈِنَر پارٹی منز۔
مےٚ پسندیدہ ٹیم چھُ شکاگو بیئرز۔
مےٚ چھُ معلوم زِ سُہ احساس حٲصل کٔرُن چھُ واریاہ زبردست۔
مےٚ چھُس اتھ اپارٹمنٹس منز پانژھ وری تام روٗزِتھ۔
زِندگی چھِ سُہ وقت سُہلی یِتھ سَتھ آسہِ۔
مےٚ چھِ ڈایپرس یِتھ پیٹھ ڈھیر یِک مایِل بُلند، تہٕ سُہ چھُ اصل منز سبنہٕ اہم حصہ۔
مےٚ کرٕ یہِ سمسٹر منز ۴۰ نمبر حٲصل کرنُک کوشش۔
سُہ چھُ اکھ دلچسپ تجربہ۔
گژھِتھ رات مےٚ اوس اکھ ڈرٲون فلم وُچھان، تہٕ سٲری دۄہ چھُس تَمس بارَس منز پریشان۔
مےٚ آسٕن واریاہ خوش۔
مےٚ چھُس بس اُمید کران زِ سُہ یِتھ پٲٹھۍ ترٛٲوتھ گژھِ تِتھ پٲٹھۍ سُہ گرٛیڈ یِم چھِ واریاہ برابر دٔرِتھ۔
سُہ چھُ سُلی، مگر تَمس منز چھِ واریاہ محنت لگان۔
آ، مےٚ اُمید چھُ زِ تُہٕنٛز کُتُر چھُ وۄنۍ واریاہ سُلی پٲٹھۍ تربیت یِوان۔
یِم چیٖز مےٚ ہٕرٹ کرِتھ ہیٚکَن، تِمَن نِزٕدیک مےٚ گژھِ واریاہ احتیاط۔
واہ، یہِ چھُ بہت خوفناک!
مےٚ چھُس سمجھان، ژٕ چھِ یہِ جان بوجھ کٔر مےٚ غصہ دِلوان خاطر کران۔
آ، مےٚ تہِ اَسے یی خیال کران۔
دَندَن ہٕند درد سٕتۍ مقابلہ کرُن چھُ بہت مُشکل۔
مےٚ چھُس تِہہِ فتح ونان۔
مےٚ چھُس پنٛنِس کُٹمُبُک بہت یاد کران۔
تَمہِ کُنہِ وُنِہہ گُلابَن ہٕند باغ اوس۔
تُہۍ چھِ کَس مُتعلِق ونان؟
اَکھ وُری مےٚ پنٛنٕن ماجہِ باپ لُٹمُتھ، پنٛنِس نشہٕ ہٕندِ وجہ سۭتۍ۔
پنٛنٕن ماجہِ باپَس سۭتۍ وقت گُزارُن تہِ کھیل دِژھُن سۭتۍ شاندار یادٕ بنٛدِتھ ہیکن۔
