آخرِس منٛز تُہۍ کِہٕ حٲصِل کٔر؟
مےٚ چھُس یَتھ پٲٹھۍ تیار یَتھ پٲٹھۍ مےٚ ہٲو تُرٛت کٲم شروٗع کٔرِتھ۔
مےٚ تہِ اَکھ نوٚ اپارٹمنٹ منٛز شفٹ گٔے۔
سُہٕ ذٲیقہٕ دار سُشی کھٲتھ مےٚ سچّی خۄشی گٔے۔
مےٚ چھُس رٲضی، تُہۍ چھِ سُہٕ کٲم کٔرمُت یُس صٲب اوس۔
امتحان ضرور واریاہ مُشکل آسِتھ
یہِ سُنتھ کہ لوٗکھ پنٕنِس بارَس منز سُہ احساس کرنہٕ خٲطرٕ فِٹ گژھان چھِ، سَدا سُہ لَگہان
خیر، تُہۍ تِمَس سٕتۍ شادی نہٕ کٔر، یِہ سُہ گٔیو
مےٚ پہلِ کُتٕرٕ تھَے سَبَنۍ کھۄتہٕ سُہ کُتٕرٕ
مگر اگر تِمِس تُہۍ سُہ گژھ نہٕ آسن، تِہ چھِ حیرٲنی
مےٚ تہِ آسُس گژھان بُتھ بچپنَس منز
مےٚ کٔر ترٛٲوِتھ ہِک ورزش، یُس منز مےٚ پَتہٕ کٔر گَرٕوٗ تہٕ مےٚ دوستن مےٚ تھٲو
اُف، تِمِس حالَتس منز آسُن چھِ بُتھ ڈرٲون
مےٚ تھٲو بیگ تہٕ کٔر مےٚ کارٕ طرف گٔژھُن
سُہ چھُ سُہ، حوصلہٕ دِنہٕ سَدا سُہ لَگہان
مےٚ پُترَس اَز ڈرٛایِوِنگ لایسنس مِلِتھ
پَکٕے کینہہ کیڑٕ مار سپرے تھٲوِتھ یِو
آ، بہٕ چھُس یِم ؤرس جونیئر
سُہ چھُ زنٛدگِس منز ہَتھِ کَرٕنُک وَخت
مےٚ دوستُک بابا گٔیو فوت، سُہ آسِتھ تِمِس تہٕ تِمِس باقی کُٹمُک خٲطرٕ بُتھ مُشکل
کیا تُہند پالتو جانور کَتھِ کٲنٛہہ گٔیو نِس
مےٚ لَگہان کینٛہہ لوٗکھ چھِ یِمِس سٲتھ پٲدٕ گژھان
مےٚ چھُ خیال سُہ بُتھ دُکھی آسِتھ
سَبَنۍ کھۄتہٕ وۄتھ یِہ چھِ کہ مےٚ نہٕ لَگہان تِمِس سامنہٕ کرُن ییلہِ سُہ ژھوٹ ونان، کیازِ سُہ چھِ بُتھ مُضحکہ خیز انکار کران
تہٕ تجربہ کیازِ آس؟
مےٚ پٕرٛ انگلش کٕلاسس منز اول آو۔
یہِ شُرِتھ دٔل گژھِتھ، تُہۍ خٲطرٕ یِہ ژٕٹ مشکل آسہِ۔
تُہۍ بلکل درست چھِو، خاص کر ییلہِ گرٕمی آسہِ۔
یِمَن سچِ کینہہ سُہ یادٕ تازٕ کر۔
بہٕ تہِ یِمن متعلق پریشان چھُس۔
گٔژھِ ہفتہِ ٲس یِتھ بڑٕ طوفان۔
زومبی اپوکلیپس چھُ جلدی یِوان۔
آج بہٕ دٔژ دنیاہِ ہُنٛد سُہ کُرٛر سۄ بڑٕ کاکراچ۔
