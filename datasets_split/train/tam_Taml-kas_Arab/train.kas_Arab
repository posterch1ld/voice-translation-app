اَز مےٚ گژھِ مُرادُک جوڑوٗ گُم
مےٚ کِنہہ چیٖز خریٖدُن چاہان اوس، مگر مےٚ کَنہہ پیسہٕ نَہ اوس، تِمۍ کارڈ کٔر استعمال
یِم ویک اینڈ چھُس کَنٛہہ دوستن سات فلم دٮ۪کھن گژھان تہٕ تَمہِ خٲطر چھُس بَہٕت بے صبری سان انتظار کَران
نَہ، مےٚ چھِ خیال وُہ مٲرِتھ گژھِو
مےٚ اوسُس کینہہ غٲر یقینی تہٕ پَریشان
تِم تُہٕنٛز آنگَن منٛز گژھِتھ یِم درٛخت کَڈنٕچ خٲطر
مےٚ چھِ یقین نَہ یِوان زِ رابِن وِلِیَمٕس مٲرِتھ گژھِو
مگر شاید چھِ تُہٕنٛدِس کَنٛہہ گۄڈٕ وجٕہ
بَہٕت شُکریہ، یہِ چھُ مےٚ خٲطرٕ بَہٕت معنی تھاوان
اَز مےٚ کُتُرٕن کٔر قالینس پیٹھ پیشاب
مےٚ چھُس پنٛنِس فیٚصلَس پٲٹھۍ قٲیم تہٕ مےٚ چھُ یقین زِ مےٚ یِہ کَرنُک چھُ پٲرا
شُکر چھِ تُہۍ تِہ واپس دِتھ
بَس محنت کَرتھ رٲو تہٕ تِمَن پَژھِ تُہٕنٛدِ عظمت منزُن کَرن
تہٕ خٲطرٕ یہِ کٔرِتھ مےٚ واریاہ سُہ لٔگ۔
حالٕچ ژھٹہٕ وۄلۍ بارش چھِ یوان، تہٕ مےٚ سچ مِنٛز چھِ یہِ وُچھُن زِ یہِ وۄنۍ تھمِتھ۔
مےٚ کٔر پنُن کٲم گٕژران، یمِ وجہ سۭتۍ مےٚ چھُ پتاہ تُہۍ کِتھ پٲٹھۍ محسوس کٔرِو۔
شوہرَس غصہٕ دِوانٕ خٲطرٕ کافی۔
کٲم ژھٕںڈُن چھُ واریاہ مُشکل۔
آ، یِم چھِ گژھان، مگر اگَر تُہۍ پَتہٕ پنُن ژھۄر لَبِو تہٕ سۄ چھِ ٹھیٖک۔
یہِ چھُ کمال، فلوریڈاچِس یِتھ گرم موسمَس منٛز AC بغٲر روزُن مےٚ چھُ نَہ تصور کٔرِتھ یِوان۔
تِمَنۍ ہٕنٛز کٲنٛہہ چھُ یُس تُہۍ واریاہ نَہ پسند کٔرِو؟
مےٚ چھُ واریاہ خوش؛ یہِ لمحہٕ یٚتھ پٲٹھۍ مےٚ کَتھ کُنہِ نَہ لٔگ زِ مےٚ چھُ فنکار۔
سچ، صرف یِم خٲطرٕ زِ مےٚ کٲمٕچ ضٔروٗرت ٲس۔
مےٚ چھُ ہمیشہ یَتھٕے کَران۔
مےٚ چھُ سچ مِنٛز خوش زِ مےٚ یہِ ژٕٹ کٔر۔
یَتھ مےٚ گھرٕچ نِزدیٖک ٹارنیڈو آو، تَتھ مےٚ ٲس واریاہ ڈَر لَگان۔
حالٕچ مےٚ کٔر پٲٹھۍ پیشکش زِ پنٕنۍ کُٹُمٕچ مدد بٔڑاونٕے خٲطرٕ مےٚ ژور کٲم کٔرُن۔
مےٚ چھُ بےصبری سۭتۍ انتظار کَران پنُن دوست مِلنٕچ۔
کیا تُہۍ سِدھے گَر گٔو؟
اَکھ نٔو ریسٹورینٛٹ چھُ کھُلان۔
آ، یہِ چھُ واریاہ دُکھ دِوان۔
یَتھ مےٚ جِمَس منٛز ٲس، مےٚ پٲنٛٹ گٔی پٲٹھۍ ژھٕٹ۔
دوست چھِ یِمِچ خٲطرٕ۔
کَل مٲج کٕنہٕ فُٹپاتھس پٮ۪ٹھ گٔژھ تہٕ تٔمۍ ہُنٛد گوٚڈ چھِل گٔیہِ۔
آؤ اب دۄیِمِس پٮ۪ٹھ گژھِو۔
روز نِندرٕ پٮ۪ٹھ وٲتھتھ مےٚ بٔڑ جوش سۭتۍ دِژھان زِ یِہ دۄہ مےٚ خٲطرٕ کیاہ ژٕٹھیوُن۔
مےٚ چھُ یقین زِ سُہ کٔرِ۔
مےٚ چھُ واریاہ شوق زِ یِہ نوکری میلہِ۔
بریک اَپ پَتہٕ مےٚ پَڑِ یِمِس منز رلُن، مگر چھُس مےٚ پنُن سنٛبھالان تہٕ سکولہِ تہِ گژھان۔
یِمن دۄہن منز اَسہِ اَتھ پٲٹھ مضبوط شٲدی دِژھِتھ واریاہ سُہ لَگِتھ۔
کیا تُہۍ تہِ مےٚ برونٛہہ پٮ۪ٹھ پٮ۪ٹھ یہِ ’تُہۍ گٕڈ ڈگَر بٔنیٛو‘ والہِ تقریر ہیٚو؟
مےٚ چھُ بالکل نَہ پَسند زِ بۄنٛدِ پٮ۪ٹھ رۄسُن۔
سُہ نَسِتھ مےٚ ژٕنٛگِتھ نَہ ہٮ۪کان۔
مےٚ گٔے گَر تہٕ دِژھ زِ مےٚ ہُنٛد سٲری گَر بۄنٛدِ پٮ۪ٹھ تھَلِ سِتۍ صاف کٔر آمُت۔
مےٚ چھُ واریاہ پَسند زِ تِمَن سۭتۍ گَرِ رۄسُن۔
آ، یہِ چھُ واریاہ مزٕ آوُت۔
مےٚ چھُ آس زِ سُہل تہٕ مثبت چیٖز گژھن۔
برٛونٛہہ، تِمَن چھِ کۄنَن منز رۄسُن پَسند۔
سُہ تَتھ پٮ۪ٹھ نَہ یِیہِ یَتھ تام سُہ مدد کٔرُن شُروع نَہ کٔرِ۔
برٛونٛہہ، مےٚ ہِنٛد زنانہٕ سُہ بٔریٖن مےٚ سامنہِ تہٕ مےٚ دۄش ژٔٹ مےٚ ہِنٛد کُت مٮ۪کس پٮ۪ٹھ۔
اَسہِ سٲرنی چھِ تِمن دۄہن ہُنٛد ضٔروٗرت۔
مےٚ چھُ واریاہ اَفسوس زِ تُہۍ یِہ نَہ دِژھ ہیٚو۔ شاید تُہۍ تٔمِس آؤٹ کٔرِو آیس کریم خٲطرٕ، زِ تٔمِس تسلی مِلِ۔
یہِ عجیب آو، کیٛازِ ژٔمِتھ ہُنٛد جایہِ بلکل صاف آو، مگر تِمَن ہُنٛد باتھ روٗم آسِ بلکل برعکس۔
مےٚنِس پَتِس مےٚ چھِ أکۍ بٔڈۍ نازٕک انٛگٕٹھ دِتھ، یوس تٔمِس زٕچِس دادیٕک آسِ۔
مےٚ چھُ یاد، أکۍ وِز مےٚنِس اَسِوٕن کزنٕچِس بٔرتھ ڈے پارٹِس گژھُن، مگر بہٕ ژٕٹہِ نِنٛدرِس۔
مےٚنِس وٕنٛد مےٚ ژٕنِس زٕچِس نٔوِس ہای سکوٗلِس آنَر پروگرامَس دَعوتھ دِنہٕ آمٕژ۔
تِم بِلٕیَن ہٕنٛدِس کُنہِ پَتہٕ نَہ۔
بہٕ تہِ تُہۍ أک شُکریہ کارڈ پٔٹھِوٕن۔
یہِ چھُ کَتھ تہٕ تِم ہٕنٛدِس مَدَتھ کٔرِتھ۔
تِمِس نَہ دِیُو تُہۍ کَنٛٹرول کٔرِتھ۔
مےٚ چھُ سُوٕ ٹیسٹ کَل، تہٕ بہٕ چھُ نَہ پٔرِمتھ۔
آ، مےٚ چھُ نَہ شٕکِتھ انٛٹَرنیٹ بغیر ژٕنٛگ تصور کٔرِتھ۔
یِلہِ بہٕ آسٕس لُکُٹ، مےٚ کٔر ۵ ڈالر چوری۔
مےٚ ژٕ أکۍ وِز مےٚنِس أکۍ دوستَس کارٕ پؠٹھ بایِک ژٕٹہٕ دٔپھ۔
تِمِس یِتھ کٔرُن چھُ نَہ کَتھ؛ کیٛاہ تِمِس کُنہِ ؤچھِر وجہ آسِ؟
کِنٛہہ نَہ آسِ ٹھیک لَگان، مگر سُہٕر گژھِتھ ژٕٹہِ مےٚ اَسہٕ اَکہٕلٕچ بَہٕت اَحساس۔
کیٛاہ تُہۍ کَتھ کَتھ وِز تِمِس مَدَتھ کٔرِتھ ہٕیٚو؟
سُہٕ گژھِمٕژ آسِ یِلہِ بہٕ اوٚسُس پٲنٛژِس کٕلاسِس۔
بٔڈِس وِز سٕتۍ رۄزمٕژ پَتہٕ مےٚ زِچ گرٛل فرٛیٚنٛڈ مےٚ چھوٚڑِتھ گٔژھ۔
تِمِس یِتھ کٔرِتھ کِتھ پٲٹھۍ بٔچِتھ گٔژھ؟
یِلہِ تُہۍ یِتھ پٲٹھۍ کٲم کٔرِو، چھُ سٕری بٔڈۍ افراتفری تہٕ گڑبڑ لَگان۔
تُہۍ ہٕنٛز بٔڈۍ دوستٕچِس آخری دِیَن مَنٛز دُکھ سٕہان دِتھ نِشُن اوس بٔڈۍ مُشکل۔
مگر تُہۍ ہٕنٛدِس گژِمس مَنٛز تِم پَل دۄبارٕ ژٕنٛگِتھ نِشُن چھُ أک خاص کٲشر۔
یِمنٛ پَتہٕ یِہ اِستعمال کَرُن اوس، تِمن ہٕنٛد خٲطرٕ میٛہِ واقعی خراب لٲگ۔
واپس گژھنُک چھُ شوق، یا تَمہِ سۭتۍ چھِ خوف؟
گیراجس منٛز چھِ واریاہ کٲکروچ۔
تِہَن چھُ میٛہِ سۭتۍ ہمیشہ پریشان کٔرمُت۔
میٛہِ ہٕنٛز چھِ دِل کہِ کینہہ نَو گیمِنگ دوست بناوٕں۔
تِہِ کَشِیَر پٮ۪ٹھ کِیاہ چیٚخ ونان اوس؟
گژھِت ہفتہِ میٛٲنۍ اَکھ بیٚیہِ دوستُک ماجہ وارِ۔
بہٕ گژھِ میٚل اکھ گژھِر ڈٮ۪ٹنگ ایپ پٮ۪ٹھ۔
یہِ آسہِ جیہِ میٛونٛد زِندگی ہٕنٛد اَکھ لمحہٕ دۄبارٕ جِیوان۔
میٛون لۄ سکول چھُ لگ بگ تٔمِتھ۔
تُہۍ گژھتھ پَتہٕ کِتھ گژھِو؟
اَکھ دفعہٕ میٛہِ کیمپِنگ خٲطرٕ گژھُن پٔر، مگر تَتھ اوس نہٕ درُست سامان۔
میٛون چھِ بال ٹھیٖک لٲگٕن، مگر تِمَن ہٕنٛد چھِ واریاہ بہتر لٲگٕن۔
تُہۍ چھِ زیادہ احتیاط کَرُن ضٔروری۔
یہِ چھُ میٛہِ مشغول تھاوان، تہٕ بہٕ چھُس کانٛہہ نہٕ وٲنٛتھ۔
یہِ رِچَرڈ سکیٚری ہٕنٛد مشغول دنیا ہٕنٛز اَکھ پورٛٲنۍ سیٖ ڈی رۄم گیم اوس۔
اَکھ نوالہٕ کھاونہٕ دۄران میٛہِ مُنٛہس منٛز کینہہ چرچراہٹ محسوس کٔر۔
او یار، تِہَن ضرور واریاہ خراب احساس آسہِ۔
میٛون برٛادَر چھُ ہسپتالس منٛز تہٕ چھُ واریاہ بیمار۔
دۄہہ تِہہِ پَتہٕ میٛہِ اَکھ ٹیکسٹ میسج آو کہِ میٛون بٲیِہ موٹر سایکل حادثس منٛز پٮ۪ٹھ۔
تُہۍ تِم کَتھ پہنِو؟
یہ تازٕ جھینگا ٲس تہٕ مےٚ یہ خراب کٔر۔
مےٚ چھُس گیم یِوان پؠٹھ واریاہ پرجوش۔
یہ چھُ رِٹائرمنٹ پارٹی خٲطرٕ بلکل تیار۔
کیا تُہۍ کٔرِو کوشش تِمِس متعلق پنٛنِس باس سۭتۍ گَژھٕنۍ؟
یہ اوس قِسمچ نِش تہٕ رِشتہٕ یُس واریاہ جذباتی ٲس تہٕ بریک اَپ اوس خراب۔
مےٚ ہَہِکٕس نہٕ دٔہتھ دُکانُک ناؤ۔
اوہ مای، کیا تُہۍ تَتھ پَتہٕ شوگر رش گٔیو؟
آ، مےٚ چھُس سمجھان یُس تُہۍ ونان چھِو، مےٚ سۭتۍ تہِ یِم زٕ آو۔
ییلہٕ مےٚ کار حادثہ گٔژھ، مےٚ اوٚس خوف لٲگتھ۔
مےٚ دِتھ اوس اَکھ ژۄن دۄدُک ڈِپازِٹ، مگر مےٚ ہٕک نہٕ تِم لۄکُٹ تہٕ سُہ مٲر گٔیو۔
مےٚ چھُس سَدا نااُمید گژھُن ناپسند کران۔
سُہ چھُ تھوڑٕ دُکھی۔
مےٚ چھُس جانان، مےٚ چھُس پنٕنِس پؠٹھ واریاہ شرمندٕ۔
تھوڑٕ وٲتھ پَگاہ اوس تہٕ نزدیٖک بجلی گٔژھ تہٕ مےٚ بجلی گٔی۔
مےٚ چھُس دۄسرن ہُند بچوٗن لاڑ کران۔
مےٚ ڈوٚل اَز اَکھ ٹیلیویزن شو یُس مےٚ کٔر تَتھ متعلق سوچنُک۔
یہِ کتھ کَتھ وَختھ پٮ۪ٹھ گٔژھ؟
تَتھ پَتہٕ ییلہٕ تُہۍ تِم دِژھو، تُہۍ گژھِو خۄدایس متعلق سوچُن۔
اَکھ لَٹہٕ مےٚ ژٕپھ کٔر تہٕ پتہٕ لَگُو زِ تَتھ منز اوس اَکھ مُردٕ ژون۔
بہٕد خراب چھِ لگان، تُہۍ چھِ خیال تہٕ تِم گژھن پکڑ؟
تُہۍ کامیابی حٲصل گژھو، تہٕ مےٚ اُمید چھِ زِ آخر سٲری کینٛہہ ٹھیٖک گژھِ۔
آ، مگر بہٕ یہِ چھُس گۄڈے وٕتھ۔
مےٚ چھِ پنٛنِ بیٚیہِ پٲٹھۍ بٕہت فخر۔
تَمہِ سۄ مےٚ گژِتھ دۄہن ہُنٛد یاد آو۔
تھوڑا بہت اچھٕ ملازم دِوان وٲلۍ تہِ چھِ مشکل مِلان۔
تِم چھِ اَسہِ سۭتۍ میٖٹنگن منز آسِتھ تہٕ ونان زِ یہِ تِمن ہٕنٛدۍ بچن ہٕنٛدۍ غلطی چھِ نَہ۔
ساکس چھِ کَران زبردست سیزن تہٕ مےٚ چھِ ینکیز نَہ پٲنس پسند۔
مےٚ چھُس سٲری وٕقتھ اکھ یژھان۔
مےٚ چھِ خیال زِ سُہ چھِ مےٚ پٲٹھۍ بہتر سکور کٔرمت۔
تُہۍ چھِ بٕہت مزٕ کَران وٕقتھ گژھان۔
یہِ چھُ سُہِتھ زِ تُہٕنٛز بیٚیہِ چھِ تُہۍ پٲٹھۍ بھروسہ۔
یہِ ونان سۭتۍ چھُ لَگان زِ سُہ آس بٕہتھ سُہٕتھ وٲقتھ۔
سیٚلف سٔرو چیک آؤٹ گٔیہِ بنٛد، مگر سٹاف اوس تَمہِ نظرانداز کَران۔
ٹھیک چھُ، زِ تُہۍ چھِ پنٛنِ دوستس مدد کَران۔
مےٚ ہنٛدِس کلایس تہِ ژٕکھم لَگِتھ۔
اوہ، بہٕ ہیکان سٲری لیپ ٹاپ چاولن منز تھاوِتھ۔
مےٚ اوس تِمس ونان زِ مےٚ چھِ سٲری سجاوٹن ہُنٛد منظوٗری دِینۍ۔
کُتن ہُنٛد جایدادس پٲٹھۍ گژھِتھ تِم پٲٹھۍ روٗیہِ کرُن چھُ بٕہت بےعزتی۔
گژِتھ ویک اینٛڈس منز میٚون سٲری خاندان مےٚ پٲٹھۍ چھوٚڑِتھ گٔے۔
اُمید چھِ زِ تُہۍ خٲطرٕ سٲری کینٛہہ ٹھیٖک گژھِ۔
نَہ، گژھِ راتھ مےٚ دوستن میٚان چھوٚڑمُت۔
او ہاں، بہٕ گژھِ سُہ پار، یِہ چھِ اصل بات۔
بہت سٲری کینٛڈی تہٕ چاکلیٹ۔
مےٚ چھِ پتاہ زِ امریکہ گژھِ اگلے ورلڈ کپس منٛز کوالیفای۔
بہٕ چھُس کالج گرٛیجویٹ گژھِتھ واریاہ خوش۔
او نہ، کِتھ جایل حرکت کٔرمُت!
ہاں، بہٕ کٔرِتھ ہٲ، مگر یَلہِ تُہۍ گوٚو تِتھ پٲٹھۍ اصلس منٛز کٲم نَہ کَران، تَلہِ چھِ سُہ تِتھ پٲٹھۍ نَہ۔
سُہ پنٛنِس فونہِ سٟتۍ مَصرُوف آسۍ۔
یِمِس بارَس منٛز پنٛنہِ تھوڑا آرام دِیو۔
تُہۍ کِیاہ نٲو دِتھ سُہ؟
میٚون بیٚیہِ کٔرِ پنٛنِس پہلی سپیلنگ بی منٛز پٲٹھۍ پٲٹھۍ مقام حٲصل۔
اَز مےٚ کٔرِ پنٛنِ تہٕ پنٛنِ بچن خٲطرٕ اَکھ نٕو ناشتہٕ آرڈر۔
مےٚ چھُس خوش زِ یونیورسٹی ہُند اگلہٕ ؤرۍ شروع گژھان۔
بہٕ آسٕس پنٛنِ ماج ہُند کُتر گژھان، تہٕ سُہ وٲتھ نِکِتھ۔
کٲمَس نِکِتھ یِوان احساس چھُ سبنِس کھوتہٕ بٔہتر۔
مےٚ چھُس سٲری ویک اینٛڈ کٲم کَرُن۔
گرٛینٛڈ پرایز چھُ کیاہ؟
یَلہِ مےٚ سۄد زِ بہٕ حٲملہٕ چھُس، تَلہِ بہٕ گژھِ واریاہ حٲران۔
مےٚ چھُس اَندازٕ کَران زِ سُہ چھُ اَکھ واریاہ بٔڑ واقعہٕ۔
کاشِ مےٚ پٲٹھۍ ہُند آپریشن اَکھ مٲہہ پتہٕ نَہ، اَز گژھِتھ۔
کُنہِ دروازَس زورٕ زورٕ دۄد۔
مےٚ چھُ پٲٹھۍ ترٛےٚ مٲہن خٲطرٕ تھٲوِتھ خرچ ہُند ٹارگٕٹ پورٕ کٔرمُت۔
شُکر چھُ، بہٕ سُہ قابوٕ منز تھٲوِتھ سڑکٕک کَنٛٹھ لٲگِتھ ہیٚکٕم۔
یہ چھُ اَکھ زبردست ڈِلیوری کرن وٲل۔
مےٚ چھُ سِنیما کَنٛہہ گژھِتھ تہٕ پنٛنِس بواے فرینڈس سۭتۍ وقت گٲرِتھ پسند۔
بہٕ چھُس سفرٕ خٲطرٕ پنُن سامان جمع کران۔
سُہ گژھِتھ اَکھ خوشگوار حیرٲنی۔
کیا چھُ تُہۍ ہٕنٛدِس یِوان ویک اینڈس خٲطرٕ کانٛہہ پلان؟
مےٚ ہٕنٛدِس اَکھ بَچَس چھُ بیٚس بال خٲطرٕ اَکھ بٔڑِ کالج سۭتۍ ساین کٔرمُت۔
مےٚ کَن چھُ کینہہ سٹاک، یِم ہٕنٛدِس بارَس مےٚ بُزِمُتھ آسِہ۔
تُہۍ سۭتۍ سچ وُچھنہٕ
مےٚ چھُس واریاہ شُکرگُزار زِ میون کُٹمب چھُ نزدیٖک روزان۔
میون دوستَن چھِ کینہہ گۄڈ نَو جوتہٕ لیٚتھ، یِم چھِ بلکل میٲنۍ سٹایل ہٕنٛد۔
مےٚ چھُس تِم ہٕنٛد کمرٕ تِتھٕے تھٲوِتھ یُس سُہ آسِہ۔
مےٚ چھُس سارٕ پۄٹ لک پارٹیٖن منٛز واین نٮ۪وان۔
یِتھ مُلکَس منٛز بہٕ وارٕو، تَتھ چھِ مےٚ پنٛنِس والِدَین پٲٹھۍ تھٲوِتھ یُن پٲوان۔
مگر تِمَن چھُ پنٛنُ کمرٕ واریاہ گژر تھٲوِتھ، تِمن چھُ اَتھ کینہہ وقت خٲطرٕ باہر نَہ گژھان۔
ہا ہا، مےٚ چھُس شرط تھاوان زِ کینہہ گژھِ تۄہہِ باسان آسِہ یِم تُہۍ فٲرِتھ یِژھِو۔
مےٚ چھُس جانان تہٕ سُہ چھُ اَز تام میٲنِس خٲطرٕ تَتھ نَہ۔
ہمیشہ اَکھ بیٚیہِ ٹیٚلیوِژن آسہِ۔
یہِ چھِ واریاہ پٮ۪ٹھ کِسہٕ، مگر ژوٗنہٕ تہٕ گَرٕم وَنٛدٕر مےٚ سُہ ہمیشہ یاد کَران۔
یہِ چھِ اَکھ آنلایِن مارکیٹنگ بزنس۔
تُہۍ چھِو اَتھ پٮ۪ٹھ دَرد؟
سُہ چھِ اَکھ گۄڈٕ قدم۔
کَتھ سُکون تہٕ آرام دِن چھُ یہِ اِتوار۔
مےٚ چھُ واریاہ محنت کٔرِتھ تیٚیار کٔرِتھ یِوان پروفیشنل اِمتِحانن خٲطرٕ۔
مےٚ ڈیوٹھ اَز پنٛنِہ ژٕری پٮ۪ٹھ باہَر تہٕ ڈیوٹھ اَکھ سٕکَنٛک مےٚ طرف گۄڈٕ نَظَر کَران۔
ہا ہا، ہر اَکھُس پنٛنِہ پسند، کیازِ مےٚ چھِ بینگن نَرٕم آسُن پسند۔
مےٚ چھُ یِم یقین زِ سُہ چھِ وفادار۔
اَکھ وٲر مےٚ دِی پریزنٹیشن تہٕ پاوَرپایِنٛٹ پٮ۪ٹھ آو نٲموزون تصوِیر نَظَر۔
کینہِ لوٗکھ چھِ واریاہ چھوٹِہ سوچ والہٕ۔
یا ﷲ، مےٚ چھُ ہمیشہ اَکھ ہَسکی ژٕٹان۔
کیا تِمَن چھِ نہٕ پَتہٕ زِ تِم کِسِہِ روٗکِتھ ہیکن یِم ضروٗری طِبّی مدد مِلُن؟
اَز مےٚ گژھِتھ باہَر، تِمَن ہٕوِتھ صاف کَرُن آسُن، تہٕ مےٚ گَرٕ وَتھ ڈیوٹھ واریاہ گَنٛد۔
تُہۍ چھِو اَتھ پٮ۪ٹھ یِہ کھیلان؟
ہای، تِمِس سُہ مُسکان آس یُس سُہ اَزِیٖہ خراب کٔر۔
مےٚ کٔرِتھ چھُ واریاہ رِسرچ، اَسہٕ چھُ اُمید زِ مےٚ چھُ سُہ گۄڈٕ تیٚیار۔
مےٚ سۭتھ نَہٕ ہٮ۪کِتھ یِتھ وارِ کَرن۔
مےٚ چھِ وٕنان، یہِ واریاہ بَد تَگِتھ ہیکان۔
آ، مےٚ چھُ ہمیشہ جہازس منز اُڑنس منز ڈر، مگر مےٚ چھُ گژھُن کُٹمبچِ اکھ رٛکن ہُند وٲنٛگن۔
مےٚ ہُند برٛونٛہہ مےٚ ہُند راز مےٚ ہُند والِدینن نہٕ ونان ہُند وعدہٕ کوٚر، تہٕ ظاہر چھُ سُہ وُچھان تہِ وون۔
گژھان ہفتہٕ مےٚ ہُند اکھ دوست مُلکچِ دوٚیمِس طرفہٕ جہازس منز یِوان چھُ۔
آ، سُہ چھُ ہمیشہ مےٚ سۭتۍ وٕنٛدِتھ تہٕ سُہ چھُ سُہنٛز زبانہٕ سۭتۍ مےٚ سُوبہٕ جاگاون۔
تَمہِ کَری مےٚ ہُند انا زٕخم زٕ۔
مےٚ ہُند لان چھُ عام سائزُک۔
مےٚ چھُ روز یہِ ژٕ بلی محسوس کران تہٕ تِم چھِ ہمیشہ مےٚ پؠٹھ پھُس پھُس کران۔
کٕہہ گوٚو یَمہِ سۭتۍ تُہۍ یہِ پرژھ؟
تَمہِ پَزِ آسَن اَز تہِ محنت کٔرتھ پَرن۔
مےٚ ہؠک نہٕ تِمن پؠٹھ نظر کرِتھ۔
کیا تُہۍ کُنہِ مددُک اُمید تھاوان؟
مےٚ چھُ سوچان کِتھ کۭژھ لوکھ آسہِ یِتھ پٲٹھۍ رٛایڈس منز پھنٛسِتھ۔
تِم چھِ واریاہ ڈراون، مےٚ چھُ امید زِ مےٚ کَنہِ تہِ نہٕ دِژن۔
مےٚ چھُ زنٛدگِ منز کَتھ تہِ اَتھ پٲٹھۍ نروس نہٕ گوٚمُت۔
آ، بہٕ اوسُس ٹایلیٹَس منز۔
پَتہٕ آو تہٕ یِتھ پٲٹھۍ لٲگ زِ گوٚو دۄیم وٲنٛگن۔
اوہ واہ، مےٚ چھُ یقین تُہۍ آسِو تیار تَمہِ خٲطرٕ۔
خیر، شاید چھُ گژھُن شایستہٕ۔
کیا سُہ گژھِتھ واریاہ بُلَنٛد کُدِتھ یا کانٛہہ؟
مےٚ صرف یہِ نہٕ چھُس یژھان کہِ تِم میٛون دوستن سۭتۍ ناراض گژھن۔
ییلہِ أس کُنہِ بٔڑِ آفت بغیر گَرٕ واپس آی، مےٚ بٔڈ جوش یِوان۔
أس نہٕ وون یژھان کہِ تِم کھٲنہٕ آون بند کَرن۔
مےٚ پنٛنہِ زنٛدگۍ منز کِنہِ نِہٕ کَتھ یِتھ پٲٹھۍ خراب محسوس کٔر۔
نَہ، مےٚ گژھِ چھُس سَمَجھان کہِ سُہ وَتھرس سۭتۍ پریشان چھُ۔
آخر کِیا مسئلہٕ بنٛیو؟
جیس چھُس مےٚ پسند، یِمن خٲطرٕ مےٚ عام طور پٲٹھۍ تَمہِ سۭتۍ کانٛہہ مزٕ کَران۔
مےٚ ہٕنٛدِس مستری چھُ واریاہ دَفعہٕ وٲنان زِ سُہ مےٚ ہٕنٛد سِنک ٹھیک کرنہٕ خٲطرٕ یِیہِ، مگر سُہ پَتہٕ یِوان نَہ۔
اَس وقت مےٚ چھُس واریاہ ژَلان۔
مگر مےٚ چھُس پنٛنِس کُٹُمبرِ سۭتۍ پَرٕ پَران پَڑٕنۍ خٲطرٕ۔
کِنہِ قسمک سیکیورٹی کیمرہٕ چھا تُہۍ کَڈِس یہِ کٔرُن دِژھنہٕ خٲطرٕ؟
مےٚ چھُس شکاگو ڈِیپ ڈِش پِزّا پسند کران۔
مےٚ بالکل گھبراونہٕ اوس، مگر مےٚ ہٕنٛدِس انسٹرکٹر اوس واریاہ کول تہٕ پَنُن یقینی۔
أس چھِ باس بال کھیٚلن تہٕ ساحلَس پٮ۪ٹھ گژھن پسند۔
مےٚ چھُس یِتھِ نٔوِ پِزّا دُکان کُھلنس پٲٹھۍ انتظار کران۔
کانٛہہ وجہِ سۭتۍ یہِ کَم نَہٕ کران۔
مےٚ چھُس پنٛنِس کُتُرَس گلے لَگان تہٕ بوسہٕ دِوان پسند؛ تَمہِ چھُ مےٚ ہٕنٛدِ توجّہ تہٕ پیار ضروٗرت۔
تُہۍ چھا پنٛنہِ پیسہٕ واپس گژھنہٕ خٲطرٕ وٲن؟
مےٚ چھُس پنٛنِس آنٹِس واریاہ یاد کران۔
تِم چھِ ہمیشہ مےٚ حیران کران، کیازِ مےٚ چھُس گۄڈٕ موقعٕ پَتہٕ واریاہ اُمید نَہٕ کران۔
تُہۍ کیا نائیکی ہُنٛد کُنہِ سؤیٹ شاپَس منز کَم کَران؟
نہ اَتھ کہ تُہۍ پاگل گژھو، بس اَتھ یِتھ تُہٕنٛد پہلۍ اَکیلا نہ لَگہِ۔
تَمہِ چھُ اَج بی مِٹھ خوشبو، یِمِتھ مےٚ پُران گھرَس منز آسِکھ وَنٛدٕنۍ۔
تُہۍ پَزِ تامِ مےٚ دۄہ بَناو۔
ہَینگ اووَر سۭتۍ مےٚ دوستُک وِواہ ہِچ نہٕ گژھِتھ۔ یہِ بٔ نہٕ عقلمندی، تہٕ مےٚ چھُ اَج بی تَمہِ پٲٹھۍ بُرا لَگان۔
مےٚ چھُ نہٕ پَتہٕ سُہ یہِ کَتھ کَتھ کَران۔
مےٚ چھُ پَزِ تَمہِ حالَتِس منز آسِتھ۔ مےٚ ہٕنٛدۍ شَوہر چھُ فوجَس منز، یِمِتھ سُہ واریاہ دۄہ دور گژھان۔
مےٚ ٲس پَزِ تَمہِ گَرِس منز روزُن یِمِتھ ماساچوسِٹس منز ٹام بریڈی تہٕ جِزیل ٲسِتھ روزان۔
شاید تُہۍ چاوا اَنٛکٕل باہر ڈِنَرَس نِوِو۔
