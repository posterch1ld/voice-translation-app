گژھِو پانٛنِس منز تال میل تھاوُن۔
سُہ گژھِتھ آسِتھ واریاہ کول۔
مےٚ دۄن بیی چھِ سۄنٛدر موسیقار۔
مےٚ پونٛس پرٛیزنٹیشن خٲطرٕ واریاہ تیٲری کٔر، مےٚ یقین چھُ سُہ سُہِ کارکردگی دِ۔
بہٕ یِم ہفتہٕ تَتھ کُن منتقل گژھان چھُس۔
ہا ہا، مےٚ چھُ معلوم تُہۍ کیٛاہ محسوس کران۔ مےٚ چھُ تہِ پرٛنٛدٕن ہٕنٛدِس دٲنہٕ دِتھ پٲنٛس گھرٕ باہر تِم دِکھنُک شوق۔
مےٚ چھُس خیال کران زِ سُہ گژھِ واریاہ پریشان۔
مےٚ بہٕن چھُ پٲوان لاک ہیڈ مارٹنَس منز کٲم کران۔
مےٚ اوس ونان سُہ کینسر اوس۔
مےٚ برٛونٛہہ ہٕنٛدِس وٲتِس خٲطرٕ آزماونہٕ خٲطرٕ آنلایِن کینہہ جوڑِ لبٲس ؜خٔریٖد۔
مےٚ نظرٕ منز چھُ نہٕ کانہہ سونٛدر۔
مےٚ چھُس واریاہ فلمہٕ دِژھان، مےٚ چھُس محسوس کران زِ بہٕ سُہ سمجھِ ہٲوٕس۔
مےٚ چھِ تھرِفٹ سٹور واریاہ پسند۔
یِم ہفتہٕ مےٚ برٛونٛہہ یِتھ مےٚ کُن ملاقات کرِ۔
مےٚ یہِ رِپورٹ کٔر تہٕ تِمَن میلر پٮ۪ٹھ، مگر کینٛہہ تبدیل نَہ گٔے۔
مےٚ پنٛنؠ متعلق گژھِتھ وٕریا خراب محسوس۔
تہِ چھُ سٲنۍ سات گژھُن بلکل زبردست۔
مےٚ خراب محسوس کران، اسہِ پٲٹھۍ سُہ صبح بدلُن پَژھ۔
گژھِتھ مےٚ کلٕ واریاہ پریشان۔
مےٚ تَمہِ پٮ۪ٹھ خراب محسوس کٔر، مگر مےٚ واریاہ تھَکمتھ۔
آ، سُہ چھُ واریاہ نِش، تِمِس خٲطرٕ چھُ سُہ نِش۔
کل مےٚ پنٛنؠ اکھ پورٕن دوستس سٲتھ وقت گٲرِتھ۔
کینہہ ہفتہ گٔے، مےٚ ہِنٛزِ ماجِ موتُک سالگرٕ آس، تہٕ سُہ کِنہِ ویزِ آسان نَہ گژھان۔
اوہ نِش، تہٕ یہِ کِتھ پٲٹھۍ گٔے؟
یہِ چھُ مےٚ دادس خٲطرٕ تحفہ۔
آج مےٚ سٲتھ کٲم کرن وٲلٕ جلدی گٔے تہٕ مےٚ پٮ۪ٹھ ڈھیر سٲری کٲم چھٔڈِتھ گٔے۔
مےٚ پنٛنؠ جوانی ہنٛز بے فکری یاد گژھان۔
واریاہ فِکر نَہ کَر۔
مےٚ فیصلہ کٔر پنٛنؠ بیٹہٕ نَو ڈے کیئرِس منز روزنُک، یُس چھُ گھرٕچ نزدیٖک۔
گژھِتھ رات کُنہِ کٔر مےٚ ہُنٛد ٹرکُک ٹیل گیٹ چورُن ہٕنٛد کوٗشش۔
کل مےٚ پنٛنؠ اٹِکَس منز ژٕلتھ گژھان۔
مےٚ ہٕنٛز گرل فرینڈن دِتم کَنسرٹ ٹِکَٹ، مےٚ ہٕنٛد پسندیدہ بینڈ دِدِر۔
نَہ، کیازِ تِمَن مےٚ ہُنٛد حِصہٕ چور کٔر۔
سُہ چھُ بلکل بدترین—کُنَن کٔر تُہٕنٛد مذاق؟
مےٚ بس یہ یقین نَہ اوس کہ یہ کِژھ گژھِ۔
اوہ نَہ، کیا یہ کینسل گژھ؟
مےٚ تیار روزُن چاہان۔
مےٚ واقعی خوش چھُس کہ یہ ختم گژھ تہٕ مےٚ وُنہہ باقی چیزن پیٹھ توجہ دِتھ ہیکان۔
مےٚ اداس گژھان ییلہِ مےٚ پنٛنؠ والدینن ہٕنٛز فکر کران۔
کیا تُہۍ دیر تام کام کرنہِ منٛز پھنس گژھِو؟
مےٚ تقریباً یقین چھُس کہ یہ مےٚ کرِتھ ہیکان۔
تَمہِ چھُ کچنَس منٛز تہِ اکھ۔
مگر چرچس گژھنہِ برونٹھ نِہ کھٲیو۔
یہ چھُ کمال، ٹورنامنٹ کِہہِ خاطر چھُ؟
پَتہٕ ہفتہٕ مےٚ پنُن گولڈ فِش مۄتھ مچھلی ٹینکُک سرٕس پٮ۪ٹھ ترٛاوان لَبن۔
مےٚ ژٕتھ اوس کہ مےٚ بہتر کَرُن گژھِ اوس۔
گژھِ کل مےٚ پارکَس منٛز پنُن بہترین دوست دِتھ۔
مےٚ اکھ نوٕ نوکری حٲصِل کٔر۔
مےٚ برٛونٛہہِ ہای سکولس منٛز یِم کام نَہ اوس کٔرمتھ، تَمہِ خٲطرٕ اکھ انتہٲی انتقامی استادن تَمہِ سسپینڈ کٔر۔
ہاں، پرٛون کھلٲون ہٕنٛز فکر کرنہٕ سۭتۍ مےٚ تھوڑا اداس گژھان۔
یہِ ماہ مےٚ بجلی ہٕنٛد بل دۄن پٲٹھۍ زیادٕ اوس۔
مےٚ وُنہہ سٲری نَروس چھُس۔
مےٚ علاقس منٛز یِم تہِ جانور چھِ، تِمن خٲطرٕ تہِ خراب لَگن۔
اگر تُہۍ یہِ خیالَس منٛز تھاوِو، تَہٕ نوٕ کار اصل منٛز اکھ بہترین سرمایہ کاری بَنان۔
تُہۍ یُس کٔر، سُہ چھُ واریاہ سُہ۔
تَمہِس مےٚ سَدارنٛگ أسۍ سُہ وُچھُن یِم پٲٹھۍ ژٔلُن۔
یِمنِچ مےٚ بٔڑ یِوان، تِمِس مُقابلس منز چھِ اَز کَل بنٲونہٕ یِوان ٹی وی ہُنٛد معیار واریاہ تٔرٛٲو۔
مےٚ ٲس واریاہ اکیلا، یِمن دۄستَن تہٕ وۄنۍ یِم گرل فرینڈ چھِ میلان، تَمہِ برونٛہہ۔
مےٚ ہُنٛد اسسٹنٹ کِنہہ فٲیلہٕ غَلَط ٹیبلس پٮ۪ٹھ تٔھاو؛ سُہ ٲس سادٕ غَلَتی، مگر تٔمۍ کٔر مےٚ سۭتۍ دَلَت۔
یِلہِ تۄہہِ کٔر سُہ پار، تَمہِ ویزِ تۄہہِ کِتھ پٲٹھۍ ٲسِو؟
نَزدیٖک پارکِنٛگ جاے دۄڈان آسِہِ اَکھ سُست زنٛگہٕ کٔر مےٚ نٔوۍ کارس پٮ۪ٹھ پٮ۪ٹھِ وار۔
سُہ چھُ واریاہ سُہ زِ تۄہہِ چھِ تَمہِ منز کینہہ مُثبَتھ دِژھان۔
ہاں، تِم ٲس مےٚ کمرس منز تہِ رٲوان۔
مےٚ چھُ واریاہ ڈر کوسٹرس سۭتۍ۔
مےٚ چھُ وُچھان، مگر کاش مےٚ ہٮ۪کہِ کٔرِتھ۔
اکھ ٹولۍ بَچن سۭتۍ ژٕ گَنٛٹہٕ سفر کٔرُن چھُ کانٛہہ مزٕ نَہ۔
تۄہہِ کِتھ پٮ۪ٹھ اَز تہٕ وۄنۍ تام وٲتھ کٔرُن پَزِ؟
یِہِ سُنتھ آسہٕ دُکھ زِ سُہ نَہ کٔر کٲم۔
ہاں، سُہ ٲس واریاہ پٲٹھۍ برونٛہہ ہُنٛد۔
مےٚ چھُ سُہ احساس معلوم، مگر تَقریبَن أکھ وُہَر پَتہٕ کٔر مےٚ سُہ کار کریش یِم مےٚ دادَن میٚنِ خاطر کٔنی ٲس۔
کیا تۄہہِ چارٹر سکول ہٕنٛدِ بارے منز وُچھمُت؟
کیا یِہ چھُ وۄنۍ اَتھ عام واقعہٕ؟
پکٕک، سُہ قدم چھُ واریاہ مُشکل۔
سُہ گژھِ ضٔروٗر اَکھ سُہ احساس۔
غلط آرڈر کینہہ ٹھیک اوس؟
کینہہ وار اسہِ پَتہٕ نَہ لگن کہ باقی انسان کِیا کٔرِتھ ہیکن۔
کیا تُہندِس دوستَن کینہہ خراب کوٚر؟
مےٚ پَتہٕ چَل کہ مےٚ کٕمٕہِ خٲطرٕ مُلکَہِ بَرٕنٛہہ گَژھُن پَیہِ، تہٕ یہِ گَژھِ مےٚ بالکل بے خبر۔
تِم بَیہِ زَنہِ ہِنٛد گَروپ اوس یِم سۭتۍ مےٚ کٕم کوٚر۔
کرٛیڈِٹ کارڈ کَمپنِی سۭتۍ رابطہٕ کٔرتھ نَو کارڈ جاری کَرُن پَوان۔
تِمۍ اسہِ ژٕٹ گَر بدلاوُن، مگر اَسہِ ہِنٛد کُکُر کُٹھ ٹریلرَس منٛز نَہ یِیہِ۔
سُہ کِس لَتھ بٔمٲر؟
اَکھ وٲر مےٚ ہِنٛز رٲنسِ کُٹھِ منٛز اَکھ چُوہ اوس۔
مےٚ پَتہٕ اوس، مےٚ تُہۍ سۭتۍ صرف طنز کران اوس۔
یہِ تُہندِ خٲطرٕ واریاہ صدمہٕ دِن وٲل اوس۔
تِم ۸۰ وں دَہٕکَچِ اَکھ بَینڈُک کَوَر بَینڈ چھِ۔
سُہ چاہان چھِ کہ مےٚ دِکھٲو یِہ سُہ چھِ مےٚ ہِنٛدِس سابق پارٹنرس سۭتۍ بہتر۔
مےٚ چھُس معلوماتی نظامن ہُنٛد شعبس منٛز۔
مےٚ اوس پٔٹھ یقین پولیسن پؠٹھ۔
سُہ چھِ تَمہِ جٲےِ ہُنٛد سۭتۍ کَٹھ کٲم۔
گَرٕ گژھِتھ دِژھ کہ سٲری شےٚ نوٕ رنگ لَگٲوِتھ چھِ۔
نَہ، سُہ کوٚرِم کھیٚل پَچھِلے وُہرس مِڈٕل سکولس منٛز۔
یہِ چھِ عجیب، مال چھِ جِنہٕ شہرن ہِنٛد مٔثٕل، ۹۰ وں دَہٕکَس منٛز یِتھ پٲٹھۍ نَہ اوس۔
ژٕٹ اسہِ ہیکہِ تُہۍ ایٚٹٲرنی اَٹ لاہ وُچھُن۔
واہ، سُنِتھ لگٕان چھُ کہ تُہۍ کَنٛہہ شکریہ ادا کرنٕچ کافی وجہہ چھِ۔
مےٚ اوس نٔو نِنٹینڈو سٕوِچ گژھِتھ ژٔرٕن، مگر سُہ سٲری وٕکٕنہٕ گٔیہٕ اوس۔
تٔم کتیٛاہ وَن چھِ؟ میون ژٔور چھُ گژھان ۲ وَری پٲٹھۍ اگلے مٲہ۔
یِلہِ وقت سٲنۍ گژھِ، تُہۍ ہیکِو اکھ دۄہ پنُن ہمسفر لبِتھ۔
یِلہِ بہٕ اکھ لایٹہِ پیٹھ اوس ترٛاوٕن، کۄنہِ ہٕنٛدۍ میٚون کار کُن ڈکّر دِتھ تِہ سُہ رَن آف گٔیو۔
بہٕ تہِ تِتھٕے محنت کران چھُس، مگر میٚون کَنٛہہ چھُ نَہ۔
مےٚ چھُ رولر کوسٹرن ہٕنٛز سٲری کھۄف۔
مےٚ اوس پنٛنٮ۪ دوستُک گَرِہِ پیٹھ اکھ گفٹ کارڈ چورمٕت۔
کیا تٔم نِش سُہ دوبارٕ لٕگِتھ؟
آ، سُہ اوس میٚانِ خٲطرٕ سٲری خوشی، تہٕ مےٚ تہِ اوس حیران گٔمُت۔
روزٕ سُبُح جاگُن۔
مےٚ گژھِ کل اکھ چاکلیٹ کیک بنٲوُن۔
آ، مےٚ نَہ مانان چھُس زِ کٲنٛہہ تہِ تَتھ گژھُن پسند کران۔
میٚون برٛون میٚانِ خٲطرٕ بیئر پٮ۪ٹھ اکھ سبق سٕکھٕوو۔
شاید مےٚ گژھِ سُہ آزماوُن۔
نَہ، میٚون ساسُر اوس اَسہِ خٲطرٕ پٮ۪سے دِوان۔
تُہۍ کِنہِ قِسمُک امتحان چھُ؟
سُہ چھُ میٚون پسندیدہ جاےِ چھٹٕی گژھنٕچ خٲطرٕ۔
مےٚ اوس تازٕ اکھ نٔو کُتُہٕ لیٛوٕمُت، تہٕ تَمہِ ہٕنٛز دیٚکھ رٲکھ کٔرِتھ مےٚ چھُ سٲری مزٕ آوان۔
مےٚ چھُ نَہ یژھان کَم پٮ۪ٹھ گژھِتھ تہِ۔
وَسے تہِ تُہۍ اَز رٲژ نہٕ وُچھِو۔
مےٚ سوتیل باپ ہَسپتالس منز چھُ تہٕ مےٚ فون نہٕ کور۔
مےٚ سٕنٛد گژھِ یِتھ کُتھ ہایوے منز گژھِ تہٕ اَکس یِوان گاڑِ کٔر ژھٹ۔
مےٚ چھُ یقین، واریاہ لوٗکھن کٔرۍ نوٹس۔
مےٚ چھُ اَز پَتہٕ شےٚ تھَرَن ہَند بین ڈِپ بناوُن۔
آ، پتہٕ مےٚ محسوس کٔر زِ مےٚ کٕنہہ چھُ نَہ۔
کینہہ تہِ واریاہ وۄقتھ پالِت محبوب پالتو جانورٕچ جٲے نَہ لیٚکھِ، اصلس منز چھِ صرف یادٕو باقی۔
واہ، مےٚ چھُ خوش زِ تُہۍ گٔژِو اچھا سکور۔
مےٚ چھُ خیال زِ تٔمۍ ہُند ڈیٹ گژھِ واریاہ حیران۔
عجیب چھُ زِ کٕنہہ تہِ نہٕ کٔر تُہۍ سٕنٛدِس بارَس منز۔
فِکر نہٕ کٔر، یِمَن لوٗکھن پٲٹھۍ کَرما چھُ زوردار ژھٹ دِوان تہٕ تِمَن چھُ حَق دار مِلان۔
مےٚ اَکھ خراب حادثس منز آسُس تہٕ بچِ گٔیوس۔
مےٚ سٕنٛز محلہِ منز ژٕوٗر کھیلان وُچھِتھ مےٚ چھُ بچپن یاد یِوان۔
یہِ کَیٚلکُلس آسِ، صرف اَکھ تعارفی کٕلاس، مگر مےٚ چھُ نہٕ واریاہ اچھا حسابس منز۔
مےٚ چھُ حیران زِ اَز نہٕ وریو۔
مےٚ چھُ واریاہ خوش زِ مےٚ سٕنٛز کزن تہٕ مےٚ دوبارٕ رابطہٕ کور۔
اَکس دۄہ مےٚ سُر اپارٹمنٹٕچ دروازس پیٹھ زور زور کٔرۍ کھٹکھٹاونہٕ سۭتۍ نیند وُٹھ۔
سکولٕچ باتھ یِوان تِمَن لوٗکھن ہُنٛد کٕنہہ کام چھُ نَہ، کَتھ کَتھ چھِ تِم بلکل بےکار۔
مےٚ چھُ بلکل پتا نہٕ زِ یہِ کٔنہٕ کٔر۔
فُٹبال، ساکر یا امریکن فُٹبال؟
اچھا، ڈریس مےٚ گژھِ نہٕ فِٹ۔
تِم فلِپ تہٕ باقی سارٕ کَرآن ہٕو، یہِ کَتھ زبردست ٲس۔
مےٚ چھُ سُہ یاد کرُن یِتھ پٲٹھۍ، اُمید چھِ زِ تِم سٲری گژھن نِک یاد۔
تِم یِتھ گژھن تُہٕنٛدِس گَرِس نٛزدیٖک، تُہۍ کِیاہ کَرِو؟
مےٚ چھُ حیران زِ پِک اَپ ٻارٕہِ وری چلِتھ۔
مےٚ دوستَنۍ مُج کِرٛوزَس پٮ۪ٹھ دعوت دِتھ، مگر مےٚ آس نہٕ یقین کیازِ مےٚ چھُ آسانی سان سَمُندَرِس منز بیمار گژھان۔
کَم اَز کَم یِتھ گٲڑ رِشتہٕ چھُ مطلب زِ تِم کَنہِ نہٕ کَنہِ طریٖقہٕ تُہۍنٛد حِصہٕ بَنِتھ رۄہَن۔
یہِ چھِ اَکھ گوٗڈ انتخاب۔
سُہ ضروٗر زِیادٕ پریشان کُن ٲس۔
مےٚ یہِ تٔم دۄہ دٕچھ یِلہٕ مےٚ ٲس صرف ژٕھ وری۔
مےٚ چھُ آڈیو تیار کَران تہٕ گرمٕی ہُنٛدِس آخرِس پیٚٹھ مےٚ اَکھ البم یِوان۔
گژھِتِ ہفتہٕ ٲس مےٚ سالگرٕ تہٕ مےٚ چھُ ابھی نَوِس شہرِس منز شفٹ گژھِتھ۔
مےٚ نہٕ کَتھ پَزِ کِیاہ کَرُن۔
مےٚ لانُک گھاس چھُ بٔڑِتھ گژھان تہٕ مےٚ نہٕ پَزِ زِ مےٚ ہیکہٕ نَو موٗوَر کِنیٛتھ یا نہٕ۔
مےٚ ہٕنٛز اَکھ دوستَنۍ ٹرایَتھلَن منز پنٛنِس عُمرِس زمرِس منز اول مقام حٲصِل کٔر۔
تُہۍ چھِوا یہِ پنٛنٮ۪ن کَران یا کُنِس مدد کَرنہٕ خٲطرٕ کُنِس روزگار دِوان؟
کِیاہ تُہٕنٛد کٲم کَرِ سُہ اِنتظام؟
یہِ چھِ اَکھ سُہاوُن پروگرام۔
مےٚ ٲس پٔزۍ تیار یہِ وارٕ سنٛبھالنہٕ خٲطرٕ۔
مےٚ چھِ نَفرَت یِلہٕ مےٚ ہٕنٛز زَن تہٕ پٲنہٕ مےٚ کَنۍ دوٗر ٲسَن۔
سُہ چھُ یِم پٮ۪ٹھ مےٚ سۭتۍ سۄنٛچِتھ
ہاں، مےٚ تہِ تٔمِس پٮ۪ٹھ سِکھِتھ ہٮ۪کِس
واہ، قسمتُک سُہ روٗپیہِ آسِتھ ژٕ جمع گٔے
سُہ چھُ واریاہ لمبہ وقت تکلیف سٲنِتھ
مےٚ چھُ سُہ کار کٔرُن یِمۍ سُہ صبحِ دۄہِس کامہِ پٮ۪ٹھ
تِم چھِ کِتھ پٮ۪ٹھ اکھ سٲتۍ
نَہ، اصلس مےٚ چھُ سَدا یِہ ژٕ چاہان
مےٚ چھُ واریاہ اُمید یُس تُہۍ فُٹبال دِوان تہٕ تُہٕنٛز سُہ نیک پٲنۍ سۭتۍ سکون لَبِو
اَسۍ چھِ کَنہِ کَنہِ غلطی کَران
مےٚ چھُ سٲری سامان پٮ۪ک کٔرِتھ تیار کٔرِتھ یِم ہفتہٕ آخرِ کٮ۪مپِنگ ٹرِپِس خٲطرٕ
آ، مےٚ چھُ لگاتھ یُس مےٚ غلط آس پِی
مےٚ چھُ پَتھ، مگر مےٚ چھُ کھٲنہٕ واریاہ پسند
آ، مےٚ چھُ پتہٕ یُس سُہ مےٚ مِلہِ؛ مےٚ چھُ یِم ہفتہٕ رٲڈ کَران
آ، اَسۍ ہٕواہس منٛز پَران آسۍ
مےٚنِس ژٔھ پٲٹھۍ چھِ واریاہ خراب تہٕ مےٚ چھِ یِہ خواہش یُس مےٚ یِتھ یونِٹَس منٛز اکیلہٕ روزان آسُن
مےٚ نَہ ہٮ۪کِس دوبارٕ کُنہِ گَژھِتھ تَتھ جایہِ پٮ۪ٹھ
یِلہِ مےٚنِس دوستہٕ ہٲے سکوٗلَس منٛز اَسۍ سٲریَن ہٕنٛز والیدِکٹورِیَن بَنِتھ، مےٚ آو واریاہ متاثر
کیا چھُ تُہٕنٛد پٮ۪ٹھ اثر یِہ جانِتھ یُس تُہۍ تِمِس قٕسمُک واقعہِ سۭتۍ نِشٕ منز نِنٛدرِ منٛز آسۍ
تُہۍ گژھِتھ آسِتھ سٲری گَر چٮ۪ک کٔرُن
حالی حال مےٚنِس ژٔٹِس منٛز چھُ تیز درد گژھان
شاید سُہ مےٚ یہِ چیز سمجھنٕچ مدد کٔرِتھ ہیکہِ
مےٚ لَگ بسترِچ نیچٕہِ اکھ پورٕنۍ کیلے ہنٛد چھلکہٕ لَگ
تَمہِ مےٚ پنٕنۍ ٹیسلا سٕفرٕچ سٲری وِز آٹو پائلٹ پٮ۪ٹھ چلاون دیوت
مےٚ دوست ۳ منٛہن منز دۄیم زبان واریاہ روانی سان وون سِکھ
کیا چھُ تۄہہِ کُن کانٛہہ ساتھی
مگر بہٕ واریاہ پریشان اوسُس
یہِ چھُ سُہ گیم یَتھ متعلق چھُ ہَر کُن ہٕندِ واریاہ گپ شپ
مےٚ گژھ گھر گژھِتھ اکھ گلاس واین پیوُن تاکہٕ سُہ شرمندگی ہَٹِتھ
مزٕ چھُ! یہِ کُن کَنسرٹ چھُ
مےٚ چھُ واریاہ پسند پنٕنۍ ماجہِ سٕتۍ تِمۍ تہٕ مےٚ ہٕنٛز بچپن ہٕنٛدِ بارے گپ کرُن
مبارک! تۄہہِ ہؠکِو آزادانہٕ مُسکرٲوِتھ
یَلہِ مےٚ سُہ خبر لٕگ زِ مےٚ ہٕنٛدۍ برٛونٛہہ کینسر پتہٕ تہِ ژِندٕ رہِ، مےٚ واریاہ سُکھ لَگ
مگر یُس وِز یَتھ تۄہہِ آنلایِن پٮ۪ٹھ کانٛہہ اَسہِ کام نہٕ کَران یُس نہٕ کٔرُن چھُ تۄہہِ
سکاوٹٕس منز اوسُم یَلہِ مےٚ جیلّو کھاونُک اکھ مقابلہٕ جیت
آ، پَر تۄہہِ ہَر کینٛہہ جیتِتھ نہٕ ہیکِو
شاید سُہ اِتھ پریشان چھُ زِ بھونٛکِتھ تہِ نہٕ ہیکہِ
مےٚ چھُ واریاہ خۄش زِ مےٚ کالیج کورس پاس کٔر
آ، یَتھ کُن کینہہ نقصان تہِ چھِ، مِثالِہِ گاس بڑاون
یہِ پیمنٹ کِس خٲطرٕ چھِ
مےٚ ہیکہٕ تۄہہِ ہٕنٛز بےچینی محسوس کٔرِتھ
مےٚ چھُس خیال کران زِ سُہ لگ بگ کرِتھ اوس۔
مےٚ چھُس امید کران زِ یہِ مےٚ پؠٹھ نہٕ ٹُٹِ۔
یہِ چھُ سچُے منز اکھ بٲثر نہٕ آسُن جُرم۔
مےٚ چھُس چاکلیٹ پسند، تُہۍ کُن چھُ پسند؟
کیا تُہۍ کَتھ کُنٛہہ پنُن پسندیدہ اَکھ نفر راتھ کھاونہٕ خٲطرٕ گھر دعوت دِتھ؟
تُہۍ چھِو کُکرن سٕتۍ کیٛاہ کَران؟
تُہنٛد پینٹ کُنہٕ کُنہٕ کھسِتھ؟
آ، یہِ نَہٕ اوس سُہترین؛ مےٚ ہٕنٛدۍ واریاہ دوست روزن کُنہٕ دۄہ دُکھی۔
امید چھُ زِ اتھ پٮ۪ٹھ سٲری چیز سُہل گژھِ۔
ٹارگٕٹ منز مےٚ پَتھ قطارِس منز اوس یہِ بٲیہ نہٕ چُپ گژھان۔
مےٚ چھُس یہِ تہِ نہٕ جانان زِ مےٚ کُنہٕ خٲطرٕ آرڈر کٔر۔
تِم پتہٕ لٲگِ زِ یہِ کُن کٔر۔
دۄیم لفظن منز، تُہۍ چھِو تِمن مالی طور مضبوط بناون یژھان۔
مےٚ چھُس مِزوری منز رَوان، مگر تَتھ پٮ۪ٹھ پٮ۪ٹھ کٮ۪نساس منز رَوان اوس۔
مےٚ کٔر اگلے ہفتہٕ خٲطرٕ اکھ چھُٹۍ بُک۔
بے شَک، مےٚ چھُس سُہترین کرُن لازمی۔
تُہنٛد دوستن کٔر نہٕ پیشکش زِ تُہۍ خٲطرٕ کانٛہہ ڈرِنک یا کینہہ دۄد خریدِ۔
کالج منز گریجویٹ گژھنہٕ پیٹھ مبارک، تمنٛد خٲطرٕ مےٚ چھِ سٲری نیک تمنٛا۔
مےٚ آو کٔر جِم منز نٲو درج، تہٕ سُہ گژھِ واریاہ صُبحَس پٮ۪ٹھ شُروع۔
مےٚ امتحان پاس کٔر تہٕ مےٚ ہٕنٛز ماج کٔر پَتھ گژھِ مےٚ اکھ کار دِنس وعدٕ۔
قیمت مناسب اوس۔
مےٚ اَز تہِ لٕگن چھُس کہ بہ ناکام گژھان۔
گَژھِ رات بہٕ اَکھ ڈراون فلم دِتھ، تہٕ اَز تہِ چھُس بہٕ زٕبردست ڈرمت۔
پتہ چَل زِ سُہ لازمی فوجی بھرتی پٮ۪ٹھ فرار چھُ۔
ٹھیک چھُ، بہٕ تہِ لو کارم کران۔
کیا تُہٕۍ اَزے اَپُن والٹ وُچھ یا تُہٕۍ چھِو نہٕ کانٛہہ پَیسہٕ؟
بہٕ تہِ تَمہِ آسُس؛ کتھ پٲٹھۍ دیر گٔیہ؟
مےٚ یقین چھُ زِ اگر تِمَن پٮ۪ٹھ جرمانہٕ لٕگُن شروع گٔیہ، تِم یہِ صاف کَرِ دِیِو۔
لایِو چیٹَس پیٹھ مےٚ اَکھ زٕبردست سٕہ گٕژھ مٕل۔
مگر اگر تِمَن لٕگہِ زِ یہِ چھُ تِمَن ہُنٛد حق، شاید تِم چھِ سوچان زِ سٲری کینہہ نارمل چھُ۔
سُہ اوس مےٚ ہُنٛد گَرٕچ سٕمَنٛز تالہٕ لٕگمتھ۔
یَتھ سُہ کُنٛہٕ کُڑِ کٲشِش کٔر مےٚ چُمی دِتھ، مےٚ پَتہٕ ہَٹِتھ کھڑٕ روٗزُن پٲو۔
مگر افسوس، یِم گَرِ چھِ زٕبردست ہُلڑ کَران یَتھ پٲٹھۍ اَز راتھ چھُ تھَڈَگ ژٕلان۔
مےٚ ہُنٛد کُٹٕب چھُ مےٚ ہُنٛد تقریبن سٲری راز جانان۔
مےٚ ہٕنٛدۍ بٕہنَن مےٚ ہُنٛد والٹ پٮ۪ٹھ پیسہٕ چور کٔر۔
تُہۍ چھِ صحیح ونان، یِمِہ سۭتۍ چھُس بہٕ کافی پریشان تہٕ ڈرمت، مگر بہٕ کرِ کوشش زِ یِم پٮ۪ٹھ پار گژھِتھ۔
بہٕ کوشش کران چھُس، مگر کُنہِ وِز تہِ نہٕ پٲران پنٕنۍ منزل پٲٹھۍ۔
مےٚ نہٕ وُچھ زِ مےٚ کِتھ پٲٹھۍ اِتھ نروس آسُن۔
بہٕ اَز تہِ اُمید نہٕ ہٲران۔
آز تُہۍ پنُن خیال رٲکھِتھ پنُن لاڈ کرِتھ ہٲیکیو۔
مےٚ تقریباً ۵۰ رۄپۍ ہٕنٛدۍ سودا سلف آرڈر کٔر، صرف ضٔروٗری چیٖز۔
میٲنۍ زَن تقریباً اَکھ وری کُنٛہہ پٮ۪ٹھ مرگٔ، اَتھ کُنہہ خاندان چھُ نہٕ۔
کُرۍ کِیاہ دِژھان چھِ تِمَن منز، مےٚ چھُ نہٕ پَتہٕ۔
مےٚ چھُس پنٛنِس ہانٛہِ ہٕنٛدِ ڈی این اے ٹیسٹُک نتیجہٕ واپس یوان پٮ۪ٹھ بٔڈ خوش۔
مےٚ دوستَن میٚ چھوٚڑمُت—کَتھ دوست چھِ یِم!
کیاہ تُہۍ کَتھ کُنہہ پرفیکٹ گیم باؤل کٔر؟
ہای، مےٚ کٔر اَکھ خَراب فیصلہٕ، راتِ دِیر گٔیہ اکیٚلہِ ہارر فلم وُچھُن۔
مےٚ چھُس سَچِس منز پگاہ وَزٕنۍ خٲطرٕ دُعا کران۔
گرمی چھِ کَم گَژھان، تہٕ مےٚ چھُس تیار تھوڑِ دیر آرام کرنہٕ خٲطرٕ۔
تُہٕنٛدِ مُستقبل تہٕ تُہٕنٛدِ رول خٲطرٕ سُہ سارنے وُچھُن۔
خاص طور، ژٕ تۄہہِ چھِ پَتہٕ کٔس آو عہدٕ پٮ۪ٹھ—اَکھ بوٚڑ غُنٛڈٕ۔
مےٚ بُٚنہِ گٔے پنٛنِس دوستِ سۭتۍ چھُٹّی پٮ۪ٹھ۔
کیاہ تُہۍ یونیورسٹی گژھِو؟
مےٚ کٔر پنٛنِس ماجِ کینہہ دوا کھٲد۔
سُہ چھُ سَچِس منز اَکھ زبردست بَنٛدٕ۔
اَز مےٚ ہٕنٛدۍ بلیٖن کٔر مےٚ ہٕنٛدِ کارپٮ۪ٹ پٮ۪ٹھ قےٕ۔
مےٚ چھُس اُمید کران زِ تُہٕنٛدِ کارِ کُنہہ نقصان گژھِو نہٕ۔
