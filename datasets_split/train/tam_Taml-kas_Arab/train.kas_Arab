تُہۍ سُہ کیازِ نہٕ کٔرِتھ ہٲو؟
کَل مےٚ ڈاکس منٛز اکھ چیک مِل۔
گژھِ تِمَن گِرِتھ یِو، میٛٲنۍ دوست۔
اَز بارس منٛز اَسہِ واریاہ مستی کٔر، تَتھ پتہٕ میٛٲنۍ دوستَن میٛٲنۍ جوتی واپس دِتھ۔
مےٚ چھُس جانان زِ سُہ مےٚ خٲطرٕ تَمہِ وٕنِتھ کٔرِتھ، تَمہِ خٲطرٕ حٲضر رَہنہٕ مےٚ چھُس خوش۔
سُہ چھِ اسپتالس منٛز تہٕ مےٚ چھِ امید زِ سُہ کینسرس نِہ گٔژھِ۔
اگر تُہۍ یہِ ٹھیٖک نہٕ کٔرِو، تَمہِ خٲطرٕ پیسہٕ کمایِو یُس یہِ ٹھیٖک کٔرِتھ ہٲو۔
مےٚ آو وٕریٛاہ خراب احساس، بہٕ کٔرۍ میٛٲنۍ جوتی دور۔
بس پیٹیوس پٮ۪ٹھ کٔڈِتھ آرام کٔر۔
تَتھ سۭتۍ سۭتۍ، مےٚ سۭتۍ اکھ ژٕٹہٕ کران وال بچہٕ تہِ اوس۔
اَز باتھ روم گٔے پتہٕ مےٚ آو پتا زِ مےٚ کوٚر واریاہ بیوقوفی۔
میٛٲنۍ ماجہِ چھِ ٹُرٹس تہٕ سُہ چھِ بے وجہہٕ لوٗکن پٮ۪ٹھ چیٚخان۔
ٹھیک چھُ، یا تُہۍ یہِ اُلٹ تہِ کٔرِتھ ہیکیو، مگر مےٚ گژھان زندگی چھِ یِتھ پٲٹھۍ۔
نَہ، مےٚ ہٕلٕنچۍ بھاری چیزٕ بیٚع کٔرۍ، مگر سُہٕن مےٚ سامان ہٕلٕنچۍ مدد کٔر۔
مےٚ فلایٹَس منز آس، تہٕ اکھ ژوٗر مےٚ کُرسی ہٕنٛد پُشٕتھ بار بار لَتھ ماران اوس۔
یہِ مےٚ سٕچٕچ بٔڈ خفہٕ کَران چھِ۔
اکھ سیاستدان ہٕنٛد طوٗر مےٚ پارٹیہٕ مےٚ اکھ سیاسی عہدٕ دِنس منز وعدٕ کٔر، مگر تِم پنُن وعدٕ نَہ پٲر۔
کاش مےٚ کٔرِتھ ہٕک، مگر میٚون اِزی چھِ واریاہ ژوٗر گژھان تہٕ تِمۍ ہٕنٛدۍ خٲطرٕ چھِ اکھ بیٚیہِ کُتھ قبول کرُن مُشکل۔
نَہ، مگر مےٚ گژھ مٕنٛز تَمہِ عادت، آہا ہا۔
مےٚ تہِ چھِ مےٚ ہٕنٛدۍ ہمسایہٕ نَہ پسند۔
ہَڈٕن ہُند نزدیٖک تِم اَسِہ تہِ گُلابی۔
تٔمۍ ووٚن زٕ ہاں، مےٚ چھُ واریاہ خوش۔
آ، یہِ بوٗزِتھ چھُ سُہلُہ زِ دُنیامَنٛز چھِ اَز تہِ نیک اِنسان۔
مےٚ گژھان چھِ زِ یہِ چھُ سُہ وجہ یتھ پؠٹھ مےٚ الزام دِتھ ہٕک۔
مےٚ اوس مےٚ ہٕنٛدۍ اکھ تخلیق آن لائن جاری کَران۔
تَمہِ منز چھِ واریاہ سٲری غذائیت۔
واہ، تِمۍ خٲطرٕ چھُ یہِ سُہلُہ، یہِ چھُ پَکّٕ اکھ کامیٲبی۔
اَے یار، مےٚ چھُ یقین زِ تُہۍ ہٕفتن تام نَہ وٕتھ۔
مےٚ نَہ ہٕک پَران یہِ لباس یُس مےٚ چھُ وٕنٛدِتھ وٕنٛدِتھ وٕنٛدِتھ وٕنٛدِتھ۔
سُہِ چھُ بس چَڑان تہٕ کُدان پسند کَران۔
مجموعی طوٗر پؠٹھ یہِ گژھِ مےٚ ہٕنٛد چھَھٕ ٹاٹو۔
تُہۍ نَہ سٲنۍ چھِ زِ تِم یہِ تُہۍ سٟتۍ ونٛٹِتھ؟
شروعس منز مشکل چھُ، مگر پتہٕ بہتر گژھان۔
اَز مےٚ کٔر پنٕنۍ فاینل میتھ امتحان شاندار۔
تُہۍ کُن سٲری نیک تمنہٕ، تہٕ بہٕ تُہۍ خٲطر دعا کران۔
مےٚ یُس وٕچھان چھُس، تِہِ گَرٕج چھِ۔
نَہ، مےٚ رٲبطہٕ توڑ کٔر، کیازِ تِہِ لڑٲےِ ہُنٛد مزٕ دِوان چھُ نَہ سٲتھ۔
مےٚ تہٕ بابا گژھان اوس پٲٹھۍ ہُنٛد گَژھِتھ، بَس کینہہ یاد کَران اوس۔
تِہِ لگ بگ ۳۰ اِنٛچ اوس تہٕ نٔو ۶۰ اِنٛچ چھُ۔
خدایہٕ شُکر، بہٕ تِمَن منز چھُس نَہ۔
جیری ساینفیلڈس نَہ اوس یژھان یہِ کٔرِتھ۔
بہٕ تہِ کران چھُس، تُہۍ کُن کِتھ پٲٹھۍ وقت لَگان چھُ یہِ کٔرِتھ؟
آ، یہِ چھُ طریقہٕ یہِ کٔرِتھ۔
سچٕ، تُہۍ سَمجھان اوسُو نہٕ زِ سُہ مےٚ احساسن ہُنٛد خیال تھاوِ، ہے نہٕ؟
تُہۍ کُن پَزِ چھِ واریاہ کَراہت لٲگمٕژ۔
تُہۍ نٔو منی مینیجر کِیاہ کٔرِتھ؟
یا خدایہٕ، مےٚ خوابن ہُنٛد سفر!
کیا جلدی ناک آؤٹ گٔے؟
اگر کانٛہہ کُرۍ مےٚ شوہر سٕتۍ تِہِ پٲٹھۍ گژھِتھ اوس، بہٕ اوسُس واریاہ غصہٕ۔
کیا تُہۍ کُن کَدٕچ کُنہہ پالتو جانور کھوون پَژِ؟
پَتہٕ ہفتہٕ بہٕ کامہٕ خٲطر نیو یارک گژھان چھُس۔
یہِ چھُ جلدٕ یوان۔
کیا چھُو تُہٕنٛدِس وٲلِس وٕنۍ زِیادٕ دوست؟
ییلہِ کٔنہٕ تہِ چھِ ٹھیک
یہ چھُ اَکھ تَناوٕ بَھرِتھ دۄہُک زبردست اِختتام۔
مےٚ چھُ یقین زِ اَکھ دۄہ گژھِ مےٚ تہٕ میون بچہٕ اَکھ گَر منز رَہنِک۔
‘سُپر سٕماش برٛادَرس’—اَس نِنٹینڈو ہٕنٛز یہ گیم کھیلان۔
مےٚ پنُن پٮ۪ٹھِم رِشتہٕ منز کَتھٕ نہٕ کٔر پارٹنر سۭتۍ دوٚکھ؛ مےٚ آس صرف تِمٕنِس خاطر وقف۔
اچھا، یہ چھِ اَکھ گۄڈ سَلٲح۔
کیا یہ چھِ گۄڈ گژھان یا خراب؟
اَکھ بٔنٛدٕ مےٚ ڈرٛایِوے منز نِم کار کٔرِتھ، یَتھ کَنٛہٕ مےٚ بۄزِتھ نِکلس، سُہ لگ بَگ ۵۰ دۄہ ہارن دِوان۔
میون بچہٕ کَتھٕ کَتھٕ چھِ کھیلنِ خاطر تِمِس گَر گژھان۔
مےٚ تہِ تَمیٚچ سۭتۍ سوچمتھ۔
میون کُتُرٕن کھایِو سٹیک یوس مےٚ پنٕنِس ڈیٹِس خاطر پکاومٕتھ۔
سُہ تجربہٕ کِتھ پٲٹھۍ گوٚو؟
چار ؤرۍ ضایع کرنٕچ یہ چھِ اَکھ زبردست پاگل وجہ دِژھان۔
تِمِس دۄہ تُہۍ تہٕ تُہٕنٛدِ دوستن کِیا کٔر؟
آ، ڈاکٹر بدلٲوُن چھُ واقِعًن مُشکِل۔
یہ چھُ اَکھ غٲرمعمُولی معاملہٕ۔
یہ چھُ افسوسناک، مگر مےٚ تہِ تَمیٚچ خیال چھُ۔
اَس ہٕلٕے پنٕنِس ۲۲ وِس سالگرٕ منٲومٕت۔
تُہۍ پنٕنِس باسس کَتھ دۄہ ڈیزائن ہٕے دِکھٲلِو؟
سُہ کُتُہ کیاہ کران وان، یا شو کِس بارے ہُو؟
مےٚ ہیک بھِکاری دۄد، مگر مےٚ تٔمِس مدد نَ کٔر۔
تُہٕنٛدِ دۄستن کِس نَہ سُہِتھ آوُن؟
یِہ ژٕ کٲفِی حَقیٖقی آسہٕ، تہٕ کردار گژھِ تِمِتھ پوشِتھ۔
سُہ یَتھ وِز چھُس چاہان کارس پیٹھ گژھان تہٕ یَتھ وِز چھُس چاہان أسۍ ہٕنٛز کٕنِس ساتہٕ وقت گژھان۔
مےٚ چھُس پنٛنِس پٲدٕسِیَن ہٕنٛدۍ شُکرگُزار۔
سُہ یِمۍ ژٕنٛگ پٲٹھۍ وُچھ، تَتھ کٔر مےٚ کٲفِی غُصہٕ۔
مےٚ کٔر ہَفتہِس منز اکھ زبردست پِزّا۔
مےٚ چھُس سچٕچ نَہ چاہان زٕ گژھٕ کونسَرٹَس منز سُہِتھ۔
کاشِہ مےٚ ہٕنٛز عَلاقس منز پوسٹمېٹس آسِہ۔
مےٚ ہٕنٛدِس دِلَس منز تھوڑا حَسد گژھِ، تِم چھِ سُہنٛدِ گاڑِ۔
مےٚ چھُس یِہِ کٲفِی خاص لٲگان۔
یِمۍ وار تِم کِتھ پٲٹھۍ دیر کٔر؟
مےٚ چھِ یاد تِم دۄہ یَتھ گٮ۪لن گٮ۪سُک قٕیمت اکھ ڈالر آسِہ۔
حَقیٖقتس منز ڈرایِوِنٛگ خٲطرٕ چھِ واریاہ لوٗکھن ہٕنٛدِ قابٕلِیَتھ سۭتۍ زیادٕ فوکَس ضروٗری۔
تُہٕنٛدِ سۭتۍ سُہ گژھِ پسند تحفہٕ کُس آسہٕ؟
تٔمِس خٲطرٕ اگٕل قدم کیاہ چھُ؟
بچپَن ہٕنٛدِیَن یادن سۭتۍ گژھِ کانٛہہ تہٕ شریٖن نَہ۔
یِہِ گژھِ اکھ زبردست تجربہٕ آسُن۔
یِہِ چھُ اکھ پوزِشَن یَتھ منز CPS ہٕنٛدۍ بچہٕن سۭتۍ کار کرُن پَڑان۔
تُہہِ کیا خیال چھُ، یہِ گژھِتھ سُہ خبر یا بُرٕ خبر؟
اُمید چھُ یہِ آخری گژھِتھ یِم تُہہِ رَن اوور کَرِو۔
