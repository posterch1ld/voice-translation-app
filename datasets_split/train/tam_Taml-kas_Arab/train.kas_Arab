بہٕ تہٕ تَمہِ آسٕس؛ یِتھِ أسۍ چھِ تِم خراب طریقہٕ لیٚکھان۔
مےٚ چھُس محسوس کران زِ نٲکَس کھوتہٕ مےٚ ہنٛز اناہِ پیٚٹھ زیٛادٕ چوٹ لگۍ، مگر ہاں، دوزخ سۭتۍ درد اوس۔
مےٚ چھُس خوش زِ تُہۍ چھِو محفوظ۔
تُہۍ چھِو سبنہٕ کھوتہٕ بہتریٖن، یہِ کانٛہہ غیر متوقع نَہ۔
تِم وقتن منز بہٕ چھُس بٔڈ تَناؤ منز۔
بہٕ چھُس تیار زِ ژٕٹِتھ بیٚیہِ اکھ گاڑِ ژٕٹٕن؛ مےٚ گاڑِ چھِ آخری حالتس منز۔
تِہِ کینہہ دۄہ دِیِو تہٕ دوبارٕ کوشش کٔرِو۔
مےٚ کٔر اکھ کلاس خٲطرٕ ۲۰ صفحن ہٕنٛدۍ پیپر تحریر۔
تُہۍ ضروٗر بٔہ غُصہٕ آمتھ ہاو۔
یہ ٹیم کُن کھیلٕچ چھِ؟
مےٚ افسوس، کیا چھِ تِم بٔہ بدتمیز یا زیادتی کَن وال؟
یِہ سۭتۍ بٔہتر چھُ زِ تۄہہِ یُس حق چھُ سُہ مِلہِ۔
بہٕ تِمِس سۭتۍ ورزش کَران۔
تۄہہِ ہٕنٛز سالگرٕچ سۭتۍ وابستہٕ سۄ پسندیدہٕ یاد کُنہِ چھِ؟
بہٕ یِوان سفرِ بابت تھوڑا نروس چھُس۔
تِتھ سُہ بٔہتر محسوس کٔرنس منز وقت لَگان۔
بہٕ واریاہ کتابہٕ چھُس پَران تہٕ کوٗشش کَران زِ کُنہِ دۄہ دۄہ کَڈنس خٲطرٕ باقی فلپینو لوٗکھ لَبہِ، یِہ چھِ واریاہ مُشکل۔
مےٚ نہٕ کۄر پتا کیاز، مگر بہٕ چھُس بٔہ خوش زِ آخرکار سُہ قرضہٕ مےٚ ہٕنٛز گردنہٕ پیٹھ گٔیہِ۔
وٲریا بچہٕ چھِ تِمِس سٕنٛز۔
ہا ہا، سُہ چھُ مزہٕ دار لَگان۔
اَکھ دۄہ بہٕ ژِندگی منز سٲری کینہہ مِلان یُس بہٕ ژٕچھان۔
بہٕ تِمن لۄکھن ہٕنٛز عزت کَران یِم سیویج منز بانٛہہ گژھان۔
مےٚ چھِ یقین زِ تِم سچِی بٔہ کیوٹ ٲسۍ۔
میکینکَن ہٕنٛز آسانی سۭتۍ مسئلہٕ ژورُن گژھِتھ۔
یِہ چھِ سُہ گژھُن زِ تۄہہِ کَنہہِ لۄکھ ٲسۍ یِمن پؠٹھ تۄہہِ بھروسہٕ کٔرِتھ۔
ہای، سُہ چھِ بٔہ خراب۔
سٹیفن کنگ سٕنٛز نٔو شوک چھِ اَز راتھ نٔو قسط۔
مےٚ چھِ یقین زِ تۄہہِ یِوان نوکری منز بٔہتر گژھِتھ۔
تَمہِ کٲم قٕسمُک پالتو جاندار چھِ؟
مےٚ ؤسطِک شہرَس منز طوفان گژھن وٲلۍ تھٕم، بہٕ سچءَ تیار ٲسُس۔
مےٚ توجٕہ حٲصِل کٔرنس خٲطرٕ سُہ چھُ تِم کُرسی خَروچان شُروع کٔرمُت یَتھ پٮ۪ٹھ بہٕ بٲٹھان۔
یہِ ہفتہِک آخرس بہٕ پہلی دفعہ لابسٹر کھٲوان۔
مےٚ بالکل نَہ ہٕیہِ انتظار کٔرتھ یِتھ پٲٹھۍ مےٚ بچہٕ ژھۄٹِ سکول واپس گژھن۔
نوٚے کپڑے کٔنِتھ پتہٕ چھُس بہٕ لاکھ روپے سٲنۍ محسوس کران۔
حالِس چھُس بہٕ پنٛنِس پریوارَس سٲتۍ کافی خوش۔
تِمۍ کُنہہ نَہ کِیاہ ونان؟
اتھ کلبَس منز شامل گژھنچ کوٗشش تہِ کٔر، ژٕ چھِ شاید وُچھُن پَتہٕ وُچھِ اپارٹمنٹَس منز کُنِہِ سٲتۍ رَہِتھ، نَہ کہ تنگ ڈارمس منز۔
شاید ژٕ ہَیہِ تِمس سٲنۍ کانٛہہ شو وُچھِتھ ژٕ وُچھِتھ۔
دۄہ راتھ ٲس طوفان گژھان تہٕ بجلی گٔیہِ۔
سُہ چھُ بس ژٕوٚٹ سُست۔
آ، مگر چھُس بہٕ نوٚن شیڈ ژٕنڈنس پیوان۔
یہِ چھُ سُہ پروگرام مزٕدار لٲگن وول۔
مےٚ ؤنٛدۍ بوبکیٹس چھِ یونیکارن سٲنۍ افسانوی جاندار۔
کُنہہ قیمتی چیٖز آسُن چھُ سُہنٛدَر۔
کیا یہِ تُہٕنٛدِ پہلۍ دفعہ ٲس جُوا کھیلُن؟
کیا ژٕ کَتھ کٔر یِم سٲنۍ ژٕ وٚنٛدِتھ مزٕدار، مگر پتہٕ کُنہِ سُہ زَخمی گٔیو؟
اتھ چھُ اَز اِلیکشن ڈے، شاید یہِ چھُ تَمس سَبَب۔
مےٚ دوستَن مےٚ نَہ وٚنٛدِتھ مےٚ خٲطرٕ پارٹی رَکھِ ٲس۔
مےٚ گژھ کَل اکیٛاہ بٕلوٗنٛگ۔
تِتھ کِیا گژھ، کانٛہہ پَتہ نَہ۔
تِم سٔرکَس پرفارمَنس چھِ اَکھ نَوِس سطَحس پٮ۪ٹھ نِتھ۔
مےٚ چھُ نہٕ وٕنکیٚن تِہِ سَنتوش حاصِل گژھمُت۔
مےٚ چھُ وٕنکیٚن تھوڑا تھوڑا اَپنِس روم میٹُس یاد کَران۔
نَوِس سالس پٮ۪ٹھ چھُس عام طور پٲٹھۍ گژھمُتس بارَس منٛز سٲری وٲرِیاہ سوچان تہٕ مُستقبٕل کُن نظر دِوان۔
اوہ، یہِ چھُ سُہ—تُہۍ کَرِو پارٹی اگر تُہۍ چاہو، ہاہا۔
مےٚ کینہہ ہفتن ہٕنٛز پٮ۪ٹھ کُنہہ زَنٛگۍ سٕتۍ کٔر ملاقات، تہٕ تَمہِ پٮ۪ٹھ چھِو تقریباً ہر روز ٹیکسٹ کَران۔
سچِ؟ یہِ چھُ دِلچَسپ، مگر تِم یہِ تہِ کِتھ پٮ۪ٹھ چاہَن؟
مےٚ چھِ اَتھ پٮ۪ٹھ فِکر کِہ یِہ یُنٛو جاب اِنٹروٗیو کِتھ پٮ۪ٹھ گژھِ۔
مےٚ چھُ سَدا افسوس گژھان یِم مےٚ کٕرِمُت دوست چھُ کٲم تٕرِتھ نَو جاب لَگاون۔
مےٚ چھُس وٕنکیٚن کھیٚلِتھ خٲطرٕ بُزرُگ تہٕ موٹ۔
تِمَن ہٮ۪کَن سٲری وٲرِیاہ یِہ وقت اِنٛجوٚے کٔر۔
مےٚنٛز اٮ۪کس چھُ سَبسٕے خراب۔
تَمہِ خٲطرٕ شایَد مےٚ چھُس نہٕ سَبسٕے بٔڈ جَج۔
اُمید چھُ یِہ نَزدیٖک مُستقبٕل منٛز بدلِتھ۔
یِہ سٕتۍ دِل ہَٹاونٕے خٲطرٕ کُنہہ شوق ژٕڑِو۔
تُہۍ کَتھ قِسمُک کیک بَنایو؟
مےٚ چھُس اَپنِس نَنِس بَھانٛزَس سٕتۍ بٔڈ خوش۔
مےٚ چھُس زٕبردست غُصہ—سیمی ٹرک وٲلِس نہٕ دِتھ اچانک مےٚن لینس منز گژھتھ، تہٕ مےٚ تقریباً جان گژھان۔
مےٚ کوٗشش کٔر زِ مےٚن دٕر گژھمٕتھ ماجہِ سۭتۍ رابطہٕ کَران، مگر تِمَن کٔر مےٚ بےعزت تہٕ کٔر انکار مےٚ سۭتۍ گَپھ کرنس۔
ٹھیٖک، کُنہِ جاینُک پلان چھُ؟
شُکریہ، پیدٕٮشِ ہُند اِنتظار کرنُک جوش چھُ زٕبردست۔
یہِ گژھِ ہٮ۪وان ہٮ۪وان ٹھیٖک۔
یہِ چھُ کمال زِ تُہۍ چھِ تُہُنٛد کٲم پسند، یہِ چھُ واقعی اہم۔
مےٚ ہٮ۪کِس نہٕ یہِ کَرتھ۔
مےٚ ووٚن مےٚن برٛٲدرس دِکھاون زِ مےٚ چھُس تَمہِ ہِنٛد فِکر۔
ٹھیک چھُ، پَگاہ ذرا سَمجھِتھ رۄزِو تہٕ واریاہ نہٕ کھٲیِو۔
مےٚ چھُس مےٚن محلے ہٕنٛد سٲری ننۍ پَکھی ہٕنٛد زٕبردست فِکر۔
تِمَن کٔر مےٚ کینہہ تہِ نہٕ ووٚن۔
مےٚ چھُس ساحلَس گژھُن زٕبردست پسند۔
ہَفتہٕ وارِس منز باہر گژھنس بجای مےٚ کٔر فیصلہٕ زِ گَرِ رۄزِتھ پنٛنِس باغس منز کٲم کَران۔
شاید تِم تھوڑا وقت تَتھ کٲم کٔرِتھ تُہۍ خٲطرٕ کانٛہہ نیک سفارش کٔرِتھ ہٮ۪کَن۔
آ، تِم چھِ اَز تہِ باہر۔
مےٚ چھُس تہِ تَمہِ خٲطرٕ خوش۔
مےٚ امید چھِ زِ تُہۍ پنٛنِس دوستس سۭتۍ حسد نہٕ کٔرِو۔
اگر یہِ چھُ تُہُنٛد قیمتی تحفہٕ، تہٕ تُہُنٛد دوستس چھُ نہٕ گژھُن یہِ گژھان۔
کیا تُہۍ کٔرِو مینیجرس سۭتۍ گَپھ؟
یہِ چھُ اکھ گژھِتھ کٲم یُس مےٚ چھُس کَران زانان۔
مےٚ سُہ تہِ شرمندٕ تہٕ مایوس اوس
واہ، یہِ چھُ اکھ سونٛہہ سرپرائز
کیا تُہۍ کم از کم ہارن تہِ وازاون؟
اوہ، تُہۍ چھِو سُہ کمال، کِتھ پٲٹھۍ
مےٚ مٲجِس بٲیِس ہُند تازٕ چھاتی کینسر ٹیسٹ آو پازیٹو
ہا، بہٕ تہِ سُہِے کام کران چھُس
تُہۍ ونسہِ کوٗشش کٔرِو، ربس منز تُہۍ اکھ دوست مِلہِ
مےٚ سُہ یاد نَہ چھُ زِ کَتہِ اوس آخری وار ذلیل، مےٚ چھِ کافی موٚٹ جلد
مےٚ دِتھ پٲٹھۍ انٹرویو دِن پَیہِ ترٛقی ہُند، تہٕ مےٚ چھُ علم زِ مےٚ سُہ کمال کٔر
مےٚ بٲبہِس تازٕ کینسر ہُند پتا چَلِتھ
کُنہِ اساینمنٹ یا پروجیکٹ جمع کرنس نہٕ پٲٹھۍ یِوان سکون ہُند کوٗنہِ مثال چھِ نَہ
تُہۍ پنٛنِس کامس ضرور پیار کران آسِو
مےٚ افسوس چھُ، تِمۍ سُہ کِتھ پٲٹھۍ لَتھ
مےٚ کُنہِ وار کوشش نَہ کٔر تہٕ نہٕ کُنہِ وار کٔرِہ
تُہۍ کرس گِلیبو ہُند ‘سایڈ ہَسل’ ضرور وُچھِو
مےٚ مٲجِس اکھ مُشکل آپریشن گژھ تہٕ سُہ وُچھ تہِ سُہ سٲری پٲٹھۍ ٹھیک گٔے
مےٚ چھِ پسند زِ تِمِس ہمیشہ مےٚ ضرورت گژھِہ
بہٕ ہمیشہ پنٛنِہِ پرٛونِہِ فیس بُک تصویراں وُچھان چھُس
سُہ چھِ واریاہ نَروٗس کَران
مےٚ نہٕ وٕنٛدٕ کہ اگر مےٚ سُہ گوم کٔر، مےٚ کیاہ کَران؟
مےٚ اَز تہِ سٲری چیز سمجھنس منز چھُس۔
مےٚ اوس راتھ دیر گژھتھ پنٛنٕچ کار نِش وٕنٛدٕن۔
مےٚ ؤنٛدۍ بہنہٕ تہِ کَتھ کَتھ چھِ دِل خراب کَران۔
شُکریہ، شاید مےٚ گوٚوٕل پزِ پنٛنٕس سٲتھ محبت کرُن۔
مےٚ سُہ رٕوز چھُ ڈاکٹر سٲتھ اپاینٹمنٹ، یِمن چھُس مےٚ کِنٛہہ فِکرمٕت۔
تَتھ گژھنس چھُ سٲری کھوٗب وقت۔
مگر أسۍ ہٕنٛز باس یِمَن تامۍ کٔرۍ ڈانٹان سُتھ، یِہ اوس مُشکل۔
یہِ افسوس چھُ کہ حال کبھی تہِ ماضی سٲتھ مقابلہ کرنس لایق نہٕ دِساں۔
تُہۍ یقین نہٕ کَرو کی ژٔتھ وار یِہ گٔیہ مےٚ سٲتھ۔
یِہ چھُ اکھ واجِب نُکتہٕ۔
یِہ چھُ زبردست کہ سُہ تُہۍ فخر دِوان۔
مےٚ یَتھ گژھِتھ رَوان گٔژھ، تِتھ پَٹھ کُنہِ مےٚ گَر منز گٔژھ، تہٕ تِمن پَٹھ مےٚ یِہِس پٲٹھۍ محسوس کٔر۔
تَتھ چھِ کیٛاہ واریاہ پارکِنگ مُیَسّر؟
خوشی ژٔ مےٚ سُنتھ کہ سُہ چھِ پنٛنہِ کٲمۍ منز ترقی کَران۔
گژھِتھ ہفتہٕ منز اوس مےٚ گَرچ ٹویلیٹ بند گٔمت۔
ہیلو، تُہۍ چھِ کَتھ کَتھ روبوٹ استعمال کٔرمت؟
کیا تُہۍ کٔر سُہ ہارن؟
مےٚ چھُس نَہ کَتھ تہِ نٔو کافی ذائقہٕ آزماوان۔
مےٚ دِتھ پنٛنِس ۱۶ وریٛہِس برٛونٛہہ پنٛنِچ کار، تاکہ سُہ پنٛنِس ڈیٹ سٲتھ باہر گژھِتھ۔
مےٚ اکھ مانٛہس منٛز کلاس ختم کٔرِتھ بیٚیَن ہٕنٛد مدد بغیر گاڑِ ژٕلٕنۍ۔
مےٚ اَتھوارس اکھ شو دِژنس گژھان۔
تُہٕنٛد گاڑِس کٕیا خراب چھُ؟
شُکریہ، کینہہ دۄہن منٛز اَز تہِ مےٚ بٔڈ درد گژھان۔
مےٚ سچِ منٛز سۄچمُتھ زِ سُہ پانٛژھ مِنٛٹ ٹھیک ٲسِ۔
حالَے منٛز کینہہ وزن کم گژھتھ مےٚ کینہہ نوۍ کپڑے آرڈر کٔرۍ۔
مےٚ جانمُتھ زِ سُہ مدد کٔرِتھ ژٕچھان ٲسِ۔
یہِ چھُ سُہنٛد زِ تُہۍ بیٚیَن نہٕ دِوان تُہنٛد حوصلہٕ کم کٔرِتھ۔
مےٚ یہِ سودا یِمِتھ زِ مےٚ پورٕ یقین چھُ زِ مےٚ چھُ اَکھ ژور تیٚران۔
اَس یِمنٛز تہِ ژور حالاتن منٛز گژھِتھ چھِ۔
یَلہِ مےٚ وُچھ زِ میون ژھونٛڈ چھُ میٚنٛۍ بَچٕچ پالنس منٛز کُدِتھ گژھِتھ، مےٚ یقین نَہ گژھ۔
مےٚ سۄچان چھُس زِ اگر مےٚ تُہنٛد باس فون کٔرِتھ سُہس وُچھاوم زِ تُہۍ تنخواہ بڑھاوِ، تَہ کِیا یہِ مدد گژھِ؟
مےٚ جانان چھُس زِ سُہ کینہہ بٔڈ کَم کَری۔
مےٚ ہٕنٛزِ برٛونٛہہ وُچھِتھ گژھِتھ میٚنٛۍ بٲیَن مےٚ اکھ سُہنا تحفہٕ دِتھ حیران کٔر۔
اُمید چھُ زِ تُہۍ اداس نہٕ گژھِو۔
کِیا تُہۍ چھِو لَمبِی خشک دورس پیٚٹھ بۄنٛتھ نیران؟
شاید تُہۍ چھِو وُنہہ اکھ دوست مِلان۔
اَز چھُ میون دۄہ بٔڈ سُہ گژھان۔
اچھا، سُہ گژھِ بٔڈ سُہ۔
مےٚ شرط لَگان چھُس، سُہن کٔرِوُن گژھِ گژھِ گژھ۔
مےٚ فاینانس پَرنٕچ وَنٛدٕس۔
فیس بُک پٮ۪ٹھ ژھٕنٛڈٕرۍ دِتھ مےٚ تھوڑا جذباتی گژھان۔
خوش قسمتی سٕتۍ، کانٛہہ بُزرگ اَسۍ تٕہٕ پٲٹھۍ تُلِتھ مےٚ واپس دِتھ، مےٚ ژٕ کَتھ نَہ گٔمٕتھ۔
مےٚ تہِ تَمہِ پٮ۪ٹھ کَرُن گژھِ۔
گژھِ رات ژٕ کھڑکی پٮ۪ٹھ ٹَک ٹَک کٔرنس آواز سۭتۍ مےٚ نیندر وٲل۔
مگر مےٚ چھُس یقین، الگ الگ روزُن تُہۍ دۄنُن خٲطرٕ مشکل گژھِ۔
مگر سُہ چھُ کَتھ مِٹھ! لَگٕنۍ چھُ سُہ کُنٛہِ خٲص۔
کیا تُہۍ چھِو کُنہِ فیملی وِزِٹُک پلان، تاکہ تُہۍ آسٕہ کُنہِ چیزُک انتظار کٔرِتھ تہِ یہِ وقت پار کٔرِتھ مدد مِلہِ؟
تِمَن ہِنٛدِس بارے منٛز سوچِتھ تُہۍ کِتھ پٲٹھۍ محسوس کَرو؟
یِمن پٮ۪ٹھ سوچان مےٚ چھُس بٔڈ دُکھی۔
یِہِ کامیاب کٔرُنٕچ چھِ ضرورت۔
آ، تہٕ سُہ ڈزنی لینٛڈس منٛز اوس۔
اوہ، سُہ چھُ بٔڈ اونٛچ ہدف۔
کیا سُہ کَتھ تہِ بھوت اوس؟
مےٚ چھُس یقین تُہۍ تِمِچ حقدار ٲسِو، کیازِ تُہۍ پروجیکٹس منٛز بٔڈ محنت کٔرتھ۔
آ، مےٚ اوسُس سٲری مایوس؛ تَمہِ سۭتۍ اوس پَگٲر تہِ بٔڑان۔
تَمہِ پَتہٕ مےٚ بٔٹھِتھ اکھ کتاب پٔرِتھ مزٕ لُٹ۔
مےٚ نَہ ہٲصِل کٔرِتھ ٹِکَٹ، مےٚ پزِ اوسُن مَنٛزِ پسند بینٛڈ دِتھ۔
تہٕ یِہِ بَنٛدٕ چھُ سُہِ وقت اَکھ گۄڈ گَژھُنٕچ گۄڈ، یَتھ تُہۍ مہمان آوِو۔
مےٚ چھُس امید کِ سُہِ ہٕنٛز کانٛہہ دانٛت نَہ وٲل۔
یہ چھُ اکھ ؤڈ معاملہ۔
مےٚ چھُس پنٛنہِ گرل فرینڈس متعلق شُکرگُزار؛ سُہ چھِ واریاہ مددگار تہٕ مِٹھی۔
فینی پیک چھِ جیت خٲطرٕ۔
مےٚ چھُس ہاکی ہٕنٛد واپس آمت، مےٚ دوست چھُ ٹیمس منٛز ژٕلْمُت۔
کیا چھُ تُہۍ سٲری کینٛہہ پلان کرِتھ تھاوُت؟
تِم چھِ وُنٛہہ تہٕ نہٕ وٹان۔
مےٚ گوٚوِس گُژِرِتھ سُہ وانس منٛز بیک پیکنگ کرن۔
مےٚ چھُس خیال کران زِ مےٚ چھُ یاد یِوان سُہ وُچھمُت۔
مےٚ تہِ نَہٕ مٲن زِ سُہ اوس اَتھ پٲٹھۍ ؤڈ مۆز۔
مےٚ لَگ بَگ سڑکُک کَنٛڈِر گاڑِ تھٲوِتھ پٲوان صرف سکون پٲٹھۍ یِون۔
تِمیچ کارَن چھُس مےٚ پسند کران کینٛہہ ریسپی یِم مےٚ بچپنس منٛز ما کٔر۔
مےٚ اوس واریاہ غُصہ یِوان یَلہِ مےٚ بِلّی گٔے باہر۔
مےٚ چھُس حالیہ منٛز اکھ واریاہ لۄکُٹ شہر منٛز شفٹ گژھمت۔
اکھ پارٹی منٛز اکھ کٲنٛہہ کُنٛہہ کٔر مےٚ کس کرنٕچ کوٗشش، مگر مےٚ اوس پیٚٹھٕے اکھ رِشتس منٛز۔
مےٚ پنُن زَنم دۄہ پٲٹھۍ اکھ پَپی مِلِتھ۔
تَتھ وٲری مےٚ پنٛنِس پسندیدہ گرل فرینڈس ملاقات کٔر۔
مےٚ چھُس تَتھ مُتعلق واریاہ اداس۔
یہ چھُ تُہٕنٛد نیک کَرم زِ تُہۍ چھِ پنُن آپ تِمَن ہٕنٛد جاین منٛز تھاوان۔
مےٚ پٲوان اَز اکھ ایتھِکس کورس کرُن پنُن رِیل اسٹیٹ لایسنس برقرار تھاونٕچ خٲطرٕ، تہٕ مےٚ ٹیسٹ پاس کٔر۔
ہاں، دوستن سۭتھ وقت گُزارُن چھُ ہمیشہ مۆز۔
یِمن خاطٕر نیک تمنائیں، یِژِر تُہِ کَتھٕ کامیابی حٲصِل گژھِو تہٕ مےٚ کَنۍ تہِ کینٛہہ ملین پَٹھٕ ہاہا
تھوٚڈٕ غٲر متوقع اوس، مگر سُہ چھُ سُہتر—یِتھ ماہِس مےٚ کُلیت خرچٕچ بل آسہِ ہٕنٛدۍ کم آو
یِلہِ مےٚ پنٛنِ کار آئل بدلاونہٕ نِیِ، مےٚ سۄ واریاہ چِڑ آو
تُہۍ خوش اوسٕو، سُہ مےٚ چھُ خوش کَران—یِہ چھُ واریاہ سُہتر احساس
ہای، مےٚ پیٛاری بیٚی یِوان ہفتہٕ شہرٕ پتہٕ گژھان
مےٚ چھُ شدید سماجی فوبیا، بےچینی تہٕ ڈِپرٛیشن
مےٚ چھُ یِوان ہفتہٕ ہٕنٛز بےصبری سان وات پٲران، مےٚ آسہِ کٲمٕچ رخصت
جانورن چھِ تُہۍ سٲری لوٗکن ہٕنٛز ضروٗرت
مےٚ چھُ سُہ احساس معلوم؛ مےٚ برٛونٛہہ اوسِ کُنہہ وارۍ وری پٲٹھۍ گریجویٹ، سُہ چھُ واریاہ بَڑِ سنگِ میل
مےٚ چھُ تھوڑا ڈرٕ یِتھِ سۄ کِہِ گژھِتھ
ہاں، احتیاط کرُن، اکھ دۄہ تُہۍ پنٛنِس خۄدس واریاہ بُری طرح زخم دِتھ ہٲوِو
مےٚ سٲری روم میٹ پنٛنٕن ہٕنٛز گامَن واپس گٔے
مےٚ چھُ اصلٕس منز اکھ کران
اوہ نَہ، تُہۍ چھِو یِوانی کینٛہہ سُہتر محسوس کران
مےٚ ڈٲل اکھ نوٚ جِم
مےٚ اوس سُہ بابت واریاہ دُکھی
أمۍ گٔو مےٚ ڈونالڈٕس ہٕنٛز یِہ سِکّہٕ، مےٚ تھاوِ اکھ یاد کَرنہٕ خٲطرٕ
مےٚ وٕن بس کٲٹھۍ بٲٹھِ ناول پٲران اوس سَمٕنٛدٕچ لَہرٕن ہٕنٛز آواز آیٚکان
کُت چھُ واقعی منٛزٕ ہٕنٛز سۄ بٔڑِ دوست
تُہۍ کِہہ کھٲد پٲٹھۍ ژٕٹھیو
بہٕ تَمہِ خٲطرٕ بے صبری سۭتۍ واتنظٲر کران اوسُس
مےٚ یقین نَہٕ آو زِ میون دوست لَٹری جیتھ
مےٚ نَہٕ چھُس پَتہٕ زِ سُہ بلکل کَتھ قٕسمُک ژٕنٛگ تھا
گیم آف تھرونٛزُک آخری سیزن چھُ جلدی یوان
میون تعزیت، اُمید چھِ زِ تُہۍ وُنٛہہ ٹھیٖک چھِو
دوست چھِ مددس خٲطرٕ بہٕتر
مگر تَمِس پٮ۪ٹھ بہٕ اَز تہِ بَدۍ محسوس کران اوسُس
مےٚ چھِ ہاکی بَہٕ پسند، ژٔ چھِو سیزنس خٲطرٕ تیار
تَمہِ پَزِ کِنہہ اکھٹٕ پلان کرُن
تازٕ ؤل میون ساتہٕ کینہہ دلچسپ گژھِتھ
کاش سُہ گژھِتھ بہٕتر سمجھدار
تُہۍ پَزِ تَمِس بَہٕ یاد یوان آسِ
یِلہِ دۄہ چِیزکیک بناوم، مےٚ پَزِ سُہ ضروٗر آزماوُن، ٹِپ خٲطرٕ شکریہ
شاید تُہۍ چھِو بلی پسند کران
زیادٕ بَد محسوس نہٕ کٔر، تِمَن پَزِتھ جلدی کَرُن
دوست گژھِتھ سُہ چھِ تُہٕنٛدِ خٲطرٕ بَہٕتر
اُمید چھِ زِ تُہۍ کانہہ بیٚیہِ نوٚو شروعات کٔرِو
واہ، تُہۍ کٮ۪ا کٔرِ تَمِس سۭتۍ
مےٚ نَہٕ چھُس پَتہٕ کِیاہ لٮ۪کھُن
کِیاہ تُہۍ پَزِتھ کٲم پٮ۪ٹھ گٕژھُن
أَسٕن پنٛنِس دوستس ۳ ہزار رۄپیہ دِژ تاکہ سُہ پنٛنۍ گاڑِی ٹھیک کٔرِتھ
یِتھ پٲٹھۍ یِتھ پٮ۪ٹھ پٲٹھۍ یِتھ کٔرِتھ کٲل لگِتھ
مےٚ ڈٮ۪ڈ مےٚ بٔرتھ ڈے پارٹی منز آیہِ
مےٚ تھوڑا شرم محسوس کٔر
بےٚ چھُس تھَلۍ پنٛنِس کھانَس پَکْنٕچ انتظار کَران، مگر یِتھ پٲٹھۍ تام چھُ سُہ خوشبو دِوان
ٹِنڈَر پٮ۪ٹھ یِہ کٕنٛہہ کٲشر لڑکی تہٕ مےٚ دِوان آسِہ واقعی اَک دۄجِس پسند، مگر سُہ اچانک مےٚ سٕتۍ رابطہ بند کٔر
سُہ گَرٕچ کٲم کَران کَران سُہ پیسہ کَمٲو
مےٚ ہٕہ نِہ ہٕو کٔرِتھ تصوُر کٔرِتھ ہٕو
کیا پولیسن کٔر سُہ گرفتار یا دِتھ سُہ چالان
مےٚ چھُس یِتھ پٲٹھۍ غصہ یِوان، مےٚ مکان مالِک چھُ گَر وٕچان، یِمۍ سۭتۍ مےٚ چھُ جٲے بدلٲوُن
مےٚ لٲگ یِم مےٚ کٔر دۄستی سۭتۍ دغا
مےٚ کٔنِہ کٔر پَتھ وٲلِہ بَرٕس نَوِس سکولس منز شُروع
سُہ لَگ بَگ یِتھ جلدی اَکھ سٲری نۄکری تہٕ اَکھ گرٕل فرٛینڈ مِلی
میمفِس منز چھُ واریاہ گَرمی یِوان
مثبت سوچ چھُ ہمیشہ اَکھ سٲری خٲصیت
مےٚ آسٕہ واریاہ خوش یِتھ دِژِتھ زِ مےٚ بھٕتِجا حالٕے ژٔن
مےٚ تہِ، یِہ چھُ اَکھٕے جٲے یُس مےٚ دِوان چھُ پنٛنِہ زَنٕچ لگاتار کِچ کِچ پٮ۪ٹھ پٲٹھۍ
سُہ بدتمیزی کَران آس، یِمۍ سۭتۍ أسۍ کٔرِتھ سُہ باہر
مےٚ ہٮ۪ک ہیمبَرگَر یِتھ منز آس اَکھ بٔڑ کالہٕ بال
مےٚ چھُس بالکل راضی زِ مےٚ چھِ نہٕ گاڑِی
کیا تُہۍ بیچلر پارٹی کَرِو؟
تُہۍ زِندگی ہُنٛد بٲقٕے حِصسَس یاد تھاوٕن وٲلۍ سُہل وقت گژھِو تہٕ یادٕ بنٲوِو۔
مےٚ چھُ اِس ہفتَس اِمتِحان تہٕ مےٚ چھُ ڈر زِ مےٚ گژھِ خراب کَرُن۔
مگر یَتھٕ مےٚ سُہ سَیٹ کٔر، تِتھٕ تِم ہَواہ منز پَران بٔد کٔر۔
حالٕ مےٚ اَکھ دوست سُہ رِسرچ سٹڈی خٲطرٕ ریفر کٔر یُس مےٚ اپلای کٔرمُت اوس۔
مےٚ چھُ وۄنۍ تِمَن ہٕنٛز تھوڑِی یاد۔
کیا سا چھُ وۄنۍ بہتر محسوس کَران؟
مےٚ چھُ واریاہ اَتھ موئسچرایزر سٕنٛدِس بارَس مُشتاق یُس مےٚ گژھِ مِلن وۄنۍ۔
مےٚ چھِ کُتھ واریاہ پسند کیازِ تِم چھِ واریاہ خیال تھاوان۔
تِم چھِ واقعی مےٚ مدد کٔرِتھ کَٹھ وقت پار کٔرٕن۔
مےٚ سُہ دوست چھُ حقیقتھ منز تِمَن پٮ۪ٹھٕ ژٕیاٛدٕ طاقتور یِم تِم دِسان چھِ۔
تُہۍ ہُنٛد یہِ واقعی واریاہ نیک کام چھُ۔
سُہ ضٔروٗر واریاہ دلچسپ آسِتھ۔
واہ، یہِ چھُ تِمِس خٲطرٕ واریاہ زبردست۔
آ، مےٚ چھُ تۄہہِ ہُنٛد خٲطرٕ احساس سمجھان۔
ژٕ ہفتہ پؠٹھٕ مےٚ دۄد زِ مےٚ ہُنٛد گَر چھُ سٲری پٲنِس منز ڈوبمُت۔
مےٚ اوسُس رٲژھ زِ مےٚ ہُنٛد کُتھ اوسُس زیادتی کٔرمُت۔
سُہ اوس مےٚ ہُنٛد سَبسٕنٛز پسندیدہ شو۔
مےٚ ہُنٛد نَو سیلنگ فین چھُ دۄپہرِس یِوان، مےٚ چھُ نہٕ صبر۔
برٛو، مےٚ چھُ یقین زِ تۄہہِ کٔر سُہ سَبسٕنٛز نیک یِم تۄہہِ کٔرِتھ ہٮ۪کِو۔
یہِ وجہ چھِ ژِ دوٗہَن منز ژٕ دوٗہَن ہَنٛزَن گھرَن منز پیٚٹھ کٕڈنہٕ آیہِ۔
پَتہٕ تِمَن مےٚ سیٹَلایٹ ہٕژ کٔر۔
یِتہِ چھِ اَکھ نَوی پِزّا دُکان کُھلٕنۍ۔
بہٕ چھُس ہمیشہ آرام پسند انسان۔
تِمٕ کٔر یہِ واریاہ نَیک کٲم۔
بہٕ چھُس پنٛنِس ماجہِ سٲری راز واتناوان، تہٕ مےٚ چھِ معلوم زِ ژِ کٚنہِس نَہ واتاوِ۔
لگہٕ چھُ زِ یہِ نَہ آس سُہ لَگنٛد ٹھیک۔
مےٚ ہٕنٛدۍ والِدین چھِ ہمیشہ مےٚ ہٕنٛز ننٛہِس پُترس بٕہتر گرامر سکھاوان۔
تَمہِ بہٕ نَہ اوسُس واریاہ بالغ۔
تِمِس جِتنٕچِ وجہ سۭتۍ أسۍ اَکھ این ایف ایل گیم ہٕنٛز تماشہٕ کرنٕچ موقعہٕ میلِ۔
بہٕ چھُس پنٛنِس بایِفرٛینٛڈس سٲری فیصلٕہ کرنٕچ اجازت دِوان۔
مےٚ چھُ ارٕ اَکھ واریاہ بٔڑ گریڈ حٲصِل کرنُک پلان۔
آہ یار، یہِ چھِ واریاہ افسوس ناک! یہِ کَتھ کٔر زِ گٔیہ؟
کاش بہٕ مدد کرنٕچ خٲطرٕ کینہہ کٔرِتھ ہٲو۔
آز چھُس بہٕ ژٕٹہِ مُتضاد تہٕ بےوفا محسوس کَران۔
مےٚ ہٕنٛز شٲمِس چھُ راتہِ واریاہ شور۔
کَتھ پٲٹھۍ اوس سُہ ژھٕپ دِلنٛگ؟ تُہۍ کٔرِو معلوم؟
مےٚ ہُ٘ن پُتر چھُ اَکھ وٲرۍ، تہٕ سُہ چھُ سٲری چیزَن پٮ۪ٹھ ژٕٹان۔
یہِ چھِ اَکھ نَیک شروٗع۔
آز کلاس منز گٔیہ مےٚ پیٚٹھ اَکھ پاد نِکٕتھ۔
مےٚ اُمید چھُس زِ تُہۍ پورٕ نیندر کٔر، نَہ تہٕ تُہند دۄہ گژھِ لَمبہٕ۔
مےٚ ؤنی چھِ واریاہ بیمار، یِمہِ وقتہٕ چھُ تِہِ ژَار۔
کم اَز کم تُہۍ کٔرِو واریاہ مزٕ۔
اوہ، مےٚ چھُ سُنتھ یِمِس بارَس منز پَگاہ۔
مےٚ چھُس سَدا گژھُن یژھان، مگر أسۍ چھِ کَتہِ نہٕ پیسہٕ رخصتس منٛز گژھنہٕ خٲطرٕ۔
مےٚ ہُند پسندیدہ ٹیم برُوٕنز اوس، مگر پتہٕ مےٚ کٔرِ جاین تبدیل۔
مےٚ ہُند بچہٕ چھِ سَدا خوش۔
کیا چھِ تُہند کُنہِ مددگار دوست یِمِ سخت وقتس منز تُہۍ مدد کٔرِتھ؟
مےٚ اوسُس واریاہ خوش زِ مےٚ ہُند بچہٕ دۄٹھ۔
اوہ، سُہ چھُ واقٔی کمال۔
تُہۍ کِس قٕسمُک گاڑِس منز چھِ امتحان دِوان؟
لَگدِ چھُ زِ تُہۍ کٔرِو واریاہ عقلمندانہٕ احتیاط۔
کَنہِ کَنہِ چھُ یِمِس پٲٹھۍ منحصر زِ تِم کُس چھِ۔
ہاں، ٹھیک چھُ، مےٚ چھُس سَمتھان زِ اَگر مےٚ کَتہِ جیتُن یژھِ تہٕ مےٚ پزِ ٹکٹ کِنُن۔
مگر تُہۍ کِیا کٔرِتھ ہیکو؟ اَگر تُہۍ باقاعدٕ چھِو، تہٕ دوٚیم پٲٹھۍ تِم خٲطرٕ کینہہ زیادٕ نِیو، سُہ گژھِ سمجھان۔
اوہ واہ، تُہۍ پزِ اتھ پٲٹھۍ سُہتر جانان۔
یِتھ کٔرِتھ خیال چھِ تُہند واریاہ مہرٕبانی۔
نَہ، یِمِس بارَس منز سٲنِتھ چھُس مےٚ واریاہ غُصہٕ یِوان۔
شُکر چھُ، تِتھ کینہہ نہٕ اوسُس آبس منز ڈُبمُت۔
مےٚ ؤنی کٔر اَز پنُن پہل پِیانو سبق۔
تُہۍ چھا تیٖن بازو؟
آسہِ چھُ سٲری لۄکٕٹ چیز یاد تھاوٕنۍ۔
کام پتھٕ کرُن چھُ سُہ ورزش لازمی۔
مےٚ چھُ ابھی نیٹفلِکس پیٹھ مائنڈ ہنٹر ہُند پہلِ سیزن ختم کٔرمُت۔
ناچوز کِتھ پٲٹھۍ ضایع گٔے!
کیا تُہۍ چھِو سخت ژخمی؟
مےٚ ٲس ذرا پریشان ٹایر پیٹھ ڈرایِو کرنس متعلق۔
کیا یہ ٲس کُنہِ نامور یا مہنگٕ گلدان؟
مےٚ نَہٕ ہٮ۪کٕس کینہِ پٲٹھۍ خٲطر خۄدس تھٲمِتھ۔
مےٚ تہٕ میٛون بہٕن ٲس یِوان کینہِ پلے بوے رسالہٕ تہِ ڈۄنڈان۔
تِمۍ ونان ٲسۍ کہِ دِیِہ ایک ڈِسکاونٹ، مگر دِتۍ ژٕ دوٚن۔
آ، نَہٕ ٲسۍ کینہِ ٹانک یا کانٛہہ، مگر سُہ ٲس میٛون خاطرٕ واریاہ حیران کُن تہٕ مایوس کُن۔
یہِ چھُ اکھ زبردست فلم۔
مےٚ چھُس واریاہ خوش زِ میٛون چھُ اکھ سمجھدار تہٕ مہربان زٕن۔
مےٚ چھُ ضرور کینہِ ضرورت—بہتر خیال۔
مےٚ گژھان چھُس اک ہفتہٕ پتھ کولوراڈو منٛز زِپ لاینِنگ کٔرِتھ۔
مےٚ گوٚو یِم ہفتہٕ میٛون زٲیہ ہای سکول شروع کٔران۔
شاید کُنہِ مقٲمی پناہ گاہ ڈۄنڈو۔
میٛون ٲس اکھ میٹنگ تہٕ تَمہِ خٲطرٕ مےٚ کٔر سخت محنت۔
مےٚ ٲس یِتھ پٲٹھۍ محسوس کَران یَلہِ مےٚ ٲس انتظار کران زِ مےٚ گریڈ سکولس منٛز داخِلہٕ مِل یا نہٕ۔
تِمَن کٔہ کہ تِم شہرَس منز واپس گژھان چھِ۔
تَمہِ مےٚ چھِ گمان زِ موسم گژھِتھ سُہٕل۔
انتظار کرنہٕ سۭتۍ مےٚ چھِ بےچینی گژھان۔
بہٕ موٹرسایکل چلاوان آسُس تہٕ لوٗکھن ہُند جماتہِ ہُند سامنہٕ پٮ۪ٹھ ژٔلۍ گژھِ۔
بہٕ فخر سۭتۍ چمکان چھُس۔
کیا سُہِ چھِ برٛونٛٹھ کتُر؟
بہٕ اکھ پیزا آرڈر کور تہٕ یِتھ پٲٹھۍ یِنہِ منز أکِس گَنٹہٕ لَگ۔
میٛونۍ بیٚنۍ ہفتہٕ منز نَس گژھِ، یِمۍ سۭتۍ مےٚ چھِ تھوڑا اداس محسوس گژھان۔
آ، بہٕ میونۍ بیٚنۍ کٔہ زِ بہٕ یہِ نَہ کَران—مگر سُہ نَہ گژھِ۔
تِم روٚو کیازِ تِمَن کُنہِ نَہ اوس اُمید زِ مدد مِلہِ۔
آ، بہٕ چھُس کٔرمت، مگر سُہٕ نَہ گژھِ سُہٕل۔
یہِ موسَمُک وقت چھِ میونۍ پاپاچ یاد دِوان۔
سُہِ چھِ بہانہٕ ڈھونٛڈنُک کوٗشش کران۔
مےٚ اوسُس صرف یہِ ڈر زِ سُہِ کشتی گٲڑِ۔
بہٕ چھُس واقعی خوش نصیب۔
اگر کَتھِ کُنہِ تُہۍ لٲگِ زِ تُہۍ چھِ تِمن ہُند ضروٗرت، تِمَن چھِ ڈرایونٛگ کلاس۔
یہِ چھُ کِس قِسمُک ریسٹورینٹ؟
بہٕ وعدٕ کران چھُس، اگر تُہۍ کَتھِ مےٚ باٮ۪ر کَڈِو، بہٕ ہتھ ہلاوٕ۔
سُہِ اوس گژھِتھ پچھلے مہینے تہٕ چھُ سُہٕ واریاہ پیار۔
میونۍ خاندانَن چھِ مےٚ دٔور کٔرمت، یِمۍ سۭتۍ یِم خوفناک فیصلٕہ یِم مےٚ کٔر پٮ۪ٹھ۔
مےٚ واقعی ہیوٗن تھٕ کہ یہِ مےٚ چھُ حٲصل۔
ہاں، کینہہ لوکھ نِہ چھِ وٕنٛدٕر ڈَرِتھ، کیازِ تِمَن نَہ چھِ لَٹ آف کٔرمُت۔
شاید تُہۍ ہُنٛد ڈاکٹر سۭتۍ گژھ کَتھ کرُن گۄڈٕ خیال آسِہ۔
اوہ واہ، تہٕ یہِ اوس اضافی پیسہ یُس تُہُنٛد نَہ اوس۔
تہٕ اوٚس بیٚیہِ شہرَس منٛز روزان، یِمن سۭتۍ سُہ اچانک یِتھ پٲٹھۍ وٕچھ مےٚ سُہ تہٕ مےٚ گژھِ حیران۔
یہِ چھُ واحد چیز یَتھ پٮ۪ٹھ مےٚ ہر ؤری کٔر خرچ۔
ہاں، تِمَن مٮ۪نیجرس پستول ہُنٛد بَٹ سۭتۍ تہِ وٕدیو۔
مےٚ چھُ لگٕنۍ کہ مےٚ نَہ گژھِ جلدبازی کرُن۔
مےٚ چھُ کوشش کران تِہِ پَکٕش وٕچھنٕچ، مگر یہِ اوس واحد سکول یتھ مےٚ گژھُن آسُن۔
افسوس، مےٚ کِنہِ نَہ آس سائنسس منٛز خۄب۔
مےٚ حالیہ منٛز پَرٕن اَکھ واریاہ گۄڈ کتاب۔
یہِ چھُ میون باسان پٮ۪ٹھ، مگر سُہ چھُ چیز ماہَن تام تھاوان۔
کاش مےٚ تہِ وٕچھِ کُنہِ یِم پٲٹھۍ اَکھ شَخٕص۔
یہِ گژھِ واریاہ گۄڈ، تہٕ مےٚ چھُ آسہٕ پٲٹھۍ خیال اَسن ہٕنٛز آیندٕک رشتہ ہُنٛد۔
اوہ نَہ، کیا تُہۍ پنٛنٮ۪ن کٲمَس منٛز گژھِتھ ہیٚکِو؟
سچ وٲتھ، کینٛہہ تہِ آسہِ، مےٚ اوس پنٛنہِ B گریڈ پٮ۪ٹھ واریاہ خۄش۔
مےٚ چھُ نَہ کینہہ وٕچھمُت سُہ فلم۔ یہِ کیازِ چھُ دِلگٕژھ کَران؟
تٔمۍ چھِ اپارٹمنٹ مےٚ نٲو پٮ۪ٹھ ترٛٲومٕت۔
کیا سُہ اوس واریاہ پیسہ؟
حالہِچ میٛانۍ چوٗرِس اغوا کَرنٕچ واریاہ کوٗشش گٔے
کیا تٔمِس تُہٕنٛد پیسہٕ واپس دِتھ
یہِ دلچسپ تہٕ ڈرٲونہٕ دۄنوٕے ہُہ سکدا
کانٛہہ خاص نَہ، تٔمِس سٕتۍ روزُن چھِ زبردست
میٛون امتحان چھِ یوان ہفتہٕ
زنٛانٕن ہٕنٛز ریسٹ روم چھِ ہمیشہ اَتھ گَندِچ نَظَر یِوان
یہِ تٔمِس خٲطرٕ واریاہ سُہ گژھِ
تِمِس سٕتۍ واریاہ پورٛن یادٕ تَزٕ کٔر، کانٛہہ تہٕ واریاہ نَہ آسۍ سُہ
مےٚ چھُس صرف عدالتس منٛز کٲم کَرُن تہٕ لوٗکن ہٕنٛز کیسہٕ ہیٚوُن
مگر اگر تُہٕنٛدۍ نوکری لٔگِ تہٕ مبارک
ہاو، سُہ آسِہ پورٛن یاد دِلاون وول
گَژِس ہفتس منزہِک دۄہ میٛٲنۍ کُنٛر بیہوش گٔے
میٛون چھِ سُہ ہر وٲرِس مِلان تہٕ سُہ چھِ میٛانہِ فُٹبال سیزنُک اِنتظار کَرنہِ منز مدد کَران
اَتھ پَتہٕ کانٛہہ جواب نَہ آو، مگر میٛون چھِ اُمید
تُہِند خیال چھُ یہِ کِہِوِز
آ، میٛون چھُس تٔمِس خٲطرٕ واریاہ خوش
یہِ سُہ چھُ زِ تُہٕنٛد سپروایزر تُہٕنٛد محنت نوٗٹ کَران
مِشِگَن ہٕنٛز اَکھ شہرَس منٛز
میٛون نَہ چھُس سُہ ٹیٖوی پٮ۪ٹھ کٲمۍ وُچھمُت، مگر میٛون کُٹٕم چھِ کَتھ کَتھ وُچھان
میٛون سۆچُن آسِہ زِ اَسۍ تصادفَس منٛز گژھِو
مگر تہِ کم از کم افلاطونی دوست ٲسُن کُنہِ نقصان نَہ۔
آ، تہِ اکھ مفت ٹی شرٹ مٕلی۔
مےٚ چھُس خیال کران زِ مےٚ چھُس صرف رد گژھنہٕ ہند خوف۔
کیا تُہٕنٛدِس محلہٕ منز چھِ گوم گژھمت کُتر؟
بےٚ گژھان چھُس ایمسٹرڈیم۔
آخرکار چھُس مےٚ زندگی منز تِہِ چیز ٲسُن سۭتۍ سٲری خوش۔
مگر تٔمہِ رٮ۪من چھُس مےٚ دلہٕ منز خاص جاے دِوان۔
مےٚ چھُس خیال کران زِ تِہِ چھُ سٲری ٹھیک گژھمت، مگر جمعہٕ تام نَہ لٮ۪بہِ مےٚ خبر۔
مےٚ چھُس یقین زِ اگر تُہٕۍ چھِو پران، تُہٕۍ کرِو سُہ کار۔
تُہۍ کٮ۪ا کٔرِو تٔمِس جنم دۄہِس خٲطرٕ؟
سُہ چھِ ژٕرِ وُہرس سۭتۍ پَگہ۔ سُہ چھُ اَز کُن شرمیلا، مگر چھُ سُہ کمال ہَسبنٛڈ۔
مےٚ سٲنس زِ کانٛہہ چھُس مےٚ توڑان۔
مےٚ ووٚن زِ مےٚ زنہِ دۄدِس زِ مےٚ شراب پیُن بند کرٕ، مگر چھُس محسوس کران زِ بند کرُن چھُ مُشکل، مےٚ چھُس قصوروار محسوس کران۔
اوہ واقعی؟ مےٚ چھُس یقین کران مےٚ سۭتۍ تہِ تَتھ پٲٹھۍ گژھِتھ۔
تُہۍ کِنہِ نَہ گژھِتھ؟
کیا تِم گٔے دور یا تُہٕنٛد بریک اَپ گژھ؟
کیا تُہۍ چھِو تُہِ سۭتۍ خوش؟
ٹھیک، بہٕ گژھِ تَتھ اکھ ہفتہٕ۔
کیا تُہۍ دِتھ کینٛہہ تِمِس بدلہٕ منز؟
سُہ چھُ تُہٕنٛد اَکلمنٛد قدم۔
اگر یہ تُہٕنٛدِس خٲطرٕ کٲم کٔرۍ تہٕ مےٚ خبر دِیو۔
کَلۍ پیٚٹھ مےٚ عجیب محسوس کران۔
مےٚ لگٕن چھُس زِ بہٕ بیمار گژھان۔
تِم چھِ ہمیشہ مےٚ تہٕ مےٚ بچٕن خٲطرٕ حٲضر۔
مےٚ چھِ کینہہ دوس تِمَن ہٕنٛز حالت چھِ مےٚ پٮ۪ٹھ واریاہ بہتر۔
مےٚ چھُس اُمید کران زِ تُہٕنٛدِس معاملہٕس منز یہ برش پیٚٹھ آو۔
مےٚ چھُس پٲٹھ یقین سٟتۍ واریاہ اُمید تھاوان۔
تُہٕنٛز مقصد چھُ عضلات بٔڑاون یا وزن کم کٔرُن؟
کَلۍ بہٕ اکیٛس ۵ پیزا کھاد۔
مےٚ کٔر تِمَس ژٕلۍ بار تِمَن پنٕن کٲم کٔرنس خٲطرٕ ونان، مگر تِمَن چھُ نہٕ ابھی تام کٔرۍمُت۔
فورٹ نایٹ چھُ اَکھ مُفت گیم تہٕ سبسان زیٛادٕ کھیٚل گژھان گیم نمبر ۱۔
مےٚ چھُس شُکرگُزار زِ مےٚ والدینن کٔر مےٚ پرورش کِتھ پٲٹھۍ۔
مےٚ چھُس تُہٕنٛز باتھ سۭتۍ متفق گژھنس طرف مائل۔
یہِ چھُ اَکھ سُہٕ احساس۔
آہ، یہِ چھُ واریاہ دُکھی کُن۔
کینہہ خاص نہٕ، مگر سُہٕ آو سُہٕنٛد۔
تِمَن نہٕ آوُن ہٕنٛز وجہ آس مےٚ دوستٕچ غلطی۔
مےٚ چھُس سَانان زِ تُہٕنٛدِس کٲنٛہہ لیبر شروع کٔرٕن یا شیڈیول کٔرِتھ سی سیکشن ہٕنٛز منصوبہٕ چھُ۔
مےٚ چھُس نہٕ جانان زِ کینہہ لوگ پنٕن ہُنر تہٕ زنٛدگی کیازِ ضایع کَران۔
نہٕ، مےٚ اوس محسوس گژھان زِ مےٚ ہٕنٛز سۭتۍ تہِ کٔر محنت۔
مےٚ چھُس ونان زِ مےٚ کَتھ پَتہٕ چھُ اَز راتھ کیاہ کھٲنس۔
تَمہِ کٔر مےٚ سِریز دۄبارٕ نَظَر۔
یِم پُران دۄست چھِو تُہۍ کَتھ بوزُن نَہ دِتھ، تِمَن ہٕند نَظَر گژھِتھ ہیکِو بٔڑ یادٕکُن۔
مےٚ کٔر نَہ سُہ کُنُن، کیازِ مےٚ چھُ نَہ پَتہٕ زِ یِہ کٔرُن کِتھ پٲٹھۍ محفوظ آسِہ۔
سٕمَر چھُ حد کھۄتہٕ گرٕم۔
مےٚ کٔر پَتہٕ ہفتہٕ اَکھ نو جاب آفر، مگر مےٚ چھُ نَہ پَتہٕ زِ مےٚ سُہ لیٚکھِ یا نَہ۔
ٹھیک چھُ، تُہۍ ہٕیکِو ریس کٔرِتھ، تہٕ یُس ہارِ سُہ گژھِ نَو حٲصِل۔
مےٚ چھُس پنٛنِس بٲیِہ سٕتۍ خَفہٕ۔
مےٚ چھُس اُمید کَران زِ سُہنٛدَر چھِ اَج تہِ سٲری شےٚ۔
سُہ آس سُہ تہٕ اَج تہِ چھُ۔
گَژھِ دۄہ مےٚ چھُ اَکھ بٔڑ کَمُک جٲیزٕ۔
کیا تُہۍ چھِو یہِ پَگاہ کٔرمتھ، یا چھُ یہِ بِلکُل نَو قِسمُک پیشہٕ؟
شایَد مےٚ گژھِ جِم، پنٛنِہ نٮ۪روٗز شٲنت کَرنٕے خٲطرٕ۔
یِتھ گژھان تِتام چھِو تُہۍ کانہہ ضٔروٗری کٲم کَران؟
اینٛڈریو کوٗمو یُس وون، تَتھ پٮ۪ٹھ چھُس مےٚ بٔڑ خَفہٕ۔
یِہ چھُس مےٚ بٔڑ دِوانٕچ لَگن، مےٚ چھُس نَہ یِمَن مَنٛز شامِل گژھان۔
تُہٕنٛد نَو کٲم کیاہ چھُ؟
مےٚ چھُ یاد زِ بَچپَنَس مےٚ تہٕ مےٚ بٲیِہ ٲسٕو بٔڑ دۄست۔
سوموار کٔر مےٚ نَو جاب شروٗع۔
واہ، سُہنٛدۍ کَنۍ مٮ۪لِتھ یہِ چھُ اَکھ کمالُک نِشانِ یاد۔
مےٚ ہمیشہ ہریکینن خٲطرٕ تیار ٲسٕن
کیا توہہ کینہہ پتہ لَگٕو سُہ کُس اوس
ہاں تہٕ تَمہِ خٲطرٕ مےٚ تعریف کرنہٕ یوان
ییلہٕ مےٚ پنٕنۍ تہٕ پنٕنٮ۪ن بٲین ہنٛد تصویراں دِژھ
مےٚ گَرٕ یِتھ پٲٹھۍ سُہ نٕہ مٕل
کیا سُہ واقعی تبٲہی ٲس یا صرف تَمہِ پٲٹھۍ لَگن اوس
سُہ چھِ اکھ کمالُک کامیٲبی
مےٚ ٲج صُبح پنٕنۍ کمبخت گاڑِ نِسٕرِتھ پَتھ گٔیِو
کیا کمالُک اچنبہ تہِ
مگر یہِ چھِ زِندگیُک حِصہٕ، چیزہٕ گژھان چھِ
مےٚ پہلۍ بار اوکلاہوما فلمُک گانٛڈٕ ‘اوہ، کِتھ خوبصورت صُبح’ گٲو
مےٚ سچِ امیٖد کران چھُس زِ سُہ یہِ خراب نہٕ کَرے، ہاہا
ییلہٕ گاڑِ مےٚ نَوۍ قالیٖن پؠشٲب کٔر، مےٚ نٕہ اوس خۄش
کیا توہہ سُہ دوبارٕ لِتھ ہٕیکِو
مےٚ ٲس ذرا پریشان ییلہٕ مےٚ ٲج صُبح ڈاکٹر کٕتھ گژھُن اوس
یہِ گژھِ الیکٹریکل انجینئرِنگ
مےٚ ٲس پَک یقین زِ ۲۰۰۶ ءِ بَرس سُپر باؤل جیتان
سُہ چھِ کمال، ییلہٕ توہہ تِمۍ سۭتۍ پہلۍ بار ملاقات گژھِ، کیاہ کَرِو
مےٚ گژھِ زیادہ باخبر
مگر شاید سُہٕے گژھِ یُس توہہ چھُ ضرورت
مےٚ حالیہ منز لفٹَس منٛز پھنس گٔیِس۔
تُہۍ ضروٗر گژھان بہت خوش تہٕ فخر محسوس کران۔
مےٚ سمجان چھُس زِ دوٚسرن ہُنٛد کاروبار چھُ اَکھ بہت حساس موضوع۔
مگر سُہ چھُ تھوڑا مزاحیہ۔
مےٚ جہازَس منز کودِتھ باہر یُنُک بہت ڈر آس۔
ہیلو، چھِ تُہۍ کُنِہ بچہ؟
تُہۍ کٔرِتھ ہیکیو مثال تِمن ہُند یِمَن تُہۍ حالیہ منز حیران کٔر؟
مےٚ جٔتھ لٹری، مےٚ چھُ نہٕ وۄنۍ پَتہٕ کانٛہہ کَم کَرُن۔
سُہ چھُ اَکھ سٕنہٕ سۭتۍ مےٚ پنٕنۍ موجودہ نوکری تَھٲوٕنِچ بےتاب۔
کم از کم سکول چھُ جلدی شروع گژھُن۔
تُہۍ کُنِہ کُنِہ چیز یژھان زِ منصوبہٕ مُطابق گژھِ؟
مےٚ ستمبرس منز اَکھ نوٚو رول لیکھِ کَمَس پَتہٕ وَتھِس۔
سٹرینجر تھِنگز چھِ مےٚ ہُنٛد پسندیدہ شوز منٛز اَکھ۔
سُہ اَکھ ڈانس ریسائٹل آس، مےٚ چھُس بہت خوش۔
کیا تُہۍ گژھِو اَکھ نوٚو ژٕٹِتھ؟
مےٚ آس چھِ زِ تُہۍ یہِ سٕدٕرٕتھ تھاوِو۔
سُہ چھُ واقعی کمال! تِمۍ کٔمِس منز مقابلہٕ کٔر؟
آج مےٚ ہُنٛد پوتُرٕن مےٚ خٲطر بسترَس پؠٹھ ناشتہٕ بناو، مےٚ چھُس بہت خوش زِ سُہ چھُ مےٚ ہُنٛد پوتُر۔
مےٚ ہُنٛد لٔڑکۍ چھِ یہِ وَرۍ لیکروس ٹیمس منز شامل گژھُن یژھان۔
مےٚ آس چھِ زِ وقتس سۭتۍ تُہۍ خٲطرٕ یہِ بہتَر گژھِ۔
ہوٹل منٛز اکیلا اوسِتھ مےٚ بےحد الگ تھلگ محسوس گژھان
مےٚ اوسُن پَران تصویٖر وُچھان یِمن منز مےٚ بچہٕ آسِ تہِ لٔکٕر
مےٚ اوسُن بس یہ ڈر زِ ژٕنٛگ لگِ نہٕ
شاید تُہۍ یہ یادگار خٲطرٕ خرٛیدِتھ گژھِو
مےٚ امید چھِ زِ یوانۍ تُہۍ پنٛنٮ۪ن پیارٕ کرن وٲلٮ۪ن کَنٛہہ مزید پھول مِلِتھ
تہِ وُچھُن اوس واریاہ کٲمِل
تُہۍ کینٛہہ قِسمہٕ ہُنٛد کرتب کرِتھ ہٮ۪و
ٲس چھِ ونان زِ یِم سیل فونن ٲس استعمال کران، تِمن کٔر سٲری کانٹیکٹ ڈِلیٖٹ
مےٚ تِمِس پورٕ پورٕ بھروسہٕ کٔرِتھ ہٮ۪و
یہِ چھِ سُہن کٲمِل، تِمِس دِیِو وقت، سُہ گژھِ واپس ٹھیک
کیا اوسُہ تِمِس منز سُہ یا باکمال
یہِ ہٕکٕر افسوس گژھِ
مگر اگلے ورٕس چھُٹی پٮ۪ٹھ گژھنس مےٚ ہٮ۪و نہٕ اعتراض
کیا تُہۍ تِمِس پٮ۪ٹھ پریشان چھِو
مےٚ ژٔٹَہ ٲج سُہمس پارکِنگ کران دۄستُک کار کَھٹِتھ
اُم، تُہۍ ونان چھِو زِ اگر کَنٛہہ غریٖب ٲس مےٚ مالی مشورٕ دِوان، نَتہٕ یہِ چھِ بے معنی، ہا
بیچارٕ نُنٛہہ بلی، پتہٕ کیا گژھ؟
کیا تُہنٛد رشتہٕ خراب چھِ یا کینٛہہ رشتہٕ چھُے نہٕ
سُہ چھُ اَز تہِ أسۍ سٕتۍ
مےٚ اوسُن وٲریاہ خۄش یِوانۍ، ییلہِ مےٚ پنٛنٮ۪ن ژوٗنٛگن سٕتۍ باہر کھیٚل
مےٚنِس بٔسٹ فرٛیٚنٛڈس اِتھ پٲٹھۍ سۭتۍ خۄबसورت گَرٛل فرٛیٚنٛڈ حٲصِل گٔژھ
مےٚنِس گَرِ یِوان نُنٛن کٔنٛنٛۍ ڈرٛاوُن مےٚ چھُ بہٕت پسند
یِم بٹکائن ملیونیرن ہٕنٛز کَتھ پٔڑھِتھ مےٚ چھُ ہمیشہ افسوس گژھان
یِلہٕ مےٚنِس دوستن ہٕنٛدِس کمپیوٹرَس منز پرٛوبلم یِوان، تِلہٕ تِم مےٚنِس کِس آسن
تُہۍ یِہ کَرُن گژھِ، یِتھ چھُ ہر کَنہِ خٲطرٕ کینٛہہ نہٕ کینٛہہ
اُمید چھِ زِ تِہِ لَوٕکٕر یِہ سَمجھ یِہ اَپُن سکوٗلُک کام لَوٕکٕر خٲرِج کَرُن چھُ بہتر
مےٚنِس شُرِکٕن آخری وَخت مےٚنِس بَچن ہٕنٛز دِیٚکھ رٛیکھ کٔر
یقینن، کیا چھُ تِہِ ہٕنٛدِس دِماغس منز کانٛہہ کالج
کامس پٮ۪ٹھ اَکھ لمبہ مگر کامِیاب دۄہ گژھِتھ ہٕںٛز گَر یِتھ مےٚ کَتھٕن سۭتۍ بس آرام کٔر
بہٕ گژھان چھُس یِتھ کَور بینٛڈس دِیٚکھنہٕ یُس مےٚ چھُ اَکھ وٲرِیاہ پٲٹھۍ دِیٚکھنُک شوق
تِمِس مُتعلق بٲتھ کٔرِتھ شیئر کٔرنس خٲطرٕ شکریہ
سُہ چھُ وٕنِہ بہٕت خوش
مےٚ گوٚو تِہِ رٛاوٕتھ تہٕ بٔیس سٲری لٲٹری ٹِکِٹ کٔنۍ
گۄڈٕ یِلہٕ چھُ بہٕت مزٕ یِوان
مےٚ چھُ نَہٕ کُنہِ پٲٹھۍ بھوتن پٮ۪ٹھ یقین، مگر یُس کانٛہہ چیٖز مےٚ بھوتن پٮ۪ٹھ یقین دِلاوِتھ ہٕکِہ تَمس چھُس مےٚ نَفرٕت
آہ نَہ، اُمید چھِ زِ تُہۍ لَوٕکٕر بَرٛونٛٹھ حِس کَریو
مےٚ چھُس اَپٕنِس مُتعلق بہٕت خۄش حِس کَران
یِہ پَک تہٕ کَرِو زِ تِہِ تِمِس یِہ وُچھِو
کُنِس مےٚنِس کَرس پٮ۪ٹھ پٲٹھۍ ٹَکَر دِتھ تہٕ مےٚنِس کَرُک باڈی ورک چھُ ضٔروٗری
مےٚ نَہٕ کُنہِ پٲٹھۍ سَمجھ یِوان
مےٚ ابھی ابھی أک نٔو کافی پاٹ استعمال کٔر، یمو برانڈ ہٕنٛز مےٚ کینہہ آزمٲیش نَہ کٔرمُت۔
یہِ پورسلینُک چھُ۔
مےٚ گژھ ہفتہ پنُن کچرا باہر تھاونُک ویسریو۔
بدترین چھُ یہ زِ مےٚ پنٕنِس باس سۭتۍ اَتھ کَتھ پریشٲنی منز پٲٹھ زِ کٲمِلٕچ نقصان گژھنُک آس خطرٕ۔
نَہ، تِم ہیٚ کٔر معافی طلب۔
مسئلہ چھُ زِ سُہ ہمیشٕ میٛہِ پٮ۪ٹھ مذاق کران چھِ۔
مےٚ چھُ یقین زِ تٔمۍ اَسۍ قدر کٔرمُت۔
کیا چھُ تُہٕنٛد پپی وُنی تہِ یِتھ؟
مےٚ حیران چھُ نَہ، کیازِ مےٚ اعلیٰ معیارُک تعلیمُک خرچ دِتمُت۔
نَہ آسہٕ تہٕ مےٚ کِیاہ کَرمُت آس، نَہ چھُ پتہٕ۔
سکولس منز پرفارم کٔرنہٕ پتہٕ واریاہ کٔنٛیِہ میٛہِ سۭتۍ رابطہٕ کران چھِ، مگر میٛہِ چھِ أک گرل فرینڈ۔
آ، یہِ چھُ دُکھ دِوان وِزِ سُہ اشارٕ دِوان چھِ زِ تِمۍ ہٕنٛدۍ بچہٕ میٛہِ ہٕنٛدۍ بچن سۭتۍ زیادٕ عقلمند تہٕ ہر پٲٹھۍ بہتر چھِ۔
تِمۍ منز زیادٕ تر گژھان چھِ یِتھ سطحس پٲٹھۍ کھاونُک مشق کٔران واریاہ وری۔
کیا تُہۍ جلدے أک دۄہ چھُٹی میلان؟
نَہ، سچ پٲٹھۍ مےٚ چھُ نَہ پتہٕ زِ کِتھ کٔرِ۔
کاہ چھُ نَہ، آخرس منز یہِ فائدٕ دِوان آسہِ۔
میٛہِ چھُ واریاہ شرمندٕ محسوس گژھان، کیازِ میٛہِ سۭتۍ دغا گٔے۔
یہِ کِس قِسمُک کلاس چھُ؟
ملبٕس سۭتۍ صرف تھوڑا فرق تھاون تہِ ڈرٲونُک گژھِتھ۔
نَہ خاص، مگر کینہہ کینہہ گژھان چھُ۔
بہٕ اَز جینز کٔرۍ۔
پَتہٕ مَے منز گریجویشن تہٕ پروم چھُ۔
مےٚ پٕتر چھُ مےٚ دِوان زٕنہٕ زٕنہٕ چلی آمتھ واچ۔
بہٕ گژھِ آسٕن بہت پریشان۔
مےٚ چھُ امید زِ بہٕ یہِ کرٕس یہِ سمسٹر منز تہِ۔
پچھلی ۳ نسلن منز چھِ سُہ پہلۍ کالج گژھن وٲلۍ۔
کیا یہ چھُ یِم بڑٕ گژھان چھِ تِمِس سۭتۍ؟
کیا تُہۍ کَنہِ وَن آنلائن ڈیٹنگ آزماوِتھ؟
یہِ ویک اینڈ رولر کوسٹر رٲڈِنگ۔
اے سی کَنِہِ ژٕیٖد کٔر۔
مےٚ چھُ ضٔروٗر وُنُن زِ یہِ چھُ اکھ سۭتۍ زٕیادٕ اجر دِن وٲل فیصلہ یُس مےٚ زنٛدٕگی منز کٔر۔
ویٹ چھِ کمال تہٕ چھِ وۄنۍ ژٕیادٕ کینہہ کٔرِتھ ژٕنٛگن بچاونہٕ خٲطرٕ۔
سُہ ٹیمپہ بے بکس آس۔
اوہ، سُہ چھِ واقعی نَہٕ سُہاون۔
شاید سُہ چھِ تَمہِ سۭتۍ پٲٹھۍ پٲٹھۍ پُراعتماد۔
مےٚ چھُ یاد زِ ییلہِ بہٕ آسٕن کم عمر، أسۍ ہٕنٛدِ ٹیچر ہر ژھومہٕ دِوان پین کیک۔
مےٚ اوسُس زٕیادٕ غُصہٕ ییلہِ مےٚ ہٕنٛد برٛور سکولس منز تَمہِ کامہِ خٲطرٕ مُشکلِ منز پَتھ یُس تٔمۍ اوس نَہٕ کٔرمُت۔
تُہۍ کَم وقتھ پٲٹھۍ چھِ اکھ سۭتۍ؟
تُہۍ تہٕ تُہٕنٛد کُٹُم کِتھ پٲٹھۍ کٔر؟
بہٕ اوسُس کانہٕ پٲٹھۍ مسکران۔
یہِ کِنہٕ مےٚ کٲمَس منز دۄر لَگنہٕ چھُ۔
بہٕ چھُس واتان خوش نصیب باپ، مےٚ سُہ چھُ بہترین پٕنُن بیٚٹہٕ۔
یِم گَر مےٚ چاہان اوس، تَمہِ کُنہِ مےٚ پیٹھ زیادٕ بولی لَگاو۔
آ، یہِ چھُ بالکل مزٕ نَہٕ۔
گژِش گۄڈٕ مہینٕ تام بہٕ کُنہِ وٲتھ کٲمَس پیٹھ ژھٹ پٲوان اوسُس، تہٕ کُنہِ نَہٕ دۄر۔
آ، تہٕ سُہ کُنہِ چیٖز نَہٕ پھِکُن۔
کیا تُہۍ تِمَن ہٕنٛز گَر دِتھ؟
یِہِ شِکَست چھُ کافی بٔڑ۔
ییلہٕ بہٕ کُنہِ فضول گژھِتھ کِنہٕ کُنِس مےٚ بیٚٹِس پیٹھ ژھٲنٛگ ژٕل۔
اگر مےٚ وُن جانٛوُن اوسُس زِ واشنگٹن منز میلہِ اَسہِ واقعاتن ہُنٛد سامنا کَرُن، تہٕ مےٚ فلوریڈا گژھِتھ اوس۔
اُمید چھُ تُہٕنٛد سَفَر گژھِ سُہنٛد۔ کُنہِ چیٖزس پیٚٹھ نَظَر تھاوُن چھُ سُہنٛد۔
مےٚ چھُ نَہٕ کھیٚلِتھ یہِ گۄڈٕ۔ یہِ چھُ کانٛہہ قِسمُک کھیٚل؟
آ، تُہۍ چھِو ضرور اکیٚلا محسوس کَران۔
گروپ منز بہٕ چھُس سبھَنٛے پیٚٹھ نٲوٕ کٲم کَران۔
بہٕ چھُس واتان، سُتھ گژھِتھ دۄدٕس پیٚٹھ رۄوُن بے فائِدٕ چھُ۔
مےٚ چھُس نَہٕ سَہِتھ مےٚ سٕہٕرِس۔
کیا سُہ کِنہِ نُقصان کٔر؟
مےٚ چھُ اَکھ روٗٹین یُس کَران مےٚ سُہنٛد جوش تہٕ سۄبٕنٛہ کٲمَس خٲطرٕ تیار۔
مےٚ اوس محسوس گژھان زِ بہٕ کِنہِ تہِ کَرِتھ ہیکَس۔
وۄنۍ وۄنۍ چھُ وقت تِمِس ہُند سرپرائز جنم دۄہ پلان کرنُک۔
ہاں، بہٕتَن خٲطرٕ کٲم چھُ پریشٲنی ہٕنٛز وجہ بنٲوُن، تہٕ تُہۍ یِہ کٔرو۔
کَتھ کَتھ چھُس بہٕ پنٛنِس خٲطرٕ دۄن تٕرن سٕنٛیکس لُکٲوِتھ تھاوان، تہٕ چھُس تھوڑا قصوروار محسوس کران، مگر یِتھ منز کانٛہہ غلطی چھُ نہٕ۔
ہاں، یِہ چھُ کافی خراب۔
مے چھُ یاد، ییلہٕ بہٕ لُکچُھس، آیس کریم والہٕ مےٚ گلی منز یِوان اوس۔
کیا تُہۍ کٔرۍ فون زٲنۍ کہ تُہۍ بیمار چھِو؟
مےٚ چھُس یِمن متعلق دۄیم خیال آوان۔
کیا تُہۍ چھِو جاے بدلٲوُن، مثلا نوکری خٲطرٕ یا کِنہہ یِتھ پٲٹھۍ؟
شاید تُہۍ پروموشن گژھِو۔
مےٚ آنٛٹِس پیٚٹھ أکِس ایمرجنسی یِتھ، تہٕ سُہ پنٛنِس زٲوِس مےٚ سُپرد کٔرِتھ گٔیہ۔ مےٚ کٔر تِمِس خیال۔
ہاں، یِہ نہٕ زٲنۍ کہ انسانیت کتھ کٔنۍ بے رحم چھِ، اوس واریاہ پُرسکون۔
مےٚ کٔر تقریباً ۵ گنٹہٕ پنٛنِس امتحان خٲطرٕ مُطالعہ۔
مےٚ چھُس ڈونلڈ ٹرمپ پیٹھ واریاہ غُصہٕ۔
مےٚ چھُس نہٕ وٕنان سُہ کٔرِ، سُہ چھُ نہٕ واریاہ بے لگام قسمُک انسان۔
کیا تُہۍ چھِو پنٛنِہِ فُٹ بال کھیلان؟
گژھِ مےٚ کَل اکیلہٕ پارک۔
تِم چھِ مےٚ تہِ دُکھی کَران۔
یِہ چھُ کمال؛ اکھ سُہٲوُن رشتہٕ چھُ بھروسَس پیٹھ قٲیم۔
سُہ اوس یَتھ پٲٹھۍ سَدار جوش منز۔
سٲری تعریف چھِ تِمَن مِلان۔
یہٕ جیپ رینگلر ایکس سیریز چھِ۔
مےٚ چھُس تُہۍ خٲطرٕ واقعی افسوس۔
مےٚ چھُس یقین، سُہ اَتھ بُرٕ نَہ آس۔
زیادٕ تَتھ ٹھیک آس؛ تَتھ لمحس منٛز مےٚ اَتھ نوسٹالژِک لَگ کہ مےٚ روٚد۔
یِم خٲطرٕ چھُ واریاہ طاقت تہٕ سخت پیار ضرورت۔
مےٚ 95 حٲصِل کٔرِتھ ہٲو۔
مےٚ کٔر سٲری ہفتہ یِتھ پٲٹھۍ کٲم۔
مےٚ چھُس آسہٕ کران زِ سُہ ٹھیک آسہٕ۔
نیک تمنائیں، مےٚ چھُس آسہٕ کران زِ تُہۍ سُہ پٲٹھۍ کٔرتھ تہٕ حٲصِل کٔرتھ۔
رشتہٕ کامیاب بناونہٕ خٲطرٕ چھُ بھروسہٕ واریاہ ضٔروٗری۔
کَل رات مےٚ سُہ آواز شُن زِ مےٚ ہُند گَرٕ منٛز اَکھ کھڑکی ٹُٹمُت، تہٕ مےٚ گَرِ اکیلا ٲس۔
مےٚ کَسینوَس منٛز واریاہ پیسہٕ ہٲروٚ۔
یَلہٕ مےٚ یی پَتہٕ لَگ زِ اَکھ کلاس میٹ چھُس مےٚ ہٕنٛزۍ لٔڑکِس سۭتۍ ظُلم کَران، مےٚ وُچھ اَتھ سخت پریشٲن۔
کیا تُہۍ چھِوِتھ تارِکۍ ہٕنٛز خوف؟
اچھا، کیٛاہ تُہۍ کَڈ چھِ اَکھ روم میٹ انٛنہٕ خٲطرٕ کٲفی جٲے؟
یِم مےٚ ڈۄہِس ٲس، سُہ مےٚ نَہ آس کِرنہٕ۔
یِلہٕ مےٚ ہُند خرگوش کینٛہہ وٲری پَتہٕ مٲر، مےٚ گژھِ واریاہ پریشٲن۔
مےٚ چھُس بے صبر زِ مےٚ کیاہ بَنٲومُت چھُ، سُہ شُنٛنہٕ خٲطرٕ۔
مےٚ ہٕنٛز کیبل بِل دِتھ ضٔروٗری آس۔
پروجیکٹُک قٕیمت ٲس اَکھ مِلیَن ڈالر پٮ۪ٹھ زیادٕ۔
مےٚ اُمید چھُ کہ اَسہِ وِواہ گژھِ۔
آ، سُہ دۄبارٕ چیمپین بٔنِتھ ہیکِ۔
فُٹبال سیزن مُتعلِق تُہۍ کِیا چھِ پسند؟
مےٚ سوچان چھُس زِ سُہ کِتھ پٲٹھۍ تصدیق کَرٕنۍ ہیکٕن۔
بس ٹھنڈٕ رٲژِو تہٕ یِتھ پٲٹھۍ تُہۍ سکھاونہٕ آمٕژ چھِ، تِتھ پٲٹھۍ کٔریو۔
یہِ چھِ اَکھ زبردست خیال، صلاح دِنِہٕ خٲطرٕ شُکریہ۔
سُہ چھُ اَکھ مَزٕدار اِوینٹ لٲگنہٕ۔
مےٚ یقین نَہٕ کٔرِتھ ہٕکہٕ ییلہِ مےٚ پَتہٕ لَگ زِ میٛٲنۍ سِسٹر اِن لاٙ گربھٕوَتی چھِ۔
مےٚ چھُس ہالی اَکھ نٔو دوست بناونومُت۔
مےٚ چھُس ہالی اَکھ نوکری ہٕنٛد انٹرویو مِلٕمُت۔
کینہہ مانٛہہ پیٹھ مےٚ اوسُس تِمِس بہٕن دَتک لِتمُت، تِمِس سۭتۍ چھِ مےٚ آوٕ پانچ۔
تِمِس مُتعلِق سوچِتھ مےٚ چھُس بٔہتھ غُصہٕ۔
کُٹُنبن دِمِس کینہہ پیسہٕ یِمِس نٔو خریدِتھ گَر دُرُست کٔرٕنۍ اوس۔
یِتھ پٲٹھۍ فخر پٲدا کٔرٕنۍ خٲطرٕ سُہ کِیا کٔر؟
آ، کانٹینٹ خٲطرٕ یہِ چھُ بٔہتر وقت۔
مےٚ اوسُس کامہِ خٲطرٕ بٔہتھ لیٹ تہٕ تِتھ پٲٹھۍ گژھنس خٲطرٕ اوسُس تیز گاڑِ چلاوان۔
مےٚ چھُس شُکرگُزار زِ مےٚ چھِ موقع مِلان پنٛنِٛن بھتیجن ہٕنٛز دٮ۪کھ رٲکھ کٔرٕنۍ۔
کاش مےٚ آسٕہ تِتھ پٲٹھۍ گیمِنگس منز بٔہتر!
شاید چھُس تِمِس کینٛہہ سۭتھ ہٕنٛز ضروٗرت۔
مےٚ اوسُس اَکھ باڑ اوٚر پار گژھنُک کوٗشش کَران، مگر آخر مےٚ ہٕنٛز جینٛس پھٹ گٔے۔
