یِم پَنٛنُن وَتھ کَرنَس پٲٹھۍ یِم پَنٛچھِن مےٚ بِلِی کٕر پٲٹھۍ
مےٚ وون تُہۍ گژھِ اسہِ کَران
تُہۍ کُن چھِو گژھُن پسند
کَتھ کَتھ یِلہ طوفان گَژھِ شَدید، گٲڑِ کَنارَس تھٲوُن چھِ سُہل
اَز مےٚ چھُس گھَرِ تَمہِ اکیلٕ
نَہ، مےٚ چھُ نَہ پسند زِ مےٚ یِتھِ اکیلٕ رۄزمُتھ
مےٚ یاد دِلٲو زِ سُہ کَتھ کَتھ لَکٕر اوسِ کِنٛہِ وَقتھ
مےٚ گژھان چھُس ہَوایِس اَتھ وَرۍ
مےٚ اوس دَپان پنُنۍ بٲیِس زِ اَز رٲژِ مےٚ تِمِس سٲتھ یِک ڈَرٲوُن فلم دِژھ
تِمَن سُہ کٲم کٕر، ٹیٖچَرَن کِتھ پٲٹھۍ رَدِعمل دِتھ
بدقسمتی سٲتھ، بس سٹیشن خٲطرٕ یِہ لگِتھ چھِ تقریباً صحیح
یِلہ کُنہِ سٲتھ چھُ نَہ مخلص، مےٚ چھِ چِڑ یِوان
کاش مےٚ اَکھ سُہ ISP وُچھِ یِم آخرکار
مےٚ چھُس سَمجان زِ تِمَن اوس اَج تام پَنُن نَخ
آ، اُمید چھِ زِ تُہۍ کَم اَز کَم شُر کَرِو
مےٚ بَبرَن اوس دۄہِم دۄپہرۍ کھٲنس خٲطرٕ پِزّاچُک یِک ٹُکڑٕ تھٲوُتھ
تُہِ چھُو ٹھیک گژھان، ہمیشہ چھُو یِژھان۔
تُہِ چھا زانان کِہ اَسٕن ناو کیاہ گژھِ؟
مٲنٛز دوست چھُ نہٕ وٕنٛدٕ مےٚ سۭتۍ کینہہ تعلق تھاوُن۔
اُمید چھُ مےٚ تُہِ سۭتۍ واریاہ مزٕ کَران۔
حالَت خراب گژھنس سۭتۍ برونٛہہ چھُ بَرٕ یِہِ وِچارن۔
یہِ چھُ اَکھ وجہ بنان اُٹھنس تہٕ تُہِ مدد کران زیادہ وۄتھ صحت مند تھاونس۔
کینہہ وار چھِ جیون ساتھی یِوان کامیاب، تہٕ کینہہ وار نہٕ۔
اچھا، تُہِ چھِو عقلمند—شادی کرنس سۭتۍ برونٛہہ صحیح شخصس خٲطرٕ ضرور انتظار کَر۔
ایبسٲلِنگ چھُ یِوان ونان یِمارتھ پٮ۪ٹھ رسۍ ہٕنٛدۍ رَپِل کٔنۍ ہیٚٹھٕ یِوان۔
مےٚ آیہِ دۄہلِ اَٹھ تہٕ مےٚ کٲمَس گژھنس منٛز دۄہل گژھان۔
مےٚ گژھ حیران یِتھ پٲٹھۍ یِم مےٚ پسندیدہ بینڈ چھُ نہٕ یِوان مےٚ شہرَس ہٕنٛزِس ٹوٗرَس۔
تُہِ کمپنیَن چھُ تُہِ اکیلا تھاوُن۔
مےٚ ؤلۍ دوٚہِ ہٲے سکول گریجویٹ کران چھِ یِم بہار۔
تُہِ چھا زانان کینہہ جاے یِتھِ مفت چھِ یِوان؟
تُہِ چھا ونان یِم چھِ مُلک خراب کران؟
مےٚ باہَر گژھان اوس تہٕ مےٚ گژھِ کُتُرس ہٕنٛدۍ گوٚبرٕ ہٕنٛدِ ڈھیرس منٛز۔
مےٚ آیہِ یِہ کہ تِم علاقن منٛز چھِ یِم واریاہ عام۔
مےٚ کٔرۍ چھُ ابھی ہٲے سکول پاس۔
مےٚ چھُ یقین زِ أسۍ سٲری بچت کرنس منٛز کٔرِتھ سۭتۍ برٕ کٔرِتھ ہٲو۔
ٹوکیو منٛز مےٚ کٔژ وقت اوس سچۍ واریاہ پسند، یہِ اوس اَکھ بہترین تجربہ۔
تُہۍ ضٔروٗر اَکھ لَچھ رَسٕوٗی ہٕند
مےٚ یاد دِلٕو کہ ژٕ تُلۍ مےٚ نٕزٕرِ سامنٕے وٲلۍ گژھان چھِ
اَز چھِ اَسہِ ہٕنٛز پٲٹھۍ وُچھمُت اَکھ بٔڈ کٲلۍ سَپ
تِم چھِ سٲری لَچھن یِم آسُن گژھان
سوٗ چھُ وُنٛۍ ویٹرنٕری ہٕنٛد نٕزٕدیک
مَگر آ، یہِ چھُ گٔژھان بٔڈ ڈراوٕن
یہِ چھُ بٔڈ خراب، سُنے مےٚ دُکھ لَگِتھ
مےٚ چھُ اُمید کَران زِ میٚونۍ بیٚیِہ نہٕ کرِ تَمہِ تٔمۍ
اَز چھُ میٚونۍ نوکری ہٕنٛد اِنٛٹرویو
یِہِ گژھِتھ چھِ تِم سٲری یادٕ اچانک وٲپس یِوان
میٚونۍ کَتھ چھُ اَکھ سَتھی کٲم کَران بُٹھمُت، یُس سٲری دۄہ پٮ۪نہِ سٕتۍ شور کَران چھُ
مےٚ چھُ بے صبری سٕتۍ انتظار کَران تہٕ دۄہ ژٕٹان زِ میٚونۍ بچہِ ہٕنٛدۍ نٕزٕرۍ سٕتۍ نٔو دُنیا وُچھٕن
تٔمۍ سچ مُچ کٔر کٲم تَمِس خٲطرٕ
تِم ضٔروٗر بٔڈ ٹٮ۪نٛشن وٲلۍ آسِہ
کَتھ کَتھ چھُ یہِ بَہتر زِ یہِ اچانک گژھِ، نِش کَنسَر تُہۍ تِہہ کَرٕنِ خٲطرٕ ۶ مۄنٛتظ وٲتھ نہٕ کَرِ
کیا تُہۍ چھِو رابطس منز رٲژھان
یہِ چھُ قٲبلِ قٕیمت، تاکہ تُہۍ فون بغیر نہٕ رٲژِو
تُہۍ کُنہِ خبر گژھٕن پٮ۪ٹھِ ژٕ گژھِ نِکھٕتھ نِکٕلِتھ
مےٚ خٲطرٕ نہٕ، مَگر بابَس چھِ سٲری وٕقت پَیسن ہٕنٛز ضٔروٗرت تہٕ مےٚ دِوان چھُس تِم
مےٚ چھُ بٔڈ پریشان میٚونۍ زَنِہِ ہٕنٛز اگلے مۄنٛت بچے ژٕنٛگ دِنٕچ بابت
مےٚ سفرس گژھان اوس، یِمن پٮ۪ٹھ مےٚ پنُن کُتہٕ اکھ ہفتہٕ ویٹرنری ڈاکٹرَس نِش تھاون پٲوان۔
اگر تُہۍ بہٕ ژٕ کیٚنہ اَسہِ درد، تہٕ شاید تُہۍ ڈینٹسٹَس گژھن سٕنٛزِ فکرِ دوبارٕ کَرِو۔
مےٚ چھُس کافی پرجوش، کیازِ مےٚ چھُس پنٛنِس دماغس منز یہ کاروباری خیال جوڑان۔
واہ، تُہۍ کامیٚابی حٕصٕل کَرو۔
نَوۍ نوکری ہُنٛد آفر چھِ، یِمن پٮ۪ٹھ مےٚ تِمس دوٚش نَہ دِوان۔
یہِ چھُ اکھ زبردست تجربہٕ سونٛچان۔
مےٚ منز چھِ سٲریَن کھۄتہٕ بہتریٖن۔
یہِ تُہٕنٛدِ خٲطرٕ اکھ نیک موقعہٕ سونٛچان۔
مےٚ لٹری ہُنٛد اکھ ٹکٹ ژٕٹ، تہٕ مےٚ چھُس محسوس کران زِ مےٚ جیتان۔
مےٚ چھُس تِمس کینہہ وِنگز رٕنٛوان۔
مگر مےٚ چھُس خوش زِ مےٚ اوٚس خوف مات۔
مےٚ چھُس بلکل تَمیٖس طٔریٖقٕس محسوس کران۔
مےٚ امید کران زِ تُہۍ تیار چھِو۔
میٚنٛس باسَن گووٚم اوس تقریباً پکا، مگر مےٚ نہٕ مٕلۍ تِمۍ ترقی یوس مےٚ چاہان اوس۔
مگر پہلُو اوس مےٚ سٹیٚپ ڈیڈس نِش۔
تِم چھِ نہٕ تِتھ خراب۔
ٹھیک چھُ، تُہۍ پَنٕنِس بارس منز سونٛچُن پٮ۪ٹھ۔
یِتھ خیال تھاون وٲل تہٕ مہربان کٲنٛسہِ ہٕنٛد لۄگ ملُن چھُ واریاہ سُہ۔
اوٚہ نہٕ، کیا تِمۍ کٲنٛسہِ تُہٕنٛدِ پٮ۪ٹھ رٲژھ آو؟
تِمۍ مےٚ کینٛہہ تہِ نَہ ووٚن۔
اگر أسۍ یِمنے کَم بار بار کَران رَلہٕ، تَہٕ یہِ اَکھ بَد عادت بَنی گَژھِ۔
پَرزُوٗ مےٚ اَکھ ۱۸ چَکرو وول ٹرَک ہٕنٛز نِیبر کُچلِتھ بچِتھ۔
لَگَان چھُ یہِ سلیٖپ پَیرَلَیسِس نَوم دِوان۔
کِیا یہِ اَکھ بَد سَرٕدی چھِ؟
اَز چھُ روٗد، تَمہِ مےٚ باہَر نِشِتھ نَہ ہیکان۔
مَگَر بَچٕہٕ یَلہِ بٲمار گَژھن، تَلہِ گژھِ تِم سَمبھٲلُن مُشکِل۔
اوہ، یِہِ تِمن ہٕنٛدِ خٲطرٕ واریاہ نیک چھُ۔
شایَد مےٚ گژھِ واریاہ ژوٗر، یِمن سٲریَن چیٖزن ہٕنٛز یاد تھاوٕنۍ خٲطرٕ۔
پَتہٕ یَلہِ میٚٲنِ کارَس منز مُشکِل آو، تَلہِ مےٚ واریاہ پیسہٕ خَرچ کَرُن پَژِ۔
کِیا تُہۍ وٕنِ اضافی کپٕڑٕ تِہِ سٲتھ نِوان؟
