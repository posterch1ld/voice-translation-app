تٔمس کُن لائسنس آسُن نَہ گژھ۔
آ، وُچھِو—بیاہ کَتھ نَہ وُچھان نیٹفلیٚکس تٔمس سۭتۍ، ہاہا۔
اَگر خۄدا چھُ میون سۭتۍ، بہٕ چھُس بالکل تیار۔
میٛون کامس پَر ترقی گٔے تہٕ بہٕ چھُس زبردست خوش تہٕ پُرجوش۔
یَتھ، اَسُن شہر چھُ اَتھ ننٛہ۔
سُہ تھا، مےٚ چھُ لگآن زِ مےٚ اوس فلِپ فلاپ پٲرِتھ۔
آ، بلکل—مےٚ چھُ کھیٚل یہ گیم ۶۰۰ گنٛٹہٕ۔
نَوی گاڑی مِلِتھ مےٚ گٔے حیران۔
یہ چھُ ناؤ پیٚٹھۍ تہٕ سستہٕ، تہٕ آسانی سان گژھِو تھودۍ گہرٕ نمکین میدانن منز۔
یہ چھُ پہلۍ وار زِ سُہ پھِر گٔے۔
آ، مےٚ چھُ کٔرمت اَتھ پٲٹھۍ باسَن سۭتۍ پَگاہ۔
بہٕ اوس تَتھ واریاہ دۄہ کٲم کران، تٔلہٕ یہِ گوٚو میٛون خٲطرٕ بَہت چُبُن۔
او یار، یہِ چھُ واریاہ مایوس کُن۔
تِم کَتھٕ کَہٕنہٕ نہٕ یِچھان تہٕ کَتھ کَتھ بدتمیز تہِ گژھان
اگر تُہٕنٛدِس کَنٛہہ پرایم ویڈیو چھِ، یہِ تَتھ مُفت چھِ
رِزلٹَن ہُنٛد اِنتظار کَرنہٕ سۭتۍ مےٚ واریاہ فِکِر چھِ
مےٚ چھِ یَقین زِ تُہٕنٛدِس یہِ واریاہ پسند یِیہِ
مےٚ اُمید چھِ زِ تُہٕنٛدِس رِیاستَس منز لیمَن قٲنۄن آسہِ
مےٚ چھِ یَقین زِ تُہٕنٛدِس سۭتۍ رۄہِتھ تِم زیادہ آرام محسوس کٔر
تِم نٔوۍ کار گِژِتھ سچ مُچ واریاہ ٹھیٖک کٔر
پَیسَن ہُنٛد رقم نہٕ واریاہ ٲس، مگر تَمہِ سۭتۍ تہِ سُہٕن کٔر مےٚ سۭتۍ واریاہ ناانصافی
تِم کُتھ پَیٹھ آوِتھ؟
پَتِھ ہِسٲبہٕ مےٚ کَتھ کَہٕنہٕ وفادار رۄزمُت، تہٕ مےٚ چھِ تَمہِ پٲٹھۍ فخر
یہِ ٹھیٖک ٲس زِ تُہٕنٛدِس برٛونٛہہ مدد کٔر
یہِ اَکھ اچانک دماغی مسلہٕ ٲس یَتھ سۭتۍ سُہٕ فَوراً متاثر گوو
کیا تُہۍ کَتھ کَہٕنہٕ لیکھنٕچ کوٗشش کٔرِتھ؟
تِم چھِ مےٚ سۭتۍ بَہن ہُنٛد مٲنِند
تَمہِ پَتہٕ مےٚ چھِ سڑک پار کَرنٕچ واریاہ ژۄر
تَمِس مےٚ کار کٔر خَرٛوٗش تہٕ سُہٕ رُکِتھ تہِ نہٕ
یہِ آوٕ تھوڑا پُرانہٕ گوو
کیا گٔژِتھ ؤرۍ تِم سٲری کامِک وِلن ٲس؟
مےٚ سۭتۍ مَزٕدار کَتھَن ہُنٛد بارَس منز گژھیو
مےٚ تِمِس نہٕ وُچھ زِ مےٚ چھِ بٲمی محسوس گژھان، تہٕ مےٚ چھِ خیال زِ تِمِس مےٚ پؠٹھ یہِ لگِتھ
آخرکار مےٚ ژٕ سفید جلد والۍ خوفناک جاپانی کٕس فلم دٮ۪تھ۔
تُہۍ پانہِ پٲٹھۍ فخر کَرُن چاہیِو، یہِ چھِ اکھ بہترین کامیابی۔
حالَس مےٚ واریاہ پَکاوان کران چھُس تہٕ پنٛنٮ۪ن نتیجن سۭتۍ خوش چھُس۔
مےٚ چھُس تَتھ پٲٹھۍ خوش۔
یہِ چھِ نَہ ٹھیک، تُہۍ ہٕکٕو دوبارٕ ٹیپ لٲگِتھ جوڑُن۔
مےٚ چھِ ۴ زٕ بچہٕ تہٕ یِتھ پٲٹھۍ چھِ زانان یِلہِ کَنہِ اکھ دُکھ دِوان، مےٚ چھُس تہِ تٔمۍ دُکھ محسوس کران۔
گژشتہٕ رات مےٚ چھُس حد تام قصوروار محسوس کران۔
مےٚ چھُ تِہٕ وُہٕے ٹب اَٹِکَس منز ژٕٹان۔
شاید چھُ تِمو، مگر مےٚ چھُس چاہان زِ سُہ بس چُپ روزِ تہٕ مےٚ تنگ کرُن بند کرِ۔
مےٚ چھُس تِم احساس سۭتۍ واریاہ نَفرت۔
بس یِمن غلطی ہٕنٛز سبق ژٕ۔
یہِ چھِ نَہ ٹھیک، کیا تُہۍ ہیٚکِو یہِ کُنہِ بیٚیہِ جٲیِہ کَران؟
مےٚ دِژ اکھ معجزہٕ ای آر منز—اکھ مریض دۄن منٹ مٲر گٔیو تہٕ واپس زنٛدٕ گٔیو۔
مےٚ چھُس کمپنِی ہُند ٹاپ ۵ مُلازمن منز اکھ ژٕ ٹاپ مینجمنٹ سۭتۍ سیمینارَس منز شامل گژھنہٕ خٲطرٕ چُنیومُت۔
کیا تُہۍ ہیٚکِو یہِ کرِتھ؟
اوہ نَہ، تِم چھِ واریاہ گَندٕ!
یہِ چھِ فون سپورٹ، یِمن سۭتۍ چھِ بالکل مزٕ نَہ۔
اگر مےٚ ہٕکو پٕچھِتھ، تٔمۍ کیاہ گٔیو؟
مےٚ ہٕنٛدۍ گاڑِ خٲطرٕ ریپو نوٹس آو۔
خاکی پہننہٕ خٲطرٕ چھُ یہِ دۄہ نَہ سُہ۔
ہاں، بہٕ اَز تہِ ژوراسک وَلڑ دِژھُن چاہان، مگر وُچھُن ہنٛز موقع نہٕ مِلتھ۔
یہِ مکمل کَرن پَتہٕ بہٕ ہَکلاسی ڈاکٹر بَنوُن چاہان، یُس دۄیِم دُنیاہَن مُلکن منز رَہن وٲلِن مدد کَرِ۔
بہٕ اَتھ پٲٹھۍ ژۄر دِلہٕ کہ آخر ڈاکٹرَس کَن گژھُن پٲو۔
بہٕ پنٛنِس بچَس ہٕنٛز ڈایپر بدلُن پانٛژھ مِنٹ پٲٹھۍ ٹٲل۔
مےٚ پونٛسٕس کٔمِنِٹی سٮ۪نٹرَس منز فُٹ بال خٲطرٕ ٹرٛایَل دِتھ۔
بہٕ گروسری سٹورَس تام ژٕٹ پَتھ گژھُن کوٗشش کَران اوس۔
بہٕ تٔمِس آٹھِم کٲس گرٛیجویشنَس گژھ۔
مےٚ افسوس چھُ کہ تُہۍ تِمِس یاد کَران چھِو۔
بہٕ سکولَس منز پنٛنِس ساینس پروجیکٹَس پٮ۪ٹھ واریاہ محنت کٔر۔
مےٚ نہٕ سمجھ یِوان کِہ لوٗکھ تِمِس ژٕٹۍ پٮ۪ٹھ بوسہٕ دِتھ برونٛہہ تَمہِ بابتہٕ کِتھ پٲٹھۍ نہٕ سوچان۔
اِزی تہٕ بہٕ بہترین دوست آسِکھ۔
یہِ نِنٹینڈو ہٕنٛد واریاہ کٲرکٹرن سۭتۍ اکھ لڑٲی گیم چھِ۔
تٔمۍ گیٹ کھۄل دِتھ رٲوُن۔
مےٚ اوس ونان زِ تِمِن پنٛنۍ پوری محنت کٔر تہٕ تِہ حٲصِل کٔر۔
یہِ ژٕٹہٕ دۄ طرفہٕ سڑک چھِ۔
واہ، تُہۍ ٹرِک یا ٹرٛیٹ کَرنہٕ خٲطرٕ کِنہِ وۄنۍ زِیادٕ ژٕنٛگِر نہٕ چھِو، ہا ہا۔
بہٕ کران چھُس، مگر اَز تام یہِ تَمہِ پٲٹھۍ نہٕ چھُ۔
مےٚ یقین نہٕ یِوان کہ مےٚ ہِنٛز بٲژِ دوبارٕ پنُن فون بل نہٕ بھر۔
مےٚ ہِنٛدۍ شٮ۪نٛزِر واریاہ شور کَران چھِ۔
مےٚ ہِنٛدِس بجٹِس خٲطرٕ 300 واریاہ زیادٕ اوس۔
بس آرام کر تہٕ اَگٔر کینٛہہ نیک گژھنٕچ آس تھاو۔
یِہ بند تھاوُن تہٕ زیادٕ مشکل چھُ۔
مےٚ نفسیات تہٕ فلسفَس منٛز زیادٕ دلچسپی چھُ، مگر تُہۍ سٲری چیز آزماوُن گژھِ—سٲری۔ یہِ چھِ اکھ بہترین ناول۔
وۄل، اگر تُہۍ پتہٕ نِش شادی شُدٕ نِہ آساو، یہِ مُشکل گژھِ۔
سُہ چھُ یہِ، تُہۍ حیران گژھِو؟
ٹھیک، یِمن خٲطرٕ نیک تمنّا—تُہۍ چھِ حق دار۔
مےٚ خوش چھُس زِ تُہۍ چھِ اکھ یِتھ پٲٹھۍ دوست۔
یہِ شُروٗس منٛز تھوڑا بَیہاوُن گژھِ، مگر چھِ مزٕ۔
مےٚ یقین چھُ زِ تُہۍ یِتھ جایہِ پٲٹھۍ یُس پہٕنچنٕچ خٲطرٕ واریاہ محنت کٔر۔
یہِ چھُ اکھ نیک خیال لگِتھ۔
راتھٕچ بیچ مےٚ وُچھ کینٛہہ عجیب آواز تہِ یِوان مےٚ بیسمنٹہٕ نِش۔
مےٚ ژور پگَل سٕتۍ دِسٕتھ آسہٕ۔
مےٚ چھُ نہٕ کَتھ تہِ آزمایوُن یہِ جاے پٲٹھۍ۔
اوہ، ٹھیک، مےٚ سَمجھِو—آ، یہِ چھُ اکھ مُشکل حالت۔
مےٚ نِہ تھٲوِتھ سَگٕن اکتوبر یَتھ۔
کیاہ یہِ تُہۍ جوش دِتھ؟
یہِ چھُ بلکل ٹھیک وقتس پٲٹھۍ آمتھ۔
میون مینیجر چھُ میون وقت ضایع کران یِم چیز چھِ کٲمَس سۭتۍ نِہ متعلق۔
آ، تٔمۍ ہُنٛد نِہ پتاہ یِوانٕچ منز چھُ اصل جوش—اگر تُہۍ زن آساو تہٕ براہِ نِہ تھاو۔
تٔمۍ چھِ سچٕچ پائی پسند کران۔
بہٕ چھُس رٲژِ نِش تِمِس سۭتۍ سۄنٛہِرۍ سٲپرایز دِتھ مبارکباد دِوان۔
تُہۍ کِہ مطلبہٕ خٲطرٕ تِمَن سۭتۍ مدد کَرُن چاہان؟
تِمَن ووٚن زِ تِمَن چھُ دۄیِم اُمیدوار سۭتۍ گژھن۔
سُہ چھُ پنٕنِ خاطرٕ تہٕ پنٕنِ کُنٛبٕچ خاطرٕ یُس بیٚہتر چھُ، سُہ کَران۔
ییلہٕ مےٚ لَگٕو پنٛنِ بابہٕچ پُرانہٕ ٹی شرٹ۔
ییلہٕ ییلہٕ تِم مےٚ سَزا دِوان، بہٕ گژھان آسٕ کُنِہ گَرٕچ چیز تۄڑُن۔
مےٚ چھُ اکھ دوس یُس پنٛنِ دۄنٛہِ بٲزٕن ہٕنٛز چھُ ڈھانپان۔
کِرایہٕ دارَن میون گَر گژھِتھ واریاہ گَندٕ کٔرِتھ چھوٚڑ۔
تُہۍ چھِو نہٕ اَتھ پٲٹھۍ۔
مےٚ چھُ نہٕ کَتھ کٔرِتھ یہِ پٲٹھۍ، تہٕ مےٚ چھُ نہٕ یِقین زِ بہٕ چھُس اَتھ تیار۔
سُہ چھُ گَندٕ، مگر بہٕ آسُس واریاہ تھَکْمُت۔
تِم چھُس مےٚ لٲگِتھ زِ یِہ چھُ اصلَن بیٚہتر پٲٹھۍ گژھن۔
بس خوش روز زِ تُہٕنٛدِس کٕلاسٕچ لگ بگ سٲریَن چھُ نہٕ اَتھ یاد۔
بہٕ کٔر، کیازِ تِمَن آسِ لگ بھگ مےٚ سۭتۍ ٹَکر دِتھ مےٚ کُڈُن۔
یِہ ریسٹورانٹ یَتھ بہٕ چھُس بچپنہٕ نِش گژھان، چھُ بند گژھان۔
میون کُنٛب چھُ اَز میانہِ گَرِ کُنٛہہ لَمبِ دورٕ کٔرِتھ گژھان۔
مےٚ نزدٕ چھُ اکھ جاے یَتھ وِنگ چھِ مِلان۔
بہٕ آسُس تِمِس پیٹھ واریاہ حَسد کَران۔
بہٕ گٔیوس اَز میل باکس کُن تہٕ مےٚ مِلون ۵ اَپٕروول لیٚٹر میڈیکل سکولہٕ کِنۍ۔
کُنہِ کُنہِ تِمن منز بَگ گژھُن چھُ نَہ تِتھ عام۔
مےٚ چھُس جانان زِ پالتو جانور چھِ کُٹمبٕچ برونہہ۔
مےٚ گٔژھ فاینل دِتھ یہِ جانان زِ مےٚ چھُس فیل گژھان، تہٕ سُہ اوس سۄتھ نَروس وریکِنگ۔
مےٚ کٔر اِک دۄستس سۄن یِم ویک اینڈس منز ژوٗٹ۔
تُہٕنٛدِ ساس برونہہ۔
مےٚ ہیٚچھِ دِژھُن پنُن پسندیدہ بینٛڈ کورن پٮ۪ٹھ کھیٚلان۔
مےٚ تہِ آسَہٕ—مُبارک۔
کاہہ پلان نَہ آسنس پیٹھ چھُس پنُن نصیب دار محسوس کران۔
مٮ۪ٚون نٔو پورش چھِ سٲری قٕسمٕچ خصوصیات۔
تِم کتھ کَتھِ عظیم اوس، یِہ یاد دِلاونہٕ خٲطرٕ مےٚ چھُس یہِ واریاہ پہنٛان پسند کران۔
تِم چھِ واریاہ جَستجو کَرُن والہٕ جاندار۔
مےٚ چھُس اُمید کران زِ تُہۍ سٲری پنٛنہِ مقصد پورٕ کٔرِتھ تِمَن پٮ۪ٹھ تہِ گژھو۔
سُہ اوس کُنہِ معجزٕچ گواہ بنُن برونہہ۔
مگر بدقسمتی سٕتۍ گرمیٚن منز تہِ مےٚ چھُس کٲم پٮ۪ٹھ آسُن۔
مےٚ چھُس تِمَن سۭتۍ تہِ مزٕ کران، مگر اصلن جتنا نَہ۔
یِم خبر مِلنہٕ پیٹھ تُہۍ چھِ بیٚیہِ وٲرِیاہ مایوس گٔمتھ۔
پنُن کُتہٕ خون وٲلِتھ دِژھِتھ مےٚ سَہمس، مگر خوش قسمتی سٕتۍ سُہ نَہ اوس واریاہ خراب۔
سُہٕنٛدِ یِہ چھُ واریاہ مِٹھی۔
سُہٕ چھُ مدد حٲصِل کرنہٕ خٲطرٕ دۄر، تہٕ تِمَن چھِ تِمِچ ضٔروٗرت، یِمۍ خٲطرٕ مےٚ چھُس یِہ مُشکل جھیلُن۔
کیا سُہٕن کٔر تُہہِ مدد پَزٕنہٕ وَخت یاد کرنہٕ منز؟
مےٚ کُترٕ چھِ بھونٛکُن بند نَہ کَران تہٕ بہٕ بالکل پاگل گژھان۔
مےٚ سۄچمتھ کہِ یہِ ژھڑُن میٛٲنۍ ہٕڈٕکۍ کُٹِتھ کَڈان۔
بہتھ دۄہن پَتھ کَنۍ دۄہ دۄہ پٮ۪ٹھ مےٚ کُٹُمبر مےٚ ملٕن آو۔
اَز مےٚ موبایل فون گژھِ گُم۔
لوٗگ چھِ ونان وقت چھِ سارٕ زخم ٹھیک کَران، اُمید چھِ تُہندِ معاملہس منٛز تہِ یِیہِ تَمہِ لَگۍ۔
بہٕ تہِ تَمیس لَگۍ کَران، مگر اَزکَل چھِ ژٕٹے لوٗکھ تَمیس نِش دِژھان۔
مےٚ چھِ یِمن متعلق زٕور خوشی۔
مےٚ کٔر محنت سٕتۍ اَپٕن فاینل خٲطرٕ مُطالعہ۔
آ، مگر دۄہہِ پٮ۪ٹھ نَہ۔
کاش بہٕ پَران کِرایِچ مکانس منٛز واپس گژھِ ہیکہٕ۔
تازٕ کِنہہ دۄہ آس سُہ سۄنٛہ، تِمن مےٚ فیٚصلہ کٔر کٲم پٮ۪ٹھ پیٚٹھ گژھنُک۔
مےٚ سۄچمتھ زِ شاید بہٕ فیل گژھان، مگر مےٚ پاس کٔر سٲری کلاس۔
سُہ چھِ سۄنٛہ، لَگِ چھِ سُہ نیک لوٗکن ہٕنز نگرٲنی منٛز چھِ۔
سٲرنی ہٕنز لزیز کھٲنہٕ کھاون تہٕ تحفہٕ بدل کران دِتھ مےٚ زٕور سۄنٛہ لَگ۔
یِلہِ مےٚ مٲوج آو مےٚ نوِ اپارٹمنٹس منٛز۔
کینہہ دۄہ پٮ۪ٹھ سۄن مےٚ بیٚچس گژھان، کیازِ اَز چھُس بہٕ ہٕنۍ گرمی منٛز چَنگٕر فِٹ۔
سُہ چھِ تَمیس کِنہٕ کَران؟
نَہ، آسہِ گژھِ زٕور سٕتۍ بٮ۪یہِ چیٖزن ہٕنٛز مُقٲبلہٕ کٔرِتھ۔
کیا تُہۍ کالج کٔر پٲرِو؟
سُہ چھِ پنٕنِہٕ روزمرہ روٗٹن منٛز زٕور محنت کٔرمٕژ۔
جِلہٕ تُہٕنٛد بچہٕ تُہۍ فخر تہٕ خوشی دِوان، تِہٕنٛدۍ احساسہٕ کھۄتہٕ بہتر احساس کِنہِ چھُ نہٕ۔
مےٚ چھُس یژھان تِمَن پیٚٹھ چیٖخِتھ ونان زِ تِم چھِ بے پرواہ۔
مےٚ چھُس اَز تام کَسہِ نَہ ونان، تُہۍ چھِو سُہِ پٲٹھۍ یُس مےٚ یہِ سۄال وُچھ۔
مےٚ ہَمسریٚن سُہ تھٲوِتھ بَاہَر کٔر۔
یِتھ کَتھ تَکلیف دِتھ پَتہٕ یہِ چھُ بَہٕت جلدی، تہٕ مےٚ چھُ نہٕ یژھان اَز کِنہِ واریاہ پریشٲنی سۭتۍ مُقابلہٕ کَرُن۔
مےٚ چھِ مِژ پسندیدہ شو ہُنٛد ٹِکَٹ جِتھ۔
مےٚ چھُس گمان کَران زِ تِم چھِ بَہٕت خۄش۔
کیا تُہۍ کُنہِ پیشہٕ وَر ٹیمَس منز کھیٚلوان؟
مےٚ چھُس بَہٕت مَژھ دِل زِ تُہۍ یِتھ پٲٹھۍ مُشکل وَقتَس منز گژھِوان۔
مےٚ لَگِو زِ گۄو مےٚ دۄہٕ سالہٕ کُنہِ۔
اوہ، مےٚ چھُس اَز آن لاین اَکھ ژٲنڈان، مگر مٮ۪ون پنُن راز نُسخہٕ چھُ کینہہ سَنتری ہُنٛد چھِلکٕ ژٲرُن۔
یِمَن منز تِم بَاتھ‌رومَس منز آسِہ، مےٚ چھُس اصل منز صوفہٕ کینہہ ژٲرِتھ۔
مےٚ چھُس کِتھ پٲٹھۍ بےوقوف!
یِمَن کلاسن منز تِمَس چھُ شوق۔
یہِ شو چھُ لۄکُٹ، یِمن سۭتۍ مےٚ گژھِ بَہٕت نِژدیک۔
یہِ چھُ بَہٕت کھٲنہٕ، اُمید چھِ تُہۍ سٲری کھٲتھ ہیکِو۔
اَزکَل مےٚ چھُس مُستَقبِل ہُنٛد بَہٕت اُمید سۭتۍ اِنتظار کَران۔
کیازِ سُہ لمحہٕ چھُ اَکھ تحفہٕ تہٕ اُمیدُک آخری کَنار۔
اَز مےٚ ہُنٛد روم میٹَن فِرِج منز مٮ۪ون نَوم لَگٲوتھ تھٲوِتھ کھٲنہٕ نیٚتھ۔
مٮ۪ون پَپِین پنٛنِس ٹرینِنگ کلاسن منز سٲریَن کھۄتہٕ بَرونٛہہ رٔٹِتھ کامیٲبی حٲصِل کٔر۔
کَل المارِی صاف کَران پیٹھ میٚون ہَتھہٕ نِش اَکھ پُرانہٕ چایِچ کَپ گِرِتھ تہٕ ٹُٹِتھ۔
تِمَن دۄپہرِچ بَچَن کُن أوسُنک طریٖقہٕ اَسہِ بدلِتھ کٔر زِ یہِ واریاہ زِیادٕ اُلجھن وارو بَنِتھ۔
میون نٔوۍ بِلّی کَونٹَر پٮ۪ٹھ تھٲوِتھ پلیٹ کَران چھُ نَہ بند۔
مےٚن ژٔ ہُوٚتھ پریشان یُس میون والدین ونان آس زِ أسۍ گَر بدل کران، أسۍ فلوریڈا تام گٔژھ۔
یہِ کِس قِسمُک ٹرک چھُ؟
یہِ تُہۍ ہُند کریڈٹ بَنانٕچ مدد تہِ کَرِ۔
بہٕ چِکَن نَہ کھاوان، مگر برِسکِٹ گژھِ آس میٚون واریاہ پسند۔
بہٕ ژٔ جاگ مےٚن اَکھ اَکھ سُوزان آس۔
بہٕ تِمِس اِنٹرویوَس گٔژھ یِمن ژٕ جانان آس زِ مےٚ یہِ نوکری مِلِ۔
مےٚ تِمِس پٮ۪ٹھ رشک آس۔
کُنہِ خیال چھُ زِ یہِ کَتھ کَڑا آس؟
یہِ چھُ اَکھ واریاہ نیک اِشارہٕ۔
بہٕ ۱۰ گیلن بین تہٕ جیریز کھاون تہٕ پُرانہٕ قسط دِکھاون سۭتۍ آپٕنہٕ سَمبھالان۔
مےٚ اوس یژھان زِ سۭتۍ پٲٹھۍ مےٚ تِم پسند چھُ، یِمن پٮ۪ٹھ سۭتۍ۔
میٚون دۄد یُس طریٖقہٕ سِکھمٕژ، تَتھ پٮ۪ٹھ چھُس مےٚ ؤرۍ یِم گژھان تیل نَہ بدلٲوتھ۔
اَخٔر کٔژ کِتھ کٔر؟
تٔمِس چھُ لگ بَگ ۱۰ وُہَر۔
بہٕ گروسری سٹور نِش اَکھ ڈبہٕ ژٕران، مگر تِم اَکھ دۄہ تہِ نَہ ژٔلان۔
میٚون مٲلۍ ؤنٛدِ کالجُک پٲٹھۍ ؤرۍ ہُند خرچ دِتھ۔
دُنیاہَس منز دیوانہٕ لوٗکن ہُند تعداد چھُ ڈرٲون۔
مےٚ کینٛہہ وقت کٔر۔
سُہ کرایہ چھِ گژھان، مگر کانٛہہ تلافی کٔرٕنۍ نہٕ ژھانٛگ۔
بہٕ پنُن پالتو جانور گژھاون اوس، تہٕ فٹ پاتھس پیٹھ کینٛہہ گندی مُرتھ جانور ڈٕکھ۔
بہٕ ترٛاوِتھ گٔژھم مُرتھ۔
یہِ چھِ زٔبردست ٹینشن—تُہۍ کِتھ پٲٹھۍ کرِو؟
مےٚ چھِ کٲمَس پیٹھ اکھ پریزنٹیشن، تہٕ مےٚ چھِ پَک یقین زِ بہٕ زبردست کرٕ۔
تہِ ڈٕکن چھِ واریاہ گندی۔
وزن کم کرُن چھِ آسان نہٕ۔
مےٚ کٲمَس پیٹھ بوٚڑ پروموشن نہٕ میٚل، یمِس خٲطرٕ بہٕ واریاہ محنت کٔرمُت اوس۔
باقی انٹرویو گژھن۔
مےٚ پَک کٔر زِ بہٕ صحنس منز ڈھیلہٕ چیزٕ ڈٕکھی۔
تہِ کٔرٕنۍ خٲطرٕ واریاہ جٔرٛأت چھِ لازِم۔
کینہہ بہترین رومانٹک تجربہ چھِ سکول ڈانسَن منز۔
تُہۍ خٲطرٕ نیک تمنّا، مگر لاٹری جیتُن چھِ واریاہ کم امکان۔
شُکریہ۔ تُہۍ کالجس منز چھِو؟
مےٚ پرسُن دۄہ اکھ فلم ڈٕکھ، مگر سُہ اوس نہٕ تِتھ پٲٹھۍ یُس مےٚ اُمید اوس۔
یہِ گژھِ اکھ گۄڈ چھُٹی ہدیہ۔
مےٚ چھِ آس زِ تُہۍ کانٛہہ تھراپی ژھانٛگِو۔
یہِ چیزٕ جلدی گژھان، تہٕ یہِ احساس گژھِ غایب۔
سُہ صرفِ اکھ عام پیڈل بایسکل اوس۔
ظاہر چھُ سُہ سمجھنہٕ کہ یہ چاونہٕ ہنٛز کھٲلُن چیز چھِ۔
گژھِت ہفتہٕ مےٚ کٔر دعوت أک پارٹی پٮ۪ٹھ أکۍ بٔڑِ مشکوک علاقس منٛز۔
مےٚ گژھِت ہفتہٕ لٹری ٹکٹ کٔرِد، یہِ سوچان کہ مےٚ ہٕنٛدِس ہفتس منٛز کام نہٕ کرُن پَران۔
حقیقتس منٛز، مےٚ ہٕنٛدِس لۄکُٹ برون کٔر مےٚ خٲطرٕ تَمہِٕ کٲم۔
اگر سٲری چیز ٹھیک گٔی، چھُس مےٚ اندازٕ کہ سٲری لۄکُٹ فکریہ تہِ ٹھیک گٔی۔
مےٚ وونہٕ کُنہِ پٮ۪ٹھ تہِ نہٕ گژھان۔
خاندان تہٕ دوستن ہنٛز قدر کرُن، تِمن عام سمجھِتھ نہٕ گژھِ۔
پَگاہ ہفتہٕ چھُس آخرکار چھُٹِی پٮ۪ٹھ گژھان۔
جمعہٕ دۄہ چھُس مےٚ مچھلی گژھِتھ۔
نہٕ بابا، یہ چھُ کافی شدید لگن—تُہۍ کٔرِتھ چھُ واقعی؟
مےٚ خیال چھُ سڑکۍ ہٕنٛز بَتھ۔
مےٚ چھُس وُنہِ یِہ کَران ییلہِ مےٚ مِلان موقع۔
ییلہِ مےٚ ہٕنٛز وار یِہ، کِیاہ چھُس مےٚ تِتھ پٲٹھۍ پُرسکون گژھِتھ؟
مگر تُہۍ گژھِو لازمی بہت بیمار، مےٚ چھُ یقین زِ سٲری سَمجھِو۔
مےٚ مِلان پنٛنٮ۪ن پُرانن دوستن سٲتۍ تہٕ سٲری رات شراب پیٖتھ۔
یہِ چھُ تِتھ مشکل نہٕ یِتھ مےٚ سونچمُتھ آسہِ۔
آ، مےٚ مِلۍ جاب ہنٛز آفر؛ وُنہِ چھُس بیک گراؤنڈ چیک واپس یِنہٕ ہنٛز انتظار کَران۔
اگر ٲسِ پٲٹھۍ رہن وٲلۍ مےٚ ناپسند کٔرِ، کیاہ گژھِ؟
سُنتھ چھُ سُہ أکۍ زبردست سُہُن کُتُر لگن۔
اَس چھِ سٲری ہفتہٕ یژھان مشق کران۔
یہِ صرف تمہِ دۄیم مقابلہٕ آس۔
تِم شامہِ اسہِ آخر ڈزنی منز گژھ، تِم گوٚو بہت حیران۔
جٔہ کھادٕ، سجاوٹ تہِ یِمِس قٕسم کینٛہہ۔
شاید تٔمۍ متعلق تہِ تٔمۍ ہٮ۪و یِتھ پٲٹھۍ خیال کران۔
کیا تۄہہِ واقعی تُل یہِ، یا سُہ اوس یِمِس پٮ۪ٹھ پٲٹھۍ بنا پٲٹھۍ پُچھان؟
مےٚ گولڈ فِش گوٚو اَز سُہ صبح مران۔
کیا تۄہہِ یِم سٲری کٔرِتھ ہٮ۪کِو؟
شادی شُدٕ مَرد آسِتھ، کینہہ دۄہ اوس مےٚ کٲم کَرن وٲلۍ اَکھ ساتھی مےٚ پٮ۪ٹھ فِدا کَران۔
سُہ دُکھی کٔرِتھ ہٮ۪کِہ، مگر خوش قسمتی چھُ تۄہہِ گژھِتھ ہٮ۪کِو تِمَن مُلاقات کٔرِتھ۔
مےٚ ہُنے ہُنے مُلکَس منز اَکھ بٔڑ جایہِ بدلی، تہِ مےٚ چھُ نہٕ پتاہ یہِ صحیح فیصلہٕ اوس یا نہٕ۔
مےٚ سمجٔھان چھُ کہ چھُٹۍ چھِ دِلچسپ، تہِ تقریباً آوُن چھِ۔
اوہ ڈیم، پتہٕ کیٛاہ گژھ؟
اَکھ گٲشَن مےٚ پٮ۪ٹھ کٹ مار۔
تَمہِ کٔرِتھ مےٚ چیٚخ تہِ دۄڑِتھ گٔے۔
ہاں، تَمہِ کٔرِتھ مےٚ بیسمنٹ خٲطرٕ طوفانُک ایمرجنسی کِٹ تیار کٔرِتھ چھُ۔
سُہ عام طور کَتھ عمرِ منز گژھان چھُ؟
مےٚ اَکھ دوست چھُ ہَر جاے پنُن کٲٹھ کٲٹھ کَران۔
تِمۍ یِم کٲم کٔرِتھ چھُ حٲصِل کٔرمُت، تَمہِ پٮ۪ٹھ چھُ مےٚ بٔڑ فخر۔
سڑکُک کَڈِس پٮ۪ٹھ
ییلہِ مےٚ پی سی پٮ۪ٹھ کینہہ اَہم کٲم کَران چھُس، انٹرنیٹ سروس بند گژھن چھُ بے آرام کَران۔
یہِ چھُ اکھ گژھان مقصد
مےٚ پننِس شَوہرَس سُوٚ یہِ دور کَرٕنٕچ کٔرٕنۍ تاکہ یہِ ژٕ دروازَس نِش نَہ آسِہ
یہِ چھُ کمال، کُنٕن کٔرِو یہِ تُہۍ خٲطرٕ خٔریٖد
کال مےٚ پنٛنِہ پُرانٕن تصویرن ہٕند نظارہ کران اوسُس تہٕ تِمن کٔرٕ بہت یادٕ تازٕ
تُہۍ گژھِو ضروٗر اکھ نِشٕٹ کمپنی مَنٛز کٲم کٔرٕنۍ
کال مےٚ اکھ نَوُ کتُر بچہٕ گژھِو حٲصِل
آ، یہِ تہِ اوسُس اکھ واریاہ موقع
مےٚ ژوٚنٛہہ کٔرِہِو پنٛنِس بواے فرٛنڈَس خٲطرٕ ڈِنر، پَہلی بار
تُہۍ کُنٕن دُکانن مَنٛز گژھان اوسِو
مےٚ کُنہِس پٮ۪ٹھ کَتھ نَہ گژھِو، مگر مےٚ یہِ آزماوِتھ دٮ۪کھِو
یہِ چھُ شایَد سَہ زنٛگ نِش بٔڈ انتخاب
مےٚ اوس اکھ موقعہِ پیسہٕ کمانُک، مگر میون فون خراب گٔیو
مگر مےٚ کٔر سُہ تِمن مَنٛز داخِل تاکہ تَمہِ کُنہِ ڈِسپلِن تہٕ ڈھانٛچہٕ آسِہ
بالکل ۲ مٲہنٕن پَتہٕ تِم گوٚو ونان، ‘تہٕ ہاں’
مےٚ اوسُس اوبَر ایٹس پٮ۪ٹھ کھٲنہٕ آرڈر کٔرمت، مگر یہِ کَتھ نَہ آو
یِم ہٕنٛد ونان، شراب چھُ حل
آس چھُ یہِ واریاہ خراب نَہ اوس
تِمۍ چھِ ابھیٚ وٕنٛہِ وٕنٛہِ نِکاح گومُت
مےٚ گٔیو پنٛنِس سکوٗلِچٕن وارِیاہ لوٚگٕن سٕتۍ
مےٚ نَہ بوٚز نمبر ۴
بہٕ پَتہٕ کَتہِ تہِ سُہ کَرانہٕ۔
بہٕ گوٚوٕن پہٕلی بار سکای ڈایؤِنگ کرنہٕ، تہٕ مےٚ نہٕ چھُ پَتہٕ کَتھ چھُس مےٚ اِنتظار کرُن۔
بس نہاویو یار۔
یِم کالیجَس سکارلرشِپ خٲطرٕ بہٕ واریاہ مانہٕ سٲتۍ مقابلہٕ کَران اوسُس، سُہ مےٚ مِژھ۔
ژھٲنۍ بَچن ہٕنٛز گَرِ یہِ چھُ لازمی۔
سُہ کِس قِسمُک جاب اوس؟
بٲلُو تہٕ ٹرک تہٕ دۄہن منز یِوان چیٖز۔
بہٕ سٲریوَقت کُنہِ خاص چیٖز خٲطرٕ دُکانس گژھان، مگر آخرس منز فالتو سامان ژٕٹھان تہٕ ضروری چیٖز بُرٕ چھِس۔
میڈن چھُ اَکھ مزٕدار گیم، مےٚ ہَسُب مےٚ طرف دھیان دِنہٕ بجاے سُہ واریاہ کھیلان۔
کیا چھِ تُہۍ سٕنٛد خیال زِ تِم راز وُچھِتھ؟
اَز مےٚ دِژ اَکھ ژٕنٛگ اَکھ پِلِس پٮ۪ٹھ چیٖخ کَران۔
تہٕ سُہ بارٕ کَڈُن چھُ مُشکِل۔
آ بہٕ چھُس نَہٕ ٹھیٖک، تہٕ گژھِ رات اوسُس خراب—پہٕلی گھونٹَس منز مےٚ گژھِ متلی۔
بہٕ ونان اوسُس تہٕ میون ساتھی سٲریوَقت مےٚ روکِتھ۔
گژھِ رات بہٕ نیٹفِلِکس پؠٹھ لُتھر ہُند سیزن ۲ کُتم۔
مےٚ چھُ نَہٕ صبر زِ اگلی پےٚ چیکَس منز میون نَو اضافہٕ کتھ دِس۔
مےٚ چھُس لگٲن زِ تِم پنٛنِس کٲمَس منز نَہٕ چھِ ٹھیٖک۔
میون بورڈ میٹنگ یِم خٲطرٕ بہٕ اوسُس تیار کَران، سُہ آخری وۄقتَس منز مُلتوی گٔی۔
کینہہ اوس سچّی مزٕدار۔
مےٚ چھُ یقین زِ گژھِم کینہہ وارِس منز کینہہ نَہ کینہہ گژھِتھ آسُن ٹھیٖک۔
ہاں، ٹریلر وُچھِتھ یہ زبردست لَگِہ، بہٕ یہ کَتھ کَتھ کھیٚلِہ۔
جہاز منز اوس اَسہٕ بُو یِوان ژۄں سٕتۍ یِم کَتھ مہینٛن پیٚٹھ صاف نہٕ کٔرۍ گٔے۔
بہٕ سُہِ سٕتۍ محبت کَران اوسُس تہٕ مےٚ سُہ یاد یِوان۔
شاید بہٕ آوٕ کُنہِ اکھ بچاون۔
مےٚ والدینن سٕتۍ نشہ کٔرِتھ گژھُن سُہل لَگِتھ۔
مےٚ یاد یِوان پُرانن وقتن۔
اَسہِ کٔرِ کٔرِ بٔڈِ مشق تہٕ مےٚ محسوس گژھِ زِ مےٚ پورٕ پورٕ آسہٕ۔
مےٚ خۄشی لَگِہ زِ تۄہہِ کٔر سُہل وقت گُزار، تہٕ تِمَن لٔب بچہٕ؛ ویسے یہِ غلطی آس۔
سُہِ مےٚ سٕتۍ رَتھ منز گژھن ہٕنٛد درخواست کٔر۔
سُہِ رات بہٕ بٔڈِ پریشان اوسُس تہٕ اکلٕے کٔر سٲری ڈبہٕ آئس کریم کھٲت۔
بہٕ ابھی ابھی دِتھ پنٛنِ فائنل امتحان۔
مےٚ سۭتۍ، اگر تھوڑا سُہ دیر گژھن ہٕنٛد امکان آسہٕ تہٕ بہٕ بٔڈِ پریشان گژھان۔
بہٕ پنٛنِ ویٹرَس ہٕنٛز ٹِپ دِتھ بُرٕن۔
یِلہِ لیبرون کَیٚوسَن سٕتۍ ساین کٔر، سُہ اوس بٔڈِ متاثر کُن۔
اگر قبول گژھِ تہٕ بہٕ جنوری منز شروع کَرِہ۔
تِمَن کٔرِم سَدا مےٚ خٲطرٕ یِلہِ کینٛہہ سُہل۔
مےٚ نفرَت چھِ یِلہِ لوگ سۭتۍ یہِ خیال کَران زِ تِم تۄہہِ پارٹنرس سٕتۍ کھُلہٕ کھُلہٕ فلرٹ کٔرِتھ ہٲکَن۔
شاید تۄہہِ سُہِ خٲطرٕ کیک کٔنی تہٕ سُہِ سۭتۍ معافی طلب کٔرِنی۔
بہٕ پنٛنِ بینک سٕتۍ فون پٮ۪ٹھ تِمَن ہٕنٛد غلطی سۭتۍ لَگِتھ کَنہِ اوورڈرٛافٹ فیسَن ہٕنٛدِس بارے منز گَژھان اوسُس۔
زیادٕ تر روز، یا کم از کم ہفتہٕ ہَندٕ اکھ وٲر
تِم دۄزَس پؠٹھ نہٕ یِوان
تَتھ گژھُن چھُ مےٚ پہلۍ وٲر
ہاں، تِمن خٲطرٕ چھُ یہِ بلکل عام
آخرکار چھُس بہٕ اکھ نِو سُہون اپارٹمنٹ گژھان برداشت کٔرتھ
یہِ ہیٚکِتھ مےٚ دۄکھ لاگ، کیاہ گژھ؟
مےٚ چھُس حَسَدس منز ژٔلِتھ
مےٚ سٕتۍ کٲم کَرِنس مےٚ پریزنٹیشن ہُند خیال چور کٔرِتھ سُہ پنُن چھُ وَنان، مےٚ چھُس یقین نہٕ یِوان
اَسہِ کٔر سٕتھ کلاینٹ حٲصِل
اَسہِ ہُند مُلک چھُ سیاسی جماعتن ہٕنٛدۍ اُکساونہٕ سۭتۍ سخت نسلی بَے چینی منز
مےٚ چھُس وُنٛہۍ وُنٛہۍ سگریٹ ترٛاوٕمُت
مےٚ ہٕنٛزۍ ہمسایہٕن سِڑِیَن پؠٹھ ڈوریٹوس ہُند اکھ تھیلہٕ ضایع کٔرِتھ تَتھ یِتھٕے چھوٚڑ
مےٚ اوسِ گۄڑٕ طِبی مسلہٕ، تَمہِ پؠٹھ گٔیُس ڈاکٹرِس نِزِک
نَہ، سُہ اوسِ اکھ پِک اَپ گیم، مگر یِمَن شاٹ مار سُہ چھُ کالج باسکٹ بال کھیلان
سُہ نیو یارک یانکیز خٲطرٕ کھیلان
ہاں، کینہہ وَرۍ پٮ۪ٹھ مےٚ ماجہِ کٔر یہِ مےٚ خٲطرٕ
ہاں، کَتھ کَتھ شپنگ دوران سامان چھُ ٹُٹان
حالے منز گٔے مےٚ اکھ جوڑ ترٛٲوِتھ چھوٚڑمٕتۍ بٲلۍ
مےٚ کُنِس کینہہ اوس وُنان یِم مےٚ اوس نہٕ ژٕٹ تِم دۄبارٕ وُنان
شاید گٔیہٕ ہٕلکٕہ ہٕلکٕہ تِمَن یہِ خیال سۭتۍ واقف کٔرتھ تہٕ تِم الگ الگ کمرٕن منز تھاوِتھ
کیا تِمِس میٚنی والِی سٕیتھ گٲوِتھ تہٕ نٲچِتھ؟
تہٕ چھُ یہِ سٕنِتھ بٔڈ خراب۔
مےٚ کَتھ تہِ اتھ پٲٹھۍ خۄش نَہ آسٕمُت۔
مےٚ چھُ سِنگل رٕہِتھ سٕیتھ سٕیتھ بٔڈ تَنگ۔
آج مےٚ کٲمَس پٮ۪ٹھ مِرٕچ پَکٲونِچ مُقابلہ جیتِتھ پہلِس نمبرس پٲٹھۍ آو۔
نَہ، مےٚ چھُس اَکھ نیک گٲمُت۔
مےٚ سٲری ہفتہٕ پٲٹھۍ چھُ پَرٕمُت تہٕ مےٚ کَتھ تہِ اتھ پٲٹھۍ تیار نَہ آسٕمُت۔
تُہٕنٛدِس پُترس یِہِ بٔڈ پسند یِیہِ۔
خاص کرِتھ، یِمِکہِ تُہٕنٛز دۄہتر چھِ تندرُست تہٕ لاتھ ژٕلٕنۍ۔
آو مےٚ چھُس تٔمِس پٮ۪ٹھ واریاہ زیادٕ بھروسہٕ کَران۔
سُہ چھِ ہای سکول گژھان تہٕ پۄرٕ وقت کٲم کَران۔
مےٚ ہُوٚس یِتھۍ بیٚٹھِتھ پُرانٕ کُٹمٕچ فوٹو وُچھان۔
تٔمِس نَوٕن اُستادَن کَریو خبر یِہِ کِہ تٔمِس خٲطرٕ کیاہ چھُ کٲم کَران۔
کیاہ فلایٹ اوس لمب؟
مےٚ چھُس تَمہِ خٲطرٕ بٔڈ پریشان، یِمِکہِ مےٚ چھُ نَہ یقین۔
آ، تَمہِ سٕیتھ مےٚ ہُوٚس بیمار، تہٕ بٔڈ دُکھی۔
مےٚ سۭتۍ تہِ، مےٚ چھُ نَہ صبر گژھان سٲری ویک اینڈ آرام کَرنٕچ۔
سُہٕ ہُوٚس اَکھ بیگل مِکس ژٕٹ یُس جیک ناوٕ ہُوٚس۔
اوہ، سمجھے۔ دوٚیمہِ وارٕ کٔرِو پَرٕتھ اٮ۪کسپایری ڈیٹ وُچھُن۔
مےٚ تہِ چھُس امٕید کَران، نیک تمنائیں۔
تُہۍ تہِ شاید وٕنٛدٕر بٔڑ گٔیو
مےٚ سمجھ چھُ سُہ ییٚلہِ کینہہ وٕمِتھ ہَنٛد بُو یوان یا وٕمِتھ دِکھان، مےٚ تہِ وٕمِتھ کٔرِتھ دِوان۔
مےٚ کِنہہ گژھِتھ نَہ کروز پٮ۪ٹھ؛ مےٚ چھُ کھُلے سمُندرٕچ بٔڈ ڈر۔
ییٚلہِ مےٚ چھُ سٲبقہِ تِہِ جماعتھ دۄہِ لٹہٕ پڑھاونہٕ، مدد گژھان۔
تُہۍ چھُو احتیاط کرُن گژھان۔
تُہۍ عام طور کِہ گیم کھیٚلوان؟
مےٚ یہِ تہِ سوچان اوسُس زِ مےٚ کِتھ پٮ۪ٹھ پنُن مارٹگج ادا کرُن۔
یونان منٛز چھُس مےٚ دۄہ ہفتن ہُند چھُٹۍ یوان، یتھ خٲطرٕ مےٚ چھُس کینہہ عرصہ پیٚٹھ انتظار کران۔
آ، اَکھ وٕڈ پُرانہِ گَرِ منٛز اکیٛلہِ رۄنُک چھُ اکثر اکیٛلہِ نَہ رۄنہِ کھۄتہٕ ژھٲستِر ڈرٲون۔
تِمَنٛز آسَن واریاہ تصویر یِمن ہُنٛد مےٚ نَہ اوس پَتہٕ۔
یہِ چھُ واریاہ دُکھ دِوان، سُتھ مےٚ چھُ افسوس۔
تِم محفوظ طریقس سۭتۍ دۄیمِ پٲٹھ گٔے۔
آخرِ کِہ برانڈ ژٕ تۄہہِ اختیار کٔر؟
مےٚ نَہ وٕنٛدٕر چھُس یِمِتھ کانٛہہ دِتھ۔
تِم پروموشن خٲطرٕ چھُس مےٚ ژٔل سٲلن پیٚٹھ انتظار کران۔
مےٚ ہُند ٹیچرٕ مےٚ دِتھ زِ مےٚ ٹیسٹ منٛز نقل کران اوسُس۔
مےٚ چھُ یاد زِ بالپَن منٛز اوسُس گَر گَر کھیٚلوان۔
ژھَٹ، صفٲی ہُنٛد کَتھ تہِ ژھٕٹ، نَہ تَہٕ مےٚ اوسُس واریاہ پریشان گژھِتھ۔
مےٚ چھُس یِمِتھ بولچالِ زبانِ سۭتۍ نَہ واقف۔
اَکھ دۄہ مےٚ ہٕکو نَہ بند کرِتھ سوچُن پنٛنِس جُدا گٔمٕتۍ خاندانِ ہٕنٛد مُتعلِق؛ مےٚ اوس تِمن ہُند یاد یوان۔
ہاں، تَتھ کَنہہ بَہت قابل لوٗکھ سکیٹ کران۔
مےٚ وٕنٛنہٕ کہ شاید سُہ بہتر محسوس کَرِہ یِم اگر مےٚ تَمہِ نہٕوٕن۔
یِہِ خٲطرٕ صرف بٔڈ پریکٹس ضروٗری چھِ، مگر تُہۍ تَتھ پَہنٛچِو۔
مےٚ کوٗشِش کران چھُس کہ گایڈن ہٕنٛز پرٛہیز کَرٕنۍ۔
مےٚ سُہ چھُس کَتھ کٔرِتھ کَہِتھ کہ ژونٛگس منزِ میچُک نَتیٖجہ مےٚ چُھ اَصٕل۔
مےٚ چھُس یقین کہ سُہ اوس تِہِ داغ صاف کرنہٕ کَنۍ کٲم آوُت۔
یہِ حالت ہرِ دوستہٕ ہُنٛد رِشتہٕس منز گٔیہ، تِہِ وجہہ سۭتۍ أس کُٹمٕچ اَکھ رُکن سۭتۍ رِشتہٕس منز۔
ییلہِ مےٚ میتھ ٹیسٹُک مارک واپس مِل۔
مےٚ تَمِس اَکھ لَٹہٕ مُلاقٲت کٔر ییلہِ مےٚ اوسُس پٲٹھۍ چَلان۔
مےٚ کرٕ اگلی سیلُک اِنتظار۔
اَکھ لَٹہٕ ہایِسکولس منز مےٚ اوس اَچانک اَکھ اِنٲم مِلان۔
اَخِر اوس اَکھ مُستَقِل نوکری تِہِ ہفتہٕ وارِچ کٲم نہٕ۔
مےٚ چھُس پنٛنِہ خۄد ضابطہٕ سۭتۍ بَہت مُطمَئِن۔
یِہِ سۭتۍ تُہۍ پنٛنہِ خۄد کَم اَہَم محسوس کٔرِو۔
ہریکینُک موسم چھُ بلکل نزدیٖک، تِہِ سۭتۍ کِہِ گَژھِتھ یِہِ بابت مےٚ چھُس کَنہہ فِکرمَنٛد۔
تَمہِ اوس بَہت زیادٕ پٲٹھۍ پٲٹھۍ پَیسہٕ دِوان تِہِ اوس مےٚ پسندِیدہ شعبہٕس منز۔
مےٚ چھُس سَدا حیران گژھان پنٛنِہ پسندِیدہ بینٛڈُک پلے کَرنہٕ نَظَر۔
مےٚ کرٕ کِرٛیکرسُک ڈِبہٕ لَگٕنۍ خٲطرٕ ژٕٹہٕ وٕنٛنہٕ، تِہِ مےٚ پینٹ گٔیہ پھٲٹ۔
سُہ چھُ مےٚ ہُنٛد تہِ پسندِیدہ۔
کَل کامس منز لنچُک دۄہ مےٚ لَحظ کٔر کہ مےٚ ہُنٛد شرٹ اوس اُلٹہٕ پہنٛنہٕ آمت۔
مےٚ چھُ نہٕ پتہٕ کہِ اَسہِ لوٗگ راتِ کِتھ پٲٹھۍ نِنٛدر کٔرِتھ ہٲکَن۔
شُکریہ، تِمَنۍ مےٚ اوسٕ تَمہِ ہَمیٚشہٕ یِوان سُنوٗن وٲلۍ تِمٕے عام جُملہٕ وٕن۔
مےٚ سٕتۍ چھُ سَچُک پتہٕ۔
مےٚ چھُس پسند کَران کَرٲٹے ٲسِتھ فلمٕن ہُنٛد نظارہٕ۔
مےٚ چھُس اُمید کَران زِ ڈاکٹر تُہۍ کِنہِ علاجُک کینہہ اِختیٲر دِتھ ہٲکِو۔
مےٚ چھُس معذرت خواہ، اُمید چھِ زِ سٲری کینٛہہ ٹھیٖک گژھِ۔
سٲری کینٛہہ گوٚو جاین منز ٹھیک ٹھاک بَسِتھ۔
آ، مگر تِمِس چھُرۍ جلدی نَوِہ نوکری ژٕنٛڈُن ضروٗری۔
مےٚ سُہ غَلط پَرٕو، مےٚ سَمٕجھ آو زِ تُہۍ وٕن زِ تُہۍ گژھِو گُلٕدانَس پٮ۪ٹھ ٹَکر، تہٕ گوٚو سُہ ٹُٹ۔
یِہ سُنِتھ مےٚ تھوڑا دُک گژھ زِ مےٚ رٲجیہٕ تعلیمَس منز آخری نمبر پٲٹھۍ آو۔
مےٚ گوٚو پَہلی دَفعہ چائے پیٖتھ، تہٕ سُہ اوس مےٚ اُمیدٕ پٮ۪ٹھ بہٕتر۔
یِہ چھُ مےٚ ہَمیٚشہٕ بَتھ تہٕ چوکس تھاوَان۔
سُہ کیٹفِش اوس پورٕ ۱۰۱۵ پاؤنٛڈ۔
مےٚ گوٚو تھوڑا دِلگیر یِتھ زِ مےٚ دۄستَن کٔر مےٚ آخری ویک اینٛڈُک پٕلان کینسٕل؛ مےٚ اوسُس سٲتۍ وقت گَژھاونُک منتظر۔
مگر آ، تُہۍ چھِو صیح وٕنٛان۔
نَہ، کیازِ مےٚ ہٲک نہٕ سَمٕجھ سٕمٕتھ کَران۔
اوہ، سُہ چھُ سُندر؛ کاش مےٚ اوسُس تِمٕے کینہہ کَران۔
یِہ چھُ اَزکَل مےٚ پریشان کَران تہٕ مےٚ چھُس ہَمیٚشہٕ ژَٹکُن۔
بُتھ چھِ پَران سکولس گَژھان۔
یَتھ دۄہ مےٚ بٔرانٛہہ پٮ۪ٹھ گَرِ واپَس یِوان، مےٚ پٲلِتھ جانور چھُ زٕیادٕ مٲحَبَت دِوان۔
مےٚ تہٕ میٛون خاندان پہاڑن منز کیمپِنگ کرنہٕ گژھان چھِ۔
سُہ چھُ ہمیشہ تُہٕندِس ساتھی۔
یہِ چھِ تٔمۍ ہُند واریاہ گژھن۔
مےٚ چھُس سمجھان، کینٛہہ لوٗکھ چھِ فطرتی طور الگ۔
کیا تُہۍ سُہ صاف کٔرِتھ بوٗر کٔڈِتھ ہٕیکیو؟
واہ، یہِ چھِ واریاہ کٕل لگن۔
تُہۍ چھِ وُچھان کہ یہِ چھُ لٔڑکا یا لٔڑکی؟
کیا تُہۍ چھِ کَنہِ ژٕنٛگ اَتھ منز گٔیِتھ؟
یعنی تُہۍ چھِ واریاہ سُہ کٲم کران۔
تِمَن ساتھ چھُ میون بخت سُہ چلٕن، مےٚ چھُس اُمید کران یہِ رۄزِ ہٕنٛدۍ۔
میٛون بیٚیِہ کَل کٔہ زِ سُہ چھِ نہٕ مےٚ سان پیار کران تہٕ سُہ طلاق ژٕچھان۔
بہتر چھُ زِ تُہۍ کینہہ حل ژٕٹِتھ کٔڈِو۔
مےٚ اوسُس واریاہ پریشان۔
ہاں، یہِ چھُ تہٕ ہاں، تِم چھِ۔
مےٚ چھُس واریاہ گھٕبراون، مگر مےٚ کرٕہِس جلدی جلدی جاےن منز درخواست دِن شروع۔
مےٚ چھُس نہٕ فخر کران زِ مےٚ سکولس منز امتحان دۄران نقل کٔر۔
مےٚ لٔگ تازٕ پتا زِ میٛون بیٚیِہ چھِ حامِلہ۔
اوہ واہ، یہِ چھِ تٔمۍ ہُند واریاہ سُہ کٲم۔
مےٚ چھُس اُمید کران زِ تُہۍ پنُن سبق سیکھِو تہٕ دۄبارٕ کَنہِ دوستَس نِش نَہ ژٕورِو۔
کیا تُہۍ ہٕیکیو تِم پنٕنۍ نِش تھاوِتھ؟
باقٕین لوٗکن سۭتۍ چھُ سچ مچ سُہ گژھان۔
آؤچ، میٚ چھُ امید زِ توہہِ تہِ نہٕ کَرو۔
میٚ چھُ مٔلۍ ڈایپرن ہٕنٛز تھکمت۔
مےٚ سۭتۍ تہِ یِہِے گژھِتھ۔
کیا تُہۍ تِمۍ وٕنِتھ وٮ۪ٹَرَنٛس منز دِژھاون؟
میٚ چھُ نہٕ کینہہ یِم کھیلِچ متعلق سُنیومُت۔
نَہ، پتہٕ چَلا زِ سُہ چھُ صرف سۄ پلاسٹِک بیگُک سایہٕ یُس مےٚ کھڑکِی باہر لٹکوان اوس۔
اگر میٚ اوسُس تُہۍ جایہِ، بہٕ پُچھِتھ تُہۍ ماجہِ زِ تِمۍ تُہۍ بہن ہٕنٛز سامانُک پٮ۪ٹھ پیسہٕ کیازِ دِتھ، تُہۍ سامانُک نہٕ کیازِ۔
سُہ چھُ وُنہِ 3 ؤرۍ، مگر تِمِس وِزِ اوس تقریبن ڈیٖڑ ؤرۍ۔
کیا کینہہ گژھِتھ یِم یاد کرنُک سبب بن؟
لیبرون لٮ۪کَرس گژھنہٕ دِژِتھ مےٚ اوسُس دُکھ۔
مےٚ اوسُس پنٛنِس شَوہرَس خٲطرٕ مقٲمی بیکری ہٕنٛز برٛونٹھ سالگرٕ ہٕنٛز کیک آرڈر کران۔
میٚ چھُ امید زِ تُہۍ مِلہِ نوکری تہٕ تُہۍ دوستَس مِلہِ تحفہٕ۔
میٚ چھُ خیال زِ بہٕ ہٕہ سمجھیٚتھ۔
اگر تِم تُہۍ سۭتۍ چھِ رَوان، تُہۍ گژھِتھ ضروٗر یقین زِ سُہ چھُ محفوظ۔
اوٚ چھٲ، مےٚ سۭتۍ تہِ چھُ یہِ ہر وَقت گژھان۔
مےٚ کُٹمبس منز چھِ سارن ہٕنٛز گاڑِ مےٚ ہٕنٛز گۄڈٕ نِش سُہتر۔
اوہ، سُہ چھُ کمال! کیا تِمۍ اوس نیکی دۄہراوان؟
مےٚ وون مٔلۍ اَکھ ؤرۍ خٲطرٕ مُفت آئس کریم مقٲمی کریمری پٮ۪ٹھ۔
ہاں، مگر سفرُک مزٕ لیٚونُک کوشش کٔر—یہِ چھُ سَہ نِش اہم حِصہٕ۔
مےٚ دوستُک زَن چھِ ساروٕے کھۄتہٕ بہتر۔
مےٚ کٲشرِ چھِ موسیقار—ساروٕے ننۍ چھِ پیانو بجاون والی تہٕ ساروٕے وڈۍ چھِ وائلن بجاون والی۔
بِہہ اَکھ اندازہٕ کرٕ۔
بِہہ تِمِس پِٹبُل ہٕنٛد شکلِ منز مےٚ ننۍ خرگوش ونان۔
تَتھ سۭتۍ مےٚ ژۄر غصہٕ آو۔
تُہۍ تِمۍ سۭتۍ کیازِ نہٕ رابطہٕ کٔر؟
آ، اکثر چیزن ہٕنٛدۍ پٲٹھۍ۔
مگر مےٚ چھِ تَتھ سۭتۍ ژۄر ژۄر ضرورت۔
ییلہِ یہِ سٲری کھیٚتم گژھِ، بِہہ خۄش گژھِ۔
حالٕے منز ییلہِ مےٚ پالُن اِگوانا مُرتھ، مےٚ ہٕنٛز دِل ٹُٹ گٔے۔
مےٚ چھِ اُمید زِ تِم کٔرِ تَتھ پٲٹھۍ مےٚ طرفہٕ تہِ۔
گرمیٖن ہٕنٛدۍ طوفان ٲس مےٚ محلہٕ پٲٹھۍ ژۄر سۭتۍ گژھان تہٕ پنٛنِس رٲستس منز سٲری کینہہ تباہ کٔر۔
آج صبح ییلہِ بِہہ جاگ مےٚ، مےٚ کمرس منز ٲس اَکھ بھڑ۔
ہا ہا، آ، یہِ تھوڑا بےمقصد چھِ، مگر بچپنِ منز چھِ یہِ تھوڑا مزہٕ دار۔
شُکریہ، تُہۍ چھِ صحیح ونان؛ مےٚ چھِ بس بجٹ بناون تہٕ زیادہ بچت کرن شروع کرُن۔
مےٚ ہٕنٛز کُتُر گٔے گژھن پٲٹھۍ چھِ گژھِم ہفتہٕ پیٚٹھۍ یہِ ژھۄپ تہٕ خاموش۔
بِہہ کٔرِتھ ہٮ۪وان، مگر بِہہ چھُس نہٕ کُنہِ تہِ زیادہ ہوشیار بَنِتھ ہٮ۪وان۔
مےٚ چھِ پتاہ زِ مےٚ ہٕنٛز زَن پَتہٕ فلرٹ کرنہِ سۭتۍ خوش گژھان ٲس۔
آ، تٔمۍ مےٚ پٲٹھۍ گوٚو زِ بہٕ ژۄر لیب ٹیسٹ کٔرٕ۔
یہِ ٲس اَکھ سرٹیفیکیشن خٲطرٕ۔
نَہ، تہٕ یہِ وٲنۍ وٲنۍ زیادٕ مُہنگ گژھان۔
مےٚ یاد چھُ کہ ژٕ بچپنَس منز زندگی کِتھ پٲٹھۍ آزاد ٲس۔
سچ وٲنۍ، مےٚ دِلَس منز گژھِتھ بٔڈ خراب۔
تِمَن سُہ آسانی سٕتۍ پتہ چھُ کہ کِیا کَرُن چھُ۔
یہِ چھُ بٔڈ زیادٕ پَرُن۔
مےٚ گژھِتھ حَیران زِ تِم سٲری رٲستہٕ ہیٚٹھۍ آو۔
کَیمَرَن ہِنٛدۍ حَوالہٕ سٕتۍ تَمس پیٚٹھ پیٚغام پٲٹھۍ دِنٕچ خٲطرٕ مےٚ پنُن کٲم حدن ہٕنٛز بٔڈ کوشش کٔر۔
ییلہٕ میون اٮ۪کس گَرٕ آو، تیلہٕ مےٚ نِنٛدَر چھُنہٕ باسان کران۔
مےٚ چھُ پتہٕ زِ تِم کٲنٛسہِ وٲتھ نِنٕچ چھِ بٔڈ تکلیف، مگر کرُن پَژھِ۔
ہاں، ییلہِ کَتھ ژٕ بچپن یاد یوان، تیلہٕ بہٕ کٲشِش کران زِ بَچَن سٕتۍ وقت گٲرِتھ۔
پَر، میٛون محلہٕ منز پولیس کَتھٕ نیٚبرِ یوان۔
میٛنٛۍ ژٕ بیٚیٚہِ چھِ میٚنٛۍ خوش تھاوان۔
ییلہٕ بہٕ خاندانس سۭتۍ ملاقات کرنہٕ باپتھ باہَر اوسُس، میون بوائے فرینڈن مےٚ دَگہٕ دِت۔
کِیا سُہ آخرکار ٹھیک گژھِ؟
مےٚ چھُ امید زِ یہِ دۄبارٕ کَتھ نیٚبرِ تُہۍ سٕتۍ نَہ گژھِ۔
باسان چھُ زِ تُہۍ چھِ بٔڈ محنت سٕتۍ مشق کران تہٕ تُہۍ چھِ خواہش تہِ۔
یار، سُہ گژھِ بٔڈ کمال۔
مےٚ چھُ بالکل پتہٕ نَہ زِ کِتھ پٲٹھۍ وقت اوسُس تَتھ۔
کِیا تُہۍ چھِ سُناوان زِ ساینِس دان چھِ تِمَن ختم کرنٕچ کوشش کران؟
مےٚ حالٕے منز باغبانی شروع کٔرِ، مگر مےٚ چھُ نَہ بٔڈ سٲری۔
یہِ چھُ اَکھ سُہٕ احساس۔
تَمہِ پتہٕ بہٕ کینہہ دَفعہٕ ژٔٹ۔
مےٚ دوٗنٛۍ بَچٕہ چھِ گَہری نِنٛدرِ، تہٕ یِمن وٕقتن مےٚ محلے منز چھُ صرف بہٕ جاگرٕتھ۔
مےٚ چھُ اَج تہِ دُکھی گژھان یِہ سوچِتھ زِ گیم آف تھرونز چھِ ختم گژھان۔
مےٚ ٹاپ پلیئرن ہٕنٛز ۴ نفر چھِ یِوان واپس یِم سیزن، اَسہِ گژھِ اَکھ شاندار سال۔
بہٕ وُن تَمس تہٕ تٔمۍ وُن زِ تٔہٕ دِیِو یہِ مےٚ یَتھ ژٔٹ واپس۔
یہِ چھُ واریاہ سُہٕ! یہِ کِس قِسمُک آس؟
بہٕ چھُس تیار مےٚ نوِہ نوکری خٲطرٕ۔
تٔمۍ تہِ مےٚ دِژھ واریاہ سُہٕ جواب۔
آ، بہٕ چھُس یہِ باقی کُنہِ تہِ کھیلٕہ پیٹھ ژٕیادٕ پسند کران۔
تَمہِ سٕتم وٕقت بہٕ یِہی وُنان اوسُس، ‘مےٚ والِدین گژھن مےٚ کُس!’
مےٚ بیٚی چھِ حٲصل کران سُہ نوکری یِمِچ تٔمۍ اوس واریاہ ژٕٹن، تہٕ بہٕ چھُس تٔمۍ خٲطرٕ واریاہ خوش۔
تُہٕ چھِ لگٕان زِ تُہۍ چھِ واریاہ سُہٕ تیٲری کٔرمتۍ۔
مےٚ چھُ یقین پنٕنۍ صلاحیتن پیٹھ تہٕ پنٕنۍ کھیلِہ پیٹھ۔
گرمیٖن ہٕنٛد آخرُک صفٲیی، بہٕ چھُس سُہ احساس جانان؛ سکول سال خٲطرٕ گژھِ تیار۔
بہٕ وٕنِہ نِنٹینڈو سِوِچ کِرِد، تہٕ یِہ کھیلنہٕ سۭتۍ مےٚ یاد آو مےٚ بچپن یُس دوستن سۭتۍ کھیل کھیلان اوس۔
تُہۍ پَزِ چھِ دُکھی گژھان۔
پَتہِ دۄہ مےٚ بہترین دوستن دِژھ مےٚ اَکھ تحفہٕ اچانک۔
نَہ، تِمن ہٕنٛدٕرُن حصٕہ اوس کٔڈمُت۔
زبانن ہٕند رُکاوٹ کافی مُشکل کٔرِتھ ہیکن
تُہۍ مےٚ وُچھِو
سُہ تِمَتھ پٲٹھۍ گژھان چھُ گَپ
شِٹ، یہِ چھُ دِل شِکَستہ کُن
مےٚ چھُ پنٛنِس پَپّی پؠٹھ فخر
ایکزیکٹلیو، یَتھ کَتھ تُہٕنٛد ضروٗرت پَتھ گژھِ تُہۍ ہَمیشہ تیار
مےٚ لگٕان چھُ تُہۍ یِہِس مُتعلِق کَتھ پٲٹھۍ محسوٗس کَران تُہۍ سُہ وُچھِو
مےٚ چھُس آز راتھ لٲیٹ ژٕلان سٹیفن کِنگ ہٕند شو ہٕنٛد نَو ایپِسوٚڈ وُچھان
اوہ، یہِ چھُ زٕٹھ رومٲنچک سونٛدِتھ
مےٚ چھِ پنٛنِہ ریزیومے پرِنٛٹ کٔرتھ تہٕ سٲری کینٛہہ تیار
مےٚ ہؠکٕس نہٕ حتّیٰ یہِ تصوٗر کٔرتھ زِ سُہ کِتھ پٲٹھۍ مُشکِل آسِہ
۳۸ ہفتہ گژھِتھ، یِمن ہٕنٛد بیبی شٲوَر چھُ واریاہ دیر سان، مگر اُمید چھُ سُہ تَتھ پٮ۪ٹھ پیٚٹھ لَیبَر نہٕ گژھِ
مےٚ ہؠکٕس نہٕ یقٖین، مےٚ ہٕنٛد اٮ۪کس نہٕ نِیہٕ وُٹھ مٕتۍ تہٕ وُنُہ سُہنٛد فون آف چھُ
یَتھ مےٚ آسٕس ۱۰ ؤرۍ، مےٚ ہٕنٛد بہترین دوست گژھِ دور
بِلکُل نہٕ، یِہِس مُتعلِق مےٚ یَتھ پٮ۪ٹھ فِکِر کٔر سُہ تِتھ لٲیِق نہٕ آسِہ
ہا ہا، بَہٕ، روز چھِ کانٛہہ نَو سیکھنہٕ یِوان
مےٚ چھُس مکان بَدلٲونِس مُتعلِق فِکِر مَنٛز، مےٚ چھُ تقریباً سٲری زنٛدگی یِتھ گھرَس مَنٛز گُزارمُت
تُہۍ چھِ صحیح خیال گَژھِتھ
تُہٕنٛد پنٛنِہ کارَس کیٛاہ گژھِتھ
یِہِ چھُ تُہۍ ہفتَن تام عجیب طریٖقہٕ سٕتۍ روٗدِتھ
بہتر کٔرٕنہٕ خٲطرٕ پڑھُن چھُ واریاہ ضٔروٗری۔
مےٚ چھُ نہٕ یہِ وُچھمُت، مےٚ بوزِ یہِ متعلق۔
مےٚ چھُ جلدٕ پنُن پرسنل ٹرینر سرٹیفیکیشن اِمتحان دِوان۔
’دِس اِز اَس‘ واپس یِوان تام مےٚ چھُ نہٕ انتظار کٔرِتھ ہیکان۔
تُہۍ پنٛنٮ۪ن ساتھی کٲم کرن وٲلۍ کِنٛہہ ونان؟
مےٚ گژھِ تِمِس اِنٹروٗیوٗس، یِمن سوالن ہُنٛد جواب مےٚ آس پٲٹھۍ مولوٗم۔
مےٚ چھُ گمان، یِہ ہٕنٛد بُو گژھِ سُہ۔
مےٚ ہٕنٛز والٕے چھُ نہٕ وُچھان مےٚ سات، تہٕ مےٚ چھُ تھوڑا یہِ خاموشی پسند۔
سَمٕژھان چھُ، تُہٕنٛز زنٛدٕگی چھِ بلکل کامل۔
مےٚ غلطی سان گژھ کِسٕ ہنٛد پٲوٕکِس اَنگُرِس پٮ۪ٹھ، گروسری سٹورس، تہٕ تٔم دِس آوُر واریاہ دٔردس منز۔
تُہۍ سَمٕژھان چھِ کہِ تٔمۍ کٔر سُہ؟
تِمِس وُچھِتھ بہتر محسوس کٔروٕنہٕ سان مےٚ چھُ پنُن آپ بہتر اِنسان محسوس کَران، تہٕ مےٚ چھُ مولوٗم زِ مےٚ کینہہ حٲصل کٔر۔
تُہۍ چھِ اکثر کیسینو گژھان؟
اوہ، یہِ نہٕ کٔر کٲم، ہا؟
شاید تُہۍ پنُن دوست دھٕژِتھ دروازٕ وُچھاوِتھ ہٮ۪کِو۔
یِمۍ مےٚ تہٕ مےٚ ہٕنٛدِس پریوارس پٮ۪ٹھ شرمندٕ کٔر۔
مےٚ ہٕنٛز ماوٕ گٔے شہرٕکِس دۄسرِس پٲٹھۍ۔
مےٚ چھُ واریاہ ناپسند ییلہٕ مےٚ کٲمَس پٮ۪ٹھ کٲم کَران تہٕ وُچھان زِ مےٚ ہٕنٛدۍ ساتھی کٲم کَران چھِ نہٕ۔
یہِ چھُ مزٕدار، مےٚ چھُ خۄشی زِ تُہۍ یہِ کٔرِتھ ہٮ۪کِو—موج کٔرو۔
مےٚ چھُ لوٗکن ہٕنٛز سامنٕے واریاہ شرمیلا۔
تَتھ تُہۍ یہٕ واپس گژھِ مِلُن۔
بہٕ سٲری گَر صاف کٔر تہٕ پنُن تیار کٔرنس منز بٔڈ وقت لَگ۔
مےٚ کَتھ کُنہِ نَہ وَنُن تھٕو کِ فرانس کپ جیتِہ۔
تِمِس دٔیٹھِتھ مےٚ خۄشی گژھان۔
آہ، یہِ چھُ خراب زِ پَیسہٕ تھٕ مسئلہٕ۔
پنُن ساتھیس پٲٹھۍ بھروسہٕ کَرُن چھُ بٔڈۍ ضٔروٗری۔
مےٚ گژھِم ویک اینڈ کَیمپِنگ کَران تہٕ تِتھ آسِ یہِ بٔڈۍ ہرن مَکھۍ یِم مےٚ بار بار کَٹان۔
تِمِس سۭتۍ چھُ اکھ بہترین کامہِ ماحول بَنان۔
یہِ چھُ کَتھ بٔڈۍ خۄشِی زِ تُہۍ چھِو اَسہِ قِسمہٕ کٕس شَخصی ترقی کَران۔
بہٕ چھُس کُنِس کُنِس کُنِس گژھان باتھ، تہٕ سٲری کینٛہہ گژھان ٹھیک، مگر تِم اچانک مےٚ سۭتۍ رابطہٕ کَٹان۔
تِتھ پٲٹھۍ بٔڈۍ آواز نَہ، مگر تِمِس چھُ یہِ کٔرِتھ۔
کَم اَز کَم تُہۍ رِفنٛڈ گٔو حٲصِل؟
بہٕ چھُس شِکایت کَرُن ژٕچھان، مگر چھُس نَہ ژٕچھان کُنہِ لَڑٲے شُروع کَرُن۔
مےٚ ہُنٛد ماج تَتھ آسِ تہٕ مےٚ تِمِس سۭتۍ گَر گژھُن پَژِ، تِمِس پَتہٕ آسِ۔
کیا تَتھ گژھِ میوزِک تہٕ نَچ؟
کَتھ کُنہِ وقت پَتہٕ مےٚ مِل اکھ نَنھۍ بِلٕی ہُنٛد بَچّہٕ تہٕ مےٚ فیصلہٕ کٔر زِ تِمِس گَرِ نِتھ بوتلہٕ سۭتۍ دۄد پِلاوُن۔
مےٚ نَہ وَنان زِ مےٚ چھُ تِم کُنِس گَرِ اَندٕر دِیُن، مگر تِم روز بَاہر آسِتھ۔
کاش بہٕ آسٕہِ اَلبَٹ آئنٛسٹاین سٲنۍ عقلمَن۔
مےٚ وَن تھٕو زِ مےٚ ہُنٛد زَنٛگِر نٲبِہ ہٕنٛد ہرنیا آسِ۔
مےٚ حالٕے منز الاباما پٲٹھۍ سِدھا انٛڈیانا کُن کٔر نقل مکانی۔
مےٚ سفرن پٮ۪ٹھ گژھُن بہت پسند ٲس، مگر مےٚ گژھتھ مےٚ باسَس یہ نَہ پسند ٲس۔
سُہ پریشان ٲس تہٕ زور دِوان ٲس۔
حالٕے مےٚ کینہہ بلی ہِنٛدۍ بچہٕ اکھ متروک گَرِ منز لَبدٕ۔
تَمہِ خٲطرٕ مےٚ سٲری کاغذ پٲٹھۍ تیار ٲس۔
مےٚ ہیٚران زٕ کَتھ سٲری پینٹنگہٕ اَسہِ ہٕنٛزۍ ژٕٹِھ بَنی۔
پگہ ہفتہ مےٚ چھُ سالانہ جٲیزہٕ۔
یہِ منز چھِ ٹی شرٹ، سٹیکر تہٕ اکھ گِٹار۔
ہر اکھ چھُ خوش روزُن لایق، ژٕ کِس سٕتۍ وقت گُزارُن پسند کران تہٕ تَمہِ ہُنٛد مطلب کینٛہہ تہٕ آسِہ۔
یہِ کَنہہ پٮ۪ٹھ نَہ ٲس یِوان۔
یہِ ڈرٕاوُن ٲس، مگر مےٚ فیصلہ کٔر کہٕ مےٚ پنٛنِس ویٚٹ پٮ۪ٹھ پورٕ بھروسہ کَرُن، تہٕ سُہ اَز تہِ تندرُست چھُ۔
مےٚ ہٕنٛزِ دو بہترین دوست حالٕے گٔے دۄر، مگر اَکھ دۄہَن پیٚٹھ کینٛہہ نَہ دۄر۔
مےٚ تہِ، دوست، چھُٹی بہت پسند چھُ۔
مےٚ چھُ اَز تہِ ترٛٲوۍ کٔرِتھ۔
مےٚ بالکل نَہ سٔہل کٔرِتھ زٕ سُہ مےٚ سٲری پیسہٕ چور کَران ٲس۔
آ تۄہہِ بہتر محسوس گژھان؟
بس اکھ ڈٮ۪ڈُر کَرُن پٲوِ چِھد۔
تَمہِ ہُنٛد ناوٕ سِلوٮ۪ستر ٲس۔ تُہٕنٛدِ بلی ہُنٛد ناوٕ کیٛاہ ٲس؟
تَمہِ سٕمتھ کَرُن چھُ واریاہ محنت طلب۔
آ، مےٚ ٲس اکھ لفٹ منز پھنٛس مٕت۔
مےٚ گٔے واپس پنٛنِس محلہِ یُس منز مےٚ پٲٹھ، پُرانٕ دوستن سلام کٔرِتھ، تہٕ یہِ سٲری کینٛہہ عجیب غٲر حقیقی لٔگ۔
بہٕ بس گَرِ بیٹھتھ چھُس۔
یُس یی یِتھ پٲٹھۍ، تَمہِ پٮ۪ٹھ چیز نہٕ آس۔
تُہۍ کَہ ریاستس منٛز چھِو؟
مُبارک، ڈاکٹرن ہُند ترٛٛے تہِ واقعی ڈراوِتھ ہٲوِتھ۔
بہٕ کٲلِس پٲٹھۍ پنٕنِس زٲوٕنۍ ہُنٛد پُران فوٹو دٮ۪کھان اوسُس۔
تُہنٛزِ نقصان خٲطرٕ مےٚ تہِ افسوس چھُ۔
اوہ ٹھیٖک، سُہ تُہۍ جانٛو پٮ۪ٹھِ گَرِ واپَس یِیہِ۔
آخرس منٛز بہٕ زٕبرٕدست خوش قسمت نِکلُس۔
اَزٕ صُبح مےٚ سٲری ہُند سۭتۍ جھگڑٕ گوو۔
اَس دوست بنٛڈ، مگر سُہ یِم شک وار مردن سۭتۍ ڈیٹ کران آسۍ، تَمہِ خٲطرٕ بہٕ ہر وَقت پریشان اوسُس۔
مےٚ آس چھُ تُہۍ یِہ ٹھیٖک کرنٕے خٲطرٕ کانٛہہ لُڈِتھ ہیٚو۔
یِہ ہیٚتھ سُنتھ گوو خۄش۔
یِتھ گژھان چھُ سُہتر یَتھ تُہنٛدِ گِردِس خیال تھاون وٲلۍ چھِ۔
کَنٛہہ کَنٛہہ چھُ آرام کٔنۍ جلدی گَرِ گژھُن مددگار۔
یِہ مۄنٛز چھُ سُہتر لَگُن زِ آخر مےٚ سٲری محنت آیی کام۔
بہٕ جیٖنز لُڈنٕے خٲطرٕ دُکانس گژھِتھ، تہٕ اکھ سُہتر جوڑٕ میٚل۔
چینُک تاریخ چھُ لانٛب تہٕ دِلچسپ۔
مےٚ خوشی گوو زِ تُہۍ سٲری موج کٔر۔
کٲلِس پٲٹھۍ مےٚ سکریچ آف لاٹری ٹکٹ پٮ۪ٹھ 100 جیت، تہٕ پنُن نصیب مےٚ یقین نہٕ آو۔
ہای، افسوس چھُ زِ مےٚ پنٕنۍ سٲری قرض فٮ۪رِتھ دِتھ۔
تۄہہِ نَوِ کَرانٛٹَس ساتہٕ مےٚ چھِ تۄہہِ خٲطرٕ نیک تمنّا
تہٕ مےٚ چھِ یقین زِ تُہۍ چھِو پورٕ مَوز
اُف، یہِ چھِ اَکھ واریاہ سودا
