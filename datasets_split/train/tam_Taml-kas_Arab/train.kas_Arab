میونٛہُک رۄنٛگ لال گژھمُت
آ، یہِ سچ مۄنٛڈٕ مایوس کُن آس
مےٚ چھُ شوق زِ میون بچن ہٕنٛدۍ بچپنُک تصویریں ڈھونٛڈٕنۍ
میونٛ بؠیہِ فوت گژھ، تِلہٕ چھُس مےٚ پھِر اکیلا
یِلہٕ کُنہِ مےٚ نَو تحفہٕ دِوان چھِ، مےٚ چھُ حیران گژھان
واریاہ ؤری گژھ مےٚ اکیلا راتھ نہٕ کٲٹمُت
اگر نَو گاڑِ واریاہ ؤری تھاوِو، تُہۍ ہٕنٛز خرچہٕ تقریباً برابر یِوان
گژھ دۄہ مےٚ اوس سۄنٛہِ دوستس سۭتۍ اچانک ملاقات، تہٕ مےٚ اوس حیران زِ کینٛہہ ہۄتھ نہٕ آو
سُہ کوشش کران تہٕ ناکام گژھان، تَمہِ پتہٕ سُہ کَنہِ تہِ یہِ صحیح طریقہٕ نہٕ کرِتھ پٲر
مےٚ چھُس تراو مےٚ تٔمۍ یہِ متعلق کینٛہہ نہٕ ونان
مےٚ سُہ متعلق سۄن، یہِ چھُ اکھ گۄڈ پلان لگٲن
سُہ ہمیٚشہ مےٚنٛز سامان استعمال کرُن چاہان تہٕ آخرس منٛز سُہ تِہ توڑان۔
یہِ چھُ بٔڈ بےعزتی والہ، خاص کرِتھ یتھ سُہ الگ گھرس منٛز نہٕ روزان۔
سُہ چھِ لفظک ہر معنہِ منٛز کامل۔
تُہہ چھُس تِمِس جایہِ یَتھ پیٹھ أسۍ سٲری روزِتھ ہیکو، مگر واریاہن وجہن سۭتۍ نہٕ ہیکو۔
یہِ چھُ سۄنٛدَر تَرین، مگر مزیدار تَلِتھ ماس چھوٚڑُن چھُ مُشکِل۔
مےٚ کِنہہ روز پیٚٹھ پنُن ڈرایؤنگ ٹیسٹ پاس کٔر۔
مےٚ چھُس پنٛنِس کُٹمُبہِ خٲطرٕ ہمیٚشہ سَستہ بیٚیر انان، تہٕ ییلہِ میون دوست یِوان چھِ تیلہِ سُہ سۄنٛدَر بیٚیر۔
مےٚ چھُس ہُنے ہُنے اَکھ نَو باغ لٲگُن شروٗع کٔرمُت۔
ہاں، مےٚ یِہِ مطلب چھُس کران زِ سُہ چھِ مزٕ کران تہٕ مےٚ چھُس خوش، مگر ہمیٚشہ چیخنہٕ—آخر سُہ کیازِ چیخان؟
سُہ چھُ امریکہ ہنٛزِ کُنہِ اکھ بٔڑِ کمپنی منٛز سبنہٕ وادٕ پگاہ والہٕ نوکری لَبمُت۔
مےٚ چھُس عام طور پٲٹھۍ صرف الارم پٲٹھۍ بھروسہ کران۔
مےٚ چھُس تمن کٔنٛہہ گژھِتھ ماحولس عزت نہٕ دِنُک خٲطرٕ ڈانٹُن چاہان۔
کیاہِ چھُ سُندس سرجری جلد طے گژھِتھ؟
سُہ کِیاہِ گژھِتھ چاہان؟
مےٚ دِژ میون پنٛنٮ۪ن بچپنُک فوٹو۔
مےٚ چھُس سۄچان زِ یہِ عام ہارر فلمَن ہنٛز نسبت واریاہ کرٛیپِی آس۔
تُہہ کَمِتھ وقتھ سۭتۍ سُہ وۄنکھان؟
یہِ چھُ اَکھ زبردست، مگر مےٚ نہٕ وۄن چھُ زِ مےٚ چھِ اضافی ذِمہ داری سنٛبھالِتھ ہیکان یا نہٕ۔
یہِ چھُ کمال زِ کَتھ لوگ گژھِ اندر۔
بچن ہٕنٛز پرورش کرُن چھِ مشکل۔
آج کل سوشل سکیورٹی تہِ پارٹ ٹایم نوکری چھِ ہمیشہ، ژٕنٛگ یہِ عام رواج چھُ بنٛد۔
شاید تُہۍ وقت بدلِتھ کینہہ زیادٕ مزٕ کَران ہٕیٚو۔
بہٕ کافی عرصس منز تَتھ گژھٕ نَہ اوس۔
یہِ چھُ اٮ۪ک آن لاین رِٹیل کاربار۔
مےٚ پنٛنۍ نوٚی نوکری خٲطرٕ گژھِ پَتہِ ہفتہٕ لائسنسِنگ ٹیسٹ دِن۔
یہِ اوس اٮ۪ک واریاہ غأر متوقع فایدٕ۔
تُہۍ یہِ کَتھ پٲٹھۍ پار کٔر؟
ہاں مگر تَتھ خٲطرٕ پیسہٕ چھِ لٲزم۔
بہٕ کُدٕلِ سٕتۍ یہِ مارِتھ ڈٲل۔
بہٕ آخری سیزن خٲطرٕ انتظار نَہ کٔرِتھ ہٲوان۔
کیا یہِ کینہہ خاص موقع اوس یا کینہہ؟
وینٛڈر کَنٛہہ واریاہ خراب۔
مےٚ دوستن دِژھ مےٚ اٮ۪ک پارٹِ کٕتھ یُس شراب تہٕ ڈرگس سان اوس۔
خیر، کم اَز کم تُہۍ اٮ۪ک تازٕ جوڑی مٕلِتھ ہٲوان۔
تٔمۍ مےٚ کٔہ کہِ تِہِ سٲری وِکِتھ گٔے۔
خریداری کَران وٲلۍ مےٚ اٮ۪ک سوڈا کھول تہٕ چیک آؤٹ کَرانہٕ وِز پیسہٕ نَہ دِت۔
مےٚ نَہ چھِ خاص پسند اِکوالایزر سٲری فلم، مگر دۄیم فلم اوس واریاہ سُندر۔
مےٚ اٮ۪ک دوستُک وٮ۪ہار چھُٹ گٔیٚو کیازِ مےٚ ہٮ۪نگ اوور اوس، تہٕ مےٚ بُرا لگِتھ یُس بٮ۪کار وجہس سۭتۍ تِہِ چھُٹ گٔیٚو۔
تِمُس اِتھ پٲٹھۍ دور یِوان خٲطرٕ مبارکباد۔
مےٚ امید چھُ زِ دۄیمہِ وار تُہۍ یہِ سمجھِو۔
مےٚ ییلہٕ وُٹھ، مےٚ کمرس منٛز اوس اکھ بھَڑ۔
مےٚ چھُ سچ ۲۰ منٹ پیٹھۍ تَمی کھٲیومُت۔
کَل مےٚ کینہہ کوڑا پھٕٹان اوس، تہٕ مےٚ ہِس آیا زِ مےٚ اکھ اوپَسَم گژھان ڈۄڈان دِٹھ۔
آ، مگر مےٚ کَدی نَہ اوس پَتہٕ زِ یہِ اَتھ پٲٹھۍ بٔڑ گژھِ۔
بوٚد وار ژور کَرُن پٲوان۔
مےٚ چھُ گمان زِ تِم چھِ مےٚ پتھٕر بہتر حالتس منٛز۔
مےٚ پنٛنۍ آفِس منٛز اکھ بُلِٹن بورڈ لٲگتھ تَمہِ پٮ۪ٹھ تِمن ہُنٛدۍ فوٹو بھرِتھ۔
یہِ چھُ جیک رَسل ٹیرِیَر۔
ہاں، ییلہٕ سٲری کینٛہہ ٹھیٖک گژھِ، تہٕ یہِ گژھِ اکھ نیک کٲم۔
مےٚ اوس شُکرگُزار زِ مےٚ ناروے منٛز آیس کٕلایمبِنگ کرن گٔیہٕ تہٕ گلیشِیَر منٛز نَہ پٲر۔
مےٚ چھُ آوۍ کَل اکھ موٹر بنٲون۔
تٔمِس ہُنٛدِ پرفارمَنسَن مےٚ بٔڑۍ عاجزی محسوٗس کٔرۍ۔
ہر مانٛہ اکھ نوٚو کار کَتھ پٲٹھۍ حٲصِل کرِ؟
دۄیمہِ ہفتہِ مےٚ شہرٕ بٲہَر گژھان چھُس، مےٚ چھُ گمان زِ سٲری کینٛہہ تیار چھُ۔
مےٚ اوس اکھ وار یمۍ کُڑِس سٕتۍ رٲوان تہٕ مےٚ اوس تٔمس پٮ۪ٹھ بھروسہٕ۔
مےٚ چھُ سخت ترٛیٖنِنگ کران تہٕ مےٚ چھُ پنٛنہِ جایہِ حٲصِل کرنچ قابلیت متعلق بٔڑٕ سُہ احساس۔
مےٚ چھُس تِمَن ۱۰ ؤرۍ پیٹھۍ فالو کران تہٕ یہِ چھُ پٲٹھۍ وار زِ مےٚ چھُس تِم دۄن۔
کَل رات مےٚ اوس دوستن سٕتۍ ڈِنَر پٮ۪ٹھ تہٕ مےٚ گوم کٔر والِٹ۔
مےٚ چھُس اَز تام نَہ کھیوٗمُت، مگر مےٚ چھُ نَہ ہٮ۪کان یہِ واپس کرِتھ۔
یہ ضرور پریشان کُن آسہٕ، کُتُہِ کِنہِ نسلُک چھُ؟
مزید نوکریوٕں خٲطرٕ درخواست دِوان وِزِ مےٚ یِہٕ کَتھ اَپُنَس یاد دِوان رَوان۔
حوصلہ تھاو، مےٚ یقین چھُ زِ اَکھ بیٚیہِ خوش قسمتی ہُنٛد موقعہ یِیہِ۔
تِمَن متعلق تُہۍ کیاہ کَرن وٲلِو؟
مےٚ چھُ یقین زِ تِمن کَتھ سراہمٕژ ہُہ۔
مےٚ اَپنِس گوٚڈنیٚ کنسرٹُک ٹِکٹ سنٛبھالِتھ تھاو۔
مےٚ کٲمِس پیٚٹھ ترقی نہٕ مِلِتھ۔
سوموار دۄہ مےٚ اَپنٕہ نوِ نوکری شُروع کَرِتھ وٲلِو۔
مےٚ چھُس یژھان کینہہ دوست بناوِتھ، مگر رٲبطہ قٲیم کَرُن چھُ یقینن مُشکل۔
مےٚ چھُس قَسم کھاون، کِیاہ کُنِہِ یِتھ پیدا گژھِتھ؟
مگر یِہٕ کَرنُکٕچ پَڑِ۔
مےٚ چھُس ژور غُصہٕ یِوان زِ میٚون باسَن مےٚ سنیچر دۄہ کٲم کَرٲو۔
یِہٕ چھُ سُہ زِ تُہۍ میٚون کَتھ مَنٛز۔
اَکھ لُکُٹ پِٹبُل اَنِتھ تِم سُہ صحی طریٖقَس پٲلِو۔
کاہہ پَتہٕ نہٕ، مگر یِہٕ چھُ بٲیہِ موٚٹ دِژھان۔
کِنہہ وٲتھ مےٚ کار گٔے خراب، مگر میٚون روم میٹ آو تہٕ مےٚ نِتھ۔
مےٚ گژھان چھُس سٲری شےٚ کَٹھ کَران دۄہِمِتِھ میٹنگ خٲطرٕ۔
جھاڑو کٲڈِتھ تِمَن ہُنٛد پُران کمزور پُٹھہِ پیٚٹھ زوردار وار کَرِو۔
آ، مگر تِمَن دوبارٕ ڈایپر پٲٹھ کَرٕن ہُنٛد پانٛژھ منٹَن مَنٛز گٔے سٲری کَن پٲخانہٕ۔
مےٚ چھُس اَپنُس متعلق تہِ مُشکلہٕ سان واقف۔
تہِ دۄن وائر سٕتۍ لۄگ پٮ۪ٹھ ہیوتھ، کیازِ تہِ تَمہِ منز پھنس گٔیو۔
مےٚ سٲری ہفتہ پَرٕنۍ، تہِ کَنہِ نَہ سُہ محسوس کٔر کہ مےٚ ژِندگی منٛز اِتھ پٮ۪ٹھ تیار چھُس۔
مےٚ سُہ احساس پٲٹھۍ جانان۔
مےٚ چھُس سٲری پٲٹھۍ پریشان تہِ نَہ ہٮ۪کان بند کٔرِتھ تَمہِ متعلق سوچُن۔
شُکریہ، اُمید چھُ کہ یہِ صرف غلط الارم گژھِ۔
یہِ چھُ سٲرنیٛ ہُند سٕتۍ ییٚلہِ موسم بدلِ۔
خاص کٔرِتھ کیازِ یہِ سٲری دۄہ اوس۔
واہ، یادگار چیزٕن ہٕند نظارہ کٔرُن چھُ مےٚ پسند۔
سُہ تہِ ہٕنٛد پٲٹھۍ پہلی نٲتۍ اوس۔
تُہۍ کِنٛہہ چیزٕن سٕتۍ اٮ۪کسولوٹل پالتو جانور تھاوُن منٛز دلچسپی پیدا گٔیو؟
سُہ چھُ سُندر، تُہۍ کُتھ گژھان؟
کرسمس معجزہ متعلق أکھ سچ کہٲنی۔
کیا تُہۍ پیسہ بٔچاونُک سوچِو؟
مےٚ چھُس وُنٕے سکریچ پٮ۪ٹھ 100 جیتھ۔
اگر تُہۍ گژھِو، تُہۍ سُہ سٲری پسند کٔرِو۔
مےٚ اوسُس ژھۄٹ، مگر مےٚ اوسُس تَمہِ وَختس پٮ۪ٹھ غصہ۔
کاش مےٚ گژھِ آسِو تَمہِ پٮ۪ٹھ۔
اوہ نہ، باربی کیو کُن خراب کران؟
کیا تُہۍ چھِ کٔرِتھ کوشش تِمِس باسس پنُن طرف ہٕند کِس بیان کرُن؟
مےٚ ہُند مینیجر چھُ مےٚ سٕتۍ سٲری پٲٹھۍ گۄڈ فِیڈبیک دِوان۔
مےٚ کینہہ وقتس پٮ۪ٹھ ڈِنرس لٕگ اٹلیَن ریسٹورَنٹ گٔژھ
مےٚ چھُس یِوان وارٕچِھ بےصبری سان اِنتظار کران
سُہ چھُ کمال، جانور چھِ سَبسٕن بھٲوُک
سُہ لگ بگ ہمیشہ چھِ باہرن کھٲنہٕ آرڈر کران، یہِ چھِ کینٛہہ مٲسن منز پہلِ وار
مےٚ دِتم مےٚ دوستس اکھ نوٚ لُک
مےٚ ہیکان تصور کٔرتھ زِ پہلِ کینٛہہ دۄہ گژھان چھِ بلکل پاگل
مےٚ اوس اَتھ غُصہٕ یِوان زِ مےٚ نَہ ہیٚکان خۄدس سنبھالِتھ
سُہ اوس اَکھ واریاہ حٲران کُن چیز
تِمَن ہٕلٕتھ بدلٲو تٔمِس شیڈول، تہٕ سُہ چھِ نَون حالَتس سٟتۍ میل کٔرتھ مُشکل منز
تِم چھِ اَز تام کوٗشش کران زِ تِمَن ہٕنٛزِ تِم لَڑکٕن ہٕنٛزِ حالَت سمجھن
مےٚ چھُس سَری جاےِ شارٹس پٮ۪وان
مےٚ اوس نہٕ دِل دھُوٕنچ، مےٚ فیصلہ کٔر زِ دوستن سٟتۍ وقت گٕزارٕن
یِم مےٚ سٟتۍ اوس تھٲوان ییلہِ مےٚ اوس دور، تِمَن چھُس مےٚ ابھیٚن ہٕلٕتھ ونان
ییلہِ کینہہ ؤرۍ پٮ۪ٹھ مےٚ آنٹی مُری، سُہ اوس مےٚ سٟتۍ واریاہ دُکھ کُن
اچھا، مےٚ چھُس اُمید کران زِ تُہۍ خٲطرٕ سُہ ساروٕی ٹھیٖک گژھِ
مےٚ چھُس نَہ پَزَنٛد اَندھیر
