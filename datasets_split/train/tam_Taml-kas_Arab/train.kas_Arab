ٹھیک چھُ، سُہ چھُ تریٛن وَرۍ ہٕنٛز، تَہ سُہ چھُ اَکھ بٔڑِیا اِشارٕ
مےٚ کَتھ نَہ کَرِتھ کُنہہ ہُنٛد کار کَتھ نَہ گژھان
مےٚ چھُس ڈَران زِ مےٚ سُہ ضایع گَژھِو
یہ کَتھ وار گژھان چھُ
تُہۍ ضروٗر چھِو بَہت دِلشِکَستہ گژھِتھ
بِیہِ چھُس مےٚ نَو کٲم شُروٗع کَران
کَتھ وار چھُس مےٚ لَگان زِ بہِ کَہنۍ نَہ لَگِہ یِمِہ فلیٹہٕ کَنہٕ باٮ۪ر
مےٚ چھُس اُمید زِ مےٚ مِلِہ یہِ نَو کٲم
واہ، تُہۍ نَہ مٲرِو، یہِ چھُ اَکھ عجیب کٲم
مےٚ نَہ اوس سَوچان زِ سُہ سَمَجِہ
مےٚ دوستَس چھُس پَہل بچہٕ یِوان
ہاں، وقت چھُ بَہت جَلٕد گژھان
ہاں، چھُس سَچ پٲٹھۍ اُمید کَران زِ مےٚ پَتہٕ کَہنۍ نَہ یِہ سُہ مَنٛزس سٟتۍ پٲٹھۍ کٲم کَرُن
زنٛدگۍ منز چھُ اَکھ اَسہِ پنُن کَتھ کَہن وٲلِس اوسُن ضروٗری
لَگان چھُ زِ یہِ کٲم چھُ تُہۍ خٲطرٕ بَہت مُناسِب
کِیا گٔیہِ تُہۍ بَہت پَیٚٹھ لٲگِتھ
مےٚ دوست اوس دیرِ سٟتۍ جاگِتھ تہٕ گٔیہِ فاینل اِمتحان چُھٹِتھ
مےٚ چھُ یاد اوسُن تِہِ دۄہ یِم کھیلَن خٲطرٕ ماہانہ سبسکرِپشن نَہ اوس ضروٗری
اَکھ گرمی منز، ییلہِ مےٚ سارٕ دوست دۄر گٔے، اوس مےٚ اَکیلا پٲٹھۍ لَگُن
ییلہِ مےٚ چھُٹی مَنٛظوٗر گٔیہِ، اوس مےٚ بَہت خۄش لَگُن
مےٚ چھُس سَوچان زِ کینہہ بَچِہ گژھان چھِ یِمِہ دۄرِ سٕتۍ
بہِ چھُس تِہِ ٹرینَس پیٚٹھ اُترِتھ، تِہٕ سُہ یَتھ تام نَہ یِہِ بَرٕی پَتہٕ نَہ چَڑھن
بٔیہِ وار چھُ مےٚ ڈاکٹرَس سٟتۍ اَپاینٛٹمینٛٹ
خۄش، کم اَز کم تُہۍ اَکیٛلاپن محسوس نہٕ کٔر۔
خۄش، مےٚ امید چھُ تُہۍ جلدی گٔژھِو تہٕ تُہنز سفر محفوظ روز۔
مےٚ پَک یقین چھُ امید زِ سُہ گوٚو تُہۍ پرپوز کران تہٕ تُہۍ چھِو وۄنۍ تہٕ خوشی خوشی رۄان۔
یہ چھُ زبردست۔ تُہۍ کیاہ چھِو وَنان، تُہۍ کِتھ کٔر؟
مےٚ امید چھُ زِ تُہنزِ سٲری چیز ترٛٲوِتھ گژھِ۔
بیاہ چھُس مےٚ دوستن خٲطرٕ ڈِنر پارٹی کَران تہٕ مےٚ چھُس خیال زِ سٲری چیز تیار کٔرمتھ۔
تَمہِ سٲری چیز ٹھیک گژھِ۔
سٲری وِزِ پنُن یقین تھاوِو تہٕ دوٚہن ہُند خیال نہٕ دِیو زِ تُہند جذبات تِم طے کَرِو۔
سُہ گژھِو پٲٹھۍ مایوس کُن۔
آ، مےٚ چھُس سُہ پری آرڈر کٔرمتھ۔
کَتھ کَتھ وار خراب چیزِ کُنہِ وجہہ سۭتۍ گژھان۔
مےٚ چھُ امید زِ سُہ منظور گژھِ۔
آ، أسۍ سٲری کَتھ کَتھ وار رشک محسوس کَران۔
مےٚ چھُس خیال زِ سُہ مِلُنک مےٚ چھُ واریاہ اچھا موقع۔
تُہۍ کٮ۪ا آسۍ وۄنُن زِ کینِو؟
تہٕ یِم سۭتۍ پیسہ تہِ بچان۔
خۄش، مےٚ چھُ یقین زِ تُہۍ پنُن سبق سیکھمتھ، ہے نا؟
یَتھ مےٚ گوٚو پنُن بچہٕ سٹرولرَس منز تھٲوِتھ رَژھان، اَکھ سُنہٕ گوٚو مےٚ پَتھ۔
کیا تُہۍ چھِو وُچھمتھ زِ سُہ کِتھ پٲٹھۍ قیمت چھُ؟
یَتھ تُہۍ دور روزِو، تُہنزِ خاص منصوبہٕ کیاہ چھِ؟
تُہۍ کٕنن چھِ کُنہِ بچہٕ کالجس منز پَران؟
سُہ چیز چھِ تھوڑا تھوڑا حوصلہٕ دِن وٲلۍ۔
سُہ چھِ بالکل کُنہِ خاص وقتہٕ ہٕندۍ گۄژھ۔
فائنل میچ تہِ سُہ چھِ واقعی مزٕدار، سٲری کپ آسِ گۄڈ۔
یِم اثر کٔرنس منز اِتھ پٲٹھۍ وقت کیاز لَگان؟
حالٕے منز بہٕ ترٛے مہینَن ججِی ڈیوٹی پؠٹھ آسُس، تہٕ سُہ سُہ چھِ واریاہ دلچسپ تہٕ کِنہِ حدس تِمٲژ۔
بہٕ پیسہٕ بالکل نَہ بچاوٕ ہٕکان، حتا کہ گروسری خریٖدنس پیٹھ تہِ ہمیشہ ژٕیادٕ خرچ کَران۔
میٛانہِ باغس منز چھِ مۄنٛہٕ ہٕنٛدۍ کُھڈ۔
یِمن پٲٹھۍ بہٕ 18 وریٛہٕ ژٕٹ، تَمن پٲٹھۍ میٛانہِ اصل سالگرٕ پارٹی چھِ نَہ گژھان، مگر بہٕ کَتھ نَہ وٲن کُنہِ خاص سوچمت۔
آ، سۄ سُپرمارکیٹس منز پارک کٔرۍ تھٲوُنۍ گاڑِ پؠٹھ ژٕٹ۔
سُہ وُچھِتھ موسمَس منز بہٕ بوزِتھ بٲہَر تہٕ میٛانہِ بچن صحنس منز کھیٚلوان دٕیٚکھ۔
بہٕ گژھٕ ہُتوٛہ کٲنٛہہ خریٖدٕ کٔرِتھ۔
آ، کَنہِ کَنہِ چھِ یہِ واریاہ نایاب چیز۔
بہٕ سکرٛیچ آف ٹکٹہٕ پؠٹھ 100 جیت۔
اوہ، فِکر مَت کٔر، حادثہٕ گژھان چھِ۔
میٛانٛہِ دِلَس منز واریاہ حسد آس، کیازِ بہٕ یِتھ وار نَہ گٔژھِ ہٕکان۔
میٛانٛہِ دِل چھِ واریاہ آس یِہِ گژھِ۔
میٛانٛہِ آس چھِ زِ تِمِس کُنہِ بٲمٲری نَہ آسِ۔
یَتھ وِز بہٕ کالج ترٛاو، تَمن پٲٹھۍ مےٚ مَعلوٗم اوس زِ میٛانٛہِ سٲری چیز گۄڈ گژھِ۔
مےٚ نَہ اوس خیال زِ میٛانہِ گرٛل فرٛینڈ مےٚ یِہِ نِنِ دِوِ۔
مےٚ پَتھ سِگنَل نَہ مِلِتھ۔
اَگر کِسَن ہؠک یِہ زَخٕم دِژ، بہٕ ژور غُصہٕ کَرٕن۔
یِہ چھُ سٕے کھوتَر۔ یِہ چھُ بٔڈ کُتَر یا نَنہ کُتَر؟
مےٚ کَرُنٛ پَژِ—اَس چھُ اَکھ بَچٕہ۔
تُہۍ سٮ۪نٛڈَل دوٙر کٔر یا صِرف صاف کٔر؟
میٛٲنۍ سُپَروایزَرَن مےٚ دٔپتھ تہٕ کٔہ مےٚ پروبیشنَس پٮ۪ٹھ رٔکھنہٕ یِیہ۔
سُہ کِس چیٖزَس سۭتۍ بٔرٕم پٲٹھ؟
یِہ چھُ اَکھ عام مسلہٕ۔
میٛٲنۍ بھانجی چھِ ہؠکہِ دوٙہ وریہِ، تہٕ یِہ چھُ عجیب لَگان زِ یِم کِتابہٕ مےٚ بَچپنَس پٮ۪ٹھ پَرٕن تِم اَس تِہ پَرٕناوان۔
اَز مےٚ کٲمَس پٮ۪ٹھ آسِتھ اَکھ لاٹری ٹِکَٹ نِیِتھ۔
مےٚ چھُ وٲلِو سۭتۍ ڈَر، مےٚ چھِ بیٹمَن فلمہٕ تِہ نَہ ہٮ۪کان دِتھ۔
اوہ یار، یِہ چھُ مےٚ سۄبَن پسند۔
مےٚ ہش کٔر زِ مےٚ ہٕنٛدِ بسترَس ژٕلِ دَل سۭتۍ گُرگُر تہٕ کھَرٕکھَرٕ آواز یِوان۔
پٮ۪ٹھۍ پٲٹھۍ اَندازٕ لَگان چھُ بَہتَر۔
گَژِو ہفتَس مےٚ ہٕنٛدِ والِدٕین خٲطرٕ اَکھ نَو کار کٔنی۔
رٲبطہٕ چھُ اَصل کٲم۔ تُہۍ چھِ تَمس مُتعلِق تَمہِ سۭتۍ کَتھ کٔرمت؟
گژِو دۄہ مےٚ ہٕنٛدِ پُترِ سۭتۍ اَکھ فلم دِژ۔
اَگر مےٚ ہیٚک جانٕوَر بَچاوٕنُک موقعہٕ گژھِ آس، بہٕ تَہٕ کَرٕنٛو۔
نَوِ لوٗکَن سۭتۍ مٮ۪لٕنَس پٮ۪ٹھ مےٚ چھُ بَہت گھَبٕراوان۔
بہتَن چیٖزَن ہٕنٛدۍ قۭیمتہٕ چھِ اَزۍ پٮ۪ٹھ وٲلِتھ، یِمَن رٲستَن مَنٛز سامان وِکْن وٲلَن خٲطرٕ تِہ۔
بہٕر حال، یُس سُہ نہٕ چھُ جانان، سُہ تَس نہٕ کَری نقصان۔
مےٚ چھُ یاد زِ مےٚ چھُ یہِ لَژھمُت بَچپَنَس۔
کیا تُہۍ پنُن فلایٹ پکڑِتھ؟
مےٚ چھُ یِمن وٲلۍ نَوِ شارک فلمہِ خٲطرٕ بوزان زبردست جوش۔
آ، یِمِہِ خٲطرٕ زِ مےٚ اوس اکیلا، تِمَن کٔر مےٚ مدد یِمِہِ خطرناک حالتس۔
سُہ چھِ کُتَن سۭتۍ قدرتی طور ماہر تہٕ تَمس چھِ پنٛنِس کٲمِس پٮ۪ٹھ کمالُک جذبہٕ۔
بٲیہہ اوس بلکل گھُپ اندھیٛر۔
یہِ چھِ کمالُک بنُن۔
مےٚ کٔر یِژھِہ نوکری خٲطرٕ دَرخواست یُس مےٚ کَرن دِ گھرٕ کٲم، کیازِ مےٚ چھُ لوپس۔
مگر تِمِہِ باوجود چھُ یہِ مُشکل۔
مےٚ چھُ دوستُک وٲنُن۔
کیتھ پَتہٕ گٔے زِ تُہۍ پٲٹھۍ نوکری ژٕٹھنُک ضرورت پَیِ؟
آ، مےٚ چھُ مطلب زِ ماریو اوڈِسی اوس کمال، تِکیازِ قسمت آسہِ سۭتۍ سٕمش برادرس تہِ تَتھِ پٲٹھۍ گژھِ۔
مےٚ اوس گھرِس بلکل اکیلا۔
اوہ، شایَد تُہۍ کُنِس چرچَس سٲتھ شامل گژھُن ہاوِو۔
یَلہِ مےٚ چھُ چِک فِل اے گژھان، مےٚ چھُ ہمیشہ مطمئن نِیران۔
یہِ چھُ سمجھِتھ یِوان، سٲتھ چھُنہٕ کَمال۔
مےٚ کٔر پنُن گریڈ چیک، تہٕ مےٚ پاس گٔے تہٕ مےٚ مِلون بی۔
مےٚ دِتھ تَس نٲو یُنگ مُنے۔
مےٚ چھُ کَتھِہ پیٚٹھ یہِ ژٕٹ نہٕ جِتھمُت۔
یِلہٕ مےٚ پنٛنہِ ٹرکَس حادثہٕ کٔر، بہٕ بٔڑ ڈر گٔژھ۔
مےٚ معاف کٔر، بلندی چھِ بدترین۔
تِم یِم سٕتۍ مےٚ خٲطرٕ بنٲون، سٲری نِکٕرۍ ڈرٛٲنگ تہٕ خط بہٕ سنٛبھالِتھ تھاوٕں۔
مگر کینہہ وار چھُ اکیلا رۄن سُہل۔
یہِ چھِ مےٚ زنٛدگی ہٕنٛز سبَس ڈرٲونی تجربہٕ۔
مےٚ گژھان چھُس گمان کہ تُہۍ نہٕ جیت۔
اکھ وٲری مےٚ کٲم ٹٲلیِتھ خٲطرٕ بیمار آسُن ہُنٛد کوٚر جھوٗٹ۔
اوہ، سچِ؟ کیازِ؟
بہٕ چھُس ژھانٛگُل کہٕ سُہ جِم گژھٕ کل، مےٚ چھُ اکھ نیک احساس۔
مےٚ چھُ نہٕ پتاہ کِہ یِم مےٚ کُن گھرَس منٛز چھِ کِمتی۔
کریانہٕ دُکانس منٛز میٚل اکھ دوست، تہٕ مےٚ پنٛنِس بیٹِس سٕتۍ کٔر تٔمس غلَط نٲو سۭتۍ تعارف۔
واہ، مےٚ برادَر اِن لاو تہِ چھُ یِم کران۔
مےٚ کرٛہہ کوشش کہِ أسہِ خٲطرٕ پنٛنہِ پٲٹھۍ زِیادٕ مایوٗس نہٕ گژھٕ۔
نہٕ، بہٕ چھُس نہٕ خاص پٲٹھۍ شوقین۔
مےٚ وٕنِس ۲۰ ؤری پٲٹھۍ تُرکی بازارَس منٛز نیٚرِتھ۔
یِلہِ أسۍ باہَر گژھان چھِ، سُہ چھُ ہر دۄہ گژھان دۄسری بٲلٕن سٕتۍ گَپ کران۔
کیا تٔمِس کُن کانٛہہ قٕسمُک انعام آو؟
تُہٕنٛد چھِ صِرف صُبحُک اوس تہٕ ژھانٛگُل سورُج ساتھی۔
یِم نِنہٕ مےٚ تہِ اکھ ژٕٹن خٲطرٕ دل کران۔
کیا چھُ کانٛہہ تیار یِتھ باہَر تہٕ یِہِ سُہ ٹھیک کرِتھ؟
تہٕ، تُہۍ پَتہٕ لَگۍ کہِ تِم ژٕوٗٹھ بَوان؟
مےٚ سٕنٛز احساس اوس زِ سٲری کینٛہہ مےٚ کَنٛٹرولس منٛز چھُ۔
