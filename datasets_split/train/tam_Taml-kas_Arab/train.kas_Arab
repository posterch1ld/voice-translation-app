ہاں، یَلہِ اَس پُرٲنِ یادَن ہٕنٛز گَژھِ کَتھ، تَلہِ مےٚ واریاہ نوسٹیلجِک محسوٗس کٔر۔
تُہۍ کِژھ وار گَژھِ وٕنُن؟
کِیا تُہۍ سٲریَن ہُنٛد اَپُن اَپُن زنٛدگی ہٕنٛز خبر گژھِ لِتھ؟
کینسَر چھُ اَکھ وَریاہ ہَولناک بٲمٲری۔
میٚٲنِ اَنٛکٕل ہُنٛد اِنٛتِقال گژھِ پَتہٕ تِمَن ہٕنٛز چیٖز وٕچھان مےٚ اَپٕنِ آنٛٹِ سٲتھ واریاہ سُہنٛد وَقت گُزار۔
یہِ چھُ کمال! کِیا سُہ تُہۍ ہٕنٛز ژٕر پٲٹھۍ ڈَرَان آسِ؟
گَژھِ رات مےٚ اَکیٛس بولِنگ اَلی گژھِ۔
یہِ تُہٕنٛدِ خٲطرٕ نَہ چھُ سُہنٛد۔
تُہۍ خۄد بناوُن چاہیئے—آن لاین چھِ بے شمار ریسپی، تہٕ یِہ چھِ دُکانس پٮ۪ٹھ ژٕٹہِتھ چیزہِ کھۄتہٕ بہت بہتر ذائقہٕ دار۔
مےٚ پَزِ گٔژھِتھ ہفتہٕ پنُن فیرٕٹ سُلانا۔
تُہۍ کُن فلم گوٚو دِژھ؟
بِہِ تُہۍ اوسٕ آوٕرِ تام گژھان۔
سٲری مےٚ کُن دِژھان تہٕ ہَساں آسۍ۔
کِیا تِمَنۍ تُہۍ سیورنس پیکیج دِتمُت؟
یِہِ دٕر رۄکھنہٕ خٲطرٕ ہوشیار روزِو۔
مےٚ چھِ گمان مےٚ چھِ کینہہ مناسب بچہٕ۔
نایس گژھِتھ آسِہ پنٕنۍ زَنہٕ سۭتۍ شاپِنگ کران۔
یاد تھاوِو، غم چھُ نہٕ کُنہِ وقت نامہٕ۔
راتہِ منز بیٚیہِ چھُ ہمیشہ کانہہ نہ کانہہ کرُن، تہٕ کھٲنہٕ چھُ کمال۔
واہ، یِہ چھِ واریاہ مہنگہٕ ٹایَر۔
او نہ، یِہ چھِ واریاہ پریشان کُن لٲگن۔
ہے، مےٚ چھِ کینہہ نِکھ خبر۔
تِمِس سۭتۍ گژھُن چھُ واریاہ اعصاب آزمایُن۔
تُہۍ کِنِس قِسمُک خبر گژھِ حٲصِل؟
کِیا چھِ سُہ کُنہِ کٲم خٲطرٕ پریشان؟
مےٚ تہٕ مٮ۪ونۍ بیٚیہِ چھِ ہر کٲم پٮ۪ٹھ گپ کران۔
مےٚ چھِ نہٕ کانہہ دوست تہٕ نہٕ پریوار یِتھِ منز نژدِیک۔
آخرکار، چھُ نہٕ لازِمی زٕ تُہۍ آسِو امیر، یَتھِ خٲطرٕ زٕ تُہۍ ہاوِو بچہٕ۔
مےٚ چھِ یقین زِ تٔمی سُہ تہِ واریاہ مزٕ کٔر۔
بۄس میون والٹ دفترس منٛز روز گٔی۔
آ، تہٕ یہِ واریاہ تٔنگ کُن والہٕ آسِ کینٛہہ کہِ مےٚ پٮ۪ٹھ بیس مِنٹ ڈرٛیو کٔرتھ واپس گٔژھُن پٔی۔
مٲجہٕ بٔنُن چھِ وۄنۍ تہِ مُشکل۔
مےٚ بیٚیہِ بیٚچن والَس سٕتۍ رابطہٕ کٔر، مگر تٔمۍ کِنہِ جواب نَہ دِت۔
مےٚ چھِ خیال زِ بہٕ آز راتھ کَرٕہ۔
مگر مےٚ چھُس جانان زِ سُہ چھُ یہِ کرنس خٲطرٕ پیٚدا گومُت۔
مےٚ اَکھ نٔو سکول شروٗ کٔر تہٕ مےٚ نَہ اوس کٲنٛہہ پٲٹھۍ کِنہِ کلاسنٛز جانان۔
مےٚ چھِ سُہ احساس پَز۪ی، اگرچہِ مےٚ پٲٹھۍ پٔرُن کِرنُن پٔی۔
مےٚ چھِ واریاہ وختہٕ سر درد۔
ییلہِ میون ژٔوٗلۍ میون گَرٕ کِنس خٲطرٕ ژٕٹہٕ۔
مےٚ چھُس رٲضی، سُہ اوس أسۍ خٲطرٕ فخرُک پل۔
مےٚ آز غلط نمبر ڈایل کٔر۔
مےٚ چھُس دوٕ وریٚن پٮ۪ٹھ اکیٛلا۔
