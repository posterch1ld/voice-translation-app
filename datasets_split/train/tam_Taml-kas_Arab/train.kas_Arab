مےٚ اوس واریاہ بُرا لٲگِتھ زِ مےٚ اوس زیادٕ نِنٛدر کٔر تہٕ سُہ گٔژھ مِس
بالکل، مےٚ خٲطرٕ تھوڑٕ ہمدردی تھاو—تُہۍ کیاہ وَنان؟
ہاں، مےٚ علاقس منٛز ویک اینڈس پٮ۪ٹھ کام کرٕنۍ چھِ واریاہ کم۔
مےٚ چھُ سٲری توجہ زَمیٖن صاف تھاون، ری سائیکل کرن تہٕ کم کچرس سۭتۍ زندگی گژھاون پٮ۪ٹھ۔
مےٚ روم میٹ گٔے ب٭ر، اَسہِ چھُس ہُندِس منز اکیلا رٲوان۔
انگورَن خٲطرٕ جیل گژھُن گژھِ تہٕ یہِ چھِ واریاہ خراب۔
مےٚ دوستن چھِ نٔو نائکی جوڑٕ لَتھ۔
تُہۍ گوٚو پٮ۪وان، یہِ چھِ نظر دِوان لایق۔
مےٚ زنٛدگِس منز کَتھٕ ہٕنٛز نَہ چھُس اَتھ پٲٹھۍ پریشان۔
ہاں، سُہ چھُ نَہ ٹھیٖک۔
تُہۍ گوٚو بٲہرِ اکھ ڈبہ تھاوِتھ، اکھ وُڈ سائن لٲگِتھ یُس لیکھتھ آسہِ—‘پنُن گندٕ بٹہٕ یَتھۍ پھینکو۔’
مےٚ چھُس یِمن پٮ۪ٹھ واریاہ غُصہٕ۔
مےٚ منیجرن چھِ مےٚ سٕنٛدِس بارَس منز کینہہ سخت لفظ وَن۔
مگر مےٚ سۭتۍ چھِ یہِ واریاہ کم گژھان۔
مےٚ ہٕنٛد اکھ وٲںٛن روڈ پٮ۪ٹھ ڈرایو کٔر، یَتھ چھُ مجرمن ہُنٛد اکھ لُکُن تھاوُن۔
اگر مےٚ کَتھٕ ہٕنٛز مَردانہ نٲو اَچھ سُنی، یہِ چھُ تِمَن منز اکھ۔
مےٚ چھُس ٹھیٖک، کاش مےٚ ہٲ تِم روکِتھ۔
کیاہ تُہۍ اندر گژھِتھ ہٕیِو؟
برٛونٛہہ، یہِ آو بہتر گژھن۔
تِم چھِ واریاہ مٲجہٕ دار گژھِتھ۔
پَتھۍ راتھ آسمان گژھ بہت ژَٹ سیاہ تہٕ زور دار بارش سٍتۍ ژَڑُن تہٕ ژَڑۍ شروع گژھ۔
وُنِ تام میون پلان چھُ صرف آرام کَرن۔
اگرچہ مےٚ اوس نہٕ پسند
یِلہٕ میون پالُت کچھُو مرِ گٔیو، بہٕ بِلکُل ٹُٹ گٔیوم۔
میون برٛون ماسٹرز کٔر مکمل۔
بہٕ بلکل تازٕ کتھٕکۍ گوبَرِ ہنٛز ڈھیرَس پٮ۪ٹھ پٲٹھ دِژ۔
مےٚ چھِ نہٕ پتہٕ۔
بہٕ اصلن چھُ نہٕ کھیلان زیادہ پَزھان۔
کیا یہِ صاف بریک اوس؟
واہ، نیک تمنائیں! مےٚ چھُ خود MMA پَزھانُن واریاہ پسند۔
آ، یِمۍ وار میون کُٹمُک ہٕنٛز کرسمس گژھِ واریاہ نِیاب۔
یہِ چھُ ۲۰۱۸ ہُنٛد چیلنجر۔
تِم کَتھ گژھان چھِ وِواہ؟
تِمَن ۷ بَجۍ سُہرس کٔر ہتھوڑٕ مارُن شروع۔
لَگن چھُ ٹِکٹُک پیسہٕ وصول گژھ۔ گاڑِ کتھ کِسمُک چھِ؟
پَتھۍ اچانک تِمِس مِلِتھ نوکری، دوست تہٕ یِتھ تام زَن گرل فرینڈ۔
مگر چھُ یِمۍ شامۍ گھرس منز صرف آرام کَرن واریاہ نِیاب۔
مےٚ اوس اُمید یِہ میون پسندیدہ شو گژھِ دوبارٕ شروع۔
میون چھُٹی یِوان چھِ، صرف تَمس پٮ۪ٹھ سوچنہٕ سٕتۍ مےٚ چھُ خوشی لَگان۔
واہ، واریاہ وقت گٔیو۔
ہاں، مےٚ چھُس خیال کران کہ تِمِس عمرس منز یہِ کافی عام آس۔
تِم چھِ اَکھ مُقابلہ کَران تہٕ مےٚ حٲصِل گژھِ زبردست رَدِعمل۔
مےٚ چھُ سِکھمُت پنُن سبق۔
مےٚ حٲصِل کٔر اَتھ نوٚوِس انگریزی دۄیِمِ زبان پٲٹھۍ پَرانہٕ خٲطرٕ سرٹیفِکیٹ۔
مےٚ چھُس نِہ پسند یِوان اَچانک بے خبر، یِمن خٲطرٕ مےٚ چھُس وقتس پیٚٹھ تیار تھاوان۔
مگر چھا سُہ چھِ کُنہِ محفوظ جایہِ؟
سُہ نَہ ہٕکِس یہِ سَمبھٲلِتھ۔
کیا تِمَن نَہ دِتھ تُہۍ دعوت؟
سُنہٕ گوٚل میڈل تہٕ جِمس منز مےٚ نَو۔
کینہہ وِز مےٚ چھُس پنٕنِس رِشتہٕ دارَن پیٚٹھ کَمۍ زِیادٕ بھروسہٕ کَران، یَتھ نَہ کَرُن گژھِ۔
موسمس شروعاتی حِصَس تام سُہ صحت یاب گژھِتھ گژھِ۔
مےٚ کوفی منٛگوٚومُت تہٕ مےٚ آس شکرگُزار، کیازِ تَمہِ کٔر مےٚ سِر دَرد کَم۔
دوستن سٕتۍ مزہٕ کَرنُک اِتھ پٲٹھۍ بِہتر طریقہٕ مےٚ نِہ سُہان۔
مےٚ چھُس بوٚڈ بے صبر تہٕ یہِ سٲری چیز چھِ مےٚ پوری طرح پریشان کَران۔
آج دُکانٕچ یہِ بٲیہِ مےٚ سٕتۍ بار بار فلرٹ کَران آس۔
واہ، اُمید چھُ زِ تُہۍ گژھوٕ کَنہِ سٲری اچھٕ لکھٕن والَن سٕتۍ مِلان تہٕ تِمَن سٕتۍ رابطہٕ تھاوِو۔
سُہ گژھِ اَتھِچ یہِ کَرنُک۔
یہِ چھُ زبردست، ہر چیزُک گۄڈنیار چھُ تھوڑا خوفناک۔
آج رات چھُس تھوڑا نوستالجِک محسوس کَران، بوٚڑِ خاندانی ڈِنر پَتہٕ أسۍ ژٕنہٕ فوٹو تہٕ ویڈیو وُچھ۔
تُہۍ چھِو اَکھ وفادار دوست۔
مےٚ گھبراوان چھُس زِ مےٚ سُہِلی نظرِ منز سُہِ اثر نَہ پَیدا کٔرِتھ۔
ہاں، لاین چھِ نِہایت تَکلیٖف دِوان۔
اوہ واہ، اَگر مےٚ آسہٕ تہٕ مےٚ پولیس کَتھ فون کٔرِتھ آس۔
مےٚ چھُس واریاہ خۄش، مےٚ چھُس یِتھ ویک اینڈ تھرِفٹ سٹور گژھِتھ کینہہ سُہ لباس وُچھِتھ لَبتھ۔
مےٚ گژھِ حېران زِ سُہ اوس اَتھ پٲٹھۍ سُہ۔
گژھِلاس ہفتہٕ مےٚ اوس اَکھ بٔڑ امتحان منز فیل۔
تِمَن چھِ شایَد سَمزھان زِ تُہۍ چھِو تھای خاندانُک حِصہٕ۔
ہاں، مےٚ چھُس اُمید زِ أسۍ نَہ لَبھِو وۄنۍ کِنہہ تہِ تِمَن پٲٹھۍ۔
سُہ چھُس بَس مےٚ سۄن محنت سٕتۍ پَرٕن ہٕچِتھ، تہٕ بَس۔
سُہ اوس تِمِچ اَکھ سُہِلی کھٔلٲڑی یِمَن ہٕنٛز دۄرِ منز۔
مےٚ اوس بالکنی منز کینہہ چِپس کھاوان۔
مےٚ اوس مال منز تہٕ کانٛہہ دٕہ مےٚ پارکِنگُک جاے لُٹ۔
مےٚ اوس چاہان زِ ناشتے منز سیریَل کھاوٕں۔
مےٚ ہٕنٛز گرل فرینڈٕن اوس واریاہ وزن کم کٔرمت۔
مےٚ ہٕنٛز ژھٲرِک چھُ سُہ ہٕنٛز کُتھ راتھٕچ راتھ بھٲنٛکُنی دِوان تہٕ مےٚ ہٕنٛز صحنس منز بیت الخلا کٔرِتھ دِوان۔
مےٚ کَتھٕچ نَہ اوس اَکھ جوڑ۔
اوہ، مےٚ پٲٹھۍ یٲقیٖن کٔر، مےٚ تہِ تَمہِ پٲٹھۍ سٕمٛژھ اوس۔
مےٚ چھُس تِم کَتھٕچ نَہ دٔیکھمت۔
مےٚ ہٕنٛز سٲری کٲم تٔم کٔرِتھ تہٕ دیٚن سمیٹِتھ چھُس سَمزھان زِ مےٚ چھُ دُنیا سۭتۍ سُکون۔
یِتھ انتظار چھُس مےٚ مٲرٕوان۔
آ، مےٚ ڈر اوس زِ تٔم میٚون یاد کٔرِ۔
آج مےٚ چھُس بے صبر زِ پنٛنِس مقٲمی انتخٲبن ہٕنٛز نتیجہ وُچھنس۔
تُہۍ کِس قٕسمُک گژھِو؟
خٲطرٕ، مےٚ چھُ اکھ واریاہ۔
مےٚ پنٛنٮ۪ن دوستن سٕتۍ شوٹنگ مقابلہس منٛز ۲۰ جیت۔
تُہۍ وٲلکیل بَنیٛو یا پولیس منٛز شٲمل گژھِو؟
بٔڈِ سکرین وُچھِتھ مےٚ عجیب محسوس کٔر۔
مےٚ تہٕ تٔمِس ژٕتھ سوچ، مگر تٔمِس ما چھِ بیمار تہٕ ہسپتالس منٛز، یمِس سۭتۍ چھِ اَسہِ نزدیٖک رٔہن۔
کہنُک ضروٗرت چھُ نہ، گھر أسِتھ یِتھ پٲٹھۍ چیز وُچھُن اوس نہ وٕنٛنِہ توقع۔
مےٚ چھُ بٔڈن مکڑن سۭتۍ واریاہ ڈر۔
میٛون بوٗزُر پنٛنِس آرمی رِکرُوٹِنگ سکوٗلس منٛز کٕلاس منٛز اَوٕل نٔبرس پاس گوٚو۔
مےٚ چھُ یقین زِ میون دوست یِیہٕ مانِتھ، تٔمِس چھُ صرف کینہہ سُہلِ سۭتۍ سمجاون۔
میٛون لٔکٹ نٲزِنۍ شروٗع کٔر تیز انگلش ونان، مےٚ گژھِ حیران۔
مےٚ چھُ وُچھمُت زِ تُہۍ سِرِف ٹھنٛڈ روٗدِو، چیز یِیہِ تٔمِس پٲٹھۍ یِتھ پٲٹھۍ گژھٕنۍ۔
مےٚ اوسُس پنٛنِس دوستُکِس بوٗزِس سۭتۍ ڈرم وٲژان، یُس اکھ ماہر موسیقار اوس، تہٕ تٔمۍ ووٚن زِ تٔمۍ پٮ۪ٹھ اثر گوٚو۔
تٔمۍ ووٚن زِ تٔمِس میٚون سۭتۍ خوشی محسوس گژھان چھُ نہ۔
شاید تُہۍ تہِ یِتھ سٕتۍ وٕنٛنِو زِ تُہٕنٛد برٛونٛہہ چھُ واریاہ کنجوٗس، ہاہا۔
مےٚ کٔر پنٛنِہ سوٗیمِنگ ٹرٛنٛک اکھ ژٕٹکِس منٛز ضایع، لوٗکن ہنٛدِس مجمعس سامنٕے۔
یِتھ وُچھِتھ زِ یِمن ہنٛدۍ پٮ۪ٹھ چھُ ساروٕی زِیادٕ پیسہ، تِم چھِ وٕریٚی وٕریٚی جیتان، گوٚو چھُ سُہ واریاہ کَھل۔
کیا تٔمۍ تٔمِس سیوَرنس یا کینہہ تٔمِس دِتھ نوکری پٮ۪ٹھ کٔڈ؟
پنُن ایماندٲری قٲیم تھاویو تہٕ زندگی پنٕنۍ شرطن پٮ۪ٹھ گزارِو۔
اوہ واہ، یہ چھُ بہت سارٕ سکول۔
بہٕ ؤن ہفتن منز ٹرینِنٛگ شروع کران۔
کیا چھِ سۄ کِنہِ گژھمتھ امریکہ؟
یونیورسٹی منز درٛخواست دِوان یا نہٕ، چھِ یہِ اکھ سخت فیصلہ۔
اسہِ کِنہِ کِنہِ یہِ عام سمجھان۔
نَہ، سۄ چھِ سکول گژھان۔
یہِ ؤرۍ میون ضلعہٕ مےٚ ہای سکولس منز ترقی دِت۔
کیا تُہۍ ہولڈ ایم کھیٚلِتھ واریاہ پیسہٕ کمایو؟
مےٚ یاد چھِ ہای سکولس منز آسُن۔
تُہۍ کِتھ پٮ۪ٹھ نہٕ گژھِتھ؟
بہٕ واریاہ غصہٕ گژھِتھ آسُس۔
ٹھیک چھُ، اسہِ سٲری کِنہِ کِنہِ حسد کران۔
بہٕ حالٕے منز نو ہیرکٹ کرایمُت۔
اسہِ ریزربیک فُٹبال ٹیمن ہٕنٛز حمایت کران۔
تُہٕنٛدِس کَنٛہہ قٕسمُک کار چھِ؟
بہٕ سولر پاورَس منز سرمایہ کاری کران تہٕ پنُن نِنٛگٕر فارم شروع کران۔
دلبَراو نہٕ، یہِ چھِ اسہِ سٲرن بہترین لوٗکن سٕتۍ گژھان۔
پنٕنۍ مہم دوران بہٕ کُنہِ طریٖقہٕ دَہ اکھ درجن شُترمرغن ہنٛدِ انڈٕ گِلِتھ۔
کیا تُہۍ تَمس ہٕنٛز بیمہٕ ہنٛد معلومات حٲصل کٔرمُت؟
‘کلاک ورک اورنج’ ہنٛد حَوالہٕ ‘سٹرزک ورک اورنج’ چھُ تازٕ ترین۔
کیا تُہنٛدِ مٲجِس تُہہِ کٔر سٲل یِہ ژٕ وٕنٛدِ چھُو یِہ تہِ پٲٹھ؟
کیا تُہہِ کُنہِ مُشکلِس منٛز پیو؟
مےٚ یِلہِ باسان گژھِ یِہ زِ کُنہِ بچَن ہُند چھُ نَہ پیار کرن وٲل فَمیٚلی تہِ نَہ سٲری ضٔروٗرت، تَلہِ مےٚ بَہت بُرا لگَان۔
مےٚ دوستَن کٔر مےٚ تازٕ تازٕ سٕنٛز وٕنٛدِ منٛز دعوت۔
اوہ مےٚ خدا، سُہ چھُ ضروٗر شرمندٕ کُن آسُن۔
یتھ چھُ بَہت شُر۔
تُہہِ نِہِ تھَکان آس یا کُنہِ بیٚیہِ کِس؟
تُہہِ کُتھ چھِو زِ سُورُج چھُ وٕنٛدِ اُٹھمُت؟
کیا تُہہِ تھوڑِ حسد گژھان؟
مےٚ چھُ سٕہ پٮ۪ٹھ اِتھ پٲٹھ غُصہٕ زِ مےٚ ہیکہٕ چیخُن۔
تُہنٛدِ زنٛدگی منٛز کیاہ چھُ ٹھیٖک گژھان؟
گژھِ ہفتہٕ مےٚ کٔر پنٛنِس بٲیِس ہُند ژٕٹہٕ سٕمبھالن، مےٚ آو بَہت پسند۔
سُہ چھُ تَمہِ پتہٕ مٔرِتھ، تِلہِ مےٚ آو سُہ بَہت یاد۔
کیا تُہہِ گوٚو تَتھ یِم حیران کرن؟
یِہ چھُ لَگان زِ أسۍ دۄنوٕن ہُند بچپن چھُ آسُن زبردست۔
سُہ نَہ آس بَہت ٹھیٖک۔
مےٚ چھُ شرمندٕ زِ مےٚ کٔر سکول ترک کونسٲرٹَس گژھن خٲطرٕ۔
تَمہِ پتہٕ یِلہِ بہٕ باجِر وٕچھان چھُس، مےٚ چھُ اعتماد زِ مےٚ چھُس پنُن پٲٹھۍ زیٛادٕ محسوس کران۔
مےٚ چھُ لَگان زِ مےٚ وٕنٛدِ چھُس گۄڈٕ کمرِ منٛز بھوتُک آواز سٕنٛد۔
یہِ چھُ بنفشی رنگُک ہٕک شیڈ، نہٕ؟
بہٕ چھُس سُہل جِم گژھتھ حیران گژھان۔
تِمِس طریٖقہٕ سۭتۍ بہٕ چھُس واریاہ سیّاح مٕلِتھ۔
مٲرِس ساتھی ہٕنٛز پٲٹھۍ اوس کھنٛچ گژھتھ۔
مےٚ چھُس سمجھان زِ تُہۍ گوٚو مختلف کھٲنۍ آزماونس تہٕ پتہٕ لٲگُن کُنہِ سۭتۍ تُہۍ چھِو پریشان۔
مےٚ چھُس خیال کران زِ یِلہِ وۄنۍ گژھِو، بہٕ دِیٛہٕ تِمِس سۭتۍ گۄڈٕ ٹِپ۔
آ، کَہہ گنٛٹہٕن پَتہٕ سُہ ٹھیک گژھ۔ اَسۍ فین ہٕنٛز نٔزدیٖک بٲٹھِتھ ٹھنٛڈ تول استعمال کٔر۔
آ، چھُس اصلن کٲنٛہہ وٲر گٔمٕت۔
تِمۍ مےٚ اکھ پیٖر دِوان لحاف پٲٹھۍ کٔرِتھ روان کٔر۔
سُہل چھُس پنٛنِس باتھ‌رومَس منٛز اکھ بٔڈ مکڑ دِتھ۔
کیا تُہۍ سُہ ڈکِتھ تھٲو یا تِمَن ہٕنٛز خبر کٔر؟
آ، مگر تِمِس وِزِ سبَن اوس اُمید زِ بہٕ کم از کم پاس گژھٕہ۔
تُہٕنٛدِس برٛونٛہہ کِیاہ پَرن؟
مےٚ چھُس یژھان زِ تِمِس خٲطرٕ کٔرِتھ جبرٕ کٔرُن۔
آ، یہِ چھُ سۄ نمبر چیٖز زِ یہِ نہٕ بھولُن۔
مٲرۍ نٲنِس چھُ سٹیج ۴ کینسر تشخیص گژھمٕت۔
کَنہہ لوٗگن منٛز چھِ واقٔعی کمال ہُنر۔
شاید نٔزدیٖک اوس کمرہٕ یِمن دِتھ مٕژ۔
یہِ اوس مٲرِس زنٛدگِچ سۄبہٕ کھۄتہٕ لَمب انتظار۔
مےٚ چھُس سُہل نوکری ہٕنٛز اِنٹرویو۔
مےٚ چھُس خیال کران زِ بہٕ یہِ کٲم زبردست طریٖقہٕ سان کرٕہ۔
مےٚ چھُس نٔو گَرِ خٲطرٕ دٔرخواست دِتمٕژ، تہٕ مےٚ چھِ اُمید زِ یہِ مےٚ مِلِ۔
مےٚ چھُس ژٔے مہینن پیٹھ بے روزگار۔
آہ مےٚ، بہٕ حیران گژھِتھ آسٕہ۔
یِمن سۭتۍ مےٚ ہُنٛد بے چینی تہِ پٲٹھۍ کَم گٔے۔
مےٚ چھُس نٔو بٔڑِ سکرین آرڈر کٔرمٕژ تہٕ سُہ چھِ اَز یِوان۔
مےٚ چھُس پٲٹھۍ پٲٹھۍ آن لایِن پٮ۪ٹھ اَن جان لوٗکن چیزِ فروخت کرنس خٲطرٕ واریاہ اوپِن گژھُن یژھان۔
کاہ شوق آسُن چھُ ہمیشہ گٔڈ۔
تِم چھِ بندوقن ہُنٛد دیوانہٕ، تُہۍ کِیاہ اُمید کران؟
تَمہِ سۭتۍ گپ شپ کرُن چھُ مےٚ ہمیشہ خوش کران۔
مےٚ چھُس خیال کران زِ اَزِ کٔنِس پَتہٕ بہٕ یہِ کٔرِتھ ہٮ۪کان۔
تِم چھِ واقعی تَتھ، تِمن ہلکٕچ نَہ گژھِتھ۔
نَہ، سُہ چھُ زَخمس پَتہٕ مُت۔
آ، تہٕ نشہٕ کرن وٲلن سۭتۍ دور رَہن تہِ چھُ ہمیشہ گٔڈ۔
تُہۍ چھِو آخری وار گژھان؟
مےٚ چھُس پَک یقین زِ سٲری کُنِس تہِ یہِ پَتہٕ لٲگِتھ آس۔
کم از کم تُہۍ چھِو وُنِس ٹھیٖک۔
سُہ آیہِ مُعاملِس پٮ۪ٹھ گٔڈ وٲری۔
ٹیکساس منٛز ساوُتھ پادرے جزیٖرٕ۔
یِمن کٔنۍ اکھ ماج آسُن چھُ واریاہ کمال، یَس پٮ۪ٹھ بھروسہٕ کٔرتھ ہٮ۪کِو۔
ٹھیک، یِمہٕ کِتھ پٲٹھۍ قیمت ٲس؟
تُہۍ وٕنۍ بِلۍ ہٹٲوِو؟
بہٕ ٹیٖلیوِژن پؠٹھ اولمپِک اَلہٕپٲین سکیٖنگ دٕژھان ٲسٕس۔
یِمِس علاقس منز بہٕ روزان چھُس، سُہ چھُ اَکھ اَندھیر بَنٛن علاقہٕ۔
مےٚ بَڑِ ترٛیش چھُس یہِ زِ بہٕ زیادٕ وۄتھ سُتھ تہٕ سُہ گۄڈٕ چھُٹِ۔
کیا تُہۍ تِمن کینٛہہ وُچھ؟
مےٚ حٲصِل گژھِ پورٕ خرچس سۭتۍ سکالرشِپ پنٕنۍ خوابن ہِنٛز سکولس خٲطرٕ۔
پٮ۪ٹھۍ پٮ۪ٹھۍ کینٛہہ سَہل۔
سُہ چھُ سُہ، کیازِ تُہۍ تَمس خٲطرٕ تیٲری کٔر ٲس۔
کۄوٗہہ روٗز پٮ۪ٹھۍ بہٕ اَجنٛبی جایہِ گٲڑِ چَلاوان ٲسٕس تہٕ بہٕ گۄڈٕ گژھِ گُم۔
سُہ چھُ اَکھ نیک اِنسان۔
یہِ چھُ سچ، بہٕ وٕنۍ ہاے وے پؠٹھۍ گٲڑِ چَلاوان گٲنے اَیکان مست چھُس۔
یِتھِ بہٕ روزان چھُس، تِتھِ پٮ۪ٹھۍ سُہ چھُ لگ بھگ اَردھ گَنٛٹہٕ دور۔
مےٚ چھُس غُصہٕ کیازِ ییلہٕ مےٚ ہِنٛز وار ٲس نہٕ مےٚ کینٛہہ سٮ۪رِوِس مِل۔
نَوِ بہتری سۭتۍ بہٕ چھُس واریاہ خوش۔
سُہ چھُ سۄیٖنہٕ پریشان کُن، خاص کٔرِتھ ییلہٕ تِم زیادٕ کھاون تہٕ کھۄر وٲستاوُن۔
ییلہٕ مےٚ برٛوٗنہٕ دوٗر گژھِ، تیلہٕ مےٚ دِل دُکھ۔
سُہ وُچھُن ٲس عَقلمٕندی یِمِس اِستعمال کٔرمٕتھ ٲس۔
کاہہ عجب نَہٕ، سُہ ٲس واریاہ خۄبصوٗرت۔
بہٕ چھُس بیٖر تہِ نَہ پٮ۪وان۔
سُہ واریاہ وقت اوس
واہ، یہ کِتھ بڑا چھُ؟
یِمو سکولہٕ خٲطرٕ کولوراڈو گژھن، مےٚ دوستن مےٚ تِہٕے گژھِتھ دِتھ
یِتھ پٲٹھۍ مےٚ بوزِتھ ہیکان
تہٕ سُہ واریاہ افسوسُک چھُ، مےٚ اُمید چھِ تُہۍ تمنٛز پَتہٕ یِکجُٹ کَرتھ ہیکیو
مےٚ تصوُر تہِ نَہ کٔرِتھ ہیکان زِ سُہ شخص کیازِ سُہ کَرِہ
سُہ مےٚ واریاہ دِل خراب کَران
کیا تُہۍ نَو پالتو جانور گژھِتھ، یا ابھی چھِ ژھٕٹ؟
مےٚ لگٕ چھُ مےٚ بوٗی فرینڈ چھُ کُنہِ دۄیہِ سۭتۍ گژھان
سُہ پیٹھٕ واریاہ شرارتی اوس
کیا تُہۍ جمع کرن وٲلۍ برتن منز کینہہ پیسہ دِتھ؟
مےٚ کوٗشِش کٔر زِ مےٚ مثبت روزِتھ تہٕ سُہِ اچھُر پاسُہ وٕچھِتھ، مگر پتہٕ مےٚ واریاہ کھجلی گژھِ
مےٚ تِہٕے یِہِے سوچِتھ اوس
مےٚ اُمید چھِ زِ اَسہِ کینہہ تہِ نَہ وٕچھمُت
آ، مےٚ وٕچھان ہیکان زِ سُہ کِتھ کَنٛہہ پریشان کَرِتھ ہیکِہ
مےٚ دوستن چھُ اکھ بوٗز، مےٚ یَتھ وار سُہ وٕچھان چھُ سُہ مےٚ پٮ۪ٹھ محبتہٕ حملہ کَران
کیا یِہ وِنڈو ٹھیک کٔرُن چھُ مہنگا؟
تُہۍ تِمۍ فون کِیازِ نَہ کَران؟
کیا تُہۍ پتہٕ نِندرِ گژھِتھ ہیکیو؟
یِہ چھُ سارنٛی وَرۍ یِمن بناومُتَن منٛز سَبہٕ کھۄتہٕ بیٚہتر
مےٚ تہِ تَمہِ خٲطرٕ انتظار نہٕ کَران۔
مےٚ اُمید چھُ کہ تُہۍ اکھ بہترین سکولس منٛز واپس گژھان چھِو۔
مےٚ چھُ سُہ پسند زِ میٛٲنۍ بچہٕ چھِ وٕنِہ گھرچِ کٲمِس منٛز مدد کَران شروٗع کٔرمُت۔
اکھ دۄہ گٔے میٛٲنۍ گاڑِ تھٲوِتھ پولیس آفیسرن مےٚ گاڑِ ہٕنٛز باژٕ نِکٕلِتھ کٔہ۔
یہِ چھِ تقریباً دۄگُنٕہ یِم مےٚ وٕنِہ کمٲوان۔
ڈیٹَس پیٹھ کیا گٔیو؟
آ، مےٚ چھُ تہِ تَمی اُمید۔ یہِ چھُ اکھَے وقتس منٛز پُر جوش تہٕ ڈراون۔
میٛٲنۍ زوجہٕ چھِ أسۍ ہُنٛد پہلے بچس سٕتۍ حاملہٕ۔
گٔے دۄہ مےٚ ڈِٹھ اکھ گاش یُس پنٛنۍ گاڑِ منٛز سٹاپ لایٹس پیٹھ نٲک کَڈان اوس۔
مےٚ تہِ گژھِ آسُن زبردست غُصہٕ۔ تِم ہٹاونہٕ چھِ گژھان مہنگا۔
شاید تُہۍ گژھِو اکھ ٹیمپ ایجنسیس۔
بالکل، سُہ اوس میٛٲنۍ سٕبس زیٛادٕ پسند پالتو جانور یُس مےٚ کینہہ اوس۔
مےٚ گٔے اکھِس کۄرس سٕتۍ ڈیٹَس پیٹھ تہٕ تمۍ میٛٲنۍ سٕتۍ کٔہ زِ ڈیٹ گٔے سُہل۔
گٔے دۄہ مےٚ ڈِٹھ اکھ گاش یُس ہاتھ نہٕ دُھووِتھ باتھ روٗمس نِکٕل۔
یِم دۄر چھُ تِمِس دوران تُہۍ کیاہ کَرِو؟
یہِ حٲصِل کَرنہٕ خٲطرٕ مےٚ کٔر زبردست محنت۔
سُہ چھُ زبردست۔ مےٚ چھُ اُمید زِ تُہۍ نہٕ زَخمی گژھو۔
مےٚ گژھِ سُہ بچٲوُن یُس مےٚ بچٲوِتھ ہٮ۪کان تہٕ پھِر اگلی سیزنس طرف گژھُن۔
اچھا، مےٚ نہٕ ہٮ۪کان سَمجھِتھ تَتھ منٛز مطلب۔
مےٚ چھُ سُہ تیار زِ بیچس پیٹھ گژھِتھ۔
آ، مےٚ پنٛنِس اٮ۪کسَس مٮ۪سیج کوٚر تہٕ أسۍ تُہۍ وقتن ہنٛدِس بارے منز گژھان گفتگو۔
کاش مےٚ سُہ لٲگِتھ سُہ کَرنِس سزٲ دِتھ ہٲوٕن۔
اوہ، ژٕ چھُ سٲریو کٔرمُت، یہِ چھُ کمال۔
شُکریہ، سُہِ کٔرٕ کٔنۍ مدد تِم حالتس منز۔
مےٚ چھُ نَو گَر خرٕد کٔرمُت تہٕ یہِ سوموار گژھٕ سُہ رجسٹر کٔرُن۔
مےٚ چھُ کَپٕڑ تہٕ کھٲنہٕ دان کَران۔
مےٚ چھُ کینہہ پچھتاوا، کیازِ مےٚ چھِ نہٕ واریاہ لُکھ یِم سٕتۍ گژھِتھ ہٲوُن۔
مےٚ سُہ اٮ۪ک اٮ۪ڈاپشن رٮ۪سکیو سٮ۪نٹر ہٕنٛز آوُر۔
آ، آخرس منز أسۍ دۄنٛۍ بچ گژھ۔
مےٚ چھُ نہٕ پتاہ زِ مےٚ چھُ ہٲوُن موجودہ کَمائی پٮ۪ٹھ زیادٕ کَمٲوُن یا نہٕ۔
یہِ چھُ زبردست، ہے نہٕ؟
تُہۍ کُن شہر گٔوٕتھ؟
اچھا، مےٚ چھُ سٕمژھان زِ تَتھ چھِ سٲریو گٲلِین ہٕنٛز کُٹُم رَوان۔
مےٚ آوٕ پارکَس منز۔
یہِ اوسُس خٲطرٕ واریاہ کَل بٲتھ۔
