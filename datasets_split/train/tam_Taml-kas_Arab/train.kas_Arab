مےٚ چھُس سمجھان زِ مےٚ کٔرِتھ گۄڈٕ وقت لگان وول کم، تاکہ مےٚ سُہل محسوس کٔرِتھ ہیکہٕ۔
تُہۍ چھِ بہت پیارِو، تہِ یہِ چھُ سُہل مزٕ دار لَگان—مزٕ کٔرِو۔
یَلہِ مےٚ اوسُس لُکُٹ، تہِ مےٚ آس جوش یِوان یَلہِ مےٚ سُہ پَتہٕ لَگ زِ مےٚ ہٕند دوست گَرِ یِتھ کھیلی ہیکہٕ۔
تہِ مےٚ چھُس پَک یقین زِ لمبی ڈرایِو کٔرِتھ گَرِ پَتھ یِتھ چھُ بہت سُہل لَگان۔
تَمہِ خٲطرٕ یہِ کَرُن چھُ بہت نیک کم۔
مےٚ تہِ، مےٚ چھُس سود دِنہٕ ناپَسند کران۔
کم اَز کم سُہ ہٕند باس اوس سُہل؟
تَمہِ چھُ ہمیشہ پنٛنِس ماجِس پٲٹھۍ بہترین بَننٕچ کوشش کران۔
مےٚ چھُس جانان زِ تُہۍ چھِ ڈران، مگر یہِ اوس تُہۍ کٔرِتھ انتخاب؛ اَتھ پَتہٕ تُہۍ چھِ اَمس ہٕندِ نتیجَن سۭتۍ مقابلہٕ کٔرُن۔
پَران کَتھ کَتھ چَلان چھُ؟
مےٚ اَز چھُ اَکھ پارسَل مِلِتھ۔
اَگست ۲۰۱۶ منز ٲسۍ اَسۍ وٕنٛکۍ گَرٕس پَتھ آمتۍ۔
مےٚ سۭتۍ تہِ چھُ یہِ سُچ، مےٚ چھِ أکھ ۱۷ تہٕ أکھ ۱۹ ؤرۍ یِم۔
تُہۍ کِیا وَنٛدۍ چھِ، یِمن کِیا گوو؟
بُلہِتھ گژھن چھُ آسان۔
مےٚ چھُ یقین زِ اَز چھُس یہِ ٹورنامٮ۪نٛٹ جیتان۔
تُہۍ چھِ سٲری راتھ جاگرِتھ پَران کَرُن۔
اَخرکار چھُس مےٚ موقعہ مِلان زِ یونیورسل سٹوڈیوزس منز ہیری پاٹر اَٹریکشن گژھِتھ۔
ہاں، یہِ چھُ مےٚ یاد دِوان سُہنٛد تہٕ سادٕ وقت، تُہۍ وَنِو۔
مےٚ تہِ چھُس پنُن کَمرا گَندٕ تھاوان۔
اُمید چھِ زِ تِم کٔرِو تُہۍ مدد مُستقبلس منز۔
مےٚ چھُس خۄش زِ سُہ چھِ پنُن قدر ژٲنٛتھ تہٕ وٕنٛدِ تعلیم حٲصِل کَرنہٕ گژھان۔
مےٚ دٕچھ اَکھ مانٛس اَکھ مُٹھی کاکروچ کھٲن۔
سُہ گٔیو ؤری سٲری سٲری مُشکل دۄرۍ گژھان، مگر اَخرکار سُہ کامیاب گوو۔
مگر مےٚ چھِ نَہ واریاہ دوست۔
مےٚ چھُس انتظار کَران زِ کینٛہہ یِیہِ۔
یِتھ دۄہ کَنٕہہ چھُس مےٚ نَہ کَتھ کٔرمُت۔
یہِ چھُ عقلمندی، مگر کُلن کچنس منز اکیلا گژھُن دِیُن چھُ غیر ذمہ دارانہ۔
یار، تُہنٛد خوراک چھِ تُہۍ پیٚٹھ کِتھ پٲٹھۍ اثر کَرِتھ شَکان، یہِ چھُ واریاہ حیران کُن۔
کیا یہ تُہُنٛدِ زِندگی ہُنٛد پہلِ پروموشن چھُ؟
تُہُند زبردست دوست چھُ۔
زیور کیٛاہ چھُ دِژھان؟
اَزکَل میٚ چھُس خوف محسوس کران۔
تہٕ میٚہِ چھُس تُہُنٛد خیال کَران، گویا یہِ کلُک واقعہ اوس۔
میٚہِ چھُ یقین زِ تَمہِ ہُند بوٗنٛد زبردست اوس۔
شاید تِمَنِ زندگی ونٛٹٕہِ کَرٕنہٕ خٲطرٕ کُنہِ عاشق لَبھِتھ۔
خاص کر ییلہِ بہٕ چھُس چھُٹۍ پٲٹھۍ گژھان۔
کَتھِ کَتھِ میٚہِ چھُس گَرِ اکیلا، بور گژھان تہٕ سٲری اکیلا محسوس کران۔
میٚہِ چھُ یقین زِ سُہ کرِ؛ سٲری چیٖز چھِ ہمیشہ بہتر گژھان، فکر مَت کٔر۔
یہِ ریاضی ہُنٛد ٹیسٹ اوس۔ میٚہِ اوس زبردست محنت کٔرتھ، مگر اَز چھُس بہٕ بلکل الجھان۔
یہِ چھُس میٚونٛد دوٚیِم بچہٕ، تہٕ میٚہِ چھُ دۄبارٕ حاملہٕ گژھنہٕ منز دِقّت۔
میٚہِ چھُس نہٕ کَدٕنہِ اتھ کَتھ گژھِ موٚٹَر چَلاوٕمُت۔
شاید ژھٲ دوٚپ بیٖر ہٲو، تہٕ أسۍ گیم ہٕند نظارہٕ کٔرِو۔
میٚہِ اوسُس تُہِ دِژھنٕچ بےصبری سان اِنتظار۔
اَز چھُ یہِ پٮ۪ٹھہِ کَتھ پٲٹھۍ زیادٕ اہم۔
میٚہِ چھُس بَہارِ منز کالج پاس کٔرِتھ، تہٕ میٚہِ اوسِس یِم نوکری ہٕنز اُمید۔
یہِ چھُ نہٕ اَتھ وٲںٛگ۔
کیا تُہۍ چھِو یہِ اکثر لیٖوان؟
گژِتِس سال ییلہِ میٚونِ دۄنُو بَچٕ سکوٗلِ منز ٲسِ، کَتھِ کَتھِ میٚہِ گَرِ اکیلا لَگِ۔
پہلے کٔدی تہِ یہِ نَہ حاصِل گژھِتھ
سُہ اَسی سٲٹھ وُہرسَن ہُند نِمِس منز ٲس
ییلہِ مےٚ دوست پیسہٕ اُدھار لۄگُن چاہان ٲس
یہِ مےٚ گرٛیجویشن خٲطرٕ ٲس
پٲلَن پوشن خٲطرٕ سُہ مےٚ پٮ۪ٹھ چھُ بَہتَم دارومدار کَران
تُہۍ یِمِس مُتعلِق بَہت پُختہٕ آواز دِوان چھِو
یہِ اوس ٹرٛک یِم مےٚ چاہان ٲس، تَمہِ چھُ مےٚ حَسد گژھان
مےٚ چھُ بَہت خوش، کیازِ مےٚ چھُ یہِ ڈورِٹوز تہٕ ماؤنٹِن ڈیو ژٕنِتھ خٲطرٕ ضرورت
مےٚ چھُس آرام محسوٗس کٔرُن چاہان
مےٚ وُچھان، یِمِس منز چھُ ڈیڑھ مہینٕچ
ٹھٕیک، سُہ شایَد چھُ کوٚرُن ژوٚٹ
مےٚ چھُ یاد، ییلہِ پیسَن ہُند کینہہ مول ٲس
زِندگی منز چھُو لازِم زِ ہمیشہ پُراعتماد روزِو تہٕ خطرٕ لیوِو
ییلہِ مےٚ ڈاکٹرَس کٔن گٔیوس، مےٚ سُہ یقین دِوان ٲس
ییلہِ سُہ گژھان چھُ، تیلہِ چھُ والِدَینن بَہت خراب لَگان
تُہۍ گژھِو یہِ ضروٗر کٔرِتھ
مےٚ چھُس سٲری آئس کریم کُل سَمے کھٲوان، پَگاہ مےٚ بچن ہٕنٛز وارٕ یِوان
کینہہ وٲرۍ چھُو اَکیس بَہت کینہہ کھٲتھ بَسُن
یہِ چھُ بَہت خراب۔ تُہۍ چھِو پَکّہٕ کہِ سُہ دۄد ٲس، نَہ کینہہ بیٚیہِ؟
مےٚ پَتہٕ لَگِتھ کہِ مےٚ بِلّی چھِ خرگوش ہُند گوٚشت آسِتھ کھٲنۍ پسند
اچھا، تُہۍ یِتھ پَنُن ٹھیک سمجھو، تِتھ کٔرِو۔
اگر تُہۍ خاندانس منز بھروسہ نَہ کٔرتھ ہیٚو، تِہ کَس پٲٹھۍ کٔرِو؟
مےٚ نَہ آسہٕ یژھان اندر گٔرِتھ۔
مےٚ چھِ اکھ اِمتِحان یِوان۔
مےٚ آیہٕ ژٕوٗر غُصہٕ، کیٛازِ تِمَہ مطلب آس سٲری کٲم مےٚ کٔرُن پَڑِ۔
مدد خٲطرٕ ٹیٚلیوِژن آن تھٲوتھ کٔرِو کوشش۔
آ، یِم چھِ تٔمِس آخری حالتس منز کٔنہٕ نٔظر گٔژھان، یِہ چھِ کَتھ مشکل۔
کیا تِمَن کٔر کینہہ یِم ژٕٹہٕ دِوان آسِ؟
کینٛہہ لوٗکھ چھِ یِژھان ژٕنٛگ بٔڑنہٕ پتہٕ دور گژھِتھ۔
مےٚ چھُس پنٛنِس کریڈِٹ سکوٗرس پٲٹھۍ زٕوٗر خۄش۔
مےٚ ہیٚکہٕ اکھ ژوٗر تہٕ اکھ کُنٛہہ ریس کٔرتھ۔
مےٚ چھُس پَنٛنِس محلہٕ منٛز گَژھان ڈَران۔
مےٚ کَران چھُس ہَفتس منٛز ژور دۄہ ورزش۔
تِہ اگر مےٚ ہٕنٛد پٲنۍ ٹوٗٹِتھ آسِ، مےٚ آس تیار گژھنہٕ خٲطرٕ۔
سُہ چھِ وٕنۍ مےٚ خٲطرٕ صفٲی کٔران تہٕ رٲندھان تہٕ مےٚ ہٕنٛدۍ کپڑٕ دھوٗن۔
یِتھ چھُس محسوس کٔران زِ یہِ سٲری کٲم سٲرتھک گٔی۔
کیا تُہۍ پنٛنِس دوستس سۭتۍ وقت بدلِتھ ہیٚو؟
ٹھیک، تِتھ کِتھ وقت لَگ؟
کاش مےٚ ہیٚکن آسِ تِمِس پٲٹھۍ بہتر اسایمنٹ مِلان۔
اوہ، یہِ چھِ مزٕدار لَگان۔
تۄہہِ آخری وٲلۍ سۭتۍ مےٚ تجسس جاگ ہا ہا
گژھان ہر ؤری مےٚ کرسمس متعلق چھُس واریاہ پرجوش تہٕ مےٚ چھِ سارٕے منصوبہٕ
آ، مگر یہ چھِ واریاہ مایوس کُن
مےٚ یہِ ہفتہٕ آخر ژانورٕن ہُنٛد پناہ گاہس منٛز رضاکارانہٕ کٲم کٔر
مےٚ ویگن چیز تہِ چھُ ملسان، یہِ چھِ واریاہ ذٔلت دار
مےٚ یہِ روز چھُس پیٚران
مےٚ چھُس پنٛنہِ حالیہ زنٛدگی سۭتۍ مطمئن
یہِ کُن خاص محفوظ جاےِ منز نمٲیش کٔرِتھ تھٲو تاکہ تُہۍ روز یہِ دٔژھِو
آ، مےٚ چھُس ۱۰۰ فیصد متفق
ساحلن ہُنٛد دورٕ کٔرُن اوس کمال
مےٚ چھُس پنٛنہِ زنہِ سۭتۍ دغا کَران
جِم گژھن شروع کٔرنُک اصل وجہ اوس تھوڑا آرام کٔرُن
یہِ چھِ واریاہ سلیٖک تہٕ یہِ ڈرٛایِو کٔرِتھ چھِ مزٕ
مےٚ نَہ اوس وقت پنُن کانٹیکٹ لینز ژٲرِتھ
امید چھِ تُہۍ نوکری حٲصل کٔرمتۍ ٲسِو
مےٚ دفترس منٛز اکھ وُچھ پروجیکٹ خٲطرٕ رضاکارانہٕ کٲم کٔر
مےٚ چھُس پنٛنہِ زنہِ سۭتۍ وُہنہِ ؤریٚن پٮ۪ٹھ وۄںسٹھِ ؤریٚن ہُنٛد شٲدی شُدٕ
مےٚ وۄنۍ وۄنۍ اکھ دوست یُس مُشکل وقتس منٛز اوس، دٔتم پنُن بالکل نو کار امانت
تٔمۍ مےٚ کٔہ کہ مےٚ گژھِتھ بدل چیز ہٲصل کٔرِتھ ہٲو
یہِ چھُ اکھ بُلند مقصد، مگر اگر تُہۍ محنت کٔرو شاید تُہۍ یہِ حٲصل کٔرِو
مےٚ چھُس خیال کران زِ اَسَن منز واریاہ چھِ اندھیرِس پَزِ ترٛاوان۔
اوہ مےٚ، تُہۍ کِتھ پٲٹھۍ نہاونس تہٕ بیت الخلاء استعمال کَرِو؟
مےٚ چھُس روان گژھن ہٕنٛز بابتھ بلکل بےچین گژھان۔
کیا یہِ چھُ اَکھ سُہ سودا، یا اضافی پیسہ دِنُک لایق چھُ نہ؟
کیا تُہۍ ہٕنٛز خوف آس زِ تُہۍ نَہ جاگِو؟
مےٚ شَہرُک زندگی یاد کَران۔
کَنٛہِ کَنٛہِ تُہۍ تَمہِ کِچھ نَہ کَرتھ ہٕیٚکِو۔
گژِت ہفتہ آخرس مےٚ نیو یارک گٔژھِتھ۔
ہمیشہ چھُ نہ، مگر اداس روزنس پٮ۪ٹھ یہِ چھُ بہتر۔
نَہ، بلکل چھُ نہ۔
تہِ چھُ اَکھ مزٕدار ہفتہ آخر لگَان۔
کینہہ ہفتن پیٚٹھ مےٚ اُڑِتھ گژھِتھ پنٛنِ گرل فرینڈس سیتھ ملاقات کَران۔
یِلہِ مےٚ پنُن زٕوٗن ہفتہ آخرس خٲطرٕ گَرِ منز اکیلا تھٲوِتھ گٔژھ، مےٚ اوس یقین زِ سُہ ذِمہٕ دارۍ سۭتۍ برتاؤ کَرِ۔
پیپر بوٚے نَے اخبار زورٕ سۭتۍ پھینٛگِتھ میون کھڑکی توڑ۔
کیا چھُ تُہۍ سمندرَس پَزِ ترٛاونسُک کُنہِ خاص وجہ؟
تہِ دۄہ مےٚ اوس پریشان، یِلہِ مےٚ پنُن بچہٕ پریکٹسس پٮ۪ٹھ نِنہٕ خٲطرٕ وقتس گَرِ ہٕنٛز نَہ پٔز۔
یہِ چھُ یٮ۪لو ورژنُک ریمَسٹَر۔
یِلہِ میون ماجہٕ بیمار گٔژھ، مےٚ اوس براہِ محسوس کران۔
آ، یہِ چھُ مُشکل، مگر تِمن خٲطرٕ چیز آسان بناونہٕ خٲطرٕ یہِ چھُ مُول۔
مےٚ نَہ چھُس جانان کٕہ کُنُہ اوس زیادٕ ڈراون—سُہ بھوت اوس یا اندر اوس اَتھ کُنہِ۔
مےٚنِس ایکس گژھان چھُ گفتگُو کرنہٕ
اگر یہٕ گوو تہٕ جج شاید زٕبردست ہنسِتھ تُہۍ تھوڑی رعایت دِتھ سُہ
اَسہِ اصلس منز تِتھ نزدیٖک نَہ آو
مےٚ چھُس پَتہٕ ۵ والیٹ واپس دِتمٕتھ
اکھ پُران ٹیلِویژن شو وُچھان چھُس
لَگہٕ چھُ یہِ کرُن ذِمہٕدار کَم
مےٚنِس بٔوُنُک برٛونٛہہ دۄہ مناونہٕ خٲطرٕ مےٚنِس کُٹمب
سُہ تُہۍ خٲطرٕ تھوڑا زیادٕ احترام تھاوِتھ ہٕکۍ
مےٚ گوو حیران یَلہٕ مےٚ وُچھ ۵۰ رۄپۍ ہُند نوٹ فٹپاتھس پٲٹھۍ پٲرِتھ
مےٚ چھُس پَک یقین تُہۍ گژھِو بےقصور ثابت
سُہ زَن چھُ واریاہ مُشکل
مےٚنِس زٕ کَم عُمر بچہٕ گوو ہَمسال ہایی سکولس منز
اوہ مےٚ، سُہ زَن چھُ واریاہ ڈرٲونٛہٕ آوُر
مےٚ چھُس بےصبری سان انتظار کران زٕ پورچس پٲٹھۍ ہاٹ چاکلیٹ سْیت بسم، یَتھ ٹھنٛڈی ہوا یِوان
مےٚ، مےٚ چھُس سُہِ پٲٹھۍ واریاہ متاثر
مےٚ چھُس زیادہ تر ہِپ ہاپ گۄٚل لِکھان
تُہۍ چھِو کیٛاہ بچہٕ؟
سُہن کٔر مےٚ سۭتۍ تَتھ متعلق گۄژھ تہٕ روٚن لٲگۍ
یہِ گژھِ واریاہ نزدیٖک
یہِ واریاہ سُہ چھُ زِ تُہۍ چھِو سُہِ خٲطرٕ پکان
تہٕ مےٚ ۱۰۰ ہٕنٛد چیک مٕلِتھ
مےٚ شرط چھُ کہ تُہۍ نَہ وٕنٛد نیند حٕصٕل کٔرۍ
کیا یہ کینٛہہ آسی یُس تُہۍ پیٹھۍ وُچھمُت
کیا تُہۍ چھِوُس تٔم دۄہ یِم ہٕنٛز وُچھان
