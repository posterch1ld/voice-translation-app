یہِ گژھِ دلچسپ۔
کیا چھِو تُہۍ اَز تہِ رابطس منز؟
یہِ چھُ سُہ نَہ، مےٚ چھُ نَہ لگُن زِ اِگوانا جنگلَس منز ژٕنٛگِتھ ہیکن۔
ہا ہا، مےٚ تہِ۔ مےٚ چھُ کَتہِ تہِ نَہ دِژھ کَہنٛہہ کیک یُس مےٚ نَہ آس پسند۔
یِمِس گَرِس منز بہٕ اَکیٛاہ گَر سِٹِنگ کران چھُس، تِمِس گَرِس منز پٲٹھۍ چھُس اَز دَم اَواز اَسُن۔
یہِ چھُ دلچسپ۔ یَلہِ تُہند ٹیم جیتان چھِ، کیا تُہۍ سۄنٛدِو ہاکی فین آسِو؟
اَز چھِ تِم ہیکان ٹیٚلیٚوِژن دِتھ یَلہِ بہٕ کانٛہہ کٲم کران چھُس۔
یِمِس سۭتۍ ہِٹ اینٛڈ رَن واقعات گژھن واریاہ کم۔
مےٚ چھُ سچۍ وٕنان زِ تِم کَرن یہِ بند۔
مےٚ چھُس خوش زِ تُہۍ دۄنَے چھِو ٹھیک۔
یہِ چھُ اَکھ مُشکل فیٚصلہ کَرُن، مگر اَتھ نَنِہ عُمرِس منز چھِ بَچن ہیکَن کۭنہِ کَس ضرورت۔
مےٚ چھُس وۄنۍ پنٛنِس بِلِس پٮ۪ٹھ واریاہ غُصہ۔
یَتھ کینٛہہ سیاسی نَہ آس، تِمَن صرف پنٛنِہ اَسُرکٕشا ہَمی پٮ۪ٹھ تھوپ دِی۔
گٔے ہفتَس منز آو چور أسۍ ہَنٛدِس کَمپاوُنٛڈَس منز ژٕنٛگِتھ، مگر گٔے پکڑنٕہ۔
صرف محنت سۭتۍ پٲٹھۍ، تُہۍ گژھِو آخر پاس، مےٚ چھُس تُہۍ یقین دِوان۔
مےٚ چھُ نَہ پتاہ یہِ کَتھ کِتھ کَتھ پٮ۪ٹھ وٕنُن۔
سۄ کۭنہِ نسلُک کُتھٕر آسِ؟
وۄنۍ سُہ تٔمۍ لیولہِ نِش باہر ٲس تہٕ سُہ تِمۍ متاثر کرنہٕ خٲطرٕ کانٛہہ چیز کٔرِتھ ژھانٛڑان۔
مےٚ بہتر محسوس کرنہٕ خٲطرٕ شکریہ۔
مےٚ اکھ نوٚی جیپ ژٕریٖد تہٕ سُہ چھِ وۄنۍ سۄنٛچھی نقصان زِ۔
کیا تُہۍ پنٕن لکی نمبر ژٕریٖد؟
مےٚ چھُس پنٛنٮ۪ن دوستن خٲطرٕ گۄڈٕ شےٚ ژھٲنڈان۔
اکانٛمی چھِ دوری، یِم چھُ آخرکار گژھُن لازمی۔
شاید سُہ تِتھ پٲٹھۍ تہِ نَہ ٲس گۄڈ، مگر مےٚ یادس منز چھُ سُہ کامل۔
سُہ چھِ کران، مگر وۄنۍ چھِ سُہ ہیٚڈ شیف۔
آ، یِہ کرنہٕ سۭتۍ چھُس مےٚ بٔڈِ اداس۔
سُہ ٲس صرف اَسہِ دۄنٛنٮ۪ن، تہٕ اَسہِ ٲسۍ بٔڈِ نزدیٖک؛ سُہ گٔیہِ کینٛہہ ؤرۍۍ یِم پٮ۪ٹھ۔
سُہ ٲس اکھ بٔڈِ سنسنی خیز تجربہ۔
مےٚ کھٲد سُہ سٲری یۄتھ مےٚ بچہٕ ژٕٹھی گٔے۔
گۄڈٕ ہفتہٕ سُہ مِڈٕل سکوٗلَس شروٗع گٔیہِ۔
سُہ چھِ اکھ کال سینٹرَس منز۔
مُبارک! تُہۍ کِس قسمچُھ کَم کٔرِو؟
سُہ ٲس سڑان تہٕ کٲوۍ ٲسۍ سُہ کھٲن—بٔڈِ افسوس۔
یِم سمیسٹر مےٚ ژےٚ کلاس ژھانٛڑان ٲس، سٲری مِلۍ۔
کیا تُہۍ تِمِس سۭتۍ بٔڈۍ وار ملاقات کران؟
مےٚ تُہۍ گۄڈٕ مُبارک دِیِو، کیازِ تُہۍ چھِ یِہ کرِتھ ژھانٛڑان۔
مےٚ چھُس سمجھان یِہ چھِ یِمِس سۭتۍ زیادہ وابستہ زِ پاپ پاپُک زندگی کتھ پٲٹھۍ سخت ٲس تہٕ تَمہِ اثر تِمۍ پٮ۪ٹھ کَتھ گٔیہِ۔
ژٕ ٹیکنالوجی منز کانٛہہ خاص ماہر چھِ نہٕ، یِمنہٕ مےٚ حیران زِ تِمن یہِ حل کٔڈ۔
مےٚ پسند چھِ زِ ہفتہٕ خٲطرٕ کینٛہہ مقصد مقرر کٔرِتھ یِم مےٚ پورٕ کٔرِتھ ہٕژھ۔
اچھا، مےٚ لگہِ چھُ زِ تۄہہِ پانٛژھہِ موجودہٕ نوکری چھوڑنہٕ برونٛہہ شاید اکھ نٔوۍ نوکری ڈھونڈنۍ گژھِ۔
سُہ باہر گٔے تہِ چھُ گم۔
مےٚ یہِ تہِ پتہٕ چھُ نہٕ زِ سُہ کیاہ چھُ۔
مےٚ تقریباً ہر روز تِمۍ واریہٕ محسوس چھِ۔ کیا تۄہہِ آخر کٔر یہِ؟
مےٚ کانٛہہ بیمہٕ اوس نہٕ۔
تِمِس پٮ۪ٹھ مےٚ چھُ تۄہہِ سۭتۍ اتفاق۔
یِمنہٕ یہِ گوٚو، مےٚ اوس زٕبردست پریشان۔
تِمن اکھ گڑٕ کھۄدِتھ پٮ۪ٹھٕنِ صحنہٕ نِرِتھ گٔے تہِ وۄنۍ تام واپس آو نہٕ۔
ہفتہٕ آخٕر چھِ سُہنہٕ اگر تۄہہِ تِمن دۄہن منز کام کرُن نہٕ پَوان تہِ کُنہہ کرن وول نہٕ آسہِ۔
یہِ روڈ ٹرِپ گژھِ اَز تام سۄب سا برونٛہہ؛ مےٚ چھِ سٲری چیز یِم مےٚ ضرورت چھِ۔
مٮ۪نۍ محنت آیٕ پھل۔
سُہ ژوٗنٛٹھ شرارتی چھُ ہر ۵ منٹہٕ پۄٹِ کَران۔
واہ، سُہ پَزِ اکھ واریاہ سۄنہٕ کُتُر پالُن وٲلۍ گژھان؛ کیاہ یہِ تِمَن ہُنٛد پہلِ کُتُر چھُ؟
اگر بۄڈِ لوٗکھ تِمۍ واریہٕ رحم دل آسہِ، تَلہِ شاید یہِ دنیا اَتھ گژھنہٕ اوس نہٕ۔
سچ پٲٹھۍ، أسۍ قرض تہِ دۄن کُنہہ سامانن ہُنٛد پیسہٕ ادا کوٚر۔
مےٚ گَرٕ منز سٲری شراب پیٚتھ، سٲری کھٲدہٕ کھٲد، بے ہوش گوٚو تہِ جاگِتھ ڈۄٹھ زبردست ناراض بیٚیہِ۔
مےٚ چھُ یقین زِ سُہ اکھ زبردست آفت اوس۔
تہِ کھٲدہٕ ژھانٛڈن وٲلۍ ژنٛگلن سۭتۍ ہوشیار روزِو۔
سوز ژٕ چھُس ڈزنی لینٛڈ بہت پسند
یہ چھُ ڈرٕون لگن، احتیاط خٲطرٕ مےٚ پَزِ پنُن تحفظ ساتٕ رکھُن شروع کٔرُن
پَتہٕ دۄہ مےٚ تِمۍ ۵۰۰ پونٛڈ ڈیڈلِفٹ کران دِژ
تِمِس دیر کرنس سۭتۍ چھُس مےٚ تِمۍ پٕتہٕ یِمۍ مایوس
اَس ہفتَس تِمِس والدینن ہُنٛد ملاقات خٲطرٕ پنُن ٹرک ژٕتھ گژھنس مےٚ پنٕنۍ بیٚیِس پٲٹھۍ بھروسہ کٔر
کیا تُہۍ چھِوٕ خیال کران زِ تُہۍ ژٔلۍ کُنہِ یِک ژٕنٛڈِو
ٹیکنالوجی چھِ سُہان تہٕ بےحد بےرحم تہِ بٔنِتھ
کیا چھُ تُہند ویک اینٛڈس خٲطرٕ کانٛہہ پلان
یہ چھُ مےٚ ڈیسکَس پٮ۪ٹھ، مےٚ چھُ نہ فکر زِ یہ چورِ گژھِ
تُہۍ چھِو نہ ہر کُنہِ خٲطرٕ سب کینٛہہ بٔنِتھ سَکٕن
اَکھ دۄہ ہٕنٛز مےٚ وُٹھ تہٕ نہٕ ہلِتھ سۭتۍ نہٕ وۄلِتھ سۭتۍ
حالٕ مےٚ اوس کھیٚلان یِک گیم تہٕ تَن مےٚ یاد کٔرۍ زِ مےٚ کِتھ پٲٹھۍ کھیٚل دۄہ اوس دادا سۭتۍ
لُکٕٹ بچہٕ چھِ سَدا اَتھ نازُک لَگٕنۍ، تُہۍ کیٛاہ کٔر
تَن چھُ سٲری کینٛہہ سۭتۍ کَرن آسان کَمۍ
دۄن ہفتن پتہٕ گژھان فلوریڈا
مےٚ چھُ نہٕ کَتھ تہِ اَسہِ پٲٹھۍ کینٛہہ اَنُبھَو کٔرِتھ
شاید تُہۍ چھِو درست، مگر مےٚ نہٕ
حقیقتس مےٚ چھُس پانٕنۍ سیکھِتھ
یہ چھُ سُچ، کینٛہہ وٲری پٮ۪ٹھۍ منز چھُ ماحول بدلِتھ سُہان لَگن
گھرِس منز تہِ چھُ نہٕ کانٛہہ ساتھی
مےٚ سٲری راتھ پڑھان اوس تہٕ مےٚ یقین چھُ زِ مےٚ فاینل پاس کرمُت۔
مےٚ پتہٕ لگ زِ میٛٲن برادَرِ ہُند زَنانہٕ میٛٲن برادَرِ سۭتۍ تِمَن سۭتۍ دوٚکھہٕ کَران اوس۔
مےٚ چھُس پنٛنٮ۪ن کُٹُمبرِ سۭتۍ وقت گَزارُن پسند۔
آ، حال چھِ کافی گوٚڈ دِژھان تہٕ اتھ پؠٹھ صرف بہتری یِوان۔
زِندگی کَتھ کَتھ، بلکہ اکثر، مُشکل بَنِتھ۔
یِلہٕ مُقابلہٕ نَہ ہُو، تِلہٕ حال چھُ مُشکل۔
مےٚ چھُس جانان زِ تُہۍ اوسُو خراب؛ تِمَن شاید پَزِ زِ تِم کیاہ کھٲن چھِ، یا کم از کم اگلی وٲر تُہۍ خبردار کرُن۔
مےٚ چھُس یِم جمعہِ ہُند ٹیسٹ خٲطرٕ پڑھان۔
یہِ چھُس میٛٲن عَلاقَس منز رِیَل اِسٹیٹ مارکیٹِ ہنٛد مُتعلِق، مےٚ کوٗشش کَران چھُس زِ یہِ ہٮ۪کٕنۍ اَکھ اِنویسٹَرِس سۭتۍ شناس کَروٗ۔
سُہ چھُ اَکھ مُشکل تبدیٖلی۔
کیاہ تُہۍ چھِو تِمِس سۭتۍ پٲٹھۍ پُرجوش؟
آ، تِم گوٚو۔ سُہ اوس حَق دار، مگر تِمَن نَہ دِژ کوٚنہٕ وضاحت تہٕ مےٚ چھُس اَسہِ زٕوٚر غُصہٕ۔
مےٚ چھُس پنٛنِہ موجودہٕ نوکری ترٛاوٕنہٕ سۭتۍ ڈَران۔
تُہۍ چھُو بس مثبت رَہن گژھِ، دوست؛ خوشی چھِ اَکھ نسبتی خیال۔
اگَر یہِ ژٕ جاری رَہِ تٕہ مےٚ چھُس سپروایزَرِ سۭتۍ گَپھ کَرٕنۍ یژھان۔
یہِ شُرِتھ مےٚ چھُس اَفسوس؛ اُمید چھِ زِ تُہۍ ژٕٹۍ کینہہ لبِو۔
سُہ شایَد میٛٲن بُزرگ دادا سٕندۍ پٲٹھۍ ژٕرِتھ تہٕ پُھلِتھ چھُ۔
دوٗن ؤرۍ پٮ۪ٹھ یِلہٕ میٛٲن زَنانہٕ طلاق خٲطرٕ عرضی دِتھ، تِلہٕ مےٚ اوس پٲٹھۍ تباہ۔
میٛون اوسِ نَہ بدلِتھ شٕے ؤرۍ، مےٚ پتہٕ لگ یہِ پَتہٕ۔
میٛٲن سٕل چھِ اتھ ۳ تہٕ ۴ ؤرۍ۔
میون کُتُک صحت خراب گژھان وۄقتھٕے میون بلی میٚون زندگی منز آیہ۔
تُہۍ کامیڈی ژور یا فلم دِتھُن وُچھ۔
میونہٕ چھُ یِم وقتھٕے زبردست کامیابی ہٕنٛز احساس۔
میون دوست چھِ ونان زِ کَتِھ کَتِھ چھُس بہٕ زٕیادٕ آسانی سٕتۍ لوٗکھن ہٕنٛز گژھان۔
سامٕنہٕ یوان ٹریفک پٲٹھۍ نظر نہٕ دِنہٕ سٕبب گٔوُس بہٕ ڈرایونگ لائسنس امتحانَس منز فیل۔
میون بیٚیہِ چھُ یِم ؤرۍ 10 وِس جماعتَس منز شروع گومُت۔
کیا تُہۍ گژھِتھ کارٹ ترٛاوُن پٲٹھۍ؟
یِمن چھِ دوستانہ گژھان ییلہِ تُہۍ سٕتۍ واقف گژھن۔
یِمن چھُ سچِ کرمُت—کِتھ شاندار کھیل!
مگر مےٚ چھُس یہِ کام پٲٹھۍ تہِ کٔرمُت۔
میون چھُس الماری کھولنہٕ سٕتۍ زٕیادٕ ڈر۔
مےٚ وٕچ گندٕ انٛڈر وِیر نٔوۍ چھِ وٕنی۔
ہاں مگر میون چھُس یِمن لگُن زِ مالِکَس وٕنُن گژھِ۔
پُرانہٕ کھٲنہٕ یُس مےٚ واریاہ دۄہ نہٕ کھٲومُت، تِمۍ اَنٛنِتھ واریاہ یاد۔
مےٚ چھُس کانٛہہ تہِ رولر کوسٹرَس پٲٹھۍ نہٕ رۄدمُت۔
یِتھ دۄنیہِ منز چھِ ہمیشہ زبردست اُستاد درکار۔
یوٹیوب گایڈ بنٲوتھ گژھِ یہِ واریاہ آسان۔
تُہۍ کَتھ گریڈ گژھِتھ؟
میون ماجہِ چھِ فِکرمَنٛد گژھِتھ بٔےمار۔
گۄڈٕ دۄہ ٹریفکَس منز کُنہِ کٔر میون سامنہٕ کٹ، تہٕ مےٚ لگ بگ وُچھ زِ حادثہٕ گژھِ۔
سچ ونان، مےٚ چھُس نہٕ یِمن متعلق یقین۔
مےٚ کوٗشش کٔر کہ یہِ گھاسس پٮ۪ٹھ پُژھِتھ کٔرُن صاف، مگر یہِ گژھِتھ واریاہ خراب۔
یہِ چھُ اکھ مُثبت قدم۔
وٕنۍ ماہ چھُ میون بجلی بِل آسمانس پٲٹھۍ۔
گٔژھِتھ وُچھُن، مےٚ پنٕنۍ سالگرٕ پٮ۪ٹھ گَرِ اکیلٕس بٔٹھ، تہٕ کٕہنٕے نہٕ آو مُکھ وُچھن۔
مےٚ چھُس خیال کران زِ ۳۸ وُہن پَتہٕ میون زنٕس چھِ یہِ رشتہ ختم کٔرُن۔
مےٚ پِزّا آرڈر کٔر، مگر تِم ہیمبرگر آن، مےٚ کٔر انکار، تہٕ تِم کٔر غُصہٕ ہنٛدۍ مےٚ پٮ۪ٹھ ژل۔
واہ، نوۍ نوکری حٲصل کٔرنس پٮ۪ٹھ شاباش۔
تُہۍ چھِو کَتھ پٮ۪ٹھ کٲم کران تَتھ؟
یِہٕ ہٲوِتھ بٔہتر، مگر یہِ ژٕنٛگ کٔرِتھ خۄشی گژھان زِ کٕہنٕچ ہفتہٕ چھُ واریاہ شاباش۔
آس نہٕ تِتھ نزدیٖک، تہٕ یہِ چھُ اصل زِ تِم کٔر ہمت تہٕ مےٚ کُر سیدھا یہِ طلب۔
تِم پسند کران تَھِس پَتھٕر ہٕنٛز کھیل تہٕ شو وُچھُن۔
فٕلکنٕس تہٕ تِمُک نو دِفاعی کوچ۔
میون بالَن ہٕنٛزِ تہِ چھِ اَتھ جایہِ پسند۔
اچھا، چھُو تُہۍ خیال کران زِ تُہۍ گژھِو یہِ نوکری حٲصل؟
کیاہ مےٚ پٔرسِتھ ہٕکُن زِ وَعدٕ کیاہ آس؟
مےٚ چھُس پپی ملن ہٕنٛزِ واریاہ نَفرَت، تہٕ بدقسمتی سٕتۍ چھُس مےٚ تَتھ عَلاقس روزان یَتھ یہِ عام چھِ۔
میون ژٕندگین منز چھُ نہٕ کَنہہ اَکھ آسِتھ، مےٚ چھُس سچّی کلِچ خاطر واریاہ بےتاب۔
یِم ہٕنٛز کارکردگی چھِ مےٚ اَز تہِ واریاہ متاثر کران، یوتھُکِ اَکھ لۄکُٹ مُلک۔
مےٚ چھُس اَتھ انتظار کران زِ یِلہِ وارٕہ میون مالی حالت گژھِ واریاہ بٔہتر۔
مےٚ کَتہِ نَہٕ آسٕو تاریخُک گۄڈٕ طالب علم۔
مےٚ کَتھ کَرنٕہٕ چھُس سُہ، شکریہ۔
مےٚ چھُس صِرف کینہہ سُکون ژھانان۔
تَہِ بِغٲر گژھُن مےٚ نَہٕ سُہ لگہِ؛ اَسۍ عام طور پٲٹھۍ اَکہِ ساتھ باہر گژھان۔
مےٚ چھُس سَمجھان یِم مےٚ یاداشت گژھان کَم۔
تِمَن کَتہِ نَہٕ آیٕک شرافتُک نَو۔
باقٕے دۄن ؤرٕی کنہِ نَہٕ چھُس بچہٕ کَرٕنۍ رٲدہٕ۔
سُہ چھِ تَتھ آسَنۍ والۍ مٲجِس پیٹھۍ نِیٖک۔
مےٚ اوسُس پَریشان ییلہِ مےٚ گریجویٹ سکولس منز دِتھ آسِو درخواست۔
ہاں، تُہۍ چھِو بلکل درست۔
شروع چھُ سُہ گژھان بَہٕتھ سُست۔
ہاں، سُہ چھُ بَہٕتھ شرمُک۔
مےٚ ہاؤس میٹ اوس گژھان کَل راتھ بَہٕتھ دیرِ گَرِ۔
اَکھِ مہینِ پَتہٕ گژھِ مےٚ سُہ دۄہ پُترس سٲتھ ملاقات۔
ارے، سُہ چھُ بَہٕتھ خراب لَگھان۔
تُہٕنٛز مٲجِن کِیا کٔر؟
اَتھ چھُس مےٚ سٲری ساف کَرُن۔
کِیا بیٖر سپرے چھُ سچ مُچ کینہہ چیز؟
ہاں، خۄش قِسمتی سٲتھ کارس منز اوس کینہہ زیادٕ کمبل تہٕ کینہہ کھاون یُس مےٚ مدد کٔر۔
اَسۍ سَری وٲرِی نَہٕ آسِو پٲٹھۍ کُنبس منز پیٖدا۔
مےٚ چھُس شرمندٕ محسوس کران ییلہِ مےٚ مردن ہٕنٛز لاکر رومس منز کَپڑٕ بدلٕوُن پَران۔
مےٚ چھُس رۄوان ہَر دَفعہ ییلہِ مےٚ پنٛنِ بہٕن ہٕنٛز یاد گژھان۔
آج مےٚ کرٕ کوشش پنُن لان موور شٲل کرٕنٕچ، مگر تَمہِ چھُ اَکھ حِصہٕ کَم۔
اَس گٔے اَسہِ نزدیٖک ‘لا ہَسیٖنڈا رٛانٛچ’ ناوٕچ کاؤبای میکسیکن جاے۔
تِمَن چھُ نہٕ پَتہٕ کِہِ وجہ چھِ۔
ہاں، تِمِس سِکھٲو زِ سامان کَچرا دٲنس منز دَبٲوِتھ گژھاوٕن۔
ییلہِ مےٚ دۄپہرٕچ کھٲدَر کھان اوس، کُنِہ کٔر تَمہِ پٲٹھ دَب۔
اَکھ بٔڑ پِزّا، سٲری مٮ۪ٲنۍ خٲطرٕ۔
‘کٕلارِسا اٮ۪کسپٕلینٛز اِٹ آل’، ‘آر یو اَفرٛیڈ آف دَ ڈارٛک؟’ تہٕ ‘کَزِن سکیٖٹر’۔
خیر، شایَد یہِ چھُ بہتَر۔
مےٚ اوس پَتہِ ہفتہِ اَکھ اِمتِحان، تہٕ مےٚ کٔر ہر سوالُک صٲیح جواب، کیازِ مےٚ کٔر تِمِس خٲطرٕ زبردست تیٲری۔
آج صُبح مےٚ ہٕنٛز چھُو رٲتھ پٲٹھۍ جاگ۔
مےٚ چھُس سٲنۍ زِ ایگلز ژِتھ سُپر باؤل ہٮ۪کَن، مگر مےٚ چھُ نہٕ یقین۔
کَم اَز کَم تُہٕنٛز گٔے آخرکار رٲضی۔
کیا تُہۍ کِنہِ خۄد آزمایو؟
آ، اَتھ چھِ لگ بَگ ژۄر ہفتہٕ گٔمٕت۔
پانٛژھ وَرۍ گٔے، مگر مےٚ اوس تَمہِ سٕتۍ آخری تام۔
مےٚ چھُس کانٛہہ نہٕ اَی۪تھ سُنتھ زِ بیلے سکوٗل چھُ اَتھ کَٹھ۔
مےٚ بٮ۪یَر خٲطرٕ پَیسَن ہٕنٛز ضروٗرت ٲس۔
دُنیاہَس منز سٲری کینہہ ٹھیک محسوس گژھان اوس۔
مےٚ ہَینگ اوور اوس تہٕ سُست اوسُس
سُہ چھُ اَکھ پیٖٹھ لالہٕ بچہٕ
یِلہٕ مےٚ پنُن ہمسایہٕ پیسہٕ عار دِتھ
مےٚ چھُس اَندازٕ کران زِ تِمَن نَہ ذِمہٕ داری وُچھ
مےٚ اوسُس سڑِتھ کچَرَس منز ڈُبُل
مےٚ چھُس بے صبری سان انتظار کران زِ دۄستمَن سۭتۍ کیمپنگس گژھِتھ
سارے چھِ تِمَس منز یقین کران، مگر مےٚ چھُس مانان زِ تُہۍ لوٗگ تہِ غلطی کران
سٲری چاکلیٹ یۄس مےٚ جلدی جلدی کھٲد
یِم ہفتَس پَتہٕ تُہۍ چھِ آرامَس حقدار؛ تُہۍ یُس کٔر، تَمس پٲٹھۍ کامیٲبی حٲصِل کٔرِتھ چھُ یقینن زٕبردَست احساس
مےٚ چھُس تِمَن ہُنٛد کٔرمُتھ پٲٹھۍ زٕبردَست فخر
سُہ چھُ زٕبردَست ژٕٹ بڑان
تُہۍ چھِ یِمِس مُتعلِق کِتھ پٲٹھۍ محسوس کران
کِیا تُہَنٛد دۄہتر ہُنٛد ٹیم جیت؟
تُہَنٛد عُمر ہُنٛد اَندازٕ کٔرُن اوس میٛون قصور
کِیا تُہۍ کٔرِو گَپ شپ زِ ڈیڈلایِن نَہ پٲرِو
نَوی کینہہ شُرُع کٔرُن چھُ ہمیشٕ دلچسپ
مےٚ چھُس یِتھ آزماونَس پٲٹھۍ زٕبردَست پُرجوش
لگٕن چھُ زِ تُہَنٛد چھُ نتیجہٕ اَگٕۍ پٲٹھۍ پَتہٕ
مگر اَسہِ سۭتۍ اوسُس زٕبردَست میل جول
حالٕے مےٚ مٲنۍ پورٛنۍ ہایِسکول یِیَر بُک لَبِتھ
یہِ چھِ مےٚ بٔڈٕ غصہ دِوان
پنٛنِس ساتھی سٕنٛدۍ مدد کرُن چھِ نیک
مگر کوشش کٔرِو زِ یہِ تُہُنٛد ضمیر نہٕ ڈنسہٕ
مےٚ چھِ پنٛنِس دوستس پٮ۪ٹھ بٔڈۍ حسد
کینہہ گژھِ بٔڈ، باقیَن ہٕنٛدۍ کارکردگی گژھِ نہٕ تِتھ پٲٹھۍ نِکٕتھ
سہِ چھِ عام طور پورٕ پٲٹھۍ بے خوف، مےٚ سٕنٛدِس پُترس مُقابلہٕ یُس ہر کِہٕنٛۍ سٕنٛدۍ ڈرٕنۍ
آ، یَلہِ کَتھِ سپورٹس ایونٹ کَرانٕس منز گژھان، شاید ہٕنٛز ہَتھ منز تھاوٕنۍ شروٗع کَرٕہ
یَلہِ مےٚ ڈوٗر سٕنٛدۍ اندر گژھِ، سُہِ پٮ۪ٹھۍ گژھِ مہٕنٛگ جوتَن ہٕنٛدۍ جوڑۍ طلب کٔر
بہٕ چھُس جلدٕ پنٛنِس پسندیدہ بینڈُک کور بینڈ وُچھنس گژھان
مٮ۪ہنَت ہٕنٛدۍ پھل مٮ۪لُن گژھِ؛ کینٛہہ کٔرِ محنت، واپس یِوان چھِ سُہ یِوان سُنِتھ خۄش گژھِ، مبارکباد
اگر تُہۍ ناراض نہٕ گژھِو، یہِ چھُ کُس قٕسمُک نوکری؟
بٔڈۍ سکالرشپ مٮ۪لٕنٕچ خٲطرٕ مےٚ ACT منز 34 نمبر ضرور آسُن، تہٕ مےٚ بٔڈۍ وار کوشش کٔر
مےٚ چھِ حیران زِ مےٚ سٕنٛدِس ایکسس کِتھ پٲٹھۍ مٮ۪لِ اَتھ خوبصورت گرل فرینڈ
مےٚ گژھِ بٔڈ شرمندٕ زِ باتھروٗم گژھنٕچ خٲطرٕ مےٚ پنُن ڈیٹ ترٛاوان پٲٹھۍ
آج مےٚ وُچھ یہِ گٕڈٕر موٹرسايکل صرف پٮ۪ٹھۍ ویل پٮ۪ٹھ چَلاوان
کاش مےٚ سٕنٛدۍ گاڈمدرن تہِ تَتھ پٲٹھۍ کٔر آسِ
بہٕ چھُس گژھنٕچ خٲطرٕ تیار تہٕ مےٚ چھُ نہٕ صبر گژھان
سُہِ مےٚ پٮ۪ٹھۍ عجیب طریٖقہٕ سٕنٛدۍ تَکان اوس
کینہہ وار چھِ مےٚ یاد یِوان سُہ ژٕنۍ دۄہ یَتھ منز سوشل میڈیا اوس نہٕ
فولس چھِ شروٗع منز گۄڈٕ مُشکِل
ہاں، یَتھ تُہۍ تِم میٹنگن منز بولٕنۍ یِوان، مےٚ ہمیشہ کَنہہ گھبراہٹ گژھان۔
مےٚ یُس پَتہٕ فلیٹ اوس، سُہ اوس کَنہہ ویران جاےِ منز، بجری وول سڑکَس پیٹھ۔
اسہِ کَنہہ ژٕ آپشن چھِ ذہنَس منز، مگر یَتھ سُہ اَتھ یِیہِ تَمہِ پَتہٕ فیصلہ کَرِو۔
تِم چھِ واقٔعی زَنانہٕ یا مردٕچ بہترین دوست۔
تَمہِ سۭتۍ مےٚ سُہ تٔمِس خٲطرٕ کٔنہٕ۔
مےٚ کُتھ آج رَوان گٔیہِ تہٕ مےٚ نَہ لَبان سُہ۔
اگلی بار سُہ ضرور سُہ حٲصِل کَرِ۔
مےٚ برٕ دوست چھِ پنٕنۍ کُٹم سۭتۍ پانٛژھ سَتھ میل دور گژھان۔
مےٚ چھُس تیار کالجٕچ یِم آخری سمسٹر زبردست طریٖقٕچ کڈنس۔
مےٚ یُس دوٚد، تَمہِ پٮ۪ٹھ مےٚ یقین نَہ گژھِ۔
سُہ یَتھ واپس یِیہِ تَتھ پیٹھ مےٚ نَہ تھٔوِتھ صبر۔
مےٚ چھُس کَتھ کَتھ پَران، تُہۍ چھِوان پَران؟
مےٚ سٲری ہفتہٕ پنُن ڈیبٹ کارڈ نَہ لَبھِتھ تہٕ آخر مےٚ ہار مانٛژ۔
مےٚ گٔژھِ خیال یِہِ حالات پَتہٕ خراب گژھِ۔
یہِ چھُک، یُس پال کارنیلَن لیکھمُت۔
پہلِ کُنہِ نَہ دیتھ، مگر پَتہٕ تِم سٲری سَمجھِ گٔے۔
مےٚ چھُس امید یِہ مےٚ لٹری جیتھِ۔
ہاں، اکلٕپن گژھِ سَخت دُکھی کُن۔
مےٚ اوس گژھان محلہٕ منز واک کَرن، تہٕ مےٚ سوس محسوس گژھِ کَنہہ چیز مےٚ سرس پٮ۪ٹھ پٔتھ۔
سُہ ٹکٹَس خٲطرٕ اوس، مگر مےٚ اوس سَخت بٔے۔
مےٚ چھُس زٕبردست پریشان، مےٚ سَتھۍ کٲمری کٲس سکول ڈرامَس منٛز مُکھ رول گژھ۔
اُمید چھُس تُہۍ اکھ بہتر ساتھی ژھانٛڈو، یُس تُہنٛد خیال تھاوی۔
یہ چھُ اَتھ پَیٹھۍ بہترین شو۔
تِم چھِ واریاہ مزٕدار۔
مےٚ گٔو نٔو گَرِ منٛز رٲوُن تہٕ آخرکار سٲری چیز کٔر کھول تہٕ سیٹ۔
تُہۍ ژٕٹ تَتھ پٲٹھۍ پَہنٛچِو۔
تُہۍ کٔرِ تِم سۭتۍ واریاہ مِٹھ۔
آ، مگر چھُس خوش زِ یہِ چھُ اَتھ وۄنۍ ختم گٔژھ۔
مےٚ چھُس روزانہ واریاہ مریضَن ہُنٛد خیال تھاوان۔
مےٚ گٔژھ دیر، تہٕ مےٚ دوڑِتھ آو تہٕ پسینٛہِ منز سٲری خراب آو۔
مےٚ چھُس اکھ فارمَس منٛز رٲوان تہٕ واریاہ جانورَن ہُنٛد خیال تھاوان۔
تہٕ تِم گٔیہِ پنٕنہِ خوابٕچ نوکری منز فوراً ہائر کٔرِتھ۔
کیا تُہۍ ژٕٹ دوہَن خٲطرٕ تِمَن سۭتۍ شٲمِل گژھِو؟
آجِ سُہِ مےٚ ہُنٛد کافی کپ منٛز اکھ مَکھی پٔتھ۔
تِم چھِ شِکایَت کَران یَیلہِ سٲری کٲم گژھان چھِ، تہٕ یَیلہِ خراب گژھان چھِ تَیلہِ تہِ خوش نَہ چھِ۔
یَیلہِ مےٚ ہُنٛد والدینن مےٚ گریجویشن تحفہ دِتھ اکھ گاڑِ کٔر، مےٚ گٔژھ حٲران؛ مےٚ نہٕ آس امید۔
مےٚ نہٕ چھُس سَمژھان زِ تِم کَتھ واریاہ وقت باقی چھُ۔
مےٚ چھُس تِمَن منز اکھ تہِ کَتھ نہٕ ژٔرمتھ۔
مےٚ چھُس یَتھ ہُنٛد اکھ برونٹھ مثال۔
مےٚ یِمنٛۍ یِتھ کنسرٹ خٲطرٕ ٹکٹ ژٕٹ، تَتھ گژھنہٕ خٲطرٕ مےٚ وُچھُن نَہ صبر۔
آ، بہٕ تِم سۭتۍ زٕبردست متاثر گٔوٗس۔
تہٕ چھُ سٲریو منز ٹھیٖک، مےٚ چھُ گژھان۔ کیا تُہنٛدِہِ پنٛنِہِ گَرِ منز تُہنٛدِہِ والِدَین چھِ نَہ تُہنٛدِس پٲٹھۍ اِعتماد؟
یہِ چھُ افسوسناک۔ مےٚ ہٕنٛدِ اَکھ دوستُک کُتہٕ کینہہ بَرٕس پٮ۪ٹھ مٔر گٔے۔
آ، بہٕ مدد حٲصِل کرنٕچ کوشش کران چھُس۔
شاید تُہۍ دۄنٛۍ اکھ جایہِ سیر کرن گژھِو۔
یہِ چھُ مےٚ سۭتۍ واریاہ گژھان۔
تُہۍ تِم کُتھ کُن نین چھِو؟
تَتھ منز چھُ واریاہ مزٕ آسِتھ پٲرُن۔
آ، بہٕ مُشکلہٕ سۭتۍ وَقتس پٮ۪ٹھ اندر گٔوس، بہٕ ڈَرَن مٲرِتھ مٔرُن اوس۔
بہٕ کینہہ وَقتھ پٮ۪ٹھ کٔرمتھ۔
کیا تُہۍ چھِو ونان زِ بِلِیَن کینٛہہ خراب ژٔٹ؟
بہٕ پیسہٕ گَرِ نین گٔیوس تہٕ گَرِک سامان ژٕٹنس خٲطرٕ پنٛنِہِ بیٚیِہِ دِتھ۔
کیا تِہۍ لَجِت گٔیو یا تُہۍ ہَسِتھ تِم ٹال؟
تُہۍ چھِو جانان، مےٚ کِیاہ کوٚشِش کٔر سُہ رات؟
کیا چھُ تُہنٛدِس نِزِک اَز تہِ کمبل؟
کیا تُہۍ کینٛہہ اہم ڈیٹا گُم کٔر؟
آ، گُم کٔر۔ مےٚ اَتھ کَتھ گَندٕ لٲگ زِ واریاہ دَفعہٕ نٮ۪ون کٔرِتھ تہِ بُو مےٚ پٮ۪ٹھ نَہ گٔی۔
مےٚ تہِ چھُ تھرِفٹ سٹورن ہٕنٛز گژھُن زٕبردست پسند۔
بہٕ نَوِہِ شَہرِ کُن اَزے منتقل گٔیوس، نَو کٲم چھُ تہٕ مےٚ چھُ نَہ کُنِہ دوست۔
یہہ جان لیوا اوس تہٕ ڈاکٹرن کٔہ کہ یہِ واریاہ دیر سان پکڑنہٕ آیہِ۔
مےٚ ایتھ رٔژھ گژھ کہ مےٚ پنُن ٹی وی توڑ۔
مےٚ یاد آوان چھُ سٲری دوستن نزدیٖک روزُن۔
اندازہٕ لٔگاو، مےٚ ہٕنٛدِ اکھ بےوقوف ساتھی کِیا کٔر؟
مےٚ ہٕنٛدِ ژٔلۍنٛدرن کٔرۍ کَل راتھ دۄہ بَجِ زور دار جَھگڑ۔
یہِ پرٛون اُمیدٕ، فلم دِژھنس گٔژھِتھ مایوس گژھِتھ باہِر یُن—مےٚ چھُ تۄہہِ بلکل سمجھن، یار۔ کِہ فلم؟
مےٚ پَنُن فہرست دۄہراوٕ چیک کٔر تہٕ مےٚ چھُ یقین زِ یِم سٲری چیٖز چھِنہٕ ضٔروٗری، سٲری مےٚ سۭتۍ چھِ۔
وۄہ، تَتھ چھِ مےٚ ہٕنٛدۍ دوست۔ مےٚ چھُس لیورنَس منز روزان۔
سُہٕنۍ بٲتھ چھُ زِ پیزا آرڈر کرنُک اکھ سُہٕنۍ بہانہٕ گژھِ آسُن۔
مےٚ چھُ یقین زِ knarma چھُ جلدی واپس یِوان۔
اَس چھِ ہمیشہ اَکھ دۄجس سۭتۍ سُہٕنۍ تہٕ ایماندار۔
عام طور چھُ یہِ وجہ کہ تِم چھِ واریاہ دوست مزاج یا حُکمَن ہٕنٛز فوراً جواب نہٕ دِوان۔
تُہۍ چھِ ونان، کِہ چیز چھِ مےٚ سٲری کھٕراب کران؟
ییلہِ مےٚ پنُن بیٚٹہٕ پہلی بار گوٚدِ منز دِژھ، مےٚ اوس واریاہ خوش۔
اگر سُہ کُنہِ وار اندر یِیہِ، مےٚ ہٕنٛز سارِہِ گھر منز پھانٛد دٔرِکھ۔
مےٚ کٔر دۄکانس فون تہٕ کٔر مٮ۪نیجر سۭتۍ بٔت۔
آ، تٔمۍ کٔر کالج تہٕ ہای سکول درمیان اکھ وُہل بریک، تِمۍ سۭتۍ آسنس مےٚ چھُ عادت۔
سُہٕنٛدِ طرفہٕ یہِ اکھ سُہٕنۍ اشارٕ اوس۔
تُہۍ چھِ تِم خوش کرُن چاہان، مگر چھُ تۄہہِ پنُن خیال تہِ تھاوُن ضروٗری۔
مےٚ دٔرٛشن اکھ زنہٕ یۄس پنٛنِس شرٹ منز ناک صاف کران اوس۔
مےٚ چھُس خیال، ژٕ فقت سُہ وقت یاد تھاو۔
آج مےٚ چھُس پانس منز ٹُکر لگاون۔
تُہۍ گٔو حٲصل واپس؟
یِم سارٕ گرمی منز بہٕ تہٕ میون دوست صرف نشہ کٔرِتھ تہٕ واریاہ فاسٹ فوڈ کھاون۔
کیا ژٕنٛدٕر تُہۍ حملہ کٔر؟
یِتھ کُتھ مرِ، مےٚ سُہ لٲگ کہٕ میون زندگی ختم گٔے۔
مےٚ چھُس عزت محسوس کران زِ مےٚ گژھِ اگلے سال چین گٔومُت۔
مےٚ چھُس نہٕ امریکن، اسہِ چھُس تِمن متعلق صرف تھوڑا بہت واقف۔
ہِک کُنہِ منز سِلورفِش تہٕ ڈایپر ڈھیر اوس۔
نَہ، سُہ اوس اَجنبی؛ تِمۍ پنُن ناک ڈھانپ تہٕ بہٕ گژھُس زبردست سُرخ۔
مےٚ چھُس بلکل اداس۔
اوہ واہ، سُہ چھُ واقعی ڈراون آواز دِوان۔
شاید تُہۍ گژھِ تِمن سات سِدھی گل کرُن۔
میٛون کراتے کلاسُک یہ بچہ چھُ واریاہ صلاحیت دِوان۔
مےٚ چھُس آس کَران زِ تھٲپی منز اکھ مہینٕہ گژھِتھ میون ساتھی واریاہ ترقی کرِ۔
اوہ واہ، سُہ چھُ زندگیُک اکھ واریاہ واقعہ—نیک تمنٲ۔
تِمن ہٕنٛدۍ پنُن پنُن فائدٕ تہٕ نقصان چھِ۔
مےٚ ہیکہٕ نہٕ بلکل گژھِتھ گُپھ اندھیرِس منز عادت۔
بدقسمتی سان سُہ بچِ نہٕ، تہٕ مےٚ چھُس اَز تام تِمن ہٕنٛز یادِس منزہ نِبرنٕچ مشکل۔
روزُک کُن حصو چھُ تُہۍ ہٕنٛز پسند؟
اَکھ حٕصُل کَرنہٕ خٲطرٕ اَتھ وَقت چھُ؟
مےٚ اَز چھُ اَکھلٕے کھٲدِتھ۔
اوہ، ٹھیک چھُ، مےٚ چھُس تُہۍ خٲطرٕ بٔڈ خوش۔
تُہۍ سَتھ سَتھ سُہ تہِ گژھِ یہِ تَمہٕ پسند۔
یِم کَمبَخت کچنَس منز گژھان مےٚ چھُس تَمہِ بٲسہِ سٕتۍ بٔڈ پریشان۔
گٔے سٲل نوکری خٲطرٕ بہٕ گٔیوس دوٚپٲر۔
کیا تُہۍ چھِو پریشان زِ تِمَن ہٕنٛد اغوا گژھِ یا کانٛہہ اَسہِ قٕسمُک؟
یہ چھُ بٔڈ بور—کام چھُ ہر وقت اَسہِ روٚکاتھ یِم اَسہِ پسند چھِ کَران۔
مےٚ چھُس پَکّ یقین زِ تُہۍ گژھِ لَبھِ اَکھ جلدی۔
مےٚ گٔو بیف ویلنگٹن، یِم کھٲنہٕ ہٕنٛز قیمت گٔے لگ بَگ 100 ڈالر۔
سُہ چھُ سکولَس منز تہِ وُچھان کٲم کران۔
حالٕے مےٚ کٔر مےٚ برونٛہہ سٕتۍ اَکھ سکریپ بُک یَتھ منز آسِ سٲری پُرانٕے تصویر۔
آ، سوشل میڈیا کٔرتھ چھُ اَسہِ دوستن تہٕ خاندان سٕتۍ بٔڈ بہتر طریقہٕ سٕتۍ رٲبطہٕ تھاوٕنۍ مُمکِن۔
یَلہِ سُہ آخرکار کوٚر ترٛاو، مےٚ کٔر بٔڈ فخر۔
کَتھ کَتھ مےٚ چھُس تِم کَھٲن کارَس منز، گَرٕ وُنہٕ رٲستہٕ۔
تَمہِ کٔر مےٚ بٔڈ ڈَر۔
مےٚ گٔیوس یہِ سٲل دوٚبارٕ ڈزنی لینٛڈ، کٔر سُہ بٔڈ مزٕ۔
تِم چھِ کیٖڈٕ، بٔڈ تہٕ چھِ اُڑان۔
کیا تُہۍ چھِو پنُنِ نوِ نوکری منز آرام محسوس کران؟
تَعلٕیمی سسپنٛشن پَتہٕ مےٚ ہٕنٛز بٔڈ دوست گژھِ آخرکار سکولَس واپس یِتھ۔
اوہ، مےٚ اوس امید چھِ تُہۍ سٕنٛز جوابس منٛز تٔمۍ کُٹ دِتھ۔
یہِ تٔمۍ ہٕنٛدۍ طرفہٕ سٕنٛز واریاہ پیٚٹھ۔
اوہ، یِہ گٔژھ سٕنٛز میٚے واریاہ افسوس چھُ۔
کُنہہ کُنہہ میٚہ چھُ یِہِ دورس منٛز پیٚدا گٔژھُن پسند، مگر پتہٕ میٚہ چھُ لگن زِ بہٕ واریاہ پریشان گٔژھ آس۔
میٚہ چھُ پتہٕ، یِمن تُہۍ سٕنٛز اِتھ بَدسلوکی کٔر، مایِک چھوڑِتھ باہر نِکلُن چھُ واریاہ دلکش۔
یہِ چھُ کمال—تُہۍ شیئر کٔرِو؟
میٚہ چھُ نہٕ کینٛہہ نروس گٔمُت۔
ہاں، تٔمۍ ضروٗر کٔر؛ سُہ چھُ ہمیشہ پنُن وعدہٕ پٲرن۔
مےٚ چھُ اَکھ لۄکُٹ کمپریسر۔
کُنہہ کُنہہ چھُ سُہنٛد یِمے کمرس منٛز بس اکھ سِتۍ آسُن۔
کیا تٔمۍ نَباتہٕ تہِ بدل کٔر؟
میٚہ چھُ لگن زِ تُہۍ ضروٗر سٕہ محسوس کٔر۔
یِہِ سٕنٛدِتھ خۄش گٔژھ زِ تُہۍ ہٕنٛز بچپن اِتھ بےفکر آس۔
اَکھ پَکھِ تَمہِ منٛز اُڑِتھ گٔژھ۔
یَلہِ بہٕ ۱۲ وریہِ ہٕنٛد آس، بہٕ چھُٹۍ منٛز ڈزنی ورلڈ گٔژھ۔
تٔمۍ کِتھ سیزن بنٲوِتھ؟
یِتھِ بہٕ روزان چھُس سُہ جاے چھُ واریاہ خالی، یِمن میٚہ چھُ گھرُک واریاہ خیال یوان۔
یَلہِ بہٕ کانٛہہ کُتہٕ چھُس وُچھان، تَلہِ میٚہ چھُ پنٕنۍ کُتُک یاد یوان۔
دۄہِم دۄہ میٚہ ہٕنٛدۍ دادٕچ پیٚٹھ کَیڈِلَک گاڑِ ژٔٹ آگ۔
گٔژھِتھ مانٛہ بہٕ اوسُس بچس ہٕنٛدِ انتظار۔
نَہ، تہٕ مےٚ وٲنۍ کرنس کوئی اِرٲدو نَہ۔
سُہ چھُ خاندانُک سبَس نُن، مےٚ سچّی بُرٕ لگ۔
ٹھیٖک، پانہٕ اندر رٔہ، دروازٕ تہٕ ژھٲٹ بند کر، تہٕ دروازٕ کُن کانہہ آو تو نہٕ کھول۔
مےٚ دوست آس مدد کران مےٚ کانہہ کرنس، مگر گژھِ ہفتہٕ سُہ مےٚ سٕتۍ دغا کٔر۔
کیا یہ چھُ بُرٕ، یا تُہۍ چھِو اکیلا رٲونس پسند؟
ہا، کَتھ کَتھ چھُ تُہۍ صرف پنُنٕس بھروسہٕ کرِتھ ہٲو۔
تُہۍ گژھِ سُہ وِسٲرُن۔
مےٚ چھُ اَکھ ای میل فراڈس منز پھٔسِتھ۔
شاید چھُ اَٹھۍ مہینٕہ گژھِتھ۔
ییلہِ سُہ تَمہِ سٕتۍ واتھ کران آس، سُہ چھِ اتھ پٲٹھۍ زیٛادٕ پُرجوش تہٕ جُڑِتھ لَگن۔
مےٚ طلاقس پتہٕ چھُ نہٕ کانہہ۔
تُہۍ گژھِ احتیاط کرُن، یِم سٕتۍ ہٲو اَکھ بٔڈ حادثہٕ گژھِتھ۔
یہ چھُ کمال! کیا چھُ کانہہ خاص وجہ سُہ ترٛاوِتھ نہٕ ہٲوُن؟ سُہ چھِ بس کَتھٕ نہٕ سٔنٛزِتھ۔
مےٚ چھُ پنُن حال ژٲنٛان، شاید مےٚ بدلہٕ لیٛنہٕ گژھِتھ آس۔
