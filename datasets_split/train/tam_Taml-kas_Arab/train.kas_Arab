ہاں، یَلہِ مےٚ نوتھ کہ سٲری مےٚ اَجیب نَظری سۭتۍ پَکان، تَلہِ مےٚ نوتھ کہ مےٚ اَز تام پاجامہ پینٹ پٲٹھۍ چھِ۔
یہِ چھِ کتھ خوشیُک وقت۔
یَلہِ بہٕ جذباتن منز یِتھ پٲٹھۍ کٲم ترٛاوٕں، تَلہِ مےٚ سٲری وٲر پَچھتاوا گژھان۔
سُہ خیال چھُ، یَلہِ کُنہِ کُٹُمبرِچ حفاظت ہٕنٛد گژھِ، تَلہِ باسان احتیاط کرُن کَتھِ زیٛادٕ نِہ۔
تٔم اتھ جلدی اکھ کٲم تہٕ اکھ گرل فرینڈ ژٕٹ کہٕ بہٕ تٔمس خٲطرٕ خوش گژھن بغیر نِہ ہیکِو۔
یَلہِ أس سَفَرَس گژھان تِہ۔
مےٚ چھِ تَلِتھ ٹوِنکی پسند، تُہۍ سۭتۍ تِہ گژھِ پسند۔
یِہ چھُ لازِم سُہ مُردٕ پَکھی یُس مےٚ کٕلہِ تٔمس کھٲنس دٕژموت۔
شُکر چھُ، سٲری کینٛہہ ٹھیک گٔیہ۔
مےٚ حٲصِل گٔژھ اکھ اِنٹرویو تِم کٲمَن خٲطرٕ یِم مےٚ سُہ لایق نِہ سَمجھان۔
بہٕ تِہ واریاہ دِل شِکستہ آسُس، تٔم سٲریَن خوشی دِوان آس۔
مےٚ ہٕنٛز ژٕٹہِ چھُ واریاہ بختاوار۔
شاید بہٕ وٕنٛدٕ جوش منز آسُس، مگر سُہ تِہ چھِ۔
شاید بہٕ پنٛنِس جنم دِسَس خٲطرٕ اکھ ژٕٹِو۔
سکول چھُ شُرٕ کَرن وٲل، تہٕ أسَن چھُ سٲری کٕہہ یِم ضروٗری چھِ۔
مگر مےٚ چھُ خوش زِ وُچھِ مےٚ یِمن بچن یہِ وٲر کینٛہہ نِہ وٕنٛتھ۔
مےٚ چھِ نَفرَت یَلہِ یِہ گژھِ، خاص کٔنۍ یَلہِ تُہۍ کُنہِ بیٚیِس چیٖزَس ہٕنٛز تصویر کٔرِتھ آسِو۔
بہٕ چھُس واریاہ کٲل سۭتۍ تَتھ نِہ گژھان۔
مےٚ پنٛنِس ماجس سۭتۍ جنگ ژٕٹ تہٕ مےٚ واریاہ خراب گژھ کٔر، تِم کٔرنس پؠٹھ مےٚ افسوس چھُ۔
میون دوستن ۳۰ فُٹہ کھوتہ لمٕب مٕوِنگ ٹرک کِرایہ پؠٹھ ژٕتھ۔
میون بہترین دوستن لاٹری ژٕٹ تہٕ تِمن گژھ واریاہ پیسہ، مگر مےٚ نہٕ۔
کینہہ چھِ پنٛنٕنۍ بُنیٛادی ضروٗرت پوری کٔرنس پؠٹھ ژھٹان۔
تُہۍ تِمِس نینٛد وٲلِتھ روٚدیو؟
اَسہِ دۄنوٕنِس چھُ وقت پنٛنٕنۍ پنٛنٕنۍ سرگرمیو پؠٹھ دھیان دِنِچ۔
کیا تُہۍ یِتھ سۭتۍ بیزار گژھان؟
مےٚ کوشش کران چھُس یِمِس، کیازِ لوٗکھ چھِ تِمِس حقدار۔
مےٚ چھُس ژٕٹِتھ مُمکِن نوکٔری ہنٛدِ خاطرٕ ژۄراو، تہٕ سٲری دۄہ چھُس آئینہِ ہنٛدِ سامنٕے مشق کران۔
تہٕ تُہۍ کیاہ کٔرِتھ ژٕوان؟
آ، مگر آتہ چھُس مےٚ تِم کٔرنس پؠٹھ خراب گژھان۔
تَتھ ٲسۍ لگ بگ ۵۰۰۔
مےٚ شرط لٲگان چھُس تُہۍ شُکرگزار آسن۔
یِمن سۭتۍ تُہۍ واریاہ پیسہ بچٲوِو۔
سُہ ٲسۍ تِمِس چینلن منز یِم پٲٹھۍ شو گوٚڈ چھُ دکھاون۔
اَز مےٚ گژھ گھر تہٕ میون سٲری گھر ٲس صاف۔
مےٚ چھُس پٲک یقین زِ سٲری کینٛہہ ٹھیک گژھِ۔
سُہ چھِ نیشنل آنر سوسایٹی ہنٛدۍ طالِبہ۔
مےٚ چھُس یِمن گھرن منز رٲوان تِمِس سۭتۍ واریاہ نفرت، مگر آخر مےٚ ژٕٹ اکھ یِم مےٚ سۭتۍ سچٕے پسند چھُ۔
یِم چھُ आत्मविश्वास واریاہ بوزان۔
مےٚ تُہ کَتہِ نَہ دِژ، مگر مےٚ چھِ اَچھِ جذباتی فلم پسند۔
اوہ، یہ چھِ گژھان زِ تُہۍ ووتھ وقت۔
اوہ نَہ، مےٚ دِلبر، تُہندس پٮ۪ٹھ کیٛاہ گٔیو؟
تہٕ یہِ تہٕ شُکر گُزار رَہِو زِ تُہۍ کَنہِ روزگار چھُ۔
مےٚ چھُس واقعی یژھان زِ مےٚ یہِ مِلہِ۔
مےٚ چھُس سٲری دۄہ تیٲری کران۔
مےٚ چھُس پَکّ زِ مےٚ چھُ اَچھ کٔرمُت۔
یہِ احساس چھُس مےٚ خاطر نَہ اَنجان۔
مٲرۍ ساس چھِ ہمیشہ ژھوٹ ونان تہٕ گژھان گۄڈ بڑٕ چڑھٲون۔
تہٕ سُہ چھُ وٲنٛگن ونان زِ تَمہِ چھُ یاد نَہ۔
ہا ہا، اصلس منز آسن، مگر کانٛہہ ڈراون وٲل نہٕ آسن۔
مےٚ کٔر مٕس دوستس شُکریہ زِ تٔمہِ مےٚ خٲطرٕ کَسٹَمٲیزڈ پٮ۪ن ژٕٹ۔
گٔے ہفتہِ مٲرۍ پالِت کُتھ مٲر گٔیو۔
مےٚ چھُس پسند کران کھلونے تہٕ گیجٹِو ہُنٛد سیکشن وُچھن، زِ مےٚ بچن خٲطرٕ کانٛہہ مِلہِ یا نَہ۔
یہِ چھُ بلکل یِم جۄن بچہٕ گژھن تہٕ کرسمس ہُنٛد راتھ ژھۄرِتھ پٲٹھۍ جوش محسوس کرن۔
آج مےٚ کٔر اَچھ پٲٹھۍ پَکِت سٹیک کھٲد۔
اَکھ سڑک فنکارن پنُن کُتھ بایِک پٮ۪ٹھ سوار کٔر۔
تہٕ مےٚ چھُس ونان زِ تُہۍ گژھِتھ دِژھُن آسہِ زِ کانٛہہ ژَخمی گٔیو یا نَہ۔
مگر چھُ یہِ اَچھ زِ تُہندس سٲری بھاوان سٕتۍ چھُ نیڑِچ رشتہٕ۔
تٔمہِ کٔر مٲرۍ فون نمبر فیس بُک پٮ۪ٹھ پوسٹ۔
مےٚنِس ماجہ اچانک مےٚنِس خٲطرٕ اکھ کیک بنٲو۔
تُہۍ کِتھ پٲٹھ صفحہ گژھِتھ؟
بینک نِش جواب یوان تام انتظار کرُن چھُ ہمیشہ تکلیف دہ۔
بۄد نِش گژھن وٲلۍ گَرٕ چھِ مےٚ سچّی ڈرٲون۔
مگر چھُ یہِ پنُن پکوان سیکھنہِ کِنہٕ واریاہ آسان۔
مےٚ چھُ یقین زِ محنت تہٕ پٲک ارادٕ سۭتۍ تُہۍ تہِ اکھ سُہنٛد روزگار لَبِو۔
مےٚ چھُ انتظار زِ فال ٹی وی پروگرام کَتھ یِوان۔
کامک اکھ مُشکل دوہِ پٲٹھۍ تَمہِ کرُن مےٚ تہِ پسند چھُ۔
مےٚ ہایِسکول دۄستَن فیصلہ کٔر زِ گَژھِتھ اکھ جایِہ راتھ ہٲر کھٲیو۔
نَہ، مےٚ نَہ لٲگِتھ کُنہِ سُہنٛد روزگار یِوان۔
کیا تِمَن کٔر قرض دہندِس سۭتۍ رابطہ قرضک ترمیمہِ خٲطرٕ؟
تٔمَن حتٰی مےٚنِس کارِس نِش کار پارک کٔر۔
مےٚ گژھِ یِم ہَژ چھان بِینٛتھ یِمِس وُرۍ۔
کینہہ ٹینشن کم کرنہِ خٲطرٕ چھُ یہِ واریاہ سُہنٛد۔
کال مےٚ ٹریفک منٛز اکھ گاڑِ ہنٛز رۄک کٔر۔
سٹار وٲرس چھُ مےٚ سٲری وقتن ہُنٛد پسندیدہ فلم۔
مےٚ سۭتۍ مےٚنِس گرل فرینڈَن بریک اپ کٔر تہٕ مےٚ چھُ واریاہ پریشان۔
مےٚ چھُ یقین زِ تُہۍ کرِو، تِم چھِ یِوان جلدی واپس۔
مےٚ چھُ یقین زِ یہِ چھُ۔ مےٚ کُن چھُ نَہ کُنہِ پنُن، مگر آسہِ تَو مےٚ گژھِ سچّی جذباتی۔
مےٚنِس ماجہ مےٚنِس بَبر دۄکھ کٔر۔
یہِ چھُ سۄنِتھ کٔنِتھ مزٕدار
بِلی چھِ تُہۍ جاندارَن سۭتۍ پیار کرنُک سِکھاون
کاہ ہفتن پیٹھ مےٚ پنُن من پسند برتھ ڈے کیک آرڈر کٔر
شاید تِمَن ہُہ جاےِ پَہلِے برٕ کٔر، تہٕ یہِ تُہۍ سۭتۍ ذٲتی طور کٲنہہ تعلق نَہ اوس
مےٚ چھُس فارمیسی ٹیکنِشیَن
یہِ چھُ دو جڑواں بچن خٲطرٕ پورٕ وقتُک کٲم
مےٚ چھُس سٲریَن ہُنٛد خرچ نَہ سَہِتھ، مگر مےٚ کَتہہ چھِ
یہِ چھُ کمال زِ تِم چھِ اَسہِ اتھ نزدیٖک چلان زِ اَسہِ رۄڈس منز لَگ بَگ اَسہِ سۭتۍ ٹکران
سُہ چھِ اکھ سبقہٕ پتہٕ تِمن سۭتۍ وۄنۍ سۭتۍ بہتر یُس مےٚ سۄنچان اوس
مےٚ چھُس زیادہ تر سستہ ترین کمپیوٹر وۄنُن والہٕ قِسمُک اِنسان، مگر مےٚ تِمُک آزمایا تہٕ سُہ سچٕچ نِشٕ ٹھیٖک اوس
باور کرُن چھُ ٹھیٖک، مگر سدا رہِو خبردار تہِ
مےٚ چھُس اکھ بینڈس منز وازان، تہٕ تازٕ مےٚ اکھ کانسرٹس منز وازِتھ، یِتھ پٲٹھۍ سۄ سامعین اوس یِمَن سۭتۍ کٔرِتھ سۄدٕرِتھ
مےٚ دوست چھِ سدا مےٚ سۭتۍ کٔرِتھ پلان رد کران
مےٚ چھُس اکھ مہینس خٲطرٕ روز پنٛژَن جاےَن منز وازِتھُک پلان بناوان
مےٚ بچہٕ اوسَن اَز تہِ کارٹون وۄنٛدِتھ جاگِتھ
یہِ چھُ مےٚ خٲطرٕ واریاہ معنی دار، کیازِ سُہ چھُ وۄنۍ وفات پٲمتھ
وۄنۍ چھِ اَسہِ تِمِس یِوان پٲٹھۍ فقط اِنتظار
مےٚ چھُس واریاہ توہم پرست، تہٕ مےٚ چھُ لگِتھ شاید سُہ اوس اکھ شکل بدلاوُن والہٕ
وۄنۍ چھُ بہتر محسوس گژھان
مےٚ ؤن سُنے چھُ کہ تِم مُلکَس باہر چھِ رَہان تہٕ قٲنونس منز نَہ یِوان فون کران۔
مےٚ تہِ آس سُرور تِمَس پٲٹھۍ۔
یہِ سَٲعتھ کٲم نَہ کران، مگر مدد کران۔
یہِ صِرف اکھ اچھِھ والِدَین بَنُن چھُ۔
مےٚ چھُس پنٛنِس نوکری ہٕنٛز اِنٹرویو خٲطرٕ بےصبری سان واتھان۔
مےٚ چھُس نہٕ یِمن منز سَبَس بہترین۔
اوہ، مےٚ چھُس تُہٕنٛدِس خٲطرٕ خوش۔
یہِ کَرن چھُ ضروٗر مُشکِل۔
مےٚ چھُس پنٛنِس آخری اِمتِحان ہٕنٛدِس بارَس منز فِکرَمَنٛد۔
مےٚ چھُس کِنٛہہ ہَژران، مگر مےٚ چھُس سَمٛژھان زِ مےٚ آسٕہِ ٹھیک۔
مےٚ تہٕ یہِ کُڑ چھِ کینہہ وقتہٕ پیٹھ ڈیٹنگ کران تہٕ آخرکار ؤن زِ أسۍ چھِ اَکِس سٕنٛدِس مُحبت کران۔
کیا تُہٕنٛد مطلب چھُ یہِ لفظی طور، یا تُہٕ چھِ صِرف پٲٹھۍ وُچھان زِ تُہٕ چھِ تیار گژھان؟
یہِ چھُ دلچسپ، مےٚ چھُس تہِ پنٛنِس صوفہٕ سٕنٛز ٹیلیویژن۔
سُہٕنۍ طریٖقہٕ، ضروٗر؛ مےٚ ؤن سَمٛج زِ ٹرمپ گژھِ آس اَتھ وَقتس تام معیشت خراب کَران۔
اَتھ پٲٹھۍ محنت کرن پَتہٕ کینٛہہ آرام کَرن چھُ بوٚڈ ضروٗری۔
تِم تُہٕنٛدِ خٲطرٕ اکھ نَو چیز لَبی تھٕ دِتھ ہیکن۔
تُہٕن کِس پٲٹھۍ یہِ خرچ کوٚر؟
مےٚ ہیکُن آس کِہِ زِیادٕ فائدمَنٛد کٲم کَران۔
ضروٗر کُن کینہہ وقت تہٕ پنُن غُصہٕ کَڈِو۔
گژِو سٲل ہَریکینَن کٮ۪ریبینَس سٕنٛز یُس حال کٔر، سُہ دِلہٕ مےٚ دُکھی۔
ہاں، سکریچ ٹکٹہٕ ۳ سیب ملن۔
یوتاہ مےٚ دوستن میانہٕ خاطر پارٹی کٔر۔
کیا سُہ سکولس منز مصیبتس منز پھٔژ؟
مےٚ چھُ یِوانۍ دۄہ دٔفتَرس منز اکھ بوٚڈ میٹنگ، تہٕ تَمہِ سۭتۍ مےٚ تھوڑا نَروس لَگٕنۍ۔
بہٕ ناروے گٔژھ وُچھنہٕ تہٕ برفس پٮ۪ٹھ چڑھان کٔر۔
اوہ واہ، سُہ چھِ واریاہ ڈراؤنی فلم۔
وۄنۍ، مےٚ اکھ پرٕتھ کٔر کٲم کرٕنۍ۔
مگر بہٕ تَمہِ خٲطرٕ تیار آسٕس۔
اَز چھُس بہٕ گَرِ منز اکیلا، کیازِ ساروٕنی کینٛہہ نہٕ کینٛہہ کٲم اوس۔
تٔمۍ سۭتۍ یہ وقت مزٕ کٔر۔
بہٕ واٹہِ پٮ۪ٹھ اکھ برفٕچ جاے منز پھسلِتھ بلکل تھَلے پٔتم۔
تِم کتھ تیزی سۭتۍ بوٚڈ گژھان۔
او ہاں، تُہۍ کِیاہ کرُن ہٕند منصوبہٕ چھِ؟
یوتاہ کُن مےٚ سُہ چیز گم کٔر یوس مےٚ مادَرَن مےٚ کانووکیشنہِ دوران کٔنی آس، تَتھ پٮ۪ٹھ چھُس مےٚ واریاہ خواہش اکھ حٲصِل کرُن۔
کھٲنہٕ چھُ زندگیُک دروازٕ۔
اچھا، شو چھُ کِیاہ؟
اُمید چھُ تُہۍ تَمہِ پٮ۪ٹھ پرٕتھ اکھ موقعہٕ مِلِو۔
یَلہِ بینڈ بَجِوان اوس، مےٚ دوستَن بارس منز مےٚ پٮ۪نٛٹ ترٛٲوُن مزاحیہ سَمٕجھ۔
کینہہ دۄہ چھُس بہٕ تَمہِ بابت فِکرمند۔
یہِ مدرز ڈے پٮ۪ٹھ بہٕ واریاہ اداس آسٕس، کیازِ مےٚ مادَرَن مےٚ سۭتۍ رشتہٕ توڑِتھ چھُس مےٚ سۭتۍ گپ نہٕ کَران۔
ہوٗائی جہازس منز توقعہ کھۄتہ زیادٕ سامان آنن والۍ لوگ مےٚ غصہ دِوان۔
ہاں، بہٕ تہِ تِمےٚ طریقہٕ چھُس۔
یہِ چھا پوری طرح تباہ گژھان یا درست کٔرِتھ یِتھ؟
تِمَن ہُتھِ تھاونٛچ بجاےٕ کَرِ نوکرِس پٮ۪ٹھ کٕڈنہٕ گژھِ۔
تُہۍ چھا ‘د میگ’ ہُنٛد پریویو دِژھ؟
بہٕ اکھ ریستوران منز اوسُس، تہٕ ویٹرَن اوس نہٕ اسہِ کینہہ سَروِس کٔرِتھ۔
سارٕ ہفتہٕ اوسُس پران، تہٕ کَدی نہٕ اوسُس یِتھ تیار محسوس کٔرمُت۔
بہٕ چھُس زٕیادٕ ڈرپوک۔
بہٕ اوسُس نہٕ یِہ باتھ تِمَن آگےٚ واتان، مگر بہٕ چھُس ڈرامہٕ ژھٲڑنٕچ کوشش کران۔
میٲنۍ کمپنیَن کٔرمچارِین ہٕٹاون ہٕنٛد سوبہٕ بہٕ اوسُس واریاہ وقت بےروزگار۔
میٲنۍ بیٚیہِ کینہہ مہینن منز دوٚہ ورِۍ گژھان، بہٕ چھُس تِم سۭتۍ کینہہ اداس۔
چھا چھُ تُہۍ کُنہِ یِمِچ کینہہ پُرانۍ تصویریِ، یِم تُہۍ دِژھِتھ ہٮ۪کِو؟
یہِ چھُ اکھ بےرحم کٲم۔
مےٚ اکھ بٹواہ لٲگ تہٕ بہٕ اوسُس سٕتۍ مالِکَس وۄپس دِوان۔
شُکر چھُ خۄدایُک، دۄنَو مریض چھِ واریاہ تِکیٛاز۔
یہِ چھُ اکھ بچَس خٲطرٕ ڈراونٕچ گۄڈ۔
