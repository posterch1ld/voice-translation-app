مےٚ چھُس واریاہ وقتھ پٮ۪ٹھ کاؤنٹی فٮ۪رِس نہٕ گژھمُت
مےٚ ہٮ۪وٗس تِہٕ دِتھ کٕہ واریاہ خوش
سُہ کمینہٕ چھُ مےٚ سٕتۍ دغا کران تہٕ پنٛنِہ سٲڈ پیٖس سٕتۍ چھُ چھُٹِی گژھُن یژھان
تَمہِ سُہ مےٚ پنُن گۄڈٕکُس نِنٹینڈو ۶۴ لَگِو
تُہۍ چھِ پنٛنِہ خٲطرٕ اَکھ سبق سِکھمُت یِم دۄہٕن
مےٚ اوس یقین زِ ژٕ کَتھِی مےٚ سٕتۍ دغا نہٕ کَری
اوہ ہا، مےٚ کرٕ کوشش زِ مےٚ تِہٕ یاد رَہِ یِہ
مےٚ چھُس نہٕ یقین، مگر مےٚ چھُ سَدا یِہ احساس زِ لوٗکن ہٕنٛز چھُ کُنہٕ پوشیدہ مقصد
ہاں، مےٚ وٕنٛدِس پتاہ لَگِتھ زِ مےٚ کمپنی ہٕنٛز پروفائل پیٹھ زیادٕ تحقیق کَرُن پٲوان
مےٚ وُنو زِ یِہِ چھِ سُدھران
اوہ واہ، سُہ چھُ واریاہ پیٖار
مےٚ تہٕ میون ڈٲڈ پَہلِہ أکٹھ شطرنج کھیٚلوان
مےٚ گوٚو دِژ کہِ ایمپلویَن منز أکِس کُنہِ ہیٚنٛز کھانَس منز تھوٗک دِوان
فٕلایٹ دوران مےٚ گوٚو ٹایلیٹ، تہٕ میٲنِس پَتھ أک زَنٛہ آیِہ
أک بٔڈ جاب حٲصل کرنہٕ خٲطرٕ مےٚ واریاہ محنت کٔرۍ چھِ
کیا یہ چھُ تِمِس لَگ بَریٛن وقت لوٗکن ہٕنٛد بیٚچ گِردٕ گِردٕ روزان
آج میون بچہٕ تٔرٛے گنٛٹہٕ نِنٛدر کٔر، یِہ چھُ غٲر معمٗول
مےٚ کُنہِ پٲٹھۍ شراب نہٕ پیٛوان
مےٚ چھُس یِم ویکنٛڈ خٲطرٕ واریاہ پرجوش
یِم گرمی مےٚ کٔرِو سارِن کلاسَن منز کامیٲبی، کیازِ مےٚ پَہلِہ کَتہِ نہٕ کٔر یہِ
ییلہِ مےٚ آسُس لٔکٕٹ تہٕ مےٚ گوٚو پتہٕ کہِ أسۍ جٲو امیوزمنٹ پارک
مےٚ نہٕ وٕنۍ، مگر مےٚ اوس سٲری فِکر کہِ یہِ بلیک وِڈو ہاوِتھ آسِہ
ٹھیک چھُ، تِمَن کٔہِو تاکہِ گٔڈٕ یِم کٔرِو
کیا تُہۍ گوٚو بی
کامہٕ خٲطرٕ تِمِس پنٛنِس گاڑِس منز گیس بھرٕنۍ ضٔروٗری آسِہ
لگٕن چھُ تِمِس پنٛنِہ ترجیحات ٹھیک تہِ ترتیب دِتھ، شاباش یار
میٲنِس دوستَن حالیہ منز دِی میٛٲنِس پنٛنِہ گاڑِی تاکہِ بہٕ شہرٕ ہٕنٛز باہر گژھِتھ ہٲوٕں
مےٚ ٹٮ۪لیوِژن پٮ۪ٹھ میون پسندیدہ شو ہٕرٕو
میٛون پَہلِہ منگنی گٔمٕتھ آسِہ
مےٚ اُمید چھُس تِمِس بیمہٕ آسِہ
مےٚ چھُس فلمہٕ دِژنس تہٕ کھانٛہٕ لیٚنس واریاہ شوق
مےٚ چھِ زٕ کٲنٛہہ تہٕ اَکھ بَچہ، تُہٕنٛد؟
مےٚ چھِ کینہہ اَسہِ چیزٕ دۄدھمٕتھ، یِم مےٚ نَہ ہیکہِ سمجھٲوِتھ۔
پرٕس مےٚ ہُنٛد ژور ؤریاہ بچہٕ مےٚ ہُنٛد پسندیدہ مُورتۍ توڑ۔
مگر ڈرٲونٛک آسُن چھوٚڑِتھ، عام طور پٲٹھۍ یہِ اَکھ سۄنٛدر فلم چھِ۔
تُہٕ چھِ اَتھ پٲٹھۍ کِتھ پٲٹھۍ ژٲنٛدٕ؟
مےٚ ہُنٛد خاندانٕ پٮ۪ٹھ چھِ واریاہ وۄنۍ سٹاک مِلِتھ۔
گاڑِ تہٕ عمارتو سوا کانٛہہ نَہ۔
اَسہِ کَتھ نَہ چھِ فیس ٹایم کٔرمُت، مگر یہِ چھِ واریاہ سۄنٛدر خیال۔
مےٚ کَتھ نَہ چھُ واریاہ شوق بٔڈِ ٹیلیویژنَن ہٕنٛز۔
سمُنٛدرِ کَنٛٹھٕ اَکھ کَنڈو خٲطرٕ بندوبست کران۔
تُہٕنٛدۍ دُکان پٮ۪ٹھ کینٛڈی کِژ کٔر چور؟
یَتھ مےٚ ہِنٛز ماجہٕ مٔر۔
یہِ سادٕ لگِتھ ہٮ۪کِہ، مگر مےٚ چھُ بس خوش یِمتی آخرکار جمعہٕ چھُ۔
مےٚ کٔر کمال، مےٚ لٔب 95—چھِ واریاہ حیران۔
کَنہِ دُکھی انسان چھِ مِٹھۍ کلامہٕ سۭتۍ آرام دِتھ ہٮ۪کِتھ۔
کیا چھِ تِم عام طور پٲٹھۍ جیتن وٲلۍ ٹیم؟
یہِ چھِ ہر اکھ خٲطرٕ نَہ۔
یہِ سُنتھ دُکّھ لٔگ—تُہٕ چھِ اَتھ پٲٹھۍ باہَر پھنسِتھ؟
مےٚ چھِ اَکھ احساس تُہٕ واریاہ کامیاب گژھِو۔
یہِ چھِ اَکھ موروثی بٲری۔
مےٚ گاڑِ ژھانٛگ پٲرک کران اوس تہٕ سُہ مےٚ ڈراونہٕ خٲطرٕ اچانک بوزِ آو۔
مےٚ بیٚیہِ خٲطرٕ مےٚ محبت زیادٕ گژھان چھِ تہٕ وُنِ اَتھ حِساب نَہ چھِ۔
آہ، یہِ چھِ بٔڈِ خراب۔ مےٚ اُمید چھِ تُہۍ جلدٕ تُہٕنٛدِ بہترین دوست سٕنٛدۍ ملاقات کٔرِو۔
سُہ چھِ بٔڈ تعداد برٛٲدرن ہنٛز۔
منیجر مےٚ سۭتۍ معافی وُچھان اوس۔
وُنِ اَتھ سٕنٛدۍ واریاہ نَہ دِکھان چھِ۔
آ، مےٚ آرامس منز چھُٹِہٕ پٲٹھۍ سفرس چھُٹِہٕ لٮ۪کھن پسند۔ تُہۍ کِتھ پٲٹھۍ دور گٔے؟
مےٚ سٲچِ امید اوس زِ مےٚ ماوجِ روزگار سِدٕن گژھِ مِلن۔
یہِ فون اوس بٔڈ مہنگا تہٕ وُنِ اَتھ کرٕنۍ چھُ درست۔
تُہۍ سُہ شرٲب پیٚون بند کرنہٕ خٲطرٕ کِیاہ کٔرِتھ ہٮ۪کِو؟
سُہ چھِ ٹھیٖک، کم از کم تُہۍ تیار اوسِو۔
نتیجہ آیہِ تہٕ مےٚ پنٛنِس ٹیم سۭتۍ قومی مباحثہ چیمپین شپ جیت۔
واہ، مےٚ اُمید چھِ تُہٕنٛدِ خٲطرٕ سٲری کینٛہہ ٹھیٖک گژھِ۔
چونکہ مےٚ سفر کران اوس، مےٚ پنُن ژھۄنٛگ ہفتہٕ خٲطرٕ ویٹرس نِش تھاون پٲوان۔
اُمید چھِ سٲری کینٛہہ پلٮ۪ن مُطٲبق گژھِ۔
مےٚ اندازٕ چھِ سُہ تُہٕنٛد پسندیدہ موسم۔
سُہٕنٛد پگٲر کِیاہ اتھ سۭتۍ بٔڈ اوس؟
گٔژھِ ہفتہٕ مےٚنٛز بھٲجیٚن پٲٹھۍ پٲٹھۍ لفظ وُچھ۔
پنٛنِس کٲسِرۍ چھِ بٔڑ گژھان تہٕ روزانہٕ کُنہِ نہٕ کُنہِ کٲمۍ مےٚ احساس دِوان زِ زندگی بدل گژھان چھِ۔
مےٚ سٲچِ اُمید چھِ زِ تُہۍ جیتِو۔
پنٛنہِ خٲطرٕ ڈرِتھ نہٕ
اگلے سوموار چھِ مےٚ امتحان، یِم مےٚ بہترین طریٖقہٕ سان پاس کرُن چھُ
تِمن مےٚ پٮ۪ٹھ گۄڈ اثر کر
مےٚ چھُ یاد، ییلہٕ بہٕ ننہٕ آسُس تہٕ آیس کریم ٹرک پٮ۪ٹھ دٲوان اوسُس
مےٚ چھِ تِم قٕسمٕچ گیمہٕ واریاہ پسند
مےٚ چھُ یقین زِ آخرکار تہٕ تٔمِس معاف کٔرِ
تُہۍ دوٚنِو کَتھ کٔنۍ ہٮ۪و یِکۍ دۄسرو دٕ ژٕن
یِمن چھُ تقریباً تُہٕنٛد ذائقہٕ گژھان ختم
تِمَن مےٚ نہٕ دی ترٛٲوت، حالانکہٕ بہٕ تِتھۍ ۴ وٲرۍ آسُس
ہاں، مگر یہِ کینہہ وٲرۍ پتہٕ گٔیو
کیا تُہۍ گٔیو فیصلہٕ زِ یہِ مزید کھوجُن چھُ
آج چھِ مےٚ بَچِ مےٚ پاگل کَران
مےٚ چھُ ہمیشہ پنٛنہِ آپ یاد دِوانٕچ کوٗشش کران
ہاں، مےٚ چھِ تِم دۄہ تہِ یاد
بالکل، مےٚ ہٕنٛز دھڑکن چھِ واریاہ تیز آسٕن
اگلے ہفتہٕ چھُ گۄڈ دن تہٕ مےٚ چھُ نہٕ صبر گژھان
مےٚ ہٕنٛز پُترن عوامی جاےِ پٮ۪ٹھ پنٛٹ کٔر وٕتھ
مگر مےٚ چھُ خوش زِ نٔو والہِ منز چھُ تُہٕنٛد نٔو دوست
مےٚ چھُ ڈونلڈ ٹرمپ پٮ۪ٹھ واریاہ غصہٕ، یِمن کنۍ تِمن دِژ حُکم زِ بَچِ تِمَن ہٕنٛدۍ والِدٕین ہٕنٛز جُدا کٔرِو
یہِ واقٔعی اکھ نَفنٛد سِگار کٹر اوس
اوہ، یہ واقعی بٔہٕ گَندٕ چھُ۔
۲۶ ؤرۍ ہٕنٛد حیسیتس، مےٚ نہٕ ہیکِ تصور کٔرِتھ کہِ یِتھ عمرس منز مےٚ بچہٕ آسَن۔
یہِ پَکٕکٕتھ سُہ آو سُہنٛدر تہٕ پُرسکون۔
مگر تَمہٕ بوز پٔتھ کینہہ ژوٗن یاد تہٕ کینہہ تھوڑٕ اَشک واپس۔
کیا تُہۍ بارشہٕ پیٹھ بچِتھ ہٕیٚکِو؟
مےٚ نہٕ کَتھٕ کٔنۍ یِم ہٕنٛدۍ سُنٛد، مگر یقین کٔر، بہٕ گوگل ضروٗر کَرٕ۔
کَل مےٚ اَچانک اَکھ اَسہِ شخص سٕتۍ ملاقات گژھِ یُس مےٚ ؤرۍ ؤرۍ نَہ دۄن۔
پانٛژھ منٹ پَتھ تِم نَو ڈایپرَس منز ہر جا پَخانہٕ کٔر۔
بہٕ یہِ آٹہٕ تہٕ انڈٕ سٕتۍ بلکل شروٗعہٕ پیٹھ تازٕ بناوان۔
مےٚ نہٕ ہیکٕ کُنہِ تہِ جاے گٲڑۍ پارک کٔرِتھ یتھ مےٚ چاہان؛ ژٕٛنٛگۍ چھِ مےٚ پارکنگ جاے چوراوان۔
تَمہٕ مےٚ گٔژھ پٔتھمٕن زمانٕچ سوچ کٔرٕنۍ۔
مگر یہِ سُہ گژھِ بٔہتر۔
بہٕ واریاہ ؤرۍ ریٹیل منز کٲم کٔر، تِلہٕ چھِ مےٚ تِم لوٗکن سٕتۍ ہمدردی یِم تِتھ حالتس منز چھِ۔
مےٚ چھِ سچٕچ تِتھٕ آس، یہِ چھُ بٔہٕ وۄپھ۔
مےٚ دۄکھاوٕمُت یِتھ پٲٹھۍ، تَتھ پیٹھٕ زٕیادٕ دۄکھاوٕمُت۔
مدد مِلان چھُ سُہنٛدر۔
بہٕ واریاہ جوشس سٕتۍ اندر گٔژھِ تہٕ انٹرویو زبردست کٔر۔
مےٚ پَزِ یہِ ویک اینڈس منز دۄن۔
یَلہٕ بہٕ کلاسس منز آس، مےٚ نٲو اَکھ ایوارڈ خٲطرٕ ذِکٕر گژھ؛ بہٕ بوزِ نِکلسِتھ خۄش آس۔
تِم پٔتھٕم راتٕچ کَتھٕ سٕتۍ چھِ مےٚ بٔہٕ وۄپھ محسوس گژھان۔
بہٕ أسۍ نِش باہر گژھن وٲلۍ راتہٕ خٲطرٕ سٲریو سۭتۍ انتظار کران اوسُس
بہٕ نَہ ہیکان انتظار کرِتھ یَلہِ گوٚوُن فلم یِیہِ باہر
خۄش قسمتی سۭتۍ تِمۍ نَو تہٕ تِمۍ پٲٹھۍ سۭتۍ بلکل ٹھیک چھِ
مےٚ پنٛنۍ گرل فرینڈ تہٕ ژٕوٚنٛٹ دوستن ہٕنٛز گروپ سۭتۍ ملاقات کرنہٕ سۭتۍ برونٛہہ اکیلا اوسُس
تہٕ چھِ سٲریو سۭتۍ جانان زِ سُہ کیٛاہ کَران چھِ
تِمِس کینسر اوس تہٕ تِمۍ نہٕ گوٚو دیرِ سۭتۍ پتہٕ
مٲرۍ گاڑِ چھِ خراب تہٕ چونکہٕ أسۍ ہٕنٛز بۄنہٕ اکھِ سکولس گژھان چھِ، تِمۍ آفر کٔر زِ أسۍ اکھ سۭتۍ گاڑِ ہٕنٛز سفر کَرَو
أسۍ چھِ یہِ کم از کم اکھ دۄہ مہینہٕ کَرنہٕ ہٕنٛز منصوبہ بندی کران، تِمۍ سۭتۍ مےٚ تہِ آس چھِ
تُہۍ کَتھ تہِ نَہ ہیکوٕ جانِتھ زِ کُن حالاتن کِنۍ کُنہِ انسانس یِتھ جاے پٲٹھۍ رَسٕوُن
کیا سُہ ابھی تہِ پپی چھِ
بہٕ کٔر سَعتھ گژھنہٕ پتہٕ
او یار، مےٚ ماریو کارٹ چھِ سۄپر پسند
مےٚ چھِ یقین زِ تِمۍ کرِو ٹھیک
اگر تُہۍ پنٛنِس زنہٕ سۭتۍ ہر وقت نہٕ ہیکوٕ روزِتھ، تُہۍ کیٛاہ کَرِو
مےٚ چھِ یِمِچِس سرپرائز ہمیشہٕ پسند
واہ، یِہ ہیٚو سُنِتھ مےٚ چھِ افسوس، امید چھِ تُہۍ ہیکوٕ یہِ سۭتۍ مقابلا کٔرتھ
مےٚ چھِ شرط زِ سُہ بوٚد پریشان گژھِتھ آسِ
مےٚ کَتھ تہِ نَہ اوسُس یِتھ ڈَرِتھ
مےٚ چھِ پتہٕ زِ پیسہٕ یِوان انتظار کرُن کیٛاہ چھُ
ہوٹل کمرس منز کھٹمل اوس
گژِتھِس مانٛہہ مےٚ برٛونٛہہ لاٹری جِتھ۔
یِم چیزن منز تُہۍ واریاہ پیسہ لَگٲوتھ، تِمن منز تھوڑا واریاہ واپس مِلنہٕ سُہ سُہان لگہٕ۔
آ، مےٚ چھُس خیال کران یہِ چھُ واریاہ زٕبردست۔
یہِ سُہ ثابت کران چھُ کہ اگر تُہۍ دِل لٲگِتھ کٔرِو، تُہۍ کِنہہ تہِ حٲصِل کٔرِتھ ہٲوِو۔
مےٚ چھُس اُمیدوار تہٕ مےٚ لگہٕ چھُ کہ اَسہِ ہُک حُکومت کٔرِ یہِ مُلکُک ہلچل ٹھیک۔
شاید گژِتھ وُچھ تُہٕنٛدِ ٹیم جِتھ۔
مےٚ چھُس سَفَرَس پٮ۪ٹھ یِم پٲٹھۍ تیار رۄزمٕژ پسند کران۔
تُہۍ چھِو اُڑان کران یا ڈرایِو؟
مےٚ چھُس اُمیدوار زِ سُہ پَتہٕ سُہ صاف کٔرِتھ گژھِتھ۔
تٔمۍ پنٛنِس ماج نہٕ لبھِتھ۔
تُہۍ سٲری کِتھ پٲٹھۍ پَتہٕ مٕلِو؟
مےٚ ہُند شَوہر لاس اینٛجلس چارجرز پسند کران، مگر سُہ چھِ نہٕ واریاہ برٛونٛہہ۔
مےٚ ہُنٛدِس ۲۹ وُہِرِس سالگرٕس پٮ۪ٹھ مےٚ ہُند بوائے فرینڈ کٔر مےٚ اچانک کیلیفورنیاچ سفرس سۭتۍ حیران۔
کیا چھُ تُہٕنٛدِس پٮ۪ٹھ کینہہ اِنشورنس پالیسی؟
ییلہِ کِنہہ مےٚ سڑکَس پٮ۪ٹھ ژٕنگ دِژھم۔
اَز مےٚ ہُنٛد والٹ کٔر گُم کٕر کامس پٮ۪ٹھ۔
زنٛدگی منز یِم موقعہٕ واریاہ وٲر نہٕ یِوان۔
اَسہِ سٲری غلطی کران، سُہ واپس روانہٕ کٔرِو تہٕ یتھ پٲٹھۍ تُہۍ ژٕٹھیو تَتھ پٲٹھۍ کٔرِو۔
کیازِ مےٚ نہٕ گوٚوٕم واپس گژھِتھ۔
تِمِس دۄران مےٚ تہٕ مےٚ ہُنٛد گرل فرینڈ اوس گۄڈٕ گۄڈٕ مضبوط رٕشتس منز۔
گرمی چھُندٕ تہِ یہِ ٹھنٛڈ اوس، تَپان نَہ۔
مےٚ یقین نَہ یِوان زِ مےٚ بلیَن سۭتۍ الرجی چھِ۔
نو میکسیکن جایہ واریاہ زبردست گژھِ۔
مےٚ لگٕ چھُس زِ مےٚ اندازٕ لاگِتھ ہٚکوا۔
مےٚ ہٕنٛد کتُر پَران گٔی اوس تہِ کانٛہہ نیک انسان تِم مےٚ کٕن واپسٕ ہٕنٛد۔
مےٚ تہِ بلن ہٕنٛز بچاونٕچ کوٗشش کَرٕنۍ اوس۔
مےٚ ہٕنٛد گولڈفِش مٕری گٔی، مےٚ چھُس بالکل ٹوٗٹمُت۔
مےٚ چھُس پٲکٕہ یقین زِ یہِ اوس اَکھ شاندار تجربہ۔
مےٚ اوسُس تَتھ منز خاص نَہ تہِ سٲریَن ہٕنٛدِس پَتہٕ لَگ۔
گھر گژھتھ مےٚ احساس گو زِ مےٚ اوس سٲری دۄہ شرٹ اُلٹہٕ پہنمُت۔
یِلہِ اَسہِ منگنی کٔر، مےٚ اوس نَہ پَتہٕ زِ یہِ گژھِ۔
یہِ چھُ تۄہہِ ہٕنٛد انتہٕ شاندار کم۔
مےٚ ہٕنٛد بچہٕ نٕے اَز صُبح مےٚ ہٕنٛد سٲری باتھ روم خراب کٔر، یہِ صُبح بالکل نَہ اوس واریاہ۔
مےٚ چھُس کینہہ نوٚو ویڈیو گیم ژٕ خریدٕنۍ یِم مےٚ اوس بہتہٕ وۄرۍ سۭتۍ ژٕ وٕنٛچان۔
مےٚ چھُ ضرورت زِ مےٚ ہٕنٛد کمرٕ منز اَکھ لائٹ روشن آسہِ تاکہ مےٚ نِنٛد یِو۔
مےٚ اوسُس اَکھ دُکانہِ منز تہِ مےٚ اوس سَندوِچٕچ سخت ضرورت۔
مےٚ یاد چھُ زِ مےٚ ہٕنٛد والدین تِم بہتہٕ ژٕ وٕنٛدٕ تھٕ۔
ہاں، تِمِس نٲو چھُ سپوٗنز۔
مےٚ چھُس اُمید زِ تۄہہِ یِتھ گژھِ تِمِس پیسہٕ واپس دِیِو۔
مےٚ اوسُس یِتھ ہفتہِ کینہہ ڈاکٹرن ہٕنٛد رزلٹَن ہٕنٛز انتظار۔
بہٕ کٔلۍ خوشگوار سُکونَس منز چھُس
کاش بہٕ تٔمہِ دِژھِتھ ہٕکَو
گژھِ دۄہ بہٕ دِوان چھُس پنُن ڈرایؤِنگ ٹیسٹ
تُہۍ کُس پیزا گٔژھِو؟
اَز بہٕ پنٕنِ کامہِ مُتعلِق رٔژھ، یہِ چھُ واریاہ پریشان کُن
کیا تُہۍ تہِ سکول مُتعلِق چھِو پٲٹھ؟
مےٚ وٕنۍ چھُس یہِ امتحان خٲطرٕ اکھ ؤرۍ سٕتۍ زیٛادٕ مطالَعہ کَران
مےٚ چھُس گژھان زِ سٕمٲجی ڈھانچن مُتعلِق چھِ تٔمِس سچُی کینہہ پرواہ نَہ
تُہۍ وقت تہِ پیسہ تہِ بچٲوِو
اگر بہٕ تہِ یہِ کَران گژھان آسہٕ، مےٚ وٕنۍ گژھِتھ آسہٕ واریاہ پریشان
بہٕ چھُس واقعی گامس منز روزان
واہ، سُہ گژھِتھ آسہٕ واریاہ خوفناک
ہا ہا، مےٚ چھُس گژھان زِ أسۍ پَتہٕ کُنہِ دۄہَس سٕتۍ زیٛادٕ وقت دِتھ اکھ دۄجٕن سٕنٛز پَزِ جانان
یہِ چھُس کَران مےٚ بَدان احساس
یِمِتھ نیک چیزن چھِ یِہِ سۄ رضاکار بنٕنۍ سٕتۍ سارتھک بَناوان
بہٕ چھُس سۄ فِکر پورٕ پورٕ سَمجھان
بہٕ پیٚٹھِ تہِ دیر کَران آسہٕ
بہٕ چھُس دُنیاہِک سٕبَنہِ کھَرٕ کُول دادی بَونٕچ خٲطرٕ پورٕ تیار
مےٚ بِلِیَن چھُ مےٚ جیکٹ خراب کٔرمت
بہٕ چھُس نٔوۍ نوکری خٲطرٕ درخواست دِوان، مگر اَز تام چھُس نہٕ کانٛہہ لَبتھ
بہٕ واریاہ تحقیق کران اوسس
تَمہِ کَل اوس کھیٚلِتھ اَکھ کلاسک نِنٹینڈو تہٕ تَمہِ سۄ چھیٚ منٛز بچپن یاد کرٕنۍ
آ، بہٕ اوس حٲصل کرِتھ بہترین نتیجٕہ
گژھِت ہفتہٕ بہٕ ژٕ چار جاب انٹرویو دِتھ
اُمید چھِ بہٕ محسوس کران زِ بہٕ گژھنٕچ تیار چھُس
وقتھ مدد کرِتھ ہیکہِ، مگر یِم عزیزس ہٕوٚنُک غم چھُ نہٕ تُہۍ پار کرِتھ ہیکان
سارنی چھِ اکھ گنٹہِ کھٕتر بسترَس پیٚٹھ
تقریبن ژٕ مہینن ہٕنٛد اضافی پیسہٕ
مےٚ دوست اوس دوبارٕ ڈرگس کھیٚون لٲگمُت
بہٕ سمجھے ہیکان زِ تُہۍ کِتھ محسوس کران اوسِو
شُکر چھُ، صرف کانٹیکٹ اوس ڈھیٖلا گژھمُت، تَمہِ سۄ سۄن زِ ژھۄپھ کُھل گٔمُت چھُ
بہٕ ہمیشہ اوسس تَمس ہر کٲمِس مدد کران
حالٕس منٛز کٲم چھُ سُست گژھان، یِم سۭتۍ بہٕ چھُس پریشان
آ، مگر یِتھ چھِ واریاہ وقت لٲگان تہٕ بہٕ چھُس یِتھ واریاہ پسینٛہ کران
بہٕ تَمس پنٛنِس بۄیہِس نِش گَرِس آو
تِم چھِ لگ بگ ۲۰ ؤریٖہِ نِش تِمَن ہٕنٛد فین
اَس اوسَن گژھان کانٛہہ نٔو بروری دِژھنٕہ
تِمَن میون دِل خوشی سۭتۍ بھرِتھ، بہٕ اوسس واریاہ خوش
بہٕ اوسس تِم لمحَس منٛز واریاہ وفادار محسوس کران، میون کُڈ اوس فخر کران
کیا یِم سوموار تُہۍ سۭتۍ کانٛہہ بُرا گژھمُت اوس، یا صرف سُست اوس چلان؟
تُہۍ کَتھ کٔنۍ اوپن مایک نایٹ گٔژھِو؟
اَکھ اچھا مُلازِم لَگہان
مےٚ یہِ آدمی اکھ ہاتھہٕ سۭتۍ ۳۰۰ پاونٛڈ وزن تُلان دِتھ—یہِ واریاہ عجیب اوس
اچھا، بہٕ کینہہ وقتھ پٲٹھۍ پیسہ جمع کران چھُس
یَلہٕ بہٕ کوٚرُس لُکُٹ، ہر خزانہِ منز میون خاندان تہٕ بہٕ سٲب ژٲرِتھ گژھان ٲسِو
ہاں، مگر روزُن سٲری گَژھِ گَلے منز اٹکِتھ
مےٚ چھُ اَکھ بار بار یِوان ڈراؤنا خواب زِ زومبی چھِ مےٚ کھاوَان
مےٚ وۄنۍ کٔل پَتہٕ زِ یہِ مےٚ نَہ مِلِتھ
خاص طور پیٹھ واریاہ کم عُمرِ منز
یَلہٕ مےٚ میون برٛونٛہہ کالیج پٮ۪ٹھ گَرٕ کُن پہلی بار یِوان دِتھ، سُہ یَتھ پٲٹھۍ دِسان اوس تَتھ سۭتۍ گٔوٕس مےٚ واریاہ متاثر
یہِ واریاہ ژالٕہ نَہ گژھان
یہِ سُہ چھُ لَگان زِ یہِ گژھِ تھکاوان
مےٚ چھُ وۄنۍ واریاہ خراب لَگان
تَتھ خٲطرٕ گٔے مےٚ سٲری پٲٹھۍ قصوروار محسوس
مےٚ کَسٕچ نَہ اوس پَتہٕ
بہٕ چھُس متفق، وُچھُن کِنہہ ضرورت چھِ نَہ—سُہ چھِ تھینٛکسگِوِنگ تام گَرِ منز بند
میون بہترین دوستن کٔر مےٚ مدد اَکھ سرپرائز پارٹی تیار کرنہٕ منز میون بہن خٲطرٕ ریکارڈ وقتس منز
گٔے مےٚ پٲٹھۍ ژھٲل یِتھ ویک اینٛڈس منز میون مست دوست یِوان انُن، تَتھ مےٚ گٔے واریاہ رُس
گٔے ژٔتھ مےٚ کوٚر کچرا باہر کَڈُن تہٕ میون ڈرایوے منز اوس اَکھ آوارہ ژُر
مےٚ چھُ اُمید زِ یہِ صرف بہتر گژھِ
مےٚ کَتھ مہینن پٲٹھۍ پنٛنِس بیٚیِس سٍتۍ أک خوفناک فلم دۄن ٹالان چھُس۔
مےٚ چھُس تِم سرکاری افسَرَن ہِنٛز نَفرَت کَران۔
یہِ سٲری کرنہٕ خٲطرٕ تُہۍ ضروٗر چھُو أک زبردست مکینک؛ مےٚ چھُ پتہٕ کِتھ کٲم لَگِتھ۔
مےٚ آو خۄش یِم مدد کَرتھ کہٕ سُہ کٲمُک طریقہٕ سیکھِتھ۔
تِم چھِ سٲری کھۄشگوار تِم قٕسمک مضمون یِم لیکھٕنۍ تہِ آسان چھِ۔
مےٚ چھُس أک ہفتہٕ تربیت ووٚنمت کہٕ بگڑِتھ نوجَوان کِتھ کٔرِتھ قابو کَرنہٕ۔
کاش مےٚ ہٕی واپس گژھِتھ ہٮ۪کِتھ۔
سُہ ہٕنٛزہِ زندٕ اوس، تِمہِ سۭتۍ مےٚ سُہ گاڑِس منز وٲلِتھ ویٹَرٕنٕری کُن نِتھ۔
اَسہِ چھُ أک کٲمُک پریزنٹیشن جلد یِوان۔
یِلہِ مےٚ کُنہِ ہٕنٛز مدد کٔر زِ سُہ پنٛنِس گَرٕ پٮ۪ٹھ سامان کٲڈِتھ نِری، مےٚ اوس سٲری احتیاط کَران۔
مےٚ شروٗع کٔر أک نوٚ کتاب پٲٹھ، تہٕ مےٚ چھُ سُہ پسند یِوان۔
مےٚ چھُس کافی اداس، کیازِ مےٚ چھِ سٲری ویک اینٛڈ اکیٚن پنٛنِس والِدین ہُند ژھۄنٛڈ سنٛبھالُن۔
تُہۍ برٛونٛہہ، مےٚ چھُس سُہ دوستُک گَرٕ پول پارٹی کُن دعوت یِوان کَل۔
مےٚ کٔر أک نوٚ قانون فرمَس منز نوکری خٲطرٕ درخواست۔
مےٚ ژوٚر بھوٚکھ اوس، تِمہِ سۭتۍ مےٚ گٔے دَہ بگ میک کھٲدِتھ۔
شایَد سُہ یِمِس کُن گژھان اوس، تَتھ پٲٹھۍ نٕہ اوس دِوان۔
کینہہ عرصہٕ خٲطرٕ مےٚ دوست اوس زنٛدگِس منز کافی ناکام۔
مےٚ اوس زٕور پریشان، کیازِ مےٚ اوس کُنہِ جاے گژھُن۔
پَر مےٚ چھُس سچٕچ نروَس۔
سُہ ضروٗر بُہ ژٕل اوس۔
مےٚ یہِ سمجھیو، مگر کُنہِ نہ کُنہِ وقت یہِ گژھُن ہی تھا۔
مےٚ مطلب، کُنہِ کُنہِ وقت یِہِ کٔرُن پَوان یُس کٔرُن پَوان۔
لگہِ چھُ کہ تُہۍ سُہ حق دار ٲسِو۔
کیا تُہۍ تِم سُہ گژھان واریاہ؟
