کورٹ چھُ ڈراونہٕ، مےٚ گٔژھموت چھُس گۄڈٕ
آ، یِتھ پٲٹھۍ میٚلِتھ تَتھٕے چھوٚڑمِتھ
سُہ کاؤچس منز آس، مگر اصلس منز سُہ مےٚ یہِ احساس دِوان زِ مےٚ کانٛہہ دوستن سٕتۍ وقت گٲری کَڈُن ضروٗری چھُ
مےٚ پٲٹھۍ پٲٹھۍ آخری پے چیکَس منز بونس میٚل
کیا سُہ چھُ تُہٕنٛد پسندیدہ مہینٕہ
تُہہِ کیا ژٕنٛگن وٲتھ
واہ، تَتھ گژھنس چھُ سُہ کافی زبردست جاے
اُف، سُہ ضرور تھوڑا ڈراونہٕ آسہِ
یِتھ کُنہہ خوشی چھُ نَہ
مےٚ چھُس خوش زِ مےٚ اکھَے دۄپہرِ منز پنُن سٲری گھر صاف کوٚر
ڈٲرٹی ۳۰ پارٹِیٖز چھِ بہترین
کیا تُہہِ لون وٲتھ ژٔھِتھ
گژھ ہفتہ میٚے بہت خواہش آسۍ
تُہۍ پیزا نہٕ پسند چھا
کھٲنہ تہِ چھُ بدترین، کیازِ کہِ ژٕ سٲری جنک فوڈ چھُ اَسہِ گِرد گِرد
تِم چھِ بہت مِٹھی تہِ میٚے خٲطرٕ چھِ بہت اہم
یِتھ سٲلن پیٹھ آسہِ کانٛہہ خیال نہٕ
آج میٚے اکھ گٕے چھُٹ موٹرسایکل پٮ۪ٹھ پٮ۪ٹھۍ وٕلۍ چلاوان دۄن
تُہٕندِ زِندگی ہٕنٛز کُنہہ خوشی ہُنٛد لمحہ کُس چھُ
میٚون دوستس منز اکھ نو کُتھ گوٚو
پَگاہہ گژھن واپَس کُنہہ کتھٕ ہُنٛد گوبَر پٮ۪ٹھ پٮ۪ٹھۍ پٮ۪ٹھ، اُف
بَس ڈاکٹر کُن کینہہ ٹیسٹن ہٕنٛدِ رزلٹٕن ہُنٛد انتظار کران چھُس تہٕ یہِ چھُ لامتناہی وقت لاگان
بَس ہر بار گروسری کِنی سۭتۍ پٮ۪ٹھ پٮ۪ٹھۍ اکھ فہرست بناوان چھُس، تِمِس سۭتۍ کانٛہہ نَس بُلان
تہٕ چھُ امیٖد زِ یہِ سُہلۍ طریقہٕ سۭتۍ گژھِ
یِم گژھِ دٕور، تِمِس وقت میٚے واریاہ دِل خراب گوٚو
آو میٚے چھُ واریاہ لَمب، میٚے چھُ صرف آیل سیٹ پٮ۪ٹھ بٮ۪ٹھان یِوان
تہٕ یِم سٲری ہٕسٕن، تِمِس سۭتۍ تِمَن ہٕنٛز دوٚبارٕ کرنٕچ خواہش گژھِ
تِمِس تہٕ میٚون شَوہرنِ یہِ چُپ چاپ ترتیب دِتھ
میٚون دوستَن ہُنٛد حلقہٕ چھُ تھوڑا
گژھ دۄہ میٚے گَر ووتھ تہٕ دِژ زِ میٚون باپَن میٚے خٲطرٕ اکھ مرسیڈیز آنۍ چھِ
یِم نوٚو زِندگی پٲدا گژھان چھِ، سٲری وقت سُہلۍ لَگان چھُ
میٚے پاس آس اکھ پِٹ بُل، سُہ گوٚو بہت پیارٕ والا
مےٚ سٕرٕن ہٕنٛز تٕم قٕسمچ شوز پسند چھِ، تہٕ بہٕ کَتھ کَتھ ژٕ چَھان سٕتۍ۔
بہٕ حالٕے منز وٕنۍ پَتہٕ اَکھ بارٕ ورزش شٕروع کٔر، تہٕ شٕروعس منز بہٕ واریاہ پَریشان اوسُس۔
مےٚ دوستن لَاٹری جٔت، یِہ چھِ واریاہ کمال۔
سُہ چھِ واریاہ ڈَرٕناوُن۔
اَسہِ منز اَکژھ کران، تہٕ باقی چھِ نہٕ واریاہ دور۔
سُہ ژَنٛگِل نَہ چھُ، سُہ چھِ مےٚ گرل فرٛینڈ۔
مےٚ دعا چھِ زِ گٔژھِ ہفتس منز بہٕ بار اِمتحان پاس کٔرِتھ۔
بہٕ بار بار وٕسراوان زِ فُٹبال سیزن چھُ بلکل نزدیٖک۔
تیٖار تہٕ روانہ گژھنٕچ تیٖاری تھاوُن چھِ ہمیشہ اَکھ کمال احساس۔
اوہ سٲری، وُنِ کِتھ چھُ سُہ؟ کیا سُہِ نوکری چھِ؟
یِہ یقین کَرنٕچ نَہ چھِ زِ لوگ کِتھ پٲٹھۍ بے رحم گژھِتھ ہیکن۔
واہ، سُہ چھِ واریاہ نِیٖک۔
آخرکار مےٚ پنٕن سٲری قرضٕہ ادا کٔرۍ۔
اوہ خدایا، یِہ شٕنِتھ مےٚ واریاہ افسوس گژھ۔
مےٚ چھِ لگن زِ مےٚ نِیٖک کٔر۔
مےٚ ہٕمیشہ پنُن اَکھ گژھٕنۍ اوس۔
سُہ کٕتھ قٕسمُک سُوٕنٛہٕر اوس؟
گَژھِ رات بہٕ گٲڈٕ گٲڈٕ گَژھان نَیٹفِلکس، یَتھ پَتہٕ بہٕ نِنٛدرِ گَژھ۔
لوگن سٕتۍ نِیٖکۍ کٔرِو، تہٕ تُہۍ ژٕ نِش دِوان زِ لوگ چھِ صِرف تَمہِ ہٕنٛد پرواہ کران۔
یہِ سُنِتھ مےٚ اوس دُکھ۔ کَم اَز کَم کینہہ سُہ یاد چھِ یِوان یِم تُہۍ یاد کٔرتھ سَگِو؟
مےٚ چھُس سَدا اِنٹرویوَن مَنٛز پَریشان۔
کامہٕ پٲٹھۍ دور گژھُن چھُ مُشکِل۔
مےٚ ہُنٛد ٹرک بیڈس مَنٛز تھوڑا گریٖس بَقِی چھُ، مگر تَتھ علاوہ سَہِے اوس۔
یَلہِ مےٚ گوٚس تَتھ، جایہِ اوس لُٹ گژھان۔
تُہۍ ہٕنٛز کِیاہ اِنٹرویو چھُ؟
مےٚ ہُنٛد گَر ژِہ کَتھ خریدان اوس، سُہ اوس یِژھان کِہ کلوزِنگ تاریخہٕ برونٛہہ مَنٛز یِتھ رَہِتھ۔
مےٚ کٔھ یِم رٛوم میٹ ہُنٛد آیس کریٖم ہُنٛد آخری حِصہٕ۔
مےٚ نَہ ہیکوس تصور کٔرتھ کِہ سُہ کِتھ پٲٹھۍ مُشکِل گژھِتھ آسہِ۔
سُہ کِتھ گُم چھُ، تہٕ کِیاہ سُہ گَرِ چھُ؟
پَتہٕ رات مےٚ گوٚس مےٚ ہُنٛد کُتھ بۄٹھِ بَرونٛہہ کَڈٕن، تہٕ مےٚ ہُنٛد فرنٹ پورچَس پٮ۪ٹھ اوس اَکھ بٔڈ مَکٕڑ۔
مےٚ ہُنٛد باس چھُ یِژھان زِ مےٚ کَرِ تَمہِ ہُنٛد کُنِہ ہُنٛد خیال۔
اوٚ یار، ہنی بَن چھِ سَبَن پٲٹھۍ ژٕٹہٕ کیک!
اَگر تُہۍ باقی دۄہن مَنٛز صحت مند کھٲنہٕ کھٲوان، تہٕ وۄنۍ وۄنۍ اَکھ دۄہ چیٹ کٔرِتھ چھُ ٹھیک۔
اَکھ لَٹ مےٚ گوٚس ژٕ دۄہن خۄش مَنٛز اَکھ اَنٛدھ جنگل مَنٛز پَھسِتھ۔
مےٚ چھُ اَکھ تہٕ اَکھ چھُ رَستَس پٮ۪ٹھ یِوان۔
تَمہِ کُن اوس ژٕ نَنۍ بَچِہٕ تہٕ سُہ اوس پُرٕ وِقت کام کَران، مگر تَمہِ گوٚو تَتھ کَمَس پٮ۪ٹھ لَگِتھ۔
مےٚ چھُس ژٕرٛورتھ کِہ مےٚ گژھِ کینہہ قٲنونی رٲجیس مَنٛز یِتھ، تاکہ مےٚ ہٕنٛز کارڈ تہِ مِلِ۔
بَچٕن ہُنٛد لنچَس لَگِتھ سامان۔
تُہۍ نَہ زَخمی گٔیو، سُہِے؟
کیا تُہٕنٛدۍ بلیٖن پَکِس دِژھاو کہ باس کُس چھُ؟
تُہۍ تہِ کُتھ جایِ چھُٹۍ گَژھِتھ یژھان؟
مےٚ امید چھُ کہ سٲری کینٛہہ بِہتر گژھِ۔
یہِ مےٚ خٲطرٕ اَکھ تلخ بیدٲری ٲس۔
میون بیٚیہِ دسمبرس منٛز پیٚدا گژھِ۔
سُہ گژھِ ساروٕی دباوٕچ کٲر۔
مٲجہ بنُن سُکون دِن وٕنٛگُن چھُ، مےٚ تہِ چھُ اَسہِ دِنٕچ ضروٗرت۔
بہٕ فٲرٹ نایٹَس منٛز سٲری آن لاین دوست دعوت دِتھ۔
تہٕ بہٕ چھُس تِمَن کیمپسَس منٛز کانٛہہ بیٚیہِ ژورٕن ہٕنٛز نال فِلرٹ کَران تہِ دِژھان۔
مےٚ اَکھ وٲر بٹوہہ ضٲئع گژھ، مگر ییلہِ سُہ مےٚ واپس مِلہٕ نہٕ آمۍ منٛز پیسہٕ۔
مےٚ چھُ خوش کہ تُہۍ پَتہٕ اکھ جُٹ گژھِتھ شُروٗع کٔرِتھ ہیکِو۔
کیا تٔمۍ سٲری کینٛہہ تٔمام کٔر؟
آزٕچ خبر مِلی۔
ییلہِ مےٚ سَمجھ آوٕ کہ اکھ پُرانہِ جیبس منٛز مےٚ چھُ ۱۰۰ روٗپیہِ نوٹ، بہٕ گژھِ حٲران۔
ساروٕی دُکُھ چھُ، تِمن فون کٔرِتھ کَتھ کٔر۔
تہٕ اَکھ مُفت ٹی شرٹ مِلی۔
تازٕ مےٚ بچن کٔر میون خاندٲنی اَمانت ژھٮ۪ت، تہٕ مےٚ ساروٕی غُصہٕ آو۔
کیا آزٕ تُہٕنٛدۍ چھُٹۍ چھِ؟
آزٕ مےٚ اَکھ دوست یُس وٕنٛگُن مُشکل وقتَس منٛز چھُ، تِمِس مدد کٔرِتھ دِن گژھاو۔
بہٕ وٲں چھُس سونٛتھ اَکھ نوٚو جِم کھولُن۔
ہاں، بہٕ چھُس تہٕ میٚون زنہٕ تہِ چھِ کمال۔
اَسہِ اَکھ مُشکِل وَقت گژھ، مگر حال اوس دِژھان سُدھران۔
کُٹمبہِ سٕتۍ چھُٹۍ گژھان نہٕ مِلُن سُہ چھُ سٔچ مُچ افسوس ناک۔
کیا تُہۍ سُہ شخص پولیسس منز رپورٹ کٔر؟
سکولس منز کٕسَن مےٚ وُچھناو تَتھ پَتہٕ مےٚ نَہ آس احساس۔
تُہۍ کُتھ پٮ۪ٹھ گژھان چھِو؟
تُہۍ ضروٗر چھِو پَران بوزنہٕ تہٕ حقایق یاد تھاونہٕ منز کمال۔
اُمید چھُ وقتس سٕتۍ سُہ سُدھرِ۔
مےٚ اوس سٲری طرح تیار یِم روڈ ٹرِپَس خٲطر؛ میٚون سٲری بیگ آس پیک تہٕ بہٕ گژھنہٕ خٲطر تیار اوسُس۔
سُہ اوس کتھ کَران؟
یار، مےٚ تھوڑا تھوڑا بُک لگن شروع گژھ۔
ہاں، مگر مےٚ مطلب چھُ زِ پتہٕ تُہۍ نَہ وٕچھِو زِ تُہۍ انٹرویو پاس کٔر یا نہٕ۔
تِم وٕپس ہیٚونہٕ خٲطر مےٚ کِیاہ کَرِتھ؟
مےٚ اوس پٲداوٕ ۸۰ کِس دہایِکِس آخرس، مگر پرورش مےٚ ۹۰ کِس دہایِکِس منز گژھ۔
آسہِ کَرٕض دِیُن والہٕ بدلٕن پٔژھ تہٕ اَکھ جاے ڈونڈنہٕ منز سٕتھ مہین لگ۔
آسہِ نَہ اوس وَقت دۄیمِ جاے ڈونڈنُک۔
مےٚ ڈونڈ، مگر کُتھ تہِ نَہ مِلان کینہہ یِمِس سٲنہٕ۔
مےٚ نَہ ہٮ۪وان یقین زِ مےٚ کَل رات اتھ پیزا کھاد۔
مےٚ نَہ ہٮ۪کہٕ تھٲوِتھ مدد کٔرِتھ، مےٚ گژھُن پٲوان۔
تُہٕنٛدٕن بَچٕن ہُنٛد شوق سپورٹ کٔرِتھ ہٕیکُن، یہِ زٕبردست چھُ۔
واہ، کیٛاہ زبردست دۄہ چھُ!
مےٚ اوس نَروس، یِم چھُکری سٕنٛد ملاقات کٔرِتھ گژھان۔
تُہۍ چھِو کِنٛہہ بَرٕ کُتھ لٕنے وٕن؟
سیف تہِ گوم چھُ۔
مےٚ پٲوان بَچٕن پنٕنۍ نانی کُن ترٛٲوِتھ؛ مےٚ تہٕ مٕہنٛدِس شٲہرِس گٔے بہاماس سمر ہالیڈے خٲطرٕ۔
چِپچِپ کاغذ چھُ ژٕہ گَژھان۔
تُہۍ کیس سٕنٛد کیاہ کٔرِو؟
مےٚ اوس زٕبردست محنت کٔرتھ پٲٹھ، تہٕ مےٚ اوس سٕہ تیار۔
کینہہ وٕرۍ پٮ۪ٹھ مےٚ أکِس دِلکش انسانس افسوسناک طریقہٕ کھوومُت۔
نَہ، سُہ کَتھٕچ قانون نَہ توڑان، سُہ صِرف تَمہِ فائدٕ لیٚوان۔
یہِ غلط کِتھ پٮ۪ٹھ گژھِ؟
مےٚ أکِس نَوس جایہِ پِزّا آرڈر کٔر۔
اوہ واہ، تُہٕنٛد دوستَن کٔر زٕبردست کٲم؛ اَسہِ حالتن مَنٛز روزُن مزٕ نَہ۔
تُہۍ بِلّی کیازِ لِتھ؟
اُمید چھُ ژٕ جلدی کینہہ یِتھ پٲٹھۍ یِوان۔
از رات مٕہنٛدِس شہرٕچ جیلہِ پٮ۪ٹھ ژٕ دوٚہ ہٕنٛدۍ فرار گٔے۔
مےٚ اوس خوش زٕ ژٕ مٕہنٛد چیزکیک اوس جاپانی پٲٹھۍ پھُلِتھ۔
یِہ اوس پٲٹھۍ تِمۍ کٔرِتھ أکۍ زٕبردست سرپرائز۔
مےٚ اوس رولر کوسٹرن پٮ۪ٹھ زٕبردست ڈر۔
اگر مےٚ جیل گژھن پَزِ تہٕ کیاہ گژھِ؟
بہٕ ہمیشہ تُہۍ سۭتۍ رَہان۔
مےٚ چھُ اکھ ساتھی کارکن یُس واریاہ مدد طلب کران۔
مےٚ چھُس یِم ہفتہٕ آخر ہای سکول رِیونین، تہٕ بہٕ چھُس تَمہِ خٲطرٕ واریاہ خوش۔
اَز مےٚ ہؠچھِ کَترِ منز وومِٹ کٔرمُت۔
بہٕ چھُس متفق، مگر یہِ ناانصافی آو، کیازِ مےٚ چھُس پنٕنِ محکمہٕ منز سبھَنۍ کھۄتہٕ زیٛادٕ واپسی۔
تٔمۍ پنٕنِ سکول سپلای لسٹَس منز تِم چیٖز شٲمل کٔرمٕژ یِم تِمن ضرورت نَہ آو۔
مےٚ اوس خوش یِوان زِ مےٚ اوس کامہٕ پیٹھ دۄہ چھُٹی مٕلِتھ۔
مےٚ چھُس وٕنۍ کینہہ دۄہَن پیٹھ اکیلا محسوس کران۔ تُہٕنٛد دوست کُتہِ چھِ؟
یہِ گژھِ اکھ لوکل کیمپ گراؤنڈ ٹایپ جاے، مگر بہٕ چھُس تَمہِ جاے کَتھ نَہ گومُت۔
مےٚ اوس ہینگ اوور تہٕ بہٕ اوس بیمار۔
بہٕ روٗدس احتیاط، یہِ ہیکِ کُنہِ ویٚلہِ ٹوٗٹِتھ۔
یَتھ بہٕ کینہہ آن لائن آرڈر کران چھُس، بہٕ چھُس تِم حٲصل کرنہٕ خٲطرٕ واریاہ بے صبر۔
یہِ موقع یُس کامیاب گژھنُک اوس، تٔمۍ کٔر واریاہ محنت۔
مےٚ چھُ بوزُر کُت، یِم وجہ سۭتۍ یہِ چھُ واریاہ گژھان۔
کینہہ دۄہِ پَگاہ مےٚ یِتھٕی لَٹری ٹکٹ کٔنۍ تہٕ ۲۵۰ جیت۔ تَمہِ کُنہِ لَمبِہِ نَہ آسِمُت قسمتُک سلسلہٕ پؠٹھ مےٚ اوس واریاہ خوش۔
بہٕ ہیکٕس اکھ سٮ۪کنٛڈس منز پریشان گژھِتھ۔
مےٚ آس چھُس زِ تُہۍ سارٕے ٹھیک آسِو۔
کیاہ یہِ اوس اکھ چیٖز یِم تُہۍ ہیکیو نظر انداز کٔرتھ؟
تُہۍ کِس نَہ کٔرِو گوٚڈ پرفارم؟
تُہۍ تَمہِ خٲطرٕ ضروٗر اَکھ بٔڈ خاص انسان گژھِو۔
میٲنۍ زَن گٔیہِ گَرٕ تہٕ سٲری ٹیبل آسٕن مےٚ پَکٲومٕتھ کھٲنہٕ سٟتۍ بَھرِتھ۔
سُہ وَخت یَتھ مےٚ سَوتیلِس پٲپَن مےٚ تہٕ مےٚ برٛورِس اَکھ ژھۄر دِتھ۔
یَتھ مےٚ سٕتۍ ترٛےٚ دۄہ دَگہٕ گٔیہِ کٔرِتھ، بہٕ دۄبارٕ کَتھ پٲٹھۍ اِعتماد کَرٕنۍ؟
دراصل بہٕ تَمہِ دِنٕہٕ خٲطرٕ وَتھ پٲرٕنۍ چھُس۔
موٹرٕن ہٕنٛز بٲبتھ مےٚ گٔیہِ گژھِتھ بدقسمتی، مگر مےٚ چھُ پَتہٕ زِ حالَتھ ہٕنٛز گَژھِ دۄبارٕ ٹھیٖک۔
یَتھ مےٚ والِدہٕ ہٕنٛز صحتھ ٹھیٖک نہٕ آسہِ، تَمہِ مدد کٔرِتھ مےٚ چھُ واریاہ خۄش گژھان۔
یَتھ بہٕ تِمَنٛز کَمری منز گژھان اوسُس، تِم صِرف کِھل کھِلاوِتھ ہَسٕتھ تہٕ پَتہٕ نِنٛدَر آسٕن ہٕنٛز نَقل کَرٕن۔
ہَمٲرۍ بٔڈ بچہٕ چھِ کالجس منز۔
مگر کیا پٲٹھۍ اَکھ سۄگٲرِس سٟتۍ گژھُن سچِ اَتھُو مزٕ دار اوس؟
مےٚ کٔرِ اتھ محنت سٟتۍ پرٛٲنۍ، مگر چھُس ڈَران زِ مےٚ سٲری جواب نہٕ گژھِ معلوم۔
سُہ چھُ اَکھ گژھان مٔژٕ۔
تہٕ تۄہہِ خٲطرٕ شکریہ یُس تۄہہِ خٲطرٕ کٔرِو۔
مےٚ کٔڈ پَٹِیوُک دروازٕ تہٕ اَکھ بٔڈ چُھپہٕ نٲوم۔
لایِو چیٹس منز مےٚ گٔیہِ اَکھ بٔڈ نیٖک ژۄن نٲومُت۔
واہ، سُہ چھُ واریاہ ڈَرٲون، پتہٕ چھُ تُہۍ؟
آ، سُہ گژھِ مٔژٕ۔
مےٚ چھُ اُمید زِ تُہۍ وَختَس پٮ۪ٹھ ٹھیٖک گژھِو۔
بہٕ لگ بَگ کٔرِتھ اوسُس، مگر اَکھ سٕکَنٛڈ خٲطرٕ کَمری نِش بٲھر نِکُلُن پٔرِ۔
اتھ ویک اینڈس پیٹھ مےٚ کُس آس تھوڑا بیٚمار، تَمہِ خٲطرٕ مےٚ کٔر تَمِچ دَیکھ رٲکھ۔
