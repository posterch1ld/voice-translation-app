ہاں، تہٕ سُہ چھِ وُنہہ کٲنٛہہ دور وُچھُن ہٕچ کوشش کَران۔
نَہ، بس گژھان چھِ گَند۔
مےٚ چھِ یقین زِ تُہۍ ژٕلہِ دۄہ یہِ پٲیہِ برابر کٔرِو۔
تُہۍ چھِ خیال کران زِ سُہ وُنہہ تہِ چھِ تُہٕنٛد مٲل، تہٕ سُہ چھِ اکھ بُرٕہ غَلتی کٔرمُت؟
سُہ چھِ لازمن وٕنۍ ذٔہین۔
مگر سُہ نَہ چھِ دِژھان زِ تِمِس کَنہِ پرواہ چھِ۔
یہِ چھِ سُہ بدترین احساس۔
سُہ کَتھ تہِ کانٛہہ چیز نَہ چھِ کَتھ کَرِتھ ٹٔھیکہِ منز پھٕکِتھ۔
مےٚ چھِ اکھ نِیٚک کٲم تہٕ اکھ کُٹمب یُس مےٚ مٲل کَران۔
یَتھ دۄہ تِمَن نِش کینڈی چھِ تہٕ تُہۍ پنُن سیاہ راز پنٕنِس اندر ٹھیٖک تھاوِو، تَتھ دۄہ تِمَن کَتھ تہِ نَہ گژھِ خبر۔
تُہۍ کالج کِتھ پٲٹھۍ پٲٹھن گٔیِو؟
مےٚ چھِ سمجَان، مےٚ چھِ لگٕان زِ مےٚ چھِ نَہ معلوم ADD۔
تُہۍ کَن چھِ کینہہ واریاہ نِیٚک کٲم کٔرۍ والہٕ۔
اوہ نَہ، سُہ چھِ صُبح دۄہ مزید مال اسٹاکس منز تھاوان؟
ہاں، یَلہِ تُہۍ برداشت کرِو، کَتھ کَتھ چھِ بالکل نَو چیز گژھان نِیٚک۔
کیا تُہۍ وُنہہ تہِ تِمس نَہ وُچھِتھ ہٕیِو؟
یہِ گژھِ اَسہِ ہُند سُہ پٲٹھ بچہٕ۔
مےٚ چھِ امید زِ یہِ نِیٚک گژھِ، کیوں زِ مےٚ چھِ ووٚن سُو زِ یہِ طریقہٕ کینہہ مُشکل گژھِ ہٕکَن۔
وۄنۍ، کم از کم یِہ لگن چھُ کہ ژٕ چھُس تُہٕنٛدِس گژھان۔
تُہٕنٛد دورٕ چھا ٲس سُہٕل؟
واہ، سُہ چھُ زبردست سکور۔
نَہ، بہٕ چھُس جان بچاونہٕ خٲطرٕ رَن۔
تَتھ برگرس منٛز ٲس واریاہ پیاز۔
سُہ چھُ واریاہ خراب خبر۔ تُہٕنٛدِس خاندانس چھُ پٕزِ یقین کرُن زِ وۄہٕرِ آخری وَقتس منٛز آرامس منز روزِ۔
سُہٕ گژھِ آسُن واریاہ سخت ورزش۔
آج کَل چھُ سُہٕ سوشَل میڈیا ہٕنٛدۍ وَجہ سۭتۍ آسان۔
سارٕن ہٕنٛد گژھِ دِتھ تہٕ نٲوتھ زِ بہٕ کِتھ پٲٹھۍ لٲگ چھُس سُہٕ اُلٹٕہ پٲٹھۍ گژھان۔
ژٕ کِتھ پٲٹھۍ رابطہ گژھِ کھۄر؟
بہٕ چھُس اِتھ پٲٹھۍ مصروف زِ بہٕ چھُس تقریباً کُنہِ سۭتۍ نہٕ ملان۔
مگر پتہٕ اکھ ساتھیٕن کٲم کٲج مدد کٔر میٛانہِ۔
کُنہِ خاندانک رُکن گژھُن کھۄر چھُ واریاہ مُشکل۔
کَل بہٕ ژٕٹہٕ وُٹھ تہٕ دِتھ زِ میٛانہِ کمرس منٛز ٲس اکھ بھڑ۔
کُس چھُ تِم فرائز پسند کران؟
کِتھ کِتھ وارٕ چھُ پنٛنِس خاطرٕ کینہہ کرُن سُہٕل۔
یِلہ بہٕ تہٕ میٛون برونٛہہ نَو فون کیس گٔژھ، تَلہٕ میٛون کٔرمُتھ کٲم ہٕنٛدۍ بابتھ گٔے میٛانہِ واریاہ خراب۔
میٛون چھُ گمان زِ سُہٕ آسِ تُہٕنٛدِ خٲطرٕ واریاہ راحت۔
سُہٕ عام طور چھُ اکھ واریاہ پریشان کُن تجربہ۔
مگر چھُس نہٕ یقین زِ بہٕ چھُس اکثر تِمَن ہٕنٛز گژھان۔
سُہ تہٕ سٕندس زُنہِ چھِ پنٛنِس اولادس نِش آس، تہٕ وُہن چھِ وٕنکیٚن خبر پٲوان زِ تِمن ترٛےٚ بچہٕ گژھن۔
مےٚ چھُس خیال زِ سُہ ہاں وٕن۔
تُہۍ چھِ ہمیشہ تِم ہی کرُن گژھان۔
مےٚ چھُس وٕنکیٚن تہِ پنٛنِس نوِ وینس سۭتۍ محبت۔
مےٚ گوٚو سوچان زِ سُہ سرٹیفیکیشن حٲصِل کرُن۔
مےٚ چھُس خیال زِ مےٚ جیلہِ منز اکھ یا ژٕ مہینٕے کَرن پَزِ۔
سُہ چھُ کمال، مےٚ چھُس مثبت ماحول زٕپان پسند۔
مےٚ چھُس ریٹائر گژھُن یژھان، مےٚ چھِ ۳۶ وۄنۍ۔
آ، خاص طور زِ مےٚ چھُس فلوریڈا منز روزان۔
مےٚ چھُس بہٕت خوش زِ میٚون دوستن کٔر مےٚ سۭتۍ سرپرائز پارٹی۔
ڈِزنی چھِ گژھنٕچ اکھ کمال جٲے۔
دۄہن منز یوان مےٚ امتحانٕچ خاطر نیک خواہشات۔
مےٚ چھُس نِہ سٲنِہ انتظار کٔرتھ ژٕن تِم بٲہر نِرِو۔
تُہۍ چھِ اکھ گژھان یِوُن؟
سُہ گوٚو گژھِتھ پٲٹھہِ دۄن کلاسَن منز فیل۔
آ، مےٚ چھُس ہمیشہ تِہِ پیٚٹھۍ دۄہ یاد کران۔
سُہ دۄہ گوٚو جَہِ مےٚ دِل ترٛےٚ گُنہٕ وُدھ۔
دُکانہِ منز کِنہِ قِسمُک سامان وِکِتھ؟
مےٚ چھُس پنٛنٮ۪ن دوستن سۭتۍ آلسپسس پٮ۪ٹھ صرف اکھ لٹہٕ گژھان۔
گژِتھ رات مےٚ گوٚو بہٕت ژٕل۔
یہ تقریر مےٚ پریشان کران چھےٚ
یِمن کُنہِ ہٕنٛز محنتِ ہٕنٛدِ پٕٹھ پیسہ مِلان چھِ، سُہ چھِ ہمیشہ زبردست
مےٚ پٕپن کٔر نہٕ مےٚ وۄنۍ وٕنٛدِس
آ، تِم چھِ زبردست مُشکل، مگر یَلہِ تُہۍ سَہِ وقت چھِ پٲٹھۍ خٲطرٕ، کانٛہہ تہِ نہٕ چھِ زِیادٕ مُشکل
آ، مےٚ چھُس پٲکٕکۍ یِمُک حقدار
پٲٹھۍ دۄہ مےٚ ٹیلیویژن پٮ۪ٹھ آلپائن سکیئنگ وُچھان اوس
مےٚ لگ بگ پاگل گژھان اوسُس
بہٕن بھراو دپان چھِ تُہۍ ہمیشہ ژھٲڑان تہٕ پَتہٕ صلح کران
مےٚ اوسُس پنٛنٮ۪ن ساتھیَن سان زٕور خوش
آ، تٕمۍ خٲطرٕ مےٚ چھُس ہمیشہ تِہ کَرنُک کوٗشش کران
تُہۍ پٮ۪ٹھہِ کیاہ لٲگۍو؟
آ، تِم چھِ مےٚ بہٕت مدد کران تِمن کِنٛہہ جلدی ژھانٛگنہِ، مگر تِم چھِ بس ہر وقت تَتھِس پٮ۪ٹھ
آ، سُہ اوس ۱۴ وَرۍ ہٕنٛدِ
تِم چھِ زٕور مزٕ دار
او یار، سُہ چھِ ہمیشہ مےٚ خٲطرٕ مُشکل کَران
کیا تُہۍ چھِ کینہہ وقتہٕ پٮ۪ٹھ ہای بلڈ پریشر؟
سُہ چھِ کمال، ہر اَکھ مَردس چھِ پنٛنِ زِندگی مَنٛز وۄنۍ تٔرٕہ ہٕنٛز زَنٛگِ ضرورت
تُہۍ چھِ وُنٛہہ کِس قِسمُک کٲم کران؟
مےٚ چھُس یقین نہٕ کرِتھ ژِ مےٚ وُنٛہہ پنٛنِ خٲطرٕ غلط سایزُک جوتہٕ کِرۍ
لَگان چھِ زِ تِم چھِ ہمیشہ اَکھ نٔو ورژن کٲڈان
کیا ترقی خٲطرٕ بیٚیہِ موقعہ دستیاب گژھن؟
بہٕ اصلاً چِلی ہٕنٛز چھُس، مگر کینیڈا منٛز روزان چھُس۔
مےٚ یقین نَہ یِوان کہ کینہہ کھٲڑۍ کتھ پٲٹھۍ بہترین چھِ۔
تُہۍ یہِ کُتھ کٔرٕو؟
یِہ سوچنٕچ مےٚ گژھان چھُ بٔڈ نروس۔
تُہۍ ٹریفک سۭتۍ پریشان گژھان چھِ یا ڈرایؤنگ سۭتۍ؟
مےٚ چھُس سونچان تُہۍ کَریو سُہل۔
سُہ بٔڈ شُکرگُزار ٲس تہٕ تُہۍ ہٮ۪کو دِتھ کہ سُہ یہِ کۭتھ پسند کَران ٲس۔
ہائیوے ہٕنٛز کَتھ دو بےگھر اِنسان پٲٹھۍ نَنگۍ گژھان ٲسۍ۔
مےٚ چھُس اُمید کران تُہۍ سِرف تِتھ پٲٹھۍ اوٚن زٕر یِوان، یار۔
سِرف بہٕ، پہاڑ تہٕ مےٚ خیال۔
مےٚ چھُس پنٛنِس خاندانس زنٛدٕگِ ہٕنٛز پٲٹھۍ بھروسہ کران، تہٕ بہٕ چھُس سۭتۍ گژھان سۄنٛہِ کُن۔
یہِ چھُ سچ، أس جلدی پتھ تَمس پٲٹھۍ کَریو۔
مےٚ چھُس اُمید کران تُہۍ سٲری یِہ مسلہٕ حَل کٔریو۔
سٲری چھِ پنٛنٮ۪ن فونن منٛز نَزَر دِوان۔
پانٛژھ ؤرۍ گژھِتھ چھُس سُہ نفر نَہ نٮ۪ران۔
بہٕ چھُس آی ٹی منٛز کٲم کران، تُہۍ کِیاہ کران چھِ؟
تِلہِ سُہِ کُن سرجری کِنہِ خٲطرٕ چھِ لازمی؟
سِرف تِہ ہفتہٕ چھِ باقی۔
بہٕ ویک اینڈس پٮ۪ٹھ سفرس گٔیِس، یَتھ أس اکھ سُہٕنِس ہوٹلَس منٛز رۄزمُت یُس بالکنی سۭتۍ ٲس تہٕ یِتھ منز پول ہٕنٛز نَزَر ٲس۔
یہ چھِ سۄ بہٕ بدترین، مےٚ چھِ کُنہِ پادری ہٕنٛد کردار ادا کرُن پسند۔
تُہۍ چھِ آمچِ گۄژرٕ قدرتی طریٖقہٕ سان پٲٹھ کران۔
اُف، یہِ چھِ مےٚ سۭتۍ پٲٹھۍ گۄڈٕ تہِ کُنہِ بیٚیہِ ژھۄنٛگ سۭتۍ گوٚو۔
بیٚیہِ مُلک چھِ سُہٕے عجیب۔
آ، مےٚ چھِ لگن پانٛٹھۍ پَچھتاوٕ سۭتۍ بہٕتر محفوظ روزُن۔
مےٚ ٲس سُکھہٕ سۭتۍ پٲٹھۍ بھرٕمت۔
مےٚ کینہہ گیم پائریٹ کٔرمٕتھ، یِم مےٚ سُہٕے مزٕ لَگان، مگر ڈٮ۪وٕلپرن ہٕنٛز مدد نہٕ کٔرمٕتھ مےٚ چھِ قصوروار ژٕٹان۔
مےٚ سۄ گۄڈٕ وۄنۍ عجیب لٮ۪گ، تہٕ مےٚ چھِ شک، مگر سۄ ٲس دلچسپ۔
مےٚ چھُس کلاسہٕ ہٕنٛدۍ اکھ دوس سۭتۍ مٮ۪لِتھ کینٛہہ بیٚیہِ چیزٕ پٲٹھۍ کرُن۔
مےٚ چھُس سوموار اکھ گَر ژٕرِتھ۔
گۄڈٕ مےٚ گۄو مےٚ پسندیدہ اَنٛڈرپٮ۪نٛٹُن ہٕنٛد جوڑ گُم۔
کینہہ دۄہ گۄڈٕ مےٚ گۄو مےٚ آئی پیڈ گُم۔
مےٚ ژٕچھ گۄڈٕ وۄنۍ اکھ ٹیٖچِنگ ایوارڈ یِتھ کٔرمٕتھ کٲم خٲطرٕ یِم خطرٕس منز چھِ ژھۄنٛگ۔
تِمَن چھِ مےٚ ہٕنٛز رۄہٕنۍ جاے مۄلوم، تہٕ مےٚ چھِ تِم راتھ دیر گٲڑِ ہَلاوِتھ گژھان دِوان۔
مےٚ چھُس مےٚ ماجہِ سۭتۍ سُہٕے پیار کران۔
سینٹ جُوڈ ہٕنٛدۍ اِشتِہار دِژِتھ مےٚ چھِ سُہٕے دُکھ لَگان۔
مےٚ چھِ لگن تُہۍ چھِ نہٕ کران۔
مےٚ چھُس یِم پوسٹ تہٕ یِتھۍ سارٕے نۄوِ نوٚو لوٗکھ ٲسِتھ نَروٗس۔
سُہ دِژُن سُہٕے نِکو چھُ یُس سکول سۭتۍ پیار کران۔
اگر مےٚ ہٮ۪کہٕ سٲری چیزٕ دوٚبارٕ کرِتھ، تٕہ مےٚ ہٮ۪کہٕ یِہِ کرُن گژھان۔
کاہہ پتا چھُ نَہ، شاید نیندٕچ کمی چھِ وجہ۔
واہ، یِم چھِ ۲ وریٚہ کھوتہ ژٕیادٕ ییٚلہِ مےٚ اوس ۱۸ وریٚہ۔
مےٚ سۭتۍ تہِ یِہے، کیازِ کَسٕٹمر سٔروس چھِ تِژھاہ اہم یِم مصنوعات یِم اَسۍ چھِ ژٕیٚوان۔
اوہ واہ، مےٚ تۄہہِ صرف تصور کٔرِتھ ہیکان۔
مےٚ چھُ کرایہ دِتھ دۄہ دیر، تہٕ مےٚ چھِ ضرورت اَکھ ویکٕچ۔
تُہۍ چھِ کَتھ کَتھ دۄہ پنٕنۍ کمپنی سۭتۍ؟
تِمٕن وُچھ کامہِ کُن اَکھ ویک چھُٹۍ۔
اوہ، یِتھ پٲٹھۍ گژھان چھُ تِلہِ مےٚ چھُ نہٕ بالکل پسند۔
مےٚ چھُ سۄنٛچِتھ تِمِس مُتعلِق زٕبردَست پریشان۔
بۄ چھُس اَکھ سُہٕ کُک بنٛدِتھ۔
مےٚ چھُ تہِ پری-کمرشل جیری پٲٹھۍ ہی بہت گھنٛاون لگٕن۔
مےٚ چھُ ویکیشن بُک کٔرِتھ گژھان اَگلے ویک، تہٕ یِہ چھُ مزٕ دار گژھُن۔
تِلہِ یِہ چھُ نہٕ کانٛہہ بٔڑِ بات۔
سٲری پَرھٲی کٔرتھ پَتہٕ اوس مےٚ یِہ زِ بہٕ ٹیسٹ پاس کَرٕنۍ۔
مےٚ چھُ تہِ یِہِ ورٕ فینٹسی فُٹبال لیگ جیتھ تہٕ ۳۰۰ تہِ جیتھ۔
تِم اوس اَکھ کِتاب پَران پٲٹھۍ پَران یِم مےٚ اوس پَرنٕمُت، تِلہِ آو اَسۍ گَپ شُرٕع کَران۔
واہ، تِلہِ تُہۍ چھِ پَتہٕ لَگِمُت زِ تُہۍ چھِ یِہ حٲصِل کٔرِتھ، یا تُہۍ چھِ صرف پٲٹھۍ پُراعتماد؟
بہٕ اوسُس اَکھ ۹-۵ نوکری کَران یِم مےٚ اوس نَفرَت، تہٕ سُہ تہِ چھُ تِمِتھ ختم۔
آ، مےٚ اوسُس خوش زِ اَکھ دۄہ صرف آرام کٔرۍ۔
سُہٕ اوس زٕبردَست خراب، تِمِس سۭتۍ اوسُس ہفتَن تام دُکھی۔
مےٚ صرف أکس ریویو دِتھ سٕکۍ
کاش راتٕچ گژھنس منز میون ساتھی کُنہِ آسہِ
مےٚ یقین نَہ یِوان زِ میٛٲن پروفیسرن یہ سٲری غلط مارک کٔر
مگر مےٚ یہ پَتہٕ کرُن چاہان زِ اگر کُنہِ گژھِتھ گٔژھ تہٕ مےٚ تیار آسُن
أکس لٹہٕ میٛٲن کارِ ہٕنٛز ژٕلۍ ہٕنٛدۍ کینہہ پٲکۍ ژھٹان اوس، مےٚ سٲنۍ یہِ بلی ہٕنٛدۍ
اگر میٛٲن دوستن مےٚ نَہ اوس نیوٗتھ تہٕ مےٚ اَز تہِ زَمیٖن ہٕنٛدِس تَہہ آسُن اوس
مےٚ پنٛنِس ژھٲسِ کُنٛجی پنُن ہمسایہِ دِوان تاکہ سُہ نَہ گژھِ گُم
مےٚ کٔرِتھ سٕکٕن، مگر تِمۍ متعلق سوچِتھ مےٚ واریاہ دُکھ گژھان
تخنیکی طور نَہ، مگر یہِ ہای سکول سپورٹس چھِ، یِمنٛہِ سٕتۍ ہَر ؤرۍ نوٚو کھیٖلٲڑی یِوان تہٕ باقی گژھان
مےٚ أکس ہاکی ٹورنامنٹَس منز ایم وی پی ایوارڈ جیتھ
مےٚ سٲنۍ آس زِ یہِ گژھِ اَکسِس برٕعکس
ہاں، تَمہِ خٲطرٕ مےٚ واریاہ شُکرگُزار آسٕن
واہ، تُہۍ چھِوٕ اَکھ شوقین شوٹر بَنُن گژھان
میون شٲہر تہٕ مےٚ چھِ کینہہ وُہرس سٕتۍ گَر ژھانڈان
مےٚ تہِ یِم پسند زِ مےٚ یِتھ گژھِ مدد کرُن یَلہِ مےٚ سٕکٕن
مگر تِم چھِ میٛٲنِس ژیادٕ کمٲوان، اگرچہ مےٚ چھِ وُہرتھ ژیادٕ اہلیت
آج میٛٲنۍ ژور ہٕنٛز ڈینٹسٹ اپواینٹمنٹ گٔی واریاہ سُہل
سُہ گریجویٹ کیاز نَہ گٔی
مےٚ ژارٕ دِیٖکھ، مگر مےٚ نَہ پٮ۪وان یِلہِ تِم کُنہِ سُہ شو کَنٛسل کَران
مےٚ آس چھِ زِ سٲری کینہہ سُہ گژھِ
مےٚ یہِ کامس منز واریاہ نَہ آسٕہ
مےٚ چھُس تٔمِس أکس ویز ملاقات کران
کیا سا چھِ ہمیشہ اَتھِ پٲٹھۍ پیٖٹھ میٖٹھی
مےٚ سونٛچان اوس کہ ییلہِ میون پہلُک ہاتھس منز آیہِ، مےٚ کتھ ڈر لٔگمُت اوس
کیازِ کہ اپاینٹمنٹ کٔر آیہِ کینٛسل
کیا چھِ تُہۍ تَمہِ سۭتۍ بَد دِل
أکِس شخصہٕ کرِ کوشش کہ سُہ دکانہِ منز کَرِ دٲخل یُس مےٚ اوس کام کران، چوری کرنہٕ خٲطرٕ
سُہ گژھِ اگلے مہینے پنٛنِس چھُٹیہِ پیٹھ أسۍ سۭتۍ ملاقات کرنہٕ
تِہ ویکیوم چھِ کمال تہٕ چھِ اکھ قِسمُک
أسۍ پنٛنِس پہلِس کروزُک پلان بناوان اوس
کیا یہِ چھِ واریاہ بوٚڑ پروجیکٹ
مےٚ تہٕ ٹِنڈر پؠٹھۍ میٖلِتھ یہِ کُنٛہۍ گژھان اوسِس واریاہ ٹھیک
نامالوم وجوہاتن سۭتۍ مےٚ نَہ اوس دعوت دِوان، مگر مےٚ چھُس تمنز آسُن یژھان
کیا سُہ اوس تٔمِس سۭتۍ تَمہِ خٲطرٕ ناراض
مےٚ چھِ ضرورت نوِس دوستن تہٕ خاندانُک
منٛز پَزِ کَتھ، سُہ چھُ ژٕٹ سیکھان
میٲنۍ بیٹیہِ مقابلہٕ منٛز ڈانس کٔرِتھ میڈل جیت
مگر مےٚ چھُس پَزِ کَتھ کچِو نَہ کھاون
یہِ اوس اکھ سُہ فیصلہ
مےٚ ہٲوان کہ تٔمِس چھُ ناراض گژھنُک وجہ
یَلہِ مٲج مر ژٲیہِ، بہٕ تھوڑا ژٲیہِ قابو کھوومُت۔
مےٚ سۭتۍ تہِ کَنہِ کَنہِ یِم ؤن، یِمن سۭتۍ بہٕ سمجاہ ہٲو۔
مےٚ کٲمَس منز تہِ چھِ واریاہ زبردست ساتھی یِمن پٲٹھۍ بہٕ بھروسہ کٔرِتھ ہٲو۔
کیا تُہۍ گَرِ پٲٹھۍ کٕرِتھ کھٲنہٕ ژٕٙ؟
زِندگی آسُن، ژِندٕ رہن، تہٕ اَکھ گَر آسُن۔
کیا یِمن سۭتۍ تُہۍ طاقت حٲصِل کٔر؟
یِمن سۭتۍ مےٚ یاد آیہِ یِم وقت یَلہِ مےٚ کٕنِہِ بچہٕ اَسِ تِتھ لۄکُٹ۔
مےٚ چھِ نیو یارک سٹایِل پیزا پسند۔
آ تۄہہِ پَتہٕ وٕچھِتھ تَتھ پٲٹھۍ ہَنسِتھ ہٲوِو، یا ابھی نِہ گٔیہِ کٲفی وقت؟
یِمن گرمیَن منز أسۍ دۄنٛۍ پنٕنۍ پنٕنۍ جاین ہؠتھ گٔژھ۔
گۄڈٕ پولیِس مےٚ برٛونٛہِ ڈونٛڈان اوس۔
اَکھ پارٹی منز اَکھ کُرۍ نٕہ مےٚ بوسہٕ دِیُن کوشش کٔر۔
یِمن سۭتۍ حالَت گژھان چھِ تھوڑا آسان۔
تَتھ مُعاملَس منز بہٕ چھُس تُہٕنٛزِ سۭتۍ متفق۔
کیا تُہۍ گٔژھنس خٲطرٕ کانٛہہ مددگار گروپ ژٕٙ؟
اوہ، بہٕ چھُس تُہٕنٛزِ سۭتۍ پوری طرح متفق۔
مےٚ چالیس ڈَبہٕ کَم قٲمتَس پٲٹھۍ وِکِتھ نۄقصان کٔر۔
خیر، یِہ تُہٕنٛدِ خٲطرٕ اَکھ بلکل نَو تجربہٕ گژھِ۔
سڑکَن پؠٹھۍ کَنہِ لوکھ چھِ بس بَدتمیز۔
مےٚ بالکنی پؠٹھۍ گژھن نَہ پسند، یِہ چھِ اَکھ بۄنہٕ وجہ۔
یہ چھُ سُہ کمال! تُہۍ کَتھ آسِو یی ژٔ دِتھ؟
مےٚ آیہِ نیٹفِلِکس پؠٹھٕ اکھ سِریز دِتھ ختم کٔر، تہٕ وۄنۍ مےٚ ڈر لگِتھ چھُ زٕ اکیلٕ اندھیرس منز باہر گژھُن۔
مےٚ آیہِ کینیڈا ہٕنٛز سفرٕ پٮ۪ٹھ واپس، تہٕ مےٚ سۄنٛچنہٕ ہٕنٛد حیران گژھِتھ زِ تَتھ ہٕنٛدۍ سٲری کِتھ پٲٹھۍ دوستانہٕ آسَن۔
سُہ چھُ لگُن زِ سُہ آسِہ اکھ مزٕ وقت۔
آ، سُہ اوس سُہ کتُرٕ یُس مےٚ سٕتۍ سٲرس منز زیادٕ وقت اوس۔
لگُن چھُ زِ یتھ چیٹس منز ژۄن چھِ۔
یَلہِ مےٚ ٹایگر وُڈس گالف کھیلان دِتھ، تٔلہِ تِمِچ کھیڈٕن ہٕنٛز سٹایل مےٚ سۄنٛچنہٕ پؠٹھٕ زٕبردست اثر پٮ۪ٹھ۔
مےٚ سچۍ منٛز سۄنٛچ زِ سُہ اوس سۄے۔
سُہ چھُ لگُن زِ تُہۍ چھِ ضرور سُہ نوکری میلان۔
کَنِہہ لوکھ چھِ سٲری کینٛہہ مِلان۔
مےٚ چھُ یقین زِ سُہ آسِہ زبردست۔
مےٚ چھُ پسند یِم زِ ژٔ مےٚ کم توقع آسِہ، تٔلہِ ژٔ مےٚ زنٛدگی ہٕنٛدۍ چیٹ کوڈ مِلان۔
یَلہِ مےٚ میٹرنِٹی لیو پؠٹھٕ گژھُن اوس، تٔلہِ مےٚ سٕتۍ کٲم کرن وٲلؠن مےٚ خٲطرٕ بیبی شاور کٔر۔
کیا سُہ چھُ اکھ طاقتور عہدس پؠٹھ؟
مےٚ چھُ بلکل ٹھیٖک کٔران۔
سۄ چھِ تَمس پیسہٕ نرسلِتھ یِم تَمس سچۍ منٛز ضرورت چھِ۔
مےٚ ژھۄر کٔر رووم۔
آ، کانٛہہ سامٲن تہٕ تھوڑٕ زیادٕ کٲم چھُ، مگر سُہ چھُ پورٕ پٲٹھۍ لایق۔
مےٚ پنٛنٕن ہمسایہِ ہٕنٛدۍ میل بۄکسس سٕتۍ ٹکر دِتھ تہٕ کٔنہہ نَہ ووٚن۔
ہای، سُہ چھُ کینہہ پاگل پٲٹھۍ۔
مےٚ آرام مِلہٕنۍ خٲطرٕ ہؠکٕن یوگا کٔرٕن شُروع۔
یہِ لگ بھگ اکھ ؤرۍ پرٛٲنۍ چھِ۔
یَلہٕ مےٚ لۄکٕٹ آس، تَمہِ وِزِ تہِ مےٚ ژۄنٛگن نَفرَت آس۔
تُہۍ چھِو کُنِہِ پلان کَران زِ تِمَن سۭتۍ کیٛاہ کٔرِو؟
مےٚ خوش چھُس زِ میون بوے فرینڈ تہٕ بہٕ پرٛٲرۍ مِلان۔
بس مےٚ چھُس پنٛنٮ۪ن سٲری دوستن سۭتۍ مستی کَران۔
تُہۍ چھِو اکھ نیک دوست یژھان۔
کینٛہہ دۄہ پؠٹھ مےٚ غلتی سۭتۍ پنٛنہِ ڈیٹ پؠٹھ کافی ڈٲل۔
سمُندرَچ منز بۄنٛٹھ رہٕنۍ ہِنٛد خیال چھُ مےٚ نروس کَران۔
تُہۍ گژھِو اکھ لیگَس منز شامل تہٕ گژھِو تِمن دوستن سۭتۍ مِلن یِمن ہٕنز دلچسپی تُہۍ سۭتۍ ملان چھِ۔
مےٚ چھُس پٲک یقین زِ تِمِچ ذٲقہٕ زبردست آسہِ۔
میون تہِ چھُ اکھ بُتھ فوجَس منز تہٕ مےٚ چھُ وَریٛاہ خۄشی یَلہِ سُہ مےٚ سۭتۍ مِلن یِوان۔
اگر مےٚ تہِ ژور آسٕہِ تِمِچ کِنہِ، مےٚ آسٕہِ زبردست غُصہٕ۔
سُہ چھُس مخلص یژھان، تِمِچ مدد قبول کٔرِتھ مےٚ آس آسانی۔
حقیقتَس منز، گٔے ؤرۍ مےٚ کۄتُہ کُٹمٕچۍ رۄٹھۍ کۄرۍ گم کٔرمٕتۍ، تِمِچ وجہہٕ مےٚ چھُس سمجھن۔
تِمِس وۄنٛدٕر برٛٲدرٕن دِتمِس پنٛنٮ۪ن آئس کریم۔
آخرٕ گژھِ یہِ ٹانگہٕ ہؠک اگلے ہفتس منز کَڈُن۔
آ، زیادٕ پیسہٕ آسُن چھُ ہمیشہ جشن کَرٕنۍ ہٕنٛز وجہہٕ۔
تُہۍ تِمَن پؠٹھ آسِو زیادٕ ناراض یا پنٛنٮ۪ن جیون ساتھی پؠٹھ؟
آ، تہٕ مےٚ پَزِ دو ہفتہٕ وۄتھ کٔرِتھ نَتیجن ہٕنٛز، یہِ واریاہ نروس کُن آس۔
بہتَن یِتھ پٲٹھۍ سٕنٛز، مگر سُہ حقیقتس پنٕنۍ وعدہ پورٕ کٔر۔
یہِ تھوڑا شَکِس پیٹھ چھِ سُنان۔
مگر واہ، سُہ کِتھ پٲٹھۍ گَندی آس؟
بہٕ تہِ اَسہِ علاقس منز روزان یَتھ ہریکین یِوان چھِ۔
کاش سُہ گژھِتھ آس۔
بہٕ نہٕ آس سٕنٛز کہ یِہ اتھ کم عُمرس منز، صرف ۳ وری یِہ گژھِ۔
سُہ اَسہِ سٕتۍ روزان چھِ۔
یِسُس یِہِ دۄہ گَرٕ یِتھ اَسہِ سٲری بچٲون۔
ٹھیک، شاید یِہ سُہِ سبق دِژھِ تہٕ سُہ جیلہِ نِش نَو انسان بنِتھ برٛونٛٹھ یِ۔
بہٕ وۄنۍ لیجنڈ ڈمپستر منز چھُس، نَو ڈیک آزماوان چھُس۔
مےٚنۍ کٲمُک ٹیم چھِ سٲری کھۄتہٕ بٕہتر۔
مےٚنۍ لٔڑ چھِ ۳ وری، یِمۍ سۭتۍ چھُس اُمید کران زِ بہٕ تِہِ یِتھ پٲٹھۍ پروگرامس منز داخل کٔرِتھ ہٲو۔
اُمید چھِ زِ تُہٕنٛد کار تہِ ٹھیک گٔی آسہِ۔
