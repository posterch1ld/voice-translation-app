اوہ واہ، مےٚ چھُس گَرٕج وٲلۍ طوفانَن ہٕنٛز بٔڈٕ شوق۔
تِم چھِ بٔڈٕ مَصرٗوف، مگر اگر سُہ تُہۍ سۭتۍ وقت طے کٔرِتھ چھِ، تَلہِ سُہ سوموار دۄہ تَتھ آسُن گژھِ۔
تُہۍ نَہ گژھِو، یہِ چھُ فَقَط اَکھ مَوادٕچ شے یُس کُنہِ قٲیم مطلب نَہ چھُ۔
مےٚ چھُس بٔڈٕ خوش زِ گرمی چھِ تقریباً ختم گٔمٕتۍ تہٕ خزاں چھِ نَزدیٖک۔
یَتھ مےٚ بینکَس منز کٲم کَران اوس، اَکھ اَدمی بندوق سۭتۍ اَسہِ لُٹِتھ آو۔
اصل منز، یہِ اوس مےٚ ہٕنٛز ہمسایِچ پیشکش۔
تِمَن فائنلَس منز سویڈن ہَراو۔
مستقبل ہیکِتھ بٔڈٕ ڈراونٛگ گژھِ؛ نامعلوم چیز چھِ مےٚ ڈراوان۔
یَلہِ مےٚ اوس لُکھر، اَکھ لَٹ مےٚ گوٚو تقریباً ڈُبِتھ۔
مےٚ چھُس واریاہ اُمید زِ یِم کٲم خٲطر مےٚ دِتھ چھُ درخواست، سُہ کٲم مےٚ ژٲرِ۔
مےٚ چھُس شکاگو کُن، اسہِ خٲطرٕ یَلہِ کَبسَن جیتھ ورلڈ سیریز، مےٚ سُہٕے احساس گژھ۔
مےٚ اوس میکڈونلڈس منز تہٕ مےٚ دِتھ اَکھ سَڑِتھ چیز برگر۔
یہ ژٕ کتھ پریشان کُن تہ بے خیال چھُ۔
مےٚ برٛیڈ پِٹ سٕتۍ حسد چھُ۔
مےٚ پنٕنۍ برونٛہہ ہٕنز ‘پرپل رین’ کٲپی چرٛٲی۔
مےٚ چھُ نہ روٗز جانور دٔکھ سَہنس یِوان دِژھتھ۔
مےٚ ٲسۍ اَکھ سٹیم کلینر تِیاَر کٔر تہِ کَل کٔر اِستعمال پٲٹھۍ۔
کینہہ لوٗکھ چھِ نہ کانٛہہ کینٛہہ سَمجھان، تہِ باقی چھِ نہ تِمن مُتعلق گَپھ کرُن چاہان۔
مےٚ چھُ اُمید زِ تٔہۍ ہٕنٛدِس کَتھ کرنٕچ خٲطرٕ کُنہِ آسہِ۔
آ، مےٚ چھُ یقین زِ تَمہِ چھُ۔
مےٚ ہٕنٛدۍ بوائے فرینڈ چھُ اَکھ گژھُن چاہان۔
سُہ چھُ وُنیو گومُت تہ مےٚ چھُ اَز تہِ تَمہِ یاد یِوان۔
یِمن تام چھُ گژھِتھ زِ سُہ جاین تٔہۍ ہٕنٛدۍ آسہِ۔
حالٕے مےٚ کٔر اَکھ میٹنگ لیڈ، یُس منز مےٚ سٕندس وُچھ سُہ سُہل؛ مےٚ سٕندس وُچھ زِ سٲریَن سَمجھ کٔر مےٚ کٮ۪نہہ وُستمُت۔
اوہ، سُہ چھُ خراب۔ مےٚ چھُ پتہٕ سُہ کِتھ پٲٹھۍ لَگہان؛ تِمے خٲطرٕ مےٚ کٔر اَکھ اضافی آنلائن کٲم۔
تُہۍ گژھان گژھان ژھانٛگ چھِ بے چین آسِتھ۔
کیا تٔہۍ ہٕنٛدۍ چھِ بچہٕ؟ مےٚ چھِ، تہِ مےٚ ہٕنٛز نَنۍ کٔنِہ گٔیو ہفتہٕ سپیلنگ ٹیسٹَس منز ایف یِلہٕ۔
اَز چھُ مےٚ بلآخر سکولٕچ خریٖداری کرنٕچ گٔژھُن۔
آز چھُ مےٚ ہٕنٛزِ گَرِ آسٕنٕچ وٲلۍ کُنہِ سٕتۍ وقت گَژھاون۔
مےٚ کَل راتھ کینہہ گنٛٹہٕ گَرِ بٔسِتھ نیٹفلِکس دِژھ۔
مےٚ اَکھ نَو راؤٹر کٔر خریٖد، مگر سُہ آسِتھٕے خراب اوس۔
مےٚ چھُ سُہ واریاہ پسند تہ مےٚ چھُ روز سُہ گژھان۔
کیا تِم تُہندِ خٲطرٕ یہِ سَمبھالِتھ ہٲو تہٕ چارج تہٕ اکاونٹ مُعَطّل کٔرِتھ ہٲو؟
شاید کُنہِ دوستَس پٲٹھۍ مدد طلب کٔرِو تُہۍ پنُن خیال تھاوٕنۍ۔
اوہ، تِمۍ پَتہٕ شاید تُہنٛدِس پٲٹھی گَژھِتھ آسہِ۔
آ، مگر بہٕ نہٕ وٕنہٕ گوٚژھان۔
مےٚ چھِ لگٕنۍ تُہۍ چھِو اکھ سُہ دوست۔
مےٚ چھِ اُمید سُہ چھِ وۄنۍ تہِ ٹھیٖک۔
مےٚ چھِ لگٕنۍ مےٚ ہٕنٛدِس کُتُرس آو آخر سمجھ کہ سُہ چھِ بٲہر گژھِتھ حاجت کٔرُن۔
مےٚ چھِ مٕعلوٗم یِم ژٕ تِم دٕخل کٔر، تعداد آس ژوٚج۔
بہٕ گژھ مٕتھ اکھ کار بناون وٲلِس کمپنی، تُہۍ چھِو ۲۰۱۹ ہُن ماڈل دِژھُن ضروٗری۔
مےٚ چھِ خۄش پنٛنِس پٲٹھۍ کہ بہٕ اوسُس یہِ گَرمی پنٛنِس کٲمُک مقصد پٲٹھۍ قٲیم۔
خوش قسمتی سۭتۍ بہٕ کٔرِتھ ہٲو، مگر یہِ چھِ کینہہ مایوس کُن۔
مےٚ چھِ محسوس گژھان زٕ بہٕ چھُس کَتھ خوش نصیب یِم سۭتۍ چھِ مےٚ ہٕنٛدِ والِدین۔
کِتھٕ تہِ آسہِ، یہِ چھِ وۄنۍ تہِ دردناک۔
سُہ ہَفتُک بہترین وَختن منٛز اکھ گژھِتھ ہٲو۔
یِم چھِ واریاہ صحت مند تہٕ تُہۍ چھِو یِم بِغٲر شَکَر تہِ حٲصِل کٔرِتھ ہٲو۔
اکھ بَچِس ہٲسہٕ چھِ ژٕنٛدگی ہٕنٛد سٲری ٹینشن دور کَران۔
تَتھ پَتہٕ اَسۍ سُرٕنٛگ کٔرُن ہٕنٛد آواز شنوٚم۔
بَتھٕ جایہٕ ژٕوٚٹ اوس، یہِ اوس واریاہ گَندٕ۔
یہِ شوٚ اوس نمبر ۱، مگر تہِ سُہ اوس نہٕ پرواہ کَران۔
آ، ڈیلیوری سروس چھِ واقٕعی واریاہ خراب گژھِتھ۔
مےٚ چھِ صرف اُمید زِ تم چھِ نَہ بَدتمیز۔
مٲرِی بیٚیِہ کَل گوٚو اَپٕن پہلِ لفظ۔
مےٚ چھُس کھٲنسُک شوقین، تِکیازِ مےٚ گوٚو جَنَتس منز آسُن۔
مےٚ نَہ اوس مطلب زِ مےٚ اَتھ بےفکری سان وٲن۔
مٲرُ کُتُہِ اوس ۱۵ ؤرۍ مےٚ سۭتۍ، تہٕ سُہ چھُ اَتھۍ مۄت۔
مےٚ چھِ شرم یوان زِ مےٚ کتھ پٔیسہ کَماوان؛ مےٚ چھُ مشکلہِ سۭتۍ گُزر بسر لایق آمدنی۔
مےٚ کَتھٕے نَہ اوس تَتھ منز دِل لَگان۔
مےٚ چھِ وٲنَن زِ بِلۍ چھِ تِہِ کَران، یِہ چھِ واریاہ عجیب۔
مےٚ چھُس گژھان اَکھ واریاہ نٔو نوکری پَگاہِ ہنٛد، تہٕ اَتھۍ چھُس مےٚ اَکھ سُہنٛدَر فلیٹ بَرداش کَران۔
مےٚ چھُس جانان زِ تۄہہِ آو ضرور خوش گژھُن۔
سُہ چھِ ۱۰ ؤرۍ مےٚ پٲٹھۍ پٲلِتھ، مےٚ چھِ پورٕ اُمید زِ سُہ بچِ۔
ہاں، چھِ ٹھیک مےٚ چھُس خیال کران، سُہ تہِ یی سمجھان۔
مےٚ چھِ واریاہ کم اِتھٕ پٲٹھۍ دۄہ یِوان یَتھ منز مےٚ صرف گَرِ رہان۔
سُہ وقت اوس واریاہ خوش قسمت۔
فکر نَہ کَر، کِنہہ وجہ سۭتۍ مےٚ ہنٛدِس تہِ اَکھ بَگ اوس۔
مٲرِ دوستن ونٛک مےٚ ہٕنٛدِس سالگرٕہس خٲطرٕ اَکھ سرپرائز پارٹی بَناوُن۔
سُہ اوس ہمیشہ ریاستہِ باپتھ گژھُن ژۄلان، تہٕ مےٚ چھُس نَہ ہیکان۔
ماجہِ ہٕنٛز محبت چھِ بے شرط؛ سُہ کَرن تۄہہِ معاف۔
سٲری زنٛدگی خودمُختار رَہِتھ تہٕ پتہٕ ہر وقت کُنہِ ہٕنٛز دَیکھ ریکھ منز رَہُن چھِ مُشکل بدلاو۔
تۄہہِ چھِ کُنہِ دۄہ سُہ صحیح مانٛس گژھُن۔
سُہ صِرف ۸۰۰ مایِل دور چھُ، یِمن مےٚ واریاہ ژٕری اداس گژھان۔
کینہہ دۄہ پیٹھ مےٚ سٕہ کینہہ مُردٕ چُہہ لَگۍ۔
تُہندِس چھِ کٕہ اچھی ترکیب؟
عام طور مےٚ چھِ نہٕ سیب زیادٕ پسند، مگر مےٚ کٔر آزمایِش تہٕ سُہ سُہلِچ سۭتۍ واریاہ سُہند لَگِتھ۔
تُہِہ چھِ کیاہ کَران؟
مےٚ پنٛنِہ خٲطرٕ تہِ کینہہ کٔنی۔
آ، سُہ چھِ کینہہ ہفتن منز شُروع کَران والی۔
یُس وقت سُہ چھُ یِتھ، سٲری دنیا چھِ ٹھیک لَگٕنۍ۔
مےٚ چھُ سمندرس پیٹھ واریاہ ڈر۔
مےٚ چھُ سُہلِچ رۄن یِوان۔
مےٚ چھِ یقین تُہۍ چھِ واریاہ تباہ گژھِتھ۔
آ، مےٚ اوسُس واریاہ غُصہٕ۔
ویٹَرٕن کٔر مےٚ خبر زِ مےٚ پَنُن کُتھ سُلٲون پَون۔
یِمن لوٗگ نہٕ سۭتۍ راضی گژھِتھ نِہ، تِمن ہُند روٗپ چھُ واریاہ خراب۔
جُدا رۄزُن چھُ مُشکِل، مگر تِمن ہٕنٛز دۄبارٕ ملاقات چھِ تِتھ پٲٹھۍ واریاہ دلچسپ۔
مگر فورد سیڈَنن ہٕنٛدۍ پٲٹھۍ سُہند نِہ۔
عُمر چھِ نہٕ مسلہٕ، تِمِس دِکھٲو زِ تُہۍ چھِ تیار۔
دۄیم پٲٹھۍ تُہۍ کَریو واریاہ بہتَر۔
ٹیلیوژن پٮ۪ٹھ سُہ دِژھُن اوسُس واریاہ خوفناک۔
کیا کٲنٛسِہِ دِژھ زِ سُہ کِتھ پٲٹھۍ گژھان؟
مےٚ پنٛنؠ کار سروس کرٛاونہٕ نٕے، مگر آخرس منز یِہِ مےٚ بجٹہٕ ہنٛد دوٚگُنہٕ خرچ گٔے۔
تٔمۍ کِس مضمونس منز میجر کٔر؟
تھوڑِس وٲری الگ رٲونہٕ پتہٕ مےٚ حالیہ منز پنٛنؠ بیٚیِہِ سٕتۍ وۄنۍ پھِر اِک جٲے گٔے۔
غُصہٕ نہٕ کَرٕنۍ خٲطرٕ اَکھ مَردَس محنتی آسُن ضٔروٗری چھُ۔
مےٚ سچِس منز دۄن تِہِ مٔہنَن روزگار نِش رٲوان۔
کام شُروع کَرنہٕ برٛونٛہہ پنٛنہِ وقتُک لطف لیو۔
مےٚ اَز کِنہِ حالَتِس منز چھُس، تُہۍ وُچھِو تَو تٕہۍ یقین نَہ کَریو۔
بہت سارٕ لوٗکھ پٕہلِے یِتھ پٲٹھۍ ڈراپ آؤٹ گٔے۔
مےٚ پنٛنہِ کٲمَس منز پنٛنہِ سہٕ ماہی بونس مِلِتھ۔
مےٚ کینٛہہ صحتہِ ہنٛد مسلہٕ چھِ۔
مےٚ کَہنٕہ پَتہٕ نَہ اوس زِ تِم یِہِ کَرٕنۍ ہِنٛد منصوبہٕ بَناوان۔
وۄنۍ مےٚ پنٛنٕن کٕلاسَن ہُنٛد فیس نقد دِوان چھُس، مگر اَکھ وارِس منز صِرف اَکھ چھُس ژَلان۔
یِہ سُتھ مےٚ خۄشی گٔے زِ تُہۍ کانٛہہ سُہ لَبھمتھ۔
تِم مےٚ کاؤنٹی جیلہٕ نِش ژٕٹے نِکلس خٲطرٕ پلی بارگین قبوٗل کٔر۔
مےٚ اوسُس لٔکٕر، تِم خٲطرٕ مےٚ سٕتۍ مِلِتھ رٲومُت کانٛہہ نَہ اوس، یِمَن سٕتۍ مےٚ رٲبطہٕ بَنٛدِتھ ہیکہٕ؛ تِم خٲطرٕ مےٚ زندگی بٔن اکیلی۔
تِم کیا یِہِ اکثر گَژھان؟
یِم گَژھان ییلہِ خاندان مُلکُک مُختٔلِف حِصَن نِش اِک جٲے یِوان۔
مےٚ پنٛنؠ سٕتۍ بٔڈ بٔڈ چِڑمِژ چھُس۔
پھِر کَتھ نَہ—سُہ سامان بٔڈ غٲر صاف تہٕ گِنٛدٕر اوس۔
تٔمۍ اَکھ اَور دۄستُک گَر گٔے، مگر مےٚ نَہ وُن زِ تٔمۍ کُتھ کُن گژھُن اوس۔
ژٕ نہ ٹُٹ تہِ سہی، مگر ضرور أسۍ زٕبرٕدست درد گژھِتھ۔
مے چھِ خبر، تِم ہٕنٛز گٲوُن چھِ مُشکل۔
آج کامس منز بونس مِلنُک اِک موقع اوس، تہٕ مےٚ اوس سُہ زٕبرٕدست گژھان۔
مےٚ چھِ بہترین دوست۔
پٲٹھۍ رٔہنُک کوشش کٔر تہٕ پنُن بہترین کٔر۔
مےٚ چھُس زٕبرٕدست وقت پیٹھ نہٕ گژھان، جوشس منز چھُس گول گول رَوان۔
مےٚ چھُس اُمید کران زِ تُہۍ دۄنَو خۄش رٔہِو۔
مےٚ چھُس صرف فلوریڈا گژھان ڈزنی ورلڈس منز گژھنہٕ خٲطرٕ۔
واہ، سُہ سُنتھ مےٚ اوس زٕبرٕدست افسوس۔
تُہۍ چھِو جانان زِ یہِ کِتھ پٲٹھۍ شروع گژھ؟
سُہ چھُ کمال! ٹیم چھِ کُن لیولس پیٹھ؟
تُہۍ گژھِتھ صبر کَرن۔
مےٚ اوس زٕبرٕدست گژھان ییلہٕ اکھ خراب طوفان گژھِتھ مےٚ ہنز مکان نزدیٖک۔
گژھِتھ مانٛہس مےٚ ہٕنٛزِ نیک دوستُک جنم دِنُک پارٹی چھُٹ گژھ، کیازِ مےٚ اوس زٕبرٕدست مصروف تہٕ بھٕل گٔژھ۔
تِم کیٛازِ چھِ اَتھ زٕبرٕدست؟
ہا ہا، یہِ چھُ پٲٹھۍ اُوٚز یِمَنٛز تِمِس منز ٹاؤن، ہے نا؟
مےٚ چھُس اَتھ اَسِی کنڈینسر صاف کران تہٕ سُہ اوس زٕبرٕدست گندٕ۔
اَسۍ ہٕنٛز پٲلِتھ جانور چھِ صرف جانور نہٕ۔
مےٚ نَہٕ ہٲو دۄپہرُک کھٲنٛہٕ ختم کرِتھ۔
سۄنٛہِ کُنہِ نہٕ کُنہِ چھُ یِمِس پَتھ نظر تھاوُن۔
مےٚ اُمید چھِ تُہۍ کانٛہہ ژٕیادٕ پریشان نہٕ آسۍ۔
تُہۍ کَتھ گٔو شِفٹ؟
مےٚ اکھ نوٚ کار جیتھ۔
یِم پروگرامس مےٚ گژھان، تَمس مُتعلِق چھُس مےٚ واریاہ خوش۔
مےٚ کھادٕ اولِو گارڈَنَس منز کینہہ وقت گژھِتھ۔
تِہ چھا فینڈر بینڈر آسُن یا پٲٹھ ٹکر؟
آ، تِہ تہٕ مےٚ چھُ اکھ رشتہٕ یُس کَتھٕ نہٕ ٹوٗٹِ۔
یہِ چھُ سُہ۔ پہل ہفتہٕ چھُ ہمیشہ سۄ سخت، مگر وقت گژھان گژھان چھُ یہِ آسان تہٕ مزاحیہ بنان۔
مےٚ سچِ پولس منز گژھِتھ مزٕ دار وقت یٚتھ یاد کرِ۔
تُہۍ کِتھ پٲٹھ وقت لَگ ذِ تُہند گھر صاف کرنس؟
یہِ چھُ زبردست، مےٚ اُمید چھِ تُہۍ یہِ حٲصِل کرِو۔
مےٚ چھُس پنُن کتُر گژھاونٕچ کوٗشش کران، مگر تِہ چھِ ہر وقت پارٹی کران۔
مےٚ چھُس یقین کران زِ تُہۍ یہِ حٲصِل کرِو۔
او یار، یہِ چھُ سُنتھِ واریاہ خراب لَگن۔
تُہۍ چھا کٔر یہِ کَتھٕ زبردست؟
تِہٕنِس طرفہٕ چھُ یہِ واریاہ سُہ۔
کینہہ وقت گژھِتھ، دوستس سۭتۍ کھٲنہٕ کھاسان، سچِ کینہہ زبردست گژھ۔
تِہٕنِس نہٕ کَتھٕ پیٚٹھ پیسہٕ دتھ تہٕ نہٕ یہِ ٹھیک کٔر۔
اَز مےٚ کٔر اکھ بوٗز دریافت۔
آ، مےٚ لَگہٕ چھِ تُہۍ شاید صٲب چھِو۔
مےٚ چھُ یقین زِ تُہۍ پریشان آسو۔
یِمِس چھِ واریاہ فائیدٕ۔
ہر اکھس چھِ پنٛنِ طاقت تہٕ کمزوری۔
اَز چھُس مےٚ تہٕ مےٚ گرل فرینڈ الگ گژھمٕتۍ۔
تہٕ پَزِ سُہ فلم واریاہ ڈراوُن آسُن۔
مےٚ سۭتۍ تہِ چھِ یِہِ گژھان۔
مےٚ چھُس کَتھ تہِ سُکونَس منز کانٛہہ نہٕ کٔرِتھ۔
مےٚ تہٕ مےٚ بیٚوٗہ چھِو ۱۰ ؤرۍ سۭتۍ اِکتھ۔
ہیکھ ویز ہای سکولس منز تازٕ برف پَتھ تہٕ مےٚ اوس خیال تھاوان زِ مےٚ نہٕ گژھِ پھسلن۔
تُہۍ پَزِ تِمِس یاد کٔرمٕتۍ۔
ژھۄنٛٹ—ژھۄنٛٹَن ہٕنٛز کُنۍ۔
گژھِ ہفتس منز شایَد اَسہِ آخرکار وَقتس پیٚٹھ گَرِ پٲٹھ۔
عام طور چھُ جاب مارکیٹس منز گژھُن مُشکل۔
ساین کرنہٕ برونٛہہ نیٹھی دِیٚکھ۔
خوش قسمتی چھِ زِ تِمَن ہٕنٛدۍ واریاہ اِختیٲر چھِ۔
کم از کم آخرس منز سٲری کینٛہہ ٹھیک گژھ۔
مےٚ چھُس کوشش کران زِ مےٚ مثبت رٲوُن۔
یِم چھُ وۄنۍ تہِ، سُہ چھُ اَکھ زبردست کھٲڑِ۔
آ، اَز چھُ مےٚ کٲم۔
اچھا، کم از کم تُہۍ ژِندٕ رٲوتھ تہٕ اَسہِ ہٕنٛدۍ کِسہٕ ہٕنٛز کَتھ کٔرِتھ۔
مےٚ تقریباً شیل فِش سٕتھ کانٛہہ چیز کھاون وٕل، مگر کُنہِ کٔر میٚ تھٕم تہٕ مےٚ تُہۍ شُکریہ کٔر۔
کیا یہ لمبٕر مُدَت ہُنٛد رشتہٕ اوس؟
مےٚ پرسٕں ۱۰ بِگ میک کھٮ۪و۔
مےٚ یقین نَہ آوٕ کہ مےٚ چھُس یی ابھی دٕوان۔
مےٚ دیُن اوس اکھ تاریخ یی ژٕٹِھ نِیُن، مگر اَز تام چھُ نہٕ تیار۔
یِم سروس چھِ نَہ دِوان، تِمِس خٲطرٕ چھُ نَہ تُہۍ پیسہٕ دِیُن ضروٗری۔
تُہۍ کٔر اکھ نیک کام۔
شُکریہ، تَتھ کٔر مےٚ مُسکُراوُن۔
مگر جیک پاٹ لگِتھ کتھ زٕبردست آسِہ!
مےٚ چھُ طوفانن سٕتھ بہٕد نَفرت۔
مےٚ اوس اُمید زِ ژٕ بہٕتھ پیسہٕ جیتٕہ۔
مےٚ چھُس شروع کٔرنس خٲطرٕ بےچین گژھان۔
مےٚ نہٕ اوس فِکر کِنہہ قِسمُک کُتُہ مےٚ مِل۔
کیا تِمَن گٔے تُہٕنٛدۍ شارٹس تہِ؟
کیا سُہ لُکُٹ گژھِتھ گژھنس خٲطرٕ کانٛہہ قصور محسوس کٔر؟
تِم چھِ واریاہ مٲلر تہٕ وفادار۔
اوہ یار، کینہہ افسوسُک گژھِ!
مےٚ چھُس واریاہ شُکرگُزار ژٕ مےٚ اکھ صاف سُتھرٕ گھرٕ یِوان۔
اَسۍ کوزومیل گژھان چھِ۔
مٲرۍ گاڑِ ہُنٛد بیٹری چھُ ہمیشہ ڈیڈ۔
آخرس منز أسۍ سارنے مَرِو۔
مےٚ ساس ژٕلہِ دفعہ ملاقاتہِ آیہِ تہٕ برفس پٮ۪ٹھ زور سان ژٕل۔
مےٚ حٲران چھُس زِ ٹایگر وُڈس دۄبارٕ گولف کھیلان۔
مےٚ یتھ پٮ۪ٹھ آسہِ ژٕ پرٛانہٕ کُتُرٕس سۭتۍ بَہٕ محبت کَران۔
یہِ واقعی چھُ، مےٚ صرف سوشل اینگزایٹی چھِ زٕبردست، مےٚ لگٕنۍ۔
سچ ونان، یہِ چھُ مےٚ دُکھی کَران۔
تَمہِ خٲطرٕ چھُس مےٚ شُکرگُزار۔
مےٚ نہٕ کَنہِ زِ تِنہِ کِتھ کٔنۍ یہِ راز تھٲو۔
گژھِتۍ ہفتہِ آخرس مےٚ گرل فرٛینڈ مےٚ کٲٹھۍ آیہِ تہٕ مےٚ گَرِچ کَمَن منز مےٚ مدد کٔر۔
مےٚ نہٕ کِنہِ چیٖز سۭتۍ ڈیل کٔرِتھ یُس 80 فیٖصَد پٮ۪ٹھ کَم آفَر آسہِ؛ کَتھٕ کَتھٕ 50 فیٖصَد تہِ، اگر یہِ مےٚ زوردار ضروٗرت آسہِ۔
آ، یہِ چھُ زٕبردست دلچسپ لٲگِتھ۔
یہِ چھُ مسلہٕ، مےٚ نہٕ لگٕنۍ زِ یہِ مےٚ خٲطرٕ صحیح فِٹ چھُ۔
تُہۍ دۄبارٕ تتھ پٲٹھۍ گژھِو۔
سُہ بوزٕ وار ڈِپلای ژٕلو تہٕ مےٚ کانہہ دغا نہٕ دِت۔
کینہہ وقت پٮ۪ٹھ اکھ دوست مےٚ مقامی باربیکیو جایہِ متعلق ونان اوس، تَمہِ سۭتۍ مےٚ تتھ جایہِ گژھنُک فیصلہ کٔر۔
کُنہِ تہٕ نہٕ کٲنہِ پَتہٕ اوس زِ تُہۍ گَر بدلٲوان۔
اوہ، تتھ جاے چھِ سُہاوُن؟
یہِ چھُ تِمٕن ہٮ۪ن دِلی نٮ۪کۍ۔
بیٹا چھُ اَگستس منز، یِمۍ مہینس، تَمہِ خٲطرٕ شاید تتھ أسۍ گژھِو۔
سُہ پَہلِ کُن گیم کھیلان آسِ؟
واریاہ دوٗر سٕتۍ مےٚ بٔڈ سرٕ درد چھُ
مےٚ چھِ تِمن یاد، تٔتھ مےٚ چھُ تِمن بغیر واریاہ اکیلا محسوس گژھان
مےٚ کینہہ عرصہ اوسِتھ رٔلۍ یتھ گَرَس منز ژھۄنٛٹٕن ہُنٛد مسئلہ اوس، یہ چھِ مزٕ نَہ اوس
مےٚ چھُس چاہان زِ میون خاندان ترٛٛٲو مٔزٕ کٔرِ
آ، مگر مےٚ کَتہِ نَہ اوس سونٛچان زِ مےٚ پنٕنۍ نِش اِتھ پٲٹھۍ دور تھاوِ
مےٚ آو کَمہِ کُنہِ باپتھ باہر کٔڈمُت
مےٚ چھُس ڈِزنی ورلڈ تہٕ ڈِزنی لینڈ دۄنوٕن گٔمُت، مےٚ چھِ لگٕمُت زِ ڈِزنی لینڈ چھُ مےٚ زیادہ پسند
مےٚ چھِ احساس زِ یہِ چیک گٔژھِ بٔڈ
مےٚ چھِ یاد زِ مےٚ اوس کٔھنا کرٛیکر جیکس بچپنس منز
تُہۍ یہِ کِنۍ پٲٹھۍ بریک کٔر، تَتھ پٮ۪ٹھ چھُ منحصر، مگر تِمَن اوس حق غصہ کٔرُن، ظاہر چھُ
دَمہ، یُس گٔیہِ تَتھ خٲطرٕ مےٚ چھُ افسوس
مےٚ اوس سونٛچان زِ کاروبار چھُ مٔزٕ چلٕن
یار، یہِ ویک اٮ۪نٛڈ گژھِ ڈرٲونٛگ
مےٚ چھُس تہِ کینہہ مٔہینٕن گٔے پٮ۪ٹھ شامل گٔومُت، مےٚ دوست، نیک تمنٲ
چلو، کم اَز کم تُہۍ اوس تَتھ گژھان نٔظَر
سُہ اوس اَکھ آسٹریلین شیٚفرٛڈ
آج مےٚ سڑکٕس کِنارٕ کٕنہِ ہٕنٛد تھوٗق کٔرِمُت گم پٮ۪ٹھ پانٛژھ ڈٲل
اوہ، مگر یہِ چھُ اکھ راحت ہُنٛد کار
سۄلَہِ سال چھِ اکھ کمال ہُنٛد وقت کٹھٕ رہنٕچ، مےٚ چھِ امید زِ بیاکھ سۄلَہِ سال تہِ گژھِ کٹھٕ
۱۵ سال، یہِ چھُ واریاہ خراب
اکھ لنگڑ کُترس پیٹھ پَتھر پھینکِتھ بچہٕ دِژُن
کم از کم یہ صرف اکھ مہینس خٲطرٕ چھُ
ٹھیک چھُ، تُہۍ سٲرۍ واریاہ لوٗکھ چھِ نہٕ
مےٚ اَز فون آو تہٕ یِم نوکری خٲطرٕ مےٚ اَرج کٔر، سُہ مےٚ نہٕ مِلۍ
کُنہِس پیٹھ اَسہِ قسمُک بھروسہٕ اوسُن ضرور سُہل، تہٕ موٹر سائیکل چلاوُن ہِک مزٕدار گژھِتھ
یِلہِ مےٚ ہِنٛز پُتُر زاو، بہٕ واریاہ پریشان اوسُس
بہٕ ٹیکساسس منز روزان، یِتہِ نہٕ چھُ اسہِ واقعی تِمن ہٕنٛز فِکَر کٔرُن ضروٗری
آ، بہٕ تِمَن گھرِ منز پڑھاوان تہٕ مےٚ چھُ سُہ واقعی پسند
بہٕ عام طور چھُس واریاہ پُرسُکون، خوش تہٕ بے فِکَر
مےٚ لگہِ چھُ سُہ باتھ ٹھیک
مےٚ ہِنٛز بابہٕ وٕچھان چھِ کہٕ بہٕ یہِ نوکری کَرٕ، یَتھ منز مےٚ چھُ بالکل دلچسپی نہٕ
مےٚ ہِنٛز سوتیلی بٔٹی کٔر اکھ بالکل نوِ کار خرٕید
یِلہِ مےٚ وٕنۍ کٔر ہٕری رنٛگ خرٕیدنس، مگر سۄ کٔر سپید رنٛگ خرٕید، سُہ دِژِتھ مےٚ چھُ کِراوتھ
بہٕ چھُس ژٕلان مہینن ہٕنٛز سفرس پیٹھ روانہٕ گژھان
بہٕ چھُس تِمِس مدد کٔرٕنۍ کوٗشش کَران
ماج چھِ یہِ کرٕنۍ پسند، تِم چھِ پنٛنٕن بچن ہٕنٛز فِکَر کَران
مےٚ لگہِ چھُ زِ مےٚ واریاہ وقت تِمِس بچپنُک تصوٗیر دِژِتھ دِژِتھ خۄش روٗن
تھینٛکس گِوِنٛگ چھُ اصل مطلب یہِ ہٮ۪وان
آ، بہٕ نہٕ گژھٕس واریاہ دِلشِکستہٕ
گژھِم ہفتہٕ مےٚ اکھ نوِ نوکری خٲطرٕ انٹرویو دِتھ
مےٚ پنٛنِس ماج پٮ۪ٹھ بہت فخر چھُ۔
مےٚ یہِ ویک اینٛڈ اَکھ ٹورنامنٹ کھیٚل۔ مےٚ اوس اُمید جیتھ، مگر مےٚ جیت نَہ۔
