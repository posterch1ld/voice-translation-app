لگَان چھُ یِم کَلٕچُھ سُہ بٔچس آسَان۔
ہارٕورڈ تہٕ ییل سۭتۍ چھُس بہٕ گھبرٲوان۔
بہٕ سۄنٛہٕ ڈَرٕمُت، مگر آسٕ سُہ یقین زِ امریکہ پارٕ لمبی ڈرایِو کَرنٕچ ہمت چھِ مےٚ۔
واریاہ سیل چھِ یِتھ پٲٹھۍ۔
اوہ، معاف کٔرِو، مےٚ سۄچمُت زِ تُہۍ کُن چھُ اَکھ سُر۔
تٔمۍ ہُنٛد یہِ واریاہ مِہرٕبانی اوس۔
آ، سچُے اوس یہِ واریاہ کٲم۔
یونیورسٹی منز واپس گژھٕنٕچ چھِ مےٚ واریاہ ڈَر۔
تَتھ پٲٹھۍ تُہنٛد فون بَدلاونٕچ واریاہ پیسہٕ بچِتھ آسہِ۔
مےٚ ریوٕنٛس چھِ پسند تہٕ مےٚ چھِ نہٕ واریاہ اُمید۔
مےٚ دروازَس پٮ۪ٹھ چھُ اَکھ واریاہ بٔڑُ خَرٛوٗچ۔
مےٚ چھُ یقین زِ سُہ اوس واریاہ مزٕ۔
کیا چھُ تُہۍ یہِ کَتھ تُہنٛد سپرٛوایزرَس سۭتۍ کٔرِتھ؟
اوہ، یہِ چھُ سٔنگٕنہٕ منز اَکھ واریاہ گۄڈ سودا۔
مےٚ گٔے چھُس تَتھ، مےٚ دوست۔
گٔے ہفتہٕ مےٚ وُچھ اَکھ شارک آبس منز۔
بَعدس پٮ۪ٹھ سۄنٛد جان بچاونٕچ خاطر کٔر مےٚ شکریہ۔
راتھ کَیمپِنگ کَران وۄقت مےٚ وُچھ اَکھ پہاڑی شیر۔
مےٚ چھُ تھوڑا ڈَر زِ پنُن ہمسایہٕ خلاف AC کُن شکایت کَران، کیازِ مےٚ چھُ نہٕ یِژھان زِ سُہ بدلہٕ ہیو۔
مےٚ چھُ یقین زِ تُہۍ چھِ سُہ واریاہ پسند۔
تُہہِ کَتھ پَتہٕ، سُہ کِنہہ قِسمُک اِنسان ہۄکھ، شایَد کُنہہ شکاری۔
سٲری ہَسٕتھ، مےٚ بٔڈ شرمندٕگی محسوس کٔر۔
تُہہِ شایَد سیکیورٹی کیمرٕچ فوٹیج مِلِتھ ہیکیو۔
مےٚ کَریو پنٛنِس مٲلِس سۭتۍ طلاق؛ یِم ہفتہٕ سُہ چھُ بَچَن سۭتۍ گرمیٖن ہَفتَن خٲطرٕ۔
سُہ اَکھ بھرِتھ ٹیڈی بیٖر اوس۔
یِہ چھُ مےٚ دۄستُک کَمپنی منٛز اِنٛجینٔریٛنٛگُک کٲم۔
سُہ اَکھ سٲری فلم ٲس۔
مےٚ چھُ خۄش زِ اَکھ وارٕ تام مےٚ ہیکِو۔
مےٚ سٕتۍ بٲٹھِتھ چھُ اَکھ کٲم کَرُن والہٕ، سُہ چھُ سٲری دۄہ پنٛنِس قَلمہٕ سۭتۍ آواز کَران۔
مےٚ چھُ بٔڈ پریشان زِ مےٚ چھُ نہٕ لۄکُٹ بچہٕ مِلان۔
اَس چھِ روڈ ٹرِپَس پٲٹھۍ گژھان۔
مےٚ پزِ کینہہ شاپِنٛگ کَرنہٕ خٲطرٕ گژھُن۔
مےٚ ؤنٛن زِ تُہہِ گٔوٕ حظ پٲٹھۍ کُنہہ کُڑِس متاثر کَرنہٕ خٲطرٕ۔
کَتھ کَتھ پریوار تہٕ پیسہٕ شامِل آسَن، تِتھ کَتھ مُشکِل بَنِتھ ہیکِہ۔
اَتھ چھِ تُہُنٛد کِتھ پٲٹھۍ بَچہٕ؟
کیا تُہہِ کۄر ڈاک خانس فون زِ کَتھ گٔے؟
مےٚ چھُ راضی—مےٚ خٲطرٕ یِتھ شاندار جنم دۄہُک پارٹی کَرِتھ سُہ چھُ اَکھ بٔڈ سرپرائزُک حقدار۔
آنی اَکھ وارٕ مےٚ ہار۔
مےٚ چھُ پنُن کٲم بٔڈ پسند، مےٚ اوس صرف اَکھ بہتَر موقعہٕ ڈۄنڈان۔
آ، اَتھ چھِ وقت گژھِتھ۔
مےٚنٛس مٮ۪نیجر تھوڑا غصہ آمُتھ لَگِتھ
واہ، مٮ۪رٕبٲنۍ لفظن خٲطرٕ شکریہ
مےٚنٛس دوستُک کُتھ پٲرِتھ گٔیو
مےٚ چھُس یقین زِ تُہۍ ٹھیک کَروٕ
آخری دھمکین ہٕنٛدۍ کٲم گژھِ تھٲوُن
آ بہٕ یِتھ پٲٹھۍ مےٚ چھُس تِمن ہٕنٛز خیال کَران
تِمَن چھُ اَز ثابت کٔرُن زِ تِم چھِ تُہۍ سُہ گوٚڈ پیار کَران
بہٕ کَرٕس یہِ کٲم زبردست
بہٕ چھُس جُرمٕچ اِنصاف پَران
مےٚ اوس تھوڑٕ حسد مےٚنٛس پڑوسی سۭتۍ
مےٚنٛس ۳۰ وٕں جنم دۄہ چھُ جلدی
نَہ، مےٚ چھِ دۄیمِ جاے زیادہ پسند
ٹرکُک یہِ چھِ سُہ دِل پسند حِصہ
بہٕ رٔلُس مےٚنٛس پیارِ بیٚیِس سۭتۍ وفادار
یِلہٕ بہٕ مےٚنٛس کریڈٹ کارڈُک بِل دِنہٕ چُھٹ گٔیوس، بہٕ اوسُس غصہٕ
کَتھ کَتھ دُکانن مَنٛز اَکھ مثال
سُہ چھِ ڈایالسِس کلِنِک مَنٛز کٲم کَران
مےٚ کٔر بچاوُن واریاہ دَفعہٕ چھوٚڑنہٕ پٮ۪ٹھ
تہٕ بہٕ چھُس اَسہِ رِشتہٕ مَنٛز زبردست خوش، تہٕ کانٛہہ زیادٕ مَنگِتھ نَہ ہٲوَان
سُہ گژھِ ٹھیک، سُہ چھِ سُہ دِل خوش کَرُن
مےٚ شُکرگُزار آسُس زِ میٚون برٛون مےٚ مکان بدلٲونٕچ مدد کٔر۔
پٲٹھۍ السکا رٲژن ہٕند بہترین فٔرسٹ بیس مین۔
مےٚ گٔژھ جاب انٹرویو دِنٕہ، مےٚ سٲری پٲٹھۍ یقین اوس تہٕ مےٚ کِنہہ گَروٗر تہِ اوس۔
مےٚ ڈایٹ کٔرٕنۍ کوٗشش کَران، مگر یہِ کٲم نِہ کَران۔
والدین کَتھ کمال ہٕوِتھ ہٲوِتھ۔
مےٚ اَز تہِ سوچان زِ مےٚ کٔنہِ دوٗہ مےٚ بیٹی بَچٕہ اوس۔
مےٚ کَتہِ تہِ کروزس پٮ۪ٹھ نَہ گٔژھم، مگر وُچھان آسَن مےٚ سٲری کھوتہٕ بہتر دوست سٕتۍ اَگلے مٲہ کروزس پٮ۪ٹھ گژھُن۔
مےٚ ہٕنٛدے کٔر کلف ڈایونگ تہٕ مےٚ ذٲتہِ کینہہ نَہ گَبھرٲومُت۔
حقیقی زنٛدگۍ منز نَہ آسہِ اَتھ پٲٹھۍ خۄش انجام۔
مےٚ سٲنۍ چھُس زِ یِمن پٲٹھۍ سوچن وٲلۍ لوٗکھ بٔہہ چھِ۔
ہا ہا، تہٕ تُہۍ چھِو پَنٕنۍ دوستس متعلق زیادٕ فِکر مند بہ نسبت بوٹ ٹھیک کٔرنس؟
یِہ چھِ سٕہت منٛز زیادٕ بہتر لٲگان بہ نسبت یِمن چِک فِل اے یُس مےٚ اوس کھٲمت۔
مےٚ بٲہَر ننگۍ پٲٹھۍ ژٕلان اوس تہٕ اکھ کیٚنچُو پٮ۪ٹھ مےٚ ژٕٹ پٮ۪و۔
میٚ دوٚپٲٹھۍ لَگٕن چھُ زِ ہر ہفتہٕ وار مےٚ یہِ یِتھ پٲٹھۍ انتظار نَہ کٔرِتھ ہٲوان۔
مبارک دوست، مےٚ چھُس تُہۍ خٲطرٕ بٔہہ خۄش۔
آگسٹین، یُتھ مےٚ گٔژھ بچپنَس منز۔
مےٚ چھُس بے حد معذرت خواہ زِ تُہۍ چھِو یہِ سٲری ژٕلان۔
مےٚ کَتہِ تہِ تِمن پٮ۪ٹھ کینہہ نَہ جِتھ، تمن خٲطرٕ مےٚ بٔہہ خۄشی گٔے۔
مےٚ نَہ ہٲوِتھ یقین کٔرِتھ، کیازِ مےٚ کَتہِ تہِ کینہہ جِتھ نَہ۔
مےٚ چھُس بٔہہ نوسٹیلجِک گژھان یَتھ سالہِ ہٕنٛدۍ وقتُک خیال کَران۔
بہٕ واریاہ سالن پیٚٹھ یِم کمپنی منز نوکری مِلانٛچ کوٗشش کران چھُس
مےٚ گوٚو اَکھ نِیٚنٛہٕ بٮ۪لِچ زٕنٛگ گھرٕ کھیٚنٛتھ تہٕ سُہ صحت یِوان پٲٹھۍ سٕنبھالان چھُس
یِم گژھِ واریاہ وار یاد تھاوُن ٹھیٖک چھُ
تِم اَصٕل میکسِکن کھانٛہٕ دِوان چھِ
اوہ مےٚ، سُہ چھُ واریاہ لَمبَر وقت
کَتھ کَتھ عادت بدلٕنۍ چھِ مُشکل
سُہ چھُ سٲنۍ، مگر اَز چھُ واریاہ وقت باقی
مےٚ چھُس وُنی تہِ تِمۍ ہُنٛد پُرانہٕ فوٹو نِہ ہٕیکان دِتھ
آ، أسۍ گوٚو پٲٹھۍ ہٮ۪ری پاٹر ہُنٛد پہلٕ فلم دۄدِتھ
مےٚ چھُس دِلِچ آس تھاوان زِ سُہ قبول گژھِ
یہِ چھُ اَکھ میکسِکن ریسٹورنٹ
اَکھ ساڪر ٹیم ہٕنٛز کیاہ رٲے
یِم کٲم مےٚ نِہ کٔر، تِمِچ پٮ۪ٹھ دِوُن گژھِ مےٚ پیسہٕ
کیاہ سُہ کینہہ بدلِتھ گوٚو
بس اعتماد تھاو تہٕ پنٛنٕچ ذات بَنِتھ رٲو
سَچ پٲٹھۍ وٕنۍ، شاید مےٚ تہِ تَمی کٲم کٔرموٚت
رٲمَن چھُ کمال، مگر مےٚ چھُس متفق زِ شاید اَز چھُ نَو کینٛہ آزماونچ وقت
سُہ چھُ دلچسپ لٲگان، کیاہ سُہ بناون چھُ مُشکل
یار، اَز مےٚ گوٚو سُہنٛد حٲل محسوس کٔرتھ جاگٕتھ
مےٚ کَتھ ؤنٛدٕ نہٕ سُہ کلیولینڈ ترٛاوِتھ گژھان۔
یہِ چھِ اَکھ نِرم ہٕلچل۔
مےٚ چاہان ہُس زِندگی منز کانٛہہ نٔو سنٛیک۔
مےٚ دوستن پنُن لیٚپٹاپ مُکھ قرض دِتھ تہٕ مےٚ ژٕ سُہ پؠٹھ جوس سٲنٛڈ۔
روز راتھ ادٕ راتھ نِش مےٚ ہیٚچھان چھِ مےٚ گَرٕ باہر جنگلَس منز باسان خوفناک آواز۔
مےٚ راتھ دیر گژھِ کٲمَس پیٹھ نِکلسان۔
مےٚ چھِ مکڑیَن سٕتۍ سخت نفرت۔
احتیاط خٲطرٕ تُہۍ پنُن گَرٕ مزید سپرے کَریو۔
کیا تُہۍ چھِ کوٗشش کٔرمتھ تِمن سٕتۍ یہِ کٔتھ کَرنٕچ؟
مےٚ کُٹم چھُ کوٗشش کَران مےٚ کُٹمک دوستُک بچہٕ سٕتۍ رِشتہٕ جوڑنٕچ۔
کاش مےٚ پنُن بٕچھرٕ ہُنٛدُس۔
پَتہٕ یلہٕ مےٚ تِم ہٕنٛد نٕزِر گژھِ، مےٚ کَران۔
مےٚ کَنہِ چھِ کینہہ تِم لٲگِچ۔
مےٚ چھُ پٲٹھ تہٕ دۄپہرِ تٲزٕ کپ بناون شروٗع کَرُن۔
یہِ چھِ یِمنٛد ژٕ تِم کرٕن کوٗشش پروفیشنل بَننٕچ۔
کِتھ عجیب، مگر تُہۍ چھِ نصیبٕدار۔
امید چھِ سُہ تیار ٲسِ یِلہٕ گَرٕ گژھُن ہُند وقت آسِ۔
کٲمَس گژھنٕچ خٲطرٕ مےٚ پؠٹھلی دفعہٕ پنُن پُتر ترٛاوُن پَڑ تہٕ سُہ ٲس سخت۔
مےٚ ٲسُس تِم خٲطرٕ واریاہ خوش۔
یہِ ٲس اَکھ مزٕدار راز، مگر مےٚ کٔرُن ضروٗری یُس سُہ سُہ راز تھاوِتھ ہٮ۪کان۔
مےٚ چھُ ضرورت یہِ ڈایٹ آزماونٕچ۔
مےٚ چھُ اکھ نٕوٚتہٕر، یُس تھوڑا سُست پیدا گومُت۔
سُہ ژٕ آج راتھ کِڈ راک کَنسرٹ ہُند ٹکٹ دِتۍ۔
تَمہِ چھُس یِمن ضروٗر خۄش گژھان۔
ہا، سُہ ٹیوی شُو سۭتۍ کُنہِ چھُ ہمیشہ یِمۍ گژھان؟
مےٚ تہِ، مگر سُہ ہٕنٛد اَسہِ سٕریٖن کُن اَسہِ طریٖقہٕ سۭتۍ باسان ضروٗری نہٕ آس۔
بچپن یٚاد کرُن گژھِ مزٕ دار۔
مےٚ چھُس حالس منز تھوڑا پریشان، تہٕ مےٚ چھُ نہٕ پتا بلکل کُنہِ۔
یِہ چھُ بُرٕ یِہ زِ سُہ ہیٚچھِ رشتٕ ختم کٔرُن، خاص کر یِمۍ کِ تَمہِ آسِ سُہ سۭتۍ سَریٖح دِلچَسپِی۔
یِہ چھُ بُرٕ۔ کِیا تۄہہ رۄدمُت؟
ہا، مےٚ آسٕس تَمہِ سۭتۍ زٕرٕ ناراض۔
کیا چھُ اَز تام کوٗن خبر یِہ کِیا گژھِ آسُن؟
مےٚ چھُس پسند زٔمیٖنِک نٔزدیٖک ڈرایِو کرُن۔
عجیب چھُ، مےٚ تہِ۔
کیا تُہۍ یہِ اَتھ پٮ۪ٹھ کٔرِو؟
تُہٕنٛد خیال رٕکھنہٕ خٲطرٕ کُنہِ نہٕ آو۔
ہا، حالس منز چھُ زٕرٕ گرمی۔
مےٚ چھُس یَتھ وقت ٹرمپ پٮ۪ٹھ زٕرٕ ناراض۔
یِہ چھُ سُہ تہٕ تۄہہِ دۄنٛنِو خٲطرٕ زٕرٕ دردناگ۔
تِم آسِ ٹھیک، شروٗعس منز تِمن ہٕنٛز کُنہِ معلومات نہٕ آسِ۔
مےٚ چھُس سَدا خۄش گژھان ییلہِ مےٚ چھُس سونچان پُرانِو وقتن ہٕنٛز۔
یہِ مےٚ پہلۍ پسند نہٕ تِم، مگر یہِ کام پَکّہٕ کران۔
بےٚ ٹیبل پؠٹھ دعا کٔر زِ اَسہِ کھاون مِلہِ۔
بےٚ حالَے منٛز پنٛنۍ نوکری چھوٚڈ، یِہِ گٔے واریاہ سُہ۔
ہفتہٕ وار گژھِتھ جِمنٛاسٹِکس مقابلہٕس منٛز میون کٲنٛہہ پٲٹھۍ جاے دۄد۔
تِمَن خٲطرٕ یہِ واریاہ سُہ چھُ۔
تُہۍ صحیح سمتس منٛز قدم وٲلِتھ گژھان؛ مےٚ لگٕنۍ تُہۍ تَتھ پنٛنِہ خٲطرٕ ٹھیٖک کَران چھِو۔
سُہ بُڈٕر، بیمار تہٕ دٔردس منٛز اوس، یِمِ خٲطرٕ وقت اوس۔
کیا تُہۍ یہِ پوشِو؟
بےٚ یہِ ہفتہٕ وار اَکھ ژھٲپ گژھِتھ چیٖز اَنٛدر کٔرمُت۔
یہِ چھُ اَکھ نوٚو چیٖز تہٕ یہِ چھُ واریاہ ژوٚٹ کام کران۔
سُہ دۄنٕوٕں سمسٹرن منٛز آنر رولس پؠٹھ آو۔
بےٚ یہِ ہفتہٕ وار سافٹ بال ٹورنامنٹس خٲطرٕ واریاہ اُمید تھٲومُت۔
مےٚ کَدی اَکھ گوٚڈٕ سٹار وارٕس فلم نہٕ چھِ دِژمُت، صرف تھوڑٕ تھوڑٕ حصٕ چھِ دِژمُت ہاہا۔
ہفتہٕ وار ٹی وی شو دِژھان چھُس تہٕ باقی ژٕٹ کَم چھُ نہٕ کَرُن۔
شایَد کینٛہہ نہٕ، مگر تَمہِ پؠٹھ یہِ کرُن چھُ اوسٕن مُشکل۔
یہِ چھُ نہٕ سبَس سُہ۔
فلم چھِ احساس جاگاونہٕ خٲطرٕ بناونہٕ آمٕژ۔
مےٚ آس چھُ زِ تِمَن چھُ سُہ انشورنس۔
نتیجہٕ گژھِ حٲلِم سُہ آسُن۔
مےٚ لگٕنۍ شاید مےٚ کینسر چھُ۔
مےٚ چھُس وُچھان کُنہِ نَے بے گھر اِنسانَس ہٕنٛدِس کپَس مَنٛز چَبمُت گَم تھاوان۔
سُہ اوس اَتھ پٲٹھۍ بے رٲبط کہ مےٚ اوس ہَساں ہَساں مَرُن۔
تَمہِ چھِ پھر تہِ یِتھ پٲٹھۍ زیٛادٕ یُس تُہۍ شروع کٔرمتھ۔
کَنہہ کَنہہ چھِ پَزِ دور گَژھُن ضروٗری۔
کیا تُہۍ تَمس کَنِ محنت سٕتھ پٲٹھۍ؟
کُنہِ پٲٹھۍ چھُس یاد کران زِ یِم اوس نہٕ اِتھ ڈرٲون یَلہِ مےٚ اوس لۄکُٹ۔
مےٚ کَنٛہِ نزدیٖک دُکانُک شُرٛوٗک کالِ شام مےٚ خٲطرٕ راتھُک کھٲنہٕ آیہِ۔
مےٚ چھُس دوست کَنٛہِ پیٚٹھ پیسہٕ عارٕتھ نیٚوان۔
مےٚ چھِ اَز تہِ ژٕوٗن دۄن وَرۍ باقی۔
سُہٕ چھُس وُچھان یَلہِ مےٚ سُہٕ لَگۍ وٕتھِتھ، مےٚ کمرَس مَنٛز اوس اَکھ بھَڑ۔
سٲری واتھ کُنہِ اوس مےٚ پَتھ پَتھ چَلان۔
ژٕوٗنٛ کَنِ محنتُک پھَل چھُ اَز مِلان۔
مےٚ مِلِہٕ بہٕتھ سٲری زبردست تحفہٕ۔
کاش مےٚ تہِ یِہِے گژھِ ہٕکُن بۄلِتھ۔
ہاں، مےٚ ہَیکان ضروٗر، مگر قسطٕن ہٕنٛد ادایگی گٔژھِ دۄبارٕ شروع کٔرٕنۍ؛ شاید مےٚ وُچھِ تَمس۔
مےٚ گٔیہِ خوش یِہ وُچھِتھ زِ مےٚ چھِ یِتھ ہفتَس چھُٹّی۔
مےٚ چھُس پَکّ یقین زِ تُہۍ اوس سُہ وقت گُزارمتھ۔
سُہ چھُ اَکھ نٛہٕرٛ وُچھُن۔
سپورٹسُک یِہِے چھُ کمال زِ کانٛہہ تہِ ہٲوِتھ ہٲکِتھ۔
یَلہِ مےٚ چھُس تَمس نزدیٖک، چھُس مےٚ خۄد لۄکُٹ محسوس کران۔
واہ، یہِ چھُ واریاہ ڈرٕاون۔
نَہ، اصل منٛز بہٕ پنٛنِس خوابن ہنٛدِس سکولس منٛز درخواست دِتھ۔
بہٕ آسٕس لُکُر ییلہٕ کٲلس منٛز مےٚ پینٹ ژٕل، سٲری مےٚ پٮ۪ٹھ ہٲس، تہٕ بہٕ آسٕس اداس۔
تمنٛز سُہِ کیاہ کٔرمتھ؟
مےٚ چھُ نہٕ صبر یوان پنٛنِس کُٹمِس سۭتۍ پتہٕ گژھِتھ۔
تُہۍ چھُ مےٚ بالکل بےچین کٔرتھ۔
شُکرِیَہ دِنٕہِ خٲطرٕ تُہۍ گژھِو تُہۍ تِم کُنہِ گیمس؟
اُف، راتِس شفٹن منٛز کٲم کٔرتھ بہٕ چھُس واریاہ تَنگ، مگر نَو کینٛہہ شُروع کٔرنٕہِ چھُس نروس۔
گژھِتھ گژھِتھ بہٕ گٔژھِس طوفانَس منٛز، یہِ اوس واریاہ ڈرٕاون۔
آ، کم از کم چھُ تُہٕ کٕنۍ سُہِ ہمیشہ یاد تھاونٕہِ خٲطرٕ یہِ۔
گژھِتھ سانٛز بہٕ بالکل اکیلا آسٕس۔
سُہِ مےٚ گیمنگ کمپیوٹرس پٮ۪ٹھ مشروب ڈٲل۔
اتھُ پتہٕ حالات گژھِ بہتر۔
اگر نہٕ، تٔلِہِ کانگریس گژھِ کٲم کٔرِتھ یہِ روٗکُنٕہِ خٲطرٕ۔
یہِ ہیٚوٗ سٔرٕ مےٚ چھُ افسوس، اُمید چھُ سُہِ جلدی ٹھیک گژھِ۔
ٹھیک، یہِ تِمِس کُن اکھ نوٹ سۭتۍ دِیو یَتھ منٛز لِکھِو تُہۍ چھِو تِمِس یاد کٔرتھ۔
بہٕ کینٛہہ دوستن سۭتۍ باہر کھاون گٔیوس۔
سُہِ اکھ گرل فرینڈ تہٕ اکھ گۄڈ جاب لَب۔
مےٚ چھُ واریاہ شوق نرس بنٛنُک۔
تِمن ہٕنٛز گٔیِو پَتہِ ہفتس منٛز سَگٲی۔
یہِ چھُ سُہ گژھن۔
مے چھُ سچِتھ پنٛنِس بیٹی ہُند ٹین ایجر بننُک اِنتظار کران نہ۔
مے نَہ آسِہ اُمید زِ تۄہہِ مے دِلہِ نَو کار مے برتھ ڈے پٮ۪ٹھ خریٖد۔
مے چھُس خوش تہٕ مے چھُ پیٖٹھ بھرِتھ محسوس گژھان۔
مے کٔنۍ چھِ واریاہ کزن تہِ۔
تُہہِ ہٕکِو کَتھ زِ تُہٕنٛد پٲٹھۍ چھُ سُہتر محسوس گژھان؟
پین کیک تہٕ انٛڈٕ تہٕ ٹوسٹ۔
مے چھُس گمان کران زِ کَدی کَدی کینٛہہ اُمید تھاوُن چھُ نَہ کَتھ۔
سٲری نَہ کَرِ تِہ۔
مے پَتہٕ لَگ زِ مے کَرُن پٲوان پنُن چھُٹّی کینسِل۔
مے چھُس واریاہ چیزن ہٕنٛز شُکرگُزار۔
مے ٲسُس دلہن ہٕنٛز سہیلی تہٕ سُہ تقریب ٲس سونٛدَر۔
پرٛٮ۪تھ دۄہ مے ٲسُس کامس پٮ۪ٹھ اکھ بٔڑِ پریزنٹیشن خٲطرٕ تیار گژھان۔
دَت، یَلہِ کُتہٕ تِہ گَژھان چھِ، مے چھُ نَفرت گژھان۔
مے چھُس گَژھان ہٕنٛسُن زِ مے سٲری گامُک دوست چھِ سٲری دور گژھان۔
مے گژھان چھُس پَتہٕ کینہہ باربیکیو کھاون۔
مے مِلِ اکھ واریاہ سُہل ڈیل کمپیوٹر خٲطرٕ آنلائن۔
مے ٲسُس واریاہ غُصہٕ یَلہِ مے بھُل گٔیہ پنُن کریڈٹ کارڈ بل دِتھ۔
مے چھُس معاف کران، مگر شاید تِمِس کینٛہہ ذرا ذاتی مسلہٕ آو۔
خود اعتمادی تھاوُن چھُ واریاہ سُہ۔
تُہۍ کیا ہٕیوان چھُ تۄہہِ یِم پٲٹھۍ کِہی کٔرِتھ ہٕیکِو؟
مے چھُ یقین زِ تُہۍ آخرکار کینٛہہ یِتھ پسند کٔرِو، سُہ ژھٲرِو۔
زِندگی ہٕنٛز لُطف لیٚون چھُ نٕہایت سُہاوُن۔
کیا تُہۍ کینہہ گھوڑٕ پالان چھِو؟
مے اوس یِتھ محسوس کران یِلہِ مے پنُن پَتھم کٲمَس منز مریضن ہٕنٛز دیکھ ریکھ کٔر۔
یِمن ڈرایؤرن ہٕنٛز مہارت سۭتۍ مے اوس حٲران۔
کیا تُہۍ کٲنٛہہ پالُو ژانور چھُ؟
مے اوس وُنٛہہ پنُن 30 ہٕم جنم دِن سٲریو۔
مے چھُ خوش زِ تُہۍ نہٕ حادثس منز پٔتھ، نہٕ ژٕیِو ہٕنٛز بدتر حالت گٔیو۔
سُہ چھُ وٲنٛگُن کالج، آرکیٹیکچر پٲٹھۍ پٔرِتھ۔
مگر تُہۍ کینٛہہ نِہ کٔرِتھ ہٕیکِو۔
مے اوس نہٕ تَمہِ کٲنٛہہ خبر، مے اوس یِم تہِ نِہ مٲلوم زِ سُہ چھِ چھُٹِس پٮ۪ٹھ۔
مے چھُ ہالی ہٕنٛز زِندگی سان عام طور پٲٹھۍ زیادٕ محنت کٔرِتھ کوشِش کران۔
مے اوس پنٕنۍ زَنٛس سۭتۍ پٲٹھۍ، مے اوس یِتھ محسوس کران زِ میانہِ کٲنٛہہ کَمے نِہ۔
سُہ کِتھ پٲٹھۍ ہٕنٛز زینہٕ ٲس؟
نَہ، مے اوس نہٕ کٔرُن۔ تِمَنٛز سۭتۍ کٲنٛہہ حدس پٲٹھۍ نَہٕ سُہاوُن اوس۔
بارٕ، تِمِس پٲٹھۍ تُہۍ کٲمِیاب گژھِو۔
مے اوس گۄڈٕ ریاستہِ ہٕنٛز نمبر وُن ٹینس کھٕلٲڑی۔
دۄیم طرف، مے چھُ نہٕ پَکٕہ زِ مے وُچھِتھ یِہ دوبارٕ کٔرِتھ۔
مے تہِ چھُ انِمے پسند، تہٕ کینہہ وُری گٔے مے ٹیٖوی وُچھُن بند کٔر، شاید بہٕ دوبارٕ شروع کرٕ۔
مےٚ چھُس پنٛنہِ پہلِ پے چیک دِتھ بہت خوش
مےٚ ٲسُس زٕ یکین، پَتہٕ تٔرٛے زَن آیہِ پٮ۪ٹھ تہٕ مےٚ بوٗز زِ خطاب چھُ اَسہِ
آج مےٚ یہ پَرٛھ، سُہ چھُ پَکّا اَکھ الگ قِسمُک ژھۄر
مےٚ چھُس خالی گھونسلہِ ہٕنٛز کیفیت زور سٕتۍ محسوس کَران
چھُس صرف مےٚ تہٕ میٛون بُزرٕگ ماوُج
اچھا، مےٚ آو پَکڑنہٕ تہٕ مےٚ لٔگ بُرا تہٕ اَجیب
مےٚ نَہ ٲسُس پَکّا زِ مےٚ چھِ نِوِ نوکری شروع کَرُن یا نہٕ
گٔژِت ہفتہٕ آخرِس مےٚ نٔوِس رٛاستَس ہائیک کٔرِتھ خۄدس پٮ۪ٹھ لٔگ اَکھ غرور
مےٚ چھُس سٕمژھان زِ تِم چھِ پروٹینُک اَکھ گۄڈٕ سورس
سُنوُن منز چھُ اَکھ دِلچَسپ نوکری لَگان
میٛون سوتیلِ ماو وارِتھ تہٕ مےٚ چھِ پنٛنِس ڈادِس بارَس فِکِر
آ، تِمِس سٕتۍ گۄڈٕ مدد گژھِ
اوہ نہٕ، تِمَن تُہٕنٛدِ مٲلومات مٮ۪لِتھ کِنہٕ گٔے
مےٚ چھُس تِمِس بارَس پٲٹھۍ خوش
ہا ہا آ، کُنہِ چھُس نَہ سَزمژھاون زِ یہِ چھُ اصلَس کتھ بُرا
یہِ چھُ سٲری کھیل بدلٲوُن
مےٚ چھُس کٲمَس منز سٲری وقت سُست گژھان
میٛون چِکَن ٲسُس بٔڈ کَچّا، منز ٲس اَز تام گلابی
یہِ چھُ اَکھ بٔس کہانی، مےٚ چھُس خۄش زِ مےٚ یہِ ژٕٹ
کیا تَمہِ سٕتۍ پگھار تہِ وادان؟
نَہ، تہٕ مےٚ ابھی ابھی شارٹس حٲصِل کٔرِتھ۔
کُنہہ وجہ سۭتۍ نِنٛہہ ننۍ جالا مےٚ ڈرٕوان۔
کیا تِمِس نَو جَیسی چھُ؟
مےٚ حالٕے منز اکھ ریسٹورَنٹ آس، یِتھ وٲلِتھ ویٹرَن اکھ سیاہ جوڑِس خدمت کرنس انکار کٔر۔
تِمَن تُہۍ سَکیم کرنہٕ خٲطرٕ کیا کٔر؟
مےٚ دۄہیم پوزیشن خٲطرٕ کامس منز درخواست کٔر۔
مےٚ اکھ دفعہ حادثہ گٔیو۔
تُہۍ تِہ واپس کُنہہ خٲطرٕ دِژ؟
مےٚ سارِ ہفتہٕ پریکٹس کران چھُس تِمِس انٹرویو خٲطرٕ یُس مےٚ سُہِتھ چھُ۔
مےٚ وریَن دوران میڈن منز سچٕے گژھِتھ چھُس تانٛگ۔
مےٚ لگہٕ چھُ وقت گژھان گژھان تُہند خاندان تِہ ضرور پسند کرِ۔
لگِتھ چھُ یِہِ گژھِ، مےٚ اُمید چھُ تُہند ڈِنر شاندار آسِ۔
مےٚ ۱۵ ؤریَن ہِنٛز بِلۍ اَز مٔرتھ۔
ہاں، سُہ سچِچ مُلازمتس منز آو، اگرچہ سُہ بےہوش گژھنہٕ نِش آس۔
مےٚ پنٛنِس کٕنِس کتابن ہٕنٛز آرڈر کرُن وُچھ۔
مےٚ تمنٛا چھُس یِہِ آسِ، مگر یِتھ وِزِ اسِ اکھٕٹھ گژھان چھِ نَہ کِہینٛہ سُہ۔
مےٚ سپرایٹ چھُ بہت پسند۔
مےٚ اعتماد سۭتۍ اندر گژھ۔
یار، مےٚ اکھ دوستس فون کرُن یا کینہہ کرُن پٲوان چھُس پنُن دل شانت کرنہٕ خٲطرٕ۔
یِہِ سُنِتھ مےٚ افسوس گٔیو۔
مےٚ سُہ گژھان تھٕ کہ بہٕ یِم کامس منٛز بس خراب اوس۔
مٕژ دوستس آدَم سکاٹ سٕتۍ گژھنُک موقعہ گٔی۔
کَتہِ کَتہِ ریچھ تہِ چھِ آسان، یِمن خٲطرٕ مےٚ ریچھ سپرے چاہی۔
مےٚ کٲمَس منٛز ترقی گٔی، تہٕ مےٚ تَتھ چھِ لگ بگ اکھ ؤری گژھان۔
مٕژ پارٹنرَس چھِ حالیہ کٲم سٕتۍ وابستہ کینہہ مسلہٕ۔
واہ، تُہۍ مزٕ کٔر وقت گژٕرٕو، یہِ شیٚتھ مےٚ خۄشی گٔی۔
مےٚ تہِ چھِ امید، اسۍ اوسُو یقینن دُنیاہُک عَظیم ترین قوم۔
ریچھٕن ہٕنٛز پٲٹھۍ ہرن تہِ چھِ کَتہِ کَتہِ بےوقوفانہٕ حرکت کران۔
نَہ، مےٚ چھُس نَہ یژھان تَتھ ہٕنٛز اکھ مایل کُنہِ نٕزدیٖک روزُن۔
مےٚ سُہ خٲطرٕ نَہ کٔر مطالعہٕ، مےٚ پنُن وقت کینہہ بیٚیہِ کَرنٕچ منٛز گژرٲو۔
گٔے رات مےٚ سٲری پیزا کھٲد یُس مےٚ دوستن خٲطرٕ انٛد لٲد اوس۔
یِم چیٖز چھِ أسۍ واریاہ گژھان معمولی سَمجان، تِمن ہُنٛد قدر کَرُن چھُ واریاہ خۄشگوار۔
وُن تام مٕژ قٕیمت حدس منٛز کینہہ تہِ نَہ۔
اَکھ چھُ اکھ ؤری ہُنٛد تہٕ اَکھ چھُ بارٕ ؤری ہُنٛد۔
مےٚ پنٛنہِ باقی آسِتھ چاینیٖز کھانٕچ متعلق سٲنٛد، گٔے گھر تہٕ وُچھ کہِ کُنہِ کھٲد اوس۔
گٔے ہفتہٕ آخر مےٚ وُچھ اَکھ زَنہٕ یُس پنٛنہِ گاڑِ منٛز بندوق تھٕوان اوس۔
مےٚ ویک اینڈس پیٚٹھ پٕہلِ یِم پورٕ کرنٕچ پوری کوشش کٔر، تاکہ ضروٗرت پَتھ سُہ ہُنٛد لُک تھوڑا درست کٔرِتھ۔
کُس چھُ سَمان، شاید سُہ چھُ اَکھ بَد ذوق پرٛس۔
سُہ چھُ سُہ۔ تُہۍ چھِ نِیٖک گاڑِ پسند؟
وۄنۍ سچ چھُ، تہٕ مےٚ صرف یہِ احساس چھُ زِ مےٚ زنٛدٕ چھُس۔
مےٚ چھُ امید زِ حمل ہموار طریقہٕ سان گژھِ۔
اچھا، تُہۍ دِژ تِمِس شکُک فایدٕ۔
مےٚ چھُس سچِ تمنّا کران زِ مےٚ لا سکولس منز داخلہٕ گژھِ۔
تُہۍ یہِ تُہندِس دلہٕ پٲٹھۍ زٕیادٕ نیچ گژھنہٕ دِیِو۔
کیا یہِ تُہندِس ساتٕتہٕ اکثر نہٕ گژھان؟
گژھِ راتھ مےٚ اوس اک زور دار آوازس پیٹھ جاگ۔
آ، خوش قسمتی سان یہِ اصل حالتہٕ نسبتن زٕیادٕ خراب نظر آو۔
یہِ سمسٹر منز چھِ مےٚ سٕتۍ آسان کلاس۔
یہِ چھُ اک لا فرم منز پارٹنرک پوسٹ۔
مگر مےٚ برٛون کٔر، تہٕ یہِ اوس لگ بھگ ۴۰۰ مایِل۔
مےٚ چھُس رٲضی، لٔٹۍ آسٕتھ مےٚ اوس سُہ شو واریاہ پسند۔
مےٚ اوس ٹیمِ سٕتۍ کم کران تہٕ مےٚ ٹیم کٔر سُہ کار سُہ۔
یہِ چھُ اک واریاہ دلیرانہٕ قدم۔
تِمَنِس چھُ وۄنۍ پوکیمون گو۔
اَس چھِ ہمیشہ تمنِس بچنِس بہترین دِوان یژھان۔
مےٚ اوس فِکرِت زِ تُہۍ وٲن زِ کانٛہہ خراب گژھِتھ۔
مےٚ گژھِ تِمِس سزٲ دِتھ گَرِ منز تھٲون۔
مےٚ اوس تِمِس صرف ۲ ؤرۍ، سُہ اوس اک بچہ۔
کیا تُہۍ تِمَنِس معافی مانٛگ؟
مےٚ چھُ بہت افسوس زِ تُہۍ سُہ سٲری کینٛہہ گژھِتھ
مےٚ چھُ لگٕان زِ یِم ؤرۍ چارجٕرس کرِ بہتھ سُہ کار
تِم چھِ مےٚ کَران شِپَر سٕتۍ دعویٰ درج تہٕ تَتھ راہِ گژھُن
مےٚ چھُ نہٕ فکر زِ سُہ چورِ گژھِ
مےٚ چھُ لازِم کُنہِ وِزِ خٲرٕس پٲٹھۍ سُہ چٮ۪ک کرُن
گژھِتھ ہفتہٕ مےٚ کُتُرس دِیُن پٲوان دَیا مۄت
مےٚ چھُ اُمید زِ تُہۍ سُہ تہِ لَبِو
کیا تُہۍ ڈِٹینشن گژھِوٕ پٮ۪ٹھ؟
مےٚ چھُ نَوُن کاروبٲری زِندگی منز تہٕ یِمۍ ۱۰۰ خۄد روزگار منافَعہٕ سۭتۍ مےٚ سٲری کرایہٕ دِتمُت
یِم ژٕنۍ چھِ گویا نہٕ واقف زِ اَسہِ نسلن منز کیاہ فرق چھُ
آ، سادٕ بچپن ہٕنٛز
سُہ چھُ ٹھیٖک، تُہۍ کَتھ پٲٹھۍ سکوٗل گژھِو؟
کیا تُہۍ چھِ کُنہِ وِزِ تِم سٕتۍ رۄبروٗ روٗبروٗ مٮ۪لِتھ، یا آنلایِن پٮ۪ٹھ مٮ۪لِتھ؟
سُہ کرُن چھُ اَکھ پاگل پَنُنۍ کٲم
آ، تہٕ سُہ چھُ تِمن منز اَکھ بہترین یِم پیسہٕ سۭتۍ لِتھ ہیکو
مےٚ چھُ تہِ تِتھ پٲٹھۍ لگٕان، مےٚ چھُ تَمس پٮ۪ٹھ فخر؛ سُہ چھُ واریاہ پسند یِوان، مگر تہِ
مےٚ پٲلِتھ گولڈفِش چھُ اَتھ مرِمُت
مگر فیس بُک پٮ۪ٹھ تِمن ہٕنٛز نٲوٕ سٲری ریویوٕ آسِتھ
کُنہِ چھُ مےٚ لان موٗوَر نِتھ گوم کٔرمُت
مےٚ آو لٲج تہٕ مےٚ سٲری آس پاس لوٗکَن نِش لُکُن چاہان
واہ، ۱۵ وریا ہٕنٛز عمرس منز تِمَن سۭتۍ محبت کرنہٕ علاوہ کانٛہہ تہِ نَہ کٔرِتھ ہیکو۔
مےٚ چھُس جانان زِ تٔمس ہٕنٛز بیٛیہِ زۄج تہِ بٔڈ یی کمٲنۍ کران۔
مےٚ تٔمس بَہت یاد کٔرَن۔
مےٚ دۄپہر ہٕنٛز کَھٲنۍ نَہ کٔر۔
کیا تُہۍ گژھِو سٲری چیٖز درست کرِتھ؟
تِہِ چھِ ٹھیک، مےٚ پَڑِ تٔمس پنٛنِس موٚمِس سۭتۍ تھٲوُن۔
مےٚ سٲحلَس پٮ۪ٹھ اوس تِہِ اکھ سیٖگل مےٚ طرف ژھپٹہٕ دِتھ ہیٚٹھِ آو۔
یہِ چھُ کمال، کیا چھُ تُہۍ سۭتۍ کٲنٛہہ وارم اَپ روٗٹین تُہۍ تیار کرنہٕ خٲطرٕ؟
مالِکَن چھِ پنٛنِس خٲطرٕ سٲری پٲٹھۍ سۭتۍ اکھ سُہُن کاروبار بٲنیوو مٕت۔
مےٚ کَمَس پٮ۪ٹھ اکھ بیٚوقوٗفی ہٕنٛز غَلتی کٔر۔
مےٚ پنٛنِس کمرَس منٛز گژھِتھ اکھ کٲلۍ بٮ۪ل دٔر، مےٚ دۄڑ کٔر یَتھ پٲٹھۍ کٔہنِچ نَہ کٔر۔
ییلہِ مےٚ چھُس کٕنہِ اکھ اَسہِ نِش تہٕ ژھٕنٛد اکیٚلا نَظر یِوان دٕوان، تیلہِ میٚون دِل چھُ دُکھی گژھان۔
مےٚ گوٚوٗل پہلی لَٹہٕ اسکای ڈایونگ کرن۔
ییلہِ مےٚ اوسُس لٔکٕٹ، تیلہِ اکھ لَٹہٕ مےٚ کٔر چوری تہٕ مےٚ گژھِ پکڑنہٕ۔
مےٚ چھُس پورٕ تیار گَرِ گژھِتھ پنٛنِس کُٹٕم سۭتۍ مِلُن۔
ہاں، یہِ چھُ بَہت خراب۔ مےٚ تہِ چھُس یہِ ژٕلِتھ مٕت۔
کاش سٲری ؤری کرسمس اوسُس، ہا؟
مےٚ چھُس سٔنٛڈٕر وار چرچَس گژھان۔
مگر کم از کم چھُ تُہۍ پنٛنِس زۄج تہٕ بچن پٮ۪ٹھ بھروسہٕ کٔرتھ ہٮ۪کان۔
ہا ہا، اُمید چھُ زِ سُہ گژھِ نَہ کُنہِ زنٛدگۍ خٲطرٕ زَخمی یا کینٛہہ یِمِچ پٲٹھۍ۔
نَہ، حقیقت منٛز نَہ؛ بہٕ صرف تِمَن ہُنٛد ہُنر سراہان۔
اچھا، آخر بہٕ پنٛنہٕ اکھ کھولِتھ سۄنٛد کہٕ میون کُتُر مےٚ سٲری جٲے چَٹان اوس۔
تَمہِ بہٕ پارکِنٛگ ہُنٛد دیوارس سٲتۍ زوردار ٹکر گژھ۔
مےٚ چھُ دُکھی زِ میون سُہر چھُ سُست۔
بہٕ پنُن سٲری کوٗشش کران۔
سُہ یِتھ دۄ ہفتَس رۄہِ۔
یہِ بینٛڈ چھُ ۲۰ سٕنٛز ۵۰ سٕنٛز دَہکَن ہُنٛد کُنہِ تہِ طرزس منٛز مشہور گانےٚ دوٚبارہ کران۔
مےٚ روزگار گژھِتھ چھِ دوٚو وَرۍ گژھان، اَتھ بہٕ چھُس دعوت یوان مُلکی مُختلف ادارٕ سٕنٛز انٹرویو خٲطرٕ۔
یہِ چھُ اکھ زبردست خیال۔
تُہٕنٛز گاڑِس کِیاہ گژھ؟
آ بہٕ چھُس یہِ محسوس کران، میون زندگی چھُ شاندار۔
تُہٕنٛز دِل کیوں چھُ خراب؟
یِم ہاسٹلَس منٛز بہٕ چھُس، سُہ چھُ بلکل خالی۔
سُہِ تہِ پٲٹھۍ نَہ اوس پسند کران، مگر پَتہٕ سُہ ترٛقی کرنس شروع کر۔
سُہ ضرور چھُ اکھ محنتی انسان۔
بہٕ چھُس ویگن بنٛنُک سوچان، مگر میٚن چھُ نہٕ پَتہٕ زِ بہٕ یہِ کرِ ہٲوٕن یا نَہ۔
مےٚ چھُ دۄہہ پیٹھ بایالوجی ہُنٛد امتحان۔
میٛون چھُ دِل تام تھکان یِوان پنٛنِس بوائےفرینڈس ہُنٛد توجہ خٲطرٕ مقابلہ کرِتھ کرِتھ۔
تُہٕ چھُو یہِ وَرۍ زِیادٕ سُندَر دِسان۔
اچھا، مےٚ چھُس سونچان زِ یہِ تِتھ خراب نَہ گژھ۔
یِم سۭتۍ مےٚ تہٕ تَمہِ تٔرٛہ احساس گژھان
بہٕ پَرنٛن پُچھن وُن یِہ کِہ تُہنٛدِس بَابَتھ کِیاہ لَگۍ
بَہٕ، سُنین چھُ لَگان زِ تُہۍ پَکّٕہ تَیاری کٔرۍ چھِو
مےٚ نَنۍ چھِ بٔڈۍ مِہربان
بہٕ کینہہ ٹی شرٹ آن لاین آرڈر کٔرِتھ وُن، مگر ویب سایٹ چھِ یوکرینٕچ تہٕ واریاہ شُبہ انگیز لَگان
یَلہِ بہٕ باہر وُتھ تہٕ اکھ پَکِرٕن کٔر مےٚ پٮ۪ٹھ شِٹ، مےٚ نَہٕ یِقین گٔژھ
آسۍ دُنیٛاہِ ہٕنٛز بٔڈۍ فوج آسۍ
کیاہ تُہنٛدِس کُنہِ کینہہ بٔڈۍ آس؟
مےٚ گٔیوٕل پُتر پیٚدا گومُت تہٕ چھُ تندرُست
سُہ کِس قِسمُک پروجیکٹ آس؟
شادی چھِ ہمیشہ واریاہ مَزٕ تہٕ رومٲنٹِک
بہٕ پنُن زنٛدگٕچ بَابَتھ سوچان آسُس
مےٚ بہٕن کالیجس گٔژھِتھ ؤنۍ
ٹھیک، مےٚ لَگان چھُ زِ تُہنٛدِس پَکّٕہ ہَنگامٕچ وَخت یِوان
تَہٕ ہاں، بہٕ تِمَس واتوٕن
آج بہٕ تہٕ مےٚ ہۄرٕ آسۍ بٔڈۍ سِنک مَنٛز، سُہ گژھِتھ گژھِتھ
کُنہِ نَہٕ ہَسۍ، مگر مےٚ چھُ اَسہِ تام یِقین نَہٕ یِوان زِ مےٚ سُہ نَہٕ کٔر
مےٚ باسَس سامنٕہ نَہٕ واتھ کٔرِتھ مےٚ بٔڈۍ خراب لَگۍ
اوہ، تَہٕ سُہ اکھ بٔڈۍ سُہنٛدِر بَاتھ آس—بَہٕ خوش۔ اُمید چھُ زِ تُہۍ پنُن نِکٕہ چھُٹۍ مَنٛز مَزٕ کَرِو
مےٚ چھُ ٹرمپَس پٮ۪ٹھ یقین، سُہ گژھِ اکھ بٔڈۍ صدر
مےٚ چھُ امید کَران زِ یہِ کانٛہہ سنجیدہ معاملہ نَہ آسہِ۔
مےٚ چھُس تہٕ تَمہِ پٲٹھۍ سوچان، مےٚ چھُس تہٕ ایمیرالڈ پسند۔
تہٕ تُہۍ چھِو وٕنٛدۍ، یَلہِ مرد بیمار گژھن تہٕ چھِو گویا موتُک بسترَس پٮ۪ٹھ۔
آ، تہٕ مزاحیہ بات یہِ ٲس زِ میٹنگ ختم گژھن تام مےٚ نَہ آی خیال۔
سُہ گَژھِتھ آتش زٕ پٲٹھۍ۔
تُہۍ پٲٹھۍ آخری دقیقس منٛز کینسل کرُن پٲوان، یمِ سۭتۍ مےٚ دُکھ لَگ۔
اوہ، تُہٕنٛدِ نَوزٕمٕتھ بچس خٲطرٕ مبارک۔
سُہ دۄہ مےٚ گژھِ اکھ مسلہٕ اکھ دوستَس سۭتۍ۔
سۄ چھِ نرس بنُن یژھان۔ یہِ ہفتس منٛز سۄ ہیٚکۍ داخِل گژھِ یا نَہ، یہِ پتہٕ لَگِ—دعا چھِ۔
گژھِ مےٚ پَگاہَس ہفتَس منٛز غُصہٕ، یَلہِ مےٚ مکان مالِک مےٚ اے سی ٹھیک کرنس کُن وقت لَگاوُن آسوٕس۔
تُہۍ چھِو وُنِ کُتہِ شہرَس منٛز؟
مےٚ چھُس وٕنِ نۄکریس منٛز اکھ اِضافہٕ مِلان۔
تِمَنۍ یہِ باتھ وٕسرٲونہٕ خٲطرٕ مےٚ اکھ کیک ؤن۔
مےٚ چھُس خیال کَران زِ بہٕ آز یہِ ژٕلیٚ ہٲوٕن۔
سُہ ٲس بَہٕ کمالُک شو۔
کیا تُہۍ چھِو تِمَنۍ پَیسہٕ دِوان؟
مےٚ چھُس یقین زِ یہِ چھُس مےٚ پٮ۪ٹھین رٕشتَن ہِنٛدِ سۭتۍ۔
مےٚ چھُس تہٕ ژٕٹھیٚتھ یژھان اکھ جیپ آپُن۔
یِمَنۍ چھِ تُہٕنٛد مدد کٔرمتۍ، تِمَنۍ ہِنٛز قٕدر کرُن چھُ سُہ۔
تُہۍ کُنہِ قِسمُک گوٗد منٛز ژٔلِو؟
مگر مےٚ سٲری وقتن ہٕنٛد پسندیدہ کھیل چھُ ٹیکساس ہولڈ ایم۔
بہٕ ہُتھٕے روٚتھ۔
یَم، مےٚ ڈیزرٛٹ بناون تہٕ کھاون دۄنُے پسند چھُ۔
تُہۍ چھُو لازِم ہر کینٛہہ خٲطرٕ تیار روزُن۔
ویک اینٛڈس پیٹھ بہٕ غصہٕ اوس۔
اوہ نہ، کیا تُہۍ تَمہِ سۭتۍ شایستہٕ اوسِو؟
مےٚ لگٕنۍ چھُ یہِ ضٔروٗری زِ جوڑٕ خوش روزنہٕ خٲطرٕ کافی محفوظ محسوس کرٕن۔
ییلہِ مےٚ ہٕنٛدۍ بٔچٕ سٲری دۄہ سکولس منٛز روزان، کَتھ کَتھ مےٚ اکیٚلاہٹ محسوس کران۔
مےٚ ہُند برٛونٛہہ آخرکار کالج گٔیو۔
مکٲڑی چھُ شاید تَمہِ خٲطرٕ شُکرگُذار۔
ییلہِ تِم مےٚ سۭتۍ ژوٗٹھ واتان، تیلہِ مےٚ سۭتۍ بہٕ ژٕٹہٕ غصہٕ یوان۔
کیا تُہۍ کانٛہہ سۭتۍ گژھان؟
کیا یہِ پَگاہہٕ نَہ اوس؟
تَمہِ ہُند یہِ طریٖقہٕ مےٚ حیران کرُن بہٕتھ نِکو اوس۔
بہٕ چھُس یہِ سٲری وِز کران۔
ییلہِ مےٚ آخرکار ہایِ سکول کٔر ختم، بہٕ اوسٕس بہٕتھ پُرجوش۔
یہِ چھُ اکھ اہم قدم یِم سڑکِ أسۍ زندگی ونان۔
مےٚ سۭتۍ تہِ اکھ گَرٕ لون چاہی۔
یہِ ڈیو ریمزی نہٕ اوس، ہے نہ؟
مےٚ امید چھُ زِ وۄنۍ تِم عمر بڑان، تِم سیکھنہِ خٲطرٕ پنُن پیار جاری تھٲوِتھ۔
مےٚ چھِ یاد یوان زِ بہٕ جوان آسٕم تہٕ زیادٕ وقت گژھان۔
سمجِ یِوان، یہِ چھُ بہٕ دُکھ دِوان۔ اُمید چھِ زِ تِم تُہٕندِ گھرٕ پٮ۪ٹھ غایب گژھن۔
مےٚ چھِ خیال زِ تُہۍ شاید ٹی وی وُچھِو۔
تٔمِ کٲم کٔر آخری ؤرۍ دۄر جَدوجہد، مگر آخرکار کامیاب گٔے۔
تُہۍ چھِ مےٚ بُوکھ لٲوان۔
مےٚ چھِ خیال زِ اوس چھِ أسۍ زٕے ۶۰ پیٹھ باہر۔
یہِ چھُ زبردست ہٲسی وول، مگر مےٚ چھِ پتہٕ زِ ٹین ایجر کَتھ کَٹھِ آسن، تَمہِ سۭتۍ چھِ یہِ تھوڑا سنجیدہ تہِ۔
مےٚ گۄڈٕ گۄڈٕ اوسٕم پنٛنِس سۭتۍ خفا۔
مےٚ چھِ گمان زِ یِہِ چھُ تُہۍ لٲج یِوان ییٚلہِ تُہۍ سٲری عوامس منٛز بۄتھ۔
مےٚ نہٕ چھِ گمان زِ مےٚ ہٕنٛز ساتھی چھُ حالیہ وقتس منٛز میانہِ وفادار۔
کیا یہُے اوسُس ژٕ تُہۍ ژھٲنڈان اوسِو؟
مےٚ چھِ یقین زِ تُہۍ تٔمِ کٲفی ڈراو مٕژ، ہا ہا۔
کیا تٔمِ تِم پنٛنِس نال کأشر وقت سۭتۍ تھاوِتھ؟
مےٚ چھِ تُہۍ خٲطرٕ خوش، اُمید چھِ زِ یہِ تَمی جاری رَہِ۔
تٔمِ وُچھُن پَزِ نِش کَٹھِن۔
مےٚ نہٕ کَتھ چھِ یِہِ پنٛنِس بدترین دُشمنس خٲطرٕ خواہش کران۔
أسۍ تٔمِ ہٕنٛز کٔرمَن ہٕنٛز قیمت دِوان اوسِو۔
نَہ، بہٕ گٔیِس کیازِ بہٕ تقریباً بےہوش گٔیِس۔
حالات خراب تر کٔرِتھ، تٔمِ پنٛنِس پی ایچ ڈی حٲصل کٔرنس منز اوسُس صرف اکھ دۄہ باقی۔
أسۍ اوسِو اکھ ٹیم روٗپ منز کأشر اکھ ؤرۍ سۭتۍ کھیلِتھ۔
اوہ یار، مےٚ نَفرَت چھُ جَل گَژھان یَتھ وَنٛگ
کیا یہِن سۭتۍ سُہ یادٕن واپس آیِن
زیادٕ غُصہ کَرنہٕ کوشِش کَرِو، شاید تَمس پَتہٕ آس سُہ خٲطرٕ یِم نہٕ واتٕوُن چاہان
سُہ چھُ أچھا یُس سُہ دوست آسن
اوہ ساری، یِتھ پٲٹھۍ أسۍ گژھان اوس تَتھ کُن أسۍ کانٛہہ نہٕ ژٲنٛھان
سارٕ کینٛہہ صاف کٔرِتھ ٹھیک تھاونِس منز اوسُس مےٚ پٲٹھۍ دھیان
مےٚ چھُ فَخر پنٛنِس ماجہِ پؠٹھ، یِم مےٚ گرٛامہِ ہُنٛد خیال تھاوان، ژٕندٕ کِنہٕ سُہ کَتھِ کَتھِ بدسلوک گٔژھِ تہِ
مےٚ دوست اوس سُہ پَزٕ کینہٕ نہٕ، یَتھ کُن سُہ اچانک نوکری تہٕ گرٛل فرینڈ نِہ مِلان
سُہ سُنینہٕ سۭتۍ لگِہِ جیوٗ تۄہہِ گریجویٹ نہٕ کٔر یا کینٛہہ غلط گٔیہِ—کیا تۄہہِ گریجویٹ کٔر
مےٚ چھُ شک زِ مےٚ ہیکہِ سُہ کٔرتھ
کیا تُہۍ تِمن گھرٕ وُچھنہٕ خٲطرٕ گھبرٲوان چھِو
ییلہِ مےٚ ہٕنٛدۍ بچہٕ واریاہ چُپ آسان
مےٚ چھُ سُہ پؠٹھ واریاہ فَخر زِ سُہ سُہ کٔرِتھ ہٮ۪کان
سُہ گژھِ واریاہ حیران کُن آسُن
ہاں تہٕ سُہِ اوس أسۍ تَمس سۭتۍ کَران
خاندان ہُنٛد ذِکَر گژھان، مےٚ چھُ پنٕنۍ لۄکٕٹۍ بھتیجی ہنٛدۍ خاطرٕ پٲٹھۍ کَرُن واریاہ پسند
مےٚ چھُ زنٛدٕگی منز کَتھِ نہٕ یِتھ پٲٹھۍ شرمندٕ گٔمتھ
مےٚ چھُ لگٕنۍ زِ ییلہِ چھُ تۄہہِ پنٕنِس پؠٹھ یقین، تۄہہِ ہیکِو زیٛادٕ ترۍ نوکریو خٲطرٕ پنُن ناو بناوِتھ
ییلہِ ییلہِ مےٚ ژٕژھ سڑکَس پؠٹھ جیپ، مےٚ چھُ واریاہ حَسَد گَژھان
آ، مےٚ چھُس وُچھان زِ تِم نہٕ کٔرِ مےٚ نوکری، تَمہِ سۭتۍ چھُس مےٚ واریاہ پریشان۔
یہِ چھُس اَسہِ لگٕنۍ زِ گوٚو کَنہِ وُچھُن بٔڈ، پُرانہٕ تہٕ ظالم بھیڑیاہ یُس مےٚ کھاونُک ارمان تھوٚو۔
مےٚ چھُس پیٚوان پنٕنۍ بَچن بُفے ہٕنٛز طرف۔
مےٚ چھُس اُمید یِہِ چھُ ریاضی تہٕ مےٚ چھُ کٔرِتھ محنت۔
کاش مےٚ ہیٚکِس پنٕنۍ ماجہِ کَنٛہہ زٕیادٕ مدد کٔرتھ۔
اَس چھِ پارٹی منز مٕلُنُک پلان کَران، یِمٕتھ مےٚ ڈَیٹ آسہِ واریاہ بےترتیب تہٕ بے ڈھنگ۔
کَنہِ کَنہِ چھُس مےٚ مشکل آرام کٔرتھ تہٕ ذہن ٹھنٛڈ کٔرتھ۔
کرسمس ہٕنٛز اَکھ دۄہ پیٚٹھ چھُس مےٚ واریاہ جوش یِوان۔
یِمن پیٚٹھ چھُ واریاہ کینٛہہ منحصر۔
تُہۍ چھُوٚرِ کٔرِتھ تِمن قدر، یِتھ پَزِ تِہِ کٔرُن۔
اُمید چھُس کَران زِ تُہٕنٛد شام گژھِ مزٕدار تہٕ نیندر یِو آرام سۭتۍ۔
اُمید چھُس کَران زِ کَنہِ دۄہ گژھِ مےٚ زِیادٕ لوٚکن پٮ۪ٹھ بھروسہ کٔرتھ یِوان۔
کیا تُہۍ چھِوُ وُچھان فُڈ کُنہِ بیٚیہِ کُتُر لَگان؟
سۄ بدترین گوٚو یِہ زِ فوٹو، بٲلَن ہٕنٛدۍ کمبل تہٕ یِیٚر بُک—یعنی سٲری کینٛہہ پھینٛکُن پٲوان۔
یِہ چھُ اَکھ شاندار سنیچرُنُک سُہ، تہٕ چھُس مےٚ واریاہ بےتاب زِ اَز کُنہِ چیز چھُ نیران۔
بس کٔرِو تَمہِ پٮ۪ٹھ کٲم۔
کیا تُہۍ چھِوٚ کَنہِ وِز پنٕنۍ سامان استعمال کٔرُن پٲوان؟
تَمہِ پیٚٹھ گوٚو اَکھ عجیب ریش۔
مےٚ ہیٚو پنُن لیپ ٹاپ ژٔل تہٕ گوٚو یہِ خراب۔
تُہۍ گژھِو اَسہِ یادن سۭتۍ واریاہ محبت۔
مےٚ یِمۍ ترٛقۍ ہٕنٛز حٲصل کَرنٕچ خٲطرٕ واریاہ محنت کٔرمٕژ، سُہ مےٚ نہٕ مِل۔
تَمہِ اوس میرے گَرٕچ باہرٕچ تٕصویرٕ، تہٕ سُہ مےٚ ڈرٲون، مگر سُہ گوٚو صِرف أکِس دوسُتُک مذاق۔
کیا تُہۍ تِمَن مدد کٔرِتھ سُہ؟
سُہ گَرِس منز رٲوت، مگر کَدی کَدی رَسٕے بغٔیر باہَر گژھان، تہٕ مےٚ ڈر لگِتھ زِ سُہ نَہ واپَس یِ۔
مےٚ ہمیشہ وارِیاہ سفرٕ خٲطرٕ تیار رٲون پسند۔
اگر تِمِس ہٕنٛز اَنگُرِس نَہ چھِ اَنگوٗر، تہٕ اَسہِ اَزِ تہِ اُمید چھِ۔
کینہہ ہفتَن پیٹھ پاناما سِٹِی گژھان۔
اوہ، یہِ شُرِتھ دُکھ گٔے۔
مےٚ چھِ پنٛنٕن ٹانگَن تہٕ آزادی ہٕنٛز یاد۔
وقت گژھِتھ تُہۍ وُچھِو سُہ گامِتھ سوار گژھِتھ۔
آنلاین دوست تہِ تِتھٕے اچھِ چھِ۔
یِتھ مےٚ پنُن بِلّی میٹی گوٚو گُم۔
مےٚ تہِ بیٹل فیلڈ منز نَہ گژھِتھ ہٲو۔
اوہ، یِم گوٚو، سُہ چھِ أکِس بونس۔
مٲژ نوکری ہٕنٛز حفاظت آسُن چھِ أکِس نٛیٚرِ احساس۔
مےٚ آیہِ ٲس کہ یِمۍ بچپنُک گَرٕچ نزدیٖک جَنٛگٕل نَوَن گَرَن ہٕنٛز تعمیرٕ خٲطرٕ کٲڈنہٕ آو۔
تِم ٲسِ واریاہ پیٖٹھ تہٕ نِیٖک، مگر کُنِہِ تہِ نَہ اوس تِمَن چاہان۔
گزِشتہ شَب مٲژ آرمڈیلو قالیٖنَس پاد کٔر۔
سُہ کِس پٲٹھۍ مُٹُھ ونان اوس؟
