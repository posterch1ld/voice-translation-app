ہائی وے پٮ۪ٹھ کار حادثہٕ وُچھِتھ بہٕ گژھُس صدمس منٛز۔
مےٚ لَگن چھُ سٕنٛچروار پٮ۪ٹھ گژھنس پتہٕ تِم چھِ اَتھ پیٚٹھۍ تہِ ژور گژھان۔
مےٚ اَکِس خالی پارکنگ لاٹَس منز گژھن نَہٕ پَساند آو
ہاں، مےٚ چھُس خیال کران زِ تَمہِ یہِ پَساند یِیہِ، مگر مےٚ چھِ آگے گژھُن ضروٗری
سُہ کمپیوٗٹر پرٛوگرامِنگ پَڑھان اوس
مےٚ تِم سٕے ہٕک ہارَس پٮ۪ٹھ جمع کٔرۍ تاکہ مےٚ تِم پہنِتھ ہٕکو
یہِ مکان مالِکُک غَلتی آو
تُہۍ گژھِ تِم خلاف پولیسَس رپورٹ کَرُن
کیا تُہۍ کُنہِ وقتھ پولَس گژھِتھ؟
تَمہِ ہٕنٛد سخاوت آو
مےٚ چھُس محسوس کران زِ سٲری دوستن ہٕنٛد اَتھ سۄ پسند آو زِ مےٚ چھُس باہر تھٲون
مےٚ ہٕنٛد دوستہِ سُہ جانان اوس زِ مےٚ نَہٕ سَہِ ہٕکو، مگر سُہ سیٹی وَجان نَہٕ رُکاون
بوٚد مایوس کُن، مگر نَتیجَن ہٕنٛد خٲطرٕ مبارکباد
عام زِندگی جاری تھاوٕنۍ خٲطرٕ اگرِ تِہ نَظراَنداز کَرُن پَڑے، مگر پنُن فانی آسُن یاد تھاوٕن چُھ سُہتر
اَسہِ ہٕنٛز قریبی فیملی منز چھِ صرف ۵ ژٕنۍ
یہِ چھُ صرف کیک، دۄیم کیک چھُ سَدایہِ آسُن
یہِ صاف تھٲوُن تِمَن ہٕنٛد طرفہِ ہٕنٛد مسلہٕ آو، تہٕ تِم ہٕکو سُہ دٮ۪کھِتھ
مےٚ چھُ، مگر یہِ کُنہِ وقتھ کامیاب نَہٕ گژھان
کیا تُہۍ پنٛنِہ کٲمچِ جاے پٮ۪ٹھ گژھِتھ کٕہنۍ چیز رپورٹ کٔرۍ؟
کٲم بوٚد زیادٕ آو تہٕ مےٚ نَہٕ ہٕکو گژھِتھ دِتھ
آ، مےٚ شرٲب گژھان ہٕنٛد ہٕتھ ہٕیٛوان
مےٚ دوستہِ سٕنٛد سٕتۍ شرط ہٕرٕوٚو
آ، واریاہ ہٕنٛدۍ ٲس
یہ چھُ سُہ، مےٚ امید چھُ زِ کینہہ غلط نہٕ گژھِتھ
مےٚ تٔمِس کٔہ زِ تٔمِس فرسٹ کلاس منٛز سیٖٹ ژور، تاکہ تٔمِس پنُن ٹایلیٹ آسِ
مےٚ کٔر گھرٕ منٛز اکھ سُہ رات تہٕ صرف آرام، مےٚ چھُ خوش زِ مےٚ یہِ کٔر
ییلہِ مےٚ کٔر معلوم زِ مےٚ کٔمٕتھ 100 اکھ دۄہ منٛز، مےٚ گٔے تھوڑا حیران
واہ، تٔمِس ساتہٕ چھُ تۄہہِ اکھ زبردست تہٕ مضبوط رشتہٕ، یہِ سُڻِتھ گٔے مےٚ واریاہ خوشی
مےٚنِس بلی ہٕنٛدِ پَتہٕ پَتہٕ میون پَپّی مُردٕ
سُہ ہر کینہہ منٛز دلچسپی دِکھاوِ
مےٚ تہِ، سچ ونان مےٚ چھُ نہٕ کینہہ سُہ طریقہٕ لُقمُتھ زِ بے چینی ٹٕلِتھ
مےٚ سُہند چھُ زِ اگر کینٛہہ گاڑِ یہِ کامہٕ خٲطرٕ ٹھیک ٲسِ، تہٕ سُہ ٹیسلا ٲسِ
راتھ مےٚ کھڑکِس پٮ۪ٹھ آواز سُڻِتھ مےٚ ڈرِتھ وُٹھ
کیا تٔمِس لونٛگ گژھان یا ژٕنٛگ
آخرس مےٚ کٔر سٲریٛس منزٕن کینہہ پنٕنۍ خۄر
یہِ چھُ گویا خۄدایِ طرفہٕ پیٹھۍ آمُتھ پیسہٕ
مےٚ اوس تُہہِ سُہ وقت ہٕنٛدۍ بارے منٛز ونان زِ ییلہِ میون کُتہٕ میون قالی پٮ۪ٹھۍ پٲخانہٕ کٔر
اَسۍ واریاہ ٹٕلِویژن دِتھ، مگر اَسۍ دالچینی رول تہِ بناوِتھ
مےٚ اوس واریاہ حیران زِ اَز ژٕتَن لوٗگ شاپنگ کَران ٲسۍ تہٕ ڈٕلی منٛز اتھ سٲری ٹرکی کلیئرنس پٮ۪ٹھ ٲس
مےٚ اوس ابھیٛ اکھ ہَوایِیَن باربیکیو پیزا آرڈر کٔرِتھ ڈٕلیوری خٲطرٕ
میٛون سٲری دوست کالج گٔے واپس، تہٕ اَز چھُ نہٕ کُنہِ ساتہٕ وقت گُزارن وٕنُن
یار، مےٚ اوس نہٕ ؤنٛد زِ مےٚ اوس اَتھ گِی
مےٚ چھُس خیال کران، یہِ چھُ ٹھیک، کیازِ مےٚ چھُس ویسے تہٕ بوٗڑ۔
سُہ چھُس مےٚ زنٛدگی ہٕنٛد بدترین روٗز آسٕن۔
حیران چھُس نہٕ، مےٚ تہِ چھُس تَمہِ سٕتۍ محسوس کران۔
مےٚ چھُ جیسن سٹیتهَم ہٕنٛد اِک گَژھ فلم پسند۔
مےٚ ہٕنٛزِ ژٔٹہِ منز چھُ سُہ خراب ذایقہٕ گژھان نہٕ۔
یہِ چھُس خراب۔ کیا تُہۍ چھِو سکولس منز رَہِتھ ہٕیکان؟
یہِ چھُس سُہ ژور یِم تُہۍ چھِو تَناوٕن ہٕنٛزِ حالتس منز سٲری صوٗرت دِتھ ہٕیکان۔
سُہ چھُس اِک دَردناگ تَجرُبہٕ آسٕن۔
مےٚ چھُس کٲمَس پٮ۪ٹھ چھُٹِتھ، تہٕ یہِ چھُس آرام کرنس باپتھ بلکل سُہ وقت۔
مےٚ تہِ، مگر آس نہٕ کٔرمُتھ زِ کُنہِ نِیٚک خبر یِیہِ۔
مےٚ چھُس واریاہ شُکرگُزار زِ مےٚ چھِ نِیٚک دوست۔
یہِ چھُ اِک نِیٚک سالگرہ ہدیہٕ۔
مےٚ چھُس سکولس منز واریاہ نِیٚک کَران۔
وٕنۍ تُہۍ پَزِو بٲقٕے احتیاط کرُن زِ تِمِس نِش چھِو کیاہ وَنان۔
مےٚ ہٕنٛزِ ماجٕن دِتھ مےٚ کینہہ بٲلی، یِم چھِ واریاہ وٲری ژٕٹِھ خاندانس منز آسٕن۔ مےٚ چھُس سچوٲی عزت محسوس کران۔
اوہ، سُہ چھُس سُڻنہٕ منز نِیٚک لَگان۔
مےٚ چھُس خیال کران زِ مےٚ چھُس بَہت نِیٚک کَران، مگر۔
مےٚ ہٕنٛد روٗز آسٕن واریاہ لمٕب، تہٕ مےٚ چھُس سچوٲی تھَکان۔
اوہ مےٚ گاش، کیا تُہۍ چھِو سچوٲی کارڈ گٕم کٔرمتھ؟
مےٚ افسوس چھُ، اُمید چھُ سُہ ٹھیک گژھِ۔
مےٚ یقین چھُ زِ تُہۍ سُہ طریقہٕ دِتھ ہیکیو یُس لوٗکھن پسند یِیہِ۔
شاید یہِ گَٹرٕچ نٔوی نسل گژھِ۔
مےٚ چھُس ونان زِ مےٚ سُہل کٔر۔
واہ، سُہ ضرور کافی مُشکل آسہٕ۔
کیا تُہۍ عام طور اکیٚلا رۄہان چھِو، یا اکیٚلا آسنس پیٹھ تُہۍ پریشان گژھان چھِو؟
سُہ مےٚ تہٕ مےٚ کُٹمٕچ خٲطرٕ کافی شرمناک آسہٕ۔
مےٚ چھُس ہیلووین پارٹی گژھنہٕ سۭتِی بہت ڈران۔
سورج اُٹھنس سۭتۍ پَتہٕ جاگنس منز مےٚ ہایِی سکوٗل کُشتی ٹورنامنٹ دۄہن ہُند جوش تہٕ ڈر یاد یِوان۔
تِم سٲری تَتھ أسن یَتھ پٲٹھۍ سُہ دوٚڑن شروع نہٕ کرن۔
اوہ، شُکر چھُ تُہۍ دیر نہٕ کٔر۔
مےٚ چھُس ژٕدٕ روٗٹ کینال خٲطرٕ ڈینٹسٹ ہُند اپاینٹمنٹ۔
آ، اکھ لمبِ لڑٕٲیِ گژھِ سُہل یا بَد۔
کُٹمٕس سۭتۍ ملُن سٲری وِزِ نیک لگِ۔
سُہ گَرٕ نِش گٔی تہٕ مےٚ چھُ نہٕ پَتہٕ زِ سُہ کُنہِ وِزِ واپس یِیہِ یا نہٕ۔
یِم لوٗکھ تُہندس سۭتۍ وفادار چھِ، تِمن سۭتۍ وفادار روزُن نیک چھُ۔
خیر، یِہِ چھُ اَکھ وَنٛہہ بَد زِ سُہ اَسہٕ پٲٹھۍ کران چھُ جَیسے سُہ کَتھِ نَہٕ گٔی آسِ۔
تِم دۄہن منز أسۍ سٲری مےٚ بھٲژن پیٹھ فخر محسوس کران۔
مےٚ چھُس زندگی منز کَتھِ نَہٕ اَتھ پٲٹھۍ تیار محسوس کٔرمت۔
اوہ، سچ؟ تُہۍ چھِو محسوس کران زِ تُہۍ سُہل کٔر؟
اوہ وٲہ، بہٕ چھُس نہٕ وۄنۍ یہِ کینہہ پٲٹھۍ ژٕنہٕمتھ۔
یہِ اوس کھۄتہٕ پاگل، بہٕ گژھُس ژٔھٹ ڈرِتھ۔
مےٚ بَرٛر چھُ ہمیشہ مےٚ سۭتۍ ژٔٹ ونان، مگر ییلہٕ سُہ ونان چھُ تیلہٕ بہٕ چھُس نہٕ کینہہ بوزان۔
اوہ تُہۍ تہٕ تُہٕنٛد سُہ بُدبُد سُوَر!
شاید یِم سٲری بٲد کٲم یم بہٕ کورموت، تِم چھِ وۄنۍ مےٚ کُن واپس یوان۔
آخرکار بہٕ او ٹِکٹ کِرٕد یوس جیک پاٹ جیت۔
مےٚ چھُس اُمید تہٕ سُہ تُہۍ صُبح جاگٲونہٕ سۭتۍ ژٕٹ بُرٕ نہٕ منن۔
یہِ چھُ کھۄتہٕ، مےٚ چھُس اُمید سُہ کرِ۔
بارٹینڈرٕ سٕے تِم مےٚ واپس دِتھ، تٕمۍ سۭتۍ بہٕ اوسُس کھۄتہٕ شُکرگُزار۔
مےٚ برتھ ڈے پارٹی کُن کۄنٛہِ نہٕ آو، تٕمۍ سۭتۍ بہٕ گژھُس گَرِ اکیلا کھاون۔
بہٕ وۄنۍ وۄنۍ مےٚ زٲنۍ ہُند بیلے شرٹ دٕہ ؤرۍ ژٕنۍ ہُند وقتہٕ پتہٕ وۄنۍ پانٛژھ ؤرۍ ژٕنۍ گژھن تام ژٕن۔
مےٚ مطلب اوس سُہ یِم خطرٕس منز گژھمتھ بلی ژٕنِتھ تہٕ مدد کور تہٕ سٲری۔
گژھِ رات بہٕ اوسُس ژٔٹ ڈران اکیلا گَرِ ژٕلان۔
یہِ اوس زبردست—یِم کٲنۍ چھِ نہٕ وۄنۍ أسۍ سۭتۍ، تِمۍ ہُند پۄران فوٹو دِتھ کھۄتہٕ قٲسم قٲسم جذبات آو۔
بہٕ سُہ نَقد پیسَن سۭتۍ کِرِد، وۄنۍ صاف اوس سُہ ژٔٹ دَوٲی وُچھن والہٕ۔
یہِ چھُ اَکھ کمالُک تَجرُبہٕ۔
یِہِ گژھِ ضرور اَکھ ژٔٹ سُہ شو۔
ڈاکٹر چھِ تٔمۍ ہُند سُہند خیال تھاوان۔
وۄنۍ، صرف اَکھ مزٕدار تفصیل وۄن۔
واہ! کیٛاہ خاص موقعہٕ اوس؟
مےٚنز کُتِس کنجیسٹِو ہارٹ فیلئر اوس تہٕ سُہ مرِو، یِمن پَتہٕ چھُس مےٚ معلوم زِ یہِ کِتھ پَزِ غمناک آسُن۔
مےٚ چھِ یِوان کَیمپِنگ کرنہٕ وریَن ہنٛد، تہٕ مےٚ چھُ نہٕ یاد زِ سُہ کِتھ آسَن۔
مےٚنز شُہٕرٕوٗلۍ چھِ ہفتہٕ ہنٛز منزٕ منٛز پٲٹھۍ پارٹی کَران۔
اَس چھِ بَچٛن ایمیوزمینٹ پارکہٕ نِوان تہٕ مےٚ چھِ کوسٹرس منز ڈر، ہاہا۔
کینہہ ہفتہٕ پٲٹھۍ گوٚو بہٕ پنُن دوستُک جنم دِنُک پارٹی منز۔
سُہ چھُ زبردست آسُن، نَہ؟
اوچ، لَگَن چھُ زِ تُہۍ چھِ دوستن سۭتۍ سچِ ورزش کَرُن پسند۔
سُہ چھُ ضروٗر بوٚڈ دلچسپ۔
مےٚ چھُ وٕنۍ یِوان محسوس کران زِ مےٚ چھُس پنُن روح گَواون تہٕ اکیلا بَنان۔
کیا چھِ تُہۍ وٕنِکی پنٛنِس ماجِس سۭتۍ روزان؟
تُہۍ ہٕنٛد محنتُک پٲٹھۍ چھُ تُہَن وقتس پٲٹھۍ پیٹھ دۄہِم ملُن گژھان۔
گیمِنگ ٹورنامٮ۪نٛٹَس گژھان۔
مےٚ چھِ کَتھِ کَتھِ نوکرِ پٲٹھۍ نہٕ کَڈنہٕ آمت تہٕ نہٕ لَیِف آف کَرنہٕ آمت۔
مےٚ چھُس سٲنۍ، سُہ چھُ اکھ وجہ۔
مےٚ چھُ نہٕ معلوم زِ سُہ پنُن کمرٕ صاف کیازِ نہٕ تھاوان۔
ہاں، مگر یِمن منز چھُس مےٚ پنٛنِس متعلق عدم تحفظ محسوس کَران۔
مےٚ چھُس بوٚڈ خوش زِ مےٚ گوٚو پنٛنِس بیٚیِس سۭتۍ کالجس منٛز ملاقات۔
راتھ گژھنس پَتہٕ انٹرسٹیٹ اوورپاسَس چھُس مےٚ گاڑِ ہٕنٛز ٹایَر پنٛکچر گوٚو، مگر اکھ اجنبی مدد کرنہٕ خٲطرٕ رُک۔
مےٚ سۭتۍ تہِ گوٚو تِمِتھ، تہٕ پَژِ مےٚ تِم دِژھُن بند کَرُن۔
مےٚ چھُس بوٚڈ اداس زِ یہِ گوٚو۔
اگلی چھٹی ہٕنٛد انتظار کران چھُس
یِمن پٲٹھۍ پنُن दोष مَتھ دِیِو
یہ چھُ صرف اَکھ میل، مگر پنٛجم جماعتک طالب علمس خٲطرٕ یہ چھُ خراب نہٕ
مےٚ ہٕنٛز گَر گژھ راتھ برُن، مےٚ پٲٹھۍ ماجہ باھر کَڈُن پٲوان
ہاں، یہ چھُ، تہٕ مےٚ خٲطرٕ چھُ نہٕ کُنہِ گائز نایٹ
ہاں، یہ گوٚو تہٕ بہٕ چھُس تُہۍ بہت شُکریہ ادا کران
گژھ راتھ مےٚ پنُن دوست رٲبطہ کٔر سَلاح خٲطرٕ
مےٚ چھُس پوری کوٗشش کران زِ یِتھ پٲٹھۍ کم پیسہ ضایع گژھِ
کاشِر اَس شہرَس منز نہٕ بلکہ گامس منز روزِو
مےٚ چھُس نہٕ وٕنۍ تَتھ متعلق سوچان تہِ یژھان
مےٚ چھُس ہمیشہ یہِ سوچان زِ بہٕ گژھِس پنٛژاہ کالہٕ ہٕنٛز سالگرٕ مناون وول یِمَن منز اکھ
ہاں، مےٚ چھُس صرف پاس گژھنُک مقصد تھاوان تہٕ دعا کران زِ یہِ کَٹھِن نہٕ گژھِ؛ یہِ چھُ استادس پٮ۪ٹھ منحصر
سُہ چھُ ہمیشہ میٚ ہُنٛد خیال تھاوان
لوٗگ یِم کینہہ گندٕ کام کران چھِ، سُہ چھِ پریشان کُن
تُہۍ گژھِو یِتھ پٲٹھۍ ژیادٕ سامان یِتھ پٲٹھۍ تُہۍ سوچان چھِو
اَسَن گۄڈٕ سٲری سامان تہٕ پنُن کُت پُڈجز کھوٚت
مےٚ پٲٹھۍ پنُن حوصلہ افزٲیی کرُن گژھِ
میٕٚژ گرل فرینڈ چھُ ماہس منز اکھ لَٹہِ پنٛنِ سہیلیٚن ساتہٕ لیڈیز نایٹَس پٲٹھۍ گژھن پسند کران
کامَس پٮ۪ٹھ گژھان مےٚ ڈٲل اکھ بٲیِسکلَس پٮ۪ٹھ کرتب کران
تُہۍ پنٛنِ حیران کُن صلاحیتھ سٕتۍ کیاہ کرِو؟
مےٚ بس یژھان چھُس زِ لوگ پنٛنۍ گژھ پنٛنۍ تامٕے تھاوٕن۔
تَمِس وقتس مےٚ بس ڈرمتھ۔
تِم کیٛاہ خلا باز بَنوو؟
مےٚ تقریباً روز تِمِس نُوٗنٛچِھ کمی محسوس کَران۔
مےٚ سٕتۍ ۱۳ ؤرۍ ہُنٛد مےٚ بِلّی مےٚ زندگِس منز سٕبزِ خۄشِی ہٕنٛد سبب اوس، وُہ اَز چھُ نَہ۔
کیٛاہ چھُ تُہۍ سٕتۍ گوٚڈٕے بایک؟
پَتھ دۄہ مےٚ بِلّی ہُند پَگاہَس پٮ۪ٹھ کٔر پوتی، مےٚ چادر پھٮ۪کۍ۔
اَز مےٚ ژھٕنِس ۳ بَجِہِ یِوُن اوس، مگر سُہ تَتھ تام نَہ آی۔
یِوان ویک اینڈ ہٕنٛد بارے مےٚ بٔڈ تَشویش چھُ۔
اَکھ وٲر مےٚ اَکھ بے گھر اَدمی دِتھ پانُن دۄپہر ہٕنٛد کھانٛہ، تِمِس تِہٕنٛد ضٔروٗرت مےٚ بہٕتر اوس۔
مےٚ کٔر فیصلہ زِ مےٚ نرسنگ سکول گژھُن چھُ تِہٕ مےٚ دٕخلہٕ مِلِتھ ہٮ۪کِہ۔
مےٚ اوس تِمِس ‘چھوٹو’ ونان چھیڑان۔
مےٚ چھُ یقین زِ اکھ دۄہ تِمِس مِلِہ۔
تِمِس نَہ اوس صبر زِ گرمی ہٕنٛز چھُٹی خٲتم گژھِ۔
شاید مےٚ یہِ غلط پَکٲو۔
مگر مےٚ نَہ ہٮ۪کان یِتھ پٲٹھۍ گژھِتھ، کازِ مےٚ کاروبارِس خٲطرٕ پَیسہٕ بچٲوُن چھُ۔
مےٚ چھُ امیٖد زِ تِمِس بہٕتر موقع مِلِہ۔
یا اَکھ زبردست خیال۔
دَفتر ہٕنٛد اوزار سٕنبٲلُن چھُ تِمِس ذمہٕوٲری۔
مےٚ چھُس پنٛنِس جیون ساتھیس سٕتۍ بٔڈ پابند۔
