مےٚ چھُس یژھان زِ تۄہہِ یِہ مشکل سٲلِتھ پار گژھِو۔
یہ چھُ بہٕت سُہ، تۄہہِ چھُس تِم صحت مند وزن تام وون۔
مےٚ چھُس صحافت پڑھاوان، مگر مےٚ ہنٛز اکھ طالب علم چھُ باہر گٔژھِتھ انٹرویو گژھاون پنُن مشن بناوان۔
تۄہہِ ہیکیو تِمِس سۭتۍ مِلنہٕ خٲطرٕ گٔژھِتھ؟
تۄہہِ چھُس مطلب سفر یَتھ کار؟
مےٚ چھُس وُنی پنٕنِہ زندگی سۭتۍ خوش۔
مےٚ ہٕنٛدِس اباہٕنِ مےٚ خٲطرٕ کینہہ سکیٹس نیبر۔
یہ چھُ سچ، مےٚ چھُس یژھان یِہ سٲریو خٲطرٕ۔
مگر مےٚ چھُس پٲک یقین زِ مےٚ کرٕ سُہ کمال۔
از مےٚ اوس اول وار اصلی اطالوی ریسٹورانٹ ہٕنٛز تجربہٕ۔
مےٚ چھُس سٲنۍ زِ مےٚ کرٕ پنٕنِس باس تہٕ ساتھیس سٲمِنٕہ سچ قبول۔
ہی دوست، مےٚ سۭتۍ وٕنۍ کینٛہہ خوفناک گٔیو۔
اقتدارس منز روزنہ خٲطرٕ تمن چھِ اکھ گژھان تہٕ کَران کینٛہہ دوٚیم۔
مےٚ چھُس خوش زِ تمن مےٚ مدد کٔرِتھ۔
گژھِتھ مانٛہ مےٚ دِژھ اکھ لایسنس ٹیسٹ، یس خٲطرٕ مےٚ گۄڈٕ محنت کرِتھ پَرُن پٲوان۔
فیس ٹایم سۭتۍ مےٚ چھُس گمان کران زِ یہِ نَہ گژھِ اَتھ بُرٕ۔
اصلن سُہ پارکِنسن پؠٹھ کٲم کران چھُ۔
یہِ جمعہ دۄہ مےٚ گژھِ معلوم۔
کیا تُہۍ کم از کم کُنہہ سۭتۍ رابطہ کرِتھ یہِ پَزِتھ کٔرِتھ کہ تُہۍ کیٛاہ بہتر کٔرِتھ ہٮ۪و؟
تُہۍ گژھِو کِنٛہہ دۄہ خٲطرٕ خَراب۔
مےٚ چھُس شرط لٲوان زِ سُہ چھُس یژھان تُہۍ گژھو پٲٹھۍ تہٕ خوش روزِو۔
تُہۍ یِمِ سۭتۍ کیٛاہ لیکھان چھِو؟
بے شک، سُہ چھِ زبردست ذٔہین تہٕ خۄبصۄرت—یہِ چھِ دۄنوں کمال کمبو۔
اوہ سچ؟ کینٛہہ کُول مٕلِتھ؟
تُہۍ نہٕ گژھِو امتحان پاس، مےٚ کیٛازِ نہٕ یژھِ تُہۍ پؠٹھ غُصہٕ؟
اُمید چھُ زِ تُہۍ ٹھیک چھِو۔
کیا سُہ اکھ منزلہ گَر ٲس؟
مےٚ چھُس پنٛنِس متعلق سچ مچ خۄش۔
مےٚ چھُس پلمبرس انتظار کران، اُمید چھُ زِ سُہ وۄنۍ مےٚ آب ٹھیک کری۔
مےٚ اصلن نہٕ اوس امریکہس منز، یِمن خٲطرٕ مےٚ چھُ نہٕ تُہۍ سٲنۍ خوشی محسوس کران، پی۔
سُہ تَتھ کینٛہہ اہم چیز اوس نہٕ۔
یہ کرنس منز کۄتہ خرچہ چھُ؟
یہ ٹی شرٹ کَس بینڈ خٲطرٕ ٲس؟
کاش یہ ژٕٹ یِتھ۔
تٔمن کٔرِ اتھہ نیک۔
مے سمجھنہٕ یِوان کِہِ اکھ یُس اَتھ عقلمند چھُ نَہ، سُہ کِتھ پٲٹھۍ اَتھ مالدار بَنِتھ۔
مےٚ ڈاڈَن کٔر سُہِ خٲطرٕ بٔہ کینہہ۔
عام طور مےٚ پریشان گژھِتھ، مگر اَسہِ رشتہٕ اَتھ سُہ گژھان چھُ کہ مےٚ چھُس اَز تہِ پابند تہٕ بےفکر۔
یہِ چھِ مےٚ ہٕنٛز بچپن یاد کَران۔
کیا تُہۍ پنٛنِس ساتھی کَرمچارِس کھۄتہٕ زیٛادٕ سمٕے پیٚٹھ تتھ کَران چھِو؟
کینہہ وقتھ پیٚٹھ مےٚ کٔر نیو سمرناہ منز کینہہ بیٚچ فشِنگ۔
مےٚ گژھِ سۄنٛتھ تُہۍ شُکریہ ادا کٔرُن۔
بچٕ یِم کِنہہ کَران چھِ، سۄ سٲری تَتھ وَقتھ شروع گژھان چھِ۔
مےٚ آو سمجھ کہ مےٚ ہٕنٛز سالگرٕ چھُٹی ٲس کَمَہِ پیٚٹھ تہٕ تَمہِ باپتھ پیسہٕ تہِ میٚل۔
کینٛہہ کٲم چھِ مُشکل۔
مےٚ اوس پنُن رۄم میٹَس بھروسہٕ کَران تہٕ پتہٕ لَگِہِ کہ سۄ اوس مےٚ سامان وُچھان۔
کیا تُہندس انشورنس منز نٔو کیئر ریپلیسمنٹ آپشن چھُ؟
یہِ مےٚ ہٕنٛز ترقی ژٕٹ اوورڈرایو منز واریاہ وٲدھاوِ۔
مےٚ چھُس ژۄنٛگن کھۄتہٕ ڈَر۔
مےٚ سۭتۍ ہٕنٛز ماجہِ چھُ کینسر تہٕ اَسہِ چھُ نَہ پتہٕ کِتھ کَتھ سمٕے سۄ ژِندٕ رہِ۔
گَژِ راتھ مےٚ سۭتۍ ہٕنٛز بستر ہٕنٛد ہیٚٹھ کھۄتہٕ کینہہ واریاہ عجیب آواز آیہِ سُنی۔
تُہۍ پنٕنِس سات دلہٕ سُکُن سٕتۍ روزِتھ ہیکِو، یِہِے چھُ اہم۔
مےٚ چھُ تَمہِ خٲطرٕ واریاہ بُراں محسوس گژھان۔
شاید دُعا کر، تہٕ ژٕ چھِ سا تُہنٛدۍ گژھان۔
مےٚ اوسُس پٲٹھۍ یِہِ احساس زِ ویک اینٛڈ گژھِ سُہ۔
کینہہ وقتس مےٚ اوسُس تَمہِ تہٕ تَمہِ بارَس منز بُرے احساس، مگر پَتہٕ مےٚ اوسُس تِمَن سٕتۍ نِبٹمُت۔
یار، مےٚ پنٛنہِ جنم دِسِس پیٚٹھ کُٹمٕن کِنٛہہ کٔر مےٚ خٲطرٕ، تُہۍ یقین نَہ کَرو۔
مےٚ چھُ اُمید زِ تُہۍ یِوان سُہ کَنٛہہ لَگِ خٲطرٕ۔
مےٚ اوسُس حَیراں زِ تِم کِتھ پٲٹھۍ ژھٲتھ ہاٹ ڈاگ کھاوان۔
کیا تُہۍ اوسِو تِمِچ ضروٗرت؟
کامہٕ گژھان مےٚ اوسُس اکھ کَمہِ رفتار ڈرٛایِورَس پٲٹھۍ پَکان۔
اگر یِہِے چھُ حال، تہٕ یِہِ چھُ افسوس، تہٕ مےٚ چھُ اتفاق۔
مےٚ ہٕنٛز گرٛینڈما دو ہفتہٕ اَگٕدٕر فوت گٔے۔
یار، گژھِم ہفتس منز کُنِہ اوسُس مےٚ ٹکر دِوان، تِمِچ وجہ سٕتۍ مےٚ اوسُس قریب قریب حادثَس منز پَکان۔
باڑہٕ سٕتۍ صحن ہُنٛد آسُن مددگار چھُ، مگر راتس مےٚ چھِ کینٛہہ چیزن ہٕنٛد فِکر۔
تہٕ تِم قصہٕ ٹٲلِو یِم تُہۍ ڈَراوان۔
یِتھ پٲٹھۍ مےٚ ہٕنٛدِس وقتس منز کانٛہہ واریاہ یِوان نَہ پٲرِتھ۔
مےٚ اوسُس ژور فَٹ دِتھ، مگر مےٚ ہُنٛد مکان مالِک چھُ نہٕ مےٚ اپارٹمنٹُک لیک گژھان نل ٹھیک کٔرمُت۔
مےٚ ہُنٛدِس اکھ قریبی دوستُک دوست اوسُس مےٚ ہُنٛدِس قریبی دوستُک بارَس منز افواہ ونان۔
مےٚ اوسُس واریاہ ڈَر گژھمُت، کیازِ مےٚ اوسُس خیال زِ سُہ چھُ مےٚ پٲٹھۍ۔
مےٚ چھُ ڈَر زِ مےٚ نزدیٖک کُنہٕ روزِتھ یِوان۔
تُہۍ کِنہہ کٕرکَس کٕژھ کٲشرۍ؟
آ، مےٚ ٹریفکَس منٛز پھنٛسُن بلکل نِہ گژھان پسند۔
مےٚ کِنہہ نَس کُس چور نِہ کٔر زندگی منز۔
مےٚ چھُس امریکہٕچ معیشت متعلق واریاہ پُرامید۔
مےٚ چھُس یقین زِ تُہۍ چھِو واریاہ عمدٕہ ساتھی تہٕ ملازم۔
تُہندِ ڈیٹَن کِنہہ ردعمل دِت؟
مےٚ کورمُتھ واریاہ مشق۔
مےٚ اوس واریاہ پُرامید زِ جیت نِہ گژھِ تہٕ کم از کم فاینلَس پٔژھٕہ، مگر نِہ پٔژھٕہ۔
تُہۍ کِنہہ اَسہِ کٕژھ ونان؟
فریشمن وٲرۍ منٛز اکھ واری مےٚ اوس دعوت مِلان اَسہِ پارٹِس، یِمِچ آواز اوس واریاہ مشکوک۔
مےٚ چھُس زندگی منٛز کِنہہ نِہ اوس اِتھ پٲٹھۍ تیار۔
نوکری تہٕ آمدنی ہٕنٛز حدس پٲٹھۍ تھوڑا۔
تُہۍ چھِو سکوٗل گژھان یا نِہ؟
مےٚ چھُس ڈیٹ نایٹَس خٲطرٕ بلکل تیار۔
مےٚنٛز دوست چھُ ہمیشہ مےٚ پٮ۪ٹھۍ سارٕ کینٛہہ حٲصِل کران۔
بیاکھ، مےٚ چھُس نِہ دٕیرِ ہنٛز فِکر، مگر چھُس واریاہ فِکر کران طوفانَس منٛز پرواز کرنس متعلق۔
مےٚ اوس گرمیٚن ہٕنٛز چھُٹِس خٲطرٕ گَر گژھمُت تہٕ مےٚنٛز ماجہ اوس روز مےٚ خٲطرٕ رٲن پکان۔
واہ، یہ چھُ واریاہ سُہ! مےٚ چھُس پُرامید زِ تُہۍ ہٕکِو یہ کٔرتھ۔
مےٚ گژھمُت مےٚنٛز پٲران کٲمٕچ جٲے۔
مےٚ چھُس خوش زِ سُہنِس چھُٹِس پَتہٕ کٲمِس پیٚٹھ واپس گژھٕنۍ۔
مےٚ چھُس جانان زِ یہِ مُشکِل چھُ۔
باخبر روزُن چھُ گۄڈٕ۔
مےٚ چھُس ژٕتھ رٲژِتھ زِ مےٚ نَہ ہیٚوک ڈزنی لینڈ گژھِتھ۔
کیا چھُو تُہۍ زیادہ تر چِکَن ہٕنٛز ڈِش پسند؟
تٔم ہٕرٛاونُک خیال مےٚ بالکل نَہ چھُند۔
پٲٹھۍ گٲڑِ رِؤرس کَران ٲس مےٚ اکھ گٲڑِ سۭتۍ ٹکر گٔمت، تہٕ دوٚیم گٲڑِ ہٕنٛز مالِک سۭتۍ گۄڈٕ گال کَرنہٕ خٲطرٕ مےٚ واریاہ دیر واتُن پَڑِ۔
تُہۍ چھِو نَہ وٕچھُن گژھِتھ۔
مےٚ نَہ ٲس خبر زِ سُہ حَملہٕ ٲس۔
مےٚ چھُس پنٛنِہ رخصتہٕ خٲطرٕ اکھ ہفتہٕ آوٕلۍ سامان پیک کٔرِتھ۔
مےٚ چھُس پَک یقین زِ سُہ اوس تُہٕنٛد وفادار دوست۔
مےٚ چھُس پنٛنِہ بیٚیِہ سۭتۍ بے شَرط محبت کَران؛ مےٚ نَہ چھُ بوزھان زِ کانٛہہ پنٛنِہ جیون ساتھی سۭتۍ کِتھ کَری دغا۔
باقی، مےٚ نَہ ٲس گژھُن تتھ۔
مےٚ چھُس کروز پؠٹھ گژھنہٕ خٲطرٕ نٲو درج کٔرِتھ۔
مےٚ چھُس پَگاہ ہفتہٕ فلایٹ پؠٹھ گژھان تہٕ مےٚ چھُ نَہ کُنہِ وِزِ جہازس منز سفر کٔرمُت۔
مےٚ ہُنٛد لایسنس اوس تقریباً پانٛژھ وُہرس آوٕلۍ ختم گومُت، تہٕ مےٚ نَہ ٲس خبر۔
مےٚ ٲس اَتھِچ کینہہ بٔڈۍ سپیکر لٲگٲومٕتۍ تہٕ تِم نِیٚتھ۔
کینہہ روٗز آوٕلۍ ہاکی کھیٚلِتھ مےٚ ہٕنٛز بلی مٔرِتھ ٲس، مےٚ اوس واریاہ دٔک۔
مےٚ اوس خوش زِ سُہ گژھان ٲس تہٕ سُہ ٹھیک چھِ یہِ پتہٕ لاگان اوس مےٚ۔
تَتھ پؠٹھ مےٚ حٲران تہٕ خوش دوٚن وۄنۍ۔
تہِ چھُ ہمیشہ بوزُن گۄڈٕ۔
کُنہِ ہٕے یہِ کِتھ کٔرِتھ ہٕیکہ؟
یہِ اَکھ واریاہ تجربہ لٕگنہٕ چھِ۔
تِمَنۍ مےٚ کالجُک سٲری خرچ دِتھ، تہٕ بہٕ ہمیشہ چاہان اوسُس کہٕ تِمَنۍ خٲطرٕ کینہہ کَرِتھ تِمُک بدلہٕ دِیُن۔
مےٚ بس یہِ پتہٕ اوس کہٕ میون پسندیدہٕ فُٹبال ٹیم سُہ کٲم کَرِ۔
یہِ ہیٚوِتھ دِل خراب گٔے، مگر تُہۍ پنٕن دوستن ہٕنٛدۍ دور کِتھ پٲٹھۍ گٔو؟
سکولہِ کُنہِ وقتُک مےٚ یاد نَہِ یُس وقت مےٚ کُنہِ بیک پیک نَہ اوس۔
بس ۹۹ مزید تہٕ بہٕ ہٮ۪کان اکھ گوٚڈ خریدِتھ۔
کِردار بُزٕرگ تنگ کُن اوس تہٕ رَنگن ہُند پیلیٹ واریاہ خراب اوس۔
مےٚ کینہہ مالی مسلہٕ اوس۔
تُہۍ کَتھ نَہِ ہٕیکِو پتہٕ لَگٕتھ زِ تِم تُہۍ پھانسناوان چھِ یا سچِچ واریاہ سَست سودا دِوان چھِ۔
مےٚ سُہ گاڑِ واریاہ پسند یِیہِ۔
آز مےٚ میٛون دٔترٕ ہٕنٛد ٹیٛچر سٕتۍ ملاقات کٔر۔
کم از کم ڈومینوز چھِ سُہ۔
تھوڑا سخت لٕگنہٕ چھِ، مگر کاروبار چھُ کاروبار۔
آز میون اول نٔو گاڑِ کٔنِتھ بہٕ واریاہ خوش اوسُس۔
دِل خراب لٕگنہٕ چھِ، اُمید چھِ زِ تُہۍ سٕتۍ یہِ گژھن ہٕنٛز کَتھ کرنہٕ خٲطرٕ کُنہِ چھُ۔
کیا تُہۍ تِمُک خیال تھاوِو؟
پانٛی یِوان اوس تہٕ أسۍ منسوخ کٔرُن پٔر۔
مےٚ تِمَنۍ پٲٹھۍ نَہِ پسند۔
مےٚ سٕہ کُنہِ پٲٹھۍ اُمید نَہ اوس۔
ژھٹ، تُہۍ چھُو ایم وی پی۔
شاید سُہ فیصلہ کرنہٕ برونٛہہ کینٛہہ ؤری کٲم کرِ۔
اگر تُہۍ کرِو یِتھ پٲٹھۍ استعمال تہٕ خیال، یہِ تُہۍ سٲری عمر چلِ۔
مےٚ ؤنٛن مےٚ چھُس یِم اکھ۔
گٲنگ کرایم چھُ روکُن ضٔروٗری۔
مےٚ چھُس شرط لٲوان، یِمن ہُند بُو اوس خراب۔
مےٚ کٲم پٮ۪ٹھ گَر ٲس آمت، تہٕ مےٚ ہُند ژھۄر اوس فرشس پٮ۪ٹھ پٲخانہٕ کران۔
زیادٕ جاینٛگ ہون چھُ ہمیشہ فایدٕ۔
یہِ ویک اینٛڈ چھِ اسہِ مےٚ ہُند ماجہِ ہُند جنم دِن پارٹی کران۔
یہِ چھُ کمال کہ انسان کِتھ پٲٹھۍ کٲم کرِتھ ہٮ۪کان۔
مےٚ اوس حیران زِ گٮ۪رٛینٛٹ تھامس جیت۔
کیا تُہۍ چھِو کُنہہ بٔڈ جایہِ ہٕنٛز ڈر؟
مےٚ ہٮ۪کانہٕ ہالووینس یوس انتظار۔
مےٚ چھُس لِوِڈی، مےٚ چھِ کانٹیکٹ لینٛس۔
اُف، کیا تُہۍ کٲنہہ سیکیورٹی کیمرہ چھُ یُس شاید یِم واقعہ ریکارڈ کٔرمتھ ہٮ۪کہٕ؟
مےٚ تہٕ مےٚ ہُند دوست چھِ جلدی واتر پارک گژھان۔
اکھ اوس دوٚیمن برونٛہہ مران، تہٕ دوٚیمن اوس اتھ اداس زِ سُہ جلدی تِم ہُند پٮ۪ٹھ گٔے۔
آ، مگر مےٚ آو نہٕ یِمن پٮ۪ٹھ یقٖین۔
مےٚ کِنہہ گنٛدٕ حادثہٕ اوس نہٕ آمُت، یِہ چھُ سُہ کٲم یُس سُہ۔
مےٚ خٲطرٕ اوس سُہ لگ بگ تبٲہی۔
مےٚن دوستَس پٲٹھۍ یقین کرُن یۄس ونان اوس ژٕنٛہہ مےٚن راز نہٕ ووتمُت
بہٕ کران چھُس ورزش، مگر سُہ چھُ اَکھ واریاہ مختلف لیولس پٮ۪ٹھ
مےٚن دوست آو تہٕ مےٚن جنم دِس خاطر کنسرٹُک جوڑ ٹکٹ انٛد
ییلہٕ مےٚن برٛونٛہہ بٮ۪مار گژھ، أسۍ نہٕ واتان اوسُس سُہ اِتھ جلدی گژھِ وُچھ
کٲفی مہینن بچت کرنہٕ پتہٕ آخرکار بہٕ ژٕ نو سمارٹ فون کٔنۍ سکتا چھُس
آ، بہٕ چھُس بلکل تباہ گژھِمُت
واہ، تُہۍ کٔرِو پنُن ڈر ژٕٹاونُک حوصلہٕ پیٚدا، تُہۍ خاطر چھُ سُہ زبردست
مےٚن بہن چھِ ہمیشہ مےٚن پیسہٕ دِتھ بٲقی
بہٕ چیٚکِتھ اوٚٹھِ جمپ کٔر، ژٕنٛہہ بہٕ سُہ ماران اوسُس
یہِ روزمرہ زندگی ہنٛز اَکھ زبردست رۄکھ بوزِ، ہے نہٕ
مےٚن چھِ اَکھ گوٚڈ نوکری، گوٚڈ گرل فرینڈ تہٕ گوٚڈ دوست
یہِ اوس اَکھ واریاہ شاندار تجربہٕ
بہٕ چھُس پٲٹھۍ اَکھ سبق سیکھمُت
آ نہٕ، سُہ کیاہ کران چھِ
ہا ہا، تُہۍ واتو چھِ ووتھ تہٕ تُہٕنٛد رشتہٕ چھُ ٹھیک ییلہٕ تُہٕنٛز بیٚی نہٕ ڈران تُہۍ چھیڑنہٕ
مےٚ آس چھِ تُہۍ کانٛہہ محفوظ جاےِ پٮ۪ٹھ رٲوان چھِو
بہٕ چھُس پنُن اکیٛاہ رٲوان تہٕ مےٚن والِدَن چھُس مےٚن خاطر ترٛیٚن مہینن ہنٛز کرایہٕ اَڈوانس دِتمُت
اَکھ دۄہ آسٹردامس منٛز اَکھ گامٕژ مےٚ لُٹنُک کوٚشش کٔر
آ تہٕ سُہ اوس مےٚن دوستن سۭتۍ گژھمتٕن گوٚڈن وقتن ہنٛز یاد دِوان
یہِ گژھِ نہٕ کانٛہہ وقت تہٕ تُہۍ گژھِو جلدی لٹکان، مےٚ چھُ یقین
یہِ تُہۍ اداس کیازان کَران؟
پَزِ دِیِکھ تُہۍ تِمِس سۭتھ وقت گژھٕو تہٕ تِمِس وٕنِو زِ یہِ ٹھیک گژھِ۔
بہٕ فالکَنٕسُک فین چھُس۔
مےٚ پَزِ پَتہٕ آس زِ بہٕ ہِسٹری ٹیسٹ کَریٖن پاس۔
تَمہِ یہِ کہ بہٕ پھِسل گٔو تہٕ سارنٕے مےٚ کُن وُچھ۔
اَز بہٕ بٔڈ خوش آسُس۔
گٔے تِمِس ژٕرِیَن وٲرَن منٛز مےٚ سۭتۍ یِہے گژھان۔
مےٚ لگٕنۍ چھِ زِ اصل منٛز تِمَن مےٚ سۭتۍ گژھِتھ آسُن یا مےٚ تِمَن سۭتۍ گژھنٕچ دعوت دِنۍ آسُن۔
سیمینار گژھِ تُہند باسَن سۭتۍ رابطہٕ کَرنُک بہترین موقع۔
کیا تُہۍ پنُن کَپڑٕ خراب کٔر؟
مےٚ چھُس یژھان زِ تِمِس بہتر محسوس گژھِ۔
یہِ چھُ بٔڈ شاباش زِ تُہۍ تیار چھِو۔
اوہ واو، یہِ چھُ اَکھ بٔڈ پھُرتِلا کُتہٕ، نیک تمنٛا۔
گٔے رات پارٹی منٛز مےٚ سٕتۍ سارٕ بئیر گٔی وِست۔
واہ، بٔڈ دلچسپ! تَمہِ تُہۍ پنُن کَتھ پٲٹھ وُچھ؟
اَسِ ہُنے ہُنے اَکھ نَو پِلاو کُتہٕ انِتھ—سَچِی پانیُک کُتہٕ۔
یہِ آسِ فِٹنس ٹیسٹ یا کیا؟
بہٕ بار بار ونان چھُس زِ مےٚ چھُس گژھُن یِژھان، مگر کَنہِ گژھان چھُس نا۔
یہِ چھُ کمال! کُن ٹیسٹ آس؟
مےٚ بٔڈ گھبراوِتھ گٔژھِس تہٕ چیٖخنٕچ شروٗع کٔر۔
سکول سائیکالوجی خٲطرٕ کاؤنسلر تعلیم
بٲدٕ نیکی ہٕنٛد کٲم نظرانداز نَہ گژھان
دوست، یہ چھِ اکھ بہتھ نیک خواہش
دُنیاہس منٛز چھِ یِمِن پٮ۪ٹھ واریاہ بہتر لوٗکھ
پُرانہ طریقہ ہٕنٛدۍ کٲم کٔرنس چھِ کینہہ مناسب فٲیدٕ
آخرکار کٔر مے اگلے مہینے خٲطرٕ فیملی ری یونین خٲطرٕ بیچس پٮ۪ٹھ ریزرویشن
آ، مے چھُس تِمَن منز اکھ زبردست تکیہ ژٕچھان، مے چھُس پنُن واریاہ وٲر پٲٹھ کران
مے چھِ یِمے مسلہ
مے چھُس خوش زِ تۄہہ نَہ کٔر زیادٕ خرچ تہِ نَہ گٔژھ قرضس منز
کیا تُہہ اوسِوُس تِم ہٕنٛد ڈرایو کٔرنس خٲطرٕ
سُہ چھِ مےٚ بیٹیَن مسلسل ونان زِ تِمَن ہُنٛد باب تہٕ مےٚ کِنہِ طریقہٕ کٲم کرُن گژھِ
آخرکار تَمہِ ترقی مِلِتھ
بہترین میوزک، سنٛیکس تہٕ ٹیلیویژن شو چھِ
مے چھُس نَہ کٲفی سخت ریپبلکن تہٕ مے چھُس تُہۍ سۭتۍ متفق
مےٚ مٕلِتھ مےٚ دادا ہُنٛد گھڑی وراثتس منز
آخرکار چھِ کُتہ تیز آواز نَہ پسند کران
یہ چھِ نہ آسان کٲم، مگر أسۍ کٔرِ تھٲو کوشش
یہ چھِ زبردست، تَمہِ خٲطرٕ چھِ سُہ نیک گژھِتھ
مےٚ چھُس پنُن کٲم وٲر شروع کران
مےٚ حالے چھوڈ مےٚ کٲم، تہٕ چھِ نَہ کانٛہہ نٔوۍ پوسٹ یُس مےٚ منز گژھِ ہٲو
میٛون کہٕنی اوس اکھ ایوارڈس خٲطرٕ نامزد۔
ٹھیک چھِ، تُہۍ کَتھ گژھِو مِسِسِپّی گومُتھ بہٕتر؟
تُہۍ کُنہِ پوسٹِ خٲطرٕ انٹرویو دِوان چھِو؟
سُہ چھُ اکھ نیک کٲشر، سُندس مُستقبل چھُ روشن۔
لَگۍ چھُ کہہ موسم گژھِ خوبصورت۔
میٛوٕ آس چھِ زِ تِم سِفت گژھن، تاکہ تُہۍ نہٕ کَرن پریشان۔
کیا تُہۍ کِنہِ وِز ٹی وی پیٹھ ریسِنگ چھِو وُچھان؟
ییلہِ تقریر دِنس وقت اوٚس، بہٕ کَریو کمال۔
ییلہِ میٛون بیٹی زٲدن اوس، میٛا اوس نہٕ وُچھُن نیند کرُن۔
لَگۍ چھُ تُہۍ سکولس مُتعلق پابند، یہِ چھُ واریاہ نیک۔
اکھ دوست اوس میٛا بارس منز گژھنس تہٕ میٛونس شریکِ حیاتس منز چھپتھ وقت گٲرنس خٲطرٕ راضی کَران۔
سُہ گژھِ واریاہ نیک۔
تُہۍ چھِ باقی ڈرایورَن ہنٛز نظر تھٲوُن۔
کئیرگِور کیاہ کَران چھُ؟
سۄن چھُ سٲری دۄہ میٛونس ژۄرس وُچھِ گژھان، تہٕ آو چھُ سچُے پریشان کَران۔
نَہ، بہٕ اوس صرف پریشان تہٕ حٲران زِ کُنہِ کِنہِ ہُہ اوس کَران۔
میٛون کوٗتر اوس ژۄن دۄہن پیٹھ لاپتہ۔
تہٕ بہٕ نہٕ وَنان یِہِ واریاہ بُڑ چھُ۔
سُہ اوس واریاہ شرمندٕ کُن۔
گژھِ دۄہ بہٕ کَڈ میٹھٕچ دوٗکانہٕ پیٹھ میٹھٕ چور کٔر۔
یہ چھُ زبردست، مگر تُہۍ کَریو
بس یی حقیقت چھِ زِ مےٚ نوکری اَز تٔہِ دَپان تہٕ سٲری کینٛہہ تُلُک زٕتھ چلان
شاید تُہۍ ہفتہٕ منز کینہہ گَھنٹہٕ خٲطرٕ کُنہِ ہٕنٛد کَمَس پٲٹھۍ رٔکھِتھ تہٕ جِم یا یوگا کٕلاس منز شٲمِل گٔژھِتھ
تُہۍ کَس چیٖزس پٮ۪ٹھ اوس کھٲران
بیرنسٹین بیئرس والہٕ، مےٚ چھِ یِہ پاگل پٲٹھۍ لٲگِتھ
اوہ، سُہ چھِ کمال، مےٚ چھِ پَتہٕ زِ سُہ چھِ تُہٕنٛدِ خٲطرٕ بٔڈ مطلب
آ، سُہ اوس مےٚ پٲٹھۍ پَہٕلۍ دَچکٲوان
اَس ہَوایِی منز رٲوان اوس
میٛون یونیورسٹی گٔیہِ خٲتمہٕ
کَل مےٚ دۄستم سٕتۍ ‘د نایٹمیئر بٕفور کرسمس’ دٕتھ تہٕ سُہ اوس مےٚ بالپن یاد دِوان
بیمٲر بچن خٲطرٕ تحفہٕ نِنہٕ مےٚ اوس بچوں ہسپتال گژھان
زیادٕ تر مالی کٲم، مُشکل سٕتۍ پَیسہٕ بَچاونہٕ
بہِ چھُس کَلان شَہر سٕتۍ مِنی چھُٹِی خٲطرٕ نِکَلان
اوہ مےٚ گاڈ، سُہ چھِ کمال
یِم نٔوِ ڈایٹہٕ منز سلاد تہٕ سینٛڈوِچ کھاونہٕ سۭتۍ چھُس مےٚ ٹھیک
گاڑِ اوس شایَد ۴۰ مایِل فی گھنٹہٕ گژھان
کیا نٔو والہٕ چھِ زیادٕ پیسہٕ دِوان
کیا سُہ اوس ٹھیک یا سُہ رۄیہِ
گَژِ رات مےٚ اوس تقریباً ۳ گَھنٹَن نیٖنٛد
کینہہ زنانہٕ وفادار نَہ وُچھان
بہٕ ہمیشہ پنٛنِس بیٚیِس سٍتۍ وٕنٛدِتھ رہٕن
بٕہہ گریجویٹ گژھنس تیار اوس، مگر اَتھ مےٚ پَتہٕ یہِ دۄبارٕ کرُن پَون
تُہۍ چھُو جانان، اکھ چیٖز چھِ یِم سُہ مزید بہتر بناوِتھ ہیکِہ
تُہۍ چھِ یِمِس پیٚٹھ تہٕ واریاہ خراب کَم کٔرِتھ ہیکان
آ، بٕہہ تَمس خٲطرٕ آئی پیڈ کٔنۍ
یِمِس خٲطرٕ تُہۍ گرفتٲر کرنٕہ یوان گژھِو
ژٕ دۄدھ نِکو، مگر مےٚ یِمِس پٲٹھۍ واریاہ خراب لٲگہٕ ہا ہا
برگر تہٕ فرایز کھٲتھ نہٕ ہیکو زنٛدٕ رہِتھ
ییلہٕ بٕہہ زنٛدگِس منٛز مُشکِلاتن سۭتۍ ژٕٹان اوس، سُہ اوس مےٚ سٍتۍ
تُہۍ چھِ پنٛنِس مقصدس کِتھ پٲٹھۍ نزدیٖک
تَتھ کینٛہہ تہِ غلط نِش
