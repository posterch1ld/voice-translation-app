نُقصان تہٕ یِم چیٖز چوری گٔے، تِم دٔسن مےٚ بالکل ٹُٹ گٔیوس۔
تُہۍ پنٛنِس دۄپہر ہٕنٛدۍ کھاون ہٕنٛدۍ بارٕ منز کانہہ لِکھِتھ اکھ سائن بناون گژھ۔
لایو منٛز یِہ چھُ وُچھِتھ زٕنٛگٕر بہترین شروعات
مےٚ بچہٕ چھِ ہر رات سُمٕتھ گژھنِس انکار کران
مےٚ خٲطرٕ اوس یِہ زِ تٔمۍ اوس یِہ پسند آمتھ
تُہٕنٛدِ والدینن اوس ضرور واریاہ فخر
مےٚ چھِ واریاہ خراب دانٛتھ
کیا تُہۍ چھِ تٔمۍ خراب کَران
اَز مےٚ آفِس منٛز زور دار پاد چھوٚڑ
مےٚ چھُ نہٕ ژٔٹھی لوٗکھ برداشت کرِتھ ہیٚکان
نا، مےٚ سٕتۍ کٔرۍ وۄنۍ
مےٚ چھُ یِہ پسند زِ تم چھِ گَرِ منٛز
یتھ مےٚ چھِ نہٕ واریاہ کینہہ یکساں آس پاسٕچ لوٗکھن سۭتۍ
یِم دۄہن منٛز چھُس مےٚ پنٕنِس باس پٮ۪ٹھ واریاہ غُصہٕ
مےٚ چھُ لگٕنۍ زِ مےٚ چھُس ناکام
سُہ اوس کٲمَس پیٚٹھ سونٛچھی گَرِ آمتھ
یِہ گوٚو مشکل بَنُن
کٕہنۍ ہٕنٛدِ سالگرٕ پٮ۪ٹھ نیٖم راتِس ہیپی برتھ ڈے گایان کدٕوٕک کھیتٕر گژھُن
مےٚ لگٕنۍ زِ ہر کُن چھِ پنٕنۍ خامیٚن
مےٚ لگٕنۍ زِ تُہۍ چھِ جوش منٛز
مےٚ چھُس یِوان زٕنٛگٕر اکھ گژھِتھ انٛدۍ خریدنِس
اُمید چھُ زِ تٔمۍ خٲطرٕ سٲری کینٛہہ ٹھیٖک گژھِ
یہ سۄنِتھ مےٚ افسوس گو، یہِ تُہند خٲطرٕ گژھان چھُ مشکل۔
کیا تہِ فونہِ پیٚٹھ آس؟
آ، یہِ چھُ واجب؛ مےٚ تہِ یِمےٚ کٲم کوٚر۔
تُہۍ استاد یا پروفیسر سۭتۍ پٔچھِتھ ہیکِو؟
بہٕ چھُس وۄٹھمُت اَز سُہٕرٕے، کِنہہ نَہ ہٕک سُتِتھ۔
سارٕے کھۄش شو گژھان چھِ ختم۔
پَتہِ دۄہ مےٚ کوٚر پروفیشنل روڈیٖوُن نظارہ۔
یہِ گوٚو سٲریو سۭتۍ، مگر سُہ فارم ہاؤس گژھِ مےٚ یاد۔
پہلِ حالَتھ کٔر مستحکم، پتہٕ کٔر باقاعدٕ بچت۔
تِم ستمبرس منز سکاٹِش رائٹ ہسپتالس منز رقص کران چھِ۔
مےٚ روٗم میٹ کانٛہہ تہِ صاف نہٕ کرِ۔
تِم فون کَور چھِ اتھۍ کھۄش نہٕ۔
کیا تُہۍ جیتِتھ پیٚٹھ خبرن منز یِو؟
مےٚ چھُس بے صبر میکسیکَن مِٹھٲیۍ آزماونُک۔
ہا ہا، سُہ شایَد تُہۍ سۭتۍ تہِ یِمےٚ کَتھ وَنِتھ۔
پَتہِ دۄہ مےٚ سُوٗر اَکھ گیت، یُس مےٚ گژھِ یاد ماضی۔
مےٚ چھُ یہِ نوکری ہٕنٛز موقعہٕ مِژمُت، مگر مےٚ نَہ چھُس ونان زِ یہِ مےٚ خٲطرٕ گژھِ موزون۔
آ بہٕ چھُس اُمید کران زِ حالَتھ گژھِ بہتَر، گرمی گژھِ ختم۔
سُہٕ ٲنِتھ ٲس اَکھ سکریپ بُک یِم سٕہِ پنٛنِے آسِہِ تیار کوٚرمُت۔
مےٚ ہٲوٕنۍ ہالینڈس منز روزان چھُ، تہٕ بہٕ چھُس یوٗکے منز روزان؛ مگر مےٚ چھُس تَمہِ پٮ۪ٹھ واریاہ بھروسہ۔
مےٚ گژھان کَل راتھ گرم چاکلیٹ پیوان تہٕ آرام سان وٲتھ کٔنۍ اَکھ شاندار فلم دِوان۔
مےٚ اگلے مہینَس خٲطرٕ انتظار نَہ کٔرتھ ہیکان۔
کیا چھُ تِمَن سٕتۍ رابطہ کرنس منز کانٛہہ بیٚیہِ طریقہ؟
تُہۍ چھِو سکولن منز کٲم کرُن یژھان؟
شاید مےٚ کٔرُن یی اَکھ اپاینٹمنٹ۔
اگر سُہ چھُ تۄہہِ سٕتۍ محبت کران، تیلہِ کانٛہہ فرق نَہ پَوان۔ مےٚ چھُ یقین زِ آخرس منز سٲری چیز ٹھیک گژھان۔
مےٚ ہٕنز گھر کلوزِنگ چھِ وُنِی جاری۔ لَگِہِ کَہِ ہفتہٕ بیٚیہِ، مگر چھُ یہِ اَسہِ لگِتھ زِ ہمیشہٕ پٲٹھۍ چَلان چھُ۔
مےٚ نَہ اوس زخمی، مگر مےٚ ہٕنٛز کار گٔی اَکھ خَرۆچ تہٕ کینہہ ڈینٹ۔
مگر یہِ چھُ سُہ واپس دِوان تہٕ اکیلاپنُک حِصہٕ چھُ پُران کران۔
نوٹ چھُ کِہِ خٲطرٕ؟
مےٚ چھُ واریاہ خوش زِ مےٚ چھُ اَب بہتر کار کٔرِتھ خریدان۔ مےٚ ہٕنٛز پرٛٲنۍ کار پٲنٛژھ مہینن منز اَکھ پَتھ دُرُست کٔرُن پَوان اوس۔
جنتس منز روزُن کِتھ پٲٹھۍ اوس؟
بوٚہ سٲری لُکھ چھِ تَمہِ سٕتۍ نَہ رٲض دِژھان۔
سُہ چھُ اَکھ پاگل قٕسمُک بَندٕ۔
ہاں، تِمَن ہٕنٛز یہِ حرکت چھِ واریاہ بُری۔
مےٚ ہٕنٛز بچہٕ گٔے کینہہ وٕرۍ سٕنٛدۍ پَہلۍ فوت۔
کیا چھُو تۄہہِ مٔلوم سُہ کُس اوس؟
تۄہہِ گژھِو یُس سُہ شخص یُسُن یہِ منصوبہٕ بنٲومُت، تَمہِ شُکریہ ادا کٔرُن۔
مےٚ کُس نٕہِ بیٚیہِ کٔہ؟
مےٚ ہٕنٛدۍ بچہٕ چھِ ونان زِ تِم فلمہٕ چھِ اَزُک فلمُک برابر نَہ گژھان۔
تُہۍ ٹھیک چھِو، یہِ جانِتھ مےٚ خوشی گٔے، کیاہ گٔیو؟
مےٚ سۄنہٕ دوست چھُ کمال۔
بہٕ چھُس یورپ گژھن وول جلدی۔
مےٚ چھُ یقین زِ غم کَڈنس منز چھِ ہمیشہ وقت لاگان۔
تُہۍ کِنہہ کٔرِتھ ہٕیکِو؟
زیادٕ چھُس مےٚ بالپن تہٕ تٔمس کینہہ حِصہٕ۔
مےٚ چھُ یقین زِ تٔمس یہِ پسند یِوان۔
تُہۍ کینٛہہ وجہہ سۭتۍ پرجوش یاہ پرجوش لگِو۔
بہٕ بدل مےٚ کارُک تھرموسٹیٹ کینہہ دۄہ چھِم گٔژھمٕت۔
کاش تٔم کرِتھ أسۍ تِمن تِمن دۄہ، مگر آو مےٚ چھُس انتظار کرُن۔
مےٚ بٔی یٔتھ بیمار گٔے تہٕ بنا کُنہہ آگاہی مر گٔے۔
مےٚ ہٕنز باتھ یِو، یہِ رامین نوڈل بنٛدن یِوان کِہنہِ دۄہ فِلے میگنُن سٹیک۔
مےٚ حیران چھُس زِ تِمن کِتھ پزِ دِژھتھ زِ گاس چھِ کَٹن واجِن، یِتھ انٛدٕرِس منز رۄزِتھ۔
کیاہ چھُ تَمہِ ہٕنٛدۍ کُنہہ سۄنہٕ وجہہ؟ مَطلب، تٔمس چھُ سۄنہٕ کم خود اعتمادی۔
کیاہ تُہۍ فلم وچھن یاہ وِڈیو گیم کھیلنُک کوشش کٔرمٕت؟
پوکر کھیلتھ کینہہ لوکھن ہٕنٛز رقم چھِم دِتھ باقی۔
آسہِ سۭتۍ گُزارمٕت مزٕ ہٕنٛز سٲری پرٛونۍ فوٹو البم وُچھنہٕ آیہِ سۄنہٕ مزٕ۔
سٔنچَرِ کیاہ گژھان؟
نَہ، تِمن سٕمٕج یہِ مزاحیہ اوس۔
مےٚ چھُس سۄچان زِ بہٕ پنُن دل خوش کران تہٕ وُچھان کُس چھُ شہرِ منز پرفارم کرنس یِوان۔
مگر یہِ واقعی اَکھ زبردست راز گژھِتھ۔
مےٚ سُہ واریاہ خراب محسوس کران، مےٚ یہِ نَہ کرُن چاہید آسن۔
گژھِتھ رات مےٚ نشہِ منز غصہٕ ہنٛد گھرَس منز واریاہ ہنگامہٕ کٔر۔
آخر یہِ بدلاؤ کِنہِ وجہہ سۭتۍ آو؟
کیا کَنہِ چیٖز تُہنٛدِ کارس پؠٹھ اٹک گٔی؟
آ، مےٚ چھُس زانان، مےٚ بار بار تٔمۍ متعلق سوچان اوس۔
مگر مےٚ نَہ گٔیوس۔
مےٚ چھُس اَز تہِ خاص طور پٲٹھۍ اَکھ پٕرٛانہِ گرل فرینڈ متعلق سوچان۔
تُہۍ مےٚ دِیِو اَکھ مثال؟
مےٚ چھُس اُمید کران زِ سُہ یٔتھ کٔرِ صحّت یِو۔
یہِ واقعی کانٛہہ نَہ سُہ احساس چھُ۔
مےٚ تہِ نَہ—تصور کٔرِو زِ اَکھن کٔر تُہۍ چَک۔
تُہۍ چھِو فُٹ بالُک واریاہ شوقین فین۔
تُہۍ کُس کتاب پَران اوسَو؟
سُہ گژھِتھ پنٛنٕنۍ دوا نَہ کھٲوان اوس یا کَنہِ کینٛہہ۔
مےٚ ہٕنٛدۍ بوزِو زِ کیا گٔیو؟ شاید مےٚ تُہۍ مدد کٔرِتھ۔
مےٚ اوس واریاہ پریشان زِ أسۍ تٔمۍ نَہ لبھِتھ۔
آ، سُہ گژھِتھ مُشکل۔
پارٹی یِہِ اَگلے ہفتہٕ، تٔمۍ کٔہ زِ سُہ یِہ یا نَہ یِہ، نَہ چھُس یقینی۔
تٔمۍ ہنٛد سطحس پؠٹھ یِوان کُنہِ وجہہ چھُ نَہ۔
مےٚ پنٛنِس کَمپیوٗٹَرُک گرافِکس کارڈ اَپگریڈ کٔرٕنچِس بارے منٛز سوچان اوس۔
کُنِہ تہِ سٕتۍ گۄڈٕنٛگ رِشتہ تھاوٕنہٕ خٲطرٕ بھروسہ چھُ اَکھ اہم سبب۔
کَتھ کَتھ رقم چھِ بٔڈ، تہٕ سا کَتھِچ کَتھِچ وقتس پٮ۪ٹھ پٮ۪سے نَہ دِوان۔
کیا تُہۍ اَسہِے بَہت سارٕ نَرٕم براوٗنی کھاد؟
کیا تُہٕنٛد باس تُہٕنٛدِس سۭتۍ ناراض اوس؟
پنٛنِس گِرل فرینٛڈ سٕتۍ ترٛےٚ وریٚن ڈیٹ کٔرِتھ تہِ سا چھِ مےٚ شادی ہُنٛد پروپوزل قبول نَہ کَران، مےٚ چھُ بَہت غُصہ۔
مےٚ چھُ پتہٕ، سُہ ضرور آسِہ بَہت مایوس کُن۔
ہا ہا، تِم چھا کُنہِ جھوٗٹ ونان اوس؟
تٔمۍ کِنہٕ قِسمُک کار لِد؟
واہ، سُہ چھُ گۄڈٕنٛگ، بَہت تازٕ تازٕ چھُ محسوس گَژھان۔
مےٚ گژھِ راتھ سٮ۪نٛٹ جوٗڈ ہُنٛد اَکھ اِنفومَرشیَل دٔچھ۔
تٔمۍ چھُ یِمِہ خٲطرٕ بَہت محنت کٔرمٕژ، تِمۍ چھِ یِمِچ حق‌دار۔
تہٕ سُہ کِتھ پٮ۪ٹھ گٔیہ؟
او یار، خاص کٔرِتھ اَکھ آلٹرنیٹِو جایہِ پٮ۪ٹھ۔
یُس طٔریٖقہٕ گژھِ تَجربہٕ، تَتھ کھۄتہٕ گۄڈٕنٛگ گَژھِ نَہ ہٮ۪کان۔
مےٚ چھِ کَتھِتام قریٖبی دوست، یِمَن سٕتۍ مےٚ چھُ نِش روزُن۔
مےٚ اوس تِمِس پٮ۪ٹھ اِتھ غُصہٕ کہ مےٚ کٔر تِمِس باقی رات پنٛنِس کمرٕ منٛز روزُن۔
مےٚ گژھِ اَکھ دوٗد کَمکٲرِس سٕتۍ ہار۔
یِمِہ قِسمُک واقعہٕ کَتھ کَتھ گژھان اوس۔
کُنہِ خاص اَڈمِس طرفہٕ آمت تحفہٕ سٕنٛد۔
آ، بہٕ وُچھمُتھ یِمَس مانٛہ ورزش شٕروٗ کٔرمُت۔ بہٕ کم اَز کم ۲۰ پاؤنٛڈ وزن کَمی کٔرنس پٲٹھۍ پٲٹھۍ پابند چھُس۔
یہہ کیلکُلس امتحان چھُ، مےٚ ۶۰ کھۄتہٕ زیادٕ نمبر ہٕنٛدۍ لٲزِ۔
ہاں، یہِ تٔم کٔرِتھ ہیکن، مگر پَگاہ یِم ضروٗر خریٖد کٔر۔
مےٚ چھِ یقین زِ تٕہۍ وٕنِہ زیادٕ دٔفعہٕ گژھِو۔
بہٕ چھُس پنٕنۍ کُٹمٕبہٕ سٕتۍ ۸۰۰ مایِل دوٗر، تہٕ تِمَن چھِ مےٚ یاد۔
