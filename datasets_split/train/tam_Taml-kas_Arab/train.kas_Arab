نَہ، یِہ چھُ مُشکل کیونکہ یِتھ تہٕ تِتھ یِوان چھِ أسۍ رَوان، تِمَن مَنٛز چھُ دوٗر۔
فریٚشَمَن وٲرسس مےٚ چھُ نَہ پَتہ زِ کیاہ آسُن، مےٚ چھُ ڈَر۔
یِہ چھِ سچٕچ سُہنٛد زِ اکھ بہترین خاندان آسُن۔
مےٚ چھِ لگٕنۍ زِ یِہ چھُ اَتھ پٮ۪ٹھ تہٕ سوچنہِ مجبوٗر کَران۔
مےٚ ہٕنٛد چھُ مقصد پنٕنۍ آخری امتحانَس منٛز بٔڈ نمبر حٲصِل کَرُن۔
بچٕہ واپس سکول گژھان چھِ، یِمن سۭتۍ مےٚ چھُ واریاہ خوشی۔
سکولس منز چھُس بہ سنجیدہ۔
واہ! مےٚ چھُس تہِ یِتھ کٔنہہ پورٕنہہ البم دِتھ، تہٕ ہر بار چھُس بہ خۄش محسوس کران۔
نیو یارک—مےٚ چھُس برٛور تَتھ رہان، سُہ چھُ ویسٹ پوٗینٹ منز پَران۔
تَمہِ کٔر مےٚ سمجھنہٕ کہ یِتھ پٲٹھۍ کرنہٕ خٲطرٕ چھُ ہمیشہ دۄیم موقع۔
ہا ہا، بہ تہِ دۄڑتھ گژھتھ۔
مےٚ کٔر پنُن پٕرٛور ای آر کُن، کیازِ سُہ اوس گژھان گٲسی۔
آج مےٚ دِتھ پنٛنِس فلیٹٕچ باہر اکھ سانپ۔ مےٚ چھِ سانپ سخت ناپسند—کِتھ گَندٕ، چھِی۔
کُٹ دِنُک وقت۔
سُہ خیال چھُس مےٚ ذہنس منز آیومٕت نَہ؛ أسۍ چھِ ۲۰ وریٚہن پیٚٹھ دوست۔
تِمَن تہِ چھُس مےٚ سۭتۍ رۄستمٕت خۄش گژھان۔
تِمَن کٔر مےٚ واریاہ ترٛقی کٔرنٕچ مدد۔
انٹرویو چھُ نہٕ کَتھِ تہِ تِتھ بُرا۔
مےٚ چھُ یقین زِ تُہۍ ہیکیو تِمِس سطحس تام واتِتھ یا تِمِس تہِ اوپر گژِتھ، کینہہ محنت کٔرِتھ۔
مےٚ سۭتۍ پٲٹھۍ بَنِو تہٕ بس تِم خرٛید کٔریو؛ یَلہِ کٲنٛہہ بیٚیہِ کٲم کٔرِ، چھُ سَہل۔
بِچٲری کِٹی، چھُس امید کران زِ سُہ ژٕٹ صحتیاب گژھِ۔
مےٚ چھُس پنُن پہلین کیج فائٹ گژھان۔
مےٚ اوس پارکس منز دۄڑان تہٕ کیلس چھلکِس پٮ۪ٹھ گژھِتھ پٔتم۔
ہاں، آگ روٗکنُک چھُ نہٕ تِتھ مُشکل آسُن۔
یِہ چھُ کمال زِ یِتھ مٔہ مےٚ کِتھ پَیسہٕ ژٕٹ بچاو، یَلہِ مےٚ دِیہِ پورٕ دھیان۔
یہِ مایوس کُن لگٕان، مگر مےٚ خوشی چھِ زِ تُہہِ ہاو نَو جایہٕ مِلِتھ یُس تُہہِ شایَد پسند یِوان۔
مےٚ سچ ٲس، مگر تِم اَتھ پٮ۪ٹھ نارإض ٲس، یِمن سۭتۍ مےٚ خراب لٲگِتھ۔
یہِ چھِ خراب۔ کیا تِم صِرف زیاتھ پرٛٮ۪ٹھ یا کیا گژھ؟
مےٚ یقین نَہ یِوان زِ مےٚ مکان مالِکَن اَز تَتھ مےٚ سٹوٗ ٹھیک نَہ کوٚرمُت۔
مےٚ چھُس تِمِس خٲطرٕ خوش۔
یِلہِ تُہہِ تِمِس قٕسمٕچ سروس یِوان دستیاب، تُہہِ چھِو تِمِس خٲطرٕ ہمیشہ شکرگُزار۔
مےٚ چھِ خیال زِ اُستاد تُہٕند گژھِتھ نہٕ یژھان ٲس۔
آ، مےٚ ٲس بے حد غصہ یَتھ زِ تِمَن ہٮ۪کؠ تِہِ کوٚشش کٔر تِمِس گژھِتھ۔
تِم چھِ نہٕ یِوان سٕمٕج تہٕ تِم چھِ نَہ کینہہ کھٲن، مگر ٹُکرٕ ضایع کران۔
مےٚ کرٕنۍ پٲٹھۍ کوٗشش۔
مےٚ کٔر درخواست اکھ نوکری خٲطرٕ یۄس مےٚ وٕنہِ تِمِس لٲیق نَہ ٲس، تہٕ آخر مےٚ مِل انٹرویو۔
اُمید چھِ زِ تُہہِ تِمَن ہٕنٛدِ خٲطرٕ واریاہ ژھٕٹ جاگِتھ پنٕنۍ نیند خراب نہٕ کٔرِو۔
کیا تِم تُہہِ لَگٕنۍ آو؟
اَسہِ سٲریَن چھِ واریاہ ورزش ضروٗری۔
یہِ چھِ سَہل کام، مگر کَتھ کَتھ چھِ تِمِس بُوٗ سٲری گَندی۔
مےٚ چھِ افسوس زِ تُہہِ بَد تجربہ گژھ۔
کل رات مےٚ شوٗرَن مےٚ دِلٕچ دورٕ یِوان کٔر۔
مےٚ کرٛانہٕ دُکانٕچ سۭتۍ زیادہ رش آسِتھ گلی منز پنٕنٮ۪ن زٕن پٲدَن ہٕنٛز ٹَکر سۭتۍ لُڑِتھ۔
پِٹ سٹاپ ہٮ۪کان مزٕدار۔
مےٚ دوستَن رضامندی سۭتۍ کام کوٚر تہٕ پیسہٕ دِتھ ہٕنٛز درخواست تہِ نہٕ کٔر۔
کیا یہ کِہنٛہ ٹھیک گٔژھ؟ یہ چھُ سَخت خراب لٕگن۔
مےٚ چھُ نہٕ یقین یِوان زِ میون دوستُک میٚہِ پؠٹھ گٔیہ منگنی۔
مٔنٛزِرِی لوٗکھن ہُند چھِ نہٕ اَکھ تہِ سُہ دوست۔
آو مےٚ چھِ تِم خۄب یاد یِوان۔
یہِ چھُ نہٕ پٲٹھِم دفعہ۔
مینوڈو، پوسولے یا تمالیس سٕنٛد یِم، بہٕ یِم صرف ‘بامب فوڈ’ وَنان، کیازِ سٲریَن چھِ یہِ پسند۔
پَتہِ دۄہ مےٚ پنٛنِہ گرل فرینڈس منگنی ہُند پرپوز کٔر، تہٕ تٔمۍ ہاں وون۔
مثبَت روٗز تہٕ کوشش کٔر زِ تُہٕنٛدِ ضروٗری جواب مِلی۔
مےٚ چھُ یقین زِ تٔمۍ پنٛنٮ۪ن کٔرِتھ چھِ اَسہِ پٲٹھِم کینہہ کٔرمُت۔
کیازِ اَسہِ کوٚر بٔہ کام۔
مےٚ چھُ فخرٕ سٕنٛد پٲٹھۍ بَھرِتھ۔
میٚنٛزِر سٲری دوست چھِ کالج گٔمتۍ۔
کیا یہِ ویڈیو مَنٛز ریکارڈ گٔژھ ہُہا؟
یَلہِ بہٕ پنٛنٮ۪ن دوستن نَو جوتہٕ یا نَو کَپڑہٕ پٲٹھۍ وُچھان، مےٚ گژھان بٔہ خراب۔
میون بھٕتیجی چھِ مےٚ کَن اکثر یِوان۔
تُہٕنٛدِ ہیمسٹرُک ناو کِیاہ آس؟
میون ذٲتی پسنٛد چھُ بین اینٛڈ جیریز فِش فوٗڈ۔
اگر تَمی چھِ، تِلہِ مےٚ چھِ نَو گاڑِ ضروٗرت تہٕ آو یہِ کرُن چھُ مُشکل۔
سُہ ٲس بٔہ مزٕ، کاش مےٚ ہٮ۪کہِ تِمن دۄہن منٛز واپس گژھِتھ۔
مےٚ ٲس پیسَنٛ ہُند ضروٗرت تہٕ میٚنٛزِ دوستن کٔر مےٚ دِیُن اوٚتھ پیسہٕ ییٚتھ مےٚ ٲس ضروٗرت۔
یا صحن چھُ بہت وٕد؟
مےٚ پارٹنر نِش فیصلہ کٔر کہِ وُن ہفتہٕ خٲطرٕ شہرٕ باہر رۄزٕنۍ پنٕنۍ والدینن ہٕنٛز ملاقات کرن۔
مےٚ ڈر اوس کہِ بِگ فُٹ کَرِ مےٚ ژٕندٕچ کھال اُتار۔
مےٚ کٲم کرن وٲلۍ ساتھی چھِ یِتھ جاے ہٕنٛز واریاہ تعریف کران۔
بہٕ چھُس تِمۍ سیزن خٲطرٕ گژھِتھ ہٮ۪کان۔
ٹریفک منٛز کٔسِہ کٔر مےٚ سۭتۍ کٹ۔
سۄ اوس اکھ واریاہ مضبوط تہٕ عزت دار زن۔
بہٕ چھُس نَہ دوستن سۭتۍ واریاہ وقت گزاران۔
مےٚ چھُ یاد، سکولہٕ پٮ۪ٹھ گَرِ تام پٮ۪ٹھ گژھنہٕ خٲطرٕ گھنٹن ہٕنٛز پیدل چلان پَران اوس۔
شاید یہِ کینٛہہ وجہہِ خٲطرٕ گوٚو۔
یہِ اوس اکھ واریاہ نیک اشارہ۔
آخرکار تُہۍ پَتہٕ سُہتر محسوس کرِو۔
مےٚ دِژ زخمی بُوم پناہ تہٕ کٔر تِمٕچ خدمت، صحتیاب گژھنہٕ پتہٕ کٔر آزاد۔
یِم دۄہ مےٚ پنٕنۍ بچہٕ زامٕتۍ۔
بہٕ چھُس ساوتھ فلوریڈا منٛز رۄزان، یِم چھُ نَہ واریاہ دوٗر۔
آ سۄ چھُ تُہٕنٛدِس واریاہ ذاتی آزادی تہٕ تُہۍ چھِو یِژھ کرِتھ ہٮ۪کان یِژھ تُہۍ چاہو۔
تِمۍ شینن بدل کرُن چھُ واریاہ مُشکِل۔
سُہ یی سیکھِ زِ کَن نہٕ سٕرنہٕ ہٕنٛز سزا ہٮ۪وان۔
یہِ اوس واریاہ بُرا، تُہۍ کُنہہ پتا نہٕ اوس کہِ یہِ یِوان چھُ۔
مےٚ کٕہہ پرواہ نَہ۔
یہ چھِ اکھ خوفناک چیز، خاص کر یَلہٕ تِم تُہۍ أسۍ درست کرنہٕ خٲطرٕ پیٹھ پیسہٕ دِوان۔
مےٚنۍ ساتھی چھُ کٲم خٲطرٕ لمبہِ وَختَس مُلک بٲہر رَہان۔
بیٖر گژھِتھ مےٚ پنٛنٕنۍ برونٛہہ ہٕنٛز والٹ پٮ۪ٹھ پیسہٕ کٕڈ۔
مےٚ اُمید چھِ تِہٕ چھُ۔ کیا تُہۍ ہٕنٛز کٲنٛہہ مٕزاحیہ تجربہٕ چھُ یِمن خراب تجربن منز؟
اَکھ وَنٛہہ والمٲرٹَس منز مےٚ پنٛٹَس منز پٲخٕن کٔر۔
مےٚ ژےٚ ٹایر ہمیشہ گژھِتھ یژھان اوس، سُہ کٔرۍ حٲصل؛ سُہ اوس مہنگہٕ، مگر قٲبلِ قدر۔
بہتر زندگی ساتھی مٕلُن چھُ مُشکل۔
مےٚ دُنیاہِ ہِنٛز کٲنٛہہ فِکر نَہ چھُ۔
مےٚ چھُ دوہہ مہینن پیٹھ پنٛنِس پڑوسِ ہُنٛد اِنٹرنیٹ چور کران۔
کینہہ والِدین چھِ واریاہ خوش نصیب۔
تِمن ہٕنٛد ہر اکھ ۴ ؤرۍ خٲطرٕ۔
بنیادی طور پٲٹھۍ، تِمن کَرُن پَڑِ ہجرت۔
تَتھ پٮ۪ٹھ کٲنٛہہ خاص نَہ کٔرِتھ ہٮ۪و۔
مُلکَس چھِ میکسیکو سٕتۍ بارڈر وال ضرورت، تہٕ ڈِم چھِ قرارداد روکاں۔
کٲنٛہہ رقم نَہ ہٮ۪کِ سُہ جایہٕ پٲٹھۍ یِتھ۔
مےٚ اوس سوچان—مےٚ کینٛہہ وَخت پٮ۪ٹھ پنٛنہِ کارڈ استعمال نَہ کٔر، مگر بٔڈ نمبر اوس اَز تَمہِ جایہِ۔
مےٚ کمپیوٹر بدلِتھ یا تَس پٮ۪ٹھ پٲچھِتھ یِم سُہ اَز تَتھ سونہٕ مٕلِتھ چھِ یا نَہ۔
مےٚ بلکل جانان چھُ تُہۍ کِژھ محسوس کران۔
مےٚ شرط لَگان چھُ تُہۍ ہٕنٛز والِدین چھِ فخر کران۔
نَہ، سُہ سچِ کوشش کران چھُ۔
مےٚ چھُس جانان تُہۍ کیاہ وَنان، مےٚ تہِ چھُس سٲری سٲری شرمیلا۔
کَتھۍ تہِ نَہ میٚوٚس اَتھ پٲٹھۍ تیار۔
مےٚ منزِ ہٕنٛدِ ماجہِ پنُن ظٲلِم بوٚای فرینڈ چھوٚڑِتھ دوٚبارٕ کھٲتہٕ پیٚٹھ کھوٚر۔
مےٚ چھُس گژھان، مےٚ روزِ جِیوِت۔
تُہۍ ہاو حَوُس جوش مَنٛز۔
اَز مےٚ کھایِتھ ڈایِٹہِ ہٕنٛز باہَرُک کھانوٕ۔
اَز میٚونٛ کُتُرَن میٚونٛ جوتہِ مَنٛز پوٗپ کٔر۔
اَسہِ ٹیمہِ ہٕنٛدِ اَکہِ پروجیکٹُک ٹایم لاین آس تیز کَرنہٕ آمُت۔
مےٚ چھُس شرط لَگان، اَگر تُہۍ کینٛہہ وَنِو اَتھ مُتعلِق تُہۍ تہِ بَد گژھِو۔
سُہ چھُ اَکھ واریاہ گوٚڈ کھیل۔
تُہۍ گژھان آسِو جوش مَنٛز تہٕ فخر تہِ۔
تِم کَرِ کیاہ گژھان؟
مےٚ چھُس جانان، سُہ سوچِتھ چھُس مےٚ واریاہ دٔرد گژھان۔
کیاہ سُہ چھُ سُہ واریاہ کَران؟
تِمَن چھُ دوٚپ آن لاین یِہ تِم ہاٹ فَز ہُنٛد سیٚکُوٚل نہٕ بَناوان۔
سُہ کَتھ پٲٹھۍ گژھ؟
پنٛنٕنۍ اکیٚلا روزُن آس واریاہ عجیب۔
واہ، تُہۍ گژھِو حاوُس پنٕنِس برادَر ہُند۔
تِم چھِ کَران، بس یِہ چھُ سنٛبھالِتھ تھاوُن۔
میٚونٛ پسندیدہ چانہِ ہُند کپ ٹوٗٹ گٔیو۔
مےٚ چھُ اکھ ریچھ پَتھ لَگُن۔
مےٚ چھُ نہٕ کٔدٕچ گٔمُت، تَمن چھُس بہٕ تَمہِ خٲطرٕ کٲفی پریشان۔
