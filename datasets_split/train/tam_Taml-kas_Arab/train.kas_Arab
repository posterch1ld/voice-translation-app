مےٚ کَتھ نہٕ دِتم جواب، مگر سُہ اَکھ مرد اوس تہٕ کینہِ قٕسمُک کامُک یونیفارم نہٕ پیٚران اوس۔
شاید پروفیسرن کٔر گریڈ وُچھِتھ، یا شاید چھُس مےٚ بس بےحد خوش قسمت۔
مےٚ ؤنۍ زانان کہ مصروف ویک اینڈس منز میٛونۍ کُنہِ فُرصت نہٕ گژھِ۔
اوہ مےٚ خدایہِ، یہِ چھُ تِمن واریاہ خراب بناوان۔
واہ، مےٚ سۭتۍ چھُس میٛونۍ تہِ پسند۔
کیا تُہۍ سۭتۍ پَڑِ انتظار کرُن واریاہ وقت یِتھ حٲصل کرنہٕ خٲطر؟
آ، یہِ اوس واریاہ آرام دہ۔ مےٚ کٔر آرام میٛونۍ گرل فرینڈ سۭتۍ تہٕ وُچھ واریاہ نیٹفلکس۔
میٛونۍ چھُس اَز واریاہ کامیاب محسوس کران۔
اچانک میٛونۍ لایٹ بل گٔے ۱۵۰ پیٚٹھ ۳۹۸ روپیٚن مہینَس۔
مگر واریاہ رولر کوسٹرن کٔر مےٚ بےچین۔
پنٛنِس دوستن سۭتۍ روز چھُ سُہل تہٕ آرام دہ محسوس گژھان۔
میٛونۍ گٔے سُہ کام ہارُن یُس مےٚ یژھان اوس۔
مگر واریاہ خاطر یا کانہہ چیز خٲطرٕ فی الحال پیسہ جمع کٔر نہٕ رَس تھا۔
یہِ پٲٹھ چھُہ پہل یارٕ زِ سُہ سٹاربکس گفٹ کارڈ سٕتۍ بٔڑ کینہہ حٲصل کٔرِتھ اہل چھُ۔
مےٚ کَل بوٗز ژٕ جَنک فوٗڈ خرٕید۔
تُہۍ سُہ ڈر سامنہٕ کٔرِتھ یِم کٔر، یہِ چھِ واریاہ بٲدری۔
وُنی مےٚ سَمجھ آو۔
شُکریہ، کَتھ کَتھ مےٚ یِژھان زِ یہِ اَتھ نایاب چیز نہٕ بَنِتھ۔
مےٚ وَنٕنۍ چھُہ گَرٕم پانین سٕتۍ تہٕ ڈیگریزر سٕتۍ۔
مےٚ چھُہ خوش زِ تُہۍ تِم رِپورٹ کٔر۔
مےٚ چھُس اُمید زِ کینہہ ژٕٹ بدلِہ۔
مےٚ کانہہ آرڈر نہٕ کٔر؛ رَسوٗی کھۄتھ نِکلِتھ اَکھ چُھوہٕ مےٚ موتھ ڈراو۔
مےٚ چھُس یِمن سٕتۍ اَکھ بہتر زندگی خٲطرٕ اُمید کران۔
واہ، سُہ کانہہ ٹھیٖک آس؟
ٹھیٖک، مےٚ چھُس یقین زِ تُہۍ تِم حقدار آسِو۔
مےٚ بلیو اینجلز لایِو نِرِکھ۔
آج کل ایمانداری چھِ واریاہ نایاب۔
اَسہِ اَکھ اَسایِنمٮ۪نٛٹ اوس تہٕ مےٚ کِتابٕچ پٲٹھۍ کینہہ جواب لبھ۔
مےٚ چھُس سَمجھان زِ مےٚ چھِ صرف واریاہ شُکریہ گُزار بَنُن۔
آج ژٕنٛدِ موٗڈ سُہ نَہ چھُ، مگر کَتھ کَتھ مےٚ چھُس مثبت محسوس کران۔
آ، لوٗکھ چھِ آرام سان بَنان یَتھ گژھِ نَہ پسند۔
نَہ، مگر مےٚ اوس تِہ ژٕٹ صاف کٔرُن پٲوان یَتھ مےٚ ماوُن پَتہٕ لَگِتھ۔
تہنٛدِ مسئلہٕ چھُ اَز تہِ جاری، تہٕ یِم باہہ یُس زخمی گٔے آسہِ، سَگہِ ہٕنٛدۍ گَژھِ کھوٗرُن—تہٕ أسۍ سٲری تَمہِ کَتھِ سۭتۍ دِل شِکستہٕ چھِ۔
او یار، تِہ نٲو سِرف کَہنہٕ سۭتۍ مےٚ پَتہٕ پَتہٕ یاد آوُن۔
مےٚ چھُ خوش کہ ہفتہٕک آخری ویک اینڈ چھُ نزدیٖک آمت۔
مےٚ چھُ لگُن زِ سُہ چھِ یِمچِ حقدار۔
میٛون پٕترُن اَز پنٛنہِ پٲٹھۍ پہل قدم ووت۔
سرکاری نوکری حاصل کرنہٕ خٲطرٕ چھُ صرف اَکھ قدم باقی۔
کَتھِ کَتھِ چھُ نہٕ أسۍ تِہ کَتھِ۔
مےٚ چھُ خیال، أسۍ وُچھو۔
کیا مخالِف ٹیم حَقیٖقتن بوٗز کَٹھِ تھِ؟
مےٚ چھُ خوش زِ تُہٕنٛدِ کینٛہہ مدد گٔے۔
یِتھ دۄہ مےٚ پنٛنِ ڈِگری خٲطرٕ یونیورسٹی منز درخواست دِژ۔
یَتھ کَتھِ سۭتۍ سُہ پیکیج کینہہ دۄہ خٲطرٕ گم کَرن، تَتھ چھُ حال اَز تہِ خراب۔
اَضافی 100 سۭتۍ مےٚ کِنہِ کَرُن اوس نہٕ پَتہٕ۔
مےٚ چھُ نہٕ پَتہٕ زِ مےٚ یِم کِتھ پٲٹھۍ تٲم کٔر۔
اَکھ بوتل واین سۭتۍ۔
یِہ چھُ سَچ، مگر اگر کُنہِ پولیس وَلا تُہٕنٛدۍ روٗکُن ہٕنٛزِ فیصلہٕ کَرِ، تَہٕ یِہ چھُ نہٕ سُہ نِشٲنۍ۔
کامہِ گژھن وٲلِس سٲری سفرس منز مےٚ بوٗز فِکرمند آسِ زِ مےٚ دیر گژھِ۔
آ، مےٚ یِہ پَرِتھ تہٕ مےٚ بوٗز زٕبردست متاثر۔
بِلکُل، مےٚ ہٕنٛزِ نہٕ تصوٗر کَرِتھ زِ اَکھ دوست مےٚ سۭتۍ دَغا کَرِ۔
سُہ تھِ اَکھ بوٗز بَرٕی گٲنہٕ وٲلۍ۔
بہٕ دوبارٕ بَچٕ بنُن ژٕچھان۔
تُہۍ حِسابس منز گوٚو اچھا؟
بہٕ پنُن زَنہِ سَتۍ وادٕ کٔرِتھ کِہ شراب نہٕ پیٖو، مگر پیٖتم۔
کِنہہ کَم اَسہِ یاد چھُس تِہ سُہ کَتھ دِسَان چھُ؟
یِتھ کَنہہ لوکل ژور لڑان وَل چھِ۔
یہِ چھُ سُہ، قسمت چھِ تِمَن ہِند ساتھ دِوان یِم تیار چھِ۔
بہٕ کینہہ وقت خٲطرٕ پنٕنۍ طرف دھیان دِتھ ہیکان۔
مےٚ کَنہِ منز چھُ مسئلہٕ، تہٕ اکھ ساتھی چھُ نہٕ روزان بند کَران مزاق یِم طریٖقہٕ سان بہٕ ژَلان چھُس۔
بہٕ ہساں ہساں اوسُس پنٕنہِ دوستَس سۭتۍ میراتھن ژَلان۔
بہٕ ضرور وٕنٛدٕر انٹرنیٹَس پٮ۪ٹھ گژھِتھ یِم متعلق پَرھٕنۍ؛ مےٚ چھُ اسپایڈرمین پسند۔
مےٚ ۲۱ ویں سالگرٕ پٮ۪ٹھ مےٚ دوستن کٔر مےٚ خٲطرٕ اَکھ اچانک پارٹی۔
دَمہٕ، مےٚ یقین نِہ یِوان زِ مےٚ نہٕ شُر۔
یہِ چھُ واقعی خاص تہٕ ذاتی سُہان۔
سکول بس عین وقتس پٮ۪ٹھ ٲی تہٕ ڈرایورَن کٔر مےٚ مدد۔
کینٛہہ لوکھن چھِ ضرورت بنیادی اِنسانیتچ سبقن ہُند۔
مےٚ یہِ خٲطرٕ گوٚو محنت کٔر۔
واہ، مےٚ خیال چھُ زِ کانہہ دۄہ بہٕ تُہۍ سۭتۍ کھیٚلِتھ پسند کَران۔
بہٕ ہمیشہ پنٕنۍ ماجہِ سۭتۍ وُنان اوسُس زِ گلیارٕچ لایٹ روشن تھاو۔
اوہ دَمہٕ، مےٚ چھِ تمن انفومرشلس سۭتۍ واقعی پسند؛ مےٚ اوس ژٕچھان زِ یِم چیٖز کَتھ کَنہہ کَم کَران چھِ۔
آب مےٚ پٮ۪ٹھ چھُ یہِ لُکاوُن۔
یہ سٲری رات باہر ٲس تہِ بہت ڈرٕاون ٲس
کیا یتھ سۭتۍ تُہۍ کٕمَس منز کُنہِ قِسمچ مُشکل پیٖٹھ
زِ کِہ مےٚ پنُن کٲم ژٕٹھیو
مےٚ امیٖد چھُس تُہٕنٛدۍ گژھِس ٹھیک ٲسۍ
مےٚ چھُ نہٕ کُنہِ ہٕنٛدٕس لبنَس منز قسمت
کیا تُہۍ بیگس منز تھاونہٕ برونٛہہ پنٕنۍ ژٕٹھی چیزٕ نَہ اوس پَرانۍ طریٖقَس سۭتۍ چیک کران
مےٚ چھُنہٕ کَتِہِ پٮ۪نٛٹَس منز پیشاب کَران
ہاں، اگر سُہِ ہٕکِس یہ کھٲتھ، تَہ یہ مُفت ٲس تہِ تَس اکھ ٹی شرٹ مٕلِتھ
یہِ چھُ عام طور پٲٹھۍ تھوڑا ناممکن، مگر مےٚ چھُس تُہٕنٛدِس حقس منز
مےٚ چھُس واریاہ کٕنی اداس گژھان
مےٚ چھُس ژٕٹہِ ژٕٹہِ گژھان، یہِ سُنٛنہٕ خٲطرٕ زِ مےٚ کیاہ چھُ بَناوْمُت
مےٚ چھُس واریاہ معذرت خواہ، مےٚ ہٕکو نہٕ یِہ تصور کٔرتھ
تَمہِ ٲس زِندگی واریاہ سادٕ
پَتہٕ دۄہ مےٚ یہِ لٲگ تہِ مےٚ اوس ہٕکٕن پنُن پسندیدہ گٲنٛہہ بَجاوِتھ
مےٚ چھُس پنٕنِس بٲیِس ہمٕشہٕ تِمِس نٲوٕ سۭتۍ کانٛہہ
مےٚ سٲنۍ زِ بِگ فُٹ کٔرِ مےٚ ژٕنٛدٕچ کھال ژٕٹھی
مےٚنٛز کٲم چھُ یِمِچ کِنٛہہ حِصہٕ فَنانس کَران
تُہۍ چھِو فَقَط مُثبَت رۄزُن
ہاں، گژھن وٲلۍ ہرِ ؤری ٲس مُشکل، مگر مےٚ حٲصِل کٔر یہِ ڈِگری یار
گَرٕچ قَرضہٕ چھُ فٕٹمُت، کٲم تہِ چھُ سَریٖوِ سۭتۍ چَلان
یہِ چھُ پولیسس یا سبوے ہُند ذمہ دار لوٗکھن دِتھ آؤ۔
نَہ، مےٚ چھُ گژھان سُہ فَقَط شرارت کَران آس، مگر تَمہِ پٲٹھۍ۔
مےٚ چھُس تہِ کِتھ پٲٹھۍ نَرْوَس۔
مےٚ کَنہہ تہِ کِسہِ چیٖزُک فُرِی ٹکٹ نَہ حٲصل گژھ۔
اوہ، سُہ چھُ بہٕ ژٕوٗر وقت پَتھ۔
مےٚ ٲسُس تَمہِ سٕتۍ واریاہ نیٖڈ۔
پرٛیٖزینٹیشن ٲس تِم نَوِ کلاینٹِس مُتَعَلِق یِم أسۍ حالٕے حٲصِل کٔر۔
تُہۍ کِس قِسمُک کوکیز بَنٲو؟
یِم سٲری ٹرینِنگ پَتہٕ تہِ مےٚ چھُس نَہ کَنہہ اَپُن زٲن کٲمَہِ آوُن۔
کَنہہ کَنہہ گژھرِتھ دۄر دۄر نَظَر کَرُن چھُ ذٲتی غور فِکرِ خٲطرٕ واریاہ مُفیٖد۔
تُہۍ کِیا اوبَر ژٕٹِھ ہیکِو؟
پُرانۍ وٮ۪سٹَرٕن فلمہٕ دٮ۪کھنٕہ سۭتۍ مےٚ یِوان اَپٕن دٲدٕ دٲدِچِ واریاہ خۄش یاد۔
خاص کٔرِتھ یُس تُہٕنٛدِس دوستَس بَچّہٕ آسَن۔
تُہۍ کَتھٕ کُن مُوٗو کَرٕنُک اِنتظار کَران چھِو؟
مےٚ نَہ ٲسِہ وقت یِمِس سۭتۍ مےٚ ہٮ۪کہِ آرام کٔرِتھ فلایٹِس پَتہٕ وِوٲہِس پٮ۪ٹھ۔
کِیا تُہۍ تِمَن کُنٛہہ باہَر نِتھ؟
مٕژ دوستَس مٕلۍ کَنہہ نَوِ جَیکِٹ، مےٚ نَہ مٕل کُنہہ تہِ۔
ہاں، چھُ احتیاط کَرُن تہٕ تِمَن دِیُن تِمَن ہُنٛد جٲے۔
تِم وُچھِتھ بَنَن زِیادٕ اماندار تہٕ عزت دار۔
کِیا تُہۍ تِمَن اَسہِ خٲطرٕ سزا دِوان چھِو؟
بہٕ عام طور پٲٹھۍ یِتھ کُنہِ ہُند پَتہٕ پَتہٕ گژھان، تہٕ آخرس منز مےٚ برونٛہہ تِم گژھن روٗکان۔
تِمِس عُمرِس منز تہِ یہِ واریاہ مُشکل چھُ۔
سُہ کِتاب چھُ مےٚ پسندیدہ مُصنفن لٲکھمُت۔
نَہ، مےٚ صرف ویک اینڈَس کُنہِ کٲمٕچ خٲطرٕ اَکھ کٲر ضروٗرت ٲس، تہٕ تِمن مہربٲنی کٔرِتھ مےٚ سٕتۍ سُہ اُدھار دِتھ۔
اَز راتھ مےٚ تھوڑا بےچین محسوس کران۔
یِمنہِ خٲطرٕ زِ مےٚ ہٕنٛد کُتُر گژھِ گھرٕ منٛز باتھ‌روم استعمال کٔرِتھ، بہٕ چھُس گھرٕ منٛز پَپی پیڈ استعمال کران۔
رامن، تُہۍ ضرور کالجس منز پَرھان چھِو۔
سکوٗلِس منز بہٕ کَتھٕچ نَہ ٲسٕس حسابس منز تیز۔
تِم ہٕنٛد آسُن چھُ واریاہ فٲیدٕمَنٛد۔
مےٚ چھُس تُہۍ ہٕنٛد حال سمجھان، کیازِ بہٕ تہِ گٔوم اَکھ نَنُن ٹاؤن یتھ جابہٕ کَم ٲس۔
مےٚ چھُس واریاہ اکیلا محسوس کران کیازِ مےٚ ہٕنٛد مٲنُس چھُ علاج خٲطرٕ دور، مگر یہِ چھُ ضروری۔
مےٚ ٲس اَکھ سُہُن احساس۔
مےٚ ہٕنٛد کُنٛبہٕ دور دورِ پٲٹھۍ جمع کرنس خٲطرٕ یہِ چھُ سُہان وقت۔
یہِ کِنِہِ قٕسمُچ نوکری چھِ؟
آخر کِیا گژھ؟
کیا یہِ تُہۍ یا تُہۍ ہٕنٛد بچہِ خٲطرٕ نَو سکول وار چھُ؟
اَچھا، یِلہٕ بہٕ لیگ آف لیجنڈز کھیڈنس گژھان تہٕ آسان ٹیم خلاف یِم مےٚ ہُند وار۔
واہ، سُہ چھُ واریاہ خراب۔ مےٚ چھُ امید زِ سُہ ٲس سُہ واقعہ گژھن برونٛہہ دٕرٛاز عُمر گژھان۔
سُہ چھُ لگن زِ یُس چھُ واریاہ کٲم۔
یِلہٕ مےٚ والِدٕین دۄنٛۍ تہِ اَکھ وریَس منز اَکھ پَتھ اَکھ گژھِ، تَلہٕ مےٚ تِم ضایہٕ کٔر
مےٚ چھُس سوچان زِ اَکھ کیڑٕ مارُن والٕ کٔرٕ رکھُن
مےٚ چھُس وٕریا خوش زِ چھُ کھانٕہ دیگ منز تہٕ سودا سُلف فریج منز
مےٚ چھُس پنُن کُتھُر متعلق تہِ تَمہِ پٲٹھۍ محسوس کَران
پٲلِتھ جانور ضایہٕ کَرُن چھُ واریاہ مُشکل، اصلس منز چھُ یہِ اَکھ کُٹمُک رُکن ضایہٕ کٔرنس سَمان
وَلہٕ، یِمن منز ژٕ الکحل چھُ تَمہِ اِتھ پٲٹھۍ بےحِس کَران زِ تُہۍ ہیکِو تِہ مارِتھ
آجکَل چھُس مےٚ اَکھ واریاہ سُہ رٲنٛدٕنۍ گژھان
مےٚ ہیکانَہ مانِتھ زِ آخر مےٚ چھُس اَکھ لٔڑکا گژھان
مےٚ رٔستہٕ یِوان کُنہِ تہِ آفت یا زومبی قیامت خٲطرٕ گٔدٕ تیار روٚس
یہِ چھُ افسوس، پنُن حوصلہٕ بُلند تھاوِو تہٕ اُمید چھُ زِ تُہۍ گٔڈِ ورٕس منز تَمہِ منز داخِل گژھِو
مےٚ گژھِ حیران زِ تِم کِتھ پٲٹھۍ نازُک پٲٹھۍ آسہٕ
مےٚ کھٲدۍ ۲ کپ آئس کریم
مےٚ چھُس بہٕتری ہٕنٛز اُمید تھاوان تہٕ بدترین خٲطرٕ تیار روٚسان
تِمۍ ہُندۍ شٲریٖکِ مَنٛزٕ کٔر زِ تِمہِ گژھِ پنٕنۍ والِدٕہ ہٕنٛز مدد کٔرِتھ، تہٕ پتہٕ تِمۍ طلاقُک دعویٰ دٲخل کٔر
اَس کٔرٕ سُنٛد بیٚٹی پنٕنۍ گریجویشن ٹرِپہٕ فلوریڈا کُن ونٹر ڈولفن دِژنس خٲطرٕ
یَتھٕ، مےٚ گژھِ، مگر یہِ گژھِ واریاہ دُکھی کُن
اَس اوس تَتھۍ ۳ دۄہ
اوہ، جُمعہٕ دۄہ کیاہ گژھان؟
آ، یہِ اوس نہٕ مےٚ ہُند سبُک فخرُک لمحہٕ
کالج گریجویشن برٛونٛہہ پنٕنِس آخری گریڈن ہٕنٛز اِنتظار کَران
ہاں، مےٚ غریٖب لوٗکن ساتہٕ گژھُن نَہ چھُ پسند۔
مےٚ اَکھ سکرٛیچ آف ٹِکَٹ پٮ۪ٹھ ۲۵۰ جِتھ۔
کیا تۄہہِ کَتہِ کَنہِ اَسہِ چیزہِ خٲطرٕ زیادٕ پٮ۪ٹھ پیٚٹھ دِوان یُس صرف اَکھ مقرر قیمت اوس ونان؟
کیا تۄہہِ نٔو دوستن سۭتۍ میٖلُن پٮ۪ٹھ گھبراہٹ چھِ؟
مےٚ سٲری دۄہ بلکل آرامس منز اوس۔
کاش مےٚ ہُہِ تٔرٛہِ محسوس کران اوس۔
مےٚ والے بُدھ وار تہٕ شُکر وارَس سۭتۍ شروع گژھان۔
ہا ہا، کُتہٕ چھِ تَمہِ تٔرٛہِ کَران۔
مےٚ پنُن نَصیٖب دار قٕلم گۄم کٔر۔
گژھِم ژٔ ہَفتہِ مےٚ تہٕ مےٚ کُٹٕم گۄڈٕ کٔرِتھ کولوراڈو گژھِم مےٚ بہن سۭتۍ میٖلِتھ۔
کَتہِ دۄہ پیٚٹھ مےٚ دوست اوس مےٚ ساتہٕ کٲم کرنُک مقرر، تہٕ مےٚ اوس سٲری واریاہ خوش۔
مےٚ ڈِش واشَر منز پیٖنۍ لیک گٔی تہٕ نقصانَس سۭتۍ أسۍ مجبُور گٔے پٲٹھ کچن تہٕ لیٖونگ روم دوٚبارٕ کٔرُن۔
مےٚ یہِ سۭتۍ نزدیٖک ۲ وریٚن پٮ۪ٹھ چھُس۔
مےٚ اَتھ ؤنۍ نٔو نوکری شروع کٔرِتھ۔
مےٚ پنٛژَن وریٚن ہِنٛدِ غٲرت کُن والہِ بوائے فرینڈ سۭتۍ رشتہ توٚڑ۔
مےٚ پتہٕ لَگہٕ کہِ مےٚ سٹوریج یونٹ گژھِ سوزنہٕ تہٕ مےٚ گۄم کٔرۍ کینہہ نہٕ بدل سکن والہِ چیز۔
میکڈونلڈس کَتہِ نہٕ چھُ مےٚ آرڈر سہی دِوان۔
کُٹٕم چھُ سیرِ خٲطرٕ باہر گٔمُت۔
اَز مےٚ اَکھ نٔو جاے پٮ۪ٹھ آرڈر کٔر۔
یَلہِ مےٚ باپَس کینسر تشخیٖص گٔی، مےٚ تٔمِس خٲطرٕ واریاہ دِل شِکستہٕ اوس۔
کیا سُہ مَرِتھ چھُ یا سُہ صرف دور رَہان چھُ؟
مےٚ چھُ ضرورت کہ تُہۍ سُہلۍ مےٚ حوصلہ بڑھٲوِو تہٕ مےٚ اعتماد محسوس کَرٲوِو۔
اَس وقت تُہندِ پٲٹھ کَتھ چھِ؟
مےٚ چھُ آسہٕ زِ تِم کَدٕچ نَہ واپس یِوٕن۔
مےٚ پنٛنِس سالگرہِس پٮ۪ٹھ پنٛنِس خاندان تہٕ دوستن سۭتۍ آرام کٔرِتھ دوٚن بیٖر پیٚتھ ہٕک۔
سُہ چھُ واریاہ مِٹھ، یِم ہٕنٛدۍ وجہہ چھِ زِ ژٕر تِمِس مٕحبٕت کَران۔
مےٚ گوٚو آسن تَتھ، تہٕ سُہ چھُ واریاہ تباہ کُن۔
اَگر تُہۍ چھِو مخلص، تَلِہ تُہند خاندان تُہۍ معاف کَرِ۔
یِمن ہٕنٛز بغٲر مےٚ چھُ محسوس گژھان زِ میون دۄہ کَتھٕچ شُروع نَہ گژھِ۔
سُہ چھِ واریاہ ذٔہین تہٕ میڈیکل سکوٗلِس منز چھِ پَران۔
یِمن تُہۍ کُنہہ عارِتھ ہٕیوان تہٕ سُہ فوراً ٹوٗٹِ گژھان، چھُ سَدا افسوس گژھان۔
مےٚ کَتھٕچ نَہ اوس اَسہِ زِندگی منز اِتھ پٲٹھۍ تَرسٲوان۔
مےٚ چھِ تَتھ سۭتۍ لگ بھگ ۱۵۔
سُہ اوس، مگر مےٚ چھُ سُہ پٮ۪ٹھ واریاہ غُصہٕ زِ تٕمِس میون کار خراب کوٚر۔
شاید زِ سُہ سکوٗل شُروع کَرِ، تَتھ پٮ۪ٹھ مےٚ پنٛن فیصلہٕ کَرٕ۔
آہ دَپ، سُہ گژھِ تمہِ خٲطرٕ واریاہ دردناک۔
آ، مگر کَنہہ کَنہہ چھُ اَسہِ پٲٹھۍ گَژھان۔
خوش قسمتی سۭتۍ سٲری کٲم بَنِتھ گٔے، تَتھ پٮ۪ٹھ کٲنٛہہ نقصان نَہ گوٚو۔
یِہ چھُ تُہندِ واریاہ نیک دِلی۔
کُنہِس چھُ نَہ مٔلوم تہٕ سُہ مےٚ نَہ وُچھِ۔
ہاں، بس یِم یونٹن منز مےٚ فیل گژھ، تمن دوبارہ کرنُک گژھان چھُ یہ ہلچل۔
نَہ، یِتھ اسہِ کران چھِ، تِتھٕے مےٚ تَمہِ ناکس پٮ۪ٹھ سیدھا مُکّہ مار۔
مےٚ چھُس محسوس کران زِ تٔمۍ پنُن وقت سُہ گژھِ لُطف اندوز۔
بہٕ تَمہِ ہٕنۍ اَکھ اَسہِ پڑوسِس سۭتۍ چھَڑِ دِیٛہ، یُس مےٚ چھُس جانان زِ سُہ گژھِ آسَہ۔
بہٕ ہٮ۪کَس ونان زِ وقتھ سۭتۍ یہِ واقعی بہتر گژھان چھُ۔
یِہِ مےٚ سۭتۍ تہِ گژھِ آو، ییلہِ بہٕ پرایمری سکولس منز آس۔
ٹھیک، مےٚ چھِ انٹرویوک ۳ مرحلہٕ پار کٔرمت، تہٕ آخری مرحلس منز چھُس انتظار کران۔
آ، مےٚ چھُس محسوس کران زِ سمر بریک گوٚو بٔڑِیا، مگر یِلہِ چھُ وقت دوبارہ تَمہِ پٮ۪ٹھ لَگنُک۔
مگر تُہۍ پاس گژھِو، یِتھ پٮ۪ٹھ چھُس بہٕ خوش۔
مےٚ چھُس صرف سُہ انرجی یاد کران یِم مےٚ آس چھِ ییلہِ بہٕ کم عمر آس۔
مگر سُہ صرف اَکھ حادثہٕ آس، تِلہِ چھُس امید کران زِ تُہۍ تٔمۍ معاف کٔرِتھ ہٮ۪کِو۔
یہِ سُہ چھُ واقعی افسوس کُن۔
یہِ بہتر گژھِ، سُہ چھُ ہمیشہ سُہ وقت زِ سُبٕحس بلکل پٮ۪ٹھ آوُن پٮ۪ٹھ تاریکی زِیادٕ آسان۔
ییلہِ میون بابا فوت گوٚو، تیلہِ بہٕ اَکھ خراب حالتس منز آس۔
مےٚ سُہ تھاوِتھ چھُ، تہٕ اَز تہِ چھُ سُہ میون والٹن منز۔
کالجس منز گژھِ مےٚ بٔڑِ تعدادس منز سکریمبلڈ ایگ کھادمت۔
مےٚ چھُس شرط لَگان زِ سُہ خوش چھِ تُہۍ تٔمۍ ہٕنز ساتھی ملازم گژھِو۔
پالِتھ جانور کھوٚنُک چھُ بٔڑِ مشکل۔
مےٚ سانوٚو سُہ یِم مومبتی بُجھاونس موقعہٕ میلان ہٕنٛز بَرونٛہہ گژھِتھ۔
اسہِ سٲری گٔژھِو باہر اَکھ نیک ریسٹورَنٹس منز کھاون کھاون۔
سچ وُچھان، بالِغ گژھِتھ تہِ مےٚ ژٕلان ہٕند خوف چھُ۔
یہِ مےٚ یاد دِلاوان چھُ یِم وقت مےٚ ژٕ معمول اوس۔
شاید تُہۍ تٔمۍ سٍتۍ گژھِتھ پنُن معاملہ سمجھٕتھ تٔمِس دوبارٕ سوچنٕچ درخواست کرِتھ ہیٚکان۔
مےٚ چھُ گمان تُہۍ باسان بھوکھ اوس۔
آ، یِہ راز اوس یِم سۭتۍ سۄ تِم حٲصِل کٔرِتھ ہیٚکۍ ییلہ مےٚ ناکام گژھ۔
اِمو مےٚ چھُ زٕور دُکھی۔
مےٚ روڈس پٮ۪ٹھ ژٕلان ژٕلان گژھان اوس، تٕہ مےٚ پھسلِتھ پٮ۪ٹھ گٔے۔
مےٚ چھُ گمان کینسر چھُ سبہٕ کھوتہٕ خراب، تہٕ ییلہ کُنہِ وٕنہِ یہِ مات دِوان چھُ تیلہٕ چھُ ہمیشہ کمال لگان۔
سٲنۍ ژٕٹھۍ بیٹی چھِ ژٕلان سوار، تہٕ چھِ اکثر گھوڑن ہٕند شو کران۔
کینہہ معاملن منز چھُ سُہ زٕور سوچ سمجھ کٔرِتھ گژھان تہٕ مےٚ کھوتہٕ چھُ زیادہ تجربہ کار۔
واہ، تُہۍ ہُند نوٚ سیزن خٲطرٕ نیک تمنّا۔
ییلہ مےٚ ہٕند بیٹی ژٕمی، تیلہ مےٚ اوس زٕور خوش تہٕ پرجوش۔
تِم چھِ مےٚ ہٕند سٲری دُنیا۔
مےٚ ہٕند دوستن مےٚ کُنِہِ کتاب ژٕٹِتھ نِتھ، مگر سُہ تِہ ژٕل گٔے۔
مےٚ ہٕنز نانی ہٕنز کمرٕچ بڑی سرجری چھِ وُچھنٕچ ہفتہٕ، تِم خٲطرٕ مےٚ چھُ زٕور افسوس۔
سُٹی چھِ کَتھ وقتٕچ؟
مےٚ چھُ یقین سُہ سٲری وقت زٕور ذہنی دباؤ اوس۔
شُکریہ، یِہِ وجہ چھِ یُس مےٚ سۭتۍ زٕور جوش۔
سُہ سیکھان چھُ؛ مےٚ اوس پٮ۪ٹھِ تٔمِس پانٛژھ دۄہ کَتھ کَتھ کٔرِتھ پیسٕ دِتھ حوصلہٕ دِوان۔
سُہ پٕزِ زٕور پٕرٛون یاد دِلاون اوس۔
اگرچہ میٚنٛز ماضی ہُنٛد واریاہ تجربہ منفی روٚز
مےٚ چھِ یقین زِ سۄ رات آس مزٕدار
یہِ چھِ سُہ ہی ژٕ مایوس کُن
اَتھ پٲٹھۍ مےٚ چھِ آزاد محسوس گژھان
مےٚ چھُس جانان زِ سُہ حٲصل کرُن چھُ مُشکل، مگر مےٚ چھِ آس
مےٚ چھُس وٕنٛنٛے پنُن گوٚڈنیٚو ۵ کِلومِٹر رَن پٲٹھۍ
میٚون پِلٕہ کَروٗچ پٲٹھۍ پٔتھ تہٕ تٔمۍ ہُنٛد پنجہٕ زَخمی گوٚو
سۄ چھِ اَکھ نَنُن ہَسکی، تٔمۍ ناو چھِ مے
آ، سُہ صرف تعارفی آ، مگر مےٚ نِہ کٔر ریاضی واریاہ وۄنۍ
تِم چھِ واقعی کمال ہنٛدۍ گاڑِ، شخصیت سٕتۍ
مےٚ اوسُس پٲٹھۍ راتھ پری سیزن فُٹبال میچ وٕچھان
آ، مےٚ تہِ چھُس
گژِ رات مےٚ اوسُس دوستن سٕتۍ باہَر تہٕ میٛون والٹ گوو چوری
