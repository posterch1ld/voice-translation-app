اوہ، ٹھیٖک، یہِ چھُ سُہٕ لٕگٕنۍ۔
آ، یہِ ہٕچُھ سٕنِتھ مےٚ سٕچٕی بٕہٕتھ اَفسوس۔
مٮ۪ٲنۍ نٕنٛہِر ژٕتھ بٔہٕتھ وَرۍ پٮ۪ٹھ وَفات پٲٹھۍ۔
یَتھ مےٚ ہٮ۪کان، مےٚ مدد کٔرٕنۍ کوٗشش کَران۔
تہٕ کَتھ چھُ تُہٕنٛد خیال، سُہ کِتھ پٲٹھۍ رٙدعمل کَرٕنۍ؟
مےٚ سمجھیو سُہ کُڑیٛن ہٕنٛز طرف کَتھِ کَران اوس۔
ہاں، سُہِ کوٚر۔ مےٚ اوس تَمہِ پٮ۪ٹھ بٕہٕتھ بھروسہٕ۔
سُہٕ کِتھ قٕسمُک سَپ اوس؟
کیا تُہۍ حالَت ہٕنٛز مزید چھان بین کوٚر؟
سٕہِ دۄہ مےٚ بٕہٕتھ خراب اینگزایٹی اٹیک گوٚو۔
ٹھیٖک، پنٛنِس ڈاکٹرَس ہٕنٛز صلاح ضٙروٗر سُن۔
مےٚ پارٹی خٲطرٕ اکھ ڈریس آرڈر کوٚر، تہٕ سُہ اوس ایونٹ ہٕنٛز دۄہٕچ یِوان۔
مےٚ چھُ آس یِہِ زٕ سٲری کینہہ ٹھیٖک گژھِ۔
مےٚنۍ بہٕن تہٕ تٔمِس شُہٕر، یِم مےٚ سٕنٛدۍ پٮ۪ٹھ غریٖب چھِ، تِمِس پٮ۪ٹھ گٔے۔
صاف چھُ، یِہِ چھُ سٕہی طریقہٕ کرٕنۍ۔
تہٕ کُس جٲنِہ، اگر تُہۍ پنٕنِہ انتخاب کھُلٕتھ تھاوِو، شایَد سٕہی نوکری تُہٕنٛدِس نَزدیٖک گژھِ۔
تِمِس میڈیکل بِلَن ہٕنٛز رقم چھِ سٲری جمع گژھان۔
مےٚ کوٚر یہِ کَم اکھ وٲرۍ پٮ۪ٹھ ژیادٕ؛ مےٚ چھُ نٲو یاد تھاوٕنۍ زٕرٕی مشکل۔
تُہُنٛد وائرلیس سروس پرووایڈر کُن چھُ؟
یہِ تِہِ ونُن خٲطرٕ اچھ تھٲو کہ سڑکَس پٮ۪ٹھ پارک اوس، مگر بیٚل دِنُک پٲٹھۍ مےٚ کھنٛڈِتھ۔
مےٚ تَمہِ پٮ۪ٹھ سٲریٛن رٲض آسٕس۔
کاش مےٚ وقتس منز پٮ۪ٹھ گژھِتھ ہیٚکن۔
گژھِتھ راتھ ۳ بجہ مےٚ پنٛنِس ژھۄکھٕر پٮ۪ٹھ زور زور ٹھک ٹھک ہیٚچھ۔
مےٚ آس چھِ تُہۍ سُہ ژٕٹۍ لبِتھ۔
مےٚ خوش چھُس زِ تُہۍ کُنہِ جایہِ پھنسِتھ نَہ اوس۔
سُہ دُرُست کَرُن نَہ چھُ تَتھ کَٹھِن لٲگِتھ۔
مےٚ یاد چھُ زِ جونیَر ہای منز مےٚ واریاہ دَفہِ کٲلژ چھوٚڑ۔
مےٚ یہِ کٲشرِی اَسۍ اکھ آنلایِن ڈیٚٹِنٛگ سایِٹ پٮ۪ٹھ مٮ۪لِتھ۔
مےٚنٛز ہمسایہِ اکھ مہینٕہ پیٚٹھ یِتھۍ شٮ۪فٹ گژھان۔
اگر مےٚ تُہٕنٛد جاےِ آسٕس، مےٚ یِہِ شاید تھاوُن؛ ویسے تہِ یِہِ کیش ویلیوس پٮ۪ٹھ زیادٕ جذباتی ویلیو چھُ۔
نَہ، مگر مےٚ یِتھ پٮ۪ٹھ سٲریٛن قصوروار لٲگٕنۍ۔
تٔمۍ اکھ کارویٹ ژٕٹ، تہِ واہ، تَمہِ ہُڈ ہٕنٛز ژٕٹِک پٮ۪ٹھ کَتھِ زبردست طاقت چھِ۔
مےٚنٛز تہِ چھُ اکھ، تہِ سُہ چھُ کھنٛڈِتھ۔
مےٚن تہِ چھِ نہٕ تِم पसنٛد۔
سُہ اکھ بَڈِی خراب دۄہ اوس۔
سُہ مٔزٕ اوس تہِ آو مےٚ چھُ اَتھ ژۄنٛگٕر ہاہا۔
مےٚ آس چھِ زِ باقی بٲچہِ تہِ پنُن کام ٹھیک کَرن۔
تِمَنِز صحتمند انتخابن ہٕنٛدۍ آپشن چھِ۔
‘اے’ ملُنٕچ آس چھِ۔
یہِ اتھ مہنگ گژھِتھ مےٚ چھُ بہت پریشان۔
بہٕ فوجس منز شامل گژھان۔
یہِ ژِیٚتھ ختم گژھِتھ، تہٕ تُہۍ سوزِو پنُن معمول زندگی واپس، بیٚیہِ ژھانگ کالن ہٕنٛدۍ بغیر۔
مدرس ڈے پیٚٹھ بہٕ چھُس پنٛنِس ماجہِ ناز کرُن پسند۔
آ تِم چھُس پنٛنِس زندگی سۭتۍ واریاہ خوش۔
کیازِ کہُ تِہِ چھُ اکھ بے قابو پاگل۔
بہٕ کُنہِ واتر پارک گژھِتھ نَہ، یِمنہٕ ہاو دلچسپ آسن۔
بہٕ گژھِم کینہہ اَگٕژ راتھٕچ کھٲترٕ اکھ اطالوی ریسٹورانٹ۔
میٚون گَر گۄو آگ۔
واہ، سُہ چھُ واریاہ کال گژھِتھ۔
مےٚ چھِ تِمن مُتعلِق بس اکھ خراب احساس۔
سُنان منز چھُ لگُن زِ یہِ چھُ اکھ امید وار جاب۔
ہاں، شایَد تُہۍ کُنہِ متبادِل لَبیو۔
اَکھ ماجہ، اَکھ باپ تہٕ اَکھ بَھرا۔
ہاں، تِہِ چھُ واریاہ سخی۔
میٚون کریڈٹ کارڈن ہٕنٛدۍ قرضہٕ ادا کٔرِتھ کینہہ پیسہٕ سرمایہ کاری منز لٲگُن۔
ہفتہٕ وار منز راتھ ٹھہران۔
حالٕچ تِمۍ ہٕنٛدۍ روٗیہِ مُتعلِق پنٛنِس باس سۭتۍ سامنا کرنٕچ مےٚ چھِ واریاہ ہچکِچاہٹ۔
پنٛنِس خاندانُک سانحہِ ذٔریعہٕ آسہِ پَتہٕ لَگ زِ انسانن منز چھُ اکھ وَڑِ رِشتہٕ۔
تُہۍ کٔنہہ اَکھ حٕصٕل کٔر؟
سُہ دۄہ مےٚ میٖٹنگ ٲس، یِم میٖٹنگس منز ٲس سٲریَن نوٗٹ کٔر۔
بہٕ چھُس پنٛنِس شۄہرَس سۭتۍ زٕنٛگٕر پٲٹھۍ محبت۔
مےٚ چھُس نَہ وٲتھ کٔرِتھ یِم ٹھنٛڈ گژھِ۔
مٕہنِس شۄہرَن گۄو پنُن کٲم ژھٕٹ۔
یِہ چھُ میٚنۍ اول ویٖڈیو گیم سِسٹمچ یاد دِلاوان۔
مَگَر سٲلن دوران تٔمۍ چھُس سٲری پٲٹھۍ میٚنِس نَزٕدِک واپس آنمُت۔
یِم دۄہ تُہۍ طبی مدد ژھانٛڈان چھِو، کۄنہہ چھُ نَہ تُہۍ سۭتۍ تِم پٲٹھۍ سلوٗک کَرُن۔
اَکھ اوس کینہہ وٲریہ ژیٛادٕ عمرِچ دِژھان۔
بہٕ آسٹن پٮ۪ٹھ اُترَس طرف یِوان ٲسُس، یِمن کٔنِہہ گۄوٕچ بُو ژھٕٹاوُن آسان ٲس۔
میٚنِس کَنہہ ٲس صاف صحیح جواب۔
میٚنۍ زنٛہٕ تہٕ مےٚ سٲری سوشل میڈیا پاسوٙرڈ اَکہِ دوٚہس سۭتۍ بدلاو کٔر۔
آ بیٚہہ میٚنۍ سکالرشِپ گۄوٕم۔
یِم کینٛہہ گژھِتھ ہٮ۪کِ، تَتھ خٲطرٕ چھُس بہٕ تیار۔
گژھِتِس ہفتس میٚنِس سۄنٛز دوستَن میٚنۍ کار ژٕر۔
کینہہ لوٗگ چھِ مےٚ پاگل کَران۔
یِہ چھُ وٲضِح پٲٹھۍ اَکھ بُرٕ دوست لٲگن۔
پُلیس چھُ کینٛہہ کَران یِم متعلق؟
پاورپایِنٛٹ چھُ کِس متعلق؟
میٚنۍ زنٛہٕ گٔے شہرٕ پٮ۪ٹھ باہَر تہٕ بہٕ ٲسُس پٲٹھۍ اَکھ ہفتہٕ اکیٛلا۔
مےٚ چھُس مانان، تِمِس بچپن گژھن ہنٛد نظارہ کرنٕچ وجہ سٕتۍ مےٚ چھُس قصوروار محسوس کران۔
سٲدٕ کپڑٕ تہِ ڈرٲونٕک گژھِتھ۔
کالجس خٲطرٕ مےٚ پٮ۪ٹھ پیسہ ختم گٔے، تہِ تِم چھِ مےٚ پرٛایویٹ لون لٕنٕچ خواہش کران۔
مےٚ چھُس خوش زِ لوٗکھ چھِ اَز تہِ بٲہری دُنیاہ پٮ۪ٹھ دھیان دِوان۔
مےٚ چھُس اُمید کران زِ تُہٕنٛد شادی گژھِ۔
مےٚ چھُس کٲنٛہہ صرف پنُن نُنٛہہ خاندان چار ڄنٛہٕ سٕتۍ بیٚچ پٮ۪ٹھ گژھان۔
مےٚ چھُس ٹھیٖک، مےٚ چھِ خبر زِ سا نہٕ کَتھ کَری مےٚ ژۄر دِنس خٲطرٕ۔
کیا تُہۍ مٮ۪نیجرس کٲنۍ وُن؟
مےٚ چھُس گلف ساحلس پٮ۪ٹھ روزان۔
مےٚ ژٕ کینہہ دۄہ اَکھ غٲر معروف برانڈُک ژٔل، کیازِ سا سیلَس منز آس۔
مےٚ چھُس اُمید کران زِ بجلی نہٕ گژھِ بند۔
کیا تُہٕنٛد والٹ تُہۍ واپس مٕل؟
اَز مےٚ پٮ۪ٹھ اَکیٛاہ راتھ کھاون کھاون پٲوان۔
تُہٕنٛد والدین گژھن ضرور تُہۍ پٮ۪ٹھ زٕبردست فخر کران۔
یہ سُنتھ مےٚ چھُس رٲژِتھ، اُمید چھُس زِ تُہۍ تُہٕنٛد باغ برابر ترتیب دِتھ ہٮ۪کِو۔
ییلہِ سُہ پنٛنٕس بواےفرٛینڈ سٕتۍ جُدا گٔی، تیلہِ مےٚ دِتھ پنٛنِس سہیلی حوصلہٕ۔
مےٚ چھُس پنٛنِس جایٕہِ سٕتۍ زٕبردست محبت کران۔
تِمِس پٲکٕہ خبر ٲس زِ سُہ کیاہ کران اوس۔
اَچھا، قصور چھُس مےٚ ہٕنٛز؛ اَز چھُس نتیجہٕ بھٕرتھ پٮ۪وان۔
مےٚ مٕلِتھ نَو ہمسایہٕ تہِ چھُس مےٚ نہٕ لگٲن زِ تِم چھِ کٲنٛہہ خاص نٮ۪ک۔
شُکریہ، سُہ ژور آس، مگر تہِ۔
مےٚ نہٕ لگن چھِ کہ تِم میٚنۍ وجہن سۭتۍ ہمدردی کرِتھ۔
مےٚ ہُند بۄڈ کینسر سۭتۍ ژٔٹھان ہیٚوان دِژُن گژھِ اوس واریاہ مُشکل۔
ژٕتھ آزاد ٲسِتھ پنُن وقت مزٕ کرُن گژھِ اوس سُہنٛدر۔
برٕ، ییلہٕ مےٚ سُہ گۄموو، مےٚ ہٕندِین والدینن میٚےٚ وون زِ مےٚ نہٕ ملِ اکھ بیٚیہِ۔
خوش چھُس زِ تُہۍ تَمہِ مدد کرنہٕ خٲطرٕ تَتھ چھِو۔
سُہ مٕرِتھ گٔیہِ، سُہ چھِ واریاہ دُکھی۔
ییلہٕ اکھ جاےٕ سُہنٛدر طریٖقہٕ سان سنبھالِتھ یوان چھِ، سُہ چھِ واریاہ سُہنٛدر۔
مےٚ چھِ یہِ گیم لیگ آف لیجنڈز واریاہ پسند، تہٕ ورین سۭتۍ پرٛانہِ میٚنۍ میچ دِژُن اوس واریاہ کۄل۔
کینہہ ہفتن ہیٚوٗر مےٚ ہُند شَوہر واریاہ خراب زٕکامہٕ سۭتۍ بیمار اوس۔
سُہ چھِ بلکُل سارتھک۔
اوہ نہٕ، کیا تُہۍ غلط طریٖقہٕ سان گاڑِ تھٲوتھ روکِتھ؟
آ، مےٚ چھُ ملان ہٕفتس منز ۵ دۄہ کٲم۔
تَمہِ خٲطرٕ مےٚ چھِ افسوس۔ کیا تُہۍ سُہ واپس میٚلِتھ؟
مےٚ کورین زَبان ہُند امتحان دِنہٕ خٲطرٕ واریاہ محنت کٔر تہٕ کَل سُہ پاس کٔر۔
تُہۍ چھِو خوش قسمت زِ تُہٕند چھِ اَتھ سُہنٛدر ماجہٕ۔
تُہۍ کٔم دِژِم؟
مےٚ دِژ اکھ لُکھ شَارکن ہٕنٛدِس بارے منز ڈِسکَوری چینل پٮ۪ٹھ، تہٕ تَمہِ پَتہٕ مےٚ کَتھ نَہ اوس پَہلِس نِش۔
مےٚ چھِ افسوس، سُہ گژھِ آخرکار رُکُن۔
کینٛہہ ٹریل مِکس پیک کٔرِتھ تھاون بہتر چھُ
ہاں، تہٕ یہِ تَمہِ خٲطرٕ واقعی بہٕت مطلب چھُ، یِمنٛۍ سۭتۍ بچہٕ کٔرِتھ حٲصل کٔرٕنۍ دٔپان چھُ مےٚ پیٚٹھ
تُہۍ تَمہِ خٲطرٕ واریاہ خۄش تہٕ فخر محسوس کٔرِتھ آسِو
اچھا، کَتھ کَتھ بِلّی دۄر دۄر گژھن پسند کران
مےٚ تٔمنٛدِ خٲطرٕ نَوۍ کَپڑے ؜خٔرید کٔرۍ تہٕ یِمنٛۍ ہفتہٕ کُل اسۍ سٲری ڈِزنی ؤرلڈ گژھِو
یِم وقتس اَسۍ مُشکِل سۭتۍ کَتھ کران
کیا تُہۍ آسہِ چھِرِتھ واریاہ نِنٛد کٔرِتھ
تہٕ مددُک یُس سیلاب آو، سُہ کمال ہُو
ٹیلیمارکیٹر ہمیشہ سۭتۍ بے آرام وقتس فون کران
یہِ چھُ واریاہ سُہ، مےٚ چھُ محسوس گژھان زِ ہر أکۍ خٲطرٕ کُنہِ جاے کُنہِ چھُ کُنہِ
سُہ دِل شِکَست کُن آسِہ، کیا تُہۍ ژٕتھ یہِ منصوبہٕ بناوِتھ آسِو یا کُنہِ نِہ تُہۍ خٲطرٕ بناوِتھ آسِہ
مےٚ چھُس امریکہس منز یِوان اقتصادی بحرانس خٲطرٕ تیٲری کران
مےٚ اُمید چھُ زِ تَمس مدد سۭتۍ پارٹی واریاہ کامیاب گٔیہ آسِہ
مےٚ چھُس خۄش زِ تِم گٔیہ گٔرفتار
مےٚ چھُس کَتھٕ نِہ ہٕمَتھ کران زِ سُہ آزماوٕں
سُہ سُںتھ خۄش گژھِ زِ آو نِہ یہِ دۄبارٕ کِنہِ
آخری مرحلس منز نیک تمنائیں
شاید ژٕ روزن منز گژھِ
کیازِ تِمنٛدِ مُکھس پیٚٹھ تھپڑ دِیُن ضٔروٗری چھُ، یِمۍ خٲطرٕ
تٔمِ سۭتۍ لطف اُٹھٲو تہٕ خۄد شُکرگُزار تھاو
مےٚنٛز باس چھُس مےٚنٛز پٲٹھۍ واریاہ زیادٕ پیسہ کمان
سُہ چھُ اکھ کمال ہُنٛد پِتہ
اَز چھُس مےٚنٛز پسندیدہ ساتھی ہُنٛد آخری دۄہ، بہٕ چھُس تِمِس یاد کران
ہائی سکولٕچ پیار کران وٲلۍ، سُہ چھُ واریاہ خاص
تُہٕنٛد چھُ کانٛہہ بیٚیہِ روم میٹ، یا تُہۍ چھِو اکیلا رہان
تٔمۍ ہُنٛد تقریر گٔیہِ مےٚنٛز دِلَس منز گہرٕ اثر
کینہہ کینہہ اکیلا روزُن چھُ سُہل
مےٚ چھُس پَک یقین، ژٕنٛہہ تُہۍ پنُن بٔکھرا لُک صاف کٔرِو، تُہۍ چھِو سٲری بٔیِس پٹاونٕچ قابلیت
سُہ کینہہ نَہ اوس یُس مےٚ آس کران اوس
مگر یُس نہٕ اَسِی آر وی منز
مےٚ چھُس خیال کران زٕنٛہہ گٔیہِ سَتھ بجِ
مےٚ چھُس جانان سُہ کرِ سُہ سۄکھ
کیا تُہۍ چھِو موسم وُچھان
ریپبلکن یِم آب و ہواک بدلاؤ ہُنٛد خیال صاف تہٕ سیدھے طریقہٕ نَکٲران، تِم وُچھِتھ چھُس بہٕ اَسہِ نسل ہُنٛد مستقبل ہٕنٛز فکرِ منز خۄف زدٕ
تُہۍ تِمِس پیٹھ کُن چیخۍ
بہٕ اوسُس پریشان، مگر مےٚ اوس تِمِس پٲٹھۍ بھروسہ کرُن لازمی
شُکریہ، بہٕ چھُس واریاہ پرجوش مگر پریشان تہِ
سُہ چھُ لازمی واریاہ دلچسپ
تِمِس ہُنٛد پاد کَٹُن پٔرِتھ ہیکِہ
مےٚ چھُس صرف اکھ ضرورت
ہاں، یَتھ دۄہ تُل مےٚ جان پٲٹھۍ کُنہِ رُکِتھ حال پُچھ، تَتھ دۄہ تُل بہ ریڈیو چلاوان اوس۔
کِنہِ گوٚڈ نَک آؤٹ گوٚو آ؟
واہ، گَرِ بجلی نہٕ آسن چھُ بہٕ گژھان خراب۔
شاید تُہُندِ مستقبل منز آسٹروفزکس منز کریئر آسِتھ۔
تُہۍ یقین کَرِو، گژھِتھ دو ہفتن منز ترٛیٛم وٲر کٲمِس منز مےٚ لنچ چور گژھِتھ؟
مےٚ سارنی دوست میڈِکَل سکولَس گژھان، تِم مستقبل منز گوٚڈ کامیاب۔
مےٚ پٲلِتھ کُتُّر گیب حالٕے منز مٲرِتھ۔
آج مےٚ چھ مِنٹن ہٕنٛد کَم وقتَس منز اَکھ مایِل رَن کٔر۔
اَکھ راتھ یَتھ گژھان اوس بہ رۄڈ پار، اَکھ کارِ مےٚ نَہٕ دِتھ تہٕ لگ بَگ مےٚ ہِٹ کٔر۔
یَلہِ بہ گژھان اوس، اَکھ کُتُّر مےٚ کِنٛہِ دۄڑِتھ یِتھ شروٗ کٔر۔
سُہ گژھِتھ، تَمہِ سۄ بہ دُکھی چھُس۔
یَتھ بہ کٲمِس پیٹھ جلدی نَہٕ نِکلی سٲنس، تَتھ دۄہ بہ دُکھی اوس۔
اگر سُہ پَیسہ نَہٕ دِیہِ تَہٕ کیاہ؟
ہفتہٕک دۄہ چھِ ہمیشہ سُست سُست گژھان، مگر ویک اینڈ چھُ نَہٕ کَتھ پَتہٕ لَگِتھ گژھان۔
مےٚ چھُس نَہٕ یقین، مےٚ صرف کَنہِ بھروسہٕ لَگاون وٲلۍ چیٖز چاہی، تُہۍ جانَو۔
یہِ چھُ اَکھ جیتن وٲلۍ کمبینیشن۔
سُہ گوٚو اَکھ مہنگا گٕلوٗو، تہٕ تَمہِ نَہٕ کَرُن اوس ضروٗری۔
مےٚ شوٚہر چھُ ویڈیو گیم کھیٚلان ہیڈسیٹَس پیٹھ زوٗر زوٗر گفتگو کَران۔
یَتھ کَنہِ نوٚو جَنٛمِتھ بَچٕس نَظَر پَو، تَتھ کَنہِ بہ ہمیشہ یہِ سوچان چھُس زِ تِمُنٛز زندگی خوش تہٕ لمبٕر آسِتھ۔
یَتھ کَنہِ سَرجرٛی کَرٕن گژھِ، خاص کٔرِتھ یَتھ سُہ ژھۄر گژھِ، چھُ ڈر لَگن۔
تُہۍ وٕنٛدِ کیا کٔرِو؟
مےٚ نہٕ چھُ پسند یِہ یِم کہِ تُہۍ کُنہِ مدد کٔرِو تہٕ تِم تُہٕنٛد فایدو ٹھیٖکۍ لَون۔
کاش مےٚ تہِ ژٕتھ نَصیٖب دار آسَہٕ ہا۔
مےٚ چھُ یقین تُہۍ کٔرِو شاندار، بس زٕ جذٕبہٕ دِکھٕیو۔
تُہۍ کِیاہ ژٕ سوچ کہِ سُہ تُہٕنٛز پَتھ آس؟
ہاں، یِہ سٕمٕجِتھ چھُ دٔل دُکھی کہِ کینٛہہ لوٗکھَن ہٕنٛز واقعی کُنہِ تہِ چھُنہٕ۔
تُہۍ کٕرِو یِژ کھاون؟
کیا تُہۍ گژھِو کَتھ کرن یا گژھِو کُنہِ مزٕ دار کام کرن، شایَد دۄنٛوے؟
کَل آس مےٚ ہُنٛد بھٕتیجٕچ بٔرتھ ڈے پارٹی۔
مےٚ چھُ ہُند تہِ بدتر حالتن مَنٛز سُہل کٔرمُت۔
آج مےٚ کٔر مےٚنٛز کافی میکر خراب، تہٕ مےٚ چھُ واریاہ غُصہٕ کیازِ مےٚ کَہہِ کَہہِ کافی نہٕ بَناوِتھ۔
یِہ چھُ شرمندٕگی ژٕنٛگ، پتہٕ کیا گژھ؟
تُہۍ کِہٕنٛز ڈرِتھ آسِو؟
مےٚ چھُ وُنِہِ ٹاؤن ہوم کمٕیوٗنِٹِی مَنٛز رَہان، تہٕ مےٚ ہُنٛد پَڑوسِی چھُ اَکھ خاندانٕچ گَرِ گژھان۔
تُہۍ یِہ کٔتھ پٮ۪ٹھ کٔرِو؟
مےٚ چھُ یقین کہِ سُہ احساس کمال آسِہ ہا۔
مےٚ چھُ وَنٛدٕ ہفتہٕ چھُٹِی پٮ۪ٹھ گژھان۔
مےٚ چھُ یقین کُنہِ تہِ نِش نہٕ لیٖکھ۔
مےٚ چھُ ہر پٲٹھۍ سادٕ عام۔
آہ، تٔمۍ ہٕنٛز ماوٕ سُہ خاطرٕ دُکھی تہٕ خۄش دونٛوے گژھِ۔
یہ چھُ کمال ہاوان، میون پیٹ چھُ بلکل بھرمت، مگر بہٕ پھر بیٚ سمندری کھانہِ کھاون گژھان۔
فقط آرام سان وٕنٛدُن سُہ وان۔
بہٕ سپین پٮ۪ٹھ شروع کٔرِتھ پتہٕ فرانس گژھان۔
ییلہٕ بہٕ مکان بدلٕوان اوس، تیلہٕ مےٚ پنُن سامان سٹوریجس منٛز تھوومت۔
کیا سا چھِ از بیٚ تُہۍ سٕتۍ؟
وُچھُن چھُ واریاہ دیر یِمۍ سال دوبارہ کوٗشش کرنس منز۔
اَزکل چھُ لوکن پٮ۪ٹھ بھروسہ کرُن مُشکل۔
ژٕ کینہہ دۄہ قبل پننِس صحنس منٛز ژھۄل دِتھ بہٕ ہَلاں گٔژھ۔
مےٚ چھُ یقین نِہ یِوان زِ یِم گرمی کتھ پٲٹھۍ درٕگٕر گٔے۔
تُہۍ خٲطرٕ گوٚو سُہ ضروٗر حیران کُن۔
یہ چھُ سکیٹ بورڈنگ سٕتۍ اَتھ پٲٹھۍ اَکھتھ کھیلن خٲطرٕ۔
کُنہہ وار چھُ صرف پننِس دلہٕ خوش کٔرُن، پتہٕ دوٚیمِس وارٕ بہتر کٔرُن۔
پَرسوں مےٚ ماج کرِتھ مےٚ واریاہ پریشان کٔر۔
اگر تُہۍ پننِس خاندانس پٮ۪ٹھ بھروسہ نِہ کٔرِو، کَس پٮ۪ٹھ کٔرِو؟
ژانورن ہٕنز دیکھ ریکھ کرُن چھُ واریاہ سُہ۔
مےٚ لگُن چھُ، یتھ خٲطرٕ چھُ کینہہ مہارت درکار۔
سُہ کَتھ پٲٹھۍ کیک اوس؟
دو ہفتن منٛز فلوریڈا خٲطرٕ روانہ گژھان۔
ہیلووین خٲطرٕ تیاری شروع کرنُک وقت آو۔
آ، تِم چھِ سِسٹم سٕتۍ دھوکہ دِتھ پتہٕ واریاہ بڑٕ ریفنڈ واپس گژھان۔
ہاں، مےٚ چھُس تٔمِس خلاف کانٛہہ گِلہٕ نَہ۔ تٔمِس چھُ پگاہ فرنچایزِ خٲطرٕ بَہتھ زیادٕ، مگر یہِ تٔمِس غلطی نَہ۔
اوہ، سُہ گژھِ مَزٕ دار۔
تُہۍ کُنہِ قِسمُک کافی گژھِ وۄنُن؟
سُہ اوسُس واریاہ نیک۔
اوہ مے گاڈ، سُہ چھِ واریاہ خراب لۄگُن۔
مےٚ بہٕن کٔل یِم مےٚ أنٛنِس سنٛیکس سٲری کھٲد۔
مےٚ اوسُس پَتہٕ زِ مےٚ دوست ویکٕنٛڈس مَنٛز مےٚ ساتہٕ روزِ۔
آ، مگر پیسَن مُتعلِق چھِ بے ذِمہٕ۔
مےٚ نَہ چھِ ڈرٲون فلمہٕ پسند۔
گٔژھِم ویکٕنٛڈس کٲم کرُن پَڑِتھ مےٚ اوسُس واریاہ ژٔلِتھ۔
سُہ چھِ دو ؤرۍ وٕنُن، تہٕ گژھِ چھُس سُہ سنٛبھٲلُن مُشکِل۔
مےٚ اوس نَہ دِوان پٲٹھۍ چاکلیٹ بارُک پیسہٕ۔
مےٚ اوس پنُن دٔہی کٲمَس مَنٛز فِرِجس مَنٛز تھاوٕمُت، مگر کُنِس دۄہ گژھِ سُہ کھاون۔
مےٚ چھُس پَتہٕ زِ ژۄر مےٚ کٲمَس پیٹھ نِکٲلِتھ دِیِہ۔
اگلیس مٔہینس خٲطرٕ مےٚ کرِ بہتر بجٹ۔
اوہ، افسوس چھِ زٕ زیادٕ نوکریو مَنٛز نَہ۔
سُہ چھُ مےٚ وۄنۍ کران۔
مےٚ گٔے تَتہٕ تہٕ کٔر سُہ کٲم۔
مےٚ حالیہ مَنٛز پنُن گَر کٔر رینویٹ۔
تِمَن کٔژھِ زِ أسۍ وۄتہٕ زِیادٕ سیاسی گٔے تہٕ کٔژھِ زِ أسۍ واریاہ حدٕ پار کٔر۔
مےٚ دِوان چھُس زِ تُہۍ چھِ جوٗا کھیٚلِتھ مزٕ۔
انشورنس ٹھیٖک چھُ، ۴۰۱(کے) تہِ چھُ، تہٕ پَگاہ واریاہ ٹھیٖک چھِ۔
بہٕ کینٛہہ تہِ خراب نہٕ کٔرمُت۔
نظر کم آسنہٕ سۭتۍ رٲستہٕ کٔڈن بہت مُشکل گٔے۔
مےٚ چھُ نہٕ پَتہٕ کہِ تِمِس سچ کِتھ پٲٹھۍ وُچھٕہ۔
مےٚ اُمید چھُ سۄ کُنہِ صحتھ مسئلہٕ نَہٕ آسِ۔
سُنے وُچھان چھُ سُہ ٹھیٖک خبر تہٕ خراب خبر۔
تُہۍ کِس قٕسمُک سفر کرٕنۍ یژھان؟
یہِ بنٲون چھُ میون سُہ پٔہل فَٹ۔
یہِ چھُ نہٕ کَران کٲم ترٛےٚ مَہینن پٲٹھۍ۔
یِلہِ میون برٛونٛہہ گَرٕ تَھٕکٕن آو، بہٕ گژھُس حَیران۔
مےٚ پٔرِ ژٕ کَنٛہہ الگ الگ جاگن منز سولڈر کٔرُن۔
تُہۍ گژھِو سچٕچ تِمِس پنُن دِلُک حال وُچھُن۔
میون مکان مالِکَن چھِ اَسہِ کمپلیکس خٲطرٕ کرفیو لٲگمُت۔
بہٕ چھُس وُنِے پنُن اُمید خۄدایِس پٲٹھۍ تھٲومُت۔
یہِ بہارُک چھُٹیَن منٛز بہٕ گٔے اوسُس پنٛنٮ۪ن دوستن سۭتۍ کولوراڈوچِ اکھ سکی ریزورٹ۔
تِمَن سٲری چیز چھان مٲرِ، مگر کینٛہہ تہِ نَہٕ نیو۔
مےٚ مطلب چھُ، سۄ کم اَز کم کُنہِ وَدِ پرٛایویٹ جاے نہٕ گٔژھِتھ؟
بہٕ تہِ پٔرِشٲن گژھِتھ۔
کیا تُہۍ چھِو پانِس سۭتۍ پیار؟
مےٚ چھُ لگٕنۍ سُہ میون طرفہٕ اکھ بیوقوفانہٕ فیصلہٕ اوس۔
تہٕ مقصد کیا چھُ؟
