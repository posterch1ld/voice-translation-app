مےٚ وُچھم آدا اِنڈونیشیاہِ گژھِمُت زَلزلہٕ؛ لگِ چھُ تِتھۍ بُتھ لوٚگ مٲرِتھ۔
کیا تُہۍ کانہِ مزٕدار جاے گژھان چھِو؟
اَکھ دۄہ مٮ۪ون پٲٹھۍ آوُن دروازَس پٮ۪ٹھ آو۔
کَتھ کَتھ مےٚ چھِ پریٚمِکا اوسُن، مگر مےٚ چھُ خیال یِوان زِ کانہِ بیٚیِس سٟتۍ ٲسُن کِتھ پٲٹھۍ گژھِ۔
یہِ چھُ مےٚ سچ پٲٹھۍ بَدٕن باسان۔
اَکھ دۄہ مےٚ سمر کیمپَس منز ڈاج بال کھیٚل۔
گَژھِ ہفتٕچ آخری دۄہ مےٚ اَکھ باہرٕ پارٹی منز اوس۔
تُہنٛد نٔو پَد کیا بَنتھ؟
یہِ چھُ اَکھ IT جاب تہٕ بہٕ چھُس یتھ خٲطرٕ اہل، مگر تَمہِ پٮ۪ٹھ تہِ ڈَر لَگان۔
تُہۍ ظٲہر چھِو اَکھ بہترین والدین۔
یاد کٔرِو سُہ کِیاہ چھُ نیران۔
بہٕ آسٕس سُہ پٲٹھۍ جِم گژھان یِوان تہٕ مےٚ سٲریوٗتھ نٕو گژھان۔
تُہۍ ہؠ کٔرِتھ یِوان زِ تُہۍ پنُن بہترین کٔرِو تہٕ کوشش کٔرِو زِ تَمہِ پٲٹھۍ زیادٕ دھیان نَہ دِو۔
کیاہ سُہ واریاہ وقت پٮ۪ٹھ چھُ یا تُہۍ چھِو حالیہ گریجویٹ کٔرمت؟
اَسہِ ضروٗر کٔرِ اَسہِ یِتھ ویڈیو۔
راتھۍ یَلہِ بہٕ چھُس بسترَس پٮ۪ٹھ پٲٹھۍ، مےٚ چھِ کَپٹہِ منز آواز یِوان۔
کَل مےٚ پنُن جاب اِنٹرویو سُہ پٲٹھۍ کٔر۔
مگر بہٕ چھُس نَہ یِژھان ڈینٹسٹ کُن گژھِتھ۔
مےٚ چھُ اُمید زِ فرؤری منز مےٚ تنخواہ وَدھی۔
ہاں، مےٚ چھُس تہِ تَمہِ پٲٹھۍ سٲنۍ—سُہ سٲری گِرٛے آُس تہٕ کینہہ تَمہِ پٲٹھۍ۔
یَلہِ مےٚ دٕژ پنُن کُتھُر پٲٹھۍ دِیوان پٲٹھۍ، مےٚ نَہ یِوان پننٕن دۄدٕن پٮ۪ٹھ یقین۔
تِم، تِم عام طور چھِ سٲری مٕٹھی۔
بہٕ تُہۍ کُن ذرا تہِ قصور نَہ دَوان۔
مےٚ کٔنِہ پٲٹھۍ ہَفتہِ منز پنُن لٔڑکۍ جَنم دِن۔
مےٚ سٲری دوستن ہٕنٛز چھِ مےٚ کھۄتہٕ نٔر کار۔
کیاہ تُہۍ زندگی منز مصروف چھِو، یا دلہٕ منز نَہ یِژھان گژھِتھ؟
جڈٕ میٚنۍ والدینن کالیج گریجویشن ہٕنٛد تحفہ طور پٮ۪ٹھ مےٚ کار دٔژ، بہٕ حیران گژھمُت۔
مےٚ کارن منز سفر کرُن خاص پسند نَہ۔
اوہ چھُ سُہ، تمنۍ کیاہ کٔرِو ییلہٕ سُہ چھِ دور؟
کاشِر اسہِ برطانیہ ہٕنٛدۍ طرح ہر جاے سی سی ٹی وی کیمرہ آسِتھ۔
ہاں، میٚنۍ لُکھ بہٕن تِم تقریبن ۳ ؤری زٕنۍ اوس۔
لگِ چھُ زِ تٔہۍ تہٕ تُہٕنٛدِس والدس منز سُہل رشتہٕ اوس، تہٕ کُنہِ کُنہِ خاندانن منز یہِ نَہ گژھان۔
تُہۍ چھِ زانان، یہِ چھُ مزاحیہ کیازِ بہٕ کٔرمُت۔
مےٚ پسندیدہ کھاونن منز چھُ اکھ سٹیک۔
مےٚ رٛونٛگٕٹہٕ کَھڑٕ گٔے۔
مےٚ محسوس کٔرِ تِمۍ سارنی نظر مےٚ پٲٹھۍ اوس۔
مےٚ گرل فرینڈس چھُ نَو یوگا انسٹرکٹر۔
مےٚ چھُ یقین زِ تٔہۍ تَمہِ وِزِ یہِ نَہ آیہِ پسند۔
بہٕ سِرف کانٛہہ نَو کٔرِتھ تیار اوسُس۔
دۄہِک تقریبن اَردھ حِصہٕ گژھِتھ ییلہٕ کانٛہہ سٕنٛدۍ طرف دِژ، تَتھ وِزِ پتہٕ لَگ۔
کیا تُہۍ کَنہِ وِزِ دُکانہٕ پٮ۪ٹھ ٹافی چور کٔرمٕژ چھِ ییلہٕ تُہۍ اوسِو لُکھ؟
سُہ چھِ سُہ وقت مےٚ پٮ۪ٹھۍ سٕنٛدۍ چیز حٲصل کَران، بہٕ یہِ نَہ سَہہ ہیکان۔
تُہۍ کِنہِ قِسمُک کاروبار چَلاوان؟
کَنہِ نَہ چھُ خراب، ماجہِ آسہِ یا باپہِ—سُہ چھِ صِرف اکھ وَنٛس لُکھ گژھان۔
مےٚ نہٕ اوس مقصد زِ تٔمۍ ہٕنٛد گلاس ٹوٗٹِتھ، مگر بہٕ پٲٹھۍ ٹوٗٹمُت۔
ہفتہٕ ہٕنٛدِس آخرس منز بہٕ ذرا ڈرِتھ اوسُس۔
کیازِ کہ یہِ اوس اَسہِ کلاینٹَس منز یہِ تقریر کہِ تِم کِیازِ اَسہِ سۭتۍ رُہن
مے چھُس پیکنگ شُروع کٔرمُت
مے اوس واریاہ پریشان ییلہِ مےٚ دوستَن پنُن شۅہر کھوٚر
مےٚ چھُس اُمید کران زِ سُہ ٹھیک گژھِ
آ، حالات اوس غٲر متوقع، مگر شاید میون ٹیسٹ اوس فالس پازیٹو
تُہۍ ہٕنٛزِ آیندٕک کُنہِ تہِ کاروبٲری کوششِ خٲطرٕ نیک تمنٛا
ییلہِ تُہۍ چھِو بھوکھ، تہِ کٲم کٔرُن چھُ مُشکِل
سُہ اوس میٚن خاطرٕ تہِ اَکھ گۄڈٕ وقت
مےٚ چھُس پُرامید زِ سُہ ٹھیک گژھِ
ہا ہا، وَاہ، میٚ چھُس شرط لَگان زِ تُہۍ ہٕنٛزِ زندگی منز کَدٕن تہِ کُہنٛہ بور لمحہ نَہ آیہ
بوٚد افسوس زِ تُہۍ گژھِو اِتھۍ وار مایوس
مےٚ اوس سۄچان زِ اَسۍ دوست بَنی گژھِو
مےٚ نَہ ہیکان تُہۍ ملامت کٔرِتھ، مےٚ چھُس جانان زِ مےٚ تہِ پَکّا نَہ کٔرِتھ
مےٚ چھُس سۄچان زِ وۄنۍ پَتہٕ اصلی سٹاکَن سۭتۍ کھیٚلِتھ
مےٚ چھُس وۄنۍ اکانٲمی بٲبتھ گۄڈٕ محسوس کران
میٚن بہٕن ہُنٛد دوستَن نَہ دِت دعوت پارٹیہِ، تِمۍ سۭتۍ سُہ کٔرِ بور محسوس
مےٚ چھُس پَکّا جانان زِ سُہ تہِ تُہۍ بٲبتھ تَمیس پرکار محسوس کران
اَسۍ اَسہِ دوستَن ہُنٛد والِدین ہُنٛد کار نیٚتھ
ییلہِ مےٚ اوس سکولس منز، مےٚ کٔر اَکھ اہم اِمتحان خٲطرٕ واریاہ گۄڈٕ مُطالعہ
پتھ ؤنتھ رۄزُن کَتھ تہِ نقصان نَہ۔
مےٚ پیٹھ چھُس محسوس کران زَن تتلی ہا اڑان۔
تہٕ تُہۍ چھِو سٲری اتھٕے مقدار پٲٹھۍ پران۔
امید چھُ کہ سُہ تُہۍ آرام کرِتھ ہٕنٛدِ کٲفی وقت پٲٹھۍ تھہٕرمتھ آسہِ۔
مےٚ کَتھٕے تہِ بیاکھ مردس کُن نَہ چھُس نظر کرمٕت۔
نٔو کار چھُس گٔژھمٕت، نہٕ ژٕنہٕ کار تہٕ نہٕ مسلہٕ۔
تُہٕند اگلا مقصد کیا چھُ؟
کَل مےٚ کینہہ دوستن سۭتۍ مٮ۪لٕنۍ کوٗشش کٔر، مگر سٲری ہٕنٛدِ کام آس۔
مےٚ کَنہِ پنٛنۍ ڈگری حٲصِل کران، مےٚ چھُ بُتھ اعتماد محسوس کران۔
کافی عرصہ گٔیو، مےٚ دوست نَہ چھِ دٮ۪تھ؛ جھیل کِنۍ گٔے آسہِ کٲفی مزٕ۔
یہِ چھُ اکھ بُرٕ چکر بنِتھ ہیکان۔
پنٛنٮ۪ن بیی سۭتۍ تِہِ لمحہٕ دۄبارٕ جٮ۪وِتھ چھُس کٔرمٕت، سۄ چھُ بُتھ یادگار آسٕن۔
مےٚ پنٛنٮ۪ن بینٛک فون کٔرِتھ پزِ ژٕ سۭتۍ پتہٕ لاگُن۔
مےٚ چھُ یقین تُہٕند خاندان چھُ تُہٕندِس پیٹھ فخر کران۔
مےٚ چھُس پنٛنٮ۪ن صحتِچ مسلہٕ سمجھنٕچ کوٗشش کران؛ بُتھ تحقیق کرِتھ چھُس محسوس کران زِ مےٚ ہَے ٹھیک کرِتھ ہیکان۔
مےٚ چھُس سانان، اَتھ پَتہٕ چھُس نَہ ژٕرۍ بچہٕ کرُن۔
دغا سۭتۍ گژھُن چھُ بُتھ خوفناک۔
مےٚ دٔفتَرِ منز نٔو سرٹیفیکیشن خٲطرٕ ٹیسٹ دِتھ۔
آ، تُہۍ دِسان تہِ کینہہ ؤری یِم کن جوان نظر یِوان۔
سُہ چھُ فوجس منز کِس قٕسمُک کام کران؟
اَسِہِ ضوٗر یہِ کٔرِ محنت۔
مےٚ نَہٕ تھٔو انتظار یِتھ پَزِ امیوزمنٹ پارکَس گژھُن۔
اَس دوہ ہفتہ پَتہٕ تَتھ پٮ۪ٹھ واپس آو، اَس مِرامار بیٖچَس منز رُک تھو۔
آ سُہ، تۄہہِ سۭتۍ گژھِتھ باتھ کرُن ختم کٔرِتھ۔
آ، بہٕ چھُس یِتھ کَم وِقتھ پٮ۪ٹھ؛ مےٚ سۄنٛچ مےٚ آو حق۔
شاید تُہۍ پنٛنِس باس سۭتۍ میٖٹنگ ہِک طلب کٔرِو تہٕ تَتھ پٮ۪ٹھ پٲٹھۍ گژھِو۔
یہِ چھُ اَسٕل اَنگرٛیزی بُنیاد پٮ۪ٹھ ٹیسٹ تہٕ سُہ چھُ اَنگرٛیزی منز واتان۔
اوہ، آیہِ تھو، مگر مےٚ سۄنٛچمُت یہِ خاموش گژھِ۔
کَنٛہہ کَنٛہہ چھُ پنٕنِس خٲطرٕ تھوڑا وقت کٲڈُن سُہ۔
مےٚ چھُ نہٕ سۄبُرۍ یِوان یَتھ وَقتھ لوٗگ ٹریفکَس منز مےٚ کَٹ کٔرِتھ گژھان۔
بہٕ پَزِ دٮ۪کھُن زِ تُہۍ یہِ اَتھُر وٲرِ کٔرِتھ ہٮ۪کِو۔
مےٚ چھُس کینہہ باسان عجیب آواز یِوان سَمُن یِوان پنٕنِس بیٚسمٮ۪نٛٹ پٮ۪ٹھ۔
ہیکہِ دۄہ مےٚ پکڑِتھ ڈٮ۪ٹھ مِتٕر یِم مےٚ گرل فرینڈَس چُمی دِوان۔
بہٕ چھُس پنٕنِس گَرِس منز تَمہِ خٲطرٕ تھوڑٕ جاے صاف کَران۔
مِتٕر مےٚ چھُ اَتھ نَون گٲڑی نِنمُت یِم مےٚ چھُس کینہہ مَہینن پٮ۪ٹھ یِوان اَرژان کَرنُک کوٗشش کَران۔
نَہٕ تَمہِ بانکَس سۭتۍ۔
اَس چھِو اَشویٖل گژھان کینٛہہ نَویٚن بریوٗریو خٲطرٕ۔
بہٕ ٲسُس پنٕنِس گوٚڈنِس بلاینٛڈ ڈیٚٹَس پٮ۪ٹھ۔
تِم ٲسِہ ہیکِس ٹیمَس سۭتۍ، یِمن خٲطرٕ مےٚ چھُس سۄنٛچان زِ یِہِ چھِ ٹیم بِلڈِنٛگ والۍ۔
مےٚ چھُ نہٕ صبر یِوان زِ سُہ وُچھاون یِلہٕ سُہ بڑ ژھٲ
مےٚ بای فرینڈن کھیٚلِتھ وِڈیو گیم، ساری رات مےٚ جاگرٕو
مےٚ چھُ سٲری وارٕ کٔرِم ڈرایِوِنگ ٹیسٹ خٲطرٕ مطالعہ
کیا تِمۍ کِنہہ اِنٹرؤیو دِتمٕژ چھِ
گٔوٚ واپس گیمس منز
شاید کینہہ وقت لَگِ، مگر مےٚ چھُ پیسَن خٲطرٕ واریاہ شُکرگُزار
آ، یِلہٕ تُہٕنٛدۍ بَچٕہ کینٛہہ حٲصل کَرن، أسۍ والدین چھِ واریاہ خوش گژھان
مےٚ اوس ماہِک بہترین مُلازِم ایوارڈس خٲطرٕ نامزد کٔرمُت
اوہ مےٚ، کیاہ چھُ گژھمُت
مےٚ چھُ بلکُل، مگر چھُ ڈر زِ اتھِ پانٛٹھۍ چھِ باقی لوٗگ فِدا گژھان
تُہۍ کِس قِسمُک ڈایِٹ چھِ کَران
یِہِ کٔرتھ چھِ سُہ واریاہ خراب ژوٗٹ بولن وٲلۍ
مےٚ گٔے اوس راتھ ڈِنیَر کھاون خٲطرٕ باہر، تہٕ سُہ اوس واریاہ شاندار ریسٹورینٹَس منز
سِرف تِمۍ ہٕنٛز فِکر کٔرتھ چھُس مےٚ ذرا مسکان یِوان
