مے چھُ یقین زِ مٲنۍ نتیجہٕ گژھِن پچھلے ؤریہِ ہٕنٛز بہتر۔
ہِرِکین سیزن شروع گژھِتھ چھُس مےٚ احتیاط طور تیار گژھُن کوٗشش کران۔
کیا تُہۍ گژھو اوٗپر یہِ چٲونہٕ کِ لِیک چھُ یا نہٕ؟
یہِ چھُ سٲری سُندر، کیا تُہۍ تقریر دِوان؟
بہٕ چھُس أکھ دارِ پٲٹھۍ ژٔلِتھ۔
بہٕ ہٕک ریسٹورَنٹ پٲٹھۍ ہیمبرگر منگٲوم، مگر سُہ اندرٕ سٕے چھُ کَچّہٕ آوُر۔
بہٕ چھُس یِمِس ہفتہٕ آخرس سکای ڈایونگ کرنہٕ خٲطرٕ بلکل تیار۔
بہٕ آوُس تَمہِ سٕتۍ کافی مطمئن۔
سُہ ضرور واریاہ مزٕ دار آوُر۔
مےٚ چھُ خوش زِ تِم چھِ ژٕر گنٛٹَن ہَوان سفرٕچ دوری پٲٹھۍ۔
بہٕ اوسُس پنٛنٕن والدینن ہٕنٛز وٲرِی البم وُچھان تہٕ یاد کران تِمَن زِ تِم کَتھ کٔنۍ جَوان آوُن۔
یہِ چھُ اَسہِ سٕتۍ کَم اَز کَم أکھ دَفعہٕ زِندگی منز گژھان۔
یَلہِ بہٕ اوسُس شُرٕعٕچ ٹین ایجس منز، بہٕ کران اوسُس یِہِ کٲم پنٛنِس مٲمس سٕتۍ ہر وَقت۔
بہٕ کرِ سُہ اَنٛدازٕ زِ سُہ احساس کِتھ کَنۍ خۄشی دِوان آوُر۔
یہِ چھُ سٲری نَہ سُہندِتھ۔
مےٚ چھُ لگن زِ ہای سکول تہٕ تَمہِ ہٕنٛز سۭتۍ پٲٹھۍ تعلیم چھِ واریاہ ضٔروری، کالج تہِ۔
کیا تُہۍ جانان زِ سُہ کُن قِسمُک ناگ آوُر؟
مےٚ کَتھٕ نہٕ ؤنٛدۍ سوچِتھ کہٕ بہٕ کِہِنۍ چیٖزِ ہُنٛد اِتھ حفاظت کَرِتھ ہیکان۔
بہٕ کینہہ دَفعہ گژھِتھ، مگر صرف کٲمٕچ خٲطرٕ، تِمۍ سۭتۍ کَتھٕ نَظَرٕ نِش کَتھٕ چھُ نہٕ دِتھ۔
اوہ مےٚ، تِم کِتھٕ نہٕ ہیکن اَکھ وقت مُقَرَر کٔرتھ تَمہِ پٲٹھۍ پابند رۄزِتھ؟
واہ، سُہ ضروٗر اَکھ اطمینان دِن وٲلۍ پیشہٕ بَنِ۔
میٛون پارٹنر اکثر دۄہن منز تھیرپی پٮ۪ٹھ سخت محنت کران، مگر سُہ ابھی تام ٹھیک گژھنٕچ نزیک تہِ چھُ نہٕ۔
او ہا، خاص کٔرِتھ راتس نِنٛدرِ وِزِتھ گَرٕج تہٕ بُرق نِش باران۔
مےٚ اَز طٕلبہٕ رجسٹر کَران دِتھ۔
اَسہِ ہُنٛد وقت گوٚو بہٕ تَمہِ خاص۔
یِمِچ عادت بَنانٕچ کینہہ وقت لَگان۔
کیا تُہۍ ژٕنۍ نَہِ کہٕ تِمۍ ہُنٛد اَثر چھُ زَنانَن پٮ۪ٹھ؟
اَز میون پٲوَن ہٕنٛد پٲٹھۍ لَگِتھ تہٕ بہٕ گوٚو بَہت پَریشان۔
تُہۍ کُن کھیٖل پسند کَران ؤنۍ؟
مےٚ چھُس جانان زِ تَمہِ نِش بَرٕیِتھ گژھُن چھُ بَہت مُشکِل۔
تُہۍ تَمہِ بارَس منز پَتہٕ کِتھ پٲٹھۍ سوچان؟
سُہ چھُ اصل منز بَہت خراب حِصہٕ۔
نٔوۍ کار جِتنس خٲطرٕ مےٚ ۱۰ ٹکٹ کٔنۍ۔
اَسہِ اپائنٹمینٹ آسِتھ تہِ میٛون ژوٗن وٮ۪ٹَر کَنِ نٮ۪برِتھ خٲطرٕ سٲری دۄہ اِنتظار کَرُن پَڑِو۔
ہا دوست، تہٕ میٛون تہِ چھُ یِژھان زِ سٲری ہٮ۪کن یِمن پٲٹھۍ آسِتھ۔
تِمۍ دۄہ میٛون ژوٗر پنٛنِس دوٚیِم جماعتُکِس ہِجّے ہِجّے مقابلَس منز دوٚیِم مقام حٲصِل کٔر۔
بہٕ گژھان چھُس تَمہِ خٲطرٕ اَکھ گفٹ کارڈ گژھِتھ۔
تَمی باغ تہٕ درٛاو
بے اِحتیاط تہٕ بے ذِمہ دٕل ہاوٕنہٕ آم تہٕ پانٕہ پٲٹھۍ شرمسار چھُس
ہاں، مےٚ چھُس گژھان؛ مےٚ چھُس واریاہ بھوٗک تہٕ میون ہَتھ چھِ کَمپان
ہاں تہٕ بہٕ چھُس بلکل تیار
اُف، سُہ ضرور واریاہ بے آرام تہٕ دِقّت وول آسہِ
سُہ ۱۴ ؤرۍ مےٚ سٕتۍ اوس
نوٚ جایہٕ واریاہ وُزُل نَہ، مگر مےٚ خٲطرٕ بلکل ٹھیک چھِ
شاید تُہۍ گژھِ تِمٕس سۄ باتھ وُنُن، تاکہ دۄیمہٕ لٹہِ سۄ تَمہِ وِزِ آیہِ یُس تُہۍ وٕقتھ اوس
آخرکار مےٚ پنٛنِس نوٚنِس نِکٕر پِلوٕس تٔمِس پہلِی کَرتَب سِکھٲو
مےٚ لگہِ چھُ کہ پیش کرنہٕ خٲطرٕ چھِ أسۍ سٲری کینٛہہ حٲصِل کٔرمُت
سکوٗل شروٗع گژھِ تِتھِ مےٚ نؤکری ژٲرِتھ
مےٚ آس چھُ کہ اتھ دوران نَہ کٔرِ واریاہ نقصان
آزکل تُہُنٛد کاروبار کِتھ پٲٹھۍ چَلان چھُ
تَمہِ پٲٹھۍ نَظَر کٔرِتھ مےٚ چھُ بس عجیب محسوس گژھان
مےٚ پَتِہِ مےٚ ترٛٲوِتھ گٔژھِ نِش، تِمِس کٔر میٛون خٲطرٕ پانٕہِ باہہ تہٕ دِل وُدٕر
مےٚ لگہِ چھُ کہ میٛون سٕسرالِی چھِ واریاہ خراب والدین؛ کینہہ لوٗکھن ہٕنٛدۍ گژھِ نَہ آسُن بچہٕ
تُہۍ گژھِ تِمِس یِتھ خٲطرٕ راضی کَرُن
مےٚ سۄنٛچان اوسُس کہ بوزِتھ مےٚ مَرِتھ گژھِ یِتھِ پٲٹھۍ
مےٚ لگہِ چھُ کہ مےٚ چھُس تَمس کینٛہہ دِتھ دٕین
ہاں، بٔچِ چھِ تَتھ سۭتۍ واریاہ خوش نَظَر یِوان
مےٚ نہٕ لگہِ چھُ کہ بہٕ واریاہ وقتھ پٲٹھۍ کَنہِ جملس منز پنُن ‘فلیمِنگو’ لفظ تہِ استعمال کٔرۍ مت۔
بہٕ دُکانس منز ٲسُس تہٕ میون بٹوہٕ پٔتھ۔
مےٚ چھِ نہٕ پنٛژن ؤرین پٲٹھۍ پنٛنۍ نٲنی/دادی دِژمُت۔
یہِ چھُ بٔڈ خراب، کیازِ مےٚ نہٕ ہیٚکِو پنُن بلی دِژِتھ۔
ٹھیک چھُ، چورِ کرِتھ مزٕ کَرِو۔
شاید بہٕ باہرس گژھِتھ مٲٹِہ کھاونُک کوٗشش کَرِو۔
گٔے راتھ بارس منز بہٕ ٹھوکر کھٲوتھ مُکھ پٲٹھۍ پٔتم۔
اَز دواہِ ہٕیِتھ مےٚ سُہ آرام محسوس کٔر۔
اَکھ دفعہ ریلِہ منز اَکھ سونہٕ کٲشرِ کُنِی سٕنٛدِس برونٛہہ مےٚ گیس چھوڑ۔
ہاں، بہٕ ہمیشہ ریویو تہٕ لوٗکن ہٕنٛز ذاتی راے پٲٹھۍ دھیان دِوان؛ یہِ اکثر بےقیمت آسِتھ۔
تِم چھِ مےٚ ہمیشہ ہوشیار تھاوان۔
مےٚ پنٛنِس ماجہِ کوٚر کُوٹ۔
مےٚ سُہ اَکھ پرٛونِہ جاسوسی ناولَس منز نِش لَب۔
مےٚ چھُ لگُن شروع گٔمُت زِ سُہ کَتھ تہِ واپس نہٕ یِہ۔
کہاوت چھِ، پنٛنِس گھاسس پانی دِیو۔
میون نِنٛہہ بچہٕ وُنِ نَچان چھُ۔
بس شمالی طرف کینیڈا کُن گژھان چھُس۔
مےٚ چھِ پنُن پرٛون کُتُہٕ یاد یِوان۔ مےٚ اوس خیال زِ اَکھ بیٚیہِ گژھٕن، مگر مےٚ چھُ نہٕ یقین۔
نٔوِس کمپنی منز شامل گژھنس کِنٛہہ اَکھ رۄز پٲٹھۍ پتہٕ مےٚ ترقی مٔلۍ۔
اَز میون پیٹ خراب اوس تہٕ سٹاف میٹنگ دوران غلطی سٕتۍ گیس نِکل۔
شاید سُہ تُہۍ سۭتۍ بَہَر گژھن ژٕاہان
کیا سُہ عام طور چھُ مُشکل چَلُن
کیا تُہۍ تِمَن فون کٔرِتھ شِکٲیت
مےٚ چھُس وۄنۍ زانان یہِ خراب چھُ، مگر مےٚ چھُس صِرف یہِ بِلڈِنگ پنٕنۍ خٲطرٕ ژٕاہان
مےٚ زٕنۍ کٔر مےٚ سۭتۍ کَتھ زِ مےٚ ژٕاہِ اَسُن اُمید زِ سُہ شِپمٮ۪نٛٹ ژٕٹۍ یِیہِ
مےٚ کُٹمٕن پٔچھ مےٚ کَتھ پٮ۪ٹھ یہِ ژٕٹۍ
یِم کَمپنی خٲطرٕ مےٚ چھُس کٲم کران، سُہ دِیِہِ اَسہِ بونس
مےٚ غُصہٕ دِلٲونٕے خٲطرٕ، ہاں
مےٚ چھُس اَزکَل تھوڑا اَکیٛلاپَن محسوس کران
سُہ ۲۴ ؤریٛہِ کَنۍ ٲس
یہِ چھُ بٔڈ دُکھ، اُمید چھُ زِ کانٛہہ نہٕ گژھِ یُس تُہۍ نَہ بدلٲوِتھ ہٮ۪کِو
ایِتھ بٔڈ خراب اِنسانی خٲصیت
اگر مےٚ کانٛہہ وۄنۍ نہٕ رٲڈِتھ، مےٚ گژھِ ٹھیک
ہاں، تُہۍ خٲطرٕ سٲری نیک تمنٲی
یہِ چھُ، مگر چھُ اِتھ پٲٹھۍ زِ مےٚ چھُس وۄنۍ نہٕ زانان کِژھ کرُن
مےٚ چھُس وۄنۍ وۄنۍ پنٕنۍ کٲمٕچ کٲغژَن پٮ۪ٹھ سٲری کافی ڈٲلِتھ
ٹھیک، مےٚ چھُس اُمید کران زِ تُہنٛد خواہش پٲر گژھِ
کاش اَزکَل کَسٹمَر سَروِس اَجٕہَر بِہتَر ٲسِ
مےٚ چھُس اُمید کران زِ میون لٔڑکہٕ اِمتحانَس منٛز پاس گژھِ
مےٚ سٲنۍ ٲس زِ اَسۍ نٔزِیک ٲسۍ
مٔہنجِ ساس ہٕنٛدِ موتٕس سٕتۍ سامنا کرُن اوس مُشکل۔
مٔہنجِ خاندان چھِ مٔہنجِ خٲطرٕ سٲری کینٛہہ۔
بہٕ چھُس تَمیو، بہٕ چھُس تیز کٲشر گژھان۔
یِہ ؤرۍ چھُ سٕبہٕ کھۄتہٕ خراب گژھان۔
مٔہنجِ محلہٕس منٛز ہر کٲن چھِ مٔہنٛدِ کھۄتہٕ سُندَر گاڑی چَلان، یہِ حقیقت چھِ مےٚ سخت نَفرت۔
سُہ چھُ اکھ سٲری خبر۔
تُہہِ چھِو کُتھ یِم سپیکٹرمس پٮ۪ٹھ؟
تُہہِ کُس کورس چھُ کَران؟
بہٕ ابھی ہسپتالہٕ پٮ۪ٹھ گَرٕ آو، تہٕ أسۍ مٔہنج پہلِ اولاد سٕتۍ آو۔
مےٚ چھِ دُکھ گژھان یہِ ژٕنِتھ زِ تَمہِ ہٕنٛدِ دۄہ چھِ گِنٛتِس منٛز۔
کیا چھِ تَمہِ کُٹمُبُک کٕہنٕہ یِم تُہہِ تَمہِ ہٕنٛدِ حال پٲٹھۍ کَرِتھ فون؟
تَمہِ ہٕنٛدِ خٲطرٕ سُہ آنُن اوس تَمہِ ہٕنٛدِ واریاہ نِیٚک۔
سُہ چھُ واریاہ ٹُٹمُٹ، مگر مےٚ چھِ امید زِ أسۍ سُہ ٹھیٖک کٔرتھ سُہ نِیٚک گژھِ۔
گرٕمی چھِ لگ بگ ختم گژھان۔
تُہنٛدِ دۄہِ نُور دِوُنہٕ خٲطرٕ ڈاک سٕنٛدِ کٕہنٕہ چھُ نِیٚک نِہ۔
مےٚ چھِ یقین زِ سُہ اوس تُہنٛدِ سرٕ پٮ۪ٹھ اکھ بٔڑِ فکر ہٕٹاون۔
مگر وۄنۍ بہٕ چھُس پنٛنہِ بٔہترِن روپ بنٛاونٕچ کوٗشش کَران، تاکہ آخرس منٛز تِمَن ہُنٛد حق واپس دِتھ سکان۔
سُہ کینہہ مُشکل حالتن منٛز گژھان اوس، یِمِہ خٲطرٕ مےٚ اوس تَمہِ تہٕ تَمہِ ہٕنٛدِ کُتُرُک خیال تھاوُن۔
کلیرنس سامان حٲصِل کرنٕچ خٲطرٕ یِہ ہفتہ اوس نِہ نِیٚک۔
مےٚ چھِ یقین زِ اگر تُہہِ کینہہ واریاہ گَنٛٹہٕ کام کٔر، تُہہِ ہٕنٛدِ خود اعتمادی بٔڑِ۔
نٔوٕ نوکری خٲطرٕ مےٚ دوٚیِم انٹرویوک جواب یِوان ہُنٛد انتظار چھُ۔
وَلہٕ، یہِ تُہۍ ہُنٛد واریاہ خراب اوس۔
یہِ اکھ بٲچہِ ہُنٛد قصہٕ چھُ، یُس اکھ جادوٕنی مچِھ لبان چھُ تہٕ تمہِ سٕتۍ پیار تہٕ حفاظت کرُن چھُ۔
سارِو کَنٛۍ مَچھَر تہٕ اَنتڑٕ پٲٹھۍ پَتھری اوس۔
اُف، کینٛہِ تہٕ قٲمتہِ پیٹھ یہِ رشتہٕ ختم کٔر۔
مےٚ خوش چھُ زِ تُہۍ تمِس نِزدیک تھاو۔
لَگٕ چھُ زِ تمن اوس بچپنک دوٚست۔
تَمِس پَہلِ ڈرایونگ ہُنٛد سبق اوس۔
مےٚ اکھ بٲچہِ سٕتۍ واریاہ پسند اوس۔
اوہ، مےٚ یہِ پَرنہٕ چھُ۔ یہِ واریاہ سُہ کتاب چھِ، فلم تہِ مےٚ مزٕ آیہِ۔
آ، مگر مےٚ اکھ دوٚست ہُنٛد انتظار کران چھُس۔
تُہۍ تمِس سٕتۍ دغا کِتھ پَتھ کٔر؟
مےٚ پنٛنٮ۪ن دوٚستن سٕتۍ راتِچ کھٲنہٕ خٲطرٕ باہَر گژھان۔
مےٚ یقین چھُ زِ تُہۍ واریاہ پریشان چھِو۔
مےٚ شرط لَوان چھُ زِ تُہۍ تِمَن واریاہ یاد کران چھِو۔
یہِ سُہ چھُ زِ تُہٕنٛد والِدین تُہۍ خٲطرٕ یہِ کٔرِتھ ہٮ۪کۍ۔
مےٚ پنُن گوٚڈٕ ژٕل تہٕ مےٚ پنُن کھٲنہٕ کٔر پَتھ۔
مےٚ چھُس یِژھان زِ اَز اکھ سُہ میچ گژھِ۔
آ، یہِ چھُ پَہلِ بار زِ مےٚ تمِس سٕتۍ چھُٹۍ گژھان۔
اَسہِ ژٕ دوٚپٲٹھۍ چھُٹۍ گٔمُت، تَمہِ خٲطرٕ مےٚ خیال اوس زِ یہِ کم گژھِ۔
آ، تہٕ اَسۍ ہنٛز والدین چھِ اَسہِ محبت کران
مےٚ چھِ یِوان محسوس زِ مےٚ ہُند بٔڈ برٛور گژھِ سٲری محبت
سُہ ٹھیک گژھِ، سُہ چھِ اَکھ لڑن وٲلۍ
مےٚ ہُند جنم دِہ چھِ دسمبرس منز
مےٚ چھِ اُمید زِ تِم تَتھ وِزِ سُہ کار کَرو
مےٚ گٔژھ مےٚ ہُند کھٲنہٕ دِتھ متاثر
وَنان چھِ بَد لٲگان، مگر مےٚ چھِ لگٲن زِ سُہ موقع گٔی چھُ گژھِتھ
مےٚ ہُند بٲیہِ یِتھ پٲٹھۍ ژٕٹ بڑٕ گژھان دِژھُن چھُ آسان نہٕ
یَتھ وِزِ اَسۍ گژھُن ہٕند پلان کَران، ویک اینڈس منز چھِ ہمیشہ ژٕر باران
کَتھ کَتھ چھُ سُہ ٹھیک، مگر تِمِس خٲطرٕ چھُ باہر نِکلسُن تہِ ضٔروٗری
مےٚ ہٕند بچہٕ کَتھ کَتھ گژھن تہٕ مےٚ ہٕند نوِس ہمسٲیہِ ہٕنز گَرِ کھیلان
ٹھیک، مےٚ چھِ اُمید زِ تِمِس یِہِ حٲصل گژھِ یُس سُہ ژٔٹان
مےٚ کٔر مےٚ ہٕند والدین ہٕنز گَرِ پیٹ بھرِ کھٲنہٕ
یَتھ مےٚ گٔی کامہِ پٲٹھۍ ژٕٹ نِکلسُن، مےٚ گٔی خوشی
یَتھ سُہ گٔی گژھن، تَتھ وِزِ مےٚ ٹیلیوِژن دِژھ
مےٚ ہٕند پُرانہٕ دوست چھِ مےٚ خٲطرٕ شہر پار کرِتھ تہِ گاڑِ نہٕ چَلاوان
تَتھ پٲٹھۍ رِسُن منز لٔگ مےٚ تِہِس سال، تہٕ مےٚ چھُ نہٕ صبر یِوان
رخصتھِ ہٕنز منظوری مِلنہٕ سُہ گٔی سُہتھ
مگر یَتھ مےٚ ژٕٹ چَکان، تَتھ چھِ اچار
مےٚ چھُ انٹرویو ہٕند سوال پرٛان تہٕ مےٚ چھُ مےٚ ہُند ریزیومہٕ پرنٹ کٔرتھ تھٲوتھ
تُہۍ دوستن سٕتۍ کیا کٔرِو؟
یہِ تٔھۍ جاری تھاو، کیازِ آزادی چھِ سبنِس مٔٹھ چیز۔
کیا کَدٕچِھ تۄہہِ یہِ سٲنۍ لگِتھ کہ تُہۍ کانٛہہ سٕنٛز جانٛو، تہٕ پتہٕ تِمَن ہٕنٛدِس گَرِ گٔژھِتھ پتاہٕ لَگِتھ زِ تِم چھِ سامان جمع کٔرِتھ تھاوان؟
کیا تُہۍ کَدٕچِھ تِمَن سٕنٛز بلکل نٔزیٖک گٔژھِو؟
یہِ چھِ سٲنۍ دِل چھُنے والی کہٲنی لَگٕنۍ۔
تِم یہِ کٮ۪از کٔرِتھ چھِ؟
یہِ نوسٹالِجِک جَذبات چھِ نِشٲنی تہٕ محسوس کٔرنس منز چھِ واریاہ خوشگوار۔
گٲڑ گژھِتھ صاف کٔرنس منز کینٛہہ وقت لَگ۔
اَسۍ وٲنہہ گژھنہٕ پیٚٹھ میٛٲنۍ بیٛیِہ چھِ واریاہ فلرٹ کَران آسٕنۍ۔
مےٚ چھِ یقین نَہ یِوان زِ تِمَن مےٚ کٔڈمُتھ اوس ٹیمہٕ منز۔
مےٚ کٔر ہفتن تام پَران تہٕ لیکچر دوبارٕ وُچھ۔
کانٛہہ لوٗکھَن چھِ کَنہہ چیٖز یا کانٛہہ سٕنٛز ذرا برابر عزت نَہ۔
بالکل، وۄنۍ چھِ واقٕعی واریاہ دُکھی وقت۔
کیا تُہۍ سانو زِ تُہۍ کُتہہ چھِ غٲر صحت بخش کھٲنہٕ کھاوان؟
کیا تِمَن تُہہِ کَس مٲفی مانٛگ؟
واہ، تِم ضٔروٗر واریاہ بُوکھ اوس۔
کامُک معاملہٕ ہٮ۪کَن واقٕعی واریاہ ذہنی دباؤ دِتھ۔
سُہ چھِ کینہہ گھِنٛاون لَگان۔
مےٚ چھِ تِم سٕتۍ واریاہ نفرت۔
مےٚ گٔژھِ تِمَنٛز ڈارم روم، تہٕ سُہ اوس واریاہ سُندَر۔
مےٚ یہِ نٔو ریسٹورَنٹ گٔژھ تہٕ یہِ کمال آسہٕ۔
کم نصیب لوٗکن ہٕند مدد کرنہٕ خٲطرٕ مےٚ اکھ سوپ کچن منز کٲم کور۔
یہِ پِلّہٕ اَتھ پٲٹھۍ بٔمار گٔژھ زِ کینہہ دۄہن منز مُر۔
مگر یتھ خٲطرٕ زِ تَمہِ کُن کانٛہہ قرضہٕ چھُنہٕ، سۄ میکڈونلڈس منز کٲم کٔرتھ تہِ آرام سٕتۍ روزِتھ ہیکہٕ۔
میٛون شوہر گٔژھ کینہہ دۄہن خٲطرٕ شہرٕ بٲیہِ۔
او ہاں، یہِ واریاہ ناگوار آسہٕ۔
بطخ چھِ ڈراون، مگر یہِ تُہۍ کُن زیادہ ڈرنہٕ چھِ بہٕ نسبت زِ تُہۍ تِم کُن ڈرِو۔
فُٹبال میچس خٲطرٕ مےٚ چھِ وُچھمتہٕ برسَن پیٹھ ٹریننگ کٔرتھ۔
مےٚ چھِ نہٕ پسند اندھیٛار یا زور شور۔
یِم کینٛہہ چیزس پیٹھ یقین تھاوان چھِ مےٚ پورٕ پورٕ محسوس کران۔
تُہۍ کِنٛہہ وارِ تَتھ روزِو؟
تُہۍ کَرو تُہِند برادَر سٕتۍ ذرا سختی۔
سُہ چھُ گوٚڈے کمیونٹی کالجس منز سمر کورس کران۔
واہ، یہِ چھِ اکھ گۄڈ وٲٹ۔ تُہۍ پنٛنِس ۱۰ فیٚصد سٕتۍ کیاہ کٔرِو؟
مےٚ آس وچھان تَتھ گژھُن، مگر بلیک فرایڈے دۄہن منز تَتھ آسہٕ واریاہ بھیڑ۔
اَز مےٚ کٲم پٲٹھۍ گژھنہٕ خٲطرٕ جلدی منز ٹریفک منز اکھ گٲڈِوان کَٹ کور۔
مےٚ کوٚشش کٔر زِ یہِ کینٛہہ نَہ آو، مگر مےٚ آسہٕ واریاہ شرمندٕ۔
یہِ بدلٕنۍ خٲطرٕ ۵۰۰ خرچ کَرُن وُضاحت چھُ۔
کاش کَنہہ مےٚ اکھ وار سرپرائز دِتھ۔
مےٚ چھِ سَدا فکر زِ کانٛہہ مےٚ نہٕ چُبِو یا مےٚ ژھٕٹ دِو۔
یہِ مے یاد دٕلاوُن کہِ وٕنِس مے پالتو کوالا اوس۔
مُبارک! تُہۍ کُس طریٖقہ ہینڈل کرِو دباوٕ؟
اوہ، بالکل۔ سُہ چھُ واریاہ شرمیٖلو، تِہِ مےٚ گژھِ فخر۔
گویا سٲری دنیا چھِ تِمَن ہُنٛد۔
اصلہِ تِمَن ہُنٛد عُمر کتِہ چھِ؟
تِمَن چھِ خۄدٕس فخرُک مسئلہ، مگر سُہ چھِ تِمَن سۭتۍ۔
شُکر چھُ، سُہ نَہ ٹوٗٹ۔
آ، مےٚ چھُ پتہ تُہۍ کِژھ محسوس کران—گویا تُہۍ چھِو پَرگَٹری منز پنُن انجام انتظار کران۔
مےٚ تہِ نَہ پسند چھُ ییلہِ اندر یا باہر واریاہ انٛدھ چھُ۔
یہِ چھُ کمال! مےٚ اوس سُہِتھ ییلہِ مےٚ اوس لۄکُٹ، تہٕ مےٚ کٔر واریاہ مزٕ۔
مےٚ چھُ کوٗشش کران زِ تِم نَہ بناوٕں، کیازِ مےٚ چھُ واریاہ ژٕیوان۔
مگر مےٚ کِنٛہہ کٲنٛہہ ژوٗٹ وُنوٕ۔
ہا ہا، تِمَن پنٛنِس خٲطرٕ صرف ۲۰ سیکَنٛڈ بچاوٕ۔
اُف، مےٚ چھُ نَہ دۄش دِوان تُہۍ—پبلِک ریسٹ روم چھِ ہمیشہ گَندٕ۔
مےٚ کَتِہ نَہ کٔر اتھ بَد محسوس پنٛنِس بارے۔
تِمَن اوس وعدٕ کٔرمُت زِ سُہ نَہ کَروٕ فیر، مگر پَتہٕ کٔر سُہ۔
اَس سٲرٕن کٔر واریاہ مزٕ۔
کینہہ فوٗڈ پینٹری چھِ کمال، مگر کینہہ منز چھِ صرف خراب مِٹھٕ کھٲنۍ۔
اگر مےٚ نَہ جیتوٚ، مےٚ چھُ لگٕنۍ زِ مےٚ دِیٚہہ واریاہ کَتھۍ مُقابلہ۔
کیا تُہۍ رولر کوسٹر منز سوار گژھان؟
بہٕ ابھی نَوس شہرَس منز منتقل گژھمٕت۔
کیبل سٹریمنگس منز سیزن در سیزن مسلسل وُچھان۔
آ بہٕ چھُس وُچھان یِہِ اکھ سِنگل۔
مےٚ مٲج کٔہ کہِ یِہِ کُتہٕ گژھِ دور کرُن، کیٛازِ تِمَن چھِ الرجی۔
نَہ ابھی، بہٕ چھُس تَمہِ پٮ۪ٹھ کٲم کَران، کیٛازِ ظٲہِر چھِ یِہِ بدلُن ضروٗری۔
کیا چھُ تُہٕنٛزِ نانی ہٕنٛد یاد یِوان؟
مےٚ چھِ پنٛنِس ایکس ہٕنٛد بٕہ یاد یِوان۔
بہٕ ابھی جاگنگ کٔر سٕپٕد، چھُس باسان زٕبردٕست تھکان، مگر چھِ کامیٲبی ہٕنٛد احساس تہِ۔
کٲم چھُ بِل ادا کَرنہٕ خٲطرٕ ٹھیٖک، مگر چھُ زندگی منز بٔڑٕ خلل پٲدا کَران۔
ٲسہِ چھِ سارٕ دماغس سٲتھی پٲدا گژھمٕت، مگر عقل سٲتھ نہٕ۔
مےٚنٛز مکان مالِک چھُ سامان ٹھیٖک کرنہٕ خٲطرٕ بٔڑِ دیر لَگان۔
بِگ ڈے ہٕنٛز دوہ دۄہ پٮ۪ٹھ بہٕ واقٕعی ڈرِتھ لَگٕمُت۔
مےٚ مٲجُک کُتہٕ چھُ پنٛنِس پنجرس منز نِبرُن نہٕ ژٕٹان، پٲنٛچ کرنہٕ خٲطرٕ تہِ۔
مےٚ کٔرِ بٔہ وٕریٚن خیال۔
مےٚنٛز بِلّی چھِ اکھ ہفتہٕ ژٕھِتھ نِشٕتھ۔
بہٕ آسٕس تَمہِ سٲتھ ٹھیٖک۔
مےٚ چھُس یقین نہٕ کران زِ مےٚنٛز بوٚی فرینڈ کُکِنگ کلاسس منز کِتھ پٲٹھۍ ژھٲر کٔر۔
آ، تَمیٚ آسٕن، تہٕ مےٚ دادَن کٔر پَک زِ بہٕ دُکانس منز واپس گژھِ معافی وُچھٕن۔
بہٕ چھُس بٔڑِ دیر سٕتۍ تَمہِ خٲطرٕ انتظار کَران۔
بہٕ دو ؤرین ہُند محنت کران اوس
واہ، یہِ چھُ اَکھ وُچھُن مان
مےٚ چھُس سمجان کہٕ مےٚ پنٛنِس کٲمَس منز واریاہ بہتر کٔر تہٕ باسَس دِکھاونہٕ خٲطرٕ اَکھ زبردست ڈیزائن آسِہ
گژھِ دۄہ مےٚ اَکھ کٲلِی بِلّی پنُن سڑک پار کران دٔرٛای
تُہۍ کِیا چھِو اَکھ بَیٚیہِ کُتھ لٮ۪وان
تُہۍ چھِو بختٲور زِ تُہۍ کَن چھُ اَتھ پٲٹھۍ سُہ پٲٹھۍ بَڈا بابا
یِتھ سٲری ؤرین پَتہٕ مےٚ بَیب رُتھ ساین کٔرِتھ اَکھ نایاب بیس بال ژٕٹھ، یہِ سُبُح یِیہِ
مےٚ چھُ نَہ پَسنٛد تُفان
شاید کینہہ اَکِٹِنگ کٕلاس تُہۍ کٔرِو تھوڑا رٲحت محسوس
کِیا چھُ تُہۍ دوٚیم پٲٹھۍ سوچنُک سبب
مےٚ پَسنٛد ٹیمَس چھُ اَکھ نوٕ کوارٹر بیک
کِیا تُہۍ تِمۍ دِدٕرٛاونہٕ خٲطرٕ فٕلایِٹَن گژھان
مےٚ چھِ نہٕ پَسنٛد کٲنٛہہ قِسمُک رٮ۪پٹایل
بہٕ اوسُس واریاہ واریاہ رَژان
مےٚ ہٮ۪کَس نہٕ سَوٕچِتھ تہٕ پیسہٕ گنٛدراونُک
کُنِہِ مےٚ سٕنٛد دوپہرُک کھٲنِہ کینہہ کھٲد
شُکریہ یار، تَتھ پَلکِس جوش منز مےٚ پنٛنٮ۪ن فٕلٮ۪ش بیکن ہٕنٛدِ سۭتۍ کھٲد، بہٕ اوسُس صدمَس منز
آ، پنٛنِس کَم عُمرِس منز بہٕ تھوڑا زِیادٕ آزاد رشتٕ کَران اوسُس، مگر اَتھ نَہ
بہٕ اوسُس واریاہ خوش زِ تٔمۍ جواب دِت تہٕ مےٚ تَتھ ڈرٛایِو
اَکھ ژٕ چھُس مےٚ سۭتۍ سُورَن ہٕنٛدِ بار بار پٲچھان
تہٕ بہٕ گژھان آسٕس گژھِ راتھ گَر
بہٕ جیتان پانٛژھ ہَزار رۄپیہِ
سۄرِے کٕڈنُک وقت آو
آز بہٕ سکولہٕ ہٕنٛدۍ کینہہ پرٛان دوستن سۭتۍ مٕلُن گژھان
کاش ۱۹۹کھانٛہ کھانٛہ بہٕ سکولہٕ آسٕس تَمہِ چھِ تِمَن سُہ آسِتھ
آسِتھ بہٕتھ وار گژھِمُت یِتھ پٲٹھۍ اکھٹھ
بہٕ خوش چھُس زِ تُہۍ چھِو
بہٕ گژھِس کمہٕ سۭتۍ ژٕٹۍ ژٕٹۍ کٔن بالٕن سۭتۍ
سُہ چھُ تیز گژھان بڑٕ بچہٕ
آ، تِم مٕژھ تہِ چھِ ژٕٹۍ تیز اُڈان، تہٕ مارُن چھُ انتہٕ مُشکل
سُہ چھُ کٲفی زبردست تہٕ سُکھ دِن وٲل
بہٕ تہِ آسٕس پریشان گژھان
صُبحن سۭتۍ شور کرن متعلق عام طور قانون چھِ
یِہِ اتھ وار چَلانٕہٕ سۭتۍ کانٛہہ تہِ دِوانہٕ کٔرِتھ ہٕکِتھ
سۄنٛہِ طرفہٕ یہِ چھُ زِ تُہنٛدِس بچس سِکھوومُت زِ وۄنۍ وۄنۍ حادثہٕ گژھان تہٕ سُہ چھُ ٹھیک
سُہ چھُ خراب گژھمُت، مگر تُہۍ چھِو مزٕ کٔرِتھ؟
مگر آخرکار بہٕ دوستن ہٕنٛدۍ ذٔریعہٕ پنٕنِس ساتھی سۭتۍ مٕلِتھ
سُہ چھُ سونہٕ ہٕنٛدۍ بنٲومُت؟
ژُمرٕتھ دۄہ آنلائن میڈن کھیلن شروٗع کرنہٕ خٲطرٕ بہٕ چھُس بے صبر، بہٕ چھُس عام طور پیٚٹھ کٲفی سُہ کھیلان
مےٚ اُمید چھُ کہ تِمِچ زندگی منز کینٛہہ نیک مرد چھِ یِم تِمِس خٲطرٕ باپ ہٕنٛد رول ادا کٔرِتھ مدد کٔرتھ ہیکن۔
یِمن کَہِنس طٕلبہٕ لون ہٕنٛد قرضٕ سٕتۍ وٕنوُن نہٕ پَوان، تِمن سٕتۍ چھُس مےٚ حسد۔
سُہ واریاہ بوٚڑ تہٕ تکلیف منز اوس۔
مےٚ اکھ لَٹہٕ یہِ بے گھر شخص سٕنٛدۍ گدۍ پٮ۪ٹھ پوٗپ کَران دٔرٛای تہٕ تَمہِ سٕنٛدۍ کمبلہٕ سٕتۍ تِہ ژھاک۔
مےٚ اُمید چھُ کہ تِمُنٛد سال واریاہ سُہل گژھِ۔
اَس اَز شاپِنگ کٔرٕن گٔژھ تہٕ سُہ وُچھِتھ یقین نہٕ کٔرِتھ ہٮ۪کِس۔
سٲری چیز پیوٗتھ بہٕ رَن منز کمال کٔر۔
مےٚ سٕتۍ ۳۰ وریٚہِ اوس یِہ کچھوا، سُہ گٔے کَل رٲوتھ۔
بہٕ ہر ہفتہٕ چھُس پنٛنِس نٲنِس سٕتۍ ملاقات کران۔
پَروٗہ رٲژ مےٚ اکھ واریاہ شاندار ریسٹورَنٹ منز ڈیٹ اوس۔
تِمَن کٔر واریاہ نیک تہٕ بہٕ گٔژھُس حٲران۔
تَمہِ سٕتۍ مےٚ گٔژھُس ناراض، کیازِ تَمہِ سٕتۍ مےٚ کَم پٮ۪ٹھ دیر گٔژھ۔
اَچھا، یِہ چھُ صرف اکھ طریقہٕ یُس تِہ پَتہٕ لٲگِتھ ہٮ۪کِو۔
مےٚ پنٛنِس پسند جیکٹ گوم کٔر تہٕ مےٚ چھِ نہٕ مٮ۪لان۔
مےٚ سٕتۍ سُہ وُچھنہٕ خٲطرٕ گژھنہٕ بجایِہ مےٚ گرل فرینٛڈن کٔرۍ باقی پلان۔
مےٚ سٕنٛد بوٚے فرینڈ چھُ کٲم خٲطرٕ شہرٕ نِش بٕٹھ تہٕ مےٚ چھُ سُہ واریاہ یاد یوان۔
مےٚ چھُس تُہۍ پٮ۪ٹھ پگاہ سٕتۍ پورٕ بھروسہٕ۔
مےٚ چھُ لگٕن سُہ تِہ سُہ گوم کٔرِتھ واریاہ ناپسند کران اوس۔
مےٚ چھُس پنٛنِس ژھٲپٕس پٲٹھۍ وٲلِس سٕتۍ واریاہ ناپاک، یُس بَرٛونٹھ نِش مےٚ اپارٹمنٹ منز ژھَریو پٲنی۔
سُہ اوس اکھ مقٲمی لوٗکھَن ہٕنٛد ملکیت وٲلٕ میکسِکن ریسٹورَنٹ۔
مےٚ چھُ یقین زِ تۄہہِ چھُو تِمَس پؠٹھ فخر۔
کیا چھُو تُہہِ کُنہِ خاص جاےِ گژھان یِم پہنُن؟
تُہہِ ہیکیو دوبارٕ لوکھن سۭتۍ رٲبطہ کرنُک کوٗشش کرِتھ۔
ہاں، مگر یہ چھُ بہت گرم گژھان۔
سُہ چھِ سۄ جاےِ مےٚ پٮ۪ٹھ پٮ۪ٹھ یِوان؛ مےٚ گژھِ تٔمس ناو سایہٕ دِن۔
مےٚ چھُ واریاہ خراب لَگان، کیازِ مےٚ زن چھِ یہِ بۄنٛد نہٕ سٲنس کرِتھ ہیٚکان۔
یِم صُبح چھِ کُنہِ چور مےٚ اخبار۔
تۄہہِ سٲری کٲم کُنہِ مدد بغیر کِیا کٔر؟
مےٚ کوٗشش کَران اوس کم خرچ روزُن۔
مےٚ چاہان اوس یہ پیسہٕ، کیازِ مےٚ چھُ نہٕ کٲم کران۔
یہِ چھُ بلکل سۄنٛدَرین۔
اوہ، کیا راتھ کھاون پٮ۪ٹھ تہِ نہٕ؟
مےٚ اوس لَگان زِ مےٚ چھُ یہِ خٲطرٕ زور سۭتۍ مطالعہٕ کٔر، مگر یہِ چھُ واریاہ مُشکل مواد۔
مےٚ چھُ سٲری کٲم آدی پیک تہٕ منصوبہٕ کٔرمتھ۔
مےٚ چھُ اَتھ وقت پنُن زندگی پسند، مگر صرف یِم خٲطرٕ زِ چھِ نہٕ ذٔمہٕ وارِی۔
اُمید چھُ زِ سُہ چھُ ٹھیک ڈرایور۔
مےٚ چھُ جنٛوبس منٛز روزان، تِلہِ مےٚ چھُ پتاہ زِ تُہہِ کیاہ ونان۔
مےٚ چھُ پنُن بھتیجا مےٚ سۭتۍ یہِ کرنُک کوٗشش کَران۔
سُہ چھُ واریاہ نیک انسان، تہٕ یہِ چھُ نہٕ تَمس لایق۔
مےٚ اوس واریاہ خوش تہٕ شاد زِ یہِ نعمت مےٚ دِنہٕ آمُت۔
ہاں، یَتھ تُہۍ پنٛنِس پیسٕن سٕتۍ اداو کٔرِو، تَتھ پٲٹھۍ بہتر لَگہِ۔
تَتھ منز کینہہ غلط نَہ چھُ۔
مےٚ چھُس ونان زِ آخرکار صدرِ مملکت ہُنٛد عہدٕ اکھ زیادہ مثبت رخس منز گژھِ۔
مےٚ ہٕنٛزِ گھَرِ منز واریاہ خاموشی چھِ۔
مےٚ چھُس خوش زِ تُہٕنٛدِ خٲطرٕ سٲری کینہہ ٹھیک گژھ۔
ہاں، تیٚیاری خٲطرٕ سُہ روز تیٚرِتھ۔
یَتھ مےٚ ہٕنٛزِ نانی گٔے، بہٕ کٔر سٲری تباہ۔
بلکل درست۔ خیر، اُمید چھِ زِ تُہۍ کینٛہہ نہ کینٛہہ میلو۔
یَتھ مےٚ اکھ نو کُتہٕ میٚل۔
مےٚ چھُس پنٛنِس پَتھِمِ صحنس منز آسٕن ایلینن ہٕنٛز کَتھ سٕتۍ تھوڑا پریشان۔
مےٚ چھُس جانان زِ مےٚ اگلی ٹیسٹ منز اے گریڈ میلو۔
مےٚ گژھان چھُس اگلے ہفتہٕ کیلیفورنیا، یِہ چھِ مےٚ ہٕنٛزِ زنٛدگی ہٕنٛزِ پہلی سفر۔
بہٕ گژھم اوس اُس دۄہ کامس وٲری دیر، تہٕ مےٚ ہٕنٛز گاڑی فُیُومس پؠٹھ چلان اوس۔
بہٕ نَہ کٔرِتھ ہٲوِو، کیازِ بہٕ چھُس اکھ بیڈروم اپارٹمنٹ منز روزان۔
مےٚ چھُس فکرمند زِ مےٚ نَہ چھُس جانان کَتھ چھِ آسُن۔
کیا تُہۍ چھِو ونان زِ تُہۍ سُہ بدلٲوِتھ ہٲوِو؟
تَتھ خٲطرٕ اَز بہٕ کٔر اکھ بوٗڑھ زَنٛگِ لُٹ۔
بہٕ نَہ کٔر، مگر سُہ کٔر اَمہِ اشارٕ خٲطرٕ واریاہ بٔڈۍ بغلگیرۍ۔
مےٚ اوس پَتہٕ زِ مےٚ ہٕنٛزِ زنٛگِ ہُنٛد خاندان کَرِ مدد پیسٕن منز۔
سُہ ہَٹٲونہٕ خٲطرٕ مےٚ اوس سُہ مُکٕل دِن پَژھان۔
مےٚ پانٛنۍ متعلق کافی مایوس اوسُس
گَژیر میون ہیمسٹر مرِتھ
اَز مےٚ خاندان إیرپورٹ تام نیو
تَوَتھ نروس گژھنُک کانٛہہ چھُ نہٕ، مےٚ چھُ یقین زِ تُہۍ سُہل کَریو
بہٕ، مےٚ چھُ خوش زِ تُہۍ خاطرٕ سٕہِتھ گژھِتھ
تُہۍ چھِو تِمَن خٲطرٕ خوش
مےٚ پنٛنۍ زنٛنۍ ہٕنٛز سالگرٕ بھول گژھ
مےٚ اوسُس نہٕ خوش زِ مےٚ وقتس منز کامہِ پٮ۪ٹھ نِکلس نِہ آو
یہِ چھُ نہٕ، مگر وُنی چھُ یہِ مےٚ ضرورت
بس گژھِو گَرٕ پٮ۪ٹھ باہَر تہٕ کٲنٛسِہ کَریو تُہۍ خٲطرٕ سُہ تباہ
مےٚ چھُ موتُک ڈر
میون بای‌فرینڈ چھُ سٲری یِژھ ویٖڈیو گیم کھیلان
وُنی چھُ نہٕ مےٚ کٲنٛسہِ سۭتۍ گَپھ کرنہٕ یا کانٛہہ کرنہٕ خٲطرٕ
گژِتھ ہفتہٕ یِلہِ میون دوس نیو کار ؤن، مےٚ اوس حسد
مےٚ چھُ پنٛنٮ۪ن بچَن پٮ۪ٹھ تھوڑا آرام ضرورت
یہِ تِمنٛدٕ پَتہٕ لَگنِک بَعٕد یِتھ کِ چھُ اَسان ہٕنٛز چھَتھ بلکُل خَراب گَژھِتھ
بڑٕ گژھان مےٚ اوس سٲری وقت تِمَن ہٕنٛز گیمز وُچھان
میون گراج ژلان وُچھن اوس پاگل کُن
تُہۍ چھُو لازِم زِ ژۄر ژۄر تِمَن پٮ۪ٹھ باہَر گژھیو
شاید اگر تُہۍ گژھیو کُنہِ جایہِ تِم کُری سۭتۍ بغٲر
کینہہ ہفتن ہٕنٛدۍ پٲٹھۍ بہٕ کٲنٛسہِ سٕتۍ پنُن پسندٕچ برتھ ڈے کیک آرڈر کٔرمُت
کاش مےٚ فون یہِ خۄد بخۄد کٔرتھ ہاوُت
آ، یہِ نہ صرف تُہٕنٛد وقت ضایع کٔران چھُ بلکہ پیسہٕ تہِ
مےٚ تِمن اٹھٲوتھ پھینکُنٛچ تقریباً حدس منز ترٛٲومُت
تِم چھِ اَسہِ خٲطرٕ بُتھ قُربٲنی دِوان
لٲگہِ چھُ تُہۍ سُہلٕچ تیار تھٲوِتھ
گژھِت ہفتہٕ مےٚ کٔرۍ پٲٹھۍ زٕوٚج سٕتۍ بحث
سُہلِتھ چھُ لگٲن یِہِ کمال وقت آس
یِم سٕتۍ مےٚ رٲبطہٕ آس، تِمَن کَتھ نیٚ کٔرۍ دھۄکہٕ
مےٚ چھُ وۄنۍ پٲٹھۍ کٲم کَرن وٲلٕن پَزَند؛ سُہ چھُ پنُن قول پٲدٕ کَرن وٲل گۄڈ بٲب
تِم تُہۍ کٔرۍ چھِ سسپنس منز ژٕلٲوتھ، مگر تُہۍ چھِ فوراً اگلی شو دِتھ ہیکان
مےٚ چھُ امید سٲری کارڈ گژھِ زبردست؛ اَز راتہٕ گژھن کینہہ سٲری لڑٲی
مےٚ چھُ جِتھ پٲٹھۍ ہیکان ژٕونٛن ہٲوان ہٲوان ژٕونٛن ہٲوان پناہ گاہس منز رضاکارانہ کٲم کَران
مےٚ چھُ یقین تُہۍ چھِ آرام کٔرتھ خٲطرٕ برٛونٛہہ دِتھ ہٲق‌دار
حالٕی منز مےٚ باس چھُ مےٚ تِم وقت دِوان یِم مےٚ سچٲیی ژٕچھان
