بوٗنہٕ لوٗکھ شاید اکھ ہفتٕ ہٕنٛد کایاکنگ ٹرپ پیٹھ گژھنہٕ سٕتۍ پریشان گژھن، مگر نہٕ مےٚ۔
کِنہٕ ؤری پٮ۪ٹھ کینہہ خراب نہٕ گژھِتھ، بس۔
مےٚ بٲیہِ پنٛنٮ۪ن ذِمٕہِ پٮ۪ٹھ لانن ہُند گھاس کٔرتھ اضافی پیسہٕ کمٲون۔
کیا تۄہہِ لٲگِ ژٕٹہِ ٹرٛین کٔرنس منز زٕرِی وقت؟
یہ اوس اکھ وُڈ ٹی شرٹ ہِنٛز، مگر تہِ۔
مےٚ چھُ نہٕ پنُن گھاس کُرتھ پسند، یِمن سۭتۍ چھُ میٚون سٕمٕن ہُند دروازٕ شہرِ ہُند جرمانہٕ ہٕنٛدۍ گلابی کاغذن سۭتۍ ڈھانپمتھ۔
مےٚ چھُ لَگہِ جاب انٹرویو پٮ۪ٹھ گژھُن، تہٕ میٚہِ خیال چھُ مےٚ یہِ کٔرِتھ ہَیہِ۔
مےٚ بارے منٛز وُچھ، سُنو۔
اکھ وۆل مےٚ یتھ دُکانس منٛز کٲم کران اوس، تتھ پٮ۪ٹھ چوری کرتھ پکڑ آو۔
ٹھیک، اگر تُہۍ اوس زان کٔرمتھ محنت کٔر ٹریننگ، مےٚ چھُ یقین تُہۍ گژھِو زبردست۔
کھانٕہ خٲطرٕ پیسہٕ ہٲوتھ یِو، یا گوٚڈ ڈرنکس ہٲوتھ یِو۔
اوہ واہ، مےٚ چھُ یقین یِمٕچ زنٛدگی آسِ حَسین۔
تِمَن منٛز گژھان گژھان چھِ أسۍ ڈِسٹرٛیکٹ گژھان۔
نَہ، تِمِس وِزِس مےٚ کینٛہہ پتا نَہ اوس کہِ کِیاہ وُن۔
مےٚ چھُ پنٛنِس بیٚیِس ترٛقۍ مٕتعلق زٕبردست خوشی۔
کیا تُہۍ ہمیشہ جیب یژھان اوس؟ تِمَن چلٲون چھُ کافی مزٕدار۔
مےٚ چھُ یِوان یِتھ کٲمَس پٮ۪ٹھ پرفارمنس اٮ۪والویشن، مگر مےٚ چھُ ذرا تہِ فکر نَہ۔
تُہۍ گژھِو یہِ کِنٛگرٕ نِش بٔٹھ دِتھ۔
کم اَز کم سُہ چھُ گژھان۔
کیا تُہۍ کَدٕچ نایگرا فالز گٔیو؟
مےٚ چھُ بالکل خوش، تہٕ کُنہِ بدلاوٕچ ضرورت نَہ۔
دِژھان چھُ کہِ ماجہٕ چھِ بچَن ہٕنٛز دَیکھ رٕکھ کران۔
مےٚ تہِ، مےٚ ہٕنٛز آواز تہِ میوزِک سۭتۍ میلان نَہ اوس۔
واہ، سُہ چھُ وُنی تہِ بدتر۔ مےٚ ہٮ۪کہٕ نَہ تصور کرِتھ، مےٚ چھُ زٕبردست افسوس۔
سُہ چھُ زبردست! تُہۍ کُتھ گٔیو؟
مگر یِمَن ہٕنٛز پہچان یِوان یِتھ چیزِس سۭتۍ، اگر تِم سُہ مُفت دِوان، تِم کِتھ پٲٹھۍ پیسہٕ کَمان؟
مےٚ چھُ وٲسپَن سۭتۍ زٕبردست نفرت۔
سٲری ژٕ ؤرۍ سٕچٕی پٲٹھۍ محنت کرُن پَیِو
ہاں، سُہ چھُ سٲری پٲٹھۍ زبردست آدمی
مےٚ چھُس یِمِچِھِتھ کُنہِ تہِ دۄہ ڈاکٹرُک فون یِوان
تُہہِ کُنہِ کُنہِ کھیٖل پسند چھِ؟
مےٚ چھُس تِم معصوم بچن خٲطرٕ بَہتھ اداس
مےٚ چھُ یاد، زٕ اور میون برٛونٹھ اکھ جایہِ ویڈیو گیم کھیٚلوان
مےٚ چھُس بلکل نَہ یقین
یا صرف تُہہِ بُکھ اوس
مےٚ اوسُس کِتھٕ پٲٹھۍ حیران کہِ پلاٹ تہٕ ایکٹر دوٗنی
سُہ چھُ سٲری پٲٹھۍ فخر کرنُک کام
مےٚ اوسُس آیہِ پَتہٕ لَگِتھ کہِ میون گٕرل فرٛینڈ اوسُس میون سۄنہٕ دۄستَس سٲتۍ سۄن
مےٚ چھُس آسہٕ کران زِ تُہہِ چھِ کینہہ مزٕ دار پلان جشن مناونہٕ خٲطرٕ
میون زٕن چھِم طلاق دِنُک خیال کران
کالج پارٹی چھِ نَہ کُنہِ چیٖز سٕتۍ برابر
کیا اوسُس مزید ڈیزرٹ ضرورت
مگر کینہہ وِزِ خٲطرٕ اوسُہ سٲری پٲٹھۍ مُشکل
ہاں تہٕ مےٚ ہیکہٕ سُہ واپس دِتھ یِلہِ مےٚ سُہ لاڈ کرِ
مےٚ چھُس پنٛنِس خود کَنٹرولُک کٔمی خٲطرٕ بَہتھ قصوروار محسوس کران
اگر اکھ دۄہ چھُٹِتھ گژھِتھ، مےٚ نَہ اوسُس ایتھ اداس
سُہ چھُ سٲری پٲٹھۍ پُرانہٕ لٲگِتھ شروع گژھان
مےٚ تہِ پُرجوش گژھان۔
یہِ چھا نَو فیلڈ؟
مےٚ ڈیپ فرای کٔرِتھ بینگن کھٲد۔
مےٚ چھُس تَمہِ خٲطرٕ واریاہ افسوس۔
آج صبح مےٚ جِم نہٕ گژھ۔
مےٚ چھُس گمان کران زِ تُہۍ تَمیچ وٲن چھِو، کانٛہہ بیٚیہِ نَہ۔
مےٚ چھُس پَک یقین زِ تِم چھِ بٔر گژھان۔
تَمہِ سۭتۍ سَوٕچھ آسانی سۭتۍ پھپھوند گژھِتھ۔
تِمَن جٔیتھ ۴ منز ۲۔
یِہِ یِتھ گژھ، مےٚ تِمَن خبر دِتھ تہٕ اکھ تصویر سُنٛد۔
میٛون دٔخ چھِ نیشنل آنر سوسایٹی ہُند سٹوٗڈنٹ۔
مےٚ وٲن چھُس اُلٹی کرُن۔
تَمہِ بجای مےٚ چھُس ڈیٹ پٮ۪ٹھ گژھُن یژھان۔
آ تٔم چھِ انشورنس سنٛبھالنٕچ واریاہ مُشکل۔
س اداکار تہِ آ چھُ مُردٕ۔
