بہٕ گژھان چھُس پنٛنٕن کُٹم سٲتھ کینہہ خۄشگوار وقت گُزارُن
مےٚ چھِ پُرانہٕ طرزُک تھیم بہت پسند
مگر مےٚ چھُ یقین زِ تُہۍ تمنٛز نَوۍ رٲبطہٕ بناوِو
مےٚ گوٚو ۳۰ ہُنٛد حدس منٛز ۴۴ ہُنٛد رفتارَس
مےٚ چھِ گندٕگی تہٕ بے ترتیبی سخت ناپسند
اَے خدا، تُہۍ تِمۍ حالتہٕ منز کَتھ کٔرِتھ بٲہر یِو
مےٚ چھُ نَہ ژھانٛگِتھ باہَر دۄہٕن ہُنٛد مُدت
اَس چھِ سفرَس گژھان
خوش قسمتی سۭتۍ، مےٚ یِم گژھن تہٕ چھِ نَہ دور گژھان
آخرَس مےٚ گٔوٚس مٲمۍ ہُنٛد کار ژٔلِتھ مَزٕ کٔرِتھ
جمعہ دۄہ چھِ مےٚ اکھ پٲٹھۍ ڈیٹ اکھ ناواقف کُرِ سۭتۍ
تُہۍ چھِ ضرور فخرَس سۭتۍ پھُٹان
تِم ہٮ۪و تعجب زِ مےٚ معافی مانٛگِتھ ییٚتھ ژٔٹِتھ ہیکُس تِتھ ژٔٹِتھ گَرٕ نِرِو
کینہہ ہفتہِ سۭتۍ مےٚ اوسُس امیوزمنٹ پارکَس گژھنُک بے صبری
مےٚ چھُ یقین زِ یہِ چھُ پورٕ حق دار
مےٚ مطلب، چھِ کینہہ حد واقعی زِ اکھ زن کِتھ بگ میک کھٲوِتھ ہیکِہ
تہٕ کھٲنہٕ تہِ مُفت اوس
یہِ چھُ یِتھ ویمپائر سِٹِی نِش
سُہ اوس وٕری بے ادٕب تہٕ بے وقوف
مےٚ ہُنٛد سۭتۍ دوستَن مےٚ ہُنٛد کٔرِ کٔنِ ہفتہٕ وارِ خٲطرٕ نِیِو، تاکہ مےٚ پنٛنِس شۄہرِ سۭتۍ کینہہ اکیٚلا وقت گٔزارِتھ ہیکہٕ
اَسنِس پریوارَن اوس وٕری مدد کٔرمٕژ
مےٚ سُہ سمجَھان، مگر اَتھ چھُ سٲری کینہہ ختم، ہے نہ؟
مےٚ بیٚیہِ گژھِ آسُن بَتھ غُصہٕ۔
یہِ خاص چھِ کینہہ لوپ، تہٕ مےٚ چھُ نہٕ پسند اُلٹِس پٲٹھۍ روزُن۔
مےٚ نہٕ کٔر، کیازِ مےٚ نہٕ روزان اوس گھرِ۔
یَلہِ مےٚ کٲم پٲٹھۍ گَر وُن، مےٚ سُہ لِوِنگ رٗمَس منز مُردٕہ اوس لَگمُت۔
تَمی پے چیک پٲٹھۍ گژھِ مےٚ خۄشگوار حَیرٲنی۔
مےٚ سٲری سمیسٹر محنت کٔر، مگر پرٕتھ فیل گژھنٕے خٲطرٕ۔
تُہۍ چھِ وَنٕان، سی ایس کٔرِتھ ڈگری چھِ مِلان۔
سُہ ڈیٹرایٹ سٹایل ہُند اوس۔
مےٚ فلوریڈا منز روزان تہٕ ہریکینن ہُند سامنا کران۔
مےٚ لَبِھ أَکھ نَو ریسٹورَنٛٹ، تہٕ تِتھ چھِ تقریباً پانٛژھ رۄپیہِ پر ڈِش۔
مےٚ نہٕ ہٲوان انتظار کرِتھ سبان۔
مُبارک، لَگٕنۍ چھِ تُہۍ سچِ کامیاب گژھمتھ۔
آج مےٚ أَکھ پِزّا آرڈر کٔر، تہٕ سُہ اوس نہٕ سُہ باسان۔
یقینن، مےٚ چھُ نہٕ کانٛہہ شک—سٲری کینہہ گژھِ سُہ، تہٕ یہِ تُہندِ خٲطرٕ نَو تجربہٕ آسِ۔
آج صُبح وُٹھِتھ مےٚ بوز زِ مٮ۪ٚن ٹرکُک اَکھ ٹایَر پنکچر اوس۔
مےٚ کُترٕچ ناو اوس کوکی۔
مےٚ چھُ نہٕ لَگٕنۍ زِ مےٚ سُہ بینٛڈ چھُ وُچھمُت۔
ہاں، تہٕ مےٚ چھُ فر بیبیز خٲطرٕ تازٕ پانی دِوان۔
کیازِ سُہ چھُ پَہلِے أَکھ وار گژھِمُت، تہٕ یہِ چھِ تَمی جاے یُس تِمۍ اوس۔
مےٚ چھُ یقین زِ سُہ سمجھیو چاکلیٹ کھاونٕچ خواہش کِنہہ تہِ نَہ دَبٲوٕنی۔
تَتھ پَتہٕ تَمہِ مُتعلِق چھُس مےٚ ژٕٹ بُرٕ محسوس کران۔
مےٚ چھُس ہمیشہ تَتھ گژھنٕچ خواہش تھاوان۔
مےٚ کَرٕنۍ پٲو سرجری۔
او یار، یہ چھُ خوفناک۔
مےٚ گوٚوٕس گژھان حیران گریجویشنٕچ راتھ، ییلہِ میٚون والدینن میٚے دپان اَکھ نو کار۔
تَنہٕ پنُن تہٕ باقیَن ہِنٛدۍ سنگتھ ہُنٛد مزٕ لُٹنس
یہِ چھُ سُڻنٕہِ کٔترٕ خوشیٕچ کٲنٛہہ۔
یہِ چھُ واریاہ خراب۔ اَگر سٲری مدد کرنٕہِ آسن، شاید یہِ ریکارڈ وقتس منز صاف گژھِتھ۔
مےٚ ہٕنٛز بلی گٔے موت بوٗڑۍ عمرٕچ وجہہ سٕتۍ، تہٕ مےٚ رٲتھ سٲری تَمہِ خٲطرٕ روٚو۔
مےٚ چھُس ناراض زِ مےٚ چھُ نَہ امکان یِم ہفتہٕ وار باہر گژھِتھ۔
بس جِتھ پٲرِو تیٚلہِ ہِنٛز چھوٹی آسُن سنبھالِو۔
مےٚ چھُس یِلہِ بلکل بےٚقیمت محسوس کران۔
آ، مےٚ چھُس واریاہ خفہٕ گژھمُت۔
سُہ چھُ تَمہِ سۭتۍ واریاہ بدتمیز۔
مےٚ چھُس تَمہِ کھیلٕچ بابت سُنمُت۔
کیا چھُ سُہ واریاہ محنت کران پڑھٕنۍ تہٕ بہتر بناونٕچ کوشش؟
یہِ چھُ وقت لگان، مگر یہِ چھُ مزٕ ہُنٛد اَکھ حِصہٕ۔
اَگر مےٚ پٲوان اَندازٕ لٲگِتھ، بدقسمتی سۭتۍ مےٚ ہٮ۪کان نَہ۔
واہ، خدا شُکر چھُ سُہ صحت یاب گژھان
سُہ بالکل محفوظ نہٕ چھُ
بہٕ واریاہ پیٹھ پارکَس منٛز ژَلان اوسُس
مےٚ چھُ اَکھ مُفت بُفے
مےٚ لَگہِ چھُ ژِہہِ وٲپس آمتھ
مےٚ چھُ صاف یاد زِ کَتھ دۄہ میٚون بابَن میٚون سایکل ہُند ٹرینِنگ ویل کَڈان
مےٚ تھوڑا خراب لَگِتھ کہ غَلتی سۭتۍ مےٚ کلیئرنس کُکیزَن ہُند ۵ پیکٹ خریٖد
تُہۍ کُن چیریٹیَن کُن عطیہ دِتھ پسند کَران
تُہۍ کیٛازِ پریشان گژھو
سُہ واریاہ سنجیدہ چھُ، اُمید چھُ تُہۍ پولیس کُن فون کَرمتھ آسِو
اُمید چھُ تُہۍ سُہ ژٕلِتھ ہُران کٔرمتھ آسِو نہٕ کہ تَتھ پٮ۪ٹھ گاڑِی چَلاوِتھ آسِو
تِم چھِ حشرات گژھتھ، سُہ دوٗر کَرنہٕ خٲطرٕ تُہۍ کِیا کٔر
یہ چھُ میٚون خوابن ہُند گاڑِی حقیقت بنمتھ
اوہ، سُہ کیٛازِ کاروبار بند گژھِتھ
ہمت تھاو، اُمید چھُ زِ تُہنٛد خٲطرٕ سُہ بہتر گژھِ
سُہ سکولس کُن وٲپس گژھان چھِ، سُہ چھُ واریاہ زبردست
علاوہ، مےٚ کَنہِ کَنہِ کِہِ تماشا دِژھُن لایق نہٕ لَبان
بہٕ، بہٕ چھُس لگ بگ اکھ ؤرس یِمِچ قٕسمُچ حالت گژھان
یِم وَڈ گژھان چھِ تہٕ چھُ مُشکل لَگان
آ تِہٕ بہٕ کَمَس پٮ۪ٹھ نظر تھاوٕس
وٕنٕن اوس دوبارٕ دِژِتھ کَہساہ لَگ؟
مےٚ کِنہہ عام برانڈچ آب کٔرِد۔
میڈن یِہ جمعہ رلیٖز گژھان تہٕ بہٕ چھُس نہٕ انتظار کٔرتھ ہیکان۔
ہا ہا، آ، بہٕ کینہہ ژیادٕ جوشس منز گٔژھ۔
تٔمس حالتس مُتعلِق مےٚ اوس بہٕ واریاہ پریشان۔
تَمہِ کٔرِتھ بہٕ تہِ احتیاط کٔرِتھ۔
سُہ چھُ اکھ بٔڈ نصیب وارو گژھان۔
کینہہ لوٗکھ چھِ نہٕ ذرا تہِ عزت کٔران بیٚیہِ ہنٛز چیزن ہٕنٛد، تہٕ یِم چیز چھِ أسۍ سٲری شٲرِک کٔرُن، تِمن ہٕنٛد تہِ کم۔
وٕنِہِ صُبح ورزش کٔرِتھ گٔژھ بہٕ کینہہ مغرور۔
تَمہِ کٔرِتھ میون دیٚن واریاہ بہتر گٔژھ۔
مےٚ گٔژھ انگلش کلاس منز مُشکل سان پاس۔
مےٚ کٔر پیسہ چور والِدس ہٕنٛز والیٹ منز۔
صدرس منز ٹرمپن یِم کٲم کٔر، تَمہِ پٲٹھۍ چھُس بہٕ واریاہ خوش۔
یِہ تہِ ٹھیک کٔرُن نہٕ سَستہٕ لَگِتھ۔
واہ، سُہ چھِ اکھ واریاہ خراب انسان دِژھان۔
میٚنۍ چھُ خیال، وٕنِہِ چھُ وقت یُس تُہۍ کینٛہہ قاعدٕ مقرر کٔرِو۔
آ، چھُ روزانہ کٲم، گَر، پالَتُو جانور، ضروٗری کٲم تہٕ باقی سٲری چیز جَمٲوُن مُشکل۔
کینہہ دۄہ چھِ ہر اکھ ژۄٹِہ ژۄٹِہ کٲم مےٚ چِڑ کٔران۔
واہ، اگر یِہِ چھُ سُہ پٲٹھۍ، تۄ سُہ چھِ پنُن مُستقبِل روشن۔
مےٚ چھُ فخر زِ مےٚ کالیج گریجویٹ کٔر؛ مےٚ نہٕ وون کُنہہ لمحن خٲطرٕ زِ بہٕ ہیکہٕ تَتھ پزِتھ۔
یہِ تِمنِس قسمُکۍ سۄ کھۄتہٕ مشہوٗر چھُ۔
بہٕ وُچھ جھیلِ کِنارِ نِش گژھِتھ۔
سُہ چھُ اَکھ زبردست پیشہٕ۔
مےٚ چھُس جانان، مگر مےٚ چھِ ابھی تَمہِ دوستن ہُند یاد۔
سُہ چھُ بَہٕ زِیادٕ کھَراب؛ تِمن سِتۍ اَکھ سبق دِوٕنۍ خاطرٕ بہٕ بدلاوٕ۔
سٲری کُٹمٕنۍ خٲطرٕ سُہ اَکھ بَہٕ مایوٗسی ہُند سبب آس۔
ویک اینڈس پٲٹھۍ بہٕ سُہ آٹو پارٹس ہُند دُکانس منز نِتھ۔
سُہ تِمن نِشٕچ آسُن گژھِ نَہ؟
بہٕ پیسہٕ بچاونٕچ کوٗشش کران چھُس۔
تِمَن لَمبِس مدٕت رہنٕچ خٲطرٕ روزانہ خرچ دِوان ہُند طریقہٕ بدلٕو۔
نَہ، سُہ چھُ مےٚ برٛونٛہِ ہُند بچہٕ۔
دوٗ وُری پٲٹھۍ اَکھ گاڑِ ہٲدثس منز مےٚ ہُند سٲہر پٲٹھۍ ژٔل۔
آ، مےٚ پٲٹھۍ محنت سۭتۍ پرٛژھ تہٕ زٕبردست محنت کٔر، یِمن مےٚ سُہ سۭتۍ خۄش آس۔
تِمَن ہاونہٕ کِتھ پٲٹھۍ نایاب چھُ؟
مےٚ چھُس پنٛنِس کُڑِ ہُند مےٚ خٲطرٕ پیارَس پٮ۪ٹھ پٲٹھۍ یقین۔
بوٚڈ پلان چھِ یا نَس آرام؟
یِہ چھُ کمال زِ اَس اکیٖلا ٲسِ تَمہِ چھِ آس پاسُک ہَر نِکٕر آواز سُنان۔
اَکھ لٹہٕ مےٚ پنٛنِس موتُک خواب وُچھ۔
اگلی لٹہٕ نَس بیٖتر کٔرٕنۍ کوٗشش کٔر۔
بہٕ بَہٕ زِیادٕ گابراوِتھ آسُس۔
مےٚ ژٕوٗر کٕر کامہٕ خٲطرٕ شہرٕ بٕرون گژھن، یمۍ سۭتۍ بہٕ یِم ہفتس گَرِ اکیلی چھُس۔
کیا تُہۍ پنٕنۍ کارڈ کمپنی کٕن فون کٔر؟
مےٚ وٕنۍ چھُس یِم دۄہنٕچ جوش منز۔
مےٚ چھُس نَہ پسند کران چمگادڑن ہٕنٛز نٔزدیٖکۍ روزُن۔
مےٚ چھُس رٲضی، وٕنۍ چھُس بہٕ واریاہ شرمندٕ۔
اوہ مےٚ گاڈ، تِم ضرور واریاہ شرمندٕ کُن آسِتھ۔
وَیل فایرَن کٔر سٲری شہرَس پٮ۪ٹھ واریاہ دھوٗر، روڈس پٮ۪ٹھ آسن نظر کٔرُن مُشکل۔
کیا ریبیز سۭتۍ نَہ گژھِ روشنی ہٕنٛز حساسیت؟
مےٚ چھُس نَہ صبر کران یِم وری ہٮ۪لوٗینس خٲطرٕ۔
تُہۍ کَسہِ پیٹھ پیسہٕ اُدھار نَہ دِیو، اگرِ سُہ تُہٕنٛز دوست آسِہ تہِ۔
تُہٕنٛز نِزدِ سُہ کتھ پٲٹھۍ آس؟
سُہ کٲنٛسہِ قٕسمہٕ ہُنٛد کامہٕ خٲطرٕ چھُ؟
مےٚنٛز رٗوم میٹَن ہَفتن سۭتۍ برٛونٛٹھ نَہ دھوومُت۔
بہٕ گوٚ مٲنس دۄہ تہٕ سبزی دۄہ بدل بدل کٔران، تہٕ مےٚ چھُس پنٛنِس جسمس منز پٲٹھۍ زیات طاقت محسوس کٔران۔
بس منفی چیزن پٮ۪ٹھ توجہ نَہ دِیو۔
سُہ یِکِس وقتس منز زٕوٚنٛٹھ تہٕ خراب تہٕ لگَان۔
مےٚ چھُس سٕمجان یِم وری ایگلز گوٚوٚ سُپر باؤل دۄیم دَفعہ جیتِتھ، تِم واریاہ زٕوٚنٛٹھ دِکان۔
مےٚ چھُس ضرورت مند باقی چیزن پٮ۪ٹھ توجہ دِنٕچ بجایِ۔
مےٚنٛز نٔزدیٖکۍ روزن وٕنٛۍ وٕنٛۍ بلکل نوٚو کیٚمپَر کٔریٚتھ۔
مےٚ چھُس اَکھ زبردست ژٕوٗر، تہٕ اَسہِ دۄنٛنٕ چھُ اَکھ سُہنٛدَر زندگی بناومُت۔
نٔوِس سالس أسۍ ‘د ٹوایلاٮ۪ٹ زون’ تہِ دٕیکھان۔
अबस کٲنٛہہ تہِ مےٚ ملاقات کرنس نَہ یِوان۔
مےٚ کٔر دعوت، مگر مےٚ پنٛنِس برٛونٛہہ خٲطرٕ دعوت حٲصل کرنچ کوشش نہ کٔر، یِمۍ مےٚ تھوڑا اداس لَگ۔
مےٚ ہُسبَنٛد کاروبٲری سفرس گٔے۔
یہ چھِ ٹھیک، مگر مےٚ خۄد تہِ یِمِس مُتعلق زیادٕ واقف نَہ ٲس۔
یہِ چھِ أسۍ کَتھ تہِ حٲصل کٔرمتو منز بہترین۔
کیا سُہ چھُ نہٕ کانٛہہ؟
سُہ ٲس اِتھ پٲٹھۍ سُہ دوٚست۔
تُہۍ کِنہہ گروپَن منز شامل گژھنچ سوچ کٔرِتھ۔
کِنہہ دۄہَن منز سُہ پنٛنِچ مرضی کران۔
بَتۍ نَہ کٔرِتھ مےٚ نیند نَہ یِوان۔
سُہ چھِ تہِ زیادہ دِلکش۔
سُہ ٲس مےٚ پنٛنِس ایکٕس سۭتۍ۔
مےٚ کُتھ ٲس ابھی مرِتھ۔
کیا تُہۍ یِہ کٔرِتھ؟
مےٚ لَگن چھِ بٔڈِ تعدادس منز لوگ۔
اوہ، مےٚ ہُلو چھُ، مےٚ یِہ دٕیکھُن پَژِ۔
مےٚ چھِ بٔڈ شوق پٲران فوٹو البم دٕیکھنس تہٕ دٕیکھنس زِ سٲری کِتھ پٲٹھۍ بڑٕ گٔے تہٕ چیٖز کِتھ پٲٹھۍ بدل گٔے۔
تَمس چھُ اکھ ژۄر تہٕ پریوار۔
سُہ تہٕ گاسس منز ؤسِتھ، مےٚ کِیاہ کٔرُن ٲس؟
ہاں، اَسہِ کِیوٹ ژٔٹہِ چہرہٕ ہٕنٛز نظر پَتھ غصہٕ کرُن مُشکل چھُ۔
مےٚ چھُ لگٕنۍ سُہ گولڈن ریٹریور آسُن گژھِت، مگر سُہ عجیب دِکھان۔
وَۄنۍ مےٚ چھُ لگٕنۍ تُہۍ یہِ ٹھیٖک دامس پؠٹھ وِکٕرِتھ ہؠکِو۔
مےٚ یُس ٲس، سُہ ٲس مےٚ خٲطرٕ کافی، یِمۍ مےٚ پنُن پَڑوسِی ہُند جایداد لَگٕنۍ مَنٛع کٔر۔
مےٚ چھُ نَہ سَمبرٕ نَظَر کَران نَوِس لیگو فلمس پؠٹھ۔
کیا تُہۍ ‘گوف آف’ ناوُک یہِ سامان آزمایو؟
یہِ چھُ اکھ گۄڈ وقت سوچنس خٲطرٕ۔
مےٚ سٲری کافی پنٕنۍ شرٹ پؠٹھ سٲرٕ سَٹاو، سُہ کِیوٹ بارِسٹا ہُند سامنے۔
مےٚ چھُ تَمہِ پؠٹھ واریاہ فخر یُس تٔمۍ مُشکل وقت پار کٔرِتھ آخر کامیاب گٔے۔
یَتھ مےٚ ہُند آڈِشن ہُند وقت آو، تَتھ پٲٹھۍ مےٚ سُہ کمال کٔر۔
مےٚ چھُ لگٕنۍ سُہ چھُ سچ۔
یا اللہ، یہِ سُڻِتھ واریاہ دُکھ لَگۍ۔
سُہ چھُ نَہ واریاہ بُڑ، مگر تُہۍ گژھِو یِمۍ ہُند سائز ضٔروٗر دٕیکھُن۔
مےٚ سُہ ٹُرِتھ تھاو۔
تَمہِ خٲطرٕ دٔفتَرِ مےٚ ہُند ساتھی بار بار مےٚ ہُند لنچ چور کَران۔
اَکھ سی گریڈ آسُن نَہ چھُ واریاہ خراب۔
پَزِ راتھ مےٚ ہُندۍ ماجۍ ڈِنَرِ کُنہِ چِکَن پورٕ نَہ پَزایو۔
مےٚ چھُ مارِیو کارٹ ۸ ہُند سوِچ ورژن پؠٹھ کھیلان۔
اُمید چھُ مےٚ ہُند باس سخی موڈس منز ٲسِتھ، ہا۔
مےٚ ہُندِ سُہ تہِ واریاہ گژھان پسند۔
یِتھ مےٚ ۱۰ ؤرۍ چھُ سٲمٕن گاڑِ چَلاوان
سُہنٛز مےٚ اکھ کَپ کٲفی گٔیہ ژٕٹ تہٕ سٲری مےٚ کٲمُک کاغذ پٲٹھۍ پٮ۪وان
کیا سا چھِ وُن یِم وقت تُہۍ کھوتہٕ دوٗر
مےٚ اوس اکھ زَنِس سٕتۍ منگنی کرمٕژ، یِمَن مےٚ سٕتۍ دَگہٕ کوٚر
آ، کینٛہہ ؤرۍ گٔے نَہ، مگر مےٚ سچوٕے اوس
مےٚ سَمجھ آوٕ زِ کَتھ کَتھ چھِ یِم مےٚ کٔرِتھ آزمانٕچ ضٔروٗرت
دوٚن مہینن منٛز مےٚ ہٮ۪وٕنۍ بچہٕ یِوان، تہٕ مےٚ چھِ تَمہِ خٲطرٕ فِکر
اَکھ یا دو ؤرۍ سٕن
تِم اوس مےٚ کُن اکھ مدد کَرُن
تُہۍ پَزِ کِچھ آزماوُن زِ تُہۍ ہٮ۪وِتھ دھیان ہٮ۪وِتھ
کیا تُہۍ فلٮ۪کس ٹیپ اِستعمال کوٚر
آ، سٲ چھِ مےٚ تہِ پسندیدہ ٹیم
مےٚ چھُ اُمید زِ تُہۍ کَرو خۄب مَزٕ تہٕ مَچھَر تُہۍ نہٕ ژٕٹِوٕن زیادٕ
تَمہِ خٲطرٕ چھُس مےٚ خوش
تہٕ یِہ چھِ مےٚ سٲری ہفتہٕ فِکر تہٕ ٹینشن منز تھاوان
یِہ چھُ لگ بھگ خواب سٲنۍ
مےٚ چھُس یژھان زِ وۄلُر پَزِ
مےٚ چھُس پنٛنِس گرل فرینڈِس سٕتۍ پیار، مگر تِم چھِ مےٚ کَران زیادٕ غُصہٕ
پٲگل لوٗگ چھِ ہر ۳ سیکنڈس منز کِہی کَران
تُہۍ وٲتھ کَرو یَتھ تام گرمی یِہ، اکھ مہینس پتہٕ یِم سکولس واپس گژھن تِمِس خٲطرٕ تُہۍ تیار گژھِو
مےٚ چھُس متفق، تِمَن کٔر سُہ سٲریٕچ کٲم یُس تِمَن یہِ آخری موقَس تام مےٚ کَنٛہہ لُکٲوِتھ۔
سُہ چھُ مارکیٹنگ پلان بورڈ آف ڈایریکٹرس سٕنٛدِ مُقابِل پیش کَران۔
مےٚ سٕنٛز قسمت چھِ تہِ یِمَن چیزَن مُتعلِق بلکل خراب۔
بہٕ گژھان چھُس مےٚ سٕنٛدِ ننِہ بھتیجٕچ سرپرایز سالگرٕ پارٹی۔
بہٕ چھُس تَتھ ہمیشہ چٲول تہٕ سٹیک ژٕٹھان۔
مگر مےٚ نہٕ گژھِتھ آسُن۔
گَژھِتھ رات مےٚ سٕنٛدٕ بچَن کٔر مےٚ سٕتۍ فلم نِش تہٕ اَسہِ کٔر سُہ سٲریٕچ مزٕ۔
سُہ کِتھ پٲٹھۍ خۄشگوار آسِہ۔
مےٚ سٕنٛز اکھ پُرانہِ سہیلی چھِ یژھان اَز راتھ ڈرنٛکْس پیٚنٛہِ گژھُن۔
تُہُنٛد پراجیکٹ کِس مُتعلِق اوس؟
مےٚ چھُس بس نہٕ ژٲنٛان کَتھ کَرُن۔
مےٚ چھُس یاد یِوان زِ بہٕ اوسُس بچپنَس منز کوایرٕس منٛز گانٛہ گژھان۔
نُقصانُک خرچ کِتھ چھُ؟
بہٕ چھُس سُہ پَتہٕ گژھِتھ کٔرمُت، مگر یہِ چھُ عجیب زِ سُہ کٔرِتھ کُنہہ مۄقَس پَتہٕ مےٚ کٔر گُناہُک احساس۔
تَتھ پَتہٕ تھوڑِچ دیرِس منز سُہ گٔی مۄت۔
سُہ چھُ بٔڈ دُکھُک، مےٚ چھُ امید زِ سٲری کینہہ چھُ ٹھیک۔
اکھ دۄہ مےٚ سٕنٛدِ دوستَن کٔر مےٚ سٕنٛدِ پسندیٖدٕ گٹارس پٮ۪ٹھ اکھ بٔڈ چیٖز ڈٲل۔
ییٚلہِ مےٚ سٕنٛدِ بٲبَن مےٚ دیٚتم پٲنٛژِم گلوٗو، بہٕ اوسُس بٔڈ شُکرگُزار۔
مےٚ چھُس کِیاہ کٔرتھ یِمِچ مدد؟
تَو مےٚ سٕنٛدِ کُتُرس چھُ پنٛنِ ڈاگی سکوٗلُک اوبیٖڈِیَنٛس کورس ہٕنٛز گریٖجُویشن کٔرمُت۔
مےٚ جٕیٛہِ ڈِگری کٔر پٲری تہٕ سۭتۍسۭتۍ پنٛنہِ شعبس منز نوکری حٲصِل کٔر۔
مےٚ چھُ واریاہ افسوس، توہہِ ضرور واریاہ خراب لٲگِتھ آسو۔
وَرۍن ہٕنٛد نہٕ گَژھِتھ پَتہٕ اَکھِر سُہ مےٚ کٕن آو۔
مےٚ چھُ ویک اینڈ ختم گژھنہٕ خٲطرٕ پورٕ تیار—سوموار چھُ مےٚ خٲطرٕ بڑِ دۄہ۔
مےٚ چھُس کیٹو ڈایٹہِ پٲٹھۍ، یمہِ خٲطرٕ مےٚ چھُ کیٹو چیٖز آزماون۔
تُہۍ کٔم رَنگ یژھان چھِو؟
والدین بنُن چھُ اکھ شاندار احساس۔
واہ، تُہۍ کٕن اَسہِ مددگار خالہٕ آسُن چھُ واقعی شاندار۔
مےٚ چھُس حیران زِ مےٚ ہٕنٛز پورٛنۍ سکوٗل وۄنۍ کِتھ پٲٹھۍ دِسِتھ آسن۔
ہا ہا، آ، یہِ چھُ تِمِس پٲٹھۍ دِژھنُک اَکھ گۄڈ طریقہٕ۔
وۄنۍ سُہ چھُ واقعی واریاہ مُشکِل۔
مےٚ چھُس واریاہ خوش زِ تُہۍ ٹھیک آسِو۔
مےٚ چھُس تقریباً روز یِتھ آوٕن، اورل۔
پتا چھُہ کیٛاہ، اَز مےٚ گوٚو واقعی حېران۔
مےٚ چھُس اُمید کَرٕنۍ زِ سُہ ژٕٹ پٲٹھۍ ٹھیک گژھِ۔
وۄنۍ چھُ کم لوٗگ یِم پنٛنہِ ہَتھن تحفہٕ یا کانٛہہ چیز بنٲوان۔
مےٚ چھُس خیال کران زِ مےٚ نَہ دِتھ کیب ڈرٛایورَس پیسہٕ، تہٕ سُہ ووٚن زِ تِمِس چھِ پیسَنٛ ہٕنٛز واریاہ ضٔروٗرت۔
مےٚ تہٕ مےٚ ہنٛز زَن چھِ وۄنۍ خزاں منز مَین گژھان چھُٹِی، تہٕ مےٚ چھُس تِمِس خٲطرٕ واریاہ خۄش۔
آ، تِمَنٛ ہٕنٛد چھِ ٹورنامنٹ، مگر یُس گیم مےٚ دِژ سُہ رٮ۪گولر سیزنُک آو۔
کیا تُہۍ چھِو فِکرِت تہٕ گھبراوِت؟
مےٚ ہریٛکینن منز وَڈ گٔو، یِم چھِ بُہت ڈراوٕن۔ ٹورنیڈو کَتھ پٲٹھۍ ڈراوٕن آسہِ، تَمہِ ہٕنٛز مےٚ اَندازٕ لَگٲوِتھ ہیکِو۔
مےٚ یِتھ کٔنۍ کھُش آسِتھ ہٕیکٕنَہ۔
مےٚ ہاٹ پاٹ چھِ بُہت پسند، تہٕ یہِ چھِ واقعی صحت مند تہِ۔
آخرکار مےٚ پنٛنِس پسندیدہ بیس بال ٹیم سٕنٛدِس سامنٕے کھیٚلِتھ ہیٚکہٕ۔
مےٚ چھُس وَنان سُہ کٲم تُہٕنٛدِس جِسمٲنی تہٕ ذہنی طور پٲٹھۍ بُہت بوجھ آسِتھ۔
کیا تُہۍ چھِو کُنہِ کٲمِہِ بَرٕون پٲٹھۍ پُر جوش؟
سُہ چھِ ٹھیٖک، مگر کیا سُہ چھِ اَتھ تہِ ٹھیک چلٕان؟
ہاں، آخرکار مےٚ چھُس سمجھان سُہ چھِ صرف یِم اُمید کرُن زِ سُہ سُہل آسِتھ۔
مےٚ چھُس نہٕ وُچھان کَلٕچ۔
سُہ ہیٚوِتھ مےٚ چھِ افسوس۔ تُہٕنٛدِس دۄنٛنِس منز آخر کیا گٔی؟
کیا تُہۍ چھِ سُہ واپس دِتمُت؟
سُہ گژھِ لازِم پنٛنِس ژھورِس سٕتۍ رشتہ دار۔
تَمہِ پنٛنِس جایِہِ ہٕنٛز حَد دِکھٲوُن گٔژھِ مےٚ خٲطرٕ ضٔروٗری۔
مےٚ ہاوٕ پنٛنِس سَبسٕنٛز دوستس پنٛنِس گَرٕچ کُنہِ کٲجی دِتمٕژ۔
تَمہِ خٲطرٕ تُہۍ پیٛاز کِتھ پٲٹھۍ ژٕٹ؟
ہاں، نَوسٹالژیا چھِ واقعی بُہت زوردار۔
ہاں، مےٚ چھُس تہِ تَتھ پٲٹھۍ سمجھان۔
تَتھ مُتعلِق چھا اَتھ تہِ کُنہِ کٲمٕیابی مٕلِتھ؟
مےٚ چھُس جانان زِ فکر نہٕ کرُن گژھِ شایَد مُشکِل۔
